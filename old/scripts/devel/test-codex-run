# Subscribe before inspecting publications, so a write between the check and
# the wait cannot be lost. Readiness includes the Codex PID contents and the stamped
# thread event, not just creation of their files. No scheduling sleeps.
wait_task_ready() {
    python3 - "$state" "$HUNG_CASE_S" <<'PYWAIT'
import ctypes
import os
from pathlib import Path
import select
import sys
import time

state = Path(sys.argv[1])
deadline = time.monotonic() + int(sys.argv[2])
libc = ctypes.CDLL(None, use_errno=True)
fd = libc.inotify_init1(os.O_CLOEXEC | os.O_NONBLOCK)
if fd < 0:
    raise OSError(ctypes.get_errno(), 'inotify_init1')
try:
    # IN_MODIFY | IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE
    if libc.inotify_add_watch(fd, os.fsencode(state), 0x2 | 0x8 | 0x80 | 0x100) < 0:
        raise OSError(ctypes.get_errno(), 'inotify_add_watch', str(state))

    def ready():
        try:
            return ((state / 'codex.pid').read_text().strip().isdigit() and
                    b'"thread_id": "thread-fixture"}\n' in
                    (state / 'events.jsonl').read_bytes())
        except FileNotFoundError:
            return False

    while not ready():
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
            sys.exit(f'FAIL deadline: task publications in {state}')
        os.read(fd, 65536)
finally:
    os.close(fd)
PYWAIT
}
wait_unit() {
    local unit=$1 finished
    IFS= read -r -t "$HUNG_CASE_S" finished <&"$unit_events" || {
        echo "FAIL deadline: unit $unit" >&2
        return 1
