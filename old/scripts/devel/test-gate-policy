def run_isolated(name):
    """Runs one test in this worker; returns its outcome and its whole output."""
    with tempfile.TemporaryFile() as capture:
        sys.stdout.flush()
        sys.stderr.flush()
        saved = os.dup(1), os.dup(2)
        os.dup2(capture.fileno(), 1)
        os.dup2(capture.fileno(), 2)
        start = time.monotonic()
        try:
            suite = unittest.defaultTestLoader.loadTestsFromName(name, sys.modules[__name__])
            result = unittest.TextTestRunner(stream=sys.stderr, verbosity=2).run(suite)
            outcome = ("ok" if not result.skipped else "skipped") if result.wasSuccessful() else "FAIL"
        except BaseException:
            import traceback
            traceback.print_exc()
            outcome = "FAIL"
        finally:
            sys.stdout.flush()
            sys.stderr.flush()
            os.dup2(saved[0], 1)
            os.dup2(saved[1], 2)
            os.close(saved[0])
            os.close(saved[1])
        elapsed = time.monotonic() - start
        capture.seek(0)
        return outcome, elapsed, capture.read().decode(errors="replace")


def run_parallel():
    """Runs every test in its own fixture over a pool of os.cpu_count() workers.

    Prints one line per test in name order, a failing test's whole output,
    and exits nonzero on any failure."""
    from concurrent.futures import ProcessPoolExecutor
    import multiprocessing
    names = [f"{fixture.__name__}.{name}"
             for fixture in (PolicyFixtures, ReceiptRows)
             for name in unittest.defaultTestLoader.getTestCaseNames(fixture)]
    start = time.monotonic()
    failed = 0
    with ProcessPoolExecutor(max_workers=os.cpu_count() or 1,
                             mp_context=multiprocessing.get_context("spawn"),
                             initializer=os.umask, initargs=(0o077,)) as pool:
        futures = [pool.submit(run_isolated, name) for name in names]
        for name, future in zip(names, futures):
            try:
                outcome, elapsed, output = future.result()
            except Exception as error:
                outcome, elapsed, output = "FAIL", 0.0, f"worker failed: {error!r}\n"
            print(f"{name} ... {outcome} ({elapsed:.1f} s)", flush=True)
            if outcome == "FAIL":
                failed += 1
                print(output, end="" if output.endswith("\n") else "\n", flush=True)
    print(f"Ran {len(names)} tests in {time.monotonic() - start:.1f} s: "
          + (f"FAILED ({failed})" if failed else "OK"), flush=True)
    return 1 if failed else 0


if __name__ == "__main__":
    os.umask(0o077)
    if len(sys.argv) > 1:
        # A selection or unittest option runs serially, as unittest.main does.
        unittest.main(verbosity=2)
    sys.exit(run_parallel())
