    def candidate_mutation(self, mode):
        if mode == "replacement":
            head = self.git("rev-parse", "HEAD").strip()
            message = self.git("log", "-1", "--format=%B")
            parents = self.git("show", "-s", "--format=%P").split()
            (self.repo / "code").write_text("ungated replacement\n")
            self.git("add", "code")
            replacement_tree = self.git("write-tree").strip()
            arguments = ["commit-tree", replacement_tree, "-m", message]
            for parent in parents:
                arguments += ["-p", parent]
            replacement = self.git(*arguments).strip()
            self.git("replace", head, replacement)
            self.git("read-tree", "--reset", "-u", "HEAD")
            self.assertEqual(self.git("rev-parse", "HEAD").strip(), head)
            self.assertNotEqual(self.git("rev-parse", "HEAD^{tree}").strip(), self.captured_tree)
            self.assertFalse(self.git("status", "--porcelain").strip())
        elif mode == "relocated-merge-state":
            moved = self.root / "moved-primary"
            self.primary.rename(moved)
            self.run_command(["git", "-C", str(moved), "worktree", "repair"])
            state = Path(self.git("rev-parse", "--git-path", "MERGE_HEAD").strip())
            self.assertNotEqual(state, self.captured_merge_state)
            self.assertFalse(self.captured_merge_state.exists())
            state.write_text(self.git("rev-parse", "HEAD"))
            self.assertTrue(state.is_file())
            self.assertFalse(self.git("status", "--porcelain").strip())
        elif mode == "same-tree":
            self.git("commit", "--allow-empty", "-qm", "same tree B")
        elif mode == "rebase":
            self.git("switch", "-qc", "concurrent-base", self.base)
            (self.repo / "upstream-code").write_text("ungated upstream change\n")
            self.git("add", "upstream-code")
            self.git("commit", "-qm", "concurrent upstream change")
            new_base = self.git("rev-parse", "HEAD").strip()
            self.git("switch", "-q", "work")
            self.git("rebase", "--onto", new_base, self.base)
        elif mode in ("rebase-state", "rebase-apply-state", "merge-state"):
            state = {"rebase-state": "rebase-merge", "rebase-apply-state": "rebase-apply",
                     "merge-state": "MERGE_HEAD"}[mode]
            path = self.repo / self.git("rev-parse", "--git-path", state).strip()
            if mode == "merge-state":
                path.write_text(self.git("rev-parse", "HEAD"))
            else:
                path.mkdir()
        elif mode == "ref":
            self.git("branch", "moved-ref")
            self.git("symbolic-ref", "HEAD", "refs/heads/moved-ref")
        elif mode == "detached":
            self.git("checkout", "--detach", "-q")
        elif mode == "head-unavailable":
            self.git("symbolic-ref", "HEAD", "refs/heads/unborn")
        elif mode == "untracked":
            (self.repo / "untracked").write_text("ungated file\n")
        elif mode == "status-error":
            (self.root / "fail-status").touch()
        elif mode == "tree-error":
            (self.root / "fail-tree").touch()
        else:
            (self.repo / "code").write_text("ungated B\n")
            if mode in ("commit", "index"):
                self.git("add", "code")
            if mode == "commit":
                self.git("commit", "-qm", "ungated B")

    def concurrent_candidate(self, point, mode):
        if mode == "relocated-merge-state":
            self.primary = self.linked_worktree()
            self.env["LAND_LOCK"] = str(self.root / "stable-land.lock")
            self.captured_merge_state = Path(self.git("rev-parse", "--git-path", "MERGE_HEAD").strip())
        if mode == "replacement":
            self.captured_tree = self.git("rev-parse", "HEAD^{tree}").strip()
        faults = self.root / "tmp/faults"
        faults.mkdir(parents=True, exist_ok=True)
        (faults / ("continue-" + point)).unlink(missing_ok=True)
        (faults / ("land-" + point)).unlink(missing_ok=True)
        (faults / ("arm-" + point)).touch()
        extra = {"HEAVY_RECOVERY_FIXTURE": "1", "HEAVY_FAULT_DIR": str(faults)}
        output = self.root / (point + "-" + mode + ".txt")
        original = self.git("rev-parse", "HEAD").strip()
        if mode == "status-error":
            # Install before Bash caches Git's path; arm only at the barrier.
            real_git = shutil.which("git", path=os.defpath)
            self.script(self.bin / "git", '#!/bin/bash\n'
                        f'if [[ $1 == status && -e {shlex.quote(str(self.root / "fail-status"))} ]]; then exit 128; fi\n'
                        f'exec {shlex.quote(real_git)} "$@"\n')
        elif mode == "tree-error":
            real_git = shutil.which("git", path=os.defpath)
            self.script(self.bin / "git", '#!/bin/bash\n'
                        f'if [[ $1 == rev-parse && $2 == "HEAD^{{tree}}" && -e {shlex.quote(str(self.root / "fail-tree"))} ]]; then exit 128; fi\n'
                        f'exec {shlex.quote(real_git)} "$@"\n')
        with output.open("w") as out:
            child = subprocess.Popen([str(self.kit / "land"), "--local", "--gate", "true"],
                cwd=self.repo, env=self.env | extra, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
        try:
            deadline = time.monotonic() + HUNG_LAND_S
            while not (faults / ("land-" + point)).exists():
                self.assertIsNone(child.poll(), output.read_text())
                self.assertLess(time.monotonic(), deadline, "candidate fixture barrier")
                time.sleep(.02)
            self.candidate_mutation(mode)
            changed = self.run_command(["git", "rev-parse", "--verify", "HEAD"], check=False)
            (faults / ("continue-" + point)).touch()
            self.assertEqual(child.wait(timeout=HUNG_LAND_S), 4, output.read_text())
            reason = ("candidate HEAD is unavailable" if mode == "head-unavailable" else
                      "candidate index/worktree cannot be checked" if mode == "status-error" else
                      "candidate merge/rebase state changed" if mode in ("rebase-state", "rebase-apply-state", "merge-state", "relocated-merge-state") else
                      "candidate index/worktree changed" if mode in ("index", "worktree", "untracked") else
                      "candidate ref changed during amendment" if point == "before_candidate_cas" else
                      "candidate HEAD or tree changed")
            self.assertIn(reason + "; rerun land", output.read_text())
            current = self.run_command(["git", "rev-parse", "--verify", "HEAD"], check=False)
            self.assertEqual((current.returncode, current.stdout), (changed.returncode, changed.stdout))
            self.assertEqual(self.git("rev-parse", "main").strip(), self.base)
            log_target = original if mode == "head-unavailable" else "HEAD"
            trailer = self.git("log", "-1", "--format=%(trailers:key=Gate-Tree,valueonly)", log_target).strip()
            if mode == "replacement":
                self.assertEqual(trailer, self.captured_tree)
            else:
                self.assertFalse(trailer)
            if point == "after_receipt":
                self.assertFalse((self.root / "tmp/gates").exists())
            print(f"consumer {point}/{mode}: PASS", file=sys.stderr)
        finally:
            (faults / ("continue-" + point)).touch()
            if child.poll() is None:
                child.terminate()
                child.wait(timeout=HUNG_LAND_S)

