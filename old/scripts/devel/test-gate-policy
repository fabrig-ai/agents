    def test_landed_tidy_detached(self):
        stub = self.root / 'waiting-tidy'
        ready, release = self.root / 'tidy.ready', self.root / 'tidy.release'
        os.mkfifo(ready)
        os.mkfifo(release)
        # Keep both ends available before tidy starts; readiness and release
        # block on pipes, and the pidfd becomes readable only at process exit.
        ready_fd = os.open(ready, os.O_RDWR | os.O_NONBLOCK)
        release_fd = os.open(release, os.O_RDWR | os.O_NONBLOCK)
        pidfd = None
        self.script(stub, '#!/usr/bin/python3\nimport os,sys,json\n'
                    'assert sys.stdin.read() == ""\n'
                    f'with open({str(ready)!r}, "w") as out:\n'
                    '    out.write(json.dumps([os.getpid(), os.getsid(0)])); out.flush()\n'
                    f'    with open({str(release)!r}, "rb", buffering=0) as release:\n'
                    '        assert release.read(1) == b"x"\n')
        try:
            self.land({'LAND_TIDY': shlex.quote(str(stub))})
            self.assertTrue(select.select([ready_fd], [], [], HUNG_TOOL_S)[0], "tidy readiness")
            pid, session = json.loads(os.read(ready_fd, 4096))
            pidfd = os.pidfd_open(pid)
            self.assertEqual(pid, session)
        finally:
            os.write(release_fd, b"x")
            try:
                if pidfd is not None:
                    self.assertTrue(select.select([pidfd], [], [], HUNG_TOOL_S)[0], "tidy child exit")
            finally:
                if pidfd is not None:
                    os.close(pidfd)
                os.close(release_fd)
                os.close(ready_fd)

