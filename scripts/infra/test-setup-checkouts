#!/usr/bin/env python3
"""Exercise setup's checkouts and landing turn in an offline scratch workspace."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import unittest

os.umask(0o077)
KIT = Path(__file__).resolve().parent
DRIVER = '''fix=${FIX:-0}; failed=0; repos=agents
ok() { echo "ok    $*"; }
warn() { echo "warn  $*"; }
fail() { echo "FAIL  $*"; failed=1; }
check_checkouts
exit "$failed"'''


def setup_driver(root, driver):
    kit = root / 'kit/scripts'
    (kit / 'infra').mkdir(parents=True)
    (kit / 'devel').mkdir()
    shutil.copyfile(KIT.parent / 'devel/kit.sh', kit / 'devel/kit.sh')
    for name in ('after-landing-units', 'fleet-units'):
        shutil.copyfile(KIT / name, kit / 'infra' / name)
    source = (KIT / 'setup').read_text()
    if source.count('check "$@"') != 1:
        raise AssertionError('setup must have one entry point')
    path = kit / 'infra/setup'
    path.write_text(source.replace('check "$@"', driver))
    return path


class SetupCheckouts(unittest.TestCase):
    def setUp(self):
        scratch = tempfile.TemporaryDirectory(prefix='setup-checkouts-')
        self.addCleanup(scratch.cleanup)
        self.root = Path(scratch.name)
        home = self.root / 'home'
        home.mkdir()
        self.workspace = self.root / 'workspace'
        self.workspace.mkdir()
        self.origin = self.root / 'origin.git'
        self.checkout = self.workspace / 'agents'
        # Ignore caller Git configuration and repository overrides, including hooks.
        self.env = {key: value for key, value in os.environ.items()
                    if not key.startswith('GIT_') and key not in
                    ('BASH_ENV', 'ENV', 'SHELLOPTS', 'BASHOPTS', 'CDPATH', 'FIX')}
        self.env.update(HOME=str(home), XDG_CONFIG_HOME=str(home / '.config'),
                        GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL='/dev/null',
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@example.invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@example.invalid',
                        GIT_TERMINAL_PROMPT='0', DEV_ROOT=str(self.workspace))
        self.git(self.root, 'init', '--bare', '--initial-branch=main', str(self.origin))
        self.git(self.root, 'clone', self.origin.as_uri(), str(self.checkout))
        self.git(self.checkout, 'commit', '--allow-empty', '-m', 'initial')
        self.git(self.checkout, 'push', 'origin', 'main')
        self.driver = setup_driver(self.root, DRIVER)

    def git(self, directory, *args):
        result = subprocess.run(['git', '-C', str(directory), *args], env=self.env,
                                capture_output=True, text=True)
        self.assertEqual(result.returncode, 0, (args, result.stdout, result.stderr))
        return result.stdout.strip()

    def check(self, fix=False, success=True):
        result = subprocess.run(['bash', str(self.driver)],
                                env=dict(self.env, FIX=str(int(fix))),
                                capture_output=True, text=True)
        self.assertEqual(result.returncode, 0 if success else 1,
                         (result.stdout, result.stderr))
        return result.stdout.splitlines()

    def test_current(self):
        self.assertEqual(self.check(), ['ok    agents: main is origin/main',
                                        'ok    agents: origin takes a push'])

    def test_behind_still_pushes(self):
        writer = self.root / 'writer'
        self.git(self.root, 'clone', self.origin.as_uri(), str(writer))
        self.git(writer, 'commit', '--allow-empty', '-m', 'next')
        self.git(writer, 'push', 'origin', 'main')
        self.assertEqual(self.check(success=False),
                         ['FAIL  agents: main is 0 ahead and 1 behind origin/main',
                          'ok    agents: origin takes a push'])
        lines = self.check(fix=True)
        self.assertIn('ok    agents: main fast-forwarded 1 commits to origin/main', lines)
        self.assertEqual(lines[-2:], ['ok    agents: main is origin/main',
                                     'ok    agents: origin takes a push'])
        self.assertEqual(self.git(self.checkout, 'rev-parse', 'main'),
                         self.git(self.origin, 'rev-parse', 'main'))

    def test_no_scratch_ref_created(self):
        self.check()
        self.assertEqual(self.git(self.origin, 'for-each-ref', '--format=%(refname)',
                                  'refs/heads/setup-push-check'), '')

    def test_origin_unreachable(self):
        self.git(self.checkout, 'remote', 'set-url', 'origin',
                 (self.root / 'missing').as_uri())
        self.assertEqual(self.check(success=False), ['FAIL  agents: cannot fetch origin'])

    def test_push_refused(self):
        self.git(self.checkout, 'remote', 'set-url', '--push', 'origin',
                 (self.root / 'missing').as_uri())
        self.assertEqual(self.check(success=False),
                         ['ok    agents: main is origin/main',
                          'FAIL  agents: origin refuses a push from here: '
                          f'git -C {self.checkout} push --dry-run origin '
                          'origin/main:refs/heads/setup-push-check'])


class SetupLandTurn(unittest.TestCase):
    def setUp(self):
        scratch = tempfile.TemporaryDirectory(prefix='setup-land-turn-')
        self.addCleanup(scratch.cleanup)
        self.root = Path(scratch.name)
        self.home = self.root / 'home'
        self.home.mkdir()
        self.directory = self.home / '.config/agents-land-turn'
        self.enabled = self.directory / 'enabled'
        self.machines = self.root / 'tmp/post/machines'
        self.ssh_calls = self.root / 'ssh.calls'
        self.driver = setup_driver(self.root, DRIVER.replace(
            'check_checkouts', 'check_land_turn "${INSTALLED_STATUS:-0}"'))
        bin_dir = self.root / 'bin'
        bin_dir.mkdir()
        for name, body in {
                'hostname': 'printf "%s\\n" "$FIXTURE_HOSTNAME"',
                'ssh': 'printf "%s\\n" "$@" > "$SSH_CALLS"\nexit "$SSH_STATUS"',
        }.items():
            script = bin_dir / name
            script.write_text('#!/bin/sh\n' + body + '\n')
            script.chmod(0o700)
        # Nothing in the caller's HOME, shell startup or SSH configuration is used.
        self.env = dict(HOME=str(self.home), PATH=f'{bin_dir}:{os.defpath}',
                        DEV_ROOT=str(self.root), DEV_TMP=str(self.root / 'tmp'),
                        FIXTURE_HOSTNAME='builder', SSH_CALLS=str(self.ssh_calls),
                        SSH_STATUS='0')

    def write_enabled(self, mode='ssh'):
        self.directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        self.enabled.write_text(mode + '\n')
        self.enabled.chmod(0o600)

    def check(self, fix=False, success=True, **env):
        self.ssh_calls.unlink(missing_ok=True)
        result = subprocess.run(['bash', str(self.driver)],
                                env=dict(self.env, FIX=str(int(fix)), **env),
                                capture_output=True, text=True)
        self.assertEqual(result.returncode, 0 if success else 1,
                         (result.stdout, result.stderr))
        self.assertEqual(result.stderr, '')
        return result.stdout.splitlines()

    def assert_ssh(self):
        self.assertEqual(self.ssh_calls.read_text().splitlines(),
                         ['-T', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes',
                          '-o', 'ConnectTimeout=5', '-o', 'UpdateHostKeys=no',
                          'free@2.29.124.199', 'true'])

    def assert_enabled(self, mode='ssh'):
        self.assertEqual(self.enabled.read_text(), mode + '\n')
        self.assertEqual(self.enabled.stat().st_mode & 0o7777, 0o600)
        self.assertEqual(self.directory.stat().st_mode & 0o7777, 0o700)

    def test_missing_then_fixed(self):
        lines = self.check(success=False)
        self.assertTrue(lines[0].startswith('FAIL  landing turn: ' + str(self.enabled)))
        self.assertFalse(self.enabled.exists())
        self.assert_ssh()
        self.check(fix=True)
        self.assert_enabled()
        self.assert_ssh()
        self.check()

    def test_wrong_then_fixed(self):
        for content in ('local\n', 'invalid\n', 'ssh\nextra\n', 'ssh\n\n', ''):
            with self.subTest(content=content):
                self.write_enabled()
                self.enabled.write_text(content)
                lines = self.check(success=False)
                self.assertIn(str(self.enabled), lines[0])
                self.assertIn('must hold ssh', lines[0])
                self.assertEqual(self.enabled.read_text(), content)
                self.check(fix=True)
                self.assert_enabled()

    def test_right_unchanged(self):
        self.write_enabled()
        before = self.enabled.stat()
        for fix in (False, True):
            lines = self.check(fix=fix)
            self.assertTrue(lines[0].startswith('ok    landing turn: '))
            self.assert_enabled()
            self.assertEqual(self.enabled.stat().st_ino, before.st_ino)
            self.assertEqual(self.enabled.stat().st_mtime_ns, before.st_mtime_ns)
            self.assert_ssh()

    def test_permissions_then_fixed(self):
        self.write_enabled()
        for path, mode in ((self.directory, 0o755), (self.enabled, 0o644)):
            with self.subTest(path=path):
                path.chmod(mode)
                self.check(success=False)
                self.check(fix=True)
                self.assert_enabled()

    def test_coordinator_needs_local(self):
        host = dict(FIXTURE_HOSTNAME='debian-16gb-hel1-3')
        self.write_enabled()
        lines = self.check(success=False, **host)
        self.assertIn('must hold local', lines[0])
        self.check(fix=True, **host)
        self.assert_enabled('local')
        self.check(**host)
        self.assert_ssh()

    def test_laptop_skips_even_with_fix(self):
        for fix in (False, True):
            self.check(fix=fix, INSTALLED_STATUS='1')
            self.assertFalse(self.enabled.exists())
            self.assertFalse(self.ssh_calls.exists())

    def test_local_post_route_requires_turn_without_heavy(self):
        self.machines.parent.mkdir(parents=True)
        self.machines.write_text('# fleet\nother free@other\nhel8 local # this host\n')
        self.check(success=False, INSTALLED_STATUS='1')
        self.check(fix=True, INSTALLED_STATUS='1')
        self.assert_enabled()
        self.assert_ssh()

    def test_remote_post_routes_do_not_make_a_laptop_fleet(self):
        self.machines.parent.mkdir(parents=True)
        self.machines.write_text('# hel8 local\nhel8 free@hel8\n')
        self.check(fix=True, INSTALLED_STATUS='1')
        self.assertFalse(self.enabled.exists())
        self.assertFalse(self.ssh_calls.exists())

    def test_unknown_heavy_status_does_not_skip(self):
        self.check(success=False, INSTALLED_STATUS='2')
        self.assert_ssh()

    def test_ssh_failure_also_under_fix(self):
        for fix in (False, True):
            self.write_enabled()
            lines = self.check(fix=fix, success=False, SSH_STATUS='255')
            self.assertTrue(lines[-1].startswith('FAIL  landing turn: strict ssh'))
            self.assertIn('free@2.29.124.199', lines[-1])
            self.assert_ssh()
        self.enabled.unlink()
        self.check(fix=True, success=False, SSH_STATUS='255')
        self.assert_enabled()

    def test_directory_conflict_still_checks_ssh(self):
        self.directory.parent.mkdir(parents=True)
        self.directory.write_text('keep\n')
        self.check(fix=True, success=False)
        self.assertEqual(self.directory.read_text(), 'keep\n')
        self.assert_ssh()

    def test_symlink_is_replaced_without_changing_target(self):
        self.write_enabled()
        target = self.home / 'target'
        self.enabled.rename(target)
        self.enabled.symlink_to(target)
        before = target.stat()
        self.check(success=False)
        self.check(fix=True)
        self.assertFalse(self.enabled.is_symlink())
        self.assert_enabled()
        self.assertEqual(target.stat(), before)


if __name__ == '__main__':
    unittest.main(verbosity=2)
