#!/usr/bin/env bash
# Check this machine for owners' work, repairing what --fix can.
#
#   setup [--fix]
# shellcheck source-path=SCRIPTDIR
# shellcheck disable=SC2015 # ok and warn always succeed
set -euo pipefail

kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
workspace() {
    local agents
    agents=$(cd "$kit/../.." && pwd)
    if [[ $(basename "$agents") == agents ]]; then dirname "$agents"; else echo "$HOME/src/rust"; fi
}
root=${DEV_ROOT:-$(workspace)}
tmp=${DEV_TMP:-$root/tmp}
repos=${DEV_REPOS:-skein smith jig hearth temper qa agents}
claude_dir=${SETUP_CLAUDE_DIR:-$root}
# shellcheck source=../devel/kit.sh
source "$kit/../devel/kit.sh"

check() {
    local fix=0 failed=0
    [[ ${1:-} == --fix ]] && { fix=1; shift; }
    (($# == 0)) || { echo "usage: setup [--fix]" >&2; return 2; }
    ok() { echo "ok    $*"; }
    warn() { echo "warn  $*"; }
    fail() { echo "FAIL  $*"; failed=1; }
    # Every primary checkout: on main, clean, equal to origin's main,
    # and origin takes a push.
    # --fix fast-forwards a clean checkout that is only behind.
    local repo dir ahead behind
    for repo in $repos; do
        dir=$root/$repo
        if [[ -e $dir/.git ]]; then
            :
        elif [[ -e $dir ]]; then
            fail "$repo: $dir exists without a checkout"
            continue
        elif ((fix)); then
            if git clone --quiet --branch main "git@github.com:fabrig-ai/$repo.git" "$dir"; then
                ok "$repo: cloned $dir"
            else
                fail "$repo: cannot clone $dir"
                continue
            fi
        else
            warn "$repo: no checkout at $dir (--fix clones it)"
            continue
        fi
        if [[ $(git -C "$dir" symbolic-ref --quiet --short HEAD || true) != main ]]; then
            fail "$repo: primary checkout is not on main"
            continue
        fi
        [[ -z $(git -C "$dir" status --porcelain) ]] ||
            fail "$repo: primary checkout has changes"
        git -C "$dir" fetch --quiet origin || { fail "$repo: cannot fetch origin"; continue; }
        read -r behind ahead < <(git -C "$dir" rev-list --left-right --count origin/main...main)
        if ((fix && behind && !ahead)) && [[ -z $(git -C "$dir" status --porcelain) ]] &&
            git -C "$dir" merge --quiet --ff-only origin/main; then
            ok "$repo: main fast-forwarded $behind commits to origin/main"
            behind=0
        fi
        if ((ahead || behind)); then
            fail "$repo: main is $ahead ahead and $behind behind origin/main"
        else
            ok "$repo: main is origin/main"
        fi
        if GIT_TERMINAL_PROMPT=0 git -C "$dir" push --dry-run --quiet origin main >/dev/null 2>&1; then
            ok "$repo: origin takes a push"
        else
            fail "$repo: origin refuses a push from here: git -C $dir push --dry-run origin main"
        fi
    done

    check_records
    check_machine
    return "$failed"
}

# records is shared by sessions; setup never resets or cleans an existing checkout.
check_records() {
    local dir=${RECORDS:-$root/records}
    if [[ -e $dir/.git ]]; then
        ok "records: checkout at $dir"
    elif [[ -e $dir ]]; then
        fail "records: $dir exists without a checkout"
    elif ((fix)); then
        if git clone --quiet --branch main git@github.com:fabrig-ai/records.git "$dir"; then
            ok "records: cloned $dir"
        else
            fail "records: cannot clone $dir"
        fi
    else
        fail "records: no checkout at $dir (--fix clones it)"
    fi
}

# Heavy's user units need lingering to survive logout.
check_lingering() {
    ((!bus)) || [[ $(loginctl show-user "$USER" -p Linger --value 2>/dev/null) == yes ]] ||
        warn "no lingering: heavy's reconciler, task wrappers and payloads stop when $USER logs out (loginctl enable-linger)"
}

# Only the machine named by the director installs the paused runner's units.
check_after_landing() {
    local address_file=$HOME/.config/agents-after-landing/director
    local unit_dir=$HOME/.config/systemd/user unit=agents-after-landing@.service
    local director expected sibling repo
    local -a addresses=()
    if [[ ! -e $address_file && ! -L $address_file ]]; then
        ok "after-landing: not this machine's runner"
        if systemctl --user is-active --quiet 'agents-after-landing@*.service' 2>/dev/null; then
            warn 'after-landing: runner services active on an unassigned machine'
        fi
        return
    fi
    if ! mapfile -t addresses < "$address_file" || ((${#addresses[@]} != 1)) ||
        [[ ! ${addresses[0]} =~ ^[A-Za-z0-9/_+.-]+@[A-Za-z0-9._-]+$ ]]; then
        fail "after-landing: $address_file must hold one director address (NAME@MACHINE)"
        return
    fi
    director=${addresses[0]}
    expected=$(cat <<UNIT
[Unit]
Description=after landing's runner for %i (agents' landing-flow.md 4, step 8)

[Service]
Type=exec
ExecStart=/bin/bash -lc 'exec after-landing follow "\$1" --director "\$2"' after-landing %i $director
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
UNIT
)
    if cmp -s "$unit_dir/$unit" <(printf '%s\n' "$expected"); then
        ok "after-landing: $unit is current"
    elif ((!fix)); then
        fail "after-landing: $unit is missing or differs (--fix writes it)"
    fi
    if ((!bus)); then
        fail 'after-landing: no user bus; cannot check or start runner services'
        return
    fi
    if ((fix)); then
        if ! mkdir -p "$unit_dir" || ! sibling=$(mktemp "$unit_dir/$unit.XXXXXX"); then
            fail "after-landing: cannot prepare $unit_dir/$unit"
            return
        fi
        if ! printf '%s\n' "$expected" > "$sibling" || ! mv -f "$sibling" "$unit_dir/$unit"; then
            rm -f "$sibling"
            fail "after-landing: cannot write $unit_dir/$unit"
            return
        fi
        if ! systemctl --user daemon-reload; then
            fail 'after-landing: user daemon-reload failed'
            return
        fi
    fi
    for repo in skein smith hearth jig temper; do
        if ((fix)) && ! systemctl --user enable --now "agents-after-landing@$repo"; then
            fail "after-landing: cannot start agents-after-landing@$repo (--fix starts it)"
        elif systemctl --user is-enabled --quiet "agents-after-landing@$repo" &&
            systemctl --user is-active --quiet "agents-after-landing@$repo"; then
            ok "after-landing: $repo enabled and active"
        else
            fail "after-landing: $repo must be enabled and active (--fix starts it)"
        fi
    done
}

# Only the machine named by the director installs QA's service.
check_qa_watch() {
    local address_file=$HOME/.config/agents-qa/director
    local unit_dir=$HOME/.config/systemd/user unit=agents-qa-watch.service
    local director expected sibling
    local -a addresses=()
    if [[ ! -e $address_file && ! -L $address_file ]]; then
        ok "qa watch: not this machine's runner"
        if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
            warn 'qa watch: service active on an unassigned machine'
        fi
        return
    fi
    if ! mapfile -t addresses < "$address_file" || ((${#addresses[@]} != 1)) ||
        [[ ! ${addresses[0]} =~ ^[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*@[a-z][a-z0-9-]*$ ]]; then
        fail "qa watch: $address_file must hold one director address (NAME@MACHINE)"
        return
    fi
    director=${addresses[0]}
    expected=$(cat <<UNIT
[Unit]
Description=QA after landing's service (agents' qa-flow.md 4)

[Service]
Type=exec
ExecStart=/bin/bash -lc 'exec qa watch --director "\$1"' qa-watch $director
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
UNIT
)
    if cmp -s "$unit_dir/$unit" <(printf '%s\n' "$expected"); then
        ok "qa watch: $unit is current"
    elif ((!fix)); then
        fail "qa watch: $unit is missing or differs (--fix writes it)"
    fi
    if ((!bus)); then
        fail 'qa watch: no user bus; cannot check or start service'
        return
    fi
    if ((fix)); then
        if ! mkdir -p "$unit_dir" || ! sibling=$(mktemp "$unit_dir/$unit.XXXXXX"); then
            fail "qa watch: cannot prepare $unit_dir/$unit"
            return
        fi
        if ! printf '%s\n' "$expected" > "$sibling" || ! mv -f "$sibling" "$unit_dir/$unit"; then
            rm -f "$sibling"
            fail "qa watch: cannot write $unit_dir/$unit"
            return
        fi
        if ! systemctl --user daemon-reload; then
            fail 'qa watch: user daemon-reload failed'
            return
        fi
    fi
    if ((fix)) && ! systemctl --user enable --now "$unit"; then
        fail "qa watch: cannot start $unit (--fix starts it)"
    elif systemctl --user is-enabled --quiet "$unit" &&
        systemctl --user is-active --quiet "$unit"; then
        ok "qa watch: $unit enabled and active"
    else
        fail "qa watch: $unit must be enabled and active (--fix starts it)"
    fi
}

# The tools, the workspace's files, the queue and room to work.
check_machine() {
    # Instructions and tools come from agents alone.
    local file
    for file in "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md"; do
        [[ ! -e $file ]] || warn "$file holds instructions outside agents"
    done
    for file in "$HOME/.claude.json" "$HOME/.claude/settings.json" "$HOME/.codex/config.toml"; do
        ! grep -qs 'codebase-memory' "$file" || warn "$file names codebase-memory-mcp, which is retired"
    done
    # Tools.
    local tool
    for tool in git jq flock cargo python3 systemd-run; do
        command -v "$tool" >/dev/null && ok "has $tool" || fail "no $tool"
    done
    cargo nextest --version >/dev/null 2>&1 && ok "has cargo-nextest" || fail "no cargo-nextest"
    # The tools link to this checkout.
    local bin=$HOME/.local/bin home=$kit target
    for tool in heavy land land-set landings after-landing repin record setup post codex-run qa issue; do
        target=$home/../devel/$tool
        [[ $tool != setup ]] || target=$home/setup
        target=$(readlink -f "$target")
        if [[ ! -f $target ]]; then
            fail "missing tool file: $target"
        elif [[ $(readlink -f "$bin/$tool" 2>/dev/null) == "$target" ]]; then
            ok "$tool is on PATH"
        elif ((fix)); then
            mkdir -p "$bin" && ln -sfn "$target" "$bin/$tool" && ok "linked $bin/$tool"
        else
            fail "$bin/$tool does not link to $target (--fix links it)"
        fi
    done

    # The workspace's own files live in agents, beside setup.
    local pair link
    for pair in "$root/AGENTS.md=AGENTS.md" "$root/CLAUDE.md=CLAUDE.md" \
        "$root/.claude/settings.json=claude-settings.json"; do
        link=${pair%%=*}
        target=$home/workspace/${pair#*=}
        if [[ ! -f $target ]]; then
            fail "missing workspace file: $target"
        elif [[ $(readlink -f "$link" 2>/dev/null) == "$target" ]]; then
            ok "$link is agents'"
        elif [[ -e $link && ! -L $link ]]; then
            fail "$link is a file of its own; replace it with a link to $target"
        elif ((fix)); then
            mkdir -p "$(dirname "$link")" && ln -sfn "$target" "$link" && ok "linked $link"
        else
            fail "$link does not link to $target (--fix links it)"
        fi
    done

    # Cargo reaches the workspace's repositories on GitHub.
    if grep -qs 'git\.ekanayaka\.io' "$root"/*/Cargo.toml; then
        git config --global --get-regexp '^url\..*\.insteadof$' 2>/dev/null |
            grep -q ' https://git\.ekanayaka\.io/ai/$' &&
            ok "git rewrites git.ekanayaka.io to GitHub" ||
            fail "Cargo.toml names git.ekanayaka.io: git config --global url.git@github.com:fabrig-dev/.insteadOf https://git.ekanayaka.io/ai/"
    fi
    grep -qs 'git-fetch-with-cli *= *true' "$HOME/.cargo/config.toml" &&
        ok "cargo fetches with git" ||
        fail "cargo must fetch with git: [net] git-fetch-with-cli = true in ~/.cargo/config.toml"
    local bus=0
    systemctl --user show --property=Version >/dev/null 2>&1 && bus=1
    if grep -qs kache "$HOME/.cargo/config.toml"; then
        if ((bus)); then
            systemctl --user is-active --quiet kache && ok "kache is running" ||
                warn "kache is configured but not running"
        else
            ok "kache is configured"
        fi
        local pinned
        pinned=$(sed -n 's/^version=//p' "$kit/kache-setup")
        [[ $(kache --version 2>/dev/null) == "kache $pinned" ]] &&
            ok "kache is $pinned, the kit's pin" ||
            warn "kache is not $pinned, the kit's pin: heavy --gate -- kache-setup"
    else
        warn "no kache rustc-wrapper in ~/.cargo/config.toml"
    fi

    check_after_landing
    check_qa_watch
    check_lingering
    # Installation is explicit: setup never probes/installs a new recovery
    # mechanism while repairing an existing queue.
    local heavy=$home/../devel/heavy
    if "$heavy" --check-recovery >/dev/null 2>&1; then
        ok "heavy's independent reconciler and containment proof are ready"
    else
        fail "heavy recovery is not ready: heavy --install-reconciler"
    fi
    if apt-config dump 2>/dev/null | grep -E '^Unattended-Upgrade::Automatic-Reboot "true";' >/dev/null; then
        warn 'the machine may reboot unattended (Unattended-Upgrade::Automatic-Reboot)'
    fi
    local lane status slots slots_source line
    # The queue is heavy's ledger (build-infrastructure.md, 2 and 4).
    read -r slots slots_source < <(machine_setting HEAVY_BUILD_SLOTS 0)
    while IFS= read -r line; do warn "machine.env: ignored line $line"; done < <(
        awk 'NF && $0 !~ /^(PLAN_MIN_MEM_GB|PLAN_MIN_DISK_GB|HEAVY_BUILD_SLOTS|HEAVY_BUILD_JOBS|KACHE_MAX_GB|QA_SLOTS|QA_BATCH|QA_CAP_MINUTES|QA_INTERVAL_SECONDS)=[0-9]+$/ { print NR ": " $0 }' "$tmp/machine.env" 2>/dev/null || true)
    if [[ $slots == 0 ]]; then
        ok "builds: every task at once ($slots_source)"
    else
        ok "builds: $slots at once ($slots_source)"
    fi
    for lane in gate build; do
        if "$heavy" --group-held "$lane"; then
            ok "queue lane $lane is held by heavy"
        else
            status=$?
            if ((status == 1)); then
                ok "queue lane $lane admits"
            else
                fail "heavy cannot report lane $lane: heavy --reconcile says why"
            fi
        fi
    done

    # Room to work.
    local disk mem disk_min disk_source mem_min mem_source
    read -r disk_min disk_source < <(machine_setting PLAN_MIN_DISK_GB 40)
    read -r mem_min mem_source < <(machine_setting PLAN_MIN_MEM_GB 6)
    disk=$(df -BG --output=avail "$root" | tail -n1 | tr -dc 0-9)
    mem=$(awk '/MemAvailable/ { print int($2 / 1048576) }' /proc/meminfo)
    ((disk >= disk_min)) && ok "disk: ${disk} GB free, want $disk_min ($disk_source)" ||
        fail "disk: ${disk} GB free, want $disk_min ($disk_source)"
    ((mem >= mem_min)) && ok "memory: ${mem} GB available, want $mem_min ($mem_source)" ||
        fail "memory: ${mem} GB available, want $mem_min ($mem_source)"

    # Claude Code trusts the workspace directory.
    if command -v claude >/dev/null; then
        jq -e --arg d "$claude_dir" '.projects[$d].hasTrustDialogAccepted == true' "$HOME/.claude.json" >/dev/null 2>&1 &&
            ok "Claude Code trusts $claude_dir" ||
            fail "Claude Code does not trust $claude_dir: run claude there once, and accept"
    else
        fail "no claude"
    fi
}

check "$@"
