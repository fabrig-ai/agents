#!/usr/bin/env python3
"""Exercise setup's runner check with scratch homes and a fake service manager."""
import json
import os
from pathlib import Path
import shlex
import subprocess
import tempfile
import unittest

os.umask(0o077)
KIT = Path(__file__).resolve().parent
WHOLE = ['skein', 'smith', 'hearth', 'jig', 'temper']
UNIT = 'agents-after-landing@.service'
SYSTEMCTL = '''#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys

args = sys.argv[1:]
with open(os.environ['FIXTURE_TRACE'], 'a') as trace:
    trace.write(json.dumps(args) + '\\n')
assert args[0] == '--user', args
op, *tail = args[1:]
if op == os.environ.get('FIXTURE_FAIL'):
    sys.exit(1)
path = Path(os.environ['FIXTURE_STATE'])
state = json.loads(path.read_text())
if op == 'show':
    assert tail == ['--property=Version'], tail
    print('Version=fixture')
elif op == 'daemon-reload':
    assert not tail, tail
elif op == 'list-units':
    assert tail == ['--all', '--plain', '--no-legend', 'agents-after-landing@*'], tail
    for name, flags in state.items():
        if flags.get('loaded', True):
            active = 'active running' if flags['active'] else 'inactive dead'
            print(f'agents-after-landing@{name}.service loaded {active} fixture')
elif op == 'list-unit-files':
    assert tail == ['--plain', '--no-legend', 'agents-after-landing@*'], tail
    print('agents-after-landing@.service disabled enabled')
    for name, flags in state.items():
        status = 'enabled' if flags['enabled'] else 'disabled'
        print(f'agents-after-landing@{name}.service {status} enabled')
elif op in ('is-enabled', 'is-active'):
    assert len(tail) == 2 and tail[0] == '--quiet', tail
    name = tail[1].removeprefix('agents-after-landing@').removesuffix('.service')
    key = 'enabled' if op == 'is-enabled' else 'active'
    found = any(flags[key] for flags in state.values()) if name == '*' else state.get(name, {}).get(key, False)
    sys.exit(0 if found else 1)
elif op in ('enable', 'disable'):
    assert len(tail) == 2 and tail[0] == '--now', tail
    name = tail[1].removeprefix('agents-after-landing@')
    state[name] = dict(enabled=op == 'enable', active=op == 'enable')
    path.write_text(json.dumps(state))
else:
    raise AssertionError(args)
'''
DRIVER = '''#!/bin/bash
set -euo pipefail
fix=$1 failed=0 bus=0
ok() { echo "ok    $*"; }
warn() { echo "warn  $*"; }
fail() { echo "FAIL  $*"; failed=1; }
source "$2"
systemctl --user show --property=Version >/dev/null 2>&1 && bus=1
check_after_landing
exit "$failed"
'''


class AfterLandingUnits(unittest.TestCase):
    def setUp(self):
        scratch = tempfile.TemporaryDirectory(prefix='after-landing-units-')
        self.addCleanup(scratch.cleanup)
        self.root = Path(scratch.name)
        self.home, self.bin = self.root / 'home', self.root / 'bin'
        self.bin.mkdir()
        self.config = self.home / '.config/agents-after-landing'
        self.config.mkdir(parents=True)
        (self.config / 'director').write_text('d@x\n')
        self.unit = self.home / '.config/systemd/user' / UNIT
        self.state = self.root / 'state.json'
        self.state.write_text('{}')
        self.trace = self.root / 'calls'
        self.driver = self.root / 'check'
        self.driver.write_text(DRIVER)
        systemctl = self.bin / 'systemctl'
        systemctl.write_text(SYSTEMCTL)
        systemctl.chmod(0o700)
        self.env = dict(os.environ, HOME=str(self.home),
                        PATH=f'{self.bin}:/usr/bin:/bin',
                        FIXTURE_STATE=str(self.state), FIXTURE_TRACE=str(self.trace))
        self.env.pop('FIXTURE_FAIL', None)
        for key in ('BASH_ENV', 'ENV', 'SHELLOPTS', 'BASHOPTS', 'CDPATH'):
            self.env.pop(key, None)

    def follow(self, text):
        (self.config / 'follow').write_text(text)

    def instances(self, names):
        self.state.write_text(json.dumps({name: dict(enabled=True, active=True) for name in names}))

    def check(self, fix=False, success=True, fault=None):
        env = self.env | ({'FIXTURE_FAIL': fault} if fault else {})
        result = subprocess.run(['/bin/bash', self.driver, str(int(fix)), KIT / 'after-landing-units'],
                                env=env, capture_output=True, text=True)
        self.assertEqual(result.returncode, 0 if success else 1, (result.stdout, result.stderr))
        self.assertEqual(result.stderr, '')
        return result.stdout.splitlines()

    def calls(self, op=None):
        calls = [json.loads(line) for line in self.trace.read_text().splitlines()]
        return [call for call in calls if op is None or call[1] == op]

    def mutations(self):
        return [call for call in self.calls() if call[1] in ('enable', 'disable', 'daemon-reload')]

    def reset_trace(self):
        self.trace.write_text('')

    def test_whole_by_default(self):
        expected = [f'ok    after-landing: {name} enabled and active' for name in WHOLE]
        self.assertEqual(self.check(fix=True), expected)
        self.assertTrue(self.unit.exists())
        self.assertEqual(self.calls('enable'), [['--user', 'enable', '--now', f'agents-after-landing@{name}'] for name in WHOLE])
        self.reset_trace()
        self.assertEqual(self.check(), [f'ok    after-landing: {UNIT} is current'] + expected)
        self.assertEqual(self.mutations(), [])

    def test_parts_listed(self):
        names = WHOLE[:-1] + ['temper.1of2', 'temper.2of2']
        self.instances(WHOLE)
        self.follow('\n# assigned here\n  # another comment\n' + '\n'.join(name + (' 60' if name == 'temper.1of2' else '') for name in names) + '\n')
        lines = self.check(fix=True)
        self.assertEqual(lines, ['ok    after-landing: temper stopped: not followed here'] +
                         [f'ok    after-landing: {name} enabled and active' for name in names])
        self.assertEqual(self.calls('enable'), [['--user', 'enable', '--now', f'agents-after-landing@{name}'] for name in names])
        self.assertEqual(self.calls('disable'), [['--user', 'disable', '--now', 'agents-after-landing@temper']])
        self.reset_trace()
        self.check()
        self.assertEqual(self.mutations(), [])

    def test_unit_command(self):
        self.check(fix=True)
        command = next(line.removeprefix('ExecStart=') for line in self.unit.read_text().splitlines()
                       if line.startswith('ExecStart='))
        after_landing = self.bin / 'after-landing'
        after_landing.write_text('#!/usr/bin/env python3\nimport json, sys\nprint(json.dumps(sys.argv[1:]))\n')
        after_landing.chmod(0o700)
        # Login shells load PATH from their profile, as they do on a runner.
        (self.home / '.bash_profile').write_text('export PATH=' + shlex.quote(self.env['PATH']) + '\n')
        for name, expected in [
            ('temper.1of2', ['follow', 'temper', '--part', '1/2', '--director', 'd@x']),
            ('skein', ['follow', 'skein', '--director', 'd@x']),
        ]:
            with self.subTest(name=name):
                # Systemd consumes doubled dollars/percents once, before bash.
                argv = shlex.split(command.replace('$$', '$').replace('%%', '%').replace('%i', name))
                self.assertEqual(argv[:2], ['/bin/bash', '-lc'])
                result = subprocess.run(argv, env=self.env, capture_output=True, text=True)
                self.assertEqual(result.returncode, 0, (result.stdout, result.stderr))
                self.assertEqual(json.loads(result.stdout), expected)

    def test_unlisted_fails_without_fix(self):
        self.check(fix=True)
        self.instances(WHOLE + ['temper.1of2'])
        self.reset_trace()
        before = self.unit.read_bytes(), self.state.read_bytes()
        self.assertIn('FAIL  after-landing: temper.1of2 runs but is not followed here (--fix stops it)',
                      self.check(success=False))
        self.assertEqual(self.mutations(), [])
        self.assertEqual((self.unit.read_bytes(), self.state.read_bytes()), before)

    def test_bad_follow_lines(self):
        for text, line, name in [
            ('skein\ntemper.1of1\n', 2, 'temper.1of1'),
            ('skein\ntemper.3of2\n', 2, 'temper.3of2'),
            ('# comment\n\nTemper\n', 3, 'Temper'),
            ('skein\ntemper 1of2\n', 2, 'temper 1of2'),
            ('skein\n# comment\nskein\n', 3, 'skein'),
            ('temper 0\n', 1, 'temper 0'),
            ('temper x\n', 1, 'temper x'),
            ('temper 60 70\n', 1, 'temper 60 70'),
            ('temper -5\n', 1, 'temper -5'),
            ('temper.0of2\n', 1, 'temper.0of2'),
            ('temper.01of2\n', 1, 'temper.01of2'),
            ('temper.2of02\n', 1, 'temper.2of02'),
            ('temper.100of99\n', 1, 'temper.100of99'),
            ('temper.9223372036854775809of9223372036854775808\n', 1,
             'temper.9223372036854775809of9223372036854775808'),
        ]:
            with self.subTest(name=name):
                self.instances(['temper'])
                before = self.state.read_bytes()
                self.follow(text)
                for fix in (False, True):
                    self.reset_trace()
                    self.assertEqual(self.check(fix=fix, success=False),
                                     [f"FAIL  after-landing: {self.config / 'follow'} line {line}: {name} is not a follower's name"])
                    self.assertFalse(self.unit.exists())
                    self.assertEqual(self.mutations(), [])
                    self.assertEqual(self.state.read_bytes(), before)

    def test_non_file_follow(self):
        self.check(fix=True)
        follow = self.config / 'follow'
        before = self.unit.read_bytes(), self.state.read_bytes()
        for kind in ('directory', 'directory-link', 'broken-link', 'fifo'):
            with self.subTest(kind=kind):
                if kind == 'directory':
                    follow.mkdir()
                elif kind == 'directory-link':
                    follow.symlink_to(self.root, target_is_directory=True)
                elif kind == 'broken-link':
                    follow.symlink_to(self.root / 'missing')
                else:
                    os.mkfifo(follow)
                self.reset_trace()
                self.assertEqual(self.check(fix=True, success=False),
                                 [f'FAIL  after-landing: cannot read {follow}'])
                self.assertEqual(self.mutations(), [])
                self.assertEqual((self.unit.read_bytes(), self.state.read_bytes()), before)
                if kind == 'directory':
                    follow.rmdir()
                else:
                    follow.unlink()

    def test_not_the_runner(self):
        (self.config / 'director').unlink()
        self.follow('invalid name\n')
        for fix in (False, True):
            with self.subTest(fix=fix):
                self.reset_trace()
                self.assertEqual(self.check(fix=fix), ["ok    after-landing: not this machine's runner"])
                self.assertFalse(self.unit.exists())
                self.assertEqual(self.mutations(), [])
        self.instances(['temper'])
        self.assertEqual(self.check(), ["ok    after-landing: not this machine's runner",
                                      'warn  after-landing: runner services active on an unassigned machine'])

    def test_enabled_or_running_unlisted(self):
        self.follow('skein\n')
        self.state.write_text(json.dumps({
            'smith': dict(enabled=True, active=False, loaded=False),
            'temper': dict(enabled=False, active=True),
            'hearth': dict(enabled=False, active=False),
        }))
        lines = self.check(fix=True)
        self.assertEqual(set(call[-1] for call in self.calls('disable')),
                         {'agents-after-landing@smith', 'agents-after-landing@temper'})
        self.assertEqual(len(self.calls('disable')), 2)
        self.assertEqual(lines[-1], 'ok    after-landing: skein enabled and active')

    def test_empty_follow(self):
        self.follow('# no followers here\n  \n')
        self.instances(WHOLE)
        self.check(fix=True)
        self.assertEqual(len(self.calls('disable')), 5)
        self.assertEqual(self.calls('enable'), [])

    def test_large_part_numbers(self):
        name = 'tier-2.9223372036854775808of9223372036854775809'
        self.follow(name)  # A final newline is optional.
        self.assertEqual(self.check(fix=True), [f'ok    after-landing: {name} enabled and active'])

    def test_service_manager_failures(self):
        self.follow('skein\n')
        for fault in ('list-units', 'list-unit-files'):
            with self.subTest(fault=fault):
                self.reset_trace()
                self.assertEqual(self.check(fix=True, success=False, fault=fault),
                                 ['FAIL  after-landing: cannot list runner services'])
                self.assertFalse(self.unit.exists())
                self.assertEqual(self.mutations(), [])
        self.assertEqual(self.check(fix=True, success=False, fault='daemon-reload'),
                         ['FAIL  after-landing: user daemon-reload failed'])
        self.assertEqual(self.calls('enable'), [])
        self.assertEqual(self.calls('disable'), [])
        self.instances(['temper'])
        self.reset_trace()
        self.assertIn('FAIL  after-landing: cannot stop agents-after-landing@temper (--fix stops it)',
                      self.check(fix=True, success=False, fault='disable'))
        self.assertTrue(json.loads(self.state.read_text())['temper']['active'])
        self.reset_trace()
        self.assertIn('FAIL  after-landing: cannot start agents-after-landing@skein (--fix starts it)',
                      self.check(fix=True, success=False, fault='enable'))

    def test_no_bus(self):
        self.follow('skein\n')
        self.assertEqual(self.check(fix=True, success=False, fault='show'),
                         ['FAIL  after-landing: no user bus; cannot check or start runner services'])
        self.assertFalse(self.unit.exists())
        self.assertEqual(self.mutations(), [])


if __name__ == '__main__':
    unittest.main(verbosity=2)
