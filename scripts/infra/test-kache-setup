#!/usr/bin/env python3
"""Exercise setup with an isolated home, binary and service manager."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import tomllib

os.umask(0o077)
KIT = Path(__file__).resolve().parent


def main():
    with tempfile.TemporaryDirectory(prefix='kache-setup-', dir=os.environ.get('DEV_TMP')) as scratch:
        root = Path(scratch)
        home, stubs = root / 'home', root / 'bin'
        stubs.mkdir()
        config = home / '.config/kache/config.toml'
        config.parent.mkdir(parents=True)
        key = config.with_name('store.env')
        dropin = home / '.config/systemd/user/kache.service.d/20-shared-store.conf'
        trace = root / 'calls'
        env = dict(os.environ, HOME=str(home), DEV_ROOT=str(root), DEV_TMP=str(root),
                   PATH=str(stubs) + ':/usr/bin:/bin', FIXTURE_TRACE=str(trace))
        env.pop('KACHE_MAX_GB', None)
        env.pop('PLAN_MIN_DISK_GB', None)
        env.pop('KACHE_LOCAL_ONLY', None)
        for name, body in {
            'systemctl': 'echo "service $*" >>"$FIXTURE_TRACE"\n',
            'sleep': 'exit 0\n',
            # Read the digest line as the real one does: exiting first breaks
            # setup's pipe under load.
            'sha256sum': 'cat >/dev/null\n[[ $* == "-c --quiet" ]]\n',
            # Fault only the owner metadata, without changing real ownership.
            'stat': 'if [[ ${FIXTURE_OWNER:-} == wrong && $* == "-c %u "* ]]; then echo 999999; else exec /usr/bin/stat "$@"; fi\n',
        }.items():
            path = stubs / name
            path.write_text('#!/bin/bash\nset -eu\n' + body)
            path.chmod(0o700)
        artifact = root / 'kache/kache-1.2.2-gitrev.2'
        artifact.parent.mkdir()
        artifact.write_text('#!/bin/bash\nset -eu\n'
                            'echo "kache $*" >>"$FIXTURE_TRACE"\n'
                            'if [[ $* == --version ]]; then echo kache 1.2.2-gitrev.2; fi\n')
        artifact.chmod(0o700)
        binary = home / '.local/bin/kache'
        binary.parent.mkdir(parents=True)
        binary.symlink_to(artifact)

        def setup(extra=None, success=True):
            result = subprocess.run([KIT / 'kache-setup'], env=env | (extra or {}),
                                    capture_output=True, text=True)
            if success:
                assert result.returncode == 0, (result.stdout, result.stderr)
            else:
                assert result.returncode == 2 and 'owned by the current user with mode 0600' in result.stderr
            return result

        # A fresh machine needs no prior config; the same version keeps its store.
        setup()
        cache = tomllib.loads(config.read_text())['cache']
        assert 'remote_upload_max_bytes' not in cache
        assert 'remote' not in cache
        assert cache['cache_executables'] is True and cache['prefetch_enabled'] is False
        assert not dropin.exists()
        assert 'clean' not in trace.read_text()

        assert cache['local_only'] is False
        assert cache['local_max_size'] == '12GiB'
        assert cache['auto_gc'] is True and cache['gc_evict_shared'] is True
        assert cache['auto_recover_min_free_bytes'] == 52 * 1024**3

        # Migrate an over-cap configuration without clearing a same-version store.
        machine = root / 'machine.env'
        machine.write_text('KACHE_MAX_GB=20\nPLAN_MIN_DISK_GB=40\nKACHE_LOCAL_ONLY=1\n')
        config.write_text('[cache]\nlocal_max_size = "20GiB"\ngc_evict_shared = false\n'
                          'auto_recover_min_free_bytes = 42949672960\n')
        setup()
        cache = tomllib.loads(config.read_text())['cache']
        assert cache['local_only'] is True
        assert cache['local_max_size'] == '20GiB'
        assert cache['auto_gc'] is True and cache['gc_evict_shared'] is True
        assert cache['auto_recover_min_free_bytes'] == 60 * 1024**3
        assert 'clean' not in trace.read_text()
        for cap, floor, reserve in [(7, 55, 62), (0, 40, 41)]:
            setup({'KACHE_MAX_GB': str(cap), 'PLAN_MIN_DISK_GB': str(floor)})
            cache = tomllib.loads(config.read_text())['cache']
            assert cache['local_max_size'] == f'{cap}GiB'
            assert cache['auto_recover_min_free_bytes'] == reserve * 1024**3
        setup()

        for setting, expected in [('0', False), ('false', False), ('1', True), ('true', True)]:
            setup({'KACHE_LOCAL_ONLY': setting})
            assert tomllib.loads(config.read_text())['cache']['local_only'] is expected
        calls = trace.read_bytes()
        before_local = config.read_bytes()
        rejected = subprocess.run([KIT / 'kache-setup'],
                                  env=env | {'KACHE_LOCAL_ONLY': 'invalid'},
                                  capture_output=True, text=True)
        assert rejected.returncode == 2 and 'KACHE_LOCAL_ONLY' in rejected.stderr
        assert trace.read_bytes() == calls and config.read_bytes() == before_local
        setup()

        # A key enables both config and service; setup only inspects its metadata.
        key.touch(mode=0o600)
        config.write_text('[cache]\nlocal_store = "/fixture/large-disk"\n')
        setup()
        cache = tomllib.loads(config.read_text())['cache']
        assert cache['local_store'] == '/fixture/large-disk'
        assert cache['local_only'] is True
        assert cache['remote_upload_max_bytes'] == 67108864
        assert cache['remote'] == dict(type='s3', bucket='kache',
                                      endpoint='http://10.80.0.13:3900',
                                      region='garage', prefix='artifacts')
        assert dropin.read_text().endswith('EnvironmentFile=%h/.config/kache/store.env\n')
        before = config.read_bytes(), dropin.read_bytes()
        setup()
        assert (config.read_bytes(), dropin.read_bytes()) == before

        # Refusal precedes daemon shutdown and every configuration mutation.
        calls = trace.read_bytes()
        key.chmod(0o640)
        setup(success=False)
        key.chmod(0o600)
        setup({'FIXTURE_OWNER': 'wrong'}, success=False)
        assert trace.read_bytes() == calls
        assert (config.read_bytes(), dropin.read_bytes()) == before

        # Removing the key removes both remote selectors, retaining local settings.
        key.unlink()
        setup()
        cache = tomllib.loads(config.read_text())['cache']
        assert 'remote_upload_max_bytes' not in cache
        assert 'remote' not in cache and cache['local_store'] == '/fixture/large-disk'
        assert not dropin.exists()
        assert config.read_text().startswith("# Written by agents' scripts/infra/kache-setup.\n")

        # Discover the workspace from agents/scripts/infra, with HOME elsewhere.
        workspace = root / 'workspace'
        moved = workspace / 'agents/scripts/infra'
        moved.mkdir(parents=True)
        shutil.copy2(KIT / 'kache-setup', moved / 'kache-setup')
        devel = moved.parent / 'devel'
        devel.mkdir()
        shutil.copy2(KIT / '../devel/kit.sh', devel / 'kit.sh')
        discovered = workspace / 'tmp/kache' / artifact.name
        discovered.parent.mkdir(parents=True)
        shutil.copy2(artifact, discovered)
        discovery_env = {key: value for key, value in env.items() if key not in ('DEV_ROOT', 'DEV_TMP')}
        result = subprocess.run([moved / 'kache-setup'], env=discovery_env,
                                capture_output=True, text=True)
        assert result.returncode == 0, (result.stdout, result.stderr)
        print('test-kache-setup: passed (local, cap migration, recovery headroom, overrides, offline mode, invalid mode, remote, repeat, mode, owner, removal)')


if __name__ == '__main__':
    main()
