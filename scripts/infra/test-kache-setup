#!/usr/bin/env python3
"""Exercise setup with an isolated home, binary and service manager."""
import os
from pathlib import Path
import subprocess
import tempfile
import tomllib

os.umask(0o077)
KIT = Path(__file__).resolve().parent


def main():
    with tempfile.TemporaryDirectory(prefix='kache-setup-', dir=os.environ.get('DEV_TMP')) as scratch:
        root = Path(scratch)
        home, stubs = root / 'home', root / 'bin'
        stubs.mkdir()
        config = home / '.config/kache/config.toml'
        config.parent.mkdir(parents=True)
        key = config.with_name('store.env')
        dropin = home / '.config/systemd/user/kache.service.d/20-shared-store.conf'
        trace = root / 'calls'
        env = dict(os.environ, HOME=str(home), DEV_ROOT=str(root), DEV_TMP=str(root),
                   PATH=str(stubs) + ':/usr/bin:/bin', FIXTURE_TRACE=str(trace))
        env.pop('KACHE_MAX_GB', None)
        env.pop('PLAN_MIN_DISK_GB', None)
        for name, body in {
            'systemctl': 'echo "service $*" >>"$FIXTURE_TRACE"\n',
            'sleep': 'exit 0\n',
            'sha256sum': '[[ $* == "-c --quiet" ]]\n',
            # Fault only the owner metadata, without changing real ownership.
            'stat': 'if [[ ${FIXTURE_OWNER:-} == wrong && $* == "-c %u "* ]]; then echo 999999; else exec /usr/bin/stat "$@"; fi\n',
        }.items():
            path = stubs / name
            path.write_text('#!/bin/bash\nset -eu\n' + body)
            path.chmod(0o700)
        artifact = root / 'kache/kache-1.2.2-gitrev.1'
        artifact.parent.mkdir()
        artifact.write_text('#!/bin/bash\nset -eu\n'
                            'echo "kache $*" >>"$FIXTURE_TRACE"\n'
                            'if [[ $* == --version ]]; then echo kache 1.2.2-gitrev.1; fi\n')
        artifact.chmod(0o700)
        binary = home / '.local/bin/kache'
        binary.parent.mkdir(parents=True)
        binary.symlink_to(artifact)

        def setup(extra=None, success=True):
            result = subprocess.run([KIT / 'kache-setup'], env=env | (extra or {}),
                                    capture_output=True, text=True)
            if success:
                assert result.returncode == 0, (result.stdout, result.stderr)
            else:
                assert result.returncode == 2 and 'owned by the current user with mode 0600' in result.stderr
            return result

        # A fresh machine needs no prior config; the same version keeps its store.
        setup()
        assert 'remote' not in tomllib.loads(config.read_text())['cache']
        assert not dropin.exists()
        assert 'clean' not in trace.read_text()

        # A key enables both config and service; setup only inspects its metadata.
        key.touch(mode=0o600)
        config.write_text('[cache]\nlocal_store = "/fixture/large-disk"\n')
        setup()
        cache = tomllib.loads(config.read_text())['cache']
        assert cache['local_store'] == '/fixture/large-disk'
        assert cache['remote'] == dict(type='s3', bucket='kache',
                                      endpoint='http://10.80.0.13:3900',
                                      region='garage', prefix='artifacts')
        assert dropin.read_text().endswith('EnvironmentFile=%h/.config/kache/store.env\n')
        before = config.read_bytes(), dropin.read_bytes()
        setup()
        assert (config.read_bytes(), dropin.read_bytes()) == before

        # Refusal precedes daemon shutdown and every configuration mutation.
        calls = trace.read_bytes()
        key.chmod(0o640)
        setup(success=False)
        key.chmod(0o600)
        setup({'FIXTURE_OWNER': 'wrong'}, success=False)
        assert trace.read_bytes() == calls
        assert (config.read_bytes(), dropin.read_bytes()) == before

        # Removing the key removes both remote selectors, retaining local settings.
        key.unlink()
        setup()
        cache = tomllib.loads(config.read_text())['cache']
        assert 'remote' not in cache and cache['local_store'] == '/fixture/large-disk'
        assert not dropin.exists()
        print('test-kache-setup: passed (local, remote, repeat, mode, owner, removal)')


if __name__ == '__main__':
    main()
