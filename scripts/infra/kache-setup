#!/usr/bin/env bash
# Install the build cache, kache, at the version the kit pins, and set it up
# (owners.md, 4.5): run it on each machine through the gate lane, which
# waits for every running task, a gate's among them, so that no build is
# running while its wrapper is swapped and its store cleared (heavy's
# --exclusive alone waits for no gate):
#
#   heavy --gate -- kache-setup
#
# It downloads the pinned release, checks it against its digest, and swaps
# ~/.local/bin/kache by rename (and ~/bin/kache, an older install's path, for
# a link to it). It points cargo's rustc-wrapper at that path, writes the
# store's cap (the machine file's KACHE_MAX_GB, 12 unless it says otherwise)
# and the disk floor (PLAN_MIN_DISK_GB) into kache's config, starts its
# daemon as a user service. From 1.2, kache collects its own store past its
# cap; a timer that collected the older one's is kept running. A store of
# another version is cleared, since its keys no longer match. Run again, it
# changes nothing that is already right.
set -euo pipefail

version=1.2.2
asset=kache-x86_64-unknown-linux-musl.tar.gz
digest=f2f6555dee50945c2a90a7fb793c2084a00cc6459d08ac2306d38d905064321b

kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
workspace() {
    local skein
    skein=$(cd "$kit/../.." && pwd)
    if [[ $(basename "$skein") == skein ]]; then dirname "$skein"; else echo "$HOME/src/rust"; fi
}
root=${DEV_ROOT:-$(workspace)}
# shellcheck disable=SC2034 # kit.sh reads it
tmp=${DEV_TMP:-$root/tmp}
# shellcheck source=kit.sh
source "$kit/kit.sh"

[[ $(uname -m) == x86_64 ]] || { echo "kache-setup: only x86_64 has a pinned release" >&2; exit 2; }
read -r cap _ < <(machine_setting KACHE_MAX_GB 12)
read -r floor _ < <(machine_setting PLAN_MIN_DISK_GB 40)

bin=$HOME/.local/bin/kache
installed=$("$bin" --version 2>/dev/null || true)

# The release, kept beside earlier ones under ~/.local/share/kache.
share=$HOME/.local/share/kache/$version
if [[ ! -x $share/kache ]]; then
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    curl -fsSL -o "$work/$asset" "https://github.com/kunobi-ninja/kache/releases/download/v$version/$asset"
    echo "$digest  $work/$asset" | sha256sum -c --quiet
    tar -xzf "$work/$asset" -C "$work"
    mkdir -p "$share"
    install -m 755 "$(find "$work" -type f -name kache | head -n1)" "$share/.kache.new"
    mv -f "$share/.kache.new" "$share/kache"
fi
[[ $("$share/kache" --version) == "kache $version" ]]

unit=$HOME/.config/systemd/user/kache.service
systemctl --user stop kache.service 2>/dev/null || true
pkill -u "$(id -u)" -f 'kache daemon run' || true

mkdir -p "${bin%/*}"
cp "$share/kache" "${bin%/*}/.kache.new" && mv -f "${bin%/*}/.kache.new" "$bin"
if [[ -e $HOME/bin/kache || -L $HOME/bin/kache ]]; then
    ln -sfn "$bin" "$HOME/bin/.kache.new" && mv -fT "$HOME/bin/.kache.new" "$HOME/bin/kache"
fi
# An older install through mise would put its own kache on PATH beside it.
if grep -qs 'kache' "$HOME/.config/mise/config.toml"; then
    sed -i '/kache/d' "$HOME/.config/mise/config.toml"
fi

# cargo's wrapper names the binary by its path, so no other kache on PATH
# runs in its place.
cargo=$HOME/.cargo/config.toml
mkdir -p "${cargo%/*}"
if grep -qs '^rustc-wrapper' "$cargo"; then
    sed -i "s|^rustc-wrapper *=.*|rustc-wrapper = \"$bin\"|" "$cargo"
elif grep -qs '^\[build\]' "$cargo"; then
    sed -i "s|^\[build\]|[build]\nrustc-wrapper = \"$bin\"|" "$cargo"
else
    printf '[build]\nrustc-wrapper = "%s"\n' "$bin" >>"$cargo"
fi

config=$HOME/.config/kache/config.toml
mkdir -p "${config%/*}"
[[ ! -f $config || -f $config.before-$version ]] || cp "$config" "$config.before-$version"
cat >"$config.new" <<TOML
# Written by skein's scripts/dev/kache-setup.
[cache]
local_max_size = "${cap}GiB"
cache_executables = true
auto_recover_min_free_bytes = $((floor * 1024 * 1024 * 1024))
TOML
mv -f "$config.new" "$config"

mkdir -p "${unit%/*}"
cat >"$unit.new" <<UNIT
# Written by skein's scripts/dev/kache-setup.
[Unit]
Description=kache build cache daemon

[Service]
Type=simple
ExecStart=$bin daemon run
Restart=always
RestartSec=5s
Environment=KACHE_LOG=kache=info

[Install]
WantedBy=default.target
UNIT
mv -f "$unit.new" "$unit"
systemctl --user daemon-reload
systemctl --user enable --quiet kache.service

if [[ $installed != "kache $version" ]]; then
    "$bin" clean --cache --yes
fi
systemctl --user start kache.service
# The older kache's collection timer, if the machine has one, stays as a
# backstop until 1.2's own collection has held the cap through a full gate.
if systemctl --user cat kache-gc.timer >/dev/null 2>&1; then
    systemctl --user enable --now --quiet kache-gc.timer
fi
sleep 2
systemctl --user is-active --quiet kache.service || { echo "kache-setup: kache.service is not running" >&2; exit 1; }
echo "kache-setup: $("$bin" --version) (was ${installed:-none}), store cap ${cap} GiB, disk floor ${floor} GB"
