#!/usr/bin/env bash
# Rebuild the fleet's static x86_64 kache in a new scratch directory.
# Usage: scripts/infra/kache/build /absolute/new-directory
# Fetch into scratch; heavy queues every compiler and header build.
set -euo pipefail
umask 077
kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
base=96052b4842239bb216f6c4812054203c21550788
pinned=93f8551e8f1deedfab30118957d5450e2204b4a09a9cd951e092426c096839a3
musl_digest=a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4

if [[ ${1:-} != --queued ]]; then
    [[ $# == 1 && $1 == /* && ! -e $1 ]] || {
        echo "usage: $0 /absolute/new-directory (must not exist)" >&2; exit 2;
    }
    [[ $(uname -m) == x86_64 ]] || { echo 'kache/build: x86_64 only' >&2; exit 2; }
    for tool in heavy git curl tar make clang ar rustup sha256sum readelf; do
        command -v "$tool" >/dev/null || { echo "kache/build: missing $tool" >&2; exit 2; }
    done
    rustup target list --installed --toolchain 1.95.0 | grep -qx x86_64-unknown-linux-musl || {
        echo 'kache/build: requires installed Rust 1.95.0 and its x86_64-unknown-linux-musl target' >&2; exit 2;
    }
    work=$1
    mkdir -p "$work/source" "$work/cargo-home" "$work/out"
    git -C "$work/source" init -q
    git -C "$work/source" fetch --depth 1 https://github.com/kunobi-ninja/kache.git "$base"
    git -C "$work/source" checkout -q --detach FETCH_HEAD
    [[ $(git -C "$work/source" rev-parse HEAD) == "$base" ]]
    git -C "$work/source" apply --check "$kit/git-checkout-rev.patch"
    git -C "$work/source" apply "$kit/git-checkout-rev.patch"
    curl --fail --silent --show-error --location --connect-timeout 10 --max-time 120 --retry 2 https://musl.libc.org/releases/musl-1.2.5.tar.gz -o "$work/musl.tar.gz"
    echo "$musl_digest  $work/musl.tar.gz" | sha256sum -c --quiet
    tar -xzf "$work/musl.tar.gz" -C "$work"
    exec heavy -- "$kit/build" --queued "$work"
fi

# Only the queued payload compiles. Rust supplies musl's libc and linker;
# musl's source supplies headers for native dependencies such as ring.
[[ $# == 2 ]] || exit 2
work=$2
musl=$work/musl-1.2.5
make -C "$musl" ARCH=x86_64 obj/include/bits/alltypes.h obj/include/bits/syscall.h
resource=$(clang -print-resource-dir)
{
    printf '#!/usr/bin/env bash\nexec '
    printf '%q ' "$(command -v clang)" --target=x86_64-unknown-linux-musl -nostdinc \
        -isystem "$resource/include" -isystem "$musl/obj/include" \
        -isystem "$musl/arch/x86_64" -isystem "$musl/arch/generic" -isystem "$musl/include"
    printf '"$@"\n'
} >"$work/clang-musl"
chmod 700 "$work/clang-musl"
compiler=$(rustup which --toolchain 1.95.0 rustc)
toolchain=$(dirname "$(dirname "$compiler")")
export RUSTUP_TOOLCHAIN=1.95.0 RUSTC_WRAPPER='' CARGO_HOME="$work/cargo-home"
unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS RUSTC_WORKSPACE_WRAPPER
export RUSTC="$compiler" CARGO_INCREMENTAL=0
export CARGO_TARGET_DIR="$work/target" CARGO_BUILD_JOBS=2
export CC_x86_64_unknown_linux_musl="$work/clang-musl"
export AR_x86_64_unknown_linux_musl
AR_x86_64_unknown_linux_musl=$(command -v ar)
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER="$toolchain/lib/rustlib/x86_64-unknown-linux-gnu/bin/rust-lld"
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_RUSTFLAGS='-C target-feature=+crt-static -C linker-flavor=ld.lld -C link-self-contained=yes'
cd "$work/source"
cargo build --locked --release --bin kache --target x86_64-unknown-linux-musl -j2
install -m 755 "$work/target/x86_64-unknown-linux-musl/release/kache" "$work/out/kache"
[[ $("$work/out/kache" --version) == 'kache 1.2.2-gitrev.1' ]]
if readelf -l "$work/out/kache" | grep -q INTERP; then
    echo 'kache/build: unexpected dynamic interpreter' >&2; exit 1;
fi
sha256sum "$work/out/kache" | tee "$work/out/SHA256SUMS"
read -r actual _ <"$work/out/SHA256SUMS"
if [[ $actual == "$pinned" ]]; then
    echo 'kache/build: matches the pinned digest'
else
    echo 'kache/build: does not reproduce the pinned digest; kache-setup remains pinned'
fi
