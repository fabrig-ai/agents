#!/usr/bin/env bash
# Test the owners' tools in an isolated workspace, home and queue.
# Its budget is 40 s, with a 5 s margin for the lanes' noise.
set -Eeuo pipefail
trap 'echo "test-tools: failed at line $LINENO" >&2' ERR
started=$(date +%s.%N)
budget=40 budget_margin=5
kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
workspace=${DEV_ROOT:-$(dirname "$(dirname "$(git -C "$kit" rev-parse --path-format=absolute --git-common-dir)")")}
machine_home=$HOME
machine_heavy_link=$(readlink "$machine_home/.local/bin/heavy" || true)
machine_land_link=$(readlink "$machine_home/.local/bin/land" || true)
machine_setup_link=$(readlink "$machine_home/.local/bin/setup" || true)
failed=0
expect() {
    local what=$1 output=$2 want
    shift 2
    for want in "$@"; do
        if ! grep -qF -- "$want" <<<"$output"; then
            echo "FAIL $what: no \"$want\" in:"
            printf '    %s\n' "${output//$'\n'/$'\n'    }"
            failed=1
        fi
    done
}

t=$(mktemp -d "$workspace/tmp/test-tools.XXXXXX")
cleanup() {
    pueue shutdown >/dev/null 2>&1 || kill "$daemon_pid" 2>/dev/null || true
    wait "$daemon_pid" 2>/dev/null || true
    rm -rf "$t"
}
export DEV_ROOT=$t/src DEV_TMP=$t/src/tmp DEV_REPOS=alpha
export HOME=$t/home XDG_CONFIG_HOME=$t/config XDG_CACHE_HOME=$t/cache HEAVY_SETTLE=0
unset XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS
mkdir -p "$HOME" "$DEV_TMP" "$t/stub"
# User service checks never reach the machine's service manager.
cat >"$t/stub/systemctl" <<'EOF'
#!/usr/bin/env bash
exit 1
EOF
chmod +x "$t/stub/systemctl"
export PATH=$t/stub:$PATH
repo=$DEV_ROOT/alpha
mkdir -p "$repo"
git -C "$repo" init -q -b main
git -C "$repo" config user.email test@example.com
git -C "$repo" config user.name test
echo '# Alpha' >"$repo/README.md"
git -C "$repo" add README.md
git -C "$repo" commit -qm Start

# Captures label their exit status, including successful commands.
capture() {
    local name=$1 code=0 output
    shift
    output=$("$@" 2>&1) || code=$?
    printf '%s=%s\n%s\n' "$name" "$code" "$output"
}
# Every poll has the same tenth-second interval and a bounded attempt count.
poll_until() {
    local attempts=$1 attempt
    shift
    for ((attempt=0; attempt<attempts; attempt++)); do
        "$@" && return 0
        sleep 0.1
    done
    return 1
}
queue_up() { pueue status >/dev/null 2>&1; }
export PUEUE_CONFIG_PATH=$t/pueue/pueue.yml
mkdir -p "$t/pueue"
cat >"$PUEUE_CONFIG_PATH" <<EOF
shared:
  pueue_directory: $t/pueue
  runtime_directory: $t/pueue
  use_unix_socket: true
  unix_socket_path: $t/pueue/pueue.socket
EOF
pueued >"$t/pueue/daemon.log" 2>&1 &
daemon_pid=$!
trap cleanup EXIT
poll_until 100 queue_up
pueue group add build >/dev/null
pueue group add gate >/dev/null

# These commands share one queue and one row file; clients wait together.
heavy_run() (cd "$repo" || exit; HEAVY_TASK='' DEV_TMP=$t/heavy-tmp "$kit/heavy" "$@")
heavy_capture() {
    local label=$1
    shift
    capture status heavy_run "$@" >"$t/$label.out"
    head -n1 "$t/$label.out" >"$t/$label.status"
}
heavy_row() {
    awk -F'\t' -v command="$1" '$10 == command { n++; lane=$2; status=$6 }
        END { printf "rows=%d lane=%s status=%s", n, lane, status }' "$t/heavy-tmp/logs/heavy.tsv"
}
heavy_capture failure sh -c 'exit 3' &
failure_pid=$!
FOO_TOKEN=fake CLAUDE_CODE_CONTEXT=fake FOO_SECRET=fake FOO_PASSWORD=fake FOO_PASSWD=fake \
    FOO_API_KEY=fake FOO_CREDENTIAL=fake lower_token=fake SKEIN_TEST_CHROMIUM=fixture-browser \
    KACHE_FIXTURE=fixture-cache RUSTC_WRAPPER=fixture-wrapper \
    HEAVY_TASK='' DEV_TMP=$t/heavy-tmp "$kit/heavy" sleep 0.5 >"$t/client.log" 2>&1 &
client_pid=$!
running_client() {
    pueue status --json | jq -er '.tasks[] | select((.status | has("Running")) and (.command | contains("sleep 0.5"))) | .id'
}
task_id=$(poll_until 50 running_client)
queued_env=$(pueue status --json | jq -c --arg id "$task_id" '.tasks[$id].envs')
expect "queued credentials are absent" "$(jq -r '
    type == "object" and
    ([keys[] | ascii_upcase | select(test("^CLAUDE_CODE_|TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|CREDENTIAL"))] | length == 0)
    ' <<<"$queued_env")" true
expect "queued build settings survive" "$(jq -r '
    .SKEIN_TEST_CHROMIUM == "fixture-browser" and .KACHE_FIXTURE == "fixture-cache" and
    .RUSTC_WRAPPER == "fixture-wrapper"' <<<"$queued_env")" true
kill "$client_pid"
wait "$client_pid" 2>/dev/null || true
heavy_capture gate --gate true &
gate_pid=$!
wait "$failure_pid" "$gate_pid"
expect "heavy passes the failed command's status" "$(cat "$t/failure.status")" 'status=3'
expect "heavy writes one failure row" "$(heavy_row 'sh -c exit 3')" 'rows=1 lane=build status=3'
expect "a killed client loses no row" "$(heavy_row 'sleep 0.5')" 'rows=1 lane=build status=0'
expect "the gate lane passes the status too" "$(cat "$t/gate.status")" 'status=0'
expect "the gate lane writes its row too" "$(heavy_row true)" 'rows=1 lane=gate status=0'

# Land against an origin owned by this world, never a remote checkout.
git init -q --bare --initial-branch=main "$t/origin.git"
git clone -q "$t/origin.git" "$t/clone" 2>/dev/null
git -C "$t/clone" config user.email test@example.com
git -C "$t/clone" config user.name test
echo '# Start' >"$t/clone/README.md"
git -C "$t/clone" add README.md
git -C "$t/clone" commit -qm Start
git -C "$t/clone" push -q origin main
land_branch() {
    git -C "$t/clone" switch -qc "$1" origin/main
    echo "$1" >>"$t/clone/README.md"
    git -C "$t/clone" add README.md
    git -C "$t/clone" commit -qm "$2"
}
land_run() (cd "$t/clone" || exit; DEV_TMP=$t/land-tmp LAND_PREBUILD='' "$kit/land" "$@")
land_branch locked 'A Markdown change'
touch "$t/origin.git/refs/heads/main.lock"
out=$(capture status land_run --docs --tries 2)
rm "$t/origin.git/refs/heads/main.lock"
expect "A locked ref is main moving" "$out" 'status=6' 'land:' 'land: main moved 2 times; giving up'
land_branch waiting 'Add the test'
# shellcheck disable=SC2016 # $1 expands in the lock holder's shell
flock "$t/clone/.git/land-turn.lock" sh -c 'touch "$1"; sleep 0.3' sh "$t/turn-held" &
turn_pid=$!
poll_until 50 test -f "$t/turn-held"
out=$(capture status land_run --gate true)
wait "$turn_pid"
expect "land waits for another landing's turn" "$out" 'land: another landing in clone has its turn; waiting for it'

# After-landing uses this world's repository and a copy of the helper,
# with heavy and machine effects confined to the fixture.
after=$t/after-landing
mkdir -p "$after/kit" "$after/bin" "$after/tmp/after-landing/sibling" "$after/outside"
cp "$kit/after-landing" "$after/kit/after-landing"
after_commit=$(git -C "$t/clone" rev-parse HEAD)
after_target=$after/tmp/after-landing/clone/target
after_log=$after/tmp/after-landing/clone-$(git -C "$t/clone" rev-parse --short HEAD).log
echo keep >"$after/tmp/after-landing/sibling/sentinel"
echo keep >"$after/outside/sentinel"
# The runner's utility path has uname but no hostname.
for tool in bash basename date dirname git grep ln mkdir readlink sed sleep tail timeout touch wc; do
    ln -s "$(command -v "$tool")" "$after/bin/$tool"
done
cat >"$after/kit/heavy" <<'EOF'
#!/usr/bin/env bash
[[ $* == '--gate -- scripts/after-landing.sh' ]] || exit 70
[[ $(git rev-parse HEAD) == "$AFTER_COMMIT" ]] || exit 71
if [[ ${AFTER_REQUIRE_CLEAN:-} == 1 && -e target ]]; then exit 72; fi
echo attempt >>"$AFTER_STATE/attempts"
if [[ ${AFTER_ABSENT:-} != 1 ]]; then
    mkdir -p target
    ln -sf "$AFTER_STATE/outside" target/link
    echo build >target/artifact
fi
if [[ $AFTER_STATUS == 9 ]]; then
    echo 'heavy: fixture refusal'
else
    echo 'heavy: queued task 1 in gate'
    echo 'fixture tier output'
fi
exit "$AFTER_STATUS"
EOF
cat >"$after/bin/uname" <<'EOF'
#!/usr/bin/env bash
[[ $* == -n ]] || exit 1
echo "$AFTER_HOST"
EOF
cat >"$after/bin/rm" <<'EOF'
#!/usr/bin/env bash
[[ $* == '-rf --one-file-system -- target' ]] || exit 73
if [[ ${AFTER_HOLD_CLEANUP:-} == 1 ]]; then
    touch "$AFTER_STATE/cleanup-held"
    for ((i=0; i<50; i++)); do
        [[ ! -e $AFTER_STATE/release-cleanup ]] || break
        sleep 0.1
    done
    [[ -e $AFTER_STATE/release-cleanup ]] || exit 74
fi
[[ ${AFTER_RM_FAIL:-} != 1 ]] || { echo 'fixture removal failed' >&2; exit 75; }
exec /usr/bin/rm "$@"
EOF
cat >"$after/bin/flock" <<'EOF'
#!/usr/bin/env bash
[[ -z ${AFTER_WAITING:-} ]] || touch "$AFTER_WAITING"
exec /usr/bin/flock "$@"
EOF
cat >"$after/bin/kache" <<'EOF'
#!/usr/bin/env bash
[[ $* == gc && ! -e $AFTER_TARGET ]] || exit 76
echo gc >>"$AFTER_STATE/gc"
exit 1
EOF
chmod +x "$after/kit/heavy" "$after/bin/"{uname,rm,flock,kache}
after_run() {
    PATH=$after/bin DEV_TMP=$after/tmp AFTER_STATE=$after AFTER_COMMIT=$after_commit \
        AFTER_TARGET=$after_target AFTER_HOST=$1 AFTER_STATUS=$2 \
        timeout 10 "$after/kit/after-landing" "$t/clone/.git" "$after_commit" fixture-branch
}
expect "after-landing fixture has no hostname" \
    "$(PATH=$after/bin capture status bash -c 'command -v hostname')" 'status=1'
while IFS='|' read -r host code target; do
    out=$(capture status after_run "$host" "$code")
    expect "after-landing $host exit $code" "$out" "status=$code"
    expect "after-landing $host target $target" "$(if [[ -d $after_target ]]; then echo kept; else echo removed; fi)" "$target"
    expect "after-landing keeps sibling" "$(cat "$after/tmp/after-landing/sibling/sentinel")" keep
    expect "after-landing keeps nested link referent" "$(cat "$after/outside/sentinel")" keep
    expect "after-landing keeps log" "$(cat "$after_log")" 'heavy:'
    expect "after-landing runner has its commands" \
        "$(if grep -q 'command not found' "$after_log"; then echo missing; else echo available; fi)" available
done <<'AFTER'
x1|0|removed
x1|23|removed
x1|9|removed
x1.example.test|0|removed
other|0|kept
carbon-forge.example.test|0|kept
AFTER
expect "after-landing failure context" "$(cat "$after/tmp/director/inbox/after-landing.md")" \
    "clone ${after_commit:0:10} (fixture-branch, \"Add the test\") failed (exit 23)" \
    'was refused by heavy, so nothing ran: heavy: fixture refusal' "log $after_log"
rm -rf "$after_target"
out=$(AFTER_ABSENT=1 capture status after_run x1 0)
expect "after-landing missing target is harmless" "$out" 'status=0'
expect "after-landing collects released cache blocks best effort" "$(wc -l <"$after/gc")" 5
expect "after-landing log is private" "$(stat -c %a "$after_log")" 600

ln -s "$after/outside" "$after_target"
out=$(capture status after_run x1 23)
expect "after-landing unsafe target preserves tier failure" "$out" 'status=23'
expect "after-landing reports unsafe cleanup" "$(cat "$after_log" "$after/tmp/director/inbox/after-landing.md")" \
    'refusing unsafe target cleanup:' 'target cleanup failed (exit 1)' 'failed (exit 23)'
expect "after-landing leaves symlink referent" "$(cat "$after/outside/sentinel")" keep
rm "$after_target"
out=$(AFTER_RM_FAIL=1 capture status after_run x1 0)
expect "after-landing reports removal failure on success" "$out" 'status=1'
expect "after-landing logs removal failure" "$(cat "$after_log")" 'fixture removal failed'
out=$(AFTER_RM_FAIL=1 capture status after_run x1 9)
expect "after-landing removal failure preserves refusal" "$out" 'status=9'
expect "after-landing keeps refusal and cleanup diagnostics" "$(tail -n2 "$after/tmp/director/inbox/after-landing.md")" \
    'was refused by heavy, so nothing ran: heavy: fixture refusal' 'target cleanup failed (exit 1)'

mv "${after_target%/target}" "$after/moved"
ln -s "$after/moved" "${after_target%/target}"
out=$(capture status after_run x1 0)
expect "after-landing refuses a linked lane path" "$out" 'status=1'
expect "after-landing preserves a linked lane's target" "$(cat "$after/moved/target/artifact")" build
rm "${after_target%/target}"
mv "$after/moved" "${after_target%/target}"

# A second attempt reaches flock while the first is inside target removal.
: >"$after/attempts"
AFTER_HOLD_CLEANUP=1 after_run x1 0 &
after_first=$!
poll_until 50 test -e "$after/cleanup-held"
AFTER_WAITING=$after/next-waiting AFTER_REQUIRE_CLEAN=1 after_run x1 0 &
after_next=$!
poll_until 50 test -e "$after/next-waiting"
expect "after-landing cleanup holds the next run's lock" \
    "$(capture status flock -n "$after/tmp/after-landing/clone.lock" true)" 'status=1'
expect "after-landing next tier waits for cleanup" "$(wc -l <"$after/attempts")" 1
touch "$after/release-cleanup"
wait "$after_first"
wait "$after_next"
expect "after-landing next tier starts after cleanup" "$(wc -l <"$after/attempts")" 2
expect "after-landing retains lane and lock" "$(if [[ -d ${after_target%/target} && -f $after/tmp/after-landing/clone.lock && ! -e $after_target ]]; then echo kept; fi)" kept

# A clean primary checkout behind its origin is advanced by --fix.
setup_check() { capture status "$kit/setup" "$@"; }
git clone -q --bare "$repo" "$t/ff.git"
git -C "$repo" remote add origin "$t/ff.git"
git clone -q "$t/ff.git" "$t/ff"
git -C "$t/ff" -c user.email=test@example.com -c user.name=test commit -q --allow-empty -m "Advance origin"
git -C "$t/ff" push -q origin main
mkdir -p "$HOME/.local/bin"
ln -s "$kit/plan" "$HOME/.local/bin/plan"
out=$(setup_check --fix)
expect "setup --fix fast-forwards" "$out" "ok    alpha: main fast-forwarded 1 commits to origin/main"
expect "setup --fix links in the world" "$(readlink "$HOME/.local/bin/setup" "$HOME/.local/bin/heavy" "$HOME/.local/bin/land")" \
    "$kit/setup" "$kit/heavy" "$kit/land"
expect "setup --fix removes a stale plan link" "$(if [[ ! -L $HOME/.local/bin/plan && ! -e $HOME/.local/bin/plan ]]; then echo gone; fi)" gone
# Compare the graph index with origin/main's tip.
graph=$(readlink -f "$repo" | sed 's|^/||; s|/|-|g')
expect "setup says the graph has no index" "$(setup_check)" "ok    alpha: the graph has no index of it ($graph)"
mkdir -p "$HOME/.cache/codebase-memory-mcp"
touch -d 2020-01-01 "$HOME/.cache/codebase-memory-mcp/$graph.db"
expect "setup warns of an older index" "$(setup_check)" "warn  alpha: the graph's index is older than origin/main: re-index $repo (project $graph)"
touch "$HOME/.cache/codebase-memory-mcp/$graph.db"
expect "setup accepts a fresh index" "$(setup_check)" "ok    alpha: the graph's index is as new as origin/main"
expect "the machine's links stay" "$(if [[ $(readlink "$machine_home/.local/bin/heavy" || true) == "$machine_heavy_link" &&
    $(readlink "$machine_home/.local/bin/land" || true) == "$machine_land_link" &&
    $(readlink "$machine_home/.local/bin/setup" || true) == "$machine_setup_link" ]]; then echo unchanged; fi)" unchanged

# The tools fail past the budget and its margin, and pass at them.
over_budget() {
    if (($1 > $2 + $3)); then echo "$1 s, past $2 s and its $3 s margin"; fi
}
while IFS='|' read -r elapsed want; do
    expect "budget, ${elapsed} s" "<$(over_budget "$elapsed" 40 5)>" "<$want>"
done <<'BUDGET'
45|
46|46 s, past 40 s and its 5 s margin
BUDGET
elapsed=$(awk -v start="$started" -v end="$(date +%s.%N)" 'BEGIN { printf "%.2f", end - start }')
over=$(over_budget "${elapsed%.*}" "$budget" "$budget_margin")
[[ -z $over ]] || { echo "FAIL test-tools ran $over"; failed=1; }
echo "test-tools: ${elapsed} s (budget $budget s, margin $budget_margin s)"
if ((failed)); then
    echo "test-tools: failed"
    exit 1
fi
echo "test-tools: passed"
