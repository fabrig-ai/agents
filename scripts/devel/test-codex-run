        KILL)
            expect 'killed worker is stale' "$("$kit/codex-run" stale)" "$id" 'unit inactive without end' "$state"
            [[ ! -f $state/ended && ! -s $state/thread ]]
            killed_id=$id ;;
    esac
done
start_task success --resume "$killed_id"
json_expect 'killed thread recovered from events' '.[0].args[0:2] == ["exec", "resume"] and .[0].args[-2] == "thread-fixture"' "$fake/codex.calls"

# DEV_ROOT is normalized before the login shell starts in a different directory.
printf 'success\n' >"$fake/scenario"
n=$((n + 1))
report=$t/reports/relative-root-$n.md
printf '%s\n' "$report" >"$fake/report"
output=$(cd "$t" && DEV_ROOT=workspace "$kit/codex-run" task "$t/task file.md" "$t/work dir" "$report")
read -r id state <<<"$output"
poll_until test -f "$state/ended"
expect 'relative DEV_ROOT normalized' "$state" "$DEV_ROOT/tmp/codex-run/$id"

printf 'owner-capacity\n' >"$fake/scenario"
printf '\n' >"$fake/report"
printf '1\n0\n1\n4\n' >"$fake/wait-codes"
printf 'From: director\nSubject: next task\n\nRead this fixture message.\n' >"$fake/read-text"
: >"$fake/post.calls"
: >"$fake/codex.calls"
output=$("$kit/codex-run" owner --model owner-model --effort xhigh o/fixture "$t/brief.md")
expect 'owner prints unit name' "$output" 'codex-owner-o-fixture'
poll_until test -f "$fake/codex-owner-o-fixture.ended"
expect 'owner loop ends normally' "$(cat "$fake/codex-owner-o-fixture.ended")" 0
json_expect 'owner registers its holder before the first turn and waits between turns' \
    '.[0].args[0:5] == ["wait", "o/fixture", "--timeout", "0", "--holder"] and
     (.[0].args[5] | test("^[0-9]+$")) and .[0].args[6:8] == ["--kind", "codex"] and
     ([.[] | select(.args[0] == "wait")] | length == 4 and ([.[].args[5]] | unique | length) == 1 and
      all(.[1:][]; .args[3] == "3600"))' "$fake/post.calls"
json_expect 'owner prompt, post text, hourly prompt, settings and stdin prompt' \
    'length == 4 and all(.[]; .post_name == "o/fixture" and .args[-1] == "-" and .unwanted == null and
      (.args | index("owner-model")) != null and (.args | index("model_reasoning_effort=xhigh")) != null and
      (.args | index("--dangerously-bypass-approvals-and-sandbox")) != null) and
     (.[0].stdin | startswith("You are o/fixture: read ")) and
     .[1].stdin == "Go on with the task: the model was at capacity.\n" and
     (.[2].stdin | startswith("Post for o/fixture:\n") and contains("Read this fixture message.")) and
     .[3].stdin == "An hour without post: check your running tasks, act on what has ended, and keep your notes current.\n" and
     all(.[1:][]; .args[0:2] == ["exec", "resume"])' "$fake/codex.calls"
owner_state=$DEV_ROOT/tmp/owners/fixture/codex
[[ $(wc -l <"$owner_state/turns.tsv") == 3 ]]
expect 'owner turn row includes retry count' "$(head -n1 "$owner_state/turns.tsv")" $'\t0\t2'
[[ $(cat "$owner_state/thread") == thread-fixture && -f $owner_state/last.md && -f $owner_state/stderr.log ]]
checks=$((checks + 1))

printf '4\n' >"$fake/wait-codes"
: >"$fake/codex.calls"
"$kit/codex-run" owner o/replaced "$t/brief.md" >/dev/null
poll_until test -f "$fake/codex-owner-o-replaced.ended"
[[ ! -s $fake/codex.calls ]]
expect 'replacement at registration ends without a turn' "$(cat "$fake/codex-owner-o-replaced.ended")" 0

# Equal final components refuse; systemd-escape keeps slash/dash units distinct.
printf '1\n4\n' >"$fake/wait-codes"
"$kit/codex-run" owner o/shared "$t/brief.md" >/dev/null
poll_until test -f "$fake/codex-owner-o-shared.ended"
refusal 'owner state collision' owner p/shared "$t/brief.md"
expect 'full owner identity persisted' "$(cat "$DEV_ROOT/tmp/owners/shared/codex/name")" 'o/shared'
for name in o/a-b o-a/b; do
    printf '1\n4\n' >"$fake/wait-codes"
    unit=$("$kit/codex-run" owner "$name" "$t/brief.md")
    expect 'escaped owner unit' "$unit" "codex-owner-$(systemd-escape "$name")"
    poll_until test -f "$fake/$unit.ended"
done

# Oversized mail is on stdin, and a failed turn replays before newly read mail.
printf 'owner-fail-once\n' >"$fake/scenario"
printf '1\n0\n0\n4\n' >"$fake/wait-codes"
head -c 204800 /dev/zero | tr '\0' x >"$fake/read-text"
rm -f "$fake/read-count"
: >"$fake/codex.calls"
: >"$fake/post.calls"
"$kit/codex-run" owner o/replay "$t/brief.md" >/dev/null
poll_until test -f "$fake/codex-owner-o-replay.ended"
json_expect '200 KiB prompt reaches stdin and failed mail precedes new post' \
    'length == 3 and (.[1].stdin | length) > 204800 and (.[2].stdin | contains("Post for o/replay:"))' "$fake/codex.calls"
# $old is bound by jq.
# shellcheck disable=SC2016
json_expect 'failed mail retained before new post' \
    '.[1].stdin as $old | .[2].stdin | startswith($old) and endswith("New second post.\n")' "$fake/codex.calls"
json_expect 'failed owner turn waits five minutes' \
    '[.[] | select(.args[0] == "wait") | .args[3]] == ["0", "3600", "300", "3600"]' "$fake/post.calls"
expect 'successful replay removes pending batch' "$(test ! -e "$DEV_ROOT/tmp/owners/replay/codex/pending.md" && echo removed)" removed

# Restart after an unsuccessful mail turn replays the pending prompt after the brief.
printf '1\n0\n4\n' >"$fake/wait-codes"
printf 'Restart this pending post.\n' >"$fake/read-text"
: >"$fake/codex.calls"
"$kit/codex-run" owner o/restart "$t/brief.md" >/dev/null
poll_until test -f "$fake/codex-owner-o-restart.ended"
restart_state=$DEV_ROOT/tmp/owners/restart/codex
expect 'unsuccessful turn keeps pending mail' "$(cat "$restart_state/pending.md")" 'Restart this pending post.'
printf 'success\n' >"$fake/scenario"
printf '1\n4\n' >"$fake/wait-codes"
: >"$fake/codex.calls"
rm "$fake/codex-owner-o-restart.ended"
"$kit/codex-run" owner o/restart "$t/brief.md" >/dev/null
poll_until test -f "$fake/codex-owner-o-restart.ended"
json_expect 'restart brief followed by saved post' \
    'length == 1 and (.[0].stdin | startswith("You are o/restart: read ") and contains("Restart this pending post."))' "$fake/codex.calls"
expect 'restart clears successful pending batch' "$(test ! -e "$restart_state/pending.md" && echo removed)" removed

elapsed=$(awk -v start="$started" -v end="$(date +%s.%N)" 'BEGIN { printf "%.3f", end-start }')
printf 'test-codex-run: %s checks passed in %ss\n' "$checks" "$elapsed"
awk -v elapsed="$elapsed" 'BEGIN { exit !(elapsed < 15) }'
