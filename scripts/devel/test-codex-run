    refusal 'DIR delimiter' task "$t/task file.md" "$t/work${delimiter}dir" "$t/reports/refused.md"
    refusal 'REPORT delimiter' task "$t/task file.md" "$t/work dir" "$t/reports/report${delimiter}file"
    refusal 'model delimiter' task --model "bad${delimiter}model" "$t/task file.md" "$t/work dir" "$t/reports/refused.md"
    refusal 'BRIEF delimiter' owner o/fixture "$t/brief${delimiter}file"
done
refusal 'bad effort' task --effort max "$t/task file.md" "$t/work dir" "$t/reports/refused.md"
refusal 'resume without thread' task --resume absent "$t/task file.md" "$t/work dir" "$t/reports/refused.md"
[[ ! -e $DEV_ROOT/tmp/codex-run ]]
refusal 'owner invalid name' owner ../oops "$t/brief.md"
refusal 'owner relative brief' owner o/fixture relative
refusal 'owner unreadable brief' owner o/fixture "$t/missing"
refusal 'owner bad effort' owner --effort low o/fixture "$t/brief.md"
touch "$fake/active"
refusal 'owner active unit' owner o/fixture "$t/brief.md"
rm "$fake/active"
[[ ! -e $fake/launch.args ]]

touch "$fake/launch-fail"
refusal 'systemd launch failure' task "$t/task file.md" "$t/work dir" "$t/reports/refused.md"
rm "$fake/launch-fail"
touch "$fake/missing-executable"
refusal 'missing worker executable' task "$t/task file.md" "$t/work dir" "$t/reports/refused.md"
rm "$fake/missing-executable"

# A worker held before execution still reserves the report against another launch.
touch "$fake/hold-launch"
output=$("$kit/codex-run" task "$t/task file.md" "$t/work dir" "$t/reports/reserved.md")
read -r reserved_id reserved_state <<<"$output"
expect 'report reserved at launch' "$(cat "$t/reports/reserved.md")" "codex-run: run $reserved_id is writing this report."
refusal 'second report launch refused' task "$t/task file.md" "$t/work dir" "$t/reports/reserved.md"
expect 'inactive unfinished run is stale' "$("$kit/codex-run" stale)" "$reserved_id" 'unit inactive without end' "$reserved_state" 'o/caller'
touch "$fake/active"
expect 'active unfinished run omitted' "[$("$kit/codex-run" stale)]" '[]'
rm "$fake/active" "$fake/hold-launch"

n=0
has_row() { [[ -f $DEV_ROOT/tmp/codex-run/runs.tsv ]] && grep -q "^$id"$'\t' "$DEV_ROOT/tmp/codex-run/runs.tsv"; }
start_task() {
