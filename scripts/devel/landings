class Checkouts:
    """Read ancestry without touching a worktree, branch, index or FETCH_HEAD."""

    def __init__(self, root, deadline=math.inf):
        self.root = root
        self.deadline = deadline
        self.commits, self.ancestry, self.trees, self.ranges = {}, {}, {}, {}
        self.missing, self.confirmed, self.landed = set(), set(), set()
        self.checkouts = {}
        self.poll()

    def poll(self):
        self.fetched = {}

    def git(self, repo, *args, timeout=GIT_READ_TIMEOUT):
        path = self.root / repo
        if not (path / '.git').exists():
            return None
        timeout = min(timeout, self.deadline - time.monotonic())
        if timeout <= 0:
            return None
        try:
            with subprocess.Popen(['git', '-C', str(path), *args],
                                  stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                  stderr=subprocess.PIPE, text=True, errors='replace',
                                  env=dict(os.environ, GIT_TERMINAL_PROMPT='0'),
                                  start_new_session=True) as process:
                try:
                    out, err = process.communicate(timeout=timeout)
                except subprocess.TimeoutExpired:
                    # SSH children can keep the pipes open after Git itself dies.
                    try:
                        os.killpg(process.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    process.communicate()
                    return None
                return subprocess.CompletedProcess(process.args, process.returncode, out, err)
        except OSError:
            return None

    def available(self, repo):
        if not (self.root / repo / '.git').exists():
            return False
        if repo not in self.checkouts:
            result = self.git(repo, 'rev-parse', '--is-shallow-repository')
            if result is not None and result.returncode == 0:
                self.checkouts[repo] = result.stdout.strip() == 'false'
        return self.checkouts.get(repo)

    def fetch(self, repo):
        if repo not in self.fetched:
            result = self.git(repo, 'fetch', '--quiet', '--no-write-fetch-head',
                              '--no-tags', '--no-recurse-submodules', '--no-auto-maintenance',
                              'origin', '+refs/heads/main:refs/remotes/origin/main',
                              timeout=GIT_FETCH_TIMEOUT)
            self.fetched[repo] = result is not None and result.returncode == 0
            if self.fetched[repo]:
                self.confirmed.add(repo)
        return self.fetched[repo]

    def resolve(self, repo, commit, after_fetch=False):
        """Return the full commit, False when absent, or None for an unread answer."""
        key = repo, commit.lower()
        if key in self.missing:
            return False
        if key not in self.commits:
            result = self.git(repo, 'rev-parse', '--verify', commit + '^{commit}')
            if result is None:
                return None
            if result.returncode:
                if after_fetch:
                    self.missing.add(key)
                return False
            self.commits[key] = result.stdout.strip()
        return self.commits[key]

    def need(self, repo, commit):
        full = self.resolve(repo, commit)
        if not full and (repo, commit.lower()) not in self.missing and self.fetch(repo):
            full = self.resolve(repo, commit, after_fetch=True)
        return full or None

    def find(self, commit, repo=None):
        if not re.fullmatch(r'[0-9a-fA-F]{7,40}', commit):
            return []
        found = []
        names = CHECKOUTS if repo is None else (repo,) if repo in CHECKOUTS else ()
        for name in names:
            available = self.available(name)
            if available is None:
                return []
            if not available:
                continue
            full = (self.resolve(name, commit.lower()) if repo is None
                    else self.need(name, commit.lower()))
            # An unread candidate cannot establish a unique checkout.
            if full is None:
                return []
            if full:
                found.append((name, full))
        return found

    def on_main(self, repo, commit):
        key = repo, commit
        if key in self.landed:
            return True

        def held():
            result = self.git(repo, 'rev-parse', '--verify', 'refs/remotes/origin/main^{commit}')
            if result is None or result.returncode:
                return None
            return self.holds(repo, result.stdout.strip(), commit)

        answer = held() if repo in self.confirmed else None
        if answer is not True:
            if not self.fetch(repo):
                return None
            answer = held()
        if answer is True:
            self.landed.add(key)
        return answer

    def holds(self, repo, main, commit):
        if not all(re.fullmatch(r'[0-9a-fA-F]{7,40}', value) for value in (main, commit)):
            return None
        full = self.need(repo, main.lower())
        tip = self.need(repo, commit.lower())
        if full is None or tip is None:
            return None
        key = repo, full, tip
        if key not in self.ancestry:
            result = self.git(repo, 'merge-base', '--is-ancestor', tip, full)
            if result is not None and result.returncode in (0, 1):
                self.ancestry[key] = result.returncode == 0
        return self.ancestry.get(key)

    def has_tier(self, repo, commit):
        key = repo, commit
        if key not in self.trees:
            result = self.git(repo, 'ls-tree', commit, '--', 'scripts/after-landing.sh')
            if result is not None and result.returncode == 0:
                self.trees[key] = bool(result.stdout.strip())
        return self.trees.get(key)

    def pushed_commits(self, repo, base, tip):
        if repo not in CHECKOUTS:
            return None
        key = repo, base, tip
        if key not in self.ranges:
            if not self.available(repo) or self.holds(repo, tip, base) is not True:
                return None
            result = self.git(repo, 'rev-list', '--reverse', base + '..' + tip)
            if result is not None and result.returncode == 0:
                commits = result.stdout.splitlines()
                if commits:
                    self.ranges[key] = commits
        return self.ranges.get(key)


def judge(runner, checkouts, repo, commit):
    """Return (outcome, console lines, red verdict rows), or None while this landing is undecided."""
    def lines(row, suffix='', naming=None):
        out = io.StringIO()
        with redirect_stdout(out):
            verdict_line(dict(row, commit=naming or row['commit']))
        text = out.getvalue()
        if suffix:
            run = 'by run ' + row['run'][:9]
            text = text.replace(run, run + suffix, 1)
        return row['verdict'], text.splitlines(), ([dict(row, commit=naming or row['commit'])]
                                                   if row['verdict'] == 'red' else [])

    mine = [r for r in runner if r['kind'] == 'tier'
            and (repo is None or follower(r['tier'])[0] == repo)]
    own = {}
    for row in sorted(mine, key=lambda r: r['utc']):
        if row['event'] == 'verdict' and (
                row['commit'].lower().startswith(commit.lower()) if repo is None
                else row['commit'] == commit):
            own[row['tier'], row['commit']] = row
    groups = {}
    for (name, tip), row in own.items():
        groups.setdefault((follower(name)[0], tip), {})[name] = lines(row)
    answers = [joined(repository, group) for (repository, _), group in groups.items()]
    if answers and (any(answer is not None and answer[0] == 'red' for answer in answers)
                    or all(answer is not None for answer in answers)):
        return ('red' if any(answer is not None and answer[0] == 'red' for answer in answers) else 'cleared',
                [line for answer in answers if answer is not None for line in answer[1]],
                [row for answer in answers if answer is not None for row in answer[2]])
    found = checkouts.find(commit, repo)
    if len(found) != 1:
        return None
    repo, commit = found[0]
    held = checkouts.on_main(repo, commit)
    if held is False:
        return 'not landed', [f'landings: {repo} {commit[:9]} is not on main: wait on the commit that landed'], []
    if held is None:
        return None
    tier = checkouts.has_tier(repo, commit)
    if tier is False:
        stamp = datetime.now(timezone.utc).strftime('%m-%d %H:%MZ')
        return 'cleared', [f'{stamp} {repo} {commit[:9]} cleared on landing: {repo} has no tier'], []
    if tier is None:
        return None
    mine = [r for r in mine if follower(r['tier'])[0] == repo]

    def run_answer(records):
        end = None
        for candidate in sorted((r for r in reversed(records) if r['event'] == 'tier'),
                                key=lambda r: r['utc'], reverse=True):
            start = newest([r for r in records if r['event'] == 'running' and r['token'] == candidate['token']])
            if start is None:
                continue
            held = checkouts.holds(repo, candidate['commit'], commit)
            if held is None:
                return None
            if not held:
                continue
            if start['from'] is not None:
                held = checkouts.holds(repo, start['from'], commit)
                if held is None:
                    return None
                if held:
                    continue
            end = candidate
            break
        if end is None:
            return None
        if end.get('baseline'):
            return lines(dict(end, verdict='cleared', run=end['commit']), ', which holds it', commit)
        verdicts = []
        for row in records:
            if row['event'] != 'verdict' or row['token'] != end['token']:
                continue
            held = checkouts.holds(repo, row['commit'], commit)
            if held is None:
                return None
            if held:
                verdicts.append(row)
        oldest = next((r for r in verdicts if all(
            checkouts.holds(repo, other['commit'], r['commit']) is True for other in verdicts)), None)
        if oldest is not None:
            return lines(oldest, f", which holds it in landing {oldest['commit'][:9]}", commit)
        return None

    answers = {}
    for name in sorted({r['tier'] for r in mine}):
        row = own.get((name, commit))
        answers[name] = lines(row) if row is not None else run_answer([r for r in mine if r['tier'] == name])
    return joined(repo, answers)


def landing_base(row):
    """The actual push's base; never the earlier candidate's gate base."""
    base = row.get('base')
    if 'base' not in row:
        result = row.get('result')
        if (isinstance(result, dict) and result.get('pushed') is True
                and result.get('commit') == row.get('commit')):
            base = result.get('base')
    return base if isinstance(base, str) and re.fullmatch(r'[0-9a-fA-F]{40}', base) else None


def has_landing_range(row):
    # Explicit null means a new publication whose push result was lost.
    return 'base' in row or landing_base(row) is not None


def judge_landing(row, runner, checkouts):
    repo, tip = row.get('repo'), row['commit']
    base = landing_base(row)
    if base is None:
        return None if has_landing_range(row) else judge(runner, checkouts, repo, tip)
    commits = checkouts.pushed_commits(repo, base, tip)
    if commits is None:
        return None
    answers = [judge(runner, checkouts, repo, commit) for commit in commits]
    reds = [answer for answer in answers if answer is not None and answer[0] == 'red']
    span = f'pushed range {base[:9]}..{tip[:9]}'
    if reds:
        # A red decides even while another pushed commit has no verdict yet.
        details = [line for answer in reds for line in answer[1]]
        return ('red', [f'{repo} {tip[:9]} red over {span}', *details],
                [row for answer in reds for row in answer[2]])
    if any(answer is None for answer in answers):
        return None
    unlanded = next((answer for answer in answers if answer[0] == 'not landed'), None)
    if unlanded is not None:
        return unlanded
    # All pushed commits cleared. Show the tip's explanation once.
    answer = answers[commits.index(checkouts.need(repo, tip))]
    return 'cleared', [answer[1][0] + '; ' + span, *answer[1][1:]], []


def clearance(records, runner, target, checkouts, lands=(), post_reds=None):
    if re.fullmatch(r'[0-9a-fA-F]{7,40}', target):
        landings = [r for r in [*records, *lands] if r['event'] == 'landed'
                    and r.get('commit', '').lower().startswith(target.lower())
                    and has_landing_range(r)]
        if not landings:
            landings = [dict(repo=None, commit=target)]
        ready = True
    else:
        run = wait_run(records, target)
        terminal = ending(run)
        if terminal is not None and terminal['event'] == 'stopped':
            print(event_line(terminal))
            return 1, [], 'stopped'
        ready = terminal is not None and terminal['event'] == 'done'
        landings = list({(r['repo'], r['commit']): r for r in run
                         if r['event'] == 'landed' and r.get('repo') and r.get('commit')}.values()) if ready else []
    decided, missing = [], []
    for row in landings:
        repo, commit = row.get('repo'), row['commit']
        answer = judge_landing(row, runner, checkouts)
        if answer is None:
            found = checkouts.find(commit, repo) if repo is None else []
            missing.append(found[0] if len(found) == 1 else (repo, commit))
        elif answer[0] == 'not landed':
            print('\n'.join(answer[1]), file=sys.stderr)
            return 2, [], 'not landed'
        else:
            decided.append(answer)
    red = any(answer[0] == 'red' for answer in decided)
    if red or (ready and not missing):
        for _, lines, rows in decided:
            print('\n'.join(lines))
            if post_reds is not None:
                post_reds.extend(rows)
        return (1 if red else 0), missing, ('red' if red else 'cleared')
    return None, missing, None


def display_text(value):
    return ''.join('?' if unicodedata.category(char) == 'Cc' else char for char in value)


def event_line(record):
    plain = record.get('kind') == 'land'
    name = display_text(record['branch']) if plain else record['set']
    parts = [record['date'], record['clock'], name, record['event']]
    if record.get('repo'):
        parts.append(display_text(record['repo']) if plain else record['repo'])
    if record.get('commit'):
        parts.append(record['commit'][:9])
    if record['event'] == 'stopped':
        parts.extend(('status=' + str(record.get('status', '?')),
                      'reason=' + record.get('reason', '')))
    parts.append(record['host'])
    return ' '.join(parts)


def taught_of(record):
    lines = record.get('taught')
    if not isinstance(lines, list) or not all(isinstance(line, str) for line in lines):
        lines = []
    more = record.get('taught_more')
    return lines, more if type(more) is int and more > 0 else 0


def taught_lines(record):
    lines, more = taught_of(record)
    return ['    ' + display_text(line) for line in lines] + ([f'    ({more} more)'] if more else [])


def latest_runs(records, proves=False):
    """Each set's latest run that lands it, or with PROVES, that proves it."""
    starts = ('proving',) if proves else ('waiting', 'started')
    runs, latest = {}, {}
    for record in records:
        key = record['set'], record['token']
        if key not in runs:
            runs[key] = []
            # Without the start, legacy or truncated runs are history only.
            if record['event'] in starts:
                latest[record['set']] = runs[key]
        runs[key].append(record)
    return latest


def wait_run(records, label):
    """The newest landing or proof attempt, ordered by its first feed record."""
    runs = [latest_runs(records, proves=proves).get(label, []) for proves in (False, True)]
    return max(runs, key=lambda run: run[0]['position'] if run else -1)


def ending(run):
    return next((r for r in reversed(run) if r['event'] in ('done', 'proved', 'stopped')), None)


def show(records, lands, last, runner, checkouts):
    events = sorted([*records, *lands], key=lambda r: r['position'])
    for record in events[-last:] if last else []:
        print(event_line(record))
        if record['event'] == 'landed':
            for line in taught_lines(record):
                print(line)
            if has_landing_range(record):
                answer = judge_landing(record, runner, checkouts)
                if answer is None:
                    print('    verdict pending over pushed range')
                else:
                    for line in answer[1]:
                        print('    ' + line)
    active = [run for run in latest_runs(records).values() if ending(run) is None]
    active += [run for run in latest_runs(records, proves=True).values() if ending(run) is None]
    if not active:
        print('in flight: none')
    else:
        print('in flight:')
    for run in active:
        started = next((r for r in run if r['event'] == 'started'), None)
        since = started or run[0]
        state = ('proving (no lock)' if run[0]['event'] == 'proving' else
                 'running (holds set lock)' if started else 'waiting')
        line = f"  {run[0]['set']}: {state} since {since['time']} on {since['host']}"
        line += f"; last event {run[-1]['clock']}"
        progress = next((r for r in reversed(run) if r['event'] in ('gated', 'landed')), None)
        if progress:
            line += f"; last {progress['event']} {progress.get('repo', '')} {progress.get('commit', '')[:9]}"
        print(line)


def wait(label, timeout, poll, unreachable, read=15, cleared=False, post_reds=None):
    start = last_read = time.monotonic()
    deadline = start + timeout if timeout is not None else math.inf
    last_error = None
    first_read = True
    missing = []
    checkouts = Checkouts(workspace(), deadline)
    if cleared:
        watch(label, read)
    while True:
        now = time.monotonic()
        # Always attempt the initial read, even with --timeout 0.
        read_limit = read if first_read else max(
            .001, min(read, deadline - now, last_read + unreachable - now))
        first_read = False
        checkouts.poll()
        try:
            records, runner, lands = read_feed(read_limit)
        except (OSError, subprocess.TimeoutExpired) as error:
            # A final attempt with little time left must not hide the transport's reason.
            if last_error is None or not isinstance(error, subprocess.TimeoutExpired):
                last_error = error
            now = time.monotonic()
            if now >= last_read + unreachable and last_read + unreachable <= deadline:
                print(f'landings: feed unreadable: {last_error}', file=sys.stderr)
                return 4, 'feed unreadable'
        else:
            last_read = time.monotonic()
            last_error = None
            if cleared:
                status, missing, outcome = clearance(records, runner, label, checkouts, lands, post_reds)
                if status is not None:
                    return status, outcome
            else:
                run = wait_run(records, label)
                terminal = ending(run)
                if terminal is not None and terminal['event'] in ('done', 'stopped'):
                    if terminal['event'] == 'stopped':
                        print(event_line(terminal))
                        return 1, 'stopped'
                    previous_done = -1
                    for index, record in enumerate(records):
                        if record is terminal:
                            end = index
                            break
                        if record['set'] == label and record['event'] == 'done':
                            previous_done = index
                    for record in records[previous_done + 1:end]:
                        if record['set'] == label and record['event'] == 'landed':
                            print(event_line(record))
                    return 0, 'cleared'
        now = time.monotonic()
        if now >= deadline:
            print(f'landings: timed out waiting for {label}', file=sys.stderr)
            for repo, commit in missing:
                name = f'{repo} {commit}' if repo is not None else commit
                print(f'landings: no verdict for {name}', file=sys.stderr)
            return 3, 'timed out'
        time.sleep(max(0, min(poll, deadline - now, last_read + unreachable - now)))


def red_post(label, rows, limit, log):
    """Bound names by bytes, keeping space for the verdict and log references."""
    budget = limit // 2  # The envelope also counts against post's limit.
    field_limit = budget // 16

    def field(value):
        data = display_text(value).encode('utf-8')
        return (data[:field_limit].decode('utf-8', errors='ignore') + '...'
                if len(data) > field_limit else data.decode('utf-8'))

    lines = [f'landings: {field(label)} red', f'wait log {socket.gethostname()}:{log}']
    for index, row in enumerate(rows):
        heading = (f"{row['date']} {row['clock']} {field(row['tier'])} "
                   f"{field(row['commit'])} red by run {field(row['run'])}")
        tail = f"; log {field(row['host'])}:{field(row['log'])}"
        tests = []
        # Reserve the fixed fields and the remaining-verdict count first.
        available = budget - len(('\n'.join(lines) + '\n' + heading + tail).encode('utf-8')) - 128
        for name in row['tests']:
            candidate = '; '.join([*tests, field(name)])
            if len(candidate.encode('utf-8')) > min(available, budget // 8):
                break
            tests.append(field(name))
        more = len(row['tests']) - len(tests) + row.get('tests_more', 0)
        detail = ': ' + '; '.join(tests) if tests else ''
        if more:
            detail += f"; and {more} more tests"
        line = heading + detail + tail
        if len(('\n'.join([*lines, line]) + '\n').encode('utf-8')) > budget - 128:
            lines.append(f'and {len(rows) - index} more verdicts (see wait log)')
            break
        lines.append(line)
    return '\n'.join(lines) + '\n'


def wait_and_post(address, label, *args):
    import tempfile

    if address is None:
        return wait(label, *args)[0]
    out, err, reds = io.StringIO(), io.StringIO(), []
    with redirect_stdout(out), redirect_stderr(err):
        status, outcome = wait(label, *args, post_reds=reds)
    stdout, stderr = out.getvalue(), err.getvalue()
    print(stdout, end='')
    print(stderr, end='', file=sys.stderr)
    body = None
    try:
        # Keep evidence outside the checkout, including after a failed delivery.
        directory = Path(tempfile.mkdtemp(prefix='landings-post-'))
        body = directory / 'body'
        full = stdout + stderr
        body.write_text(full, encoding='utf-8')
        limit = int(Path(__file__).resolve().with_name('post-limit').read_text())
        if outcome == 'red':
            log = directory / 'wait.log'
            log.write_text(full, encoding='utf-8')
            body.write_text(red_post(label, reds, limit, log), encoding='utf-8')
        elif len(full.encode('utf-8')) > limit // 2:
            log = directory / 'wait.log'
            log.write_text(full, encoding='utf-8')
            body.write_text(f'landings: {outcome}; wait log {socket.gethostname()}:{log}\n',
                            encoding='utf-8')
        result = subprocess.run(['post', 'send', '--as', 'landings', address,
                                 f'landings: {label} {outcome}', str(body)],
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
        if result.returncode not in (0, 3):
            raise OSError(result.stderr.strip() or result.stdout.strip()
                          or f'exit {result.returncode}')
        body.unlink()
        if not (directory / 'wait.log').exists():
            directory.rmdir()
    except (OSError, ValueError) as error:
        print(f'landings: warning: post failed: {error}', file=sys.stderr)
        if body is not None and body.exists():
            print(f'landings: post body saved at {body}', file=sys.stderr)
        return status or 1
    return status


STEPS = ('fmt', 'clippy', 'wasm', 'build', 'focused', 'fuzzy', 'bundle', 'browser')


def since(value):
    try:
        stamp = datetime.fromisoformat(value)
    except ValueError:
        raise argparse.ArgumentTypeError('since must be a date or an ISO time')
    # A bare date or a time without a zone is UTC.
    return stamp.replace(tzinfo=stamp.tzinfo or timezone.utc).astimezone(timezone.utc)


def number(value):
    ok = isinstance(value, (int, float)) and not isinstance(value, bool)
    return value if ok and math.isfinite(value) else None


def part(result, name):
    value = result.get(name)
    return value if isinstance(value, dict) else {}


def costs(result):
    """One result's times: None for what it doesn't carry."""
    prebuild, gate = part(result, 'prebuild'), part(result, 'gate')
    steps = gate.get('steps') if isinstance(gate.get('steps'), dict) else None
    row = {'prebuild_wait_s': number(prebuild.get('wait_s')),
           'prebuild_run_s': number(prebuild.get('run_s')),
           'gate_wait_s': number(gate.get('wait_s')),
           'gate_run_s': number(gate.get('run_s')),
           'gate_exit': number(gate.get('exit'))}
    for step in STEPS:
        row[step] = number(steps.get(step)) if steps else None
    run = row['gate_run_s']
    # Without steps (an older gate), its whole time is no evidence for other.
    row['other'] = (None if steps is None or run is None or gate.get('kind') != 'ran' else
                    round(max(0, run - sum(filter(None, map(number, steps.values())))), 3))
    return row


def failed(result):
    return any(part(result, name).get('exit') not in (None, 0)
               for name in ('prebuild', 'gate'))


def mss(value):
    value = round(value)
    return f'{value // 60}:{value % 60:02d}'


def median(values, show=mss):
    import statistics

    values = [v for v in values if v is not None]
    return show(statistics.median(values)) if values else '-'


def p90(values):
    values = sorted(v for v in values if v is not None)
    # Nearest rank: the smallest value at or above 90% of them.
    return mss(values[math.ceil(.9 * len(values)) - 1]) if values else '-'


def table(head, rows):
    widths = [max(len(str(c)) for c in column) for column in zip(head, *rows)]
    for row in (head, *rows):
        print('  '.join(str(c).rjust(w) if i else str(c).ljust(w)
                        for i, (c, w) in enumerate(zip(row, widths))).rstrip())


def report_verdicts(records, runner, lands):
    mine = [r for r in runner if r['kind'] == 'tier' and r['event'] in ('tier', 'verdict')]
    if not mine:
        print('no after landing runs')
        return
    landings = {}
    for row in [r for r in records if r['event'] == 'landed'] + lands:
        if row.get('repo') and row.get('commit'):
            key = row['repo'], row['commit']
            landings[key] = min(landings.get(key, row['utc']), row['utc'])
    verdicts, runs, judged = {}, {}, {}
    for row in mine:
        name = row['tier']
        if row['event'] == 'verdict':
            verdicts.setdefault((name, row['commit']), []).append(row)
            judged.setdefault((name, row['token']), set()).add(row['commit'])
        else:
            runs[name, row['token']] = row
    rows = []
    for repo in sorted({follower(r['tier'])[0] for r in mine}):
        names = sorted({r['tier'] for r in mine if follower(r['tier'])[0] == repo},
                       key=lambda name: (follower(name)[2], follower(name)[1]))
        own = {name: [] for name in names}
        joined_times = []
        for (repository, commit), landed in landings.items():
            if repository != repo:
                continue
            reds, splits = [], {}
            for name in names:
                answers = verdicts.get((name, commit), [])
                if answers:
                    first = min(r['utc'] for r in answers)
                    own[name].append((first - landed).total_seconds())
                reds.extend(r['utc'] for r in answers if r['verdict'] == 'red')
                cleared = [r['utc'] for r in answers if r['verdict'] == 'cleared']
                if cleared:
                    _, part, parts = follower(name)
                    splits.setdefault(parts, {})[part] = min(cleared)
            cleared = [max(split.values()) for parts, split in splits.items() if len(split) == parts]
            decided = min(reds) if reds else min(cleared) if cleared else None
            if decided is not None:
                joined_times.append((decided - landed).total_seconds())
        def timing(name, times):
            return [name, len(times), median(times), p90(times)]
        def run_costs(name):
            completed = [r for (tier, _), r in runs.items() if tier == name]
            per_run = [len(judged.get((name, r['token']), ())) for r in completed]
            ran = [r['ran_s'] for r in completed]
            return [len(completed), median(per_run, show=lambda n: f'{n:g}'), median(ran), p90(ran)]
        if names == [repo]:
            rows.append(timing(repo, joined_times) + run_costs(repo))
        else:
            rows.append(timing(repo, joined_times) + ['', '', '', ''])
            rows.extend(timing('  ' + name, own[name]) + run_costs(name) for name in names)
    print("after landing's verdicts (verdict: landed to the record that decided it; "
          "per run: landings a run judged; m:ss)")
    table(['tier', 'landings', 'verdict', 'p90', 'runs', 'per run', 'ran', 'p90'], rows)


def report_starved(results, runner, lands):
    totals, tests = {}, {}
    sources, seen = [], set()
    for record, result in results:
        # Push reconciliation can put the same result on landed and stopped.
        key = record['set'], record['token'], json.dumps(result, sort_keys=True)
        if key not in seen:
            seen.add(key)
            sources.append((result['repo'], result, 0))
    plain = {(row['repo'], row['token']): row for row in lands}
    sources.extend((row['repo'], row, 0) for row in plain.values())
    # Verdicts repeat a run's names for each landing; only the run's end counts.
    runs = {(row['tier'], row['token']): row for row in runner
            if row['kind'] == 'tier' and row['event'] == 'tier'}
    sources.extend((follower(row['tier'])[0], row, 1) for row in runs.values())
    for repo, row, column in sources:
        names = row.get('starved', [])
        if not isinstance(names, list) or not all(isinstance(n, str) and n for n in names):
            continue
        names = set(names)
        more = row.get('starved_more', 0)
        if type(more) is not int or more < 0:
            continue
        total = len(names) + more
        if not total:
            continue
        totals.setdefault(repo, [0, 0])[column] += total
        for name in names:
            tests.setdefault((repo, name), [0, 0])[column] += 1
    if not totals:
        print('no starved passes')
        return
    print('starved passes (once per gate or run)')
    table(['repo', 'gates', 'runs'], [[repo, *counts] for repo, counts in sorted(totals.items())])
    table(['test', 'repo', 'gates', 'runs'],
          [[name, repo, *counts] for (repo, name), counts in sorted(
              tests.items(), key=lambda item: (-sum(item[1]), item[0][1], item[0][0]))])


def report(records, runner, lands, repo, tsv):
    results = [(r, r['result']) for r in records if isinstance(r.get('result'), dict)
               and isinstance(r['result'].get('repo'), str)]
    if repo is not None:
        results = [(r, x) for r, x in results if x['repo'] == repo]
        runner = [r for r in runner if r['kind'] == 'tier' and follower(r['tier'])[0] == repo]
        lands = [r for r in lands if r['repo'] == repo]
    if tsv:
        columns = ['prebuild_wait_s', 'prebuild_run_s', 'gate_wait_s', 'gate_run_s',
                   'gate_exit', 'failed_step', *STEPS, 'other']
        print('\t'.join(['time', 'set', 'event', 'repo', 'machine', 'kind', *columns]))
        for record, result in results:
            gate = part(result, 'gate')
            row = costs(result)
            row['failed_step'] = gate.get('failed_step')
            cells = [record['time'], record['set'], record['event'], result['repo'],
                     result.get('machine'), gate.get('kind'),
                     *(row[c] for c in columns)]
            print('\t'.join('' if c is None else str(c) for c in cells))
        return
    if not results:
        print('no results')
    else:
        print('gates by repository (times m:ss; medians over gates run; '
              'a step only where it ran)')
        rows = []
        for name in sorted({x['repo'] for _, x in results}):
            mine = [x for _, x in results if x['repo'] == name]
            ran = [costs(x) for x in mine if part(x, 'gate').get('kind') == 'ran']
            cached = sum(part(x, 'gate').get('kind') == 'cached' for x in mine)
            bad = [x for x in mine if failed(x)]
            col = lambda key: [r[key] for r in ran]
            causes = {}
            for x in bad:
                step = part(x, 'gate').get('failed_step')
                step = step if isinstance(step, str) else (
                    'prebuild' if part(x, 'prebuild').get('exit') not in (None, 0) else '?')
                causes[step] = causes.get(step, 0) + 1
            rows.append([name, len(ran), cached, len(bad), median(col('gate_run_s')),
                         p90(col('gate_run_s')), median(col('gate_wait_s')),
                         median(col('prebuild_run_s')),
                         *(median(col(step)) for step in (*STEPS, 'other')),
                         ' '.join(f'{k}={v}' for k, v in sorted(causes.items())) or '-'])
        table(['repo', 'ran', 'cached', 'failed', 'gate', 'p90', 'wait', 'prebuild',
               *STEPS, 'other', 'failures'], rows)
    runs = {}
    for record in records:
        runs.setdefault(record['token'], []).append(record)
    if repo is not None:
        runs = {k: run for k, run in runs.items() if any(
            r.get('repo') == repo or part(r, 'result').get('repo') == repo for r in run)}
    sets, proves = {}, {}
    for run in runs.values():
        first = lambda event: next((r for r in run if r['event'] == event), None)
        end, waiting = ending(run), first('waiting')
        # A prove's run is from proving to its end, and holds no lock.
        started = first('proving') if run[0].get('mode') == 'prove' else first('started')
        entries = proves if run[0].get('mode') == 'prove' else sets
        entry = entries.setdefault(run[0]['set'], {'runs': 0, 'done': 0, 'proved': 0, 'stopped': 0,
                                                   'proof': 0, 'wait': [], 'run': []})
        entry['runs'] += 1
        if end:
            entry[end['event']] += 1
        if started and started.get('proof'):
            entry['proof'] += 1
        if waiting and started:
            entry['wait'].append((started['utc'] - waiting['utc']).total_seconds())
        if started and end:
            entry['run'].append((end['utc'] - started['utc']).total_seconds())
    print()
    if not sets and not proves:
        print('no set runs')
    naming = f' naming {repo}' if repo is not None else ''
    longest = lambda values: mss(max(values)) if values else '-'
    if sets:
        print(f'set runs{naming} (lock wait: waiting to started; run: started to done or stopped; '
              'proof: started from a prove)')
        table(['set', 'runs', 'done', 'stopped', 'proof', 'wait', 'longest', 'run', 'longest'],
              [[name, e['runs'], e['done'], e['stopped'], e['proof'], median(e['wait']),
                longest(e['wait']), median(e['run']), longest(e['run'])]
               for name, e in sorted(sets.items())])
    if proves:
        if sets:
            print()
        print(f'proves{naming} (no lock; run: proving to proved or stopped)')
        table(['set', 'runs', 'proved', 'stopped', 'run', 'longest'],
              [[name, e['runs'], e['proved'], e['stopped'], median(e['run']), longest(e['run'])]
               for name, e in sorted(proves.items())])

    print()
    report_verdicts(records, runner, lands)
    print()
    report_starved(results, runner, lands)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--last', type=count, default=20)
    commands = parser.add_subparsers(dest='command')
    waiter = commands.add_parser('wait', help='wait for a set to land or stop')
    waiter.add_argument('set')
    waiter.add_argument('--timeout', type=seconds)
    waiter.add_argument('--post', metavar='ADDRESS', help='post a bounded verdict summary and log references')
    waiter.add_argument('--cleared', action='store_true', help='wait for tier verdicts (default timeout: 7200s)')
    cleared = commands.add_parser('cleared', help='show the newest main with all run verdicts cleared')
    cleared.add_argument('repo')
    teacher = commands.add_parser('taught', help='show every landing and what it taught')
    teacher.add_argument('--since', type=since, help='UTC date or ISO time')
    reporter = commands.add_parser('report', help='summarize gate and set costs')
    reporter.add_argument('--since', type=since, help='UTC date or ISO time')
    reporter.add_argument('--repo')
    reporter.add_argument('--tsv', action='store_true', help='one row per result')
    args = parser.parse_args()
    if args.command == 'wait':
        try:
            poll = seconds(os.environ.get('LANDINGS_POLL', '30'))
            unreachable = seconds(os.environ.get('LANDINGS_UNREACHABLE', '300'))
            read = seconds(os.environ.get('LANDINGS_READ', '15'))
            if poll == 0 or unreachable == 0 or read == 0:
                raise ValueError('poll, unreachable and read intervals must be positive')
        except (ValueError, argparse.ArgumentTypeError) as error:
            parser.error(str(error))
        timeout = 7200 if args.cleared and args.timeout is None else args.timeout
        return wait_and_post(args.post, args.set, timeout, poll, unreachable, read, args.cleared)
    try:
        records, runner, lands = read_feed()
    except (OSError, subprocess.TimeoutExpired) as error:
        print(f'landings: feed unreadable: {error}', file=sys.stderr)
        return 4
    if args.command == 'cleared':
        return cleared_main(runner, args.repo, Checkouts(workspace()))
    if args.command == 'taught':
        events = sorted([r for r in records if r['event'] == 'landed'] + lands,
                        key=lambda r: r['position'])
        for record in events:
            if args.since is None or record['utc'] >= args.since:
                print(event_line(record))
                for line in taught_lines(record):
                    print(line)
        return 0
    if args.command == 'report':
        if args.since is not None:
            records = [r for r in records if r['utc'] >= args.since]
            runner = [r for r in runner if r['utc'] >= args.since]
            lands = [r for r in lands if r['utc'] >= args.since]
        report(records, runner, lands, args.repo, args.tsv)
        return 0
    show(records, lands, args.last, runner, Checkouts(workspace()))
    show_tiers(runner, records)
    return 0


if __name__ == '__main__':
    sys.exit(main())
