def seconds(value):
    number = float(value)
    if not math.isfinite(number) or number < 0:
        raise argparse.ArgumentTypeError('seconds must be finite and nonnegative')
    return number


def count(value):
    number = int(value)
    if number < 0:
        raise argparse.ArgumentTypeError('count must be nonnegative')
    return number


def read_feed(timeout=15):
    local = os.environ.get('LANDINGS_FEED')
    # Fixtures can force the remote branch without depending on this machine.
    host = os.environ.get('LANDINGS_FIXTURE_HOSTNAME', socket.gethostname())
    if local is not None or host == COORDINATOR:
        data = Path(local if local is not None else FEED).read_bytes()
    else:
        result = subprocess.run([*SSH, TAIL], stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                timeout=timeout)
        if result.returncode:
            reason = result.stderr.decode(errors='replace').strip()
            raise OSError(f'ssh exited {result.returncode}: {reason}')
        data = result.stdout
    records, runner = [], []
    for line in data.splitlines():
        try:
            record = json.loads(line)
            if isinstance(record, dict) and record.get('kind') in ('tier', 'watch'):
                if runner_record(record):
                    stamp_record(record)
                    runner.append(record)
                continue
            if not isinstance(record, dict) or not all(
                    isinstance(record.get(key), str) and record[key]
                    for key in ('time', 'set', 'host', 'token')):
                continue
            stamp = datetime.fromisoformat(record['time'])
            if stamp.tzinfo is None:
                continue
            stamp = stamp.astimezone(timezone.utc)
            record['utc'] = stamp
            record['date'] = stamp.strftime('%m-%d')
            record['clock'] = stamp.strftime('%H:%MZ')
            record.setdefault('event', 'landed')
            if not isinstance(record['event'], str):
                continue
            if any(key in record and not isinstance(record[key], str)
                   for key in ('repo', 'commit', 'reason')):
                continue
            records.append(record)
        except (ValueError, UnicodeError, OverflowError, RecursionError):
            continue
    return records, runner


def utc(value):
    stamp = datetime.fromisoformat(value)
    if stamp.tzinfo is None:
        raise ValueError('time lacks a zone')
    return stamp.astimezone(timezone.utc)


def stamp_record(record):
    record['utc'] = utc(record['time'])
    record['date'] = record['utc'].strftime('%m-%d')
    record['clock'] = record['utc'].strftime('%H:%MZ')


def runner_record(row):
    """Validate the runner boundary before any display or wait uses its fields."""
    text = lambda value: isinstance(value, str) and bool(value)
    nullable = lambda value: value is None or text(value)
    strings = lambda value: isinstance(value, list) and all(text(v) for v in value)
    if not all(text(row.get(k)) for k in ('time', 'event', 'host', 'token')):
        return False
    if not re.fullmatch(r'[0-9a-fA-F]{32}', row['token']):
        return False
    utc(row['time'])
    if not more_counts(row):
        return False
    if row['kind'] == 'watch':
        return (row['event'] == 'watching' and text(row.get('target'))
                and 'name' in row and nullable(row['name']))
    if not text(row.get('tier')):
        return False
    event = row['event']
    if event == 'fault':
        if not ('commit' in row and nullable(row['commit'])
                and text(row.get('reason')) and text(row.get('since'))):
            return False
        utc(row['since'])
        return True
    if not text(row.get('commit')):
        return False
    if event == 'recovered':
        if not text(row.get('since')):
            return False
        utc(row['since'])
        return True
    if event == 'running':
        return 'from' in row and nullable(row['from'])
    if event not in ('tier', 'verdict') or not strings(row.get('flakes')) or not text(row.get('log')):
        return False
    if event == 'verdict':
        return (text(row.get('run')) and row.get('verdict') in ('cleared', 'red')
                and strings(row.get('tests')) and 'set' in row and nullable(row['set'])
                and (row['verdict'] != 'red' or isinstance(row.get('excerpt'), str))
                and ('excerpt' not in row or isinstance(row['excerpt'], str)))
    return (row.get('state') in ('green', 'red') and 'last_green' in row
            and nullable(row['last_green']) and number(row.get('ran_s')) is not None
            and row['ran_s'] >= 0 and isinstance(row.get('reds'), list)
            and all(isinstance(red, dict) and 'landing' in red and nullable(red['landing'])
                    and strings(red.get('tests')) and more_counts(red) for red in row['reds']))


def more_counts(row):
    return all(key not in row or (type(row[key]) is int and row[key] >= 0)
               for key in ('tests_more', 'flakes_more'))


def newest(records):
    # Feed position breaks ties between records written in the same instant.
    return max(enumerate(records), key=lambda pair: (pair[1]['utc'], pair[0]))[1] if records else None


def show_tiers(records, set_records):
    repos = {r['tier'] for r in records if r['kind'] == 'tier'}
    if not repos:
        print('tiers: none in the feed')
        return
    print('tiers:')
    for repo in sorted(repos, key=lambda name: (ORDER.index(name) if name in ORDER else len(ORDER), name)):
        mine = [r for r in records if r.get('tier') == repo]
        # Compare positions too: the terminal record can share a timestamp with running.
        ordered = sorted(enumerate(mine), key=lambda pair: (pair[1]['utc'], pair[0]))
        state = running = fault = None
        for _, row in ordered:
            if row['event'] == 'tier':
                state, running, fault = row, None, None
            elif row['event'] == 'running':
                running, fault = row, None
            elif row['event'] == 'fault':
                fault = row
            elif row['event'] == 'recovered':
                fault = None
        parts = []
        if fault:
            clock = utc(fault['since']).strftime('%H:%MZ')
            parts.append(f"fault since {clock}: {fault['reason']}")
        if running:
            parts.append(f"running on {running['commit'][:9]} since {running['clock']}")
        if state:
            line = f"{state['state']} at {state['commit'][:9]} ({state['date']} {state['clock']})"
            if state['state'] == 'red':
                tests = sum(len(red['tests']) + red.get('tests_more', 0)
                            for red in state['reds']) + state.get('tests_more', 0)
                line += f": {tests} tests"
                reds = [red['landing'] for red in state['reds'] if red['landing'] is not None]
                verdicts = [r for r in mine if r['event'] == 'verdict' and r['commit'] in reds]
                # A verdict can be reissued or published out of landing order.
                # Prefer the landing's own timestamp; a truncated feed may leave
                # only verdict times, or ultimately the standing-red list order.
                def landed_at(commit):
                    landed = [r['utc'] for r in set_records if r['event'] == 'landed'
                              and r.get('repo') == repo and r.get('commit') == commit]
                    seen = [r['utc'] for r in verdicts if r['commit'] == commit]
                    return min(landed or seen or [state['utc']])
                landing = min(reds, key=landed_at) if reds else None
                named = newest([r for r in verdicts if r['commit'] == landing and r['set']])
                if landing:
                    line += f", first red {landing[:9]}"
                    if named:
                        line += f" ({named['set']})"
                if state['last_green']:
                    line += f"; green at {state['last_green'][:9]}"
                    green = newest([r for r in mine if r['event'] == 'tier'
                                    and r['state'] == 'green' and r['commit'] == state['last_green']])
                    if green:
                        line += f" ({green['date']} {green['clock']})"
            parts.append(line)
        print(f"  {repo}: " + ('; '.join(parts) or 'no completed run'))


def watch(target, timeout):
    row = dict(time=datetime.now(timezone.utc).isoformat(), kind='watch', event='watching',
               host=socket.gethostname(), token=secrets.token_hex(16), target=target,
               name=os.environ.get('POST_NAME') or None)
    local = os.environ.get('LANDINGS_FEED')
    host = os.environ.get('LANDINGS_FIXTURE_HOSTNAME', socket.gethostname())
    argv = ['python3', '-I', '-c', FEED_PROGRAM, local if local is not None else FEED]
    if local is None and host != COORDINATOR:
        argv = [*SSH, shlex.join(argv)]
    try:
        result = subprocess.run(argv, input=(json.dumps(row) + '\n').encode(),
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
        if result.returncode:
            raise OSError(result.stderr.decode(errors='replace').strip() or f'exit {result.returncode}')
    except (OSError, subprocess.TimeoutExpired) as error:
        print(f'landings: warning: feed append failed: {error}', file=sys.stderr)


def verdict_line(row):
    line = (f"{row['date']} {row['clock']} {row['tier']} {row['commit'][:9]} "
            f"{row['verdict']} by run {row['run'][:9]}")
    if row['verdict'] == 'red':
        line += ': ' + '; '.join(row['tests'])
        if row.get('tests_more'):
            line += f"; {row['tests_more']} more tests"
        line += f"; log {row['host']}:{row['log']}"
    if row['flakes']:
        line += '; flakes: ' + '; '.join(row['flakes'])
    if row.get('flakes_more'):
        line += f"; {row['flakes_more']} more flakes"
    print(line)
    if row['verdict'] == 'red':
        for line in row['excerpt'].splitlines():
            print('    ' + line)


def clearance(records, runner, target):
    verdicts = [r for r in runner if r['kind'] == 'tier' and r['event'] == 'verdict']
    latest = {}
    for row in sorted(verdicts, key=lambda r: r['utc']):
        latest[row['tier'], row['commit']] = row
    if re.fullmatch(r'[0-9a-fA-F]{7,40}', target):
        landings = [key for key in latest if key[1].lower().startswith(target.lower())]
        ready = bool(landings)
    else:
        run = latest_runs(records).get(target, [])
        terminal = ending(run)
        if terminal is not None and terminal['event'] == 'stopped':
            print(event_line(terminal))
            return 1, []
        ready = terminal is not None and terminal['event'] == 'done'
        landings = list(dict.fromkeys((r['repo'], r['commit']) for r in run
                                     if r['event'] == 'landed' and r.get('repo') and r.get('commit'))) if ready else []
    decided = [latest[key] for key in landings if key in latest]
    missing = [key for key in landings if key not in latest]
    red = any(r['verdict'] == 'red' for r in decided)
    if red or (ready and not missing):
        for row in decided:
            verdict_line(row)
        return (1 if red else 0), missing
    return None, missing


def event_line(record):
    parts = [record['date'], record['clock'], record['set'], record['event']]
    if record.get('repo'):
        parts.append(record['repo'])
    if record.get('commit'):
        parts.append(record['commit'][:9])
    if record['event'] == 'stopped':
        parts.extend(('status=' + str(record.get('status', '?')),
                      'reason=' + record.get('reason', '')))
    parts.append(record['host'])
    return ' '.join(parts)


def latest_runs(records, proves=False):
    """Each set's latest run that lands it, or with PROVES, that proves it."""
    starts = ('proving',) if proves else ('waiting', 'started')
    runs, latest = {}, {}
    for record in records:
        key = record['set'], record['token']
        if key not in runs:
            runs[key] = []
            # Without the start, legacy or truncated runs are history only.
            if record['event'] in starts:
                latest[record['set']] = runs[key]
        runs[key].append(record)
    return latest


def ending(run):
    return next((r for r in reversed(run) if r['event'] in ('done', 'proved', 'stopped')), None)


def show(records, last):
    for record in records[-last:] if last else []:
        print(event_line(record))
    active = [run for run in latest_runs(records).values() if ending(run) is None]
    active += [run for run in latest_runs(records, proves=True).values() if ending(run) is None]
    if not active:
        print('in flight: none')
    else:
        print('in flight:')
    for run in active:
        started = next((r for r in run if r['event'] == 'started'), None)
        since = started or run[0]
        state = ('proving (no lock)' if run[0]['event'] == 'proving' else
                 'running (holds set lock)' if started else 'waiting')
        line = f"  {run[0]['set']}: {state} since {since['time']} on {since['host']}"
        line += f"; last event {run[-1]['clock']}"
        progress = next((r for r in reversed(run) if r['event'] in ('gated', 'landed')), None)
        if progress:
            line += f"; last {progress['event']} {progress.get('repo', '')} {progress.get('commit', '')[:9]}"
        print(line)


def wait(label, timeout, poll, unreachable, read=15, cleared=False):
    start = last_read = time.monotonic()
    deadline = start + timeout if timeout is not None else math.inf
    last_error = None
    first_read = True
    missing = []
    if cleared:
        watch(label, read)
    while True:
        now = time.monotonic()
        # Always attempt the initial read, even with --timeout 0.
        read_limit = read if first_read else max(
            .001, min(read, deadline - now, last_read + unreachable - now))
        first_read = False
        try:
            records, runner = read_feed(read_limit)
        except (OSError, subprocess.TimeoutExpired) as error:
            # A final attempt with little time left must not hide the transport's reason.
            if last_error is None or not isinstance(error, subprocess.TimeoutExpired):
                last_error = error
            now = time.monotonic()
            if now >= last_read + unreachable and last_read + unreachable <= deadline:
                print(f'landings: feed unreadable: {last_error}', file=sys.stderr)
                return 4
        else:
            last_read = time.monotonic()
            last_error = None
            if cleared:
                status, missing = clearance(records, runner, label)
                if status is not None:
                    return status
            else:
                run = latest_runs(records).get(label, [])
                terminal = ending(run)
                if terminal is not None:
                    if terminal['event'] == 'stopped':
                        print(event_line(terminal))
                        return 1
                    previous_done = -1
                    for index, record in enumerate(records):
                        if record is terminal:
                            end = index
                            break
                        if record['set'] == label and record['event'] == 'done':
                            previous_done = index
                    for record in records[previous_done + 1:end]:
                        if record['set'] == label and record['event'] == 'landed':
                            print(event_line(record))
                    return 0
        now = time.monotonic()
        if now >= deadline:
            print(f'landings: timed out waiting for {label}', file=sys.stderr)
            for repo, commit in missing:
                print(f'landings: no verdict for {repo} {commit}', file=sys.stderr)
            return 3
        time.sleep(max(0, min(poll, deadline - now, last_read + unreachable - now)))


STEPS = ('fmt', 'clippy', 'wasm', 'build', 'focused', 'fuzzy', 'bundle', 'browser')


def since(value):
    try:
        stamp = datetime.fromisoformat(value)
    except ValueError:
        raise argparse.ArgumentTypeError('since must be a date or an ISO time')
    # A bare date or a time without a zone is UTC.
    return stamp.replace(tzinfo=stamp.tzinfo or timezone.utc).astimezone(timezone.utc)


def number(value):
    ok = isinstance(value, (int, float)) and not isinstance(value, bool)
    return value if ok and math.isfinite(value) else None


def part(result, name):
    value = result.get(name)
    return value if isinstance(value, dict) else {}


def costs(result):
    """One result's times: None for what it doesn't carry."""
    prebuild, gate = part(result, 'prebuild'), part(result, 'gate')
    steps = gate.get('steps') if isinstance(gate.get('steps'), dict) else None
    row = {'prebuild_wait_s': number(prebuild.get('wait_s')),
           'prebuild_run_s': number(prebuild.get('run_s')),
           'gate_wait_s': number(gate.get('wait_s')),
           'gate_run_s': number(gate.get('run_s')),
           'gate_exit': number(gate.get('exit'))}
    for step in STEPS:
        row[step] = number(steps.get(step)) if steps else None
    run = row['gate_run_s']
    # Without steps (an older gate), its whole time is no evidence for other.
    row['other'] = (None if steps is None or run is None or gate.get('kind') != 'ran' else
                    round(max(0, run - sum(filter(None, map(number, steps.values())))), 3))
    return row


def failed(result):
    return any(part(result, name).get('exit') not in (None, 0)
               for name in ('prebuild', 'gate'))


def mss(value):
    value = round(value)
    return f'{value // 60}:{value % 60:02d}'


def median(values, show=mss):
    values = [v for v in values if v is not None]
    return show(statistics.median(values)) if values else '-'


def p90(values):
    values = sorted(v for v in values if v is not None)
    # Nearest rank: the smallest value at or above 90% of them.
    return mss(values[math.ceil(.9 * len(values)) - 1]) if values else '-'


def table(head, rows):
    widths = [max(len(str(c)) for c in column) for column in zip(head, *rows)]
    for row in (head, *rows):
        print('  '.join(str(c).rjust(w) if i else str(c).ljust(w)
                        for i, (c, w) in enumerate(zip(row, widths))).rstrip())


def report(records, repo, tsv):
    results = [(r, r['result']) for r in records if isinstance(r.get('result'), dict)
               and isinstance(r['result'].get('repo'), str)]
    if repo is not None:
        results = [(r, x) for r, x in results if x['repo'] == repo]
    if tsv:
        columns = ['prebuild_wait_s', 'prebuild_run_s', 'gate_wait_s', 'gate_run_s',
                   'gate_exit', 'failed_step', *STEPS, 'other']
        print('\t'.join(['time', 'set', 'event', 'repo', 'machine', 'kind', *columns]))
        for record, result in results:
            gate = part(result, 'gate')
            row = costs(result)
            row['failed_step'] = gate.get('failed_step')
            cells = [record['time'], record['set'], record['event'], result['repo'],
                     result.get('machine'), gate.get('kind'),
                     *(row[c] for c in columns)]
            print('\t'.join('' if c is None else str(c) for c in cells))
        return
    if not results:
        print('no results')
    else:
        print('gates by repository (times m:ss; medians over gates run; '
              'a step only where it ran)')
        rows = []
        for name in sorted({x['repo'] for _, x in results}):
            mine = [x for _, x in results if x['repo'] == name]
            ran = [costs(x) for x in mine if part(x, 'gate').get('kind') == 'ran']
            cached = sum(part(x, 'gate').get('kind') == 'cached' for x in mine)
            bad = [x for x in mine if failed(x)]
            col = lambda key: [r[key] for r in ran]
            causes = {}
            for x in bad:
                step = part(x, 'gate').get('failed_step')
                step = step if isinstance(step, str) else (
                    'prebuild' if part(x, 'prebuild').get('exit') not in (None, 0) else '?')
                causes[step] = causes.get(step, 0) + 1
            rows.append([name, len(ran), cached, len(bad), median(col('gate_run_s')),
                         p90(col('gate_run_s')), median(col('gate_wait_s')),
                         median(col('prebuild_run_s')),
                         *(median(col(step)) for step in (*STEPS, 'other')),
                         ' '.join(f'{k}={v}' for k, v in sorted(causes.items())) or '-'])
        table(['repo', 'ran', 'cached', 'failed', 'gate', 'p90', 'wait', 'prebuild',
               *STEPS, 'other', 'failures'], rows)
    runs = {}
    for record in records:
        runs.setdefault(record['token'], []).append(record)
    if repo is not None:
        runs = {k: run for k, run in runs.items() if any(
            r.get('repo') == repo or part(r, 'result').get('repo') == repo for r in run)}
    sets, proves = {}, {}
    for run in runs.values():
        first = lambda event: next((r for r in run if r['event'] == event), None)
        end, waiting = ending(run), first('waiting')
        # A prove's run is from proving to its end, and holds no lock.
        started = first('proving') if run[0].get('mode') == 'prove' else first('started')
        entries = proves if run[0].get('mode') == 'prove' else sets
        entry = entries.setdefault(run[0]['set'], {'runs': 0, 'done': 0, 'proved': 0, 'stopped': 0,
                                                   'proof': 0, 'wait': [], 'run': []})
        entry['runs'] += 1
        if end:
            entry[end['event']] += 1
        if started and started.get('proof'):
            entry['proof'] += 1
        if waiting and started:
            entry['wait'].append((started['utc'] - waiting['utc']).total_seconds())
        if started and end:
            entry['run'].append((end['utc'] - started['utc']).total_seconds())
    print()
    if not sets and not proves:
        print('no set runs')
        return
    naming = f' naming {repo}' if repo is not None else ''
    longest = lambda values: mss(max(values)) if values else '-'
    if sets:
        print(f'set runs{naming} (lock wait: waiting to started; run: started to done or stopped; '
              'proof: started from a prove)')
        table(['set', 'runs', 'done', 'stopped', 'proof', 'wait', 'longest', 'run', 'longest'],
              [[name, e['runs'], e['done'], e['stopped'], e['proof'], median(e['wait']),
                longest(e['wait']), median(e['run']), longest(e['run'])]
               for name, e in sorted(sets.items())])
    if proves:
        if sets:
            print()
        print(f'proves{naming} (no lock; run: proving to proved or stopped)')
        table(['set', 'runs', 'proved', 'stopped', 'run', 'longest'],
              [[name, e['runs'], e['proved'], e['stopped'], median(e['run']), longest(e['run'])]
               for name, e in sorted(proves.items())])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--last', type=count, default=20)
    commands = parser.add_subparsers(dest='command')
    waiter = commands.add_parser('wait', help='wait for a set to land or stop')
    waiter.add_argument('set')
    waiter.add_argument('--timeout', type=seconds)
    waiter.add_argument('--cleared', action='store_true', help='wait for tier verdicts (default timeout: 7200s)')
    reporter = commands.add_parser('report', help='summarize gate and set costs')
    reporter.add_argument('--since', type=since, help='UTC date or ISO time')
    reporter.add_argument('--repo')
    reporter.add_argument('--tsv', action='store_true', help='one row per result')
    args = parser.parse_args()
    if args.command == 'wait':
        try:
            poll = seconds(os.environ.get('LANDINGS_POLL', '30'))
            unreachable = seconds(os.environ.get('LANDINGS_UNREACHABLE', '300'))
            read = seconds(os.environ.get('LANDINGS_READ', '15'))
            if poll == 0 or unreachable == 0 or read == 0:
                raise ValueError('poll, unreachable and read intervals must be positive')
        except (ValueError, argparse.ArgumentTypeError) as error:
            parser.error(str(error))
        timeout = 7200 if args.cleared and args.timeout is None else args.timeout
        return wait(args.set, timeout, poll, unreachable, read, args.cleared)
    try:
        records, runner = read_feed()
    except (OSError, subprocess.TimeoutExpired) as error:
        print(f'landings: feed unreadable: {error}', file=sys.stderr)
        return 4
    if args.command == 'report':
        if args.since is not None:
            records = [r for r in records if r['utc'] >= args.since]
        report(records, args.repo, args.tsv)
        return 0
    show(records, args.last)
    show_tiers(runner, records)
    return 0


if __name__ == '__main__':
    sys.exit(main())
