def dirty(lab):
    for name in ('untracked', 'tracked', 'locked', 'held'):
        oid = lab.landed(name)
        work = lab.wt(name)
        if name == 'untracked':
            lab.put(work / 'loose')
        elif name == 'tracked':
            lab.put(work / 'file', 'modified\n')
        elif name == 'locked':
            lab.git(lab.a, 'worktree', 'lock', str(work))
        else:
            process = subprocess.Popen([sys.executable, '-c', 'import sys; sys.stdin.buffer.read()'], stdin=subprocess.PIPE, cwd=work,
                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        try:
            text = lab.run('agents')
            assert f'kept worktree {work}:' in text, (name, text)
            assert work.exists() and lab.exists(name)
        finally:
            if name == 'held':
                process.stdin.close()
                process.wait(timeout=HUNG_TIDY_S)
        # Leave this worktree for subsequent runs: each remains guarded.
        if name == 'held':
            lab.git(lab.a, 'worktree', 'lock', str(work))
    lab.git(lab.a, 'config', 'branch.main.landed', oid)
    assert lab.a.exists() and str(lab.a) not in lab.run('agents')


