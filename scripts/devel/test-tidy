#!/usr/bin/env python3
"""Isolated, offline tidy fixtures; select cases by name."""
from case_runner import HUNG_TOOL_S
from contextlib import ExitStack
from datetime import datetime, timedelta, timezone
import fcntl
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import time
from urllib.parse import quote

import case_runner

SCRIPT = Path(__file__).resolve().with_name('tidy')
GIT = shutil.which('git')
# Hang detection, not a tidy performance requirement; see the measured commit.
HUNG_TIDY_S = HUNG_TOOL_S
REPOS = ('agents', 'skein', 'smith', 'jig', 'hearth', 'qa', 'temper')
# Only these cases inspect the trace or inject fetch/push faults.
GIT_TRACED = ('copies', 'fetch_failure', 'push_failure', 'order')


class Lab:
    def __init__(self, root, trace_git=False, built=None):
        if built is not None:
            # Copy bytes, never hardlink mutable refs, objects, index or logs.
            shutil.copytree(built, root, dirs_exist_ok=True)
            # Clones record their source both in config and in clone reflogs.
            for config in root.rglob('config'):
                config.write_text(config.read_text().replace(str(built), str(root)))
            for log in root.rglob('logs'):
                for path in log.rglob('*'):
                    if path.is_file():
                        path.write_text(path.read_text().replace(str(built), str(root)))
        self.root = root
        self.workspace = root / 'workspace'
        self.tmp = self.workspace / 'tmp'
        self.records = self.workspace / 'records'
        self.bin = root / 'bin'
        for path in (self.tmp, self.records, self.bin, root / 'home'):
            path.mkdir(parents=True, exist_ok=True)
        self.env = dict(PATH=str(self.bin) + ':' + os.environ['PATH'], HOME=str(root / 'home'),
                        DEV_ROOT=str(self.workspace), DEV_TMP=str(self.tmp), RECORDS=str(self.records),
                        GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@invalid',
                        GIT_AUTHOR_DATE='2026-10-01T12:00:00+00:00',
                        GIT_COMMITTER_DATE='2026-10-01T12:00:00+00:00',
                        GIT_ALLOW_PROTOCOL='file', LC_ALL='C.UTF-8')
        heavy = self.put(self.bin / 'heavy', '#!/bin/sh\n[ \"$1\" = --installed ] || exit 9\nexit \"${HEAVY_INSTALLED:-1}\"\n')
        heavy.chmod(0o700)
        self.record = self.bin / 'record'
        self.record.write_text('#!/bin/sh\n[ "$1" = pull ] || exit 9\n'
                               'echo pull >>"$RECORDS/pulls"\nexit "${FAIL_PULL:-0}"\n')
        self.record.chmod(0o700)
        self.env['TIDY_RECORD'] = str(self.record)
        if trace_git:
            # Trace order and inject faults only where a case needs them.
            wrapper = self.bin / 'git'
            wrapper.write_text('#!/bin/sh\n'
                               'printf "%s\\n" "$*" >>"$DEV_ROOT/git.trace"\n'
                               'case "$*" in\n'
                               ' *fetch*) [ -z "$FAIL_FETCH" ] || case "$*" in *"-C $DEV_ROOT/$FAIL_FETCH fetch"*) exit 7;; esac;;\n'
                               ' *push*) [ -z "$FAIL_PUSH" ] || exit 8;;\n'
                               'esac\nexec ' + shlex.quote(GIT) + ' "$@"\n')
            wrapper.chmod(0o700)
        self.origins, self.primary = {}, {}
        if built is None:
            seed = root / 'seed'
            seed.mkdir()
            self.git(seed, 'init', '-b', 'main')
            self.put(seed / 'file', 'base\n')
            self.put(seed / '.gitignore', 'target/\n')
            self.commit(seed, 'baseline')
        for name in REPOS:
            origin, primary = root / f'{name}.git', self.workspace / name
            if built is None:
                self.git(root, 'clone', '--bare', str(seed), str(origin))
                self.git(root, 'clone', str(origin), str(primary))
            self.origins[name], self.primary[name] = origin, primary
        if built is None:
            self.git(root, 'clone', '--bare', str(seed), str(root / 'records.git'))
            self.git(root, 'clone', str(root / 'records.git'), str(self.records))
        self.a = self.primary['agents']
        self.base = self.git(self.a, 'rev-parse', 'HEAD')

    def git(self, path, *args, check=True):
        result = subprocess.run([GIT, '-C', str(path), *args], env=self.env, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=HUNG_TOOL_S)
        assert not check or result.returncode == 0, (args, result.stdout, result.stderr)
        return result.stdout.strip() if check else result

    def put(self, path, text='fixture\n'):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
        return path

    def commit(self, path, subject):
        self.git(path, 'add', '.')
        self.git(path, 'commit', '-m', subject)
        return self.git(path, 'rev-parse', 'HEAD')

    def branch(self, name, repo='agents', remote=True):
        path = self.primary[repo]
        self.git(path, 'checkout', '-b', name, 'main')
        self.put(path / name, name + '\n')
        oid = self.commit(path, name)
        if remote:
            self.git(path, 'push', 'origin', f'HEAD:{name}')
        self.git(path, 'checkout', 'main')
        return oid

    def landed(self, name='done', repo='agents', remote=True):
        oid = self.branch(name, repo, remote)
        path = self.primary[repo]
        self.git(path, 'merge', '--ff-only', name)
        self.git(path, 'push', 'origin', 'main')
        self.git(path, 'config', f'branch.{name}.landed', oid)
        return oid

    def wt(self, name='done', path=None, repo='agents'):
        path = path or self.tmp / 'owners' / 'active' / name
        self.git(self.primary[repo], 'worktree', 'add', str(path), name)
        return path

    def target(self, name, age, owner='mission', path=None, triple=False, repo='agents'):
        work = path or self.tmp / 'owners' / owner / name
        self.git(self.primary[repo], 'worktree', 'add', '-b', name, str(work), self.base)
        target = work / 'target'
        self.put(target / 'CACHEDIR.TAG')
        profile = target / 'x86_64-unknown-linux-gnu' / 'debug' if triple else target / 'debug'
        for child in ('deps', '.fingerprint', 'build'):
            (profile / child).mkdir(parents=True)
        self.put(profile / '.cargo-lock', '')
        self.age_target(target, age)
        return target

    def kept_target(self, name, age=1800, token='0' * 32):
        label = 'fixture/' + name
        path = self.tmp / 'land-set' / 'worktrees' / quote(label, safe='') / 'agents'
        branch = f'land-set/{token}/agents'
        target = self.target(branch, age, path=path)
        self.put(path / 'file', label + '\n')
        commit = self.commit(path, label)
        entry = dict(base=self.base, commit=commit, tree=self.git(path, 'rev-parse', 'HEAD^{tree}'),
                     pin_only=True, worktree=str(path))
        proof = dict(schema='land-set-proof-v1', set=label, machine='fixture', token=token,
                     time=datetime.now(timezone.utc).isoformat(), repos=dict(agents=entry))
        proof_file = self.tmp / 'land-set' / 'proofs' / (quote(label, safe='') + '.json')
        self.put(proof_file, json.dumps(proof))
        self.put(self.tmp / 'land-set' / 'state' / (quote(label, safe='') + '.lock'), '')
        return target, proof_file, branch

    def age_target(self, target, age):
        stamp = time.time() - age
        # Only fixture setup walks; the tool samples Cargo's directory timestamps.
        for base, dirs, files in os.walk(target, topdown=False):
            os.utime(base, (stamp, stamp))

    def target_exists(self, target):
        return target.is_dir()

    def readme(self, mission, state):
        self.put(self.records / 'missions' / mission / 'README.md',
                 f'---\nstate: {state}\nended: 2026-10-01\n---\n\nMission.\n')
        path = self.tmp / 'owners' / mission
        path.mkdir(parents=True, exist_ok=True)
        return path

    def run(self, *args, status=0, extra=None):
        result = subprocess.run([sys.executable, '-I', str(SCRIPT), *args], cwd=self.root,
                                env=dict(self.env, **(extra or {})), text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=HUNG_TIDY_S)
        assert result.returncode == status, (args, result.returncode, result.stdout, result.stderr)
        return result.stdout + result.stderr

    def target_fault(self, code, *args, status=3):
        # Faults live in a child interpreter, never in the tool or the machine.
        driver = ('import errno, runpy, sys\n'
                  f'tool = runpy.run_path({str(SCRIPT)!r})\n'
                  f'sys.argv = {[str(SCRIPT), *args, "--targets"]!r}\n' + code +
                  '\nraise SystemExit(tool["main"]())\n')
        result = subprocess.run([sys.executable, '-I', '-S', '-c', driver], cwd=self.root,
                                env=self.env, text=True, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, timeout=HUNG_TIDY_S)
        assert result.returncode == status, (result.returncode, result.stdout, result.stderr)
        return result.stdout + result.stderr

    def room_free(self, gb):
        source = self.put(self.root / 'free-bytes', str(gb * 2**30))
        self.env['TIDY_FREE_BYTES'] = str(source)
        return source

    def room_reclaim(self, gb, *args, code='', status=0):
        # Model recovered blocks after deletion, entirely inside the fixture child.
        hook = ('remove = tool["shutil"].rmtree\n'
                'def reclaim(path, *args, **kwargs):\n'
                '    remove(path, *args, **kwargs)\n'
                '    source = tool["Path"](tool["os"].environ["TIDY_FREE_BYTES"])\n'
                f'    source.write_text(str(int(source.read_text()) + {gb * 2**30}))\n'
                'tool["shutil"].rmtree = reclaim\n')
        return self.target_fault(hook + code, *args, status=status)

    def exists(self, name, repo='agents', remote=False):
        path = self.origins[repo] if remote else self.primary[repo]
        return self.git(path, 'show-ref', '--verify', f'refs/heads/{name}', check=False).returncode == 0


def copies(lab):
    old = lab.branch('copy')
    lab.put(lab.a / 'other', 'advance\n')
    lab.commit(lab.a, 'advance')
    lab.git(lab.a, 'cherry-pick', old)
    lab.git(lab.a, 'push', 'origin', 'main')
    text = lab.run('agents')
    assert f'deleted github-branch agents:copy {old}' in text, text
    assert f'deleted branch agents:copy {old}' in text, text
    assert not lab.exists('copy') and not lab.exists('copy', remote=True)
    trace = (lab.workspace / 'git.trace').read_text().splitlines()
    assert sum(' log --format=' in line and line.endswith('origin/main') for line in trace) == 1


def lock_copy(lab, copy_sources=('first\n', 'final\n'), twin_sources=('resolved\n', 'final\n'),
              upstream='upstream\n', twin_locks=None):
    locks = ('Cargo.lock', 'nested/Cargo.lock')
    for name in locks:
        lab.put(lab.a / name, 'base lock\n')
    lab.commit(lab.a, 'lock baseline')
    lab.git(lab.a, 'checkout', '-b', 'copy')
    commits = []
    for number, source in enumerate(copy_sources):
        lab.put(lab.a / 'file', source)
        for name in locks:
            lab.put(lab.a / name, f'copy lock {number}\n')
        commits.append(lab.commit(lab.a, f'feature {number}'))
    lab.git(lab.a, 'push', 'origin', 'copy')
    lab.git(lab.a, 'checkout', 'main')
    lab.put(lab.a / 'advance')
    if upstream is not None:
        lab.put(lab.a / 'file', upstream)
    lab.commit(lab.a, 'advance')
    twins = []
    for number, (source, original) in enumerate(zip(twin_sources, commits)):
        lab.put(lab.a / 'file', source)
        for name in locks:
            lab.put(lab.a / name, twin_locks or f'main lock {number}\n')
        lab.git(lab.a, 'add', '.')
        lab.git(lab.a, 'commit', '--allow-empty', '-C', original)
        twins.append(lab.git(lab.a, 'rev-parse', 'HEAD'))
    lab.git(lab.a, 'push', 'origin', 'main')
    return commits, twins


def lockfile_conflicts(lab):
    commits, _ = lock_copy(lab)
    merged = lab.git(lab.a, 'merge-tree', '--write-tree', '--name-only', '-z', '--no-messages',
                     'main', 'copy', check=False)
    assert merged.returncode == 1
    assert set(filter(None, merged.stdout.split('\0')[1:])) == {'Cargo.lock', 'nested/Cargo.lock'}, merged.stdout
    text = lab.run('agents')
    assert f'deleted branch agents:copy {commits[-1]}' in text, text
    assert not lab.exists('copy') and not lab.exists('copy', remote=True)


