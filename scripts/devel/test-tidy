    assert lab.git(lab.a, 'diff-tree', '--no-commit-id', '--name-only', '-r', 'main',
                   merged.stdout.strip()).splitlines() == ['Cargo.lock', 'nested/Cargo.lock']
    text = lab.run('agents')
    assert 'deleted branch agents:copy' in text, text
    assert not lab.exists('copy') and not lab.exists('copy', remote=True)


def lockfile_patches(lab):
    commits, twins = lock_copy(lab, copy_sources=('feature\n', 'feature\n'),
                              twin_sources=('feature\n', 'feature\n'), upstream=None)
    for commit in (commits[-1], twins[-1]):
        assert lab.git(lab.a, 'show', '--pretty=format:', commit, '--', '.',
                       ':(exclude,glob)**/Cargo.lock') == ''
    lab.put(lab.a / 'file', 'later main work\n')
    lab.commit(lab.a, 'later work')
    lab.git(lab.a, 'push', 'origin', 'main')
    merged = lab.git(lab.a, 'merge-tree', '--write-tree', '--name-only', '-z', '--no-messages',
                     'main', 'copy', check=False)
    assert merged.returncode == 1 and 'file' in merged.stdout.split('\0')[1:]
    text = lab.run('agents')
    assert 'deleted branch agents:copy' in text, text
    assert not lab.exists('copy') and not lab.exists('copy', remote=True)


