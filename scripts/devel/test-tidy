def scripts(lab):
    mission = lab.readme('paused', 'paused')
    py = lab.put(mission / 'scratch.py')
    shebang = lab.put(mission / 'runner', '#!/bin/fake\n')
    plain = lab.put(mission / 'notes')
    clone = mission / 'copy'
    lab.git(lab.root, 'clone', str(lab.origins['agents']), str(clone))
    cloned_script = lab.put(clone / 'keep.py')
    lab.branch('work')
    work = lab.wt('work', mission / 'work')
    work_script = lab.put(work / 'keep.py')
    bare = mission / 'bare.git'
    lab.git(lab.root, 'clone', '--bare', str(lab.origins['agents']), str(bare))
    bare_script = lab.put(bare / 'hooks' / 'keep.py')
    tool_script = lab.put(lab.tmp / 'codex-run' / 'run' / 'keep.py')
