def lockfile_patches(lab):
    commits, twins = lock_copy(lab, copy_sources=('feature\n', 'feature\n'),
                              twin_sources=('feature\n', 'feature\n'), upstream=None)
    for commit in (commits[-1], twins[-1]):
        assert lab.git(lab.a, 'show', '--pretty=format:', commit, '--', '.',
                       ':(exclude,glob)**/Cargo.lock') == ''
    lab.put(lab.a / 'file', 'later main work\n')
