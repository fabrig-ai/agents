    held = checkout(lab, '3'*7)
    process = subprocess.Popen([sys.executable, '-S', '-c', 'import sys; sys.stdin.buffer.read()'],
                               stdin=subprocess.PIPE, cwd=held, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        text = lab.run('--checkouts')
        assert all(p.exists() for p in (recent, ok_recent, held)), text
        assert f'kept checkout {held}: held by process {process.pid}' in text, text
        assert '0 deleted, 0 pinned, 2 recent,' in text, text
    finally:
        process.stdin.close()
        process.wait(timeout=HUNG_TIDY_S)


def checkouts_not_in_target(lab):
    paths = [checkout(lab, digit*7) for digit in '12345']
    pin(lab, lab.a / 'target', '1'*40)
    cargo = lab.tmp / 'owners/m/cargo'
    (cargo / 'registry').mkdir(parents=True)
    (cargo / 'git').mkdir()
    pin(lab, cargo, '2'*40)
    pin(lab, lab.a / '.git', '3'*40)
    outside = lab.root / 'outside'
    pin(lab, outside, '4'*40)
    (lab.a / 'linked').symlink_to(outside, target_is_directory=True)
    lab.put(outside / 'lock', 'source = "git+https://example.invalid/#' + '5'*40 + '"\n')
    (lab.a / 'Cargo.lock').symlink_to(outside / 'lock')
    text = lab.run('--checkouts')
    assert all(not p.exists() for p in paths), text
    assert '5 deleted, 0 pinned, 0 recent,' in text, text


