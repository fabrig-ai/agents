def evidence(lab):
    ended = lab.readme('ended', 'ended')
    clone = ended / 'copy'
    lab.git(lab.root, 'clone', str(lab.origins['agents']), str(clone))
    lab.git(clone, 'checkout', '-b', 'private')
    lab.put(clone / 'private')
    lab.commit(clone, 'private evidence')
    lab.git(clone, 'checkout', 'main')
    text = lab.run('--mission', 'ended', status=1)
    assert 'commit on no origin branch' in text and clone.exists(), text
    lab.git(clone, 'push', 'origin', 'private')
    external = lab.root / 'outside-work'
    lab.git(clone, 'worktree', 'add', str(external), 'private')
    text = lab.run('--mission', 'ended', status=1)
    assert 'worktree outside directory' in text and external.exists(), text
    lab.git(clone, 'worktree', 'remove', str(external))
    text = lab.run('--mission', 'ended')
    assert not clone.exists() and not ended.exists(), text


