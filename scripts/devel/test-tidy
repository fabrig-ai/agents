    (mission / 'linked').symlink_to(outside, target_is_directory=True)
    text = lab.run()
    assert not py.exists() and not shebang.exists(), text
    assert all(p.exists() for p in (plain, cloned_script, work_script, tool_script,
                                    bare_script, external, outside_script))


