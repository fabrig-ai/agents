def amended(lab):
    old = lab.branch('amended')
    lab.git(lab.a, 'merge', '--ff-only', 'amended')
    lab.git(lab.a, 'push', 'origin', 'main')
    lab.git(lab.a, 'checkout', 'amended')
    lab.put(lab.a / 'amended', 'different content\n')
    new = lab.commit(lab.a, 'temporary')
    lab.git(lab.a, 'reset', '--soft', old)
    lab.git(lab.a, 'commit', '--amend', '--no-edit')
    assert lab.git(lab.a, 'rev-parse', 'HEAD') != new
    lab.git(lab.a, 'push', '--force', 'origin', 'amended')
    lab.git(lab.a, 'checkout', 'main')
    work = lab.wt('amended')
    text = lab.run('agents', status=1)
    assert text.count('content differs') == 2, text
    assert lab.exists('amended') and lab.exists('amended', remote=True)
    assert work.exists() and f'kept worktree {work}' in text


def conflict_copy(lab):
    lab.git(lab.a, 'checkout', '-b', 'conflict')
    lab.put(lab.a / 'file', 'branch resolution\n')
    old = lab.commit(lab.a, 'conflicting change')
    lab.git(lab.a, 'push', 'origin', 'conflict')
    lab.git(lab.a, 'checkout', 'main')
    lab.put(lab.a / 'file', 'main change\n')
    lab.commit(lab.a, 'advance')
    result = lab.git(lab.a, 'cherry-pick', old, check=False)
    assert result.returncode == 1
    lab.put(lab.a / 'file', 'branch resolution\n')
    lab.git(lab.a, 'add', 'file')
    lab.git(lab.a, 'cherry-pick', '--continue')
    landed = lab.git(lab.a, 'rev-parse', 'HEAD')
    def patch(oid):
        diff = subprocess.check_output([GIT, '-C', str(lab.a), 'show', oid], env=lab.env)
        return subprocess.check_output([GIT, 'patch-id', '--stable'], input=diff, env=lab.env).split()[0]
    assert patch(old) != patch(landed)
    lab.git(lab.a, 'push', 'origin', 'main')
    text = lab.run('agents')
    assert 'deleted branch agents:conflict' in text, text
    assert not lab.exists('conflict') and not lab.exists('conflict', remote=True)


