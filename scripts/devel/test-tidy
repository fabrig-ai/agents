    assert before == [(p.relative_to(db), p.stat().st_mtime_ns, p.read_bytes() if p.is_file() else None)
                      for p in sorted(db.rglob('*'))]


def checkouts_failure_continues(lab):
    first, second = (checkout(lab, digit*7) for digit in '12')
    driver = ('import runpy, sys\n'
              f'tool = runpy.run_path({str(SCRIPT)!r})\n'
              f'sys.argv = {[str(SCRIPT), "--checkouts"]!r}\n'
              'remove = tool["shutil"].rmtree\n'
              'def fail(path, *args, **kwargs):\n'
              f'    if str(path) == {str(first)!r}: raise OSError("fixture checkout failure")\n'
              '    return remove(path, *args, **kwargs)\n'
              'tool["shutil"].rmtree = fail\n'
              'raise SystemExit(tool["main"]())\n')
    result = subprocess.run([sys.executable, '-I', '-S', '-c', driver], env=lab.env,
                            capture_output=True, text=True, timeout=HUNG_TIDY_S)
    assert result.returncode == 3, result
    assert f'kept checkout {first}: fixture checkout failure' in result.stdout, result
    assert first.exists() and not second.exists()
    assert '1 deleted, 0 pinned, 0 recent,' in result.stdout, result


def checkouts_bad_lock(lab):
    path = checkout(lab, '1'*7)
    lock = lab.put(lab.a / 'Cargo.lock', '')
    lock.write_bytes(b'\xff')
    text = lab.run('--checkouts', status=3)
    assert 'cannot read' in text and str(lock) in text, text
    assert path.exists() and 'deleted checkout' not in text


