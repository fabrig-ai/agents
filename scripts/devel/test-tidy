    script = lab.put(mission / 'held.py')
    # Inherited descriptor proves open files count even with cwd elsewhere.
    with script.open() as source:
        process = subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(30)'], cwd=lab.root,
                                   pass_fds=(source.fileno(),), stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
        try:
            text = lab.run()
            assert script.exists() and f'kept script {script}: held by process' in text, text
        finally:
            process.terminate()
            process.wait(timeout=5)


