def lock(lab):
    lock = lab.tmp / 'logs' / 'tidy.lock'
    lock.parent.mkdir()
    lab.landed()
    with lock.open('a') as source:
        fcntl.flock(source, fcntl.LOCK_EX)
        process = subprocess.Popen([sys.executable, '-I', str(SCRIPT), 'agents'], cwd=lab.root,
                                   env=lab.env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        try:
            inode = str(os.fstat(source.fileno()).st_ino)
            deadline = time.monotonic() + HUNG_TIDY_S
            while True:
                blocked = [line.split() for line in Path('/proc/locks').read_text().splitlines() if '->' in line]
                if any(row[5] == str(process.pid) and row[6].rsplit(':', 1)[-1] == inode for row in blocked):
                    break
                assert process.poll() is None and time.monotonic() < deadline, 'child did not block on tidy.lock'
                time.sleep(.01)
            assert process.poll() is None and lab.exists('done')
            # A preview never waits for the held machine lock.
            assert 'would delete' in lab.run('--dry-run', 'agents')
            fcntl.flock(source, fcntl.LOCK_UN)
            stdout, stderr = process.communicate(timeout=HUNG_TIDY_S)
            assert process.returncode == 0 and 'deleted branch agents:done' in stdout, (stdout, stderr)
        finally:
            if process.poll() is None:
                process.kill()
                process.wait()


def kept_proofs(lab):
    """Only proof-named, due pin-only trees are collected, under the set flock."""
    rows = (
        ('old', 25, False, 'valid', True),
        ('landed', 1, True, 'valid', True),
        ('young', 1, False, 'valid', False),
        ('locked', 25, False, 'locked', False),
        ('held', 25, False, 'held', False),
        ('unnamed', 25, False, 'unnamed', False),
        ('malformed', 25, False, 'malformed', False),
        ('old-format', 25, False, 'no-worktree', False),
        ('outside', 25, False, 'outside', False),
        ('wrong-branch', 25, False, 'branch', False),
        ('unregistered', 25, False, 'unregistered', False),
        ('missing-lock', 25, False, 'missing-lock', False),
        ('invalid-time', 25, False, 'time', False),
        ('symlink', 25, False, 'symlink', False),
        ('wrong-schema', 25, False, 'schema', False),
        ('branch-entry', 25, False, 'non-pin', False),
        ('failed-replacement', 25, False, 'replacement-token', False),
        ('moved-head', 25, False, 'replacement-head', False),
    )
    made = []
    with ExitStack() as stack:
        for index, (label, age, landed, mode, remove) in enumerate(rows):
            label = 'fixture/' + label
            branch = f'land-set/{index:032x}/agents' if mode != 'branch' else 'ordinary'
            path = lab.tmp / 'land-set' / 'worktrees' / quote(label, safe='') / 'agents'
            if mode == 'outside':
                path = lab.root / 'outside'
            lab.git(lab.a, 'worktree', 'add', '-b', branch, str(path), lab.base)
            lab.put(path / 'file', label + '\n')
            commit = lab.commit(path, label)
            target = lab.put(path / 'target' / 'evidence')
            if landed:
                lab.git(lab.a, 'merge', '--ff-only', branch)
                lab.git(lab.a, 'push', 'origin', 'main')
            entry = dict(base=lab.base, commit=commit, tree=lab.git(path, 'rev-parse', 'HEAD^{tree}'),
                         pin_only=mode != 'non-pin', worktree=str(path))
            if mode == 'replacement-token':
                lab.git(path, 'branch', '-m', f'land-set/{index + len(rows):032x}/agents')
                branch = lab.git(path, 'branch', '--show-current')
            if mode == 'replacement-head':
                entry['commit'] = lab.base
            if mode == 'no-worktree':
                entry.pop('worktree')
            if mode == 'symlink':
                link = path.parent / 'link'
                link.symlink_to(path, target_is_directory=True)
                entry['worktree'] = str(link)
            if mode == 'unregistered':
                entry['worktree'] = str(path.parent / 'not-a-worktree')
                lab.put(Path(entry['worktree']) / 'evidence')
            proof = dict(schema='other' if mode == 'schema' else 'land-set-proof-v1', set=label,
                         machine='fixture', token=f'{index:032x}',
                         time=(datetime.now(timezone.utc) - timedelta(hours=age)).isoformat(),
                         repos=dict(agents=entry))
            if mode == 'time':
                proof['time'] = 'invalid'
            source = '{broken' if mode == 'malformed' else json.dumps(proof)
            proof_file = lab.tmp / 'land-set' / 'proofs' / (quote(label, safe='') + '.json')
            if mode != 'unnamed':
                lab.put(proof_file, source)
            lock_path = lab.tmp / 'land-set' / 'state' / (quote(label, safe='') + '.lock')
            inode = None
            if mode != 'missing-lock':
                lab.put(lock_path, '')
                inode = lock_path.stat().st_ino
            if mode == 'locked':
                lock = stack.enter_context(lock_path.open('r'))
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            if mode == 'held':
                process = subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(30)'], cwd=path,
                                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                stack.callback(process.wait, timeout=5)
                stack.callback(process.terminate)
            made.append((path, branch, target, proof_file, source, lock_path, inode, mode, remove))
        # Target-only modes keep their original scope, even for expired proofs.
        lab.run('--targets')
        lab.room_free(40)
        lab.run('--targets', '--room', '30')
        preview = lab.run('--dry-run', 'agents')
        assert preview.count('would delete worktree') == 2, preview
        assert all(path.exists() and target.exists() for path, _, target, *_ in made)
        text = lab.run('agents')
        for path, branch, target, proof_file, source, lock_path, inode, mode, remove in made:
            assert path.exists() != remove and target.exists() != remove, (mode, text)
            assert bool(lab.git(lab.a, 'branch', '--list', branch)) != remove, (mode, text)
            if mode != 'unnamed':
                assert proof_file.read_text() == source, mode
            assert (lock_path.stat().st_ino if lock_path.exists() else None) == inode, mode
            if mode in ('locked', 'held', 'missing-lock'):
                assert f'kept worktree {path}:' in text, (mode, text)
            if remove:
                assert f'deleted worktree {path} ' in text, text


