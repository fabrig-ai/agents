def cargo_home_scripts(lab):
    mission = lab.readme('paused', 'paused')
    retained = []
    for number, marker in enumerate(('.package-cache', '.global-cache')):
        home = mission / f'cargo-{number}'
        lab.put(home / marker, '')
        retained.append(lab.put(home / 'registry' / 'src' / 'keep.py'))
        retained.append(lab.put(home / 'git' / 'checkouts' / 'keep', '#!/bin/fake\n'))
        lab.put(home / 'probe.py')
    # Names alone do not turn ordinary agent notes into a Cargo cache.
    ordinary = mission / 'ordinary'
    remove = lab.put(ordinary / 'registry' / 'probe.py')
