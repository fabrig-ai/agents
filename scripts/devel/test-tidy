def old_directories(lab):
    old = lab.tmp / 'director' / 'tasks' / 'old'
    young = old.with_name('young')
    nested = old.with_name('nested')
    run = lab.tmp / 'codex-run' / 'old-run'
    for path in (old, young, nested, run):
        lab.put(path / 'sub' / 'note', 'evidence\n')
    stamp = time.time() - 8 * 86400
    for parent in (old, nested, run):
        for base, dirs, files in os.walk(parent, topdown=False):
