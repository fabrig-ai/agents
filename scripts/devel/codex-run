#!/usr/bin/env bash
# Start Codex in a detached user unit and post its report when it ends.
#   codex-run task [--model M] [--effort E] [--read-only] [--to ADDR] [--resume RUN] TASK DIR REPORT
#   codex-run owner [--model M] [--effort E] NAME BRIEF
#   codex-run stale [--post]
# See docs/design/post.md, section 5.
set -euo pipefail
umask 077

script=$(readlink -f "${BASH_SOURCE[0]}")
kit=$(dirname "$script")
workspace() {
    local agents
    agents=$(cd "$kit/../.." && pwd)
    if [[ $(basename "$agents") == agents ]]; then dirname "$agents"; else echo "$HOME/src/rust"; fi
}
root=$(realpath -m "${DEV_ROOT:-$(workspace)}")
runs=$root/tmp/codex-run
search_rule='Before any command, read the rules in the text below. Search only your worktree and the paths it names: never run rg, find, ls -R or grep -r from ~/src/rust/tmp or any directory above it, and never in ~/.local, ~/.config or /run/user. '
ON_STOP_SECONDS=60
capacity='Selected model is at capacity. Please try a different model.'

refuse() {
    local reason=${1//$'\n'/ }
    printf 'codex-run: %s\n' "$reason" >&2
    exit 2
}
field() { [[ $1 != *$'\t'* && $1 != *$'\n'* ]] || refuse "$2 contains a tab or newline"; }
absolute() { field "$1" "$2"; [[ $1 == /* ]] || refuse "$2 must be absolute"; }
valid_to() { [[ $1 =~ ^[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*(@[a-z][a-z0-9-]*)?$ ]]; }
reservation() { printf 'codex-run: run %s is writing this report.\n' "$id"; }
thread_from_events() {
    jq -Rrs '[split("\n")[] | fromjson? | select(.type == "thread.started") |
        .thread_id | select(type == "string" and length > 0)][0] // empty' "$1"
}
settings() {
    field "$model" model
    [[ -n $model ]] || refuse 'model must not be empty'
    case $effort in medium|high|xhigh) ;; *) refuse 'effort must be medium, high or xhigh' ;; esac
}
meta_get() {
    local key value
    while IFS='=' read -r key value; do
        [[ $key != "$2" ]] || { printf '%s\n' "$value"; return; }
    done <"$1"
}

# Each event gains "ts", when it arrived, UTC to the millisecond, as its first
# key, so that a run's steps can be timed; other lines pass unchanged.
stamp() {
    perl -MPOSIX=strftime -MTime::HiRes=time -ne 'BEGIN { $| = 1 }
        my $t = time;
        my $ts = strftime("%Y-%m-%dT%H:%M:%S", gmtime $t) . sprintf(".%03dZ", ($t - int $t) * 1000);
        s/^\{(\s*\})?/defined $1 ? "{\"ts\":\"$ts\"$1" : "{\"ts\":\"$ts\","/e;
        print'
}

# Each invocation repeats the settings, including when continuing a thread.
turn() {
    local event_offset stderr_offset thread delay child='' events stamper
    printf '%s\n' "$1" >"$state/prompt"
    local -a command delays
    read -r -a delays <<<"${CODEX_RUN_RETRY_DELAYS:-120 300 900}"
    tries=0 run_exit=0
    touch "$state/events.jsonl" "$state/stderr.log"
    while :; do
        tries=$((tries + 1))
        event_offset=$(wc -c <"$state/events.jsonl")
        stderr_offset=$(wc -c <"$state/stderr.log")
        command=(codex exec)
        # --sandbox belongs to exec, rather than its resume subcommand.
        if [[ $read_only == 1 ]]; then command+=(--sandbox read-only); fi
        thread=''
        [[ ! -s $state/thread ]] || thread=$(<"$state/thread")
        [[ -z $thread ]] || command+=(resume)
        command+=(-m "$model" -c "model_reasoning_effort=$effort")
        if [[ $read_only == 0 ]]; then command+=(--dangerously-bypass-approvals-and-sandbox); fi
        command+=(--skip-git-repo-check --json -o "$state/last.md")
        [[ -z $thread ]] || command+=("$thread")
        command+=(-)
        run_exit=0
        exec {events}> >(stamp >>"$state/events.jsonl")
        stamper=$!
        (cd "$dir" && exec "${command[@]}" <"$state/prompt") 1>&"$events" 2>>"$state/stderr.log" &
        child=$!
        wait "$child" || run_exit=$?
        child=''
        exec {events}>&-
        wait "$stamper" || true
        tail -c "+$((event_offset + 1))" "$state/events.jsonl" >"$state/attempt.jsonl"
        tail -c "+$((stderr_offset + 1))" "$state/stderr.log" >"$state/attempt.stderr"
        if [[ ! -s $state/thread ]]; then
            thread_from_events "$state/attempt.jsonl" >"$state/thread"
        fi
        ((run_exit != 0 && tries <= 3 && tries <= ${#delays[@]})) || break
        [[ -s $state/thread ]] || break
        if ! jq -Rse --arg message "$capacity" 'any(split("\n")[] | fromjson?;
            (.type == "error" and .message == $message) or
            (.type == "turn.failed" and .error.message == $message))' "$state/attempt.jsonl" >/dev/null &&
            ! grep -Fq -- "$capacity" "$state/attempt.stderr"; then break; fi
        delay=${delays[tries-1]}
        sleep "$delay"
        printf '%s\n' 'Go on with the task: the model was at capacity.' >"$state/prompt"
    done
    rm -f "$state/attempt.jsonl" "$state/attempt.stderr"
}

terminate() {
    trap - TERM INT
    # A signal can reenter Bash's child wait. Drop our writer first: the
    # stamper may be the only child left, and it cannot exit without EOF.
    if [[ -n ${events:-} ]]; then exec {events}>&-; fi
    if [[ -n ${child:-} ]]; then
        kill -TERM "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    exit "$1"
}
finish_error() { printf '%s\n' "$*" >>"$state/finish-errors"; }
post_subject() {
    local status=$1 first='' summary_exit=0
    first=$(head -n1 "$report" | tr -d '[:cntrl:]' | cut -c1-80) || summary_exit=$?
    if [[ $status == 0 ]]; then printf 'run %s ok: %s\n' "$id" "$first"
    else printf 'run %s failed %s: %s\n' "$id" "$status" "$first"; fi
    return "$summary_exit"
}
post_body() {
    printf 'Report: %s\nRun: %s\nThread: %s\nMinutes: %s\nTries: %s\n' \
        "$report" "$state" "${thread:--}" "$minutes" "$tries"
}
stale_body() {
    local started start_seconds
    started=$(meta_get "$state/meta" started) || return
    [[ -n $started ]] || return 1
    start_seconds=$(date -d "$started" +%s) || return
    minutes=$(( (now - start_seconds) / 60 ))
    thread=''
    if [[ -s $state/thread ]]; then thread=$(<"$state/thread") || return; fi
    # turn() keeps its attempt count in memory; a dead worker leaves none.
    tries='-'
    post_body >"$state/post-body"
}

finish_task() {
    local status=$1 ended tokens='-' thread='' subject post_exit=0 minutes=0
    trap - EXIT
    trap '' TERM INT
    # Each step must run even if another step or its diagnostics cannot be saved.
    set +e
    ended=$(date -u +%FT%TZ)
    if [[ ! -e $report ]] || cmp -s <(reservation) "$report"; then
        {
            if [[ -s $state/last.md ]]; then
                if [[ $read_only == 1 ]]; then
                    cat "$state/last.md"
                else
                    printf '%s\n' 'codex-run: the run wrote no report; its last message follows.' && cat "$state/last.md"
                fi
            else
                printf 'codex-run: the run wrote no report and no last message; exit %s; see %s.\n' "$status" "$state"
            fi
        } >"$state/report.md" || finish_error 'report fallback failed'
        cp -- "$state/report.md" "$report" || finish_error 'report publication failed'
    fi
    [[ ! -s $state/thread ]] || thread=$(<"$state/thread")
    tokens=$(jq -Rrs '[split("\n")[] | fromjson? | select(.type == "turn.completed" and (.usage | type) == "object") | .usage] |
        if length == 0 then "-" else
        [([.[].input_tokens // 0] | add), ([.[].cached_input_tokens // 0] | add),
         ([.[].output_tokens // 0] | add)] | map(tostring) | join("/") end' "$state/events.jsonl") || {
        tokens='-'; finish_error 'tokens failed'
    }
    subject=$(post_subject "$status") || finish_error 'report summary failed'
    minutes=$(( ($(date -d "$ended" +%s) - $(date -d "$started" +%s)) / 60 ))
    post_body >"$state/post-body" || finish_error 'post body failed'
    "$kit/post" send --as codex-run "$to" "$subject" "$state/post-body" >"$state/post-output" 2>&1 || post_exit=$?
    if ((post_exit != 0)); then
        finish_error "post failed: $post_exit"
        if ((post_exit != 3)); then
            cp "$state/post-output" "$state/post-failed" || printf 'post failed: %s\n' "$post_exit" >"$state/post-failed"
        fi
        cat "$state/post-output"
    fi
    (
        flock 9 || exit
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$id" "$to" "$started" "$ended" "$status" "$tries" "$model" "$effort" "$task" "$report" \
            "${thread:--}" "$tokens" "$post_exit" >&9
    ) 9>>"$runs/runs.tsv" || finish_error 'row failed'
    : >"$state/ended" || finish_error 'ended marker failed'
    exit "$status"
}

launch() {
    local unit=$1 output status=0
    shift
    local -a envs=("--setenv=DEV_ROOT=$root") properties=()
    if [[ ${mode:-} == task && -n ${on_stop:-} ]]; then
        # No shell and no $: a daemon-reload doubles a transient ExecStop's $$ (systemd 257, 10-26).
        properties+=("--property=ExecStop=-\"$script\" \"_stop\" \"$id\"")
    fi
    if [[ -v CODEX_RUN_RETRY_DELAYS ]]; then envs+=("--setenv=CODEX_RUN_RETRY_DELAYS=$CODEX_RUN_RETRY_DELAYS"); fi
    # The login shell expands these positional arguments, never the caller.
    # shellcheck disable=SC2016
    output=$(systemd-run --user --collect --quiet --service-type=exec --unit "$unit" "${envs[@]}" "${properties[@]}" \
        bash -lc 'exec "$0" "$@"' "$script" "$@" 2>&1) || status=$?
    if ((status != 0)); then
        if [[ ${mode:-} == task ]]; then
            cmp -s <(reservation) "$report" && rm -f -- "$report"
            rm -rf "$state"
        fi
        refuse "systemd-run failed: $output"
    fi
}

task_launch() {
    local model='' effort='' read_only='' to=${POST_NAME:-} resume='' previous='' task report dir='' on_stop=''
    local id state started caller=${POST_NAME:-} key resume_thread=''
    while (($#)); do
        case $1 in
            --model|--effort|--to|--resume)
                (($# >= 2)) || refuse "missing value for $1"
                key=${1#--}; printf -v "$key" '%s' "$2"; shift 2 ;;
            --on-stop)
                (($# >= 2)) || refuse "missing value for $1"
                absolute "$2" --on-stop
                on_stop=$2; shift 2 ;;
            --read-only) read_only=1; shift ;;
            --) shift; break ;;
            -*) refuse "unknown option $1" ;;
            *) break ;;
        esac
    done
    if [[ -n $resume ]]; then
        [[ $resume != */* && $resume != . && $resume != .. ]] || refuse 'resume must name a run id'
        previous=$runs/$resume
        if [[ -s $previous/thread ]]; then resume_thread=$(<"$previous/thread")
        elif [[ -f $previous/events.jsonl ]]; then resume_thread=$(thread_from_events "$previous/events.jsonl")
        fi
        [[ -n $resume_thread ]] || refuse 'resume run has no thread'
        [[ -f $previous/meta ]] || refuse 'resume run has no meta'
        model=${model:-$(meta_get "$previous/meta" model)}
        effort=${effort:-$(meta_get "$previous/meta" effort)}
        read_only=${read_only:-$(meta_get "$previous/meta" read_only)}
        dir=$(meta_get "$previous/meta" dir)
    fi
    if (($# == 3)); then task=$1 dir=$2 report=$3
    elif (($# == 2)) && [[ -n $resume ]]; then task=$1 report=$2
    else refuse 'usage: codex-run task [options] TASK DIR REPORT'; fi
    model=${model:-gpt-6.1-sol} effort=${effort:-high} read_only=${read_only:-0}
    settings
    absolute "$task" TASK; absolute "$dir" DIR; absolute "$report" REPORT
    [[ -f $task && -r $task ]] || refuse 'TASK is not readable'
    [[ -d $dir ]] || refuse 'DIR is not a directory'
    [[ ! -e $report && ! -L $report ]] || refuse 'REPORT already exists'
    [[ -d $(dirname "$report") ]] || refuse 'REPORT directory does not exist'
    [[ -n $to ]] || refuse 'no recipient: use --to or POST_NAME'
    valid_to "$to" || refuse 'invalid recipient address'
    field "$caller" caller
    if [[ -n $on_stop && $script == *[\$%\"\\$' \t\n']* ]]; then
        refuse "the kit's path is unsafe in a stop command"
    fi
    mkdir -p "$runs"
    while :; do
        id=$(date -u +%Y%m%dT%H%M%SZ)-$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n')
        state=$runs/$id
        if mkdir "$state" 2>/dev/null; then break; fi
        [[ -e $state ]] || refuse "cannot create run directory $state"
    done
    if ! (set -o noclobber; reservation >"$report") 2>/dev/null; then
        rmdir "$state"
        refuse 'REPORT already exists or cannot be reserved'
    fi
    started=$(date -u +%FT%TZ)
    printf 'caller=%s\nto=%s\nmodel=%s\neffort=%s\nread_only=%s\ntask=%s\ndir=%s\nreport=%s\nresume_of=%s\nstarted=%s\non_stop=%s\n' \
        "$caller" "$to" "$model" "$effort" "$read_only" "$task" "$dir" "$report" "$resume" "$started" "$on_stop" >"$state/meta"
    [[ -z $previous ]] || printf '%s\n' "$resume_thread" >"$state/thread"
    launch "codex-run-$id" _run "$id"
    printf '%s %s\n' "$id" "$state"
}

task_run() {
    (($# == 1)) || refuse 'usage: codex-run _run ID'
    if [[ ${CODEX_RUN_SUBREAPER:-} != "$$" ]]; then
        # exec preserves the adopting parent: an orphan must never signal systemd --user.
        exec python3 -I -c 'import ctypes, os, sys; libc = ctypes.CDLL(None, use_errno=True); libc.prctl(36, 1, 0, 0, 0) == 0 or sys.exit("codex-run: cannot become child subreaper: " + os.strerror(ctypes.get_errno())); os.environ["CODEX_RUN_SUBREAPER"] = str(os.getpid()); os.execv(sys.argv[1], sys.argv[1:])' "$script" _run "$@"
    fi
    local id=$1 state=$runs/$1 key value
    local model='' effort='' read_only='' task='' dir='' report='' to='' started='' tries=0 run_exit=0
    while IFS='=' read -r key value; do
        case $key in model|effort|read_only|task|dir|report|to|started) printf -v "$key" '%s' "$value" ;; esac
    done <"$state/meta"
    touch "$state/events.jsonl" "$state/stderr.log"
    trap 'finish_task "$?"' EXIT
    trap 'terminate 143' TERM
    trap 'terminate 130' INT
    local report_instruction="Write your report to $report."
    if [[ $read_only == 1 ]]; then
        report_instruction="Return your entire report as your final message, even if the task asks you to write a report file. Do not write the report file; codex-run will write it to $report."
    fi
    turn "${search_rule}Read $task and do what it says. $report_instruction"
    wait || true
    exit "$run_exit"
}

task_stop() {
    # Stop failures must never affect the unit, even if meta or logs are gone.
    set +e
    (($# == 1)) || return 0
    local state=$runs/$1 f status=0
    f=$(meta_get "$state/meta" on_stop)
    if [[ -f $f && ! -L $f && -x $f ]]; then
        (cd -- "$(dirname -- "$f")" && timeout --signal=KILL "$ON_STOP_SECONDS" "$f") \
            </dev/null >>"$state/on-stop.log" 2>&1 || status=$?
        printf 'exit %s\n' "$status" >"$state/on-stop"
    else
        printf 'absent\n' >"$state/on-stop"
    fi
    return 0
}

owner_launch() {
    local model=gpt-6.1-sol effort=high key name brief unit state
    while (($#)); do
        case $1 in
            --model|--effort)
                (($# >= 2)) || refuse "missing value for $1"
                key=${1#--}; printf -v "$key" '%s' "$2"; shift 2 ;;
            --) shift; break ;;
            -*) refuse "unknown option $1" ;;
            *) break ;;
        esac
    done
    (($# == 2)) || refuse 'usage: codex-run owner [options] NAME BRIEF'
    name=$1 brief=$2
    [[ $name =~ ^[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$ ]] || refuse 'invalid owner name'
    absolute "$brief" BRIEF
    [[ -f $brief && -r $brief ]] || refuse 'BRIEF is not readable'
    settings
    unit=codex-owner-$(systemd-escape "$name")
    if systemctl --user is-active --quiet "$unit"; then refuse "$unit is active"; fi
    state=$root/tmp/owners/${name##*/}/codex
    owner_identity
    launch "$unit" _owner "$name" "$brief" "$model" "$effort"
    printf '%s\n' "$unit"
}

owner_identity() {
    mkdir -p "$state"
    {
        flock 9 || refuse 'cannot lock owner identity'
        if [[ -e $state/name ]]; then
            [[ $(<"$state/name") == "$name" ]] || refuse 'owner state belongs to another name'
        else
            printf '%s\n' "$name" >"$state/name"
        fi
    } 9>"$state/.name.lock"
}
owner_run() {
    (($# == 4)) || refuse 'usage: codex-run _owner NAME BRIEF MODEL EFFORT'
    local name=$1 brief=$2 dir=$root model=$3 effort=$4
    local state=$root/tmp/owners/${1##*/}/codex read_only=0 prompt status start end tries=0 run_exit=0 wait_timeout
    export POST_NAME=$name
    owner_identity
    status=0
    "$kit/post" wait "$name" --timeout 0 --holder "$$" --kind codex || status=$?
    case $status in 0|1) ;; 4) return 0 ;; *) return "$status" ;; esac
    prompt="You are $name: read $brief and do what it says. Your messages arrive as your turns' prompts; send yours with post send (agents' docs/design/post.md)."
    if [[ -s $state/pending.md ]]; then prompt+=$'\n'"$(cat "$state/pending.md")"; fi
    while :; do
        # Keep the whole prompt containing a mail batch until its turn succeeds.
        if [[ -s $state/pending.md ]]; then printf '%s\n' "$prompt" >"$state/pending.md"; fi
        start=$(date -u +%FT%TZ)
        turn "$prompt"
        end=$(date -u +%FT%TZ)
        printf '%s\t%s\t%s\t%s\n' "$start" "$end" "$run_exit" "$tries" >>"$state/turns.tsv"
        wait_timeout=3600
        if ((run_exit == 0)); then rm -f "$state/pending.md"; else wait_timeout=300; fi
        status=0
        "$kit/post" wait "$name" --timeout "$wait_timeout" --holder "$$" --kind codex || status=$?
        case $status in
            0|1)
                prompt=''
                [[ ! -s $state/pending.md ]] || prompt=$(cat "$state/pending.md")
                if ((status == 0)); then
                    prompt+="${prompt:+$'\n'}Post for $name:"$'\n'"$("$kit/post" read "$name")"
                    printf '%s\n' "$prompt" >"$state/pending.md"
                elif [[ -z $prompt ]]; then
                    prompt='An hour without post: check your running tasks, act on what has ended, and keep your notes current.'
                fi ;;
            4) break ;;
            *) return "$status" ;;
        esac
    done
}
stale() {
    (($# == 0)) || { (($# == 1)) && [[ $1 == --post ]]; } || refuse 'usage: codex-run stale [--post]'
    local state id why to now post=${1:-} status subject output result=0
    local report thread minutes tries modified
    now=$(date +%s)
    for state in "$runs/"*/; do
        [[ -f $state/meta && ! -f $state/told ]] || continue
        state=${state%/}
        id=${state##*/}
        if ! modified=$(stat -c %Y "$state/meta"); then
            printf '%s not told: meta age unavailable\n' "$id"
            result=1
            continue
        fi
        # post.md 5: allow startup time, and leave day-old runs to tidy.
        ((now - modified >= 120 && now - modified < 86400)) || continue
        why=''
        if [[ -f $state/post-failed ]]; then
            status=0
            grep -Fq 'queued, nobody will wake it' "$state/post-failed" || status=$?
            if ((status == 0)); then continue; fi
            if ((status != 1)); then
                printf '%s not told: post failure marker unreadable\n' "$id"
                result=1
                continue
            fi
            why='post failed'
        elif [[ ! -f $state/ended ]] && ! systemctl --user is-active --quiet "codex-run-$id"; then
            why='unit inactive without end'
        fi
        [[ -n $why ]] || continue
        if ! to=$(meta_get "$state/meta" to) || ! valid_to "$to"; then
            printf '%s not told: meta recipient unreadable or invalid\n' "$id"
            result=1
            continue
        fi
        if [[ -z $post ]]; then
            printf '%s\t%s\t%s\t%s\n' "$id" "$why" "$state" "$to"
            continue
        fi
        if ! report=$(meta_get "$state/meta" report) || [[ $report != /* ]]; then
            printf '%s not told: meta report unreadable or invalid\n' "$id"
            result=1
            continue
        fi
        status=''
        subject="run $id failed stale: $why"
        if [[ $why == 'post failed' && -f $runs/runs.tsv && -r $runs/runs.tsv ]]; then
            status=$(awk -F'\t' -v id="$id" '$1 == id { print $5; exit }' "$runs/runs.tsv" 2>/dev/null) || status=''
        fi
        if [[ $status =~ ^[0-9]+$ ]]; then subject=$(post_subject "$status") || true; fi
        output=''
        if [[ $why == 'unit inactive without end' ]] ||
            { [[ ! $status =~ ^[0-9]+$ && ! -e $state/post-body && ! -L $state/post-body ]]; }; then
            if ! stale_body; then output='post body failed'; fi
        fi
        if [[ -z $output && ( ! -f $state/post-body || ! -r $state/post-body ) ]]; then
            output='post body unreadable'
        fi
        if [[ -n $output ]]; then
            printf '%s not told: %s\n' "$id" "$output"
            result=1
            continue
        fi
        status=0
        output=$("$kit/post" send --as codex-run "$to" "$subject" "$state/post-body" 2>&1) || status=$?
        if ((status == 0 || status == 3)); then
            printf '%s\n' "$output" >"$state/told" || result=1
            printf '%s told: %s\n' "$id" "${output##*$'\n'}"
        else
            printf '%s not told: %s\n' "$id" "${output##*$'\n'}"
            result=1
        fi
    done
    return "$result"
}

mode=${1:-}
(($# == 0)) || shift
case $mode in
    task) task_launch "$@" ;;
    owner) owner_launch "$@" ;;
    stale) stale "$@" ;;
    _run) task_run "$@" ;;
    _stop) task_stop "$@" ;;
    _owner) owner_run "$@" ;;
    *) refuse 'usage: codex-run task|owner ... | stale [--post]' ;;
esac
