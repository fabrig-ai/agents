#!/usr/bin/env bash
# Run a repository's after-landing tier on a commit land has just pushed
# (owners.md, 4.5): the tests too slow for its gate, which would otherwise
# break unseen on main.
#
#   after-landing GIT_COMMON_DIR COMMIT BRANCH
#
# land starts it in the background after each code landing of a repository
# whose landed tree has scripts/after-landing.sh. It checks the commit out
# in a detached worktree kept for the repository (tmp/after-landing/REPO,
# with its own target, one run at a time), runs the script through
# `heavy --gate`, and when that fails or heavy refuses it, writes one line
# to the director's inbox, tmp/director/inbox/after-landing.md, naming the
# repository, the commit, its branch and subject, and the log.
set -euo pipefail
umask 077

kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# The workspace, as land finds it.
workspace() {
    local skein
    skein=$(cd "$kit/../.." && pwd)
    if [[ $(basename "$skein") == skein ]]; then dirname "$skein"; else echo "$HOME/src/rust"; fi
}
root=${DEV_ROOT:-$(workspace)}
tmp=${DEV_TMP:-$root/tmp}

(($# == 3)) || { echo "usage: after-landing GIT_COMMON_DIR COMMIT BRANCH" >&2; exit 2; }
common=$1 commit=$2 branch=$3
repo=$(basename "$(dirname "$common")")
dir=$tmp/after-landing
wt=$dir/$repo
mkdir -p "$dir" "$tmp/director/inbox"
log=$dir/$repo-$(git --git-dir="$common" rev-parse --short "$commit").log
subject=$(git --git-dir="$common" log -1 --format=%s "$commit")

report() {
    printf '%s after-landing: %s %s (%s, "%s") %s; log %s\n' \
        "$(date -u +%Y-%m-%dT%H:%MZ)" "$repo" "${commit:0:10}" "$branch" "$subject" "$1" "$log" \
        >>"$tmp/director/inbox/after-landing.md"
}

# x1's kept targets hold cache blocks past the cache's limit (owners.md,
# 4.5). Stay inside this lane's physical worktree; rm does not follow
# links within target, and must not cross a filesystem mounted below it.
cleanup_target() (
    [[ $(hostname -s) == x1 ]] || exit 0
    cd -P -- "$wt" || exit 1
    if [[ $PWD != "$wt" || -L target || ( -e target && ! -d target ) ]]; then
        echo "after-landing: refusing unsafe target cleanup: $wt/target" >&2
        exit 1
    fi
    rm -rf --one-file-system -- target || exit 1
    if command -v kache >/dev/null; then kache gc >/dev/null 2>&1 || true; fi
)

# One run at a time per repository: they share the worktree and its target.
exec 7>"$dir/$repo.lock"
flock 7
{
    if [[ -d $wt ]]; then
        git -C "$wt" checkout --quiet --detach "$commit"
    else
        git --git-dir="$common" worktree add --quiet --detach "$wt" "$commit"
    fi
} >"$log" 2>&1 || { report "could not be checked out"; exit 1; }

bytes=$(wc -c <"$log")
status=0
(cd "$wt" && HEAVY_LABEL="after-landing $repo" "$kit/heavy" --gate -- scripts/after-landing.sh) >>"$log" 2>&1 ||
    status=$?
if ((status != 0)); then
    out=$(tail -c "+$((bytes + 1))" "$log")
    if grep -qE '^heavy: (queued )?task [0-9]+ ' <<<"$out"; then
        report "failed (exit $status)"
    else
        reason=$(sed -n '/^heavy: /{p;q;}' <<<"$out")
        report "was refused by heavy, so nothing ran: $reason"
    fi
fi
# Descriptor 7 still holds the lane lock through cleanup, including when
# heavy failed or refused the attempt. Its status takes precedence.
cleanup_status=0
cleanup_target >>"$log" 2>&1 || cleanup_status=$?
if ((cleanup_status != 0)); then
    report "target cleanup failed (exit $cleanup_status)"
    ((status != 0)) || status=$cleanup_status
fi
exit "$status"
