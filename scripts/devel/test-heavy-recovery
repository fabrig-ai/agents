    daemon_marker = lab.path / 'private-daemon.json'
    daemon_code = ('import json,os,time\nfrom pathlib import Path\n'
        'if os.fork(): os._exit(0)\nos.setsid()\n'
        'if os.fork(): os._exit(0)\n'
        'marker=Path(' + repr(str(daemon_marker)) + ')\n'
        'temporary=marker.with_suffix(".new")\n'
        'temporary.write_text(json.dumps({"pid":os.getpid(),'
        '"cgroup":Path("/proc/self/cgroup").read_text()}))\ntemporary.replace(marker)\ntime.sleep(120)\n')
    code = ('import json,os,subprocess,time\nfrom pathlib import Path\n'
            'child=subprocess.Popen(["setsid","sleep","120"])\n'
            'launcher=subprocess.Popen([' + repr(sys.executable) + ',"-c",' + repr(daemon_code) + '])\n'
            'private_marker=Path(' + repr(str(daemon_marker)) + ')\n'
            'while not private_marker.exists(): time.sleep(.01)\n'
            'private=json.loads(private_marker.read_text())\n'
            'Path(' + repr(str(marker)) + ').write_text(json.dumps({"payload":os.getpid(),"child":child.pid,"private":private["pid"],'
            '"payload_cgroup":Path("/proc/self/cgroup").read_text(),'
            '"child_cgroup":Path(f"/proc/{child.pid}/cgroup").read_text(),'
            '"private_cgroup":private["cgroup"]}))\n'
            'time.sleep(' + ('0.15' if action == 'normal' else '120') + ')\n')
    gate = lab.start('gate', gate=True, code=code)
    evidence = wait_for(lambda: fixture_json(marker), 'setsid children JSON')
    assert evidence['payload_cgroup'] == evidence['child_cgroup'] == evidence['private_cgroup']
    shared_cgroup = Path(f'/proc/{shared}/cgroup').read_text()
    assert shared_cgroup != evidence['payload_cgroup']
    (lab.path / 'shared.json').write_text(json.dumps({'pid': shared, 'cgroup': shared_cgroup}))
    if action == 'boot':
        lab.boot.write_text('fixture-next-boot\n')
    elif action == 'kill':
        # With the submitter gone too, only the independently installed timer
        # can recover the orphan and release its holds.
        gate.kill()
        gate.wait(timeout=HUNG_TOOL_S)
        lab.kill_wrapper('gate')
    elif action == 'stop':
        lab.call(['systemctl', '--user', 'stop', lab.wrapper_unit('gate')])
    lab.released('gate')
    lab.done(gate, -9 if action == 'kill' else (0 if action == 'normal' else 137))
    if action == 'kill':
        assert lab.event('gate', 'release_end')['source'] == '--reconcile'
    for name in ('payload', 'child', 'private'):
        assert not live(evidence[name]), ('surviving descendant', name)
    assert live(int(shared)), 'shared daemon was killed'
    (lab.path / 'shared-after.json').write_text(json.dumps({'pid': shared,
        'cgroup': Path(f'/proc/{shared}/cgroup').read_text(), 'live': live(int(shared))}))
    assert not lab.held('build')
    if action == 'boot':
        wait_for(lambda: lab.state()['installation']['boot'] == 'fixture-next-boot', 'new boot containment probe')
    lab.done(lab.start('progress'))


