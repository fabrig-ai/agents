def migrate_undrained(lab):
    # Keep admission's timer proof while leaving recovery to the submitting
    # call below, rather than racing the accelerated periodic tick.
    lab.call([HEAVY, '--install-reconciler', '60s'])
    lab.call(['systemctl', '--user', 'start', lab.prefix + '-reconcile.service'])
    marker = lab.path / 'finish-running'
    running = lab.start('running', code='import time; from pathlib import Path\n'
                        f'while not Path({str(marker)!r}).exists(): time.sleep(0.03)\n')
    wait_for(lambda: lab.event('running', 'payload_begin'), 'running payload')
    lab.arm('claim')
    clients = {}
    wrappers = {}
    for label in ('enqueuing', 'queued'):
        clients[label] = lab.start(label, args=['touch', str(lab.path / (label + '-must-not-run'))])
        wrappers[label] = lab.queued(label)['wrapper_unit']
        lab.barrier('claim', label)

    def edit(data):
        for task in data['tasks'].values():
            task.pop('exclusive', None)
            if task['label'] == 'enqueuing':
                task['state'] = 'enqueuing'

    previous = lab.pueue_era(edit)
    refused = lab.call([HEAVY, 'true'], check=False, environment=dict(lab.env, HEAVY_LABEL='refused'))
    (lab.path / 'refused.client.txt').write_text(refused.stdout + refused.stderr)
    assert refused.returncode == 2
    assert 'drain first: 1 task from the pueue generation' in refused.stderr, refused.stderr
    assert lab.state()['tasks'].keys() == previous['tasks'].keys() and lab.task('refused') is None
    assert lab.state()['queue'] == previous['queue'] and 'next_id' not in lab.state()
    for label, client in clients.items():
        task = lab.released(label)
        assert task['code'] == 137 and task['outcome'] == 'cancelled' and not task.get('wrapper')
        assert lab.event(label, 'unclaimed')['source'] == 'submit'
        lab.done(client, 137)
        receipt = json.loads((lab.base / 'receipts' / (task['token'] + '.json')).read_text())
        assert receipt['queue'] == previous['queue'] and receipt['code'] == 137
    lab.disarm('claim')
    wait_for(lambda: sum(e['source'] == '--task' and e['event'].startswith('refusal:')
                         for e in lab.events()) == 2, 'both older wrappers refused replay')
    for label, unit in wrappers.items():
        wait_for(lambda: lab.call(['systemctl', '--user', 'is-active', '--quiet', unit],
                                 check=False).returncode != 0, label + ' wrapper ended')
        assert not (lab.path / (label + '-must-not-run')).exists()
        assert not lab.event(label, 'wrapper_start')
    assert lab.task('running')['state'] == 'active' and lab.state()['queue'] == previous['queue']
    assert not any(e['event'].startswith('migration:') for e in lab.events())
    marker.touch()
    lab.done(running)
    task = lab.released('running')
    assert task['code'] == 0
    assert json.loads((lab.base / 'receipts' / (task['token'] + '.json')).read_text())['queue'] == previous['queue']
    lab.call([HEAVY, '--reconcile'])
    migrations = [e for e in lab.events() if e['event'].startswith('migration:')]
    assert len(migrations) == 1 and migrations[0]['previous'] == previous['queue']
    assert lab.state()['queue'] == hashlib.sha256(str(lab.base).encode()).hexdigest()
    lab.call([HEAVY, '--install-reconciler', '0.2s'])
    lab.done(lab.start('progress'))


