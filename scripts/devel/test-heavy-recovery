def unclaimed_client(lab, periodic=False):
    # A client lost after durable submission cannot leave an unowned token.
    anchor = {}
    if periodic:
        lab.call([HEAVY, '--install-reconciler', '5s'])
        lab.call(['systemctl', '--user', 'start', lab.prefix + '-reconcile.service'])
        for key, unit, prop in (
                ('last_inactive_usec', '-reconcile.service', 'InactiveEnterTimestampMonotonic'),
                ('next_elapse_usec', '-reconcile.timer', 'NextElapseUSecMonotonic')):
            anchor[key] = lab.call(['systemctl', '--user', 'show', lab.prefix + unit,
                                   '--property=' + prop, '--value']).stdout.strip()
    lab.arm('wrapper_intent')
    client = lab.start('unclaimed')
    pid = lab.barrier('wrapper_intent', 'unclaimed')
    assert pid == client.pid
    task = lab.task('unclaimed')
    assert (lab.base / (task['token'] + '.env')).exists()
    killed_ns = time.time_ns()
    client.kill()
    lab.done(client, -9)
    lab.disarm('wrapper_intent')
    # Observe files only: no heavy call may trigger the recovery we measure.
    task = lab.released('unclaimed')
    event = lab.event('unclaimed', 'unclaimed')
    assert task['code'] == 137 and task['outcome'] == 'cancelled' and not task.get('wrapper')
    assert event['source'] == '--reconcile' and event['time_ns'] > killed_ns
    receipt = lab.base / 'receipts' / (task['token'] + '.json')
    wait_for(receipt.exists, 'unclaimed receipt')
    assert json.loads(receipt.read_text())['code'] == 137
    assert not (lab.base / (task['token'] + '.env')).exists()
    props = lab.call(['systemctl', '--user', 'show', task['wrapper_unit'], '--property=LoadState']).stdout
    assert 'LoadState=not-found' in props
    if periodic:
        assert lab.state()['installation']['interval'] == '5s'
        assert event['time_ns'] - killed_ns < 15e9
        activation = int(lab.call(['systemctl', '--user', 'show', lab.prefix + '-reconcile.service',
                                  '--property=ExecMainStartTimestampMonotonic', '--value']).stdout.strip())
        assert activation >= int(anchor['last_inactive_usec']) + 4_900_000
        anchor.update(recovery_activation_usec=activation, periodic_activation=True,
                      killed_ns=killed_ns, recovery_ns=event['time_ns'], source=event['source'],
                      interval='5s', no_heavy_call_after_kill=True)
        (lab.path / 'periodic-proof.json').write_text(json.dumps(anchor, indent=2) + '\n')
    lab.done(lab.start('progress'))


def wrapper_start_failure(lab):
    # Both a rejected transient start and an exec error release synchronously.
    shim = lab.path / 'failed-launch-bin'
    shim.mkdir()
    launcher = shim / 'systemd-run'
    for name in ('bash', 'python3', 'readlink', 'dirname', 'basename', 'nproc',
                 'awk', 'df', 'tail', 'tr', 'git', 'systemctl'):
        (shim / name).symlink_to(shutil.which(name))
    previous = lab.env['PATH']
    lab.env['PATH'] = str(shim) + ':' + previous
    marker = lab.path / 'must-not-run'
    for label, content in (('rejected-start', '#!/bin/sh\nexit 71\n'),
                           ('exec-error', 'invalid executable\n')):
        launcher.write_text(content)
        launcher.chmod(0o700)
        if label == 'exec-error':
            lab.env['PATH'] = str(shim)
        result = lab.call([HEAVY, 'touch', marker], check=False,
                          environment=dict(lab.env, HEAVY_LABEL=label))
        (lab.path / (label + '.refusal.txt')).write_text(result.stdout + result.stderr)
        assert result.returncode == 2 and result.stderr == 'heavy: cannot start the task wrapper unit\n', result
        task = lab.task(label)
        assert task['state'] == 'released' and task['outcome'] == 'refused' and task['code'] == 2
        assert lab.event(label, 'refusal')['reason'] == 'cannot start the task wrapper unit'
        assert not task.get('wrapper') and not marker.exists()
        receipt = json.loads((lab.base / 'receipts' / (task['token'] + '.json')).read_text())
        assert receipt['outcome'] == 'refused' and receipt['code'] == 2
        assert not (lab.base / (task['token'] + '.env')).exists()
    lab.env['PATH'] = previous
    # An older same-identity snapshot can lack the allocator, never its IDs.
    state = lab.state()
    state.pop('next_id')
    (lab.base / 'state.json').write_text(json.dumps(state))
    lab.done(lab.start('progress'))
    assert int(lab.task('progress')['id']) == 3


