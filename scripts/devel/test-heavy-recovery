def lane_order(lab, lane):
    # Hold admission until every wrapper waits, then prove FIFO payload entry.
    if lane == 'build':
        lab.env['HEAVY_BUILD_SLOTS'] = '1'
    lab.hold(lane)
    labels = [lane + '-' + str(i) for i in range(4)]
    clients = []
    for i, label in enumerate(labels):
        clients.append(lab.start(label, gate=lane == 'gate' and i < 3,
                                 land=lane == 'gate' and i == 3, duration=.15))
        lab.waiting(label)
        assert not lab.event(label, 'admit') and not lab.event(label, 'drain_begin')
    lab.unhold(lane)
    for client in clients:
        lab.done(client)
    assert [e['label'] for e in lab.events() if e['event'] == 'payload_begin'] == labels
    for previous, following in zip(labels, labels[1:]):
        assert lab.event(previous, 'release_end')['time_ns'] < lab.event(following, 'scope_enter')['time_ns']


