def overhead(lab, real_policy=False):
    samples = []
    payload = [sys.executable, '-c', 'import time; time.sleep(.15)']
    if real_policy:
        lab.env.update(SKEIN_TEST_CHROMIUM=str(Path.home() / '.local/opt/chromium-147.0.7727.101/bin/chromium'),
                       SKEIN_TEST_FONTS='/usr/share/fonts/truetype/dejavu')
    def measure(args, name, environment):
        with (lab.path / (name + '.output')).open('w') as out:
            start = time.monotonic_ns()
            child = subprocess.Popen([str(arg) for arg in args], cwd=lab.repo, env=environment,
                                     stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
            _, status, usage = os.wait4(child.pid, 0)
            child.returncode = os.waitstatus_to_exitcode(status)
            elapsed = (time.monotonic_ns() - start) / 1e6
        assert child.returncode == 0, (name, child.returncode)
        return elapsed, {'user_s': usage.ru_utime, 'system_s': usage.ru_stime,
                         'maxrss_kib': usage.ru_maxrss}
    for i in range(3):
        # Same command, alternating raw then queued execution.
        before_tasks = len(lab.state()['tasks'])
        before = len(lab.events())
        size = (lab.base / 'events.jsonl').stat().st_size
        direct, direct_metrics = measure(payload, 'direct-' + str(i), lab.env)
        # The timer/queue execute outside this client's process ancestry.
        queued, metrics = measure([HEAVY, *(['--gate'] if real_policy else []), '--', *payload],
                                  'heavy-' + str(i), dict(lab.env, HEAVY_LABEL='sample-' + str(i)))
        samples.append({'tasks': len(lab.state()['tasks']) - before_tasks,
                        'event_count': len(lab.events()) - before,
                        'event_bytes': (lab.base / 'events.jsonl').stat().st_size - size,
                        'direct_resources': direct_metrics, 'client_resources': metrics,
                        'scope_resources': lab.task('sample-' + str(i)).get('resources'),
                        'direct_ms': direct, 'heavy_ms': queued, 'overhead_ms': queued - direct})
    retained = sum(path.stat().st_size for path in (lab.path / 'tmp').rglob('*') if path.is_file())
    data = {'samples': samples, 'median_overhead_ms': statistics.median(s['overhead_ms'] for s in samples),
            'real_policy': real_policy, 'host': os.uname().nodename, 'loadavg': os.getloadavg(),
            'retained_tmp_bytes': retained, 'cpu_scope': 'client ancestry plus separately sampled owned cgroup',
            'payload': payload, 'background': 'normal host services; only owned disposable queues used'}
    (lab.path / 'overhead.json').write_text(json.dumps(data, indent=2) + '\n')


@contextlib.contextmanager
def released_ledger(lab):
    lab.done(lab.start('land repo', land=True))
    task = lab.released('land repo')
    scratch = lab.path / 'ledger-copy'
    scratch.mkdir()
    base, logs = scratch / 'heavy', scratch / 'logs'
    shutil.copytree(lab.base, base)
    shutil.copytree(lab.path / 'tmp/logs', logs)
    sys.path.insert(0, str(KIT))
    try:
        with patch.dict(os.environ, lab.env):
            module = runpy.run_path(str(KIT / 'heavy-recovery.py'))
    finally:
        sys.path.pop(0)
    scope = module['Ledger'].save.__globals__
    with patch.dict(os.environ, lab.env), patch.dict(scope, BASE=base, LOGS=logs), \
            patch.object(time, 'time', return_value=task['ended'] + 120):
        ledger = module['Ledger']()
        yield module, ledger, task


def hand_shrink(ledger, task):
    compact = {key: task[key] for key in ('token', 'id', 'state', 'code', 'row_durable', 'ended')}
    ledger.tasks[task['token']] = compact
    ledger.save()
    assert json.loads(ledger.path.read_text())['tasks'][task['token']] == compact
    return compact




def delayed_client_reads_shrunk_history(lab):
    with released_ledger(lab) as (module, ledger, task):
        token = task['token']
        hand_shrink(ledger, task)
        # Refusals before launch may have no log output; their event keeps the remedy.
        with (ledger.path.parent / 'events.jsonl').open('a') as out:
            out.write(json.dumps({'token': token, 'event': 'refusal', 'reason': 'start the shared service'}) + '\n')
        with (ledger.path.parent / 'events.jsonl').open('a') as out:
            out.write('{"interrupted":')
        assert module['completed_task'](token)['refusal'] == 'start the shared service'
        # A delayed client/cancel still gets its summary from the receipt and row.
        completed = module['completed_task'](token)
        for key in ('code', 'lane', 'repo', 'log', 'waited', 'ran'):
            assert completed[key] == task[key]
        with patch('pathlib.Path.cwd', return_value=Path(task['repo'])):
            assert module['cancel'](token) == 1


def task_number_survives_retired_records(lab):
    with released_ledger(lab) as (module, ledger, task):
        token = task['token']
        hand_shrink(ledger, task)
        ledger.tasks.pop(token)
        ledger.save()
        # A queue takeover must preserve the allocator even with no retained task.
        ledger.data['next_id'] = 50
        ledger.data['queue'] = 'previous queue'
        module['take_over'](ledger)
        assert ledger.data['next_id'] == 50
        # An old snapshot lacking the counter seeds from the TSV, even when empty.
        rows = module['Ledger'].save.__globals__['LOGS'] / 'heavy.tsv'
        fields = task['row'].split('\t')
        fields[0] = '37'
        with rows.open('a') as out:
            out.write('\t'.join(fields) + '\n')
        ledger.data.pop('next_id')
        ledger.save()
        restored = module['Ledger']()
        assert restored.data['next_id'] == 38
        # Submit through the production allocator; refuse before any unit starts.
        scope = module['submit'].__globals__
        with patch.dict(scope, ensure_reconciler=lambda ledger: None, start_wrapper=lambda task: False,
                        kill_scope=lambda task: True):
            try:
                module['submit'](['true'], 'build', 0, False)
            except module['Refusal'] as error:
                assert str(error) == 'cannot start the task wrapper unit'
            else:
                raise AssertionError('fixture wrapper start must refuse')
        fresh = module['Ledger']()
        assert [int(t['id']) for t in fresh.tasks.values()] == [38]


def late_wrapper_refused_by_a_shrunk_task(lab):
    with released_ledger(lab) as (module, ledger, task):
        compact = hand_shrink(ledger, task)
        try:
            module['wrapper'](task['token'])
        except module['Refusal'] as error:
            assert str(error) == 'token is not queued; refusing replay'
        else:
            raise AssertionError('late wrapper ran')
        assert ledger.tasks[task['token']] == compact
        with patch.object(time, 'time', return_value=task['ended'] + 86400):
            ledger.tasks.pop(task['token'])
            ledger.save()
            try:
                module['wrapper'](task['token'])
            except module['Refusal'] as error:
                assert str(error) == 'token is not queued; refusing replay'
            else:
                raise AssertionError('evicted wrapper ran')
            assert module['payload'](task['token']) == 137
        assert module['completed_task'](task['token'])['code'] == task['code']


def release_replay_on_a_shrunk_task(lab):
    with released_ledger(lab) as (module, ledger, task):
        hand_shrink(ledger, task)
        receipt = ledger.path.parent / 'receipts' / (task['token'] + '.json')
        events = ledger.path.parent / 'events.jsonl'
        rows = module['Ledger'].save.__globals__['LOGS'] / 'heavy.tsv'
        before = [p.read_bytes() for p in (receipt, events, rows)]
        ledger.data['pending'] = [lab.events()[-1]]
        ledger.save()
        transport = ledger.path.parent / (task['token'] + '.env')
        transport.touch()
        for _ in range(3):
            module['reconcile'](module['Ledger']())
        assert not transport.exists()
        assert [p.read_bytes() for p in (receipt, events, rows)] == before


def reservation_ignores_shrunk(lab):
    with released_ledger(lab) as (module, ledger, task):
        hand_shrink(ledger, task)
        for now in (task['ended'] + 120, task['ended'] + 119, task['ended'] - 1):
            with patch.object(time, 'time', return_value=now):
                assert module['reservation'](ledger.tasks) is None
        # Both lanes and FIFO readers ignore released records without lane/label.
        with patch.dict(os.environ, HEAVY_BUILD_SLOTS_EFFECTIVE='2'):
            for lane in ('build', 'gate'):
                waiting = dict(task, token='waiting', id='2', state='waiting', lane=lane)
                ledger.tasks['waiting'] = waiting
                assert module['admissible'](ledger, waiting)
                del ledger.tasks['waiting']


