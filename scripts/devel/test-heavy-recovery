    assert task['code'] == 130 and task['outcome'] == 'cancelled', task
    assert lab.event(label, 'cancel') and lab.event(label, 'release_end')['code'] == 130
    receipt = json.loads((lab.base / 'receipts' / (task['token'] + '.json')).read_text())
    assert receipt['code'] == 130 and receipt['outcome'] == 'cancelled' and not receipt['payload_ended']
    output = (lab.path / (label + '.client.txt')).read_text()
    assert 'Traceback' not in output, output
    assert f"heavy: task {task['id']} ({task['lane']}) exit 130, waited " in output, output
    assert output.splitlines()[-1] == f"heavy: receipt {lab.base / 'receipts' / (task['token'] + '.json')} token {task['token']}"
    row = next(row.split('\t') for row in (lab.path / 'tmp/logs/heavy.tsv').read_text().splitlines()
               if row.split('\t')[8] == task['log'])
    assert row[5] == '130', row
    assert lab.state()['gate'] is None
    return task


def refused_replay(lab, task, marker):
    # The wrapper, let past its claim barrier, must refuse the released token.
    lab.disarm('claim')
    wait_for(lambda: any(e['source'] == '--task' and e['event'].startswith('refusal:') for e in lab.events()),
             'late wrapper refused replay')
    wait_for(lambda: lab.call(['systemctl', '--user', 'is-active', '--quiet', task['wrapper_unit']],
                             check=False).returncode != 0, 'wrapper ended')
    assert not marker.exists(), 'cancelled payload ran'


def cancel_queued(lab):
    lab.arm('claim')
    marker = lab.path / 'must-not-run'
    client = lab.start('queued-build', args=['touch', str(marker)])
    task = lab.queued('queued-build')
    # Below the disk floor: a cancel frees a slot, so it never refuses there.
    floor = dict(lab.env, PLAN_MIN_DISK_GB='999999')
    assert lab.call([HEAVY, 'true'], check=False, environment=floor).returncode == 2
    result = lab.call([HEAVY, '--cancel', task['token']], environment=floor)
    assert result.stdout == f"heavy: cancelled task {task['id']} (build) token {task['token']}, exit 130\n", result
    task = cancelled(lab, 'queued-build', client)
    assert not task.get('wrapper') and not task.get('payload_started')
    again = lab.call([HEAVY, '--cancel', task['token']], check=False)
    assert again.returncode == 1 and 'not cancelled, already ended' in again.stdout, again
    refused_replay(lab, task, marker)
    lab.done(lab.start('progress'))


def cancel_running(lab, gate):
    marker = lab.path / 'payload.json'
    code = ('import json,os,subprocess,time\nfrom pathlib import Path\n'
            'child=subprocess.Popen(["setsid","sleep","120"])\n'
            'Path(' + repr(str(marker)) + ').write_text(json.dumps({"payload":os.getpid(),"child":child.pid}))\n'
            'time.sleep(120)\n')
    label = 'running-gate' if gate else 'running-build'
    client = lab.start(label, gate=gate, code=code)
    pids = wait_for(lambda: fixture_json(marker), 'payload PID JSON')
    token = lab.task(label)['token']
    if gate:
        assert lab.state()['gate'] == token
        assert lab.held('build')
    result = lab.call([HEAVY, '--cancel', token])
    assert 'heavy: cancelled task' in result.stdout and 'exit 130' in result.stdout, result
    task = cancelled(lab, label, client)
    assert task['payload_started'] and task.get('cgroup')
    assert lab.event(label, 'cancel')['source'] == '--cancel'
    for name in ('payload', 'child'):
        assert not live(pids[name]), ('cancel left a process of the scope', name)
    assert not lab.held('build')
    lab.done(lab.start('progress'))


def cancel_refusals(lab):
    proceed = lab.path / 'finish-payload'
    client = lab.start('owned', code='from pathlib import Path; import time; p=Path(' +
                       repr(str(proceed)) + ');\nwhile not p.exists(): time.sleep(.02)')
    wait_for(lambda: lab.event('owned', 'payload_begin'), 'owned payload')
    task = lab.task('owned')
    elsewhere, below = lab.path / 'elsewhere', lab.repo / 'sub'
    elsewhere.mkdir()
    below.mkdir()
    rows = [(task['token'], elsewhere, 'cancel refused: the task was submitted from another directory'),
            (task['token'], below, 'cancel refused: the task was submitted from another directory'),
            (os.urandom(16).hex(), lab.repo, 'cancel refused: unknown token'),
            (task['token'].upper(), lab.repo, 'cancel refused: malformed token'),
            ('../' + task['token'], lab.repo, 'cancel refused: malformed token')]
    for token, directory, words in rows:
        result = lab.call([HEAVY, '--cancel', token], check=False, cwd=directory)
        assert result.returncode == 2 and result.stderr == 'heavy: ' + words + '\n', result
    for args in (['--cancel'], ['--cancel', task['token'], 'extra']):
        result = lab.call([HEAVY, *args], check=False)
        assert result.returncode == 2 and '--cancel TOKEN' in result.stderr, result
    after = lab.task('owned')
    assert after['state'] == 'active' and after.get('outcome') is None and not lab.event('owned', 'cancel')
    assert client.poll() is None
    proceed.touch()
    lab.done(client)


def interrupted(lab, number, running):
    marker = lab.path / 'payload-started'
    if running:
        code = ('from pathlib import Path; import time; Path(' + repr(str(marker)) + ').touch(); time.sleep(120)')
    else:
        lab.arm('claim')
        code = 'from pathlib import Path; Path(' + repr(str(marker)) + ').touch()'
    client = lab.start('interrupted', code=code)
    if running:
        wait_for(marker.exists, 'payload running')
    else:
        lab.queued('interrupted')
    client.send_signal(number)
    task = cancelled(lab, 'interrupted', client)
    assert lab.event('interrupted', 'cancel')['reason'] == 'interrupt'
    assert lab.event('interrupted', 'cancel')['signal'] == number
    output = (lab.path / 'interrupted.client.txt').read_text()
    assert 'heavy: interrupted; cancelled task' in output and 'recovery/storage failure' not in output, output
    if running:
        assert task['payload_started']
    else:
        refused_replay(lab, task, marker)
    lab.done(lab.start('progress'))


def land_interrupt(lab):
    # A terminal's Ctrl-C reaches the whole foreground group: land, its
    # capture and heavy. The gate is cancelled and nothing lands.
    base, head = candidate(lab)
    marker = lab.path / 'gate-running'
    output = lab.path / 'land.client.txt'
    with output.open('w') as stream:
        land = subprocess.Popen([str(KIT / 'land'), '--local', '--gate', 'touch ' + str(marker) + '; sleep 120'],
                                env=dict(lab.env, LAND_PREBUILD=''), cwd=lab.repo, start_new_session=True,
                                stdin=subprocess.DEVNULL, stdout=stream, stderr=subprocess.STDOUT)
    lab.clients.append(land)
    wait_for(marker.exists, 'land gate running')
    os.killpg(land.pid, signal.SIGINT)
    assert land.wait(timeout=HUNG_TOOL_S) == 4
    text = output.read_text()
    assert 'Traceback' not in text and 'heavy: interrupted; cancelled task' in text, text
    task = lab.released('land repo')
    assert task['code'] == 130 and task['outcome'] == 'cancelled'
    assert lab.call(['git', 'rev-parse', 'main']).stdout.strip() == base
    assert lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip() == head
    assert not (lab.path / 'tmp/gates').exists()
    lab.done(lab.start('progress'))


def candidate(lab):
    base = lab.call(['git', 'rev-parse', 'main']).stdout.strip()
    lab.call(['git', 'switch', '-qc', 'candidate'])
    (lab.repo / 'code').write_text('candidate\n')
    lab.call(['git', 'add', 'code'])
    lab.call(['git', 'commit', '-qm', 'candidate'])
    return base, lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip()


def land_process(lab, command):
    out = (lab.path / 'land.client.txt').open('w')
    process = subprocess.Popen([str(KIT / 'land'), '--local', '--gate', command],
                              env=dict(lab.env, LAND_PREBUILD=''), cwd=lab.repo,
                              stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
    out.close()
    lab.clients.append(process)
    return process


def mutate_candidate(lab, mode):
    if mode == 'rebase':
        original = lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip()
        base = lab.call(['git', 'rev-parse', 'main']).stdout.strip()
        branch = lab.call(['git', 'symbolic-ref', '--short', 'HEAD']).stdout.strip()
        lab.call(['git', 'switch', '-qc', 'concurrent-base', base])
        (lab.repo / 'upstream-code').write_text('ungated upstream change\n')
        lab.call(['git', 'add', 'upstream-code'])
        lab.call(['git', 'commit', '-qm', 'concurrent upstream change'])
        new_base = lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip()
        lab.call(['git', 'switch', '-q', branch])
        lab.call(['git', 'rebase', '--onto', new_base, base])
        assert lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip() != original
    elif mode == 'same-tree':
        lab.call(['git', 'commit', '--allow-empty', '-qm', 'concurrent same tree commit'])
    elif mode == 'rebase-state':
        location = lab.call(['git', 'rev-parse', '--git-path', 'rebase-merge']).stdout.strip()
        (lab.repo / location).mkdir()
    else:
        (lab.repo / 'code').write_text('concurrent candidate B\n')
        if mode in ('commit', 'index'):
            lab.call(['git', 'add', 'code'])
        if mode == 'commit':
            lab.call(['git', 'commit', '-qm', 'concurrent candidate B'])


def payload_tree_drift(lab, when, mode):
    candidate(lab)
    marker, proceed = lab.path / 'requested-payload', lab.path / 'finish-payload'
    if when == 'settled':
        lab.arm('settled')
        gate = lab.start('gate', gate=True, args=['touch', str(marker)])
        lab.barrier('settled', 'gate')
    else:
        code = ('from pathlib import Path; import time; Path(' + repr(str(marker)) + ').touch(); '
                'p=Path(' + repr(str(proceed)) + ');\nwhile not p.exists(): time.sleep(.02)')
        gate = lab.start('gate', gate=True, code=code)
        wait_for(marker.exists, 'payload running on candidate A')
    mutate_candidate(lab, mode)
    if when == 'settled':
        lab.disarm('settled')
    else:
        proceed.touch()
    lab.done(gate, 2)
    task = lab.released('gate')
    receipt = json.loads((lab.base / 'receipts' / (task['token'] + '.json')).read_text())
    assert task['code'] != 0 and receipt['code'] != 0
    assert 'rerun land' in (lab.path / 'gate.client.txt').read_text()
    if when == 'settled':
        assert not marker.exists() and not receipt['payload_started']
    assert not receipt['payload_ended'], 'drift accepted payload completion'
    (lab.path / 'tree-drift-proof.json').write_text(json.dumps({
        'when': when, 'mode': mode, 'admitted_commit': task['commit'], 'admitted_tree': task['tree'],
        'receipt_code': receipt['code'], 'accepted_completion': False}, indent=2) + '\n')


def dirty_admission(lab):
    candidate(lab)
    for mode in ('worktree', 'index'):
        mutate_candidate(lab, mode)
        result = lab.call([HEAVY, '--gate', 'true'], check=False)
        assert result.returncode == 2 and 'rerun land' in result.stderr
        assert not lab.state()['tasks']
        (lab.path / (mode + '-refusal.txt')).write_text(result.stdout + result.stderr)
        lab.call(['git', 'reset', '--hard', 'HEAD'])
    lab.done(lab.start('positive', gate=True))


def concurrent_land_drift(lab, mode, point='after_receipt'):
    base, head = candidate(lab)
    lab.arm(point)
    land = land_process(lab, 'true')
    wait_for((lab.faults / ('land-' + point)).exists, 'land ' + point)
    task = lab.task('land repo')
    receipt = json.loads((lab.base / 'receipts' / (task['token'] + '.json')).read_text())
    assert receipt['code'] == 0 and receipt['tree'] == lab.call(['git', 'rev-parse', head + '^{tree}']).stdout.strip()
    mutate_candidate(lab, mode)
    changed = lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip()
    lab.disarm(point)
    lab.done(land, 4)
    output = (lab.path / 'land.client.txt').read_text()
    assert 'candidate' in output and 'rerun land' in output
    assert lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip() == changed
    assert lab.call(['git', 'rev-parse', 'main']).stdout.strip() == base
    assert not lab.call(['git', 'log', '-1', '--format=%(trailers:key=Gate-Tree,valueonly)']).stdout.strip()
    if point == 'after_receipt':
        assert not (lab.path / 'tmp/gates').exists(), 'drift wrote fresh accepted cache'
    else:
        for cache in (lab.path / 'tmp/gates').rglob('*'):
            if cache.is_file():
                assert receipt['policy'] in cache.read_text()
    policy = lab.call(['bash', '-c', 'source "$1"; gate_policy_identity', 'fixture', KIT / 'gate-policy.sh'],
                      environment=dict(lab.env, SKEIN_GATE_COMMAND='true')).stdout.strip()
    assert policy == task['policy'], 'fixture must keep the effective policy fixed'
    (lab.path / 'candidate-proof.json').write_text(json.dumps({'mode': mode, 'point': point,
        'candidate_A': head, 'candidate_B': changed, 'gated_tree': receipt['tree'],
        'policy_unchanged': True, 'main_unchanged': True, 'candidate_B_has_no_green': True,
        'land_exit': land.returncode, 'no_fresh_cache': point == 'after_receipt'}, indent=2) + '\n')


