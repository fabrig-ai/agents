def replay(lab):
    lab.done(lab.start('gate', gate=True))
    events = lab.events()
    state = lab.state()
    # A snapshot outbox survives an append/rename interruption. Replay a
    # durable event, and an incomplete append at each journal's end.
    state['pending'] = [events[-1]]
    (lab.base / 'state.json').write_text(json.dumps(state))
    with (lab.base / 'events.jsonl').open('ab') as out:
        out.write(b'{"interrupted":')
    with (lab.path / 'tmp/logs/heavy.tsv').open('ab') as out:
        out.write(b'interrupted\trow')
    lab.call([HEAVY, '--reconcile'])
    assert lab.events() == events


def late_launch(lab):
    # The real systemd-run client is delayed before StartTransientUnit. The
    # wrapper dies and recovery releases first. The late unit cannot payload.
    shim = lab.path / 'bin'
    shim.mkdir()
    real = lab.call(['which', 'systemd-run']).stdout.strip()
    marker, proceed = lab.path / 'launch-waiting', lab.path / 'launch-continue'
    script = shim / 'systemd-run'
    script.write_text('#!/usr/bin/env python3\nimport os,time,sys\nfrom pathlib import Path\n'
        'if "--payload" not in sys.argv: os.execv(' + repr(real) + ', [' + repr(real) + '] + sys.argv[1:])\n'
        'Path(' + repr(str(marker)) + ').write_text(str(os.getpid()))\n'
        'while not Path(' + repr(str(proceed)) + ').exists(): time.sleep(.02)\n'
        'os.execv(' + repr(real) + ', [' + repr(real) + '] + __import__("sys").argv[1:])\n')
    script.chmod(0o700)
    lab.env['PATH'] = str(shim) + ':' + lab.env['PATH']
    marker_payload = lab.path / 'must-not-run'
    gate = lab.start('gate', gate=True, args=['touch', str(marker_payload)])
    wait_for(marker.exists, 'deferred scope creation')
    lab.kill_wrapper('gate')
    lab.released('gate')
    proceed.touch()
    wait_for(lambda: not live(int(marker.read_text())), 'late launcher ended')
    assert not marker_payload.exists(), 'late creation ran payload'
    lab.done(gate, 137)
    lab.env['PATH'] = lab.env['PATH'].split(':', 1)[1]
    lab.done(lab.start('progress'))


def cancelled_reused_id(lab):
    lab.done(lab.start('old-build'))
    old = lab.task('old-build')
    lab.q('reset', '--force')
    for group in ('build', 'gate'):
        if group not in json.loads(lab.q('group', '--json')):
            lab.q('group', 'add', group)
        lab.q('parallel', '2' if group == 'build' else '1', '--group', group)
    lab.q('pause', '--wait', '--group', 'gate')
    lab.call(['git', 'switch', '-qc', 'candidate'])
    (lab.repo / 'code').write_text('candidate\n')
    lab.call(['git', 'add', 'code'])
    lab.call(['git', 'commit', '-qm', 'candidate'])
    head = lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip()
    main = lab.call(['git', 'rev-parse', 'main']).stdout.strip()
    marker = lab.path / 'cancelled-payload-must-not-run'
    output = lab.path / 'land.client.txt'
    with output.open('w') as out:
        land = subprocess.Popen([str(KIT / 'land'), '--local', '--gate', 'touch ' + str(marker)],
                                env=dict(lab.env, LAND_PREBUILD=''), cwd=lab.repo,
                                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
    lab.clients.append(land)
    task = wait_for(lambda: lab.task('land repo'), 'land gate submission')
    wait_for(lambda: lab.task('land repo')['state'] == 'queued', 'land queued token')
    task = lab.task('land repo')
    assert task['id'] == old['id'], 'fixture must reuse the old successful build ID'
    assert task['state'] == 'queued' and not task.get('wrapper')
    lab.arm('queue_observed')
    # This known, never-started entry is still owned by the fixture. No other
    # submitter uses this daemon. Remove is the explicit cancellation fault.
    lab.q('remove', task['id'])
    observer = lab.barrier('queue_observed', 'land repo')
    lab.q('reset', '--force')
    for group in ('build', 'gate'):
        if group not in json.loads(lab.q('group', '--json')):
            lab.q('group', 'add', group)
        lab.q('parallel', '2' if group == 'build' else '1', '--group', group)
    proceed = lab.path / 'finish-unrelated'
    unrelated = lab.start('unrelated', code='from pathlib import Path; import time; p=Path(' +
                          repr(str(proceed)) + ');\nwhile not p.exists(): time.sleep(.02)')
    wait_for(lambda: lab.event('unrelated', 'payload_begin'), 'unrelated new task')
    assert lab.task('unrelated')['id'] == task['id']
    lab.disarm('queue_observed')
    lab.done(land, 4)
    cancelled = lab.released('land repo')
    receipt = json.loads((lab.base / 'receipts' / (task['token'] + '.json')).read_text())
    assert receipt['outcome'] == 'cancelled' and receipt['code'] != 0
    assert not receipt['payload_started'] and not receipt['payload_ended']
    assert receipt['token'] != old['token'] and not marker.exists()
    assert lab.task('unrelated')['state'] == 'active' and unrelated.poll() is None
    late = lab.call([HEAVY, '--task', task['token']], check=False)
    assert late.returncode == 2 and not marker.exists()
    assert lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip() == head
    assert lab.call(['git', 'rev-parse', 'main']).stdout.strip() == main
    assert not (lab.path / 'tmp/gates').exists()
    assert not lab.call(['git', 'log', '-1', '--format=%(trailers:key=Gate-Tree,valueonly)']).stdout.strip()
    (lab.path / 'cancellation-proof.json').write_text(json.dumps({
        'reused_id': task['id'], 'old_build_token': old['token'], 'cancelled_token': task['token'],
        'unrelated_token': lab.task('unrelated')['token'], 'observer_pid': observer,
        'land_exit': land.returncode, 'head_unchanged': True, 'main_unchanged': True,
        'no_cache_or_trailer': True, 'late_wrapper_exit': late.returncode,
        'unrelated_unharmed': True}, indent=2) + '\n')
    proceed.touch()
    lab.done(unrelated)
    lab.q('start', '--group', 'gate')


def stale_pause(lab):
    lab.call([HEAVY, '--install-reconciler', '5s'])
    lab.q('pause', '--wait', '--group', 'default')
    lab.q('group', 'add', 'operator-held')
    lab.call([HEAVY, '--maintenance-pause', 'operator-held'])
    marker = lab.path / 'finish-gate'
    lab.arm('payload_finished')
    gate = lab.start('gate', gate=True, code='from pathlib import Path; import time; p=Path(' +
                     repr(str(marker)) + ');\nwhile not p.exists(): time.sleep(.02)')
    wait_for(lambda: lab.event('gate', 'payload_begin'), 'stale-pause gate')
    lab.call(['systemctl', '--user', 'stop', lab.prefix + '-reconcile.timer'])
    lab.call(['systemctl', '--user', 'stop', lab.prefix + '-reconcile.service'])
    # Submission requires the active timer; queue this build before stopping
    # it again to construct the recorded stale-pause state deterministically.
    lab.call(['systemctl', '--user', 'start', lab.prefix + '-reconcile.timer'])
    build = lab.start('waiting-build')
    wait_for(lambda: lab.task('waiting-build') and lab.task('waiting-build')['state'] == 'queued', 'queued build')
    lab.call(['systemctl', '--user', 'stop', lab.prefix + '-reconcile.timer'])
    lab.call(['systemctl', '--user', 'stop', lab.prefix + '-reconcile.service'])
    # Anchor a completed reconciliation while the wrapper/payload are live.
    # The next recovery must come from the five-second periodic activation,
    # rather than the immediate OnBootSec activation when a timer starts.
    lab.call(['systemctl', '--user', 'start', lab.prefix + '-reconcile.timer'])
    lab.call(['systemctl', '--user', 'start', lab.prefix + '-reconcile.service'])
    inactive = lab.call(['systemctl', '--user', 'show', lab.prefix + '-reconcile.service',
                         '--property=InactiveEnterTimestampMonotonic', '--value']).stdout.strip()
    scheduled = lab.call(['systemctl', '--user', 'show', lab.prefix + '-reconcile.timer',
                          '--property=NextElapseUSecMonotonic', '--value']).stdout.strip()
    marker.touch()
    pid = lab.barrier('payload_finished', 'gate')
    os.kill(pid, signal.SIGKILL)
    lab.kill_wrapper('gate')
    lab.disarm('payload_finished')
    groups = json.loads(lab.q('group', '--json'))
    assert groups['build']['status'] != 'Running' and groups['gate']['status'] == 'Running'
    assert lab.state()['gate'] == lab.task('gate')['token'] and not lab.event('waiting-build', 'payload_begin')
    start = time.monotonic()
    lab.released('gate')
    elapsed = time.monotonic() - start
    lab.done(gate, 137)
    lab.done(build)
    assert lab.event('gate', 'release_end')['source'] == '--reconcile'
    assert lab.state()['installation']['interval'] == '5s'
    groups_after = json.loads(lab.q('group', '--json'))
    assert groups_after['build']['status'] == 'Running'
    assert groups_after['default']['status'] != 'Running'
    assert groups_after['operator-held']['status'] != 'Running'
    (lab.path / 'stale-pause-proof.json').write_text(json.dumps({
        'interval': '5s', 'recovery_seconds_single_sample': elapsed,
        'last_reconcile_inactive_monotonic_usec': inactive,
        'next_timer_elapse_monotonic_usec': scheduled, 'periodic_activation': True,
        'before': groups, 'after': groups_after, 'release_source': '--reconcile',
        'incident_root_cause': 'UNKNOWN', 'owned_hold_recovered': True,
        'unowned_and_maintenance_pauses_preserved': True}, indent=2) + '\n')


def publication_crash(lab, point='receipt_ready'):
    lab.arm(point)
    gate = lab.start('gate', gate=True)
    pid = lab.barrier(point, 'gate')
    task = lab.task('gate')
    assert task['state'] == 'released' and task['row_durable']
    assert (lab.base / 'receipts' / (task['token'] + '.json')).exists() == (point == 'receipt_published')
    if point == 'receipt_fsynced':
        assert (lab.base / 'receipts' / (task['token'] + '.json.new')).stat().st_mode & 0o777 == 0o600
    digest = hashlib.sha256(Path(task['log']).read_bytes()).hexdigest()
    os.kill(pid, signal.SIGKILL)
    lab.disarm(point)
    lab.done(gate)
    receipt = json.loads((lab.base / 'receipts' / (task['token'] + '.json')).read_text())
    assert receipt['log_sha256'] == digest
    # Even a delayed writer on the service's capture cannot mutate the log.
    with Path(task['capture']).open('a') as out:
        out.write('late capture write\n')
    lab.call([HEAVY, '--reconcile'])
    assert hashlib.sha256(Path(task['log']).read_bytes()).hexdigest() == digest


