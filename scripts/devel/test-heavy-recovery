def candidate(lab):
    base = lab.call(['git', 'rev-parse', 'main']).stdout.strip()
    lab.call(['git', 'switch', '-qc', 'candidate'])
    (lab.repo / 'code').write_text('candidate\n')
    lab.call(['git', 'add', 'code'])
    lab.call(['git', 'commit', '-qm', 'candidate'])
    return base, lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip()


def land_process(lab, command):
    out = (lab.path / 'land.client.txt').open('w')
    process = subprocess.Popen([str(KIT / 'land'), '--local', '--gate', command],
                              env=dict(lab.env, LAND_PREBUILD=''), cwd=lab.repo,
                              stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
    out.close()
    lab.clients.append(process)
    return process


def real_land(lab):
    lab.env.update(SKEIN_TEST_CHROMIUM=str(Path.home() / '.local/opt/chromium-147.0.7727.101/bin/chromium'),
                   SKEIN_TEST_FONTS='/usr/share/fonts/truetype/dejavu')
    base, head = candidate(lab)
    command = 'test -n "$SKEIN_GATE_POLICY_HELPER" && test -n "$SKEIN_TEST_FONTS" && "$SKEIN_TEST_CHROMIUM" --version'
    first = land_process(lab, command)
    lab.done(first)
    task = lab.task('land repo')
    assert task['tree'] == lab.call(['git', 'rev-parse', 'HEAD^{tree}']).stdout.strip()
    assert task['tree'] != head and task['policy'].startswith('sha256:')
    assert all(e['policy'] == task['policy'] for e in lab.events() if e.get('token') == task['token'])
    assert 'Chromium 147.0.7727.101' in Path(task['log']).read_text()
    (lab.path / 'land.first.txt').write_text((lab.path / 'land.client.txt').read_text())
    advanced = lab.call(['git', 'rev-parse', 'main']).stdout.strip()
    assert advanced != base
    lab.call(['git', 'update-ref', 'refs/heads/main', base])
    second = land_process(lab, command)
    lab.done(second)
    assert len(lab.state()['tasks']) == 1, 'cache hit resubmitted a gate'
    assert 'gate    ' in (lab.path / 'land.client.txt').read_text()
    assert '? s' not in (lab.path / 'land.client.txt').read_text()
    (lab.path / 'real-policy-proof.json').write_text(json.dumps({
        'runtime': lab.env['SKEIN_TEST_CHROMIUM'], 'policy': task['policy'], 'tree': task['tree'],
        'receipt': str(lab.base / 'receipts' / (task['token'] + '.json')),
        'first_exit': first.returncode, 'cache_hit_exit': second.returncode,
        'tasks_after_cache_hit': 1, 'main_advanced': True}, indent=2) + '\n')


def policy_refusal(lab, mode):
    base, head = candidate(lab)
    if mode == 'config':
        lab.env['CARGO_HOME'] = str(lab.path / 'cargo-home')
        Path(lab.env['CARGO_HOME']).mkdir()
    lab.q('pause', '--wait', '--group', 'gate')
    marker = lab.path / 'must-not-run'
    land = land_process(lab, 'touch ' + str(marker))
    task = wait_for(lambda: lab.task('land repo') if lab.task('land repo') and
                    lab.task('land repo')['state'] == 'queued' else None, 'policy gate queued')
    if mode == 'runtime':
        runtime = Path(lab.env['SKEIN_TEST_CHROMIUM'])
        runtime.write_text(runtime.read_text() + '# changed runtime content\n')
    elif mode == 'missing':
        Path(lab.env['SKEIN_TEST_CHROMIUM']).unlink()
    elif mode == 'config':
        # This external Cargo home is part of policy, outside the Git tree.
        cargo = lab.path / 'cargo-home'
        # Existing environment retained through the queue points here.
        (cargo / 'config.toml').write_text('[build]\nrustflags=["--cfg=changed"]\n')
    elif mode == 'tree':
        (lab.repo / 'code').write_text('changed while queued\n')
        lab.call(['git', 'commit', '-qam', 'queued tree change'])
        head = lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip()
    lab.q('start', '--group', 'gate')
    lab.done(land, 4)
    task = lab.released('land repo')
    assert task['code'] != 0 and not task.get('payload_started') and not marker.exists()
    assert task['policy'] == next(e['policy'] for e in lab.events() if e.get('token') == task['token'])
    assert lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip() == head
    assert lab.call(['git', 'rev-parse', 'main']).stdout.strip() == base
    assert not (lab.path / 'tmp/gates').exists()
    assert not lab.call(['git', 'log', '-1', '--format=%(trailers:key=Gate-Tree,valueonly)']).stdout.strip()
    (lab.path / 'policy-refusal-proof.json').write_text(json.dumps({
        'mode': mode, 'land_exit': land.returncode, 'payload_started': False,
        'head_unchanged': True, 'main_unchanged': True, 'no_cache_or_trailer': True,
        'submitted_policy_preserved': task['policy'], 'token': task['token']}, indent=2) + '\n')


def supplied_policy(lab):
