             ('policy-config-drift', lambda lab: policy_refusal(lab, 'config')),
             ('tree-drift', lambda lab: policy_refusal(lab, 'tree')),
             ('supplied-policy', supplied_policy), ('overhead', overhead),
             ('real147-overhead', lambda lab: overhead(lab, True))]
    for name, test in cases:
        if opts.case and name not in opts.case:
            continue
        print('RUN ' + name, flush=True)
        lab = Lab(root, name)
        result = {'case': name, 'evidence': str(lab.path)}
        try:
            lab.setup()
            test(lab)
            counts = lab.verify()
            result.update(result='PASS', **counts)
        except BaseException as error:
            result.update(result='FAIL', error=type(error).__name__ + ': ' + str(error))
            raise
        finally:
            previous_handler = signal.signal(signal.SIGINT, signal.SIG_IGN)
            lab.cleanup()
            signal.signal(signal.SIGINT, previous_handler)
            result['seconds_single_sample'] = round(time.monotonic() - lab.started, 3)
            RESULTS.append(result)
            (root / 'results.json').write_text(json.dumps(RESULTS, indent=2) + '\n')
            print(json.dumps(result), flush=True)
    print('PASS all selected cases; evidence ' + str(root), flush=True)


if __name__ == '__main__':
    main()
