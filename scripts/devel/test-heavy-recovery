#!/usr/bin/env python3
"""Fault the production heavy entrypoints against disposable pueued instances.

No global queue/cache mutations, task-record APIs, or environment dumps.
Raw evidence is retained in --evidence (a new directory).
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import shutil
import statistics
import subprocess
import sys
import time

os.umask(0o077)
KIT = Path(__file__).resolve().parent
HEAVY = KIT / 'heavy'
RESULTS = []


def wait_for(predicate, what, seconds=20):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(0.03)
    raise AssertionError('did not reach ' + what)


def live(pid):
    try:
        return Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[0] != 'Z'
    except FileNotFoundError:
        return False


def owned_wrapper(owner):
    if not owner or not live(owner['pid']):
        return False
    try:
        fields = Path(f"/proc/{owner['pid']}/stat").read_text().rsplit(')', 1)[1].split()
        return fields[19] == owner['ticks']
    except FileNotFoundError:
        return False


class Lab:
    def __init__(self, root, name):
        self.name, self.path = name, root / name
        self.path.mkdir()
        self.repo = self.path / 'repo'
        self.repo.mkdir()
        self.queue_dir = self.path / 'queue'
        self.queue_dir.mkdir()
        # sockaddr_un has a small fixed path limit, independent of the data
        # directory. The random evidence directory gives this socket ownership.
        self.socket = Path('/tmp/skein-hr-' + hashlib.sha256(str(self.path).encode()).hexdigest()[:24] + '.sock')
        assert not self.socket.exists(), self.socket
        (self.path / 'socket-path.txt').write_text(str(self.socket) + '\n')
        self.config = self.path / 'pueue.yml'
        self.config.write_text('shared:\n  pueue_directory: ' + str(self.queue_dir) + '\n'
            '  runtime_directory: ' + str(self.queue_dir) + '\n  use_unix_socket: true\n'
            '  unix_socket_path: ' + str(self.socket) + '\n')
        (self.path / 'tmp').mkdir()
        self.boot = self.path / 'tmp/boot-id'
        self.boot.write_text(Path('/proc/sys/kernel/random/boot_id').read_text())
        self.faults = self.path / 'tmp/faults'
        self.faults.mkdir()
        self.env = dict(os.environ)
        for key in ('HEAVY_TASK', 'DEV_ROOT', 'DEV_TMP', 'PUEUE_CONFIG_PATH', 'PUEUE_PROFILE',
                    'HEAVY_FAULT_DIR', 'HEAVY_BOOT_ID_FILE', 'RUSTC_WRAPPER'):
            self.env.pop(key, None)
        self.env.update(DEV_ROOT=str(self.path), DEV_TMP=str(self.path / 'tmp'),
                        PUEUE_CONFIG_PATH=str(self.config), HEAVY_SETTLE='0',
                        HEAVY_BOOT_ID_FILE=str(self.boot), HEAVY_FAULT_DIR=str(self.faults), HEAVY_RECOVERY_FIXTURE='1')
        cache_bin = self.path / 'fixture-bin'
        cache_bin.mkdir()
        cache = cache_bin / 'kache'
        cache.write_text('#!/usr/bin/env python3\nimport os,sys\nfrom pathlib import Path\n'
                         'assert sys.argv[1:] == ["gc"]\n'
                         'with Path(os.environ["HEAVY_FIXTURE_GC_LOG"]).open("a") as out: out.write("gc\\n")\n')
        cache.chmod(0o700)
        self.env['PATH'] = str(cache_bin) + ':' + self.env['PATH']
        self.env['HEAVY_FIXTURE_GC_LOG'] = str(self.path / 'cache-gc-stub.txt')
        runtime = cache_bin / 'chromium-147-fixture'
        runtime.write_text('#!/bin/sh\necho "Chromium 147.0.7727.101"\n')
        runtime.chmod(0o700)
        fonts = self.path / 'fonts'
        fonts.mkdir()
        (fonts / 'DejaVuSans.ttf').write_bytes(b'fixture-font')
        self.env.update(SKEIN_TEST_CHROMIUM=str(runtime), SKEIN_TEST_FONTS=str(fonts))
        self.env.pop('SKEIN_GATE_POLICY_ID', None)
        self.env.pop('SKEIN_GATE_POLICY_HELPER', None)
        self.base = self.path / 'tmp/heavy'
        self.prefix = 'skein-heavy-' + hashlib.sha256(str(self.base).encode()).hexdigest()[:12]
        self.clients = []
        self.extra_units = []
        self.daemon = None
        self.installed = False
        self.started = time.monotonic()
        self.number = 0

    def call(self, args, check=True, environment=None, **kw):
        result = subprocess.run([str(x) for x in args], env=environment or self.env, cwd=self.repo,
                                stdin=subprocess.DEVNULL, capture_output=True, text=True, **kw)
        if check and result.returncode:
            raise AssertionError(str(args[:2]) + ': ' + result.stdout + result.stderr)
        return result

    def q(self, *args):
        assert args[0] not in ('status', 'log', 'env')
        return self.call(['pueue', *args]).stdout

    def start_daemon(self):
        out = (self.path / ('daemon-' + str(time.time_ns()) + '.txt')).open('w')
        self.daemon = subprocess.Popen(['pueued', '--config', str(self.config)], env=self.env,
                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
        out.close()
        wait_for(lambda: self.call(['pueue', 'group', '--json'], check=False).returncode == 0,
                 'disposable daemon ready')

    def setup(self):
        self.call(['git', 'init', '-q', '-b', 'main'])
        self.call(['git', 'config', 'user.name', 'fixture'])
        self.call(['git', 'config', 'user.email', 'fixture@localhost'])
        self.call(['git', '-c', 'user.name=fixture', '-c', 'user.email=fixture@localhost',
                   'commit', '-q', '--allow-empty', '-m', 'Recovery fixture'])
        self.start_daemon()
        for group in ('build', 'gate'):
            self.q('group', 'add', group)
            self.q('parallel', '2' if group == 'build' else '1', '--group', group)
        install = self.call([HEAVY, '--install-reconciler', '0.2s'])
        (self.path / 'installation.txt').write_text(install.stdout + install.stderr)
        self.installed = True

    def state(self):
        return json.loads((self.base / 'state.json').read_text())

    def events(self):
        return [json.loads(line) for line in (self.base / 'events.jsonl').read_text().splitlines()]

    def event(self, label, name):
        return next((event for event in self.events() if event.get('label') == label and event['event'] == name), None)

    def task(self, label):
        return next((task for task in self.state()['tasks'].values() if task['label'] == label), None)

    def start(self, label, gate=False, code=None, duration=0.15, args=None):
        if args is None:
            args = [sys.executable, '-c', code or f'import time; time.sleep({duration})']
        env = dict(self.env, HEAVY_LABEL=label)
        # Only fixture-owned input variables are examined by the payload.
        env['FIXTURE_TOKEN'] = 'must-be-omitted'
        out = (self.path / (label + '.client.txt')).open('w')
        child = subprocess.Popen([str(HEAVY), *(['--gate'] if gate else []), '--', *args],
                    env=env, cwd=self.repo, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
        out.close()
        self.clients.append(child)
        return child

    def done(self, client, expected=0):
        code = client.wait(timeout=25)
        assert code == expected, (code, expected, self.path)

    def released(self, label):
        return wait_for(lambda: (task if (task := self.task(label)) and task['state'] == 'released' else None),
                        label + ' release')

    def arm(self, point):
        (self.faults / ('arm-' + point)).touch()

    def barrier(self, point, label):
        token = wait_for(lambda: self.task(label), label + ' token')['token']
        path = self.faults / (token + '-' + point)
        wait_for(path.exists, point + ' barrier')
        return int(path.read_text())

    def disarm(self, point):
        (self.faults / ('arm-' + point)).unlink(missing_ok=True)
        (self.faults / ('continue-' + point)).touch()

    def kill_wrapper(self, label):
        task = wait_for(lambda: self.task(label) if self.task(label).get('wrapper') else None, label + ' wrapper')
        os.kill(task['wrapper']['pid'], signal.SIGKILL)

    def verify(self):
        events = self.events()
        cgroup_proofs = []
        ids = [event['id'] for event in events]
        assert len(ids) == len(set(ids)), 'duplicate durable event IDs'
        active = {}
        for event in events:
            name, token = event['event'], event['token']
            if name == 'scope_enter':
                lane = event['lane']
                if lane == 'gate':
                    assert not active, ('gate overlaps live scope', active)
                else:
                    assert 'gate' not in active.values(), ('build overlaps gate', active)
                    assert len(active) < 2, ('more than two builds', active)
                active[token] = lane
            elif name == 'release_end':
                active.pop(token, None)
        assert not active, active
        for task in self.state()['tasks'].values():
            assert task['state'] == 'released', task
            assert sum(e['id'] == task['token'] + ':release_end' for e in events) == 1
            assert sum(e['id'] == task['token'] + ':task_completion' for e in events) == 1
            receipt_path = self.base / 'receipts' / (task['token'] + '.json')
            receipt = wait_for(lambda: json.loads(receipt_path.read_text()) if receipt_path.exists() else None,
                               'durable receipt')
            assert len(receipt) == 17 and receipt['schema'] == 'heavy-receipt-v1'
            assert receipt['token'] == task['token'] and receipt['tree'] == task['tree']
            assert receipt['policy'] == task['policy'] and receipt['code'] == task['code']
            assert receipt['release_complete'] and receipt['cgroup_empty']
            if task.get('payload_started') and task.get('payload_ended'):
                assert abs(receipt['elapsed_s'] - (task['payload_ended'] - task['payload_started'])) < 0.000001
                assert receipt['elapsed_s'] < task['ended'] - task['submitted'], 'gate duration includes queue/cleanup time'
            else:
                assert receipt['elapsed_s'] == 0
            assert receipt['log_sha256'] == hashlib.sha256(Path(task['log']).read_bytes()).hexdigest()
            assert receipt_path.stat().st_mode & 0o777 == 0o600
            assert Path(task['log']).stat().st_mode & 0o777 == 0o600
            if receipt['code'] == 0:
                assert receipt['outcome'] == 'completed' and receipt['payload_started'] and receipt['payload_ended']
            if task.get('cgroup'):
                path = Path('/sys/fs/cgroup') / task['cgroup'].lstrip('/') / 'cgroup.events'
                evidence = path.read_text() if path.exists() else 'cgroup absent'
                assert evidence == 'cgroup absent' or 'populated 0' in evidence, task['cgroup']
                cgroup_proofs.append({'token': task['token'], 'unit': task['unit'],
                                      'cgroup': task['cgroup'], 'evidence': evidence, 'verified_empty': True})
        (self.path / 'cgroup-proof.json').write_text(json.dumps(cgroup_proofs, indent=2) + '\n')
        rows = (self.path / 'tmp/logs/heavy.tsv').read_text().splitlines()
        assert len(rows) == len(self.state()['tasks'])
        assert all(len(row.split('\t')) == 11 for row in rows)
        assert len({row.split('\t')[8] for row in rows}) == len(rows)
        for path in [self.base / 'state.json', self.base / 'events.jsonl', self.path / 'tmp/logs/heavy.tsv']:
            assert path.stat().st_mode & 0o777 == 0o600, path
        assert 'must-be-omitted' not in (self.base / 'events.jsonl').read_text()
        for _ in range(3):
            self.call([HEAVY, '--reconcile'])
        assert len(self.events()) == len(events), 'repeated reconcile adds outcomes'
        return {'events': len(events), 'bytes': (self.base / 'events.jsonl').stat().st_size,
                'tasks': len(self.state()['tasks'])}

    def cleanup(self):
        # Kill only this fixture's recorded wrapper identities and unit names.
        for point in self.faults.glob('arm-*'):
            self.disarm(point.name.removeprefix('arm-'))
        if (self.base / 'state.json').exists():
            for task in self.state()['tasks'].values():
                if task['state'] != 'released' and owned_wrapper(task.get('wrapper')):
                    os.kill(task['wrapper']['pid'], signal.SIGKILL)
                if task['state'] != 'released' and not task.get('wrapper'):
                    # Unstarted disposable queue entries have no cgroup/holds.
                    # Let the queue run them rather than infer completion.
                    try:
                        self.q('start', '--group', task['lane'])
                    except AssertionError:
                        pass
            for _ in range(4):
                self.call([HEAVY, '--reconcile'], check=False)
                time.sleep(0.1)
        for child in self.clients:
            if child.poll() is None:
                child.terminate()
            try:
                child.wait(timeout=3)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
        if self.installed:
            removed = self.call([HEAVY, '--remove-reconciler'], check=False)
            if removed.returncode:
                # Even a failing case must leave no fixture timer or scope.
                self.call(['systemctl', '--user', 'disable', '--now', self.prefix + '-reconcile.timer'], check=False)
                self.call(['systemctl', '--user', 'stop', self.prefix + '-reconcile.service'], check=False)
                units = Path(self.state()['installation']['units'])
                for suffix in ('.service', '.timer'):
                    (units / (self.prefix + '-reconcile' + suffix)).unlink(missing_ok=True)
                self.call(['systemctl', '--user', 'daemon-reload'], check=False)
        scope_proofs = []
        if (self.base / 'state.json').exists():
            for task in self.state()['tasks'].values():
                if owned_wrapper(task.get('wrapper')):
                    os.kill(task['wrapper']['pid'], signal.SIGKILL)
                for unit in (task['unit'], self.prefix + '-' + task['token'] + '-observe.service'):
                    self.call(['systemctl', '--user', 'kill', '--kill-whom=all', '--signal=KILL', unit], check=False)
                    self.call(['systemctl', '--user', 'stop', unit], check=False)
                group = task.get('cgroup')
                path = Path('/sys/fs/cgroup') / group.lstrip('/') / 'cgroup.events' if group else None
                empty = not path or not path.exists() or 'populated 0' in path.read_text()
                assert empty, ('cleanup left populated cgroup', task['unit'])
                scope_proofs.append({'unit': task['unit'], 'empty': empty})
        for unit in self.extra_units:
            self.call(['systemctl', '--user', 'stop', unit], check=False)
        if self.daemon and self.daemon.poll() is None:
            self.q('shutdown')
            self.daemon.wait(timeout=10)
        if not self.daemon or self.daemon.poll() is not None:
            self.socket.unlink(missing_ok=True)
            shutil.rmtree(self.queue_dir)
        for private_env in self.base.glob('*.env'):
            private_env.unlink()
        owned = self.call(['systemctl', '--user', 'list-units', '--all', '--plain', '--no-legend',
                          self.prefix + '*'], check=False).stdout
        # Inactive/failed unit records carry no processes; reset only our names.
        self.call(['systemctl', '--user', 'reset-failed', self.prefix + '*'], check=False)
        units = Path(self.env.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'systemd/user'
        remaining_files = [str(path) for path in units.rglob(self.prefix + '*')]
        live_wrappers = [task['wrapper']['pid'] for task in self.state()['tasks'].values()
                         if owned_wrapper(task.get('wrapper'))] if (self.base / 'state.json').exists() else []
        (self.path / 'cleanup.json').write_text(json.dumps({'queue_pid': self.daemon.pid if self.daemon else None,
            'queue_ended': not self.daemon or self.daemon.poll() is not None,
            'socket_removed': not self.socket.exists(),
            'owned_unit_listing': owned, 'prefix': self.prefix, 'retained': str(self.path),
            'scope_proofs': scope_proofs, 'live_wrappers': live_wrappers,
            'unit_files_remaining': remaining_files, 'queue_data_removed': not self.queue_dir.exists(),
            'private_environment_files_removed': not list(self.base.glob('*.env'))}, indent=2) + '\n')
        assert not remaining_files and not live_wrappers


def normal(lab):
    lab.env['FIXTURE_ESCAPED'] = '$literal $(not-a-command) `literal` \\ quote"\nline two'
    child = lab.start('failure', code='import os; print("payload-output"); assert "FIXTURE_TOKEN" not in os.environ; assert os.environ["CARGO_BUILD_JOBS"] == "4"; raise SystemExit(3)')
    lab.done(child, 3)
    gate = lab.start('gate', gate=True, code='import os; assert os.environ["CARGO_BUILD_JOBS"] == "8"')
    lab.done(gate)
    assert 'payload-output' in (lab.path / 'failure.client.txt').read_text()
    assert lab.event('gate', 'wrapper_start')['time_ns'] < lab.event('gate', 'payload_begin')['time_ns']
    lab.done(lab.start('escaped-input', code='import os; assert os.environ["FIXTURE_ESCAPED"] == ' + repr(lab.env['FIXTURE_ESCAPED'])))


def unsupported(lab):
    shim = lab.path / 'unsupported-bin'
    shim.mkdir()
    (shim / 'systemd-run').write_text('#!/bin/sh\nexit 71\n')
    (shim / 'systemd-run').chmod(0o700)
    env = dict(lab.env, PATH=str(shim) + ':' + lab.env['PATH'], DEV_TMP=str(lab.path / 'unsupported-tmp'))
    for key in ('HEAVY_BOOT_ID_FILE', 'HEAVY_FAULT_DIR', 'HEAVY_RECOVERY_FIXTURE'):
        env.pop(key, None)
    result = lab.call([HEAVY, '--install-reconciler'], check=False, environment=env)
    assert result.returncode == 2 and 'unsupported' in result.stderr
    (lab.path / 'unsupported.txt').write_text(result.stdout + result.stderr)
    # Changing endpoint selection cannot borrow an installed queue's ledger.
    config = lab.config.read_text()
    try:
        lab.config.write_text(config.replace(str(lab.socket), str(lab.socket) + '-other'))
        result = lab.call([HEAVY, '--reconcile'], check=False)
        assert result.returncode == 2 and 'different queue identity' in result.stderr
        (lab.path / 'queue-mismatch.txt').write_text(result.stdout + result.stderr)
    finally:
        lab.config.write_text(config)
    lab.done(lab.start('progress'))


def configured_kache(lab):
    cargo = lab.path / 'cargo-home'
    cargo.mkdir()
    (cargo / 'config.toml').write_text('[build]\nrustc-wrapper = "kache"\n')
    lab.env['CARGO_HOME'] = str(cargo)
    shim = lab.path / 'offline-cache-bin'
    shim.mkdir()
    real = lab.call(['which', 'systemctl']).stdout.strip()
    stub = shim / 'systemctl'
    stub.write_text('#!/usr/bin/env python3\nimport os,sys\n'
        'if "is-active" in sys.argv and "kache.service" in sys.argv: sys.exit(1)\n'
        'os.execv(' + repr(real) + ', [' + repr(real) + '] + sys.argv[1:])\n')
    stub.chmod(0o700)
    previous = lab.env['PATH']
    lab.env['PATH'] = str(shim) + ':' + previous
    marker = lab.path / 'must-not-start'
    child = lab.start('configured-cache', gate=True, args=['touch', str(marker)])
    lab.done(child, 2)
    assert not marker.exists() and not lab.event('configured-cache', 'scope_enter')
    assert lab.event('configured-cache', 'refusal')
    assert 'selected Cargo wrapper requires the shared kache.service' in (lab.path / 'configured-cache.client.txt').read_text()
    lab.env['RUSTC_WRAPPER'] = ''
    lab.done(lab.start('empty-dedicated', gate=True))
    lab.env.pop('RUSTC_WRAPPER')
    lab.env['CARGO_BUILD_RUSTC_WRAPPER'] = '/bin/true'
    lab.done(lab.start('generic-override', gate=True))
    lab.env.pop('CARGO_BUILD_RUSTC_WRAPPER')
    nearer = lab.path / '.cargo'
    nearer.mkdir()
    (nearer / 'config.toml').write_text('[build]\nrustc-wrapper = "/bin/true"\n')
    lab.done(lab.start('nearer-wrapper', gate=True))
    # The legacy filename wins over config.toml at the same depth.
    (nearer / 'config').write_text('[env]\nRUSTC_WRAPPER = {value="", force=true}\n')
    lab.env['RUSTC_WRAPPER'] = 'kache'
    lab.done(lab.start('forced-empty', gate=True))
    (nearer / 'config').write_text('[env]\nRUSTC_WRAPPER = {value="fixture-bin/kache", force=true, relative=true}\n')
    lab.done(lab.start('forced-relative', gate=True), 2)
    lab.env['RUSTC_WRAPPER'] = ''
    (nearer / 'config').write_text('[env]\nRUSTC_WRAPPER = "kache"\n')
    lab.done(lab.start('unforced-masked', gate=True))
    (nearer / 'config').write_text('[build]\nrustc-workspace-wrapper = "kache"\n')
    lab.done(lab.start('independent-workspace', gate=True), 2)
    (nearer / 'config').unlink()
    lab.env['PATH'] = previous
    lab.done(lab.start('progress'))


def kill_at(lab, point):
    lab.arm(point)
    gate = lab.start('gate', gate=True)
    pid = lab.barrier(point, 'gate')
    os.kill(pid, signal.SIGKILL)
    lab.disarm(point)
    lab.released('gate')
    if gate.pid != pid:
        lab.done(gate, 137 if point in ('intent', 'intent_fsynced', 'paused') else 0)
    build = lab.start('progress')
    lab.done(build)


def descendants(lab, action='kill'):
    unit = lab.prefix + '-shared.service'
    lab.extra_units.append(unit)
    lab.call(['systemd-run', '--user', '--quiet', '--unit=' + unit, '/bin/sleep', '120'])
    shared = lab.call(['systemctl', '--user', 'show', unit, '--property=MainPID', '--value']).stdout.strip()
    marker = lab.path / 'descendants.json'
    daemon_marker = lab.path / 'private-daemon.json'
    daemon_code = ('import json,os,time\nfrom pathlib import Path\n'
        'if os.fork(): os._exit(0)\nos.setsid()\n'
        'if os.fork(): os._exit(0)\n'
        'Path(' + repr(str(daemon_marker)) + ').write_text(json.dumps({"pid":os.getpid(),'
        '"cgroup":Path("/proc/self/cgroup").read_text()}))\ntime.sleep(120)\n')
    code = ('import json,os,subprocess,time\nfrom pathlib import Path\n'
            'child=subprocess.Popen(["setsid","sleep","120"])\n'
            'launcher=subprocess.Popen([' + repr(sys.executable) + ',"-c",' + repr(daemon_code) + '])\n'
            'private_marker=Path(' + repr(str(daemon_marker)) + ')\n'
            'while not private_marker.exists(): time.sleep(.01)\n'
            'private=json.loads(private_marker.read_text())\n'
            'Path(' + repr(str(marker)) + ').write_text(json.dumps({"payload":os.getpid(),"child":child.pid,"private":private["pid"],'
            '"payload_cgroup":Path("/proc/self/cgroup").read_text(),'
            '"child_cgroup":Path(f"/proc/{child.pid}/cgroup").read_text(),'
            '"private_cgroup":private["cgroup"]}))\n'
            'time.sleep(' + ('0.15' if action == 'normal' else '120') + ')\n')
    gate = lab.start('gate', gate=True, code=code)
    wait_for(marker.exists, 'setsid children started')
    evidence = json.loads(marker.read_text())
    assert evidence['payload_cgroup'] == evidence['child_cgroup'] == evidence['private_cgroup']
    shared_cgroup = Path(f'/proc/{shared}/cgroup').read_text()
    assert shared_cgroup != evidence['payload_cgroup']
    (lab.path / 'shared.json').write_text(json.dumps({'pid': shared, 'cgroup': shared_cgroup}))
    if action == 'boot':
        lab.boot.write_text('fixture-next-boot\n')
    elif action == 'restart':
        waiting = lab.start('queued-before-restart')
        wait_for(lambda: lab.task('queued-before-restart') and 'queued task' in
                 (lab.path / 'queued-before-restart.client.txt').read_text(), 'build queued behind gate')
        # Keep the orphan scope alive across restart, then deliberately lose
        # the queue's group pause. Durable admission must still exclude it.
        timer = lab.prefix + '-reconcile.timer'
        lab.call(['systemctl', '--user', 'stop', timer])
        lab.call(['systemctl', '--user', 'stop', lab.prefix + '-reconcile.service'])
        lab.q('shutdown')
        lab.daemon.wait(timeout=10)
        assert live(evidence['child']) and live(evidence['private'])
        lab.start_daemon()
        lab.q('start', '--group', 'build')
        lab.call(['systemctl', '--user', 'start', timer])
    elif action == 'kill':
        # With the submitter gone too, only the independently installed timer
        # can recover the orphan and release its holds.
        gate.kill()
        gate.wait(timeout=5)
        lab.kill_wrapper('gate')
    elif action == 'queue-kill':
        # This fixture owns the still-running entry and has not reused its ID.
        lab.q('kill', lab.task('gate')['id'])
    lab.released('gate')
    lab.done(gate, -9 if action == 'kill' else (0 if action == 'normal' else 137))
    if action == 'kill':
        assert lab.event('gate', 'release_end')['source'] == '--reconcile'
    for name in ('payload', 'child', 'private'):
        assert not live(evidence[name]), ('surviving descendant', name)
    assert live(int(shared)), 'shared daemon was killed'
    (lab.path / 'shared-after.json').write_text(json.dumps({'pid': shared,
        'cgroup': Path(f'/proc/{shared}/cgroup').read_text(), 'live': live(int(shared))}))
    if action == 'restart':
        lab.done(waiting)
    if action == 'boot':
        wait_for(lambda: lab.state()['installation']['boot'] == 'fixture-next-boot', 'new boot containment probe')
    lab.done(lab.start('progress'))


