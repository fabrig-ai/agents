os.umask(0o077)
KIT = Path(__file__).resolve().parent
HEAVY = KIT / 'heavy'
RESULTS = []
# Patience for fixture admission/completion under load; protocol bounds stay local.
HUNG_HEAVY_S = HUNG_TOOL_S
CHILD_STOP_S = 3  # Cleanup grace before escalating to SIGKILL.


def wait_for(predicate, what, seconds=HUNG_HEAVY_S):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(0.03)
    raise AssertionError('did not reach ' + what)


def fixture_json(path):
    """A fixture writer may have created the file before finishing its JSON."""
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def live(pid):
    try:
        return Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[0] != 'Z'
    except FileNotFoundError:
        return False


def owned_wrapper(owner):
    if not owner or not live(owner['pid']):
        return False
    try:
        fields = Path(f"/proc/{owner['pid']}/stat").read_text().rsplit(')', 1)[1].split()
        return fields[19] == owner['ticks']
    except FileNotFoundError:
        return False


class Lab:
    def __init__(self, root, name):
        self.name, self.path = name, root / name
        self.path.mkdir()
        self.repo = self.path / 'repo'
        self.repo.mkdir()
        (self.path / 'tmp').mkdir()
        self.boot = self.path / 'tmp/boot-id'
        self.boot.write_text(Path('/proc/sys/kernel/random/boot_id').read_text())
        self.faults = self.path / 'tmp/faults'
        self.faults.mkdir()
        self.env = dict(os.environ)
        for key in ('HEAVY_TASK', 'HEAVY_CLASS', 'DEV_ROOT', 'DEV_TMP',
                    'HEAVY_FAULT_DIR', 'HEAVY_BOOT_ID_FILE', 'RUSTC_WRAPPER'):
            self.env.pop(key, None)
        # The old queue daemon is gone; discard its inherited selection.
        for key in tuple(self.env):
            if key.startswith('P' + 'UEUE_'):
                self.env.pop(key)
        self.env.update(DEV_ROOT=str(self.path), DEV_TMP=str(self.path / 'tmp'), LAND_TIDY='',
                        HEAVY_BUILD_SLOTS='2', HEAVY_SETTLE='0', PLAN_MIN_DISK_GB='0', PLAN_LAND_ROOM_GB='0',
                        HEAVY_BOOT_ID_FILE=str(self.boot), HEAVY_FAULT_DIR=str(self.faults), HEAVY_RECOVERY_FIXTURE='1')
        cache_bin = self.path / 'fixture-bin'
        cache_bin.mkdir()
        self.available = self.path / 'tmp/available-gb'
        self.available.write_text('100')
        self.env['HEAVY_DISK_FREE_FILE'] = str(self.available)
        df = cache_bin / 'df'
        df.write_text('#!/bin/sh\nprintf "Avail\\n%sG\\n" "$(cat ' + shlex.quote(str(self.available)) + ')"\n')
        df.chmod(0o700)
        cache = cache_bin / 'kache'
        cache.write_text('#!/usr/bin/env python3\nimport os,sys\nfrom pathlib import Path\n'
                         'assert sys.argv[1:] == ["gc"]\n'
                         'with Path(os.environ["HEAVY_FIXTURE_GC_LOG"]).open("a") as out: out.write("gc\\n")\n')
        cache.chmod(0o700)
        self.env['PATH'] = str(cache_bin) + ':' + self.env['PATH']
        self.env['HEAVY_FIXTURE_GC_LOG'] = str(self.path / 'cache-gc-stub.txt')
        runtime = cache_bin / 'chromium-147-fixture'
        runtime.write_text('#!/bin/sh\necho "Chromium 147.0.7727.101"\n')
        runtime.chmod(0o700)
        fonts = self.path / 'fonts'
        fonts.mkdir()
        (fonts / 'DejaVuSans.ttf').write_bytes(b'fixture-font')
        self.env.update(SKEIN_TEST_CHROMIUM=str(runtime), SKEIN_TEST_FONTS=str(fonts))
        self.env.pop('SKEIN_GATE_POLICY_ID', None)
        self.env.pop('SKEIN_GATE_POLICY_HELPER', None)
        self.base = self.path / 'tmp/heavy'
        self.prefix = 'skein-heavy-' + hashlib.sha256(str(self.base).encode()).hexdigest()[:12]
        self.clients = []
        self.extra_units = []
        self.installed = False
        self.started = time.monotonic()
        self.number = 0
        self.retired_tasks = {}

    def call(self, args, check=True, environment=None, cwd=None, **kw):
        result = subprocess.run([str(x) for x in args], env=environment or self.env, cwd=cwd or self.repo,
                                stdin=subprocess.DEVNULL, capture_output=True, text=True, **kw)
        if check and result.returncode:
            raise AssertionError(str(args[:2]) + ': ' + result.stdout + result.stderr)
        return result

    def hold(self, lane):
        self.call([HEAVY, '--maintenance-pause', lane])

    def unhold(self, lane):
        self.call([HEAVY, '--maintenance-resume', lane])

    def held(self, lane):
        result = self.call([HEAVY, '--group-held', lane], check=False)
        assert result.returncode in (0, 1), result.stderr
        return result.returncode == 0

    def waiting(self, label):
        return self.await_state(label, 'waiting')

    def queued(self, label):
        return self.await_state(label, 'queued')

    def await_state(self, label, state):
        return wait_for(lambda: (task if (task := self.task(label)) and task['state'] == state and
                        'queued task' in (self.path / (label + '.client.txt')).read_text() else None),
                        label + ' ' + state)

    def wrapper_unit(self, label):
        return self.task(label)['wrapper_unit']

    def setup(self):
        self.call(['git', 'init', '-q', '-b', 'main'])
        self.call(['git', 'config', 'user.name', 'fixture'])
        self.call(['git', 'config', 'user.email', 'fixture@localhost'])
        self.call(['git', '-c', 'user.name=fixture', '-c', 'user.email=fixture@localhost',
                   'commit', '-q', '--allow-empty', '-m', 'Recovery fixture'])
        install = self.call([HEAVY, '--install-reconciler', '0.2s'])
        (self.path / 'installation.txt').write_text(install.stdout + install.stderr)
        self.installed = True

    def state(self):
        return json.loads((self.base / 'state.json').read_text())

    def pueue_era(self, edit=None):
        previous = hashlib.sha256(b'pueue-era fixture').hexdigest()
        with (self.base / 'host.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            data = self.state()
            data['queue'] = previous
            data.pop('next_id', None)
            data['resume_requests'] = []
            for task in data['tasks'].values():
                task['queue'] = previous
                self.extra_units.append(task.pop('wrapper_unit'))
                if task['lane'] == 'gate':
                    task.update(resume=[], initially_paused=[])
            if edit:
                edit(data)
            temporary = self.base / 'state.json.fixture-new'
            temporary.write_text(json.dumps(data) + '\n')
            temporary.replace(self.base / 'state.json')
        return data

    def free(self, gb):
        temporary = self.available.with_suffix('.new')
        temporary.write_text(str(gb))
        temporary.replace(self.available)

    def age(self, label, seconds, changed_boot=False):
        with (self.base / 'host.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            data = self.state()
            task = next(task for task in data['tasks'].values() if task['label'] == label)
            for key in ('submitted', 'payload_started', 'payload_ended', 'ended', 'disk_wait'):
                if key in task:
                    task[key] -= seconds
            if changed_boot:
                # Stop only while we own the lock, so the timer can recover it.
                os.kill(task['wrapper']['pid'], signal.SIGSTOP)
                self.boot.write_text('fixture-next-boot\n')
            temporary = self.base / 'state.json.fixture-new'
            temporary.write_text(json.dumps(data) + '\n')
            temporary.replace(self.base / 'state.json')

    def events(self):
        # A concurrent append can expose its last line before its newline.
        return [json.loads(line) for line in (self.base / 'events.jsonl').read_bytes().splitlines(keepends=True)
                if line.endswith(b'\n')]

    def event(self, label, name):
        return next((event for event in self.events() if event.get('label') == label and event['event'] == name), None)

    def task(self, label):
        return next((task for task in self.state()['tasks'].values() if task['label'] == label), None)

    def start(self, label, gate=False, code=None, duration=0.15, args=None, land=False):
        if args is None:
            args = [sys.executable, '-c', code or f'import time; time.sleep({duration})']
        env = dict(self.env, HEAVY_LABEL=label)
        # Only fixture-owned input variables are examined by the payload.
        env['FIXTURE_TOKEN'] = 'must-be-omitted'
        out = (self.path / (label + '.client.txt')).open('w')
        flags = ['--gate'] if gate else ['--land'] if land else []
        child = subprocess.Popen([str(HEAVY), *flags, '--', *args],
                    env=env, cwd=self.repo, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
        out.close()
        self.clients.append(child)
        return child

    def done(self, client, expected=0):
        code = client.wait(timeout=HUNG_HEAVY_S)
        assert code == expected, (code, expected, self.path)

    def released(self, label):
        def complete():
            task = self.task(label)
            # The snapshot's outbox precedes its journal. Completion follows
            # release_end there; neither is promised by the snapshot alone.
            return task if task and task['state'] == 'released' and self.event(label, 'task_completion') else None
        return wait_for(complete, label + ' release and journal')

    def arm(self, point):
        (self.faults / ('arm-' + point)).touch()

    def barrier(self, point, label):
        token = wait_for(lambda: self.task(label), label + ' token')['token']
        path = self.faults / (token + '-' + point)
        return wait_for(lambda: int(text) if path.exists() and (text := path.read_text()) else None,
                        point + ' barrier PID')

    def disarm(self, point):
        (self.faults / ('arm-' + point)).unlink(missing_ok=True)
        (self.faults / ('continue-' + point)).touch()

    def kill_wrapper(self, label):
        task = wait_for(lambda: self.task(label) if self.task(label).get('wrapper') else None, label + ' wrapper')
        os.kill(task['wrapper']['pid'], signal.SIGKILL)

    def verify(self, retired_tasks=None):
        events = self.events()
        current = self.state()['tasks']
        tasks = {**(retired_tasks or {}), **current}
        cgroup_proofs = []
        ids = [event['id'] for event in events]
        assert len(ids) == len(set(ids)), 'duplicate durable event IDs'
        submitted = [e['token'] for e in events if e['event'] == 'submit']
        assert set(submitted) == tasks.keys(), 'submitted tasks missing from retained ledgers'
        numbers = [int(current[token]['id']) for token in submitted if token in current]
        assert numbers == sorted(set(numbers)), ('task numbers not unique and increasing', numbers)
        assert self.state()['next_id'] > max(numbers, default=0)
        active = {}
        for event in events:
            name, token = event['event'], event['token']
            if name == 'scope_enter':
                # Only an exclusive gate runs alone; a landing's gate runs
                # beside builds, and builds beside it.
                lane = 'exclusive' if event.get('exclusive', event['lane'] == 'gate') else event['lane']
                if lane == 'exclusive':
                    assert not active, ('exclusive gate overlaps live scope', active)
                else:
                    assert 'exclusive' not in active.values(), ('scope overlaps exclusive gate', active)
                    assert lane != 'gate' or 'gate' not in active.values(), ('landing gates overlap', active)
                    assert (not int(self.env['HEAVY_BUILD_SLOTS']) or lane != 'build' or
                            list(active.values()).count('build') < int(self.env['HEAVY_BUILD_SLOTS'])), \
                        ("more builds than the lab permits", active)
                active[token] = lane
            elif name == 'release_end':
                active.pop(token, None)
        assert not active, active
        for task in tasks.values():
            assert task['state'] == 'released', task
            assert sum(e['id'] == task['token'] + ':release_end' for e in events) == 1
            assert sum(e['id'] == task['token'] + ':task_completion' for e in events) == 1
            receipt_path = self.base / 'receipts' / (task['token'] + '.json')
            receipt = wait_for(lambda: json.loads(receipt_path.read_text()) if receipt_path.exists() else None,
                               'durable receipt')
            assert len(receipt.keys() - {'head', 'inputs'}) == 17 and receipt['schema'] == 'heavy-receipt-v1'
            for key in ('head', 'inputs'):
                assert receipt.get(key) == task.get(key)
            assert receipt['token'] == task['token'] and receipt['tree'] == task['tree']
            assert receipt['policy'] == task['policy'] and receipt['code'] == task['code']
            assert receipt['release_complete'] and receipt['cgroup_empty']
            if task.get('payload_started') and task.get('payload_ended'):
                assert abs(receipt['elapsed_s'] - (task['payload_ended'] - task['payload_started'])) < 0.000001
                assert receipt['elapsed_s'] < task['ended'] - task['submitted'], 'gate duration includes queue/cleanup time'
            else:
                assert receipt['elapsed_s'] == 0
            assert receipt['log_sha256'] == hashlib.sha256(Path(task['log']).read_bytes()).hexdigest()
            assert receipt_path.stat().st_mode & 0o777 == 0o600
            assert Path(task['log']).stat().st_mode & 0o777 == 0o600
            if receipt['code'] == 0:
                assert receipt['outcome'] == 'completed' and receipt['payload_started'] and receipt['payload_ended']
            if task.get('cgroup'):
                path = Path('/sys/fs/cgroup') / task['cgroup'].lstrip('/') / 'cgroup.events'
                evidence = path.read_text() if path.exists() else 'cgroup absent'
                assert evidence == 'cgroup absent' or 'populated 0' in evidence, task['cgroup']
                cgroup_proofs.append({'token': task['token'], 'unit': task['unit'],
                                      'cgroup': task['cgroup'], 'evidence': evidence, 'verified_empty': True})
        (self.path / 'cgroup-proof.json').write_text(json.dumps(cgroup_proofs, indent=2) + '\n')
        rows = (self.path / 'tmp/logs/heavy.tsv').read_text().splitlines()
        assert len(rows) == len(tasks)
        assert all(len(row.split('\t')) == 11 for row in rows)
        assert len({row.split('\t')[8] for row in rows}) == len(rows)
        for path in [self.base / 'state.json', self.base / 'events.jsonl', self.path / 'tmp/logs/heavy.tsv']:
            assert path.stat().st_mode & 0o777 == 0o600, path
        assert 'must-be-omitted' not in (self.base / 'events.jsonl').read_text()
        for _ in range(3):
            self.call([HEAVY, '--reconcile'])
        assert len(self.events()) == len(events), 'repeated reconcile adds outcomes'
        return {'events': len(events), 'bytes': (self.base / 'events.jsonl').stat().st_size,
                'tasks': len(self.state()['tasks'])}

    def cleanup(self):
        (self.path / 'guard-ended').touch()
        # Kill only this fixture's recorded wrapper identities and unit names.
        for injection in self.faults.glob('enospc-*'):
            injection.unlink()
        for point in self.faults.glob('arm-*'):
            self.disarm(point.name.removeprefix('arm-'))
        if (self.base / 'state.json').exists():
            for task in self.state()['tasks'].values():
                if task['state'] != 'released' and owned_wrapper(task.get('wrapper')):
                    os.kill(task['wrapper']['pid'], signal.SIGKILL)
                for unit in (task['unit'], task.get('wrapper_unit')):
                    if unit:
                        self.call(['systemctl', '--user', 'stop', unit], check=False)
            for _ in range(4):
                self.call([HEAVY, '--reconcile'], check=False)
                time.sleep(0.1)
        for child in self.clients:
            if child.poll() is None:
                child.terminate()
            try:
                child.wait(timeout=CHILD_STOP_S)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
        if self.installed:
            removed = self.call([HEAVY, '--remove-reconciler'], check=False)
            if removed.returncode:
                # Even a failing case must leave no fixture timer or scope.
                self.call(['systemctl', '--user', 'disable', '--now', self.prefix + '-reconcile.timer'], check=False)
                self.call(['systemctl', '--user', 'stop', self.prefix + '-reconcile.service'], check=False)
                units = Path(self.state()['installation']['units'])
                for suffix in ('.service', '.timer'):
                    (units / (self.prefix + '-reconcile' + suffix)).unlink(missing_ok=True)
                self.call(['systemctl', '--user', 'daemon-reload'], check=False)
        scope_proofs = []
        if (self.base / 'state.json').exists():
            for task in self.state()['tasks'].values():
                if owned_wrapper(task.get('wrapper')):
                    os.kill(task['wrapper']['pid'], signal.SIGKILL)
                for unit in (task['unit'], task.get('wrapper_unit')):
                    if unit:
                        self.call(['systemctl', '--user', 'kill', '--kill-whom=all', '--signal=KILL', unit], check=False)
                        self.call(['systemctl', '--user', 'stop', unit], check=False)
                group = task.get('cgroup')
                path = Path('/sys/fs/cgroup') / group.lstrip('/') / 'cgroup.events' if group else None
                empty = not path or not path.exists() or 'populated 0' in path.read_text()
                assert empty, ('cleanup left populated cgroup', task['unit'])
                scope_proofs.append({'unit': task['unit'], 'empty': empty})
        for unit in self.extra_units:
            self.call(['systemctl', '--user', 'stop', unit], check=False)
        for private_env in self.base.glob('*.env'):
            private_env.unlink()
        owned = self.call(['systemctl', '--user', 'list-units', '--all', '--plain', '--no-legend',
                          self.prefix + '*'], check=False).stdout
        # Inactive/failed unit records carry no processes; reset only our names.
        self.call(['systemctl', '--user', 'reset-failed', self.prefix + '*'], check=False)
        units = Path(self.env.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'systemd/user'
        remaining_files = [str(units / (self.prefix + '-reconcile' + suffix))
                           for suffix in ('.service', '.timer')
                           if (units / (self.prefix + '-reconcile' + suffix)).exists()]
        live_wrappers = [task['wrapper']['pid'] for task in self.state()['tasks'].values()
                         if owned_wrapper(task.get('wrapper'))] if (self.base / 'state.json').exists() else []
        (self.path / 'cleanup.json').write_text(json.dumps({
            'owned_unit_listing': owned, 'prefix': self.prefix, 'retained': str(self.path),
            'scope_proofs': scope_proofs, 'live_wrappers': live_wrappers,
            'unit_files_remaining': remaining_files,
            'private_environment_files_removed': not list(self.base.glob('*.env'))}, indent=2) + '\n')
        assert not remaining_files and not live_wrappers


# The unit still owns the real guard and its real ledger; only its parent is
# replaced. Never let a failed adoption send this fixture's signal to systemd.
PAYLOAD_MANAGER = r'''import ctypes, json, os, signal, subprocess, sys, time
from pathlib import Path
kit = Path(__file__).resolve().parent
log = Path(os.environ['DEV_ROOT']) / 'manager.jsonl'
def record(**row):
    with log.open('a') as out:
        out.write(json.dumps(row) + '\n')
assert ctypes.CDLL(None).prctl(36, 1, 0, 0, 0) == 0
signal.signal(signal.SIGTERM, lambda sig, frame: record(signal=sig))
# Keep the guard alive to reap the sender, even if the signal arrives before
# the sender's exit. This story checks routing; the command supplies its code.
def guard_signals():
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
child = subprocess.Popen([sys.executable, '-B', str(kit / 'heavy-recovery.py'), *sys.argv[1:]],
                         preexec_fn=guard_signals)
record(manager=os.getpid(), guard=child.pid)
while True:
    try:
        pid, status = os.waitpid(-1, 0)
    except ChildProcessError:
        break
    orphan = Path(os.environ['DEV_ROOT']) / 'orphan.json'
    remains = orphan.exists() and Path(f"/proc/{json.loads(orphan.read_text())['pid']}").exists()
    record(pid=pid, code=os.waitstatus_to_exitcode(status), time=time.monotonic(), orphan_remains=remains)
    if pid == child.pid:
        child.returncode = os.waitstatus_to_exitcode(status)
        (Path(os.environ['DEV_ROOT']) / 'guard-ended').touch()
sys.exit(child.returncode if child.returncode >= 0 else 128 - child.returncode)
'''


def payload_manager(lab):
    kit = lab.path / 'kit'
    shutil.copytree(KIT, kit)
    manager = kit / 'payload-manager.py'
    manager.write_text(PAYLOAD_MANAGER)
    heavy = kit / 'heavy'
    text = heavy.read_text().replace('exec python3 -B "$kit/heavy-recovery.py" "$@"',
        'if [[ ${1:-} == --payload ]]; then exec python3 -B "$kit/payload-manager.py" "$@"; fi\n'
        'exec python3 -B "$kit/heavy-recovery.py" "$@"')
    temporary = heavy.with_suffix('.new')
    temporary.write_text(text)
    temporary.chmod(0o700)
    temporary.replace(heavy)
    # Let the stand-in record the guard's natural return before release kills
    # the unit. The real systemctl still supplies every cgroup-empty proof.
    systemctl = lab.path / 'fixture-bin/systemctl'
    real_systemctl = shutil.which('systemctl')
    systemctl.write_text(f'#!{sys.executable}\n' +
        'import os, sys, time\nfrom pathlib import Path\n' +
        f'root=Path({str(lab.path)!r})\n' +
        f'unit_prefix={lab.prefix!r}\n' +
        'if "kill" in sys.argv and "--signal=KILL" in sys.argv and sys.argv[-1].startswith(unit_prefix):\n'
        '    deadline=time.monotonic()+' + str(HUNG_HEAVY_S) + '\n'
        '    while not (root / "guard-ended").exists() and time.monotonic() < deadline: time.sleep(.01)\n' +
        f'os.execv({real_systemctl!r}, [{real_systemctl!r}, *sys.argv[1:]])\n')
    systemctl.chmod(0o700)
    return heavy


def payload_adopts_an_orphan_that_signals_its_parent(lab):
    heavy = payload_manager(lab)
    orphan = lab.path / 'orphan.json'
    code = (f'import json, os, signal, time; from pathlib import Path\n'
            f'path=Path({str(orphan)!r})\n'
            'if os.fork() == 0:\n'
            '    parent=os.getpid()\n'
            '    if os.fork() != 0: os._exit(0)\n'
            '    while os.getppid() == parent: time.sleep(.01)\n'
            '    pid=os.getppid()\n'
            '    temporary=path.with_suffix(".new")\n'
            '    temporary.write_text(json.dumps(dict(pid=os.getpid(), parent=pid)))\n'
            '    temporary.replace(path)\n'
            '    os.kill(pid, signal.SIGTERM)\n'
            '    os._exit(0)\n'
            'os.wait()\n'
            'while not path.exists(): time.sleep(.01)\n'
            'pid=json.loads(path.read_text())["pid"]\n'
            'while Path(f"/proc/{pid}").exists(): time.sleep(.01)\n'
            'raise SystemExit(7)\n')
    result = lab.call([heavy, '--', sys.executable, '-c', code], check=False, timeout=HUNG_HEAVY_S,
                      environment=dict(lab.env, HEAVY_LABEL='adoption'))
    assert result.returncode == 7, result.stdout + result.stderr
    task = lab.released('adoption')
    records = [json.loads(line) for line in (lab.path / 'manager.jsonl').read_text().splitlines()]
    manager = records[0]
    assert fixture_json(orphan)['parent'] == manager['guard'], records
    assert not any('signal' in row or ('pid' in row and row['pid'] != manager['guard']) for row in records), records
    assert task['code'] == 7


def payload_reaps_adopted_before_it_ends(lab):
    heavy = payload_manager(lab)
    orphan = lab.path / 'orphan.json'
    ended = lab.path / 'orphan-ended'
    code = (f'import json, os, time; from pathlib import Path\n'
