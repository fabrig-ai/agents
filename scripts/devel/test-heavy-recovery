def gc_budget(lab):
    # Controlled clock/runner checks arithmetic; other GC cases enforce real time.
    sys.path.insert(0, str(KIT))
    try:
        collect = runpy.run_path(str(KIT / 'heavy-recovery.py'))['gc']
    finally:
        sys.path.pop(0)
    for spent, missing in ((25, False), (60, False), (0, True)):
        now, calls, events = [100.0], [], []
        def runner(args, **kw):
            assert all(kw[k] == subprocess.DEVNULL for k in ('stdin', 'stdout', 'stderr'))
            calls.append(kw['timeout'])
            if len(calls) == 1:
                now[0] += spent
                return SimpleNamespace(returncode=0)
            raise subprocess.TimeoutExpired(args, kw['timeout'])
        with patch.dict(collect.__globals__, time=SimpleNamespace(monotonic=lambda: now[0]),
                shutil=SimpleNamespace(which=lambda name: None if missing else '/fake/kache'),
                subprocess=SimpleNamespace(run=runner, DEVNULL=subprocess.DEVNULL, TimeoutExpired=subprocess.TimeoutExpired),
                phase=lambda token, name, **kw: events.append((name, kw))):
            collect('owned', 3)
        assert calls == ([] if missing else [60.0, 35.0] if spent == 25 else [60.0]), calls
        assert events == [('gc_begin:3', {}), ('gc_end:3', {
            'outcome': 'skipped' if missing else 'timeout',
            'reason': 'client-missing' if missing else 'rpc'})], events
    (lab.path / 'controlled-clock.json').write_text(json.dumps({'rows':'readiness 25 + RPC 35; readiness 60 skips RPC; missing client', 'passed':True})+'\n')
    lab.done(lab.start('progress'))


