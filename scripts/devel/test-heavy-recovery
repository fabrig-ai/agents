def policy_refusal(lab, mode):
    base, head = candidate(lab)
    if mode == 'config':
        lab.env['CARGO_HOME'] = str(lab.path / 'cargo-home')
        Path(lab.env['CARGO_HOME']).mkdir()
    lab.hold('gate')
    marker = lab.path / 'must-not-run'
    land = land_process(lab, 'touch ' + str(marker))
    # Land captures heavy's queued line until completion; observe its ledger.
    task = wait_for(lambda: task if (task := lab.task('land repo')) and task['state'] == 'waiting'
                    else None, 'policy gate waiting')
    if mode == 'runtime':
        runtime = Path(lab.env['SKEIN_TEST_CHROMIUM'])
        runtime.write_text(runtime.read_text() + '# changed runtime content\n')
    elif mode == 'missing':
        Path(lab.env['SKEIN_TEST_CHROMIUM']).unlink()
    elif mode == 'config':
        # This external Cargo home is part of policy, outside the Git tree.
        cargo = lab.path / 'cargo-home'
        # Existing environment retained through the queue points here.
        (cargo / 'config.toml').write_text('[build]\nrustflags=["--cfg=changed"]\n')
    elif mode == 'tree':
        (lab.repo / 'code').write_text('changed while queued\n')
        lab.call(['git', 'commit', '-qam', 'queued tree change'])
        head = lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip()
    lab.unhold('gate')
    lab.done(land, 4)
    task = lab.released('land repo')
    assert task['code'] != 0 and not task.get('payload_started') and not marker.exists()
    assert task['policy'] == next(e['policy'] for e in lab.events() if e.get('token') == task['token'])
    assert lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip() == head
    assert lab.call(['git', 'rev-parse', 'main']).stdout.strip() == base
    assert not (lab.path / 'tmp/gates').exists()
    assert not lab.call(['git', 'log', '-1', '--format=%(trailers:key=Gate-Tree,valueonly)']).stdout.strip()
    (lab.path / 'policy-refusal-proof.json').write_text(json.dumps({
        'mode': mode, 'land_exit': land.returncode, 'payload_started': False,
        'head_unchanged': True, 'main_unchanged': True, 'no_cache_or_trailer': True,
        'submitted_policy_preserved': task['policy'], 'token': task['token']}, indent=2) + '\n')


