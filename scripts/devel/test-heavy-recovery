def land_diagnostic(lab, point, prebuild=False):
    if prebuild:
        (lab.repo / 'Cargo.toml').write_text('# capture prebuild fixture\n')
        lab.call(['git', 'add', 'Cargo.toml'])
        lab.call(['git', 'commit', '-qm', 'prebuild fixture'])
    base, head = candidate(lab)
    proceed = lab.path / 'complete-payload'
    command = 'while test ! -e ' + str(proceed) + '; do sleep .02; done'
    label = 'land repo prebuild' if prebuild else 'land repo'
    output = lab.path / 'land.client.txt'
    environment = dict(lab.env, LAND_PREBUILD=command if prebuild else '')
    with output.open('w') as stream:
        client = subprocess.Popen([str(KIT / 'land'), '--local', '--gate', 'true' if prebuild else command],
            env=environment, cwd=lab.repo, stdin=subprocess.DEVNULL, stdout=stream, stderr=subprocess.STDOUT)
    lab.clients.append(client)
    wait_for(lambda: lab.event(label, 'payload_begin'), 'land payload entered')
    task = lab.task(label)
    token = task['token']
    if not prebuild and point != 'seal':
        assert not lab.held('build')
    # This faults the capture write with a real kernel ENOSPC (/dev/full).
    # Its warning must already reach the waiting caller before that write.
    (lab.faults / 'enospc-land-capture').touch()
    if point == 'missing':
        lab.call(['systemctl', '--user', 'stop', lab.prefix + '-reconcile.timer'])
    else:
        injection = lab.faults / ('enospc-' + point)
        injection.touch()
        proceed.touch()
        wait_for((lab.faults / ('hit-enospc-' + point)).exists, 'land storage failure')
    wait_for(lambda: 'recovery/storage failure' in output.read_text(), 'warning on waiting land caller')
    task = lab.task(label)
    assert client.poll() is None and task['token'] == token
    assert not (lab.base / 'receipts' / (token + '.json')).exists()
    assert task.get('outcome') != 'cancelled'
    if point == 'missing':
        assert owned_wrapper(task['wrapper']) and task['state'] == 'active'
    elif not prebuild and point != 'seal':
        # A landing's gate holds nothing: the builds go on beside it.
        assert lab.state()['gate'] is None
    assert lab.call(['git', 'rev-parse', 'main']).stdout.strip() == base
    assert not (lab.path / 'tmp/gates').exists()
    if point == 'missing':
        lab.call(['systemctl', '--user', 'start', lab.prefix + '-reconcile.timer'])
        proceed.touch()
    else:
        injection.unlink()
        lab.call(['systemctl', '--user', 'reset-failed', lab.prefix + '-reconcile.service'])
        lab.call(['systemctl', '--user', 'start', lab.prefix + '-reconcile.service'])
    lab.call([HEAVY, '--reconcile'])
    lab.released(label)
    # Capture failure refuses the landing even after durable same-ledger recovery.
    lab.done(client, 4)
    assert 'capture could not be written' in output.read_text()
    assert lab.call(['git', 'rev-parse', 'main']).stdout.strip() == base
    assert lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip() == head
    assert not (lab.path / 'tmp/gates').exists()
    (lab.faults / 'enospc-land-capture').unlink()
    lab.done(lab.start('progress'))
    (lab.path / 'land-diagnostic-proof.json').write_text(json.dumps({
        'path': 'prebuild' if prebuild else 'gate', 'fault': point,
        'warning_seen_before_restore': True, 'caller_waiting_at_warning': True,
        'kernel_capture_enospc': True, 'no_receipt_during_failure': True,
        'same_queue_ledger_service_restored': True, 'no_false_green': True,
        'land_exit': client.returncode}, indent=2) + '\n')


