def overhead(lab, real_policy=False):
    samples = []
    payload = [sys.executable, '-c', 'import time; time.sleep(.15)']
    if real_policy:
        lab.env.update(SKEIN_TEST_CHROMIUM=str(Path.home() / '.local/opt/chromium-147.0.7727.101/bin/chromium'),
                       SKEIN_TEST_FONTS='/usr/share/fonts/truetype/dejavu')
    def measure(args, name, environment):
        with (lab.path / (name + '.output')).open('w') as out:
            start = time.monotonic_ns()
            child = subprocess.Popen([str(arg) for arg in args], cwd=lab.repo, env=environment,
                                     stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
            _, status, usage = os.wait4(child.pid, 0)
            child.returncode = os.waitstatus_to_exitcode(status)
            elapsed = (time.monotonic_ns() - start) / 1e6
        assert child.returncode == 0, (name, child.returncode)
        return elapsed, {'user_s': usage.ru_utime, 'system_s': usage.ru_stime,
                         'maxrss_kib': usage.ru_maxrss}
    for i in range(3):
        # Same command, alternating raw then queued execution.
        before_tasks = len(lab.state()['tasks'])
        before = len(lab.events())
        size = (lab.base / 'events.jsonl').stat().st_size
        direct, direct_metrics = measure(payload, 'direct-' + str(i), lab.env)
        # The timer/queue execute outside this client's process ancestry.
        queued, metrics = measure([HEAVY, *(['--gate'] if real_policy else []), '--', *payload],
                                  'heavy-' + str(i), dict(lab.env, HEAVY_LABEL='sample-' + str(i)))
        samples.append({'tasks': len(lab.state()['tasks']) - before_tasks,
                        'event_count': len(lab.events()) - before,
                        'event_bytes': (lab.base / 'events.jsonl').stat().st_size - size,
                        'direct_resources': direct_metrics, 'client_resources': metrics,
                        'scope_resources': lab.task('sample-' + str(i)).get('resources'),
                        'direct_ms': direct, 'heavy_ms': queued, 'overhead_ms': queued - direct})
    retained = sum(path.stat().st_size for path in (lab.path / 'tmp').rglob('*') if path.is_file())
    data = {'samples': samples, 'median_overhead_ms': statistics.median(s['overhead_ms'] for s in samples),
            'real_policy': real_policy, 'host': os.uname().nodename, 'loadavg': os.getloadavg(),
            'retained_tmp_bytes': retained, 'cpu_scope': 'client ancestry plus separately sampled owned cgroup',
            'payload': payload, 'background': 'normal host services; only owned disposable queues used'}
    (lab.path / 'overhead.json').write_text(json.dumps(data, indent=2) + '\n')


