def gc_clients(lab, plans):
    # Fake only optional service readiness and RPC; all other systemctl is real.
    real = shutil.which('systemctl')
    common = ('import json,os,sys,time\nfrom pathlib import Path\n'
              'root=Path(' + repr(str(lab.path)) + ')\n')
    action = ('label=os.environ.get("HEAVY_LABEL", "")\n'
              'plan=' + repr(plans) + '.get(label, {}).get(stage, {})\n'
              '(root/("gc-client-"+str(os.getpid())+".json")).write_text(json.dumps('
              '{"pid":os.getpid(),"stage":stage,"label":label,"start":time.monotonic()}))\n'
              'print("discard-optional-output", flush=True)\n'
              'time.sleep(plan.get("delay", 0))\nsys.exit(plan.get("code", 0))\n')
    cache = lab.path / 'fixture-bin/kache'
    cache.write_text('#!/usr/bin/env python3\n' + common + 'assert sys.argv[1:]==["gc"]\nstage="rpc"\n' + action)
    control = lab.path / 'fixture-bin/systemctl'
    control.write_text('#!/usr/bin/env python3\n' + common +
        'if "kache.service" not in sys.argv: os.execv(' + repr(real) + ', [' + repr(real) + ']+sys.argv[1:])\n'
        'assert sys.argv[1:]==["--user","is-active","--quiet","kache.service"]\nstage="readiness"\n' + action)
    control.chmod(0o700)
    lab.env.update(RUSTC_WRAPPER='', RUSTC_WORKSPACE_WRAPPER='')


def gc_expired(lab, label, serial=0):
    before = time.monotonic()
    end = wait_for(lambda: lab.event(label, 'gc_end:' + str(serial)), 'GC expiry')
    assert (end['outcome'], end['reason']) == ('timeout', 'rpc'), end
    begin = lab.event(label, 'gc_begin:' + str(serial))
    span = (end['time_ns'] - begin['time_ns']) / 1e9
    assert 59 <= span < 70, span
    clients = [json.loads(p.read_text()) for p in lab.path.glob('gc-client-*.json')]
    assert all(not live(c['pid']) for c in clients if c['label'] == label)
    with (lab.path / 'gc-expiries.jsonl').open('a') as out:
        out.write(json.dumps({'label':label, 'serial':serial, 'phase_wall_s':span,
                             'observed_wait_monotonic_s':time.monotonic()-before, 'clients':clients})+'\n')


