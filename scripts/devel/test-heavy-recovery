#!/usr/bin/env python3
"""Fault the production heavy entrypoints against disposable state directories and units.
No queue daemon is needed.

No global queue/cache mutations, task-record APIs, or environment dumps.
Raw evidence is retained in --evidence (a new directory).
"""
