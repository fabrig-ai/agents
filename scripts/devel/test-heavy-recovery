def land_disk_floor(lab, mode='refused', machine=False, saved=None):
    # Real land/heavy, with the Lab's disposable units, ledger and free space.
    lab.env.pop('PLAN_MIN_DISK_GB')
    lab.env['PLAN_LAND_ROOM_GB'] = '30'
    if machine or saved is not None:
        (lab.path / 'tmp/machine.env').write_text(f'PLAN_MIN_DISK_GB={saved or 60}\n')
    (lab.repo / 'Cargo.toml').write_text('# disk floor prebuild fixture\n')
    lab.call(['git', 'add', 'Cargo.toml'])
    lab.call(['git', 'commit', '-qm', 'prebuild fixture'])
    base, head = candidate(lab)
    prebuilt, gated = lab.path / 'prebuilt', lab.path / 'gated'
    command = 'touch ' + shlex.quote(str(prebuilt))
    gate = mode == 'gate'
    label = 'land repo' if gate else 'land repo prebuild'
    if mode == 'payload':
        lab.arm('payload_floor')
    else:
        lab.free(5)
    output = lab.path / 'land.client.txt'
    with output.open('w') as stream:
        client = subprocess.Popen([str(KIT / 'land'), '--local', '--gate', 'touch ' + shlex.quote(str(gated))],
            env=dict(lab.env, LAND_PREBUILD='' if gate else command), cwd=lab.repo,
            stdin=subprocess.DEVNULL, stdout=stream, stderr=subprocess.STDOUT)
    lab.clients.append(client)
    if mode == 'payload':
        lab.barrier('payload_floor', label)
        assert lab.event(label, 'admit') and not lab.task(label).get('payload_started')
        if saved is not None:
            assert lab.task(label)['floor_gb'] == saved
            (lab.path / 'tmp/machine.env').write_text(f'PLAN_MIN_DISK_GB={40 if saved == 60 else 60}\n')
        lab.free(45 if saved is not None else 5)
        lab.disarm('payload_floor')
    else:
        wait_for(lambda: (task := lab.task(label)) and task.get('disk_wait'), 'landing queued below floor')
        assert client.poll() is None and not lab.task(label).get('payload_started')
        lab.age(label, 1201)
    if saved == 40:
        wait_for(prebuilt.exists, 'prebuild uses its saved lower floor')
        lab.free(100)
        lab.done(client)
        task = lab.released(label)
        assert task['code'] == 0 and task['outcome'] == 'completed'
        assert lab.event(label, 'payload_begin') and gated.exists()
        return
    lab.done(client, 9)
    assert not prebuilt.exists(), 'below-floor prebuild ran'
    assert not gated.exists(), 'below-floor gate ran'
    text = output.read_text()
    floor = saved or (60 if machine else 40)
    free = 45 if saved is not None else 5
    assert f'{free} GB free on {lab.path}, below the disk floor of {floor} GB (as submitted)' in text, text
    assert 'heavy: disk floor refused before payload start' in text, text
    assert lab.call(['git', 'rev-parse', 'main']).stdout.strip() == base
    assert lab.call(['git', 'rev-parse', 'HEAD']).stdout.strip() == head
    assert not (lab.path / 'tmp/gates').exists()
    task = lab.task(label)
    assert task['code'] == 2 and task['outcome'] == 'refused'
    assert not task.get('payload_started') and not task.get('payload_ended')
    assert task['refusal'] == 'disk floor refused before payload start'
    if mode != 'payload':
        assert task.get('disk_wait') and not lab.event(label, 'admit')
        assert lab.event(label, 'release_begin')['outcome'] == 'refused'
        assert lab.event(label, 'refusal')['reason'] == 'disk-floor'
    receipt = lab.base / 'receipts' / (task['token'] + '.json')
    assert receipt.is_file() and json.loads(receipt.read_text())['outcome'] == 'refused'
    lab.free(100)
    lab.done(lab.start('progress'))


