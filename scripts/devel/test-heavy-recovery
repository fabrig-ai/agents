def replay(lab):
    lab.done(lab.start('gate', gate=True))
    events = lab.events()
    state = lab.state()
    # A snapshot outbox survives an append/rename interruption. Replay a
    # durable event, and an incomplete append at each journal's end.
    state['pending'] = [events[-1]]
    (lab.base / 'state.json').write_text(json.dumps(state))
    with (lab.base / 'events.jsonl').open('ab') as out:
        out.write(b'{"interrupted":')
    with (lab.path / 'tmp/logs/heavy.tsv').open('ab') as out:
        out.write(b'interrupted\trow')
    lab.call([HEAVY, '--reconcile'])
    assert lab.events() == events


def late_launch(lab, release_crash=False):
    # The real systemd-run client is delayed before StartTransientUnit. The
    # wrapper dies and recovery releases first. The late unit cannot payload.
    policy_marker, helper_marker = lab.path / 'policy-executed', lab.path / 'policy-child'
    if release_crash:
        runtime = Path(lab.env['SKEIN_TEST_CHROMIUM'])
        helper = ('from pathlib import Path; import time; Path(' + repr(str(helper_marker)) +
                  ').write_text("child"); time.sleep(120)')
        runtime.write_text('#!/usr/bin/env python3\nimport os,subprocess\nfrom pathlib import Path\n'
            'if os.environ.get("HEAVY_TASK"):\n'
            '    Path(' + repr(str(policy_marker)) + ').write_text("preflight")\n'
            '    subprocess.Popen([' + repr(sys.executable) + ', "-c", ' + repr(helper) + '], '
            'stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)\n'
            'print("Chromium 147.0.7727.101")\n')
        lab.arm('release_saved')
    shim = lab.path / 'bin'
    shim.mkdir()
    real = lab.call(['which', 'systemd-run']).stdout.strip()
    marker, proceed = lab.path / 'launch-waiting', lab.path / 'launch-continue'
    # The delayed request belongs to an independent fixture unit: losing the
    # production wrapper must not kill it before the late creation attempt.
    delayed_unit = lab.prefix + '-late-launcher.service'
    lab.extra_units.append(delayed_unit)
    attempted, completed = lab.path / 'launch-attempted', lab.path / 'launch-completed'
    delayed = lab.path / 'delayed-launch.py'
    delayed.write_text('import json,os,subprocess,sys,time\nfrom pathlib import Path\n'
        'Path(' + repr(str(marker)) + ').write_text(str(os.getpid()))\n'
        'while not Path(' + repr(str(proceed)) + ').exists(): time.sleep(.02)\n'
        'Path(' + repr(str(attempted)) + ').write_text(str(time.time_ns()))\n'
        'result=subprocess.run([' + repr(real) + ']+sys.argv[1:])\n'
        'Path(' + repr(str(completed)) + ').write_text(json.dumps({"code":result.returncode}))\n')
    script = shim / 'systemd-run'
    script.write_text('#!/usr/bin/env python3\nimport os,sys\n'
        'if "--payload" not in sys.argv: os.execv(' + repr(real) + ', [' + repr(real) + '] + sys.argv[1:])\n'
        'os.execv(' + repr(real) + ', [' + repr(real) + ', "--user", "--quiet", "--wait", "--collect", '
        '"--unit=' + delayed_unit + '", ' + repr(sys.executable) + ', ' + repr(str(delayed)) + '] + sys.argv[1:])\n')
    script.chmod(0o700)
    lab.env['PATH'] = str(shim) + ':' + lab.env['PATH']
    marker_payload = lab.path / 'must-not-run'
    gate = lab.start('gate', gate=True, args=['touch', str(marker_payload)])
    wait_for(lambda: int(text) if marker.exists() and (text := marker.read_text()) else None,
             'deferred scope launcher PID')
    lab.kill_wrapper('gate')
    if release_crash:
        reconciler = lab.barrier('release_saved', 'gate')
        assert lab.task('gate')['state'] == 'released'
        lab.call(['systemctl', '--user', 'stop', lab.prefix + '-reconcile.timer'])
        os.kill(reconciler, signal.SIGKILL)
        lab.disarm('release_saved')
        task = lab.task('gate')
        transport = lab.base / (task['token'] + '.env')
        assert transport.exists(), 'crash must retain the delayed launch environment'
    else:
        lab.released('gate')
    assert live(int(marker.read_text())), 'fixture lost its delayed request with the wrapper'
    proceed.touch()
    completion = wait_for(lambda: fixture_json(completed), 'late creation result JSON')
    assert int(attempted.read_text()) > lab.event('gate', 'release_end')['time_ns']
    assert completion['code'] != 0
    wait_for(lambda: not live(int(marker.read_text())), 'late launcher ended')
    if release_crash:
        assert not policy_marker.exists() and not helper_marker.exists(), 'late launch executed policy tools'
        properties = lab.call(['systemctl', '--user', 'show', task['unit'],
                              '--property=ControlGroup,ActiveState,LoadState']).stdout
        group = next((line.split('=', 1)[1] for line in properties.splitlines() if line.startswith('ControlGroup=')), '')
        cg = Path('/sys/fs/cgroup') / group.lstrip('/') if group else None
        empty = not cg or not cg.exists() or 'populated 0' in (cg / 'cgroup.events').read_text()
        assert empty, 'late cgroup populated'
        assert transport.exists(), 'cleanup was not deferred across the crash'
        lab.call([HEAVY, '--reconcile'])
        assert not transport.exists(), 'released transport cleanup was not replayed'
        receipt_path = lab.base / 'receipts' / (task['token'] + '.json')
        receipt_before = receipt_path.read_bytes()
        lab.call([HEAVY, '--reconcile'])
        assert receipt_path.read_bytes() == receipt_before, 'sealed receipt changed'
        lab.call(['systemctl', '--user', 'reset-failed', lab.prefix + '-reconcile.service'])
        lab.call(['systemctl', '--user', 'start', lab.prefix + '-reconcile.timer'])
        (lab.path / 'late-launch-proof.json').write_text(json.dumps({
            'retained_env_used': True, 'pre_guard_policy_executed': False, 'detached_child_created': False,
            'late_cgroup_empty': empty, 'unit_properties': properties, 'transport_cleanup_replayed': True,
            'sealed_receipt_immutable': True}, indent=2) + '\n')
    assert not marker_payload.exists(), 'late creation ran payload'
    lab.done(gate, 137)
    lab.env['PATH'] = lab.env['PATH'].split(':', 1)[1]
    lab.done(lab.start('progress'))


