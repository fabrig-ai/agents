            destination.parent.mkdir(parents=True, exist_ok=True)
            self.assertFalse(destination.exists())
            # Execute below /tmp so host ancestor Cargo configs cannot mask
            # the fixture's own config. Retain the complete execution directory.
            def retain():
                (self.root / "execution-root.txt").write_text(str(self.root) + "\n")
                def retain_file(source, target):
                    mode = stat.S_IMODE(os.stat(source, follow_symlinks=False).st_mode)
                    if stat.S_ISFIFO(os.stat(source, follow_symlinks=False).st_mode):
                        os.mkfifo(target, mode)
                        return target
                    # Cross-filesystem retention must preserve deliberately
                    # unreadable receipts/logs and their modes after assertions.
                    try:
                        os.chmod(source, mode | stat.S_IRUSR)
                        shutil.copy2(source, target)
                    finally:
                        os.chmod(source, mode)
                        if Path(target).exists():
                            os.chmod(target, mode)
                    return target
                shutil.move(str(self.root), destination, copy_function=retain_file)
            self.addCleanup(retain)
