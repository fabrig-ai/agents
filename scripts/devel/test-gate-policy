    def test_mutation_after_last_check_cannot_change_explicit_push_object(self):
        original_tree = self.git("rev-parse", "HEAD^{tree}").strip()
        self.git("update-ref", "refs/remotes/origin/main", self.base)
        real_git = shutil.which("git", path=os.defpath)
        proof = self.root / "explicit-push.json"
        self.script(self.bin / "git", "#!/usr/bin/env python3\n" +
            "import json,subprocess,sys,os\nfrom pathlib import Path\n" +
            "real=" + repr(real_git) + "\n" +
            "if sys.argv[1] == 'fetch': sys.exit(0)\n" +
            "if sys.argv[1] == 'push':\n" +
            "    selected=sys.argv[-1].split(':')[0]\n" +
            "    Path('code').write_text('uncooperative late B\\n')\n" +
            "    subprocess.run([real,'add','code'],check=True)\n" +
            "    subprocess.run([real,'commit','-qm','late B'],check=True)\n" +
            "    query=lambda *args: subprocess.check_output([real,*args],text=True).strip()\n" +
            "    Path(" + repr(str(proof)) + ").write_text(json.dumps({'args':sys.argv[1:], 'commit':selected, " +
            "'tree':query('rev-parse',selected+'^{tree}'),'candidate_B':query('rev-parse','HEAD')}))\n" +
            "    sys.exit(0)\n" +
            "os.execv(real,[real]+sys.argv[1:])\n")
        self.run_command([str(self.kit / "land"), "--gate", "true"])
        pushed = json.loads(proof.read_text())
        self.assertEqual(pushed["tree"], original_tree)
        self.assertNotEqual(pushed["commit"], pushed["candidate_B"])
        self.assertEqual(pushed["args"], ["push", "--quiet", "origin", pushed["commit"] + ":refs/heads/main"])
        self.assertEqual(self.git("rev-parse", "main").strip(), pushed["commit"])
        self.assertEqual(self.git("rev-parse", "HEAD").strip(), pushed["candidate_B"])
        self.assertNotEqual(self.git("rev-parse", "HEAD^{tree}").strip(), original_tree)
        self.assertFalse(self.git("log", "-1", "--format=%(trailers:key=Gate-Tree,valueonly)").strip())
        self.assertEqual(self.git("log", "-1", "--format=%(trailers:key=Gate-Tree,valueonly)", pushed["commit"]).strip(), original_tree)

