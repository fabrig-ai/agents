#!/usr/bin/env python3
"""Gate policy and land evidence in disposable local Git repositories."""
import hashlib
import os
from pathlib import Path
import shutil
import shlex
import sys
import subprocess
import tempfile
import unittest

KIT = Path(__file__).resolve().parent


class PolicyFixtures(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix="skein-gate-policy-")
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.home = self.root / "home"
        self.kit = self.root / "kit"
        self.repo = self.root / "repo"
        self.bin = self.root / "bin"
        for path in (self.home, self.kit, self.repo, self.bin):
            path.mkdir()
        self.env = {"PATH": str(self.bin) + ":" + os.defpath, "HOME": str(self.home),
                    "DEV_ROOT": str(self.root), "DEV_TMP": str(self.root / "tmp"),
                    "LAND_PREBUILD": "", "GIT_CONFIG_GLOBAL": os.devnull,
                    "GIT_CONFIG_NOSYSTEM": "1", "FIXTURE_CALLS": str(self.root / "calls")}
        for name in ("land", "gate-policy.sh", "kit.sh"):
            shutil.copy(KIT / name, self.kit / name)
        self.script(self.kit / "heavy", '''#!/usr/bin/env bash
set -eu
lane=build
while (($#)); do
    case $1 in
    --gate) lane=gate; shift ;;
    --tail) shift 2 ;;
    *) break ;;
    esac
done
printf '%s %s %s\n' "$lane" "$SKEIN_TEST_CHROMIUM" "$SKEIN_GATE_POLICY_ID" >>"$FIXTURE_CALLS"
echo 'heavy: queued task 1 in gate'
"$@"
echo 'heavy: ran alone for 0s'
echo 'heavy: task 1 (gate) exit 0, waited 0s, ran 0s'
''')
        for name, version in (("rustc", "rustc 1.fixture"), ("cargo", "cargo 1.fixture"),
                              ("rustdoc", "rustdoc 1.fixture")):
            self.script(self.bin / name, f"#!/bin/sh\nprintf '%s\\n' '{version}'\n")
        self.script(self.bin / "rustup", "#!/bin/sh\nexit 1\n")
        self.runtime = self.home / ".local/opt/chromium-147.0.7727.101/usr/lib/chromium/chromium"
        self.script(self.runtime, "#!/bin/sh\necho 'Chromium 147.0.7727.101'\n")
        self.launcher = self.home / ".local/opt/chromium-147.0.7727.101/bin/chromium"
        self.script(self.launcher, "#!/bin/sh\nexit 92\n")
        # PATH's browser must never enter the kit policy.
        self.script(self.bin / "chromium", "#!/bin/sh\necho 'Chromium 155.0.0.0'\n")
        self.fonts = self.root / "fonts"
        self.fonts.mkdir()
        (self.fonts / "DejaVuSans.ttf").write_bytes(b"fixture font")
        self.env["SKEIN_TEST_FONTS"] = str(self.fonts)
        self.git("init", "-q", "-b", "main")
        self.git("config", "user.email", "fixture@example.test")
        self.git("config", "user.name", "fixture")
        (self.repo / "code").write_text("base\n")
        self.git("add", ".")
        self.git("commit", "-qm", "base")
        self.base = self.git("rev-parse", "HEAD").strip()
        self.git("switch", "-qc", "work")
        (self.repo / "code").write_text("work\n")
        self.git("commit", "-qam", "work")

    def script(self, path, text):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
        path.chmod(0o700)

    def run_command(self, args, check=True, extra=None):
        result = subprocess.run(args, cwd=self.repo, env=self.env | (extra or {}),
                                text=True, capture_output=True, timeout=20)
        if check:
            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        return result

    def git(self, *args):
        return self.run_command(["git", *args]).stdout

    def identity(self, extra=None, check=True):
        return self.run_command(["bash", "-c", 'source "$1"; gate_policy_identity',
                                 "fixture", str(self.kit / "gate-policy.sh")], check, extra)

    def land(self, extra=None, check=True, gate="true"):
        return self.run_command([str(self.kit / "land"), "--local", "--gate", gate], check, extra)

    def retry(self):
        self.git("update-ref", "refs/heads/main", self.base)

    def calls(self):
        path = self.root / "calls"
        return path.read_text().splitlines() if path.exists() else []

    def advance_main_docs(self):
        self.git("switch", "-qc", "docs-main", self.base)
        (self.repo / "docs").mkdir()
        (self.repo / "docs/new.md").write_text("documentation\n")
        self.git("add", "docs")
        self.git("commit", "-qm", "docs")
        self.git("update-ref", "refs/heads/main", self.git("rev-parse", "HEAD").strip())
        self.git("switch", "-q", "work")

    def test_same_policy_reuses_and_propagates_runtime(self):
        self.land()
        policy = self.git("log", "-1", "--format=%(trailers:key=Gate-Policy,valueonly)").strip()
        self.assertRegex(policy, r"^sha256:[0-9a-f]{64}$")
        self.assertIn(str(self.runtime), self.calls()[0])
        self.assertIn(policy, self.calls()[0])
        self.retry()
        self.land()
        self.assertEqual(len(self.calls()), 1)
        cache = next((self.root / "tmp/gates/repo").iterdir())
        self.assertEqual(cache.read_text().splitlines()[:2], ["gate-evidence-v2", policy])
        self.assertEqual(cache.stat().st_mode & 0o777, 0o600)

    def test_docs_only_same_policy_reuses(self):
        self.land()
        before = self.git("rev-parse", "HEAD^{tree}").strip()
        self.advance_main_docs()
        result = self.land()
        self.assertIn("differs from this tree only in docs/ Markdown", result.stderr)
        self.assertEqual(len(self.calls()), 1)
        self.assertEqual(self.git("log", "-1", "--format=%(trailers:key=Gate-Tree,valueonly)").strip(), before)

    def test_docs_only_different_policy_cannot_reuse(self):
        self.land()
        self.advance_main_docs()
        with self.runtime.open("a") as output:
            output.write("# new executable content\n")
        result = self.land()
        self.assertNotIn("differs from this tree only in docs/ Markdown", result.stderr)
        self.assertEqual(len(self.calls()), 2)

    def test_runtime_content_and_path_invalidate(self):
        self.land()
        self.retry()
        with self.runtime.open("a") as output:
            output.write("# content changes at the same version\n")
        self.land()
        self.assertEqual(len(self.calls()), 2)
        self.retry()
        other = self.root / "other147"
        shutil.copy(self.runtime, other)
        self.land({"SKEIN_TEST_CHROMIUM": str(other)})
        self.assertEqual(len(self.calls()), 3)

    def test_wrong_version_refuses_even_with_cached_evidence(self):
        self.land()
        self.retry()
        result = self.land({"SKEIN_TEST_CHROMIUM": str(self.bin / "chromium")}, check=False)
        self.assertEqual(result.returncode, 2)
        self.assertEqual(len(self.calls()), 1)
        self.script(self.runtime, "#!/bin/sh\necho 'Chromium 155.0.0.0'\n")
        self.assertEqual(self.land(check=False).returncode, 2)
        self.assertEqual(len(self.calls()), 1)

    def test_legacy_and_mismatched_records_are_invalid(self):
        self.land()
        cache = next((self.root / "tmp/gates/repo").iterdir())
        for record in ("true passed: legacy\n", "gate-evidence-v2\nsha256:wrong\npassed\n"):
            cache.write_text(record)
            self.retry()
            before = len(self.calls())
            self.land()
            self.assertEqual(len(self.calls()), before + 1)

    def test_legacy_compiler_key_cannot_reuse(self):
        tree = self.git("rev-parse", "HEAD^{tree}").strip()
        cache = self.root / "tmp/gates/repo"
        cache.mkdir(parents=True)
        old_key = hashlib.sha1(f"{tree}\ntrue\nrustc 1.fixture\n".encode()).hexdigest()
        (cache / old_key).write_text("legacy passed\n")
        self.land()
        self.assertEqual(len(self.calls()), 1)

    def test_policy_mutation_during_gate_refuses_evidence(self):
        gate = 'printf "# mutation\\n" >> "$SKEIN_TEST_CHROMIUM"'
        result = self.land(check=False, gate=gate)
        self.assertEqual(result.returncode, 4, result.stdout + result.stderr)
        self.assertIn("gate policy changed", result.stderr)
        self.assertEqual(self.git("rev-parse", "main").strip(), self.base)
        self.assertFalse((self.root / "tmp/gates/repo").exists())

    def test_flags_configs_wrappers_and_fixtures_change_identity(self):
        baseline = self.identity().stdout
        for variable in ("RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS", "CARGO_BUILD_RUSTFLAGS", "RUSTC_BOOTSTRAP", "CARGO_PROFILE_DEV_OPT_LEVEL",
                         "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS", "RUSTUP_TOOLCHAIN"):
            with self.subTest(variable=variable):
                result = self.identity({variable: "private fixture setting"})
                self.assertNotEqual(result.stdout, baseline)
                self.assertNotIn("private fixture setting", result.stdout + result.stderr)
        config = self.home / ".cargo/config.toml"
        config.parent.mkdir()
        wrapper = self.bin / "wrapper"
        self.script(wrapper, "#!/bin/sh\nexit 0\n")
        config.write_text(f'[build]\nrustc-wrapper = "{wrapper}"\nrustflags = ["--cfg=global"]\n')
        configured = self.identity().stdout
        self.assertNotEqual(configured, baseline)
        self.script(wrapper, "#!/bin/sh\nexit 0\n# changed\n")
        self.assertNotEqual(self.identity().stdout, configured)
        # Empty dedicated wrapper variables disable configuration wrappers.
        disabled = self.identity({"RUSTC_WRAPPER": ""}).stdout
        wrapper.unlink()
        self.assertEqual(self.identity({"RUSTC_WRAPPER": ""}).stdout, disabled)
        config.write_text('[build]\nrustflags = ["--cfg=global"]\n')
        (self.repo / ".cargo").mkdir()
        local = self.repo / ".cargo/config.toml"
        local.write_text('[build]\nrustflags = ["--cfg=local"]\n')
        local_id = self.identity().stdout
        local.write_text('[build]\nrustflags = ["--cfg=other"]\n')
        self.assertNotEqual(self.identity().stdout, local_id)
        fixture_id = self.identity().stdout
        (self.fonts / "DejaVuSans.ttf").write_bytes(b"different fixture font")
        self.assertNotEqual(self.identity().stdout, fixture_id)
        resource_id = self.identity().stdout
        (self.runtime.parent / "icudtl.dat").write_bytes(b"browser resource")
        self.assertNotEqual(self.identity().stdout, resource_id)

    def test_config_precedence_and_private_values(self):
        (self.repo / ".cargo").mkdir()
        config = self.repo / ".cargo/config"
        config.write_text('[build]\nrustflags = ["--cfg=selected"]\n[registries.private]\ntoken = "do-not-read-or-print"\n')
        alias = self.repo / ".cargo/config.toml"
        alias.write_text('[build]\nrustc-wrapper = "missing-wrapper"\n')
        baseline = self.identity().stdout
        config.write_text('[build]\nrustflags = ["--cfg=selected"]\n[registries.private]\ntoken = "different-private-value"\n')
        self.assertEqual(self.identity().stdout, baseline)
        config.write_text('malformed = ["private-invalid-config"\n')
        result = self.identity(check=False)
        self.assertEqual(result.returncode, 2)
        self.assertNotIn("private-invalid-config", result.stdout + result.stderr)

    def test_implementation_and_tool_contents_invalidate(self):
        for path in (self.kit / "gate-policy.sh", self.kit / "land", self.kit / "heavy", self.kit / "heavy-recovery.py",
                     self.kit / "kit.sh", self.bin / "rustc", self.bin / "cargo"):
            with self.subTest(path=path.name):
                baseline = self.identity().stdout
                with path.open("a") as output:
                    output.write("\n# implementation change\n")
                self.assertNotEqual(self.identity().stdout, baseline)

    def test_preparation_is_stable_and_identity_is_safe(self):
        result = self.run_command(["bash", "-c", '''source "$1"
gate_policy_prepare || exit
before=$SKEIN_GATE_POLICY_ID
gate_policy_prepare || exit
[[ $before == "$SKEIN_GATE_POLICY_ID" ]] || exit 90
[[ $(gate_policy_identity) == "$before" ]] || exit 91
printf '%s\\n' "$before"
''', "fixture", str(self.kit / "gate-policy.sh")])
        self.assertRegex(result.stdout, r"^sha256:[0-9a-f]{64}\n$")

