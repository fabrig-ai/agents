    def test_markdown_landing_needs_no_runtime(self):
        self.git("reset", "--hard", self.base)
        (self.repo / "README.md").write_text("documentation\n")
        self.git("add", "README.md")
        self.git("commit", "-qm", "docs only")
        self.run_command([str(self.kit / "land"), "--local", "--docs"],
                         extra={"SKEIN_TEST_CHROMIUM": str(self.bin / "chromium")})
        self.assertFalse(self.calls())
        self.assertIn("none (Markdown only)", self.git("log", "-1", "--format=%(trailers:key=Gate-Policy,valueonly)"))

    def test_check_boundary_uses_admission_helper_and_refuses_drift(self):
        script = self.repo / "scripts/check.sh"
        script.parent.mkdir()
        shutil.copy(KIT.parent / "check.sh", script)
        # The checked-out helper can differ from the kit being used to land it.
        self.script(self.repo / "scripts/dev/gate-policy.sh", "#!/bin/sh\nexit 91\n")
        self.script(self.bin / "python3", f'''#!/bin/sh
if [ "$3" = -m ]; then
    echo 'fixture: checks reached'
    exit 73
fi
exec {shlex.quote(sys.executable)} "$@"
''')
        result = self.run_command(["bash", "-c", '''source "$1"
gate_policy_prepare || exit
exec bash scripts/check.sh
''', "fixture", str(self.kit / "gate-policy.sh")], check=False)
        self.assertEqual(result.returncode, 73, result.stdout + result.stderr)
        self.assertIn("fixture: checks reached", result.stdout)
        result = self.run_command(["bash", "scripts/check.sh"], check=False, extra={
            "SKEIN_GATE_POLICY_ID": "sha256:wrong",
            "SKEIN_GATE_POLICY_HELPER": str(self.kit / "gate-policy.sh")})
        self.assertEqual(result.returncode, 2)
        self.assertNotIn("checks reached", result.stdout)
        self.assertIn("admission policy differs", result.stderr)

    def test_configured_path_and_inactive_target_commands(self):
        alternate = self.root / "alternate-bin"
        shutil.copytree(self.bin, alternate)
        wrapper = alternate / "config-wrapper"
        self.script(wrapper, "#!/bin/sh\nexit 0\n")
        config = self.home / ".cargo/config.toml"
        config.parent.mkdir()
        config.write_text(f'''[env]
PATH = {{ value = "{alternate}:{os.defpath}", force = true }}
RUSTFLAGS = {{ value = "--cfg=forced", force = true }}
[build]
rustc-wrapper = "config-wrapper"
[target.unused-target]
runner = "missing-inactive-runner"
''')
        baseline = self.identity().stdout
        self.assertEqual(self.identity({"RUSTFLAGS": "--cfg=masked"}).stdout, baseline)
        with wrapper.open("a") as output:
            output.write("# wrapper changes\n")
        self.assertNotEqual(self.identity().stdout, baseline)

    def test_missing_rustup_toolchain_fails_before_shim_execution(self):
        for name in ("rustc", "cargo"):
            (self.bin / name).unlink()
            (self.bin / name).symlink_to(self.bin / "rustup")
        self.script(self.bin / "rustup", '''#!/bin/sh
if [ "$1" = which ]; then exit 1; fi
echo attempted >> "$HOME/shim-invoked"
exit 97
''')
        result = self.identity(check=False)
        self.assertEqual(result.returncode, 2)
        self.assertFalse((self.home / "shim-invoked").exists())

    def test_external_gate_implementation_change_invalidates_cache(self):
        gate = self.root / "gate"
        self.script(gate, "#!/bin/sh\nexit 0\n")
        self.land(gate=str(gate))
        self.retry()
        with gate.open("a") as output:
            output.write("# gate implementation changes\n")
        self.land(gate=str(gate))
        self.assertEqual(len(self.calls()), 2)

    def test_unmodeled_config_includes_refuse_without_reading_them(self):
        config = self.home / ".cargo/config.toml"
        config.parent.mkdir()
        config.write_text('include = "private-unopened-config"\n')
        result = self.identity(check=False)
        self.assertEqual(result.returncode, 2)
        self.assertNotIn("private-unopened-config", result.stdout + result.stderr)

    def test_missing_prior_tree_cannot_claim_docs_only_reuse(self):
        self.land()
        policy = self.git("log", "-1", "--format=%(trailers:key=Gate-Policy,valueonly)").strip()
        tree = self.git("log", "-1", "--format=%(trailers:key=Gate-Tree,valueonly)").strip()
        missing = "f" * len(tree)
        key = hashlib.sha256(f"{missing}\0true\0{policy}\0".encode()).hexdigest()
        cache_dir = self.root / "tmp/gates/repo"
        record = next(cache_dir.iterdir()).read_text()
        (cache_dir / key).write_text(record)
        message = self.git("log", "-1", "--format=%B").replace("Gate-Tree: " + tree, "Gate-Tree: " + missing)
        self.git("commit", "--amend", "-qm", message)
        self.advance_main_docs()
        self.land()
        self.assertEqual(len(self.calls()), 2)

    def test_normal_gate_keeps_all_tiers(self):
        source = (KIT.parent / "check.sh").read_text()
        for command in ("cargo nextest run --workspace\n",
                        "cargo nextest run --workspace --profile fuzzy\n",
                        "cargo nextest run --workspace --profile browser\n",
                        "cargo check -p skein-tls\n", "cargo clippy --workspace --all-targets -- -D warnings\n"):
            self.assertIn(command, source)
        self.assertLess(source.index("gate_policy_prepare"), source.index("cargo fmt"))


