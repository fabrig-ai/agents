#!/usr/bin/env -S python3 -S
"""issue open [--mission M] [--repo R] [--public] TITLE FILE
issue list [--mission M] [--all]
issue comment [--mission M] REPO#NUMBER FILE
issue close [--mission M] REPO#NUMBER [FILE]
issue serve [--listen HOST:PORT] [--route LOGIN]
"""
import argparse
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
import hashlib
import hmac
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import ipaddress
import json
import os
from pathlib import Path
import re
import socket
import stat
import subprocess
import sys
import tempfile
import threading
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

os.umask(0o077)
FORGE = 'https://git.fabrig.ai'  # ISSUE_FORGE overrides it (fixtures).
OWNER = 'fabrig-ai'
REPOS = ('agents', 'skein', 'smith', 'jig', 'hearth', 'temper', 'qa')
PRIVATE = ('agents', 'qa')
LABEL = 'waiting-on-user'  # The label applied to each new question.
TOOL = 'fabrig-agents'
PEOPLE = ('free',)
SENDER = 'issues'  # The router's post name.
LISTEN = '127.0.0.1:8391'  # The default loopback webhook listener.
# Copied from scripts/devel/post: name_pattern, machine_pattern, valid_address.
NAME = r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*'
MACHINE = r'[a-z][a-z0-9-]*'
ADDRESS = rf'{NAME}@{MACHINE}'
MISSION = r'[a-z0-9][a-z0-9_-]*'
MARKER = re.compile(r'^<!-- waiting-on-user (?:mission=(\S+)|director) -->$', re.M)


class Refusal(Exception):
    pass


def need(ok, why):
    if not ok:
        raise Refusal(why)


def workspace():
    # As scripts/devel/status-page finds the workspace.
    home = Path.home()
    return home / ('src/rust' if (home / 'src/rust').exists() else 'src')


class Paths:
    def __init__(self):
        self.root = Path(os.environ.get('DEV_ROOT', workspace())).expanduser().absolute()
        self.tmp = Path(os.environ.get('DEV_TMP', self.root / 'tmp')).expanduser().absolute()
        self.records = Path(os.environ.get('RECORDS', self.root / 'records')).expanduser().absolute()
        self.spool = Path(os.environ.get('XDG_STATE_HOME', Path.home() / '.local/state')) / 'issue-router'

    def machine(self):
        names = []
        for line in (self.tmp / 'post/machines').read_text().splitlines():
            fields = line.split('#', 1)[0].split()
            if not fields:
                continue
            need(len(fields) == 2 and re.fullmatch(MACHINE, fields[0])
                 and not fields[1].startswith('-'), 'invalid machines file')
            if fields[1] == 'local':
                names.append(fields[0])
        need(len(names) == 1, 'machines file must name one local machine')
        return names[0]


def credential(path, kind):
    try:
        value = path.read_text(encoding='utf-8').strip()
    except (OSError, UnicodeError):
        value = ''
    need(value, f'no {kind} at {path}')
    return value


def asking(paths, mission):
    if mission is None:
        name = os.environ.get('POST_NAME', '')
        mission = name if name == 'director' else name.partition('/')[2]
        need(mission, 'set POST_NAME or pass --mission')
    need(re.fullmatch(MISSION, mission), 'invalid mission')
    return mission


def front_matter(paths, mission):
    try:
        text = (paths.records / 'missions' / mission / 'README.md').read_text(encoding='utf-8')
    except FileNotFoundError:
        return None
    front = re.match(r'\A---\n(.*?)\n---(?:\n|$)', text, re.S)
    return dict(line.split(':', 1) for line in front[1].splitlines() if ':' in line) if front else {}


def repository(paths, asker):
    front = front_matter(paths, asker) if asker != 'director' else None
    feature = (front or {}).get('feature', '').split()
    return feature[0] if feature and feature[0] in REPOS else 'agents'


def chain(paths, asker: str) -> list[str]:
    """The mission's owner and parent, then this machine's director, each once."""
    recipients = []
    if asker != 'director':
        front = front_matter(paths, asker)
        if front is None:
            try:
                pulled = subprocess.run(['record', 'pull'], stdin=subprocess.DEVNULL,
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
                if pulled.returncode:
                    print(f'issue: record pull exited {pulled.returncode}', file=sys.stderr, flush=True)
            except (OSError, subprocess.TimeoutExpired):
                print('issue: record pull failed', file=sys.stderr, flush=True)
            front = front_matter(paths, asker)
        for key in ('owner', 'parent'):
            address = (front or {}).get(key, '').strip()
            if re.fullmatch(ADDRESS, address):
                recipients.append(address)
    recipients.append(f'director@{paths.machine()}')
    return list(dict.fromkeys(recipients))


def write_marker(asker):
    return f'<!-- waiting-on-user {"director" if asker == "director" else "mission=" + asker} -->'


def read_marker(body) -> str | None:
    matches = list(MARKER.finditer(body))
    if not matches:
        return None
    mission = matches[-1][1]
    if mission is None:
        return 'director'
    return mission if re.fullmatch(MISSION, mission) else None


def parse_issue(text) -> tuple[str, int]:
    match = re.fullmatch(r'([a-z]+)#([0-9]+)', text)
    why = 'use REPO#NUMBER with a known repository and positive decimal number'
    need(match and match[1] in REPOS, why)
    try:
        number = int(match[2])
    except ValueError:
        raise Refusal(why) from None
    need(number > 0, why)
    return match[1], number


class ForgeError(Exception):
    def __init__(self, status, message):
        self.status, self.message = status, message
        super().__init__(message)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class Forge:
    def __init__(self, base: str, token: str):
        self.base, self.token = base.rstrip('/'), token
        self.opener = urllib.request.build_opener(NoRedirect)

    def call(self, method, repo, path, body=None, query=None):
        """One JSON call in a workspace repository; raises ForgeError."""
        need(repo in REPOS, 'unknown repository')
        url = f'{self.base}/api/v1/repos/{OWNER}/{repo}/{path}'
        if query:
            url += '?' + urllib.parse.urlencode(query)
        request = urllib.request.Request(url, method=method,
                                         data=None if body is None else json.dumps(body).encode(),
                                         headers={'Authorization': 'token ' + self.token,
                                                  'Accept': 'application/json',
                                                  'Content-Type': 'application/json',
                                                  'User-Agent': 'agents-issue'})
        try:
            with self.opener.open(request, timeout=30) as response:
                return json.load(response)
        except urllib.error.HTTPError as error:
            try:
                message = json.load(error).get('message', error.reason)
            except (ValueError, AttributeError, UnicodeError):
                message = error.reason
            raise ForgeError(error.code, self.safe(message)) from None
        except (urllib.error.URLError, OSError) as error:
            raise ForgeError(0, self.safe(getattr(error, 'reason', error))) from None
        except (ValueError, UnicodeError):
            raise ForgeError(0, 'invalid JSON response') from None

    def safe(self, message):
        return clean(str(message).replace(self.token, '[redacted]'))[:200]


def clean(text):
    return ''.join(' ' if unicodedata.category(c) == 'Cc' else c for c in text)


def body_file(filename):
    path = Path(filename)
    # Opening nonblocking avoids hanging on a FIFO passed in place of a regular file.
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as source:
        need(stat.S_ISREG(os.fstat(source.fileno()).st_mode), 'body must be a regular file')
        data = source.read(60 * 1024 + 1)
    need(len(data) <= 60 * 1024, 'body exceeds 60 KiB')
    try:
        text = data.decode('utf-8')
    except UnicodeError:
        raise Refusal('body must be valid UTF-8') from None
    need(not any(line.startswith('<!-- waiting-on-user') for line in text.splitlines()),
         'body contains a waiting-on-user marker')
    return text


def client(paths):
    return Forge(os.environ.get('ISSUE_FORGE', FORGE),
                 credential(paths.tmp / 'git-fabrig/agents-issues.token', 'token'))


def open_issue(paths, args):
    need(1 <= len(args.title) <= 200 and clean(args.title) == args.title,
         'title must be one line, 1 to 200 characters, without control characters')
    text = body_file(args.file)
    asker = asking(paths, args.mission)
    repo = args.repo if args.repo is not None else repository(paths, asker)
    need(repo in REPOS, 'unknown repository')
    need(repo in PRIVATE or args.public,
         f"{repo}'s issues are public: write the text for anyone, then pass --public")
    who = 'by the director' if asker == 'director' else f'for the mission `{asker}`'
    body = (text.rstrip() + f'\n\n---\nAsked {who}. Your comment here '
            'reaches it by post, and it closes the issue.\n' + write_marker(asker))
    forge = client(paths)
    page, label = 1, None
    while True:
        labels = forge.call('GET', repo, 'labels', query={'limit': 50, 'page': page})
        label = next((row['id'] for row in labels if row['name'] == LABEL), None)
        if label is not None or len(labels) < 50:
            break
        page += 1
    if label is None:
        raise ForgeError(200, f'no label {LABEL} on {OWNER}/{repo}')
    issue = forge.call('POST', repo, 'issues', {'title': args.title, 'body': body, 'labels': [label]})
    suffix = '' if repo in PRIVATE else ' public'
    print(f"{repo}#{issue['number']} {issue['html_url']}{suffix}")


def age(created, now):
    minutes = max(0, int((now - datetime.fromisoformat(created.replace('Z', '+00:00'))).total_seconds() // 60))
    if minutes < 120:
        return f'{minutes}m'
    if minutes < 2880:
        return f'{minutes // 60}h'
    return f'{minutes // 1440}d'


def list_issues(paths, args):
    asker = asking(paths, args.mission)
    forge, now = client(paths), datetime.now(timezone.utc)
    for repo in REPOS:
        rows, page = [], 1
        while True:
            batch = forge.call('GET', repo, 'issues', query={
                'state': 'open', 'type': 'issues', 'labels': LABEL, 'limit': 50, 'page': page})
            rows.extend(batch)
            if len(batch) < 50:
                break
            page += 1
        for row in sorted(rows, key=lambda r: r['number']):
            owner = read_marker(row.get('body') or '')
            if args.all or owner == asker:
                print('\t'.join((f"{repo}#{row['number']}", age(row['created_at'], now),
                                  owner or '-', clean(row['title']), row['html_url'])))


def change_issue(paths, args):
    repo, number = parse_issue(args.issue)
    asker = asking(paths, args.mission)
    forge = client(paths)
    name = f'{repo}#{number}'
    issue = forge.call('GET', repo, f'issues/{number}')
    need(not issue.get('pull_request'), f'{name} is a pull request')
    owner = read_marker(issue.get('body') or '')
    need(owner is not None, f"{name} has no asker's marker")
    need(owner == asker, f'{name} is asked by {owner}, not {asker}')
    if args.file is not None:
        comment = forge.call('POST', repo, f'issues/{number}/comments', {'body': body_file(args.file)})
        if args.command == 'comment':
            print(f"{name} {comment['html_url']}")
            return
    closed = issue['state'] == 'closed'
    if not closed:
        forge.call('PATCH', repo, f'issues/{number}', {'state': 'closed'})
    print(f'{name} ' + ('was closed already' if closed else 'closed'))


@dataclass(frozen=True)
class Reply:
    comment: int
    number: int
    title: str
    url: str
    author: str
    text: str
    asker: str
    repo: str


def reply(event: str, payload: dict, routes=()) -> Reply | str:
    """The comment to route, or why there is none. Bad fields raise ValueError."""
    if not isinstance(payload, dict):
        raise ValueError('payload must be an object')
    if event != 'issue_comment':
        return 'not an issue comment'
    try:
        action, is_pull = payload['action'], payload['is_pull']
        repository = payload['repository']['full_name']
        issue, comment = payload['issue'], payload['comment']
        number, title, body = issue['number'], issue['title'], issue['body']
        opener = issue['user']['login']
        ident, url, text, author = comment['id'], comment['html_url'], comment['body'], comment['user']['login']
        if not all(isinstance(v, str) for v in (action, repository, title, body, url, text, author, opener)):
            raise ValueError('invalid text field')
        if type(is_pull) is not bool or any(type(v) is not int or v <= 0 for v in (number, ident)):
            raise ValueError('invalid comment fields')
    except (KeyError, TypeError):
        raise ValueError('missing comment field') from None
    if action != 'created':
        return 'not created'
    if is_pull:
        return 'pull request'
    repo = repository.removeprefix(OWNER + '/')
    if repository != f'{OWNER}/{repo}' or repo not in REPOS:
        return 'another repository'
    if author not in (*PEOPLE, *routes):
        return 'comment author not allowed'
    if opener != TOOL:
        return 'issue author not trusted'
    asker = read_marker(body)
    if asker is None:
        return 'no asker marker'
    return Reply(ident, number, title, url, author, text, asker, repo)


def post_body(item, fallback=None, owner=None):
    lines = item.text.splitlines()
    result = [f'{clean(item.author)} on {item.repo}#{item.number}, {clean(item.url)}:', '',
              *(clean(line)[:300] for line in lines[:10])]
    if len(lines) > 10:
        result.append(f'[… {len(lines) - 10} more lines on the issue.]')
    # At most 15 lines, including the fallback prefix and the final instructions.
    if fallback is None and len(result) < 14:
        result.append('')
    result.append(f'Answer there with `issue comment {item.repo}#{item.number} FILE`, '
                  f'and close it with `issue close {item.repo}#{item.number}` once done.')
    if fallback is not None:
        result.insert(0, f'For {owner or item.asker}, whom post could not wake: {clean(fallback)[:300]}.')
    return '\n'.join(result) + '\n'


def atomic_json(directory, destination, row):
    name = None
    try:
        with tempfile.NamedTemporaryFile(dir=directory, delete=False) as target:
            name = target.name
            target.write((json.dumps(row) + '\n').encode())
        os.replace(name, destination)
    finally:
        if name and os.path.exists(name):
            os.unlink(name)


class Router:
    def __init__(self, paths):
        self.paths, self.spool = paths, paths.spool
        paths.machine()  # Refuse an invalid local configuration before accepting webhooks.
        for name in ('tmp', 'new', 'done', 'failed'):
            (self.spool / name).mkdir(parents=True, exist_ok=True, mode=0o700)
        self.lock, self.wake, self.stop = threading.Lock(), threading.Event(), threading.Event()

    def enqueue(self, item):
        name = f'{item.repo}-{item.comment}.json'
        with self.lock:
            if any((self.spool / state / name).exists() for state in ('new', 'done', 'failed')):
                return 'redelivery'
            row = dict(asdict(item), attempts=0, tried=[],
                       received=datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'))
            atomic_json(self.spool / 'tmp', self.spool / 'new' / name, row)
        self.wake.set()
        return 'spooled'

    def deliver(self, item, row, path):
        tried = row['tried']
        if any(attempt['exit'] == 0 for attempt in tried):
            return 'done'
        recipients = chain(self.paths, item.asker)
        completed = [attempt for attempt in tried if attempt['exit'] in (2, 3)]
        skipped = {attempt['recipient'] for attempt in completed}
        fallback = completed[-1]['line'] if completed else None
        front = front_matter(self.paths, item.asker) if item.asker != 'director' else None
        owner = (front or {}).get('owner', '').strip()
        if not re.fullmatch(ADDRESS, owner):
            owner = item.asker
        code = completed[-1]['exit'] if completed else 2
        subject = clean(f'{item.repo}#{item.number} {item.author} replied: {item.title}')[:200]
        for recipient in recipients:
            if recipient in skipped:
                continue
            try:
                sent = subprocess.run(['post', 'send', '--as', SENDER, recipient, subject],
                                      input=post_body(item, fallback, owner), text=True, errors='replace',
                                      stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=600)
                code = sent.returncode
                lines = sent.stdout.strip().splitlines()
                last = lines[-1] if lines else f'post exited {code}'
            except subprocess.TimeoutExpired:
                code, last = 'timeout', 'post timed out'
            except OSError:
                code, last = 'unavailable', 'post could not start'
            tried.append(dict(recipient=recipient, exit=code, line=clean(last)[:300]))
            with self.lock:
                atomic_json(self.spool / 'tmp', path, row)
            print(f'issue: {item.repo}#{item.number} comment {item.comment} to {recipient}: post {code}',
                  file=sys.stderr, flush=True)
            if code == 0:
                return 'done'
            if code not in (2, 3):
                return 'retry'
            fallback = last
        return 'done' if code == 3 else 'failed'

    def worker(self):
        while not self.stop.is_set():
            self.wake.clear()
            for path in sorted((self.spool / 'new').glob('*.json'), key=lambda p: (p.stat().st_mtime_ns, p.name)):
                if self.stop.is_set():
                    break
                try:
                    row = json.loads(path.read_text())
                    item = Reply(**{key: row[key] for key in ('comment', 'number', 'title', 'url', 'author', 'text', 'asker', 'repo')})
                    outcome = self.deliver(item, row, path)
                    if outcome == 'retry':
                        row['attempts'] += 1
                        with self.lock:
                            atomic_json(self.spool / 'tmp', path, row)
                        if row['attempts'] < 5:
                            continue
                        outcome = 'failed'
                    with self.lock:
                        os.replace(path, self.spool / outcome / path.name)
                except (Refusal, OSError, ValueError, KeyError, TypeError):
                    # Leave unreadable state for repair; never log its contents.
                    print(f'issue: spool file {path.name}: cannot process', file=sys.stderr, flush=True)
            self.wake.wait(60)


class Hook(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass

    def answer(self, status, reason):
        self.send_response(status)
        self.send_header('Content-Length', '0')
        self.end_headers()
        print(f'issue: request {status}: {reason}', file=sys.stderr, flush=True)

    def __getattr__(self, name):
        if name.startswith('do_'):
            return lambda: self.answer(405, 'method refused')
        raise AttributeError(name)

    def do_POST(self):
        if self.path != '/hook':
            return self.answer(404, 'path refused')
        try:
            length = int(self.headers.get('Content-Length', ''))
            if length < 0:
                raise ValueError
        except ValueError:
            return self.answer(400, 'invalid content length')
        if length > 1024 * 1024:
            return self.answer(413, 'body too large')
        self.connection.settimeout(5)
        try:
            body = self.rfile.read(length)
        except OSError:
            return self.answer(400, 'incomplete body')
        if len(body) != length:
            return self.answer(400, 'incomplete body')
        signature = self.headers.get('X-Forgejo-Signature', self.headers.get('X-Gitea-Signature', ''))
        expected = hmac.new(self.server.secret, body, hashlib.sha256).hexdigest()
        if not re.fullmatch('[0-9a-f]{64}', signature) or not hmac.compare_digest(signature, expected):
            return self.answer(403, 'signature refused')
        try:
            event = self.headers.get('X-Forgejo-Event', self.headers.get('X-Gitea-Event', ''))
            item = reply(event, json.loads(body), self.server.routes)
        except (ValueError, UnicodeError, RecursionError):
            return self.answer(400, 'invalid payload')
        if isinstance(item, str):
            return self.answer(204, item)
        try:
            reason = self.server.router.enqueue(item)
        except OSError:
            return self.answer(500, 'cannot spool')
        self.answer(204, reason)


def serve(paths, listen, routes):
    secret = credential(paths.tmp / 'git-fabrig/webhook.secret', 'webhook secret')
    try:
        host, port = listen.rsplit(':', 1)
        host = host.removeprefix('[').removesuffix(']')
        address = ipaddress.ip_address(host)
        need(address.is_loopback, 'listener must be a loopback address')
        port = int(port)
        need(0 <= port <= 65535, 'invalid listen port')
    except ValueError:
        raise Refusal('listen must be a loopback HOST:PORT') from None
    router = Router(paths)
    class Server(ThreadingHTTPServer):
        address_family = socket.AF_INET6 if address.version == 6 else socket.AF_INET
    with Server((host, port), Hook) as server:
        server.secret, server.router, server.routes = secret.encode(), router, routes
        worker = threading.Thread(target=router.worker, daemon=True)
        worker.start()
        print(f'issue: listening on {host}:{server.server_port}', flush=True)
        try:
            server.serve_forever()
        finally:
            router.stop.set()
            router.wake.set()


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    opening = sub.add_parser('open')
    opening.add_argument('--repo')
    opening.add_argument('--public', action='store_true')
    opening.add_argument('title')
    opening.add_argument('file')
    listing = sub.add_parser('list')
    listing.add_argument('--all', action='store_true')
    commenting = sub.add_parser('comment')
    commenting.add_argument('issue')
    commenting.add_argument('file')
    closing = sub.add_parser('close')
    closing.add_argument('issue')
    closing.add_argument('file', nargs='?')
    for command in (opening, listing, commenting, closing):
        command.add_argument('--mission')
    serving = sub.add_parser('serve')
    serving.add_argument('--listen', default=LISTEN)
    serving.add_argument('--route', action='append', default=[])
    args = parser.parse_args()
    try:
        paths = Paths()
        if args.command == 'open':
            open_issue(paths, args)
        elif args.command == 'list':
            list_issues(paths, args)
        elif args.command in ('comment', 'close'):
            change_issue(paths, args)
        else:
            serve(paths, args.listen, args.route)
        return 0
    except ForgeError as error:
        if error.status == 200 and error.message.startswith('no label '):
            reason = error.message
        elif error.status:
            reason = f'the forge answered {error.status}: {error.message}'
        else:
            reason = f'cannot reach the forge: {error.message}'
        print(f'issue: {reason}', file=sys.stderr)
        return 1
    except (Refusal, OSError, UnicodeError) as error:
        print(f'issue: {error}', file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 0


if __name__ == '__main__':
    sys.exit(main())
