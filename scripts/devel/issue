#!/usr/bin/env -S python3 -S
"""issue open [--as WHO] [--mission M] TITLE FILE
issue list [--as WHO] [--all]
issue comment [--as WHO] NUMBER FILE
issue close [--as WHO] NUMBER [FILE]
issue serve [--listen HOST:PORT]
issue install [--listen HOST:PORT]
"""
import argparse
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
import hashlib
import hmac
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import ipaddress
import json
import os
