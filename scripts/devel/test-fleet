#!/usr/bin/env python3
"""Offline fleet fixtures: private machine trees and piped-source SSH."""
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import runpy
import shlex
import subprocess
import sys
import time
import case_runner

SCRIPT = Path(__file__).resolve().with_name('fleet')
PYTHON = sys.executable
GB = 2 ** 30
NOW = 1793068800
API = runpy.run_path(str(SCRIPT))


def write(path, value, mode=None):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(value)
    if mode:
        path.chmod(mode)
    return path


def tool(directory, name, body):
    # As test-status-page: executable Python fakes, never the machine's tools.
    return write(directory / name, f'#!{PYTHON} -S\nimport json, os, sys, time\nfrom pathlib import Path\n' + body, 0o700)


class Lab:
    def __init__(self, root):
        self.root, self.bin = root, root / 'bin'
        self.trace = root / 'trace'
        self.trace.mkdir()
        for name in ('alpha', 'beta', 'gamma'):
            self.machine(name)
        write(self.tmp() / 'post/machines', 'alpha local\nbeta free@beta\ngamma free@gamma\n')
        for name in ('claude', 'kache', 'post', 'codex-run', 'systemctl'):
            tool(self.bin, name, '''
name = Path(sys.argv[0]).name
root = Path(os.environ['DEV_TMP']).parent
with (root / 'calls').open('a') as out:
    out.write(json.dumps([name, *sys.argv[1:]]) + '\\n')
a = json.loads((root / (name + '.json')).read_text())
if a.get('sleep'): time.sleep(a['sleep'])
print(a.get('out', ''), end='')
sys.exit(a.get('exit', 0))
''')
        tool(self.bin, 'du', '''
a = json.loads((Path(os.environ['DEV_TMP']).parent / 'du.json').read_text())
answer = a.get(sys.argv[-1], {'size': 123})
if answer.get('sleep'): time.sleep(answer['sleep'])
if 'out' in answer: print(answer['out'], end=''); sys.exit(0)
print(str(answer['size']) + '\\t' + sys.argv[-1])
''')
        tool(self.bin, 'ssh', '''
import subprocess, shlex
name = sys.argv[-2].split('@')[-1]
root = Path(os.environ['FIXTURE_ROOT']) / name
source = sys.stdin.buffer.read()
trace = Path(os.environ['FIXTURE_TRACE'])
(trace / (name + '.source')).write_bytes(source)
(trace / (name + '.args')).write_text(json.dumps(sys.argv[1:]))
cmd = shlex.split(sys.argv[-1])
assert cmd[:2] == ['bash', '-lc'], cmd
words = shlex.split(cmd[2])
assert words[:5] == ['exec', 'python3', '-I', '-', 'probe'], words
assert sys.argv[-1] == "bash -lc '" + ' '.join(words) + "'", sys.argv[-1]
mode = (root / 'ssh').read_text() if (root / 'ssh').exists() else ''
if mode == 'sleep': time.sleep(10)
if mode == 'nonsense': print('not json'); sys.exit(0)
if mode == 'probe-failed': print('Permission denied', file=sys.stderr); sys.exit(1)
if mode == 'warning': print('SSH-WARNING', file=sys.stderr)
if mode.startswith('answer:'): print(mode[7:]); sys.exit(0)
if mode and mode != 'warning':
    print(mode, file=sys.stderr); sys.exit(255)
env = dict(os.environ, DEV_TMP=str(root / 'tmp'), FLEET_FIXTURE_HOST=str(root / 'host'))
sys.exit(subprocess.run([sys.executable, '-I', '-', *words[4:]], input=source, env=env).returncode)
''')
        write(root / 'gamma/ssh', 'Connection refused')
        self.env = dict(os.environ, HOME=str(root / 'home'), PATH=f'{self.bin}:/usr/bin:/bin',
                        DEV_TMP=str(self.tmp()), FLEET_FIXTURE_HOST=str(root / 'alpha/host'),
                        FIXTURE_ROOT=str(root), FIXTURE_TRACE=str(self.trace))
        self.env.pop('PLAN_MIN_DISK_GB', None)

    def tmp(self, name='alpha'):
        return self.root / name / 'tmp'

    def machine(self, name):
        self.tmp(name).mkdir(parents=True)
        self.figures(name)
        self.answer('claude', [], name)
        self.answer('kache', {'disk': {'store_bytes': 60 * GB, 'store_limit_bytes': 100 * GB}}, name)
        for tool_name in ('post', 'codex-run', 'systemctl'):
            self.answer(tool_name, '', name)
        write(self.root / name / 'du.json', '{}')

    def figures(self, name='alpha', load=(1, 2, 3), cores=8, free=200*GB, total=600*GB, available=12*GB, memory=16*GB):
        host = self.root / name / 'host'
        write(host / 'cores', str(cores))
        write(host / 'disk', f'{free} {total}')
        write(host / 'proc/loadavg', ' '.join(map(str, load)) + ' 1/1 1\n')
        write(host / 'proc/pressure/cpu', 'some avg10=0 avg60=4.5 avg300=0 total=1\n')
        write(host / 'proc/pressure/memory', 'some avg60=3.2\nfull avg60=1.0\n')
        write(host / 'proc/meminfo', f'MemAvailable: {available//1024} kB\nMemTotal: {memory//1024} kB\n')

    def answer(self, name, out, machine='alpha', **extra):
        if isinstance(out, (dict, list)):
            out = json.dumps(out)
        write(self.root / machine / (name + '.json'), json.dumps(dict(out=out, **extra)))

    def run(self, *args, status=0, **env):
        result = subprocess.run([PYTHON, '-I', '-S', str(SCRIPT), *args], cwd=self.root,
                                env=dict(self.env, **env), capture_output=True, text=True, timeout=40)
        assert result.returncode == status, (result.returncode, result.stdout, result.stderr)
        return result

    def probe(self, *args, **env):
        return json.loads(self.run('probe', *args, **env).stdout)

    def rooms(self, *names, status=0, **env):
        return json.loads(self.run('room', '--json', *names, status=status, **env).stdout)['machines']

    def heavy(self, wait=0):
        write(self.tmp() / 'heavy/state.json', json.dumps({'gate': 'held', 'tasks': {
            'r': {'state': 'active', 'args': ['PRIVATE-ARGUMENT']},
            'q': {'state': 'queued', 'submitted': time.time() - wait},
            'done': {'state': 'released'}}}))

    def run_meta(self, name, task, ended=False):
        path = write(self.tmp() / 'codex-run' / name / 'meta', f'task={task}\nto=o/x@beta\n')
        if ended:
            write(path.parent / 'ended', 'done')
        return path

    def git(self, *args):
        return subprocess.run(['git', *map(str, args)], env=dict(self.env, GIT_CONFIG_NOSYSTEM='1',
                              GIT_CONFIG_GLOBAL='/dev/null'), capture_output=True, text=True, check=True).stdout

    def target(self, relative, size=2*GB):
        primary = self.root / 'alpha/agents'
        if not primary.exists():
            primary.mkdir()
            self.git('init', primary)
            self.git('-C', primary, '-c', 'user.name=Fixture', '-c', 'user.email=f@x', 'commit', '--allow-empty', '-m', 'seed')
        work = self.tmp() / relative
        self.git('-C', primary, 'worktree', 'add', '--detach', work)
        target = work / 'target'
        write(target / 'CACHEDIR.TAG', 'cache\n')
        for part in ('deps', '.fingerprint', 'build'):
            (target / 'debug' / part).mkdir(parents=True)
        for path in [target, *(target / 'debug').iterdir()]:
            os.utime(path, (NOW, NOW))
        sizes = self.root / 'alpha/du.json'
        values = json.loads(sizes.read_text()); values[str(target)] = {'size': size}
        write(sizes, json.dumps(values))
        return target


def reading_fields(lab):
    lab.answer('claude', [{'pid': 12, 'name': 'director', 'state': 'working'}, {'name': 'dead'}])
    lab.answer('systemctl', 'codex-owner-o-test\\x2dmission.service loaded active running\ncodex-run-live.service loaded active running\n')
    lab.run_meta('live', lab.tmp() / 'owners/test-m2/task.md')
    lab.heavy(720)
    lab.answer('post', '17 o/x id from waiter=dead PRIVATE-SUBJECT\n4 o/x id2 from waiter=alive other\n')
    meta = lab.run_meta('dead', lab.tmp() / 'director/task.md')
    os.utime(meta, (NOW, NOW))
    lab.answer('codex-run', f'dead\tpost failed\t{meta.parent}\to/x@beta\n')
    write(lab.tmp() / 'fleet/tend.jsonl', '{"start":"a","end":"b","commands":[]}\n')
    lab.target('owners/test/wt')
    reading = lab.probe('--sizes')
    rows = [('cores', 8), ('load', [1, 2, 3]), ('pressure', {'cpu': 4.5, 'memory_some': 3.2, 'memory_full': 1}),
            ('memory', {'available': 12*GB, 'total': 16*GB}), ('disk', {'free': 200*GB, 'total': 600*GB}),
            ('floor', 40*GB), ('quiet', False), ('kache', {'store': 60*GB, 'limit': 100*GB}),
            ('sessions', [{'name': 'director', 'state': 'working', 'kind': 'claude'}, {'name': 'o/test-mission', 'kind': 'codex'}]),
            ('implementers', {'test': 1}), ('mail', {'o/x': {'count': 2, 'oldest': 17, 'waiter': True}}),
            ('stale', [{'run': 'dead', 'why': 'post failed', 'caller': 'o/x@beta', 'since': API['iso'](NOW)}]),
            ('tend', [{'start': 'a', 'end': 'b', 'commands': []}]), ('errors', {})]
    for field, expected in rows:
        assert reading[field] == expected, (field, expected, reading.get(field))
    assert reading['heavy']['running'] == 1 and reading['heavy']['queued'] == 1
    assert 720 <= reading['heavy']['oldest_wait'] < 730 and reading['heavy']['gate'] is True
    assert reading['targets'] == [{'path': 'owners/test/wt/target', 'owner': 'test', 'built': API['iso'](NOW), 'in_use': False, 'size': 2*GB}]
    assert API['SCHEMAS']['time'](reading['time'])
    calls = [json.loads(x) for x in (lab.root / 'alpha/calls').read_text().splitlines()]
    assert sum(c[0] == 'systemctl' for c in calls) == 1, calls


def reading_floor(lab):
    path = write(lab.tmp() / 'machine.env', 'PLAN_MIN_DISK_GB=20\nPLAN_MIN_DISK_GB=35\nPLAN_MIN_DISK_GB=bad\nFLEET_QUIET=1\n')
    for env, expected in [({'PLAN_MIN_DISK_GB': '45'}, 45), ({}, 35)]:
        r = lab.probe(**env); assert r['floor'] == expected*GB and r['quiet']
    path.unlink()
    assert lab.probe()['floor'] == 40*GB


def reading_absent(lab):
    (lab.bin / 'kache').unlink()
    r = lab.probe()
    assert all(x not in r for x in ('kache', 'heavy', 'tend')) and r['errors'] == {}, r


def reading_source_fails(lab):
    rows = [('kache', '', {'exit': 1}, 'kache', 'exit 1'), ('claude', 'no JSON', {}, 'sessions', 'shape'),
            ('post', '', {'exit': 2}, 'mail', 'exit 2'), ('codex-run', '', {'exit': 1}, 'stale', 'exit 1'),
            ('systemctl', '', {'exit': 1}, 'implementers', 'exit 1'),
            ('kache', {'disk': {'store_bytes': 'x', 'store_limit_bytes': 100}}, {}, 'kache', 'shape')]
    expected_fields = set(lab.probe())
    originals = {name: (lab.root / 'alpha' / (name + '.json')).read_text() for name, *_ in rows}
    for name, out, extra, source, kind in rows:
        lab.answer(name, out, **extra)
        r = lab.probe()
        assert r['errors'].get(source) == kind and source not in r, (name, r)
        affected = {'sessions', 'implementers'} if name == 'systemctl' else {source}
        assert set(r['errors']) == affected and set(r) == expected_fields - affected, r
        write(lab.root / 'alpha' / (name + '.json'), originals[name])
    # Receiving side uses exactly the same shape checks and drops unknown keys.
    write(lab.root / 'beta/ssh', 'answer:' + json.dumps({'disk': {'free': 'x', 'total': 1}, 'private': 'SECRET'}))
    r = lab.rooms('beta')[0]['reading']
    assert r == {'errors': {'disk': 'shape'}}, r


