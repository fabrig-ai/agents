def malformed_watch_inputs(lab):
    # Tend records cross a loose boundary: one malformed command cannot stop a sweep.
    for commands in (None, 7, {}, [None], [{'argv': 7}],
                     [{'argv': None}, {'argv': ['post'], 'exit': 0}, {'argv': ['codex-run'], 'exit': 0}]):
        record = {'end': API['iso'](NOW), 'commands': commands}
        first = rounds(reading(tend=[record]), count=1)
        state = rounds(reading(tend=[]), first, now=NOW+300, count=1)
        assert 'alpha untended' in state['pending']
    # The refusal is still described after the cursor has consumed its record.
    first = rounds(reading(tend=[tend_record(NOW, (2, 0, 0))]), count=1)
    state = rounds(reading(tend=[]), first, now=NOW+300, count=1)
    assert state['conditions']['alpha untended']['reading'] == '(tidy refused)'
    path = lab.tmp() / 'fleet/watch.json'
    for bad in ({'cleared': ['alpha session']}, {'pending': ['alpha disk']},
                {'cleared': ['alpha session x', 'alpha session x']},
                {'conditions': {'alpha untended': {'raise': 2, 'clear': 0, 'raised': False}}},
                {'conditions': {'alpha untended': {'raise': 1, 'clear': 0, 'raised': False, 'reading': ['bad']}}}):
        write(path, json.dumps(dict(round=API['iso'](NOW), **bad)))
        assert API['load_state'](path) == {}, bad
    # A cleared condition may since have left conditions; keep it until a post goes.
    saved = dict(round=API['iso'](NOW), cleared=['alpha load'], conditions={})
    write(path, json.dumps(saved))
    assert API['load_state'](path) == saved


def watch_write_failure(lab):
    watch_kit(lab)
    path = lab.tmp() / 'fleet/watch.json'
    path.mkdir()
    watch_round(lab, 0, status=2)
    assert not list(path.parent.glob('watch.json.*'))
    path.rmdir()
    watch_round(lab, 0)
    before = path.read_bytes()
    with patch.object(Path, 'replace', side_effect=OSError('fixture rename failure')):
        try:
            API['atomic'](path, '{}')
        except OSError:
            pass
        else:
            raise AssertionError('rename failure was hidden')
    assert path.read_bytes() == before and not list(path.parent.glob('watch.json.*'))


