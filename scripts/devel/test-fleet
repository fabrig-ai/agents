    write(lab.root / 'alpha/send.json', '{"exit":3}')
    result = watch_round(lab, 2)
    assert 'director queued, nobody will wake it: absent' in result.stderr
    assert not watch_state(lab)['pending']
    watch_round(lab, 3)
    assert len(sends(lab)) == 2


def round_reads_since(lab):
    watch_kit(lab)
    watch_round(lab, 0)
    lines = (('tidy: deleted target x',), ('o/x woken',), ('run1 told: sent',))
    records = [tend_record(NOW), tend_record(NOW+60, lines=lines), tend_record(NOW+120, lines=lines)]
    write(lab.tmp('beta') / 'fleet/tend.jsonl', '\n'.join(map(json.dumps, records))+'\n')
    watch_round(lab, 1)
    sent, = sends(lab)
    assert 'beta tends: cleared 2 targets (disk now 38 GB free), woke o/x, told 2 callers' in sent['body']
    # Sized disk reads do not have --since; gamma's unsized trace proves its own absence.
    watch_round(lab, 2)
    assert '--since '+API['iso'](NOW+120) in json.loads((lab.trace / 'beta.args').read_text())[-1]
    assert '--since' not in json.loads((lab.trace / 'gamma.args').read_text())[-1]
    assert not watch_state(lab)['done']


