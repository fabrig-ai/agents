def reading_implementers_stale(lab):
    for run, task, ended in [('live', 'owners/mission-m12/task', False), ('gone', 'owners/gone/task', False),
                              ('done', 'owners/done/task', True), ('director', 'director/t', False), ('other', 'elsewhere/t', False)]:
        lab.run_meta(run, lab.tmp() / task, ended)
    lab.answer('systemctl', ''.join(f'codex-run-{x}.service loaded active running\n' for x in ('live', 'done', 'director', 'other')))
    directory = lab.tmp() / 'codex-run/gone'
    write(directory / 'post-failed', '')
    for path in directory.iterdir():
        os.utime(path, (NOW-50, NOW-50))
    os.utime(directory / 'post-failed', (NOW, NOW))
    lab.answer('codex-run', f'gone\tpost failed\t{directory}\to/x@alpha\n')
    r = lab.probe()
    assert r['implementers'] == {'mission': 1, 'director': 1, 'other': 1}, r
    assert r['stale'] == [{'run': 'gone', 'why': 'post failed', 'caller': 'o/x@alpha', 'since': API['iso'](NOW)}]


def reading_targets(lab):
    a = lab.target('owners/mission-m2/wt')
    b = lab.target('director/wt')
    c = lab.target('owners/other/wt')
    d = lab.target('owners/locked/wt')
    lab.git('-C', lab.root / 'alpha/agents', 'worktree', 'lock', d.parent)
    outside = lab.root / 'external-target'; c.rename(outside); c.symlink_to(outside, target_is_directory=True)
    write(lab.root / 'alpha/agents/target/CACHEDIR.TAG', 'cache')
    cwd = lab.root / 'alpha/host/proc/123/cwd'; cwd.parent.mkdir(); cwd.symlink_to(a.parent)
    fingerprint = a / 'debug/.fingerprint'; os.utime(fingerprint, (NOW+60, NOW+60))
    lock = write(b / 'debug/.cargo-lock', '')
    with lock.open('rb') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        r = lab.probe()['targets']
    assert len(r) == 2, r
    assert {(t['owner'], t['built'], t['in_use']) for t in r} == {('mission', API['iso'](NOW+60), True), ('director', API['iso'](NOW), True)}, r
    cwd.unlink()
    assert not any(t['in_use'] for t in lab.probe()['targets'])
    # A file descriptor holds the worktree too; two-level target profiles count.
    fd = lab.root / 'alpha/host/proc/123/fd/5'; fd.parent.mkdir(); fd.symlink_to(a / 'CACHEDIR.TAG')
    deep = a / 'x86/debug/.fingerprint'; deep.mkdir(parents=True); os.utime(deep, (NOW+120, NOW+120))
    os.utime(a, (NOW, NOW))
    r = lab.probe()['targets']
    assert next(t for t in r if t['owner'] == 'mission')['built'] == API['iso'](NOW+120)
    assert next(t for t in r if t['owner'] == 'mission')['in_use']
    # A source failure omits that field, while every other source stands.
    (lab.root / 'alpha/skein').mkdir()
    failed = lab.probe()
    assert 'targets' not in failed and failed['errors'] == {'targets': 'exit 128'}, failed
    assert 'disk' in failed and 'sessions' in failed


