def room_verdicts(lab):
    baseline = lab.probe()
    rows = [('disk', {'disk': {'free': 49*GB, 'total': 600*GB}}, 'full'),
            ('load', {'load': [1, 2, 24]}, 'full'),
            ('memory', {'memory': {'available': GB, 'total': 16*GB}}, 'full'),
            ('kache', {'kache': {'store': 150*GB, 'limit': 100*GB}}, 'full'),
            ('disk', {'disk': {'free': 99*GB, 'total': 600*GB}}, 'tight'),
            ('load', {'load': [1, 2, 12.1]}, 'tight'),
            ('memory', {'memory': {'available': 3*GB, 'total': 16*GB}}, 'tight'),
            ('wait', {'heavy': {'running': 0, 'queued': 1, 'oldest_wait': 600, 'gate': False}}, 'tight')]
    for field, changes, word in rows:
        assert API['verdict'](dict(baseline, **changes)) == (word, [field]), (field, changes)
    assert API['verdict'](baseline) == ('room', [])
    without = dict(baseline); del without['disk']
    assert API['verdict'](without) == ('tight', ['disk unknown'])
    for condition in ('disk', 'load', 'memory', 'kache'):
        assert API['holds'](condition, 'raise', {}) is None
        assert API['holds'](condition, 'clear', baseline) is True
    # Exact thresholds and hysteresis edges.
    for condition, changes, raised, cleared in [
        ('disk', {'disk': {'free': 50*GB}}, False, False),
        ('disk', {'disk': {'free': 60*GB}}, False, True),
        ('load', {'load': [0, 0, 16]}, False, False),
        ('memory', {'memory': {'available': 10, 'total': 100}}, False, False),
        ('memory', {'memory': {'available': 15, 'total': 100}}, False, True),
        ('kache', {'kache': {'store': 110, 'limit': 100}}, False, True)]:
        r = dict(baseline, **changes)
        assert API['holds'](condition, 'raise', r) is raised
        assert API['holds'](condition, 'clear', r) is cleared
    assert lab.rooms('alpha')[0]['verdict'] == 'room'


def room_order_and_exit(lab):
    for name, load, free in [('beta', (0, 0, 5), 99*GB), ('delta', (0, 0, 1), 200*GB),
                             ('epsilon', (0, 0, 4), 200*GB), ('zeta', (0, 0, 25), 200*GB)]:
        if name != 'beta': lab.machine(name)
        lab.figures(name, load=load, free=free)
    write(lab.tmp() / 'post/machines', 'zeta free@zeta\nbeta free@beta\nepsilon free@epsilon\nalpha local\ngamma free@gamma\ndelta free@delta\n')
    lab.figures('alpha', load=(1, 2, 24))
    r = lab.rooms(status=1)
    assert [x['machine'] for x in r] == ['delta', 'epsilon', 'beta', 'alpha', 'zeta', 'gamma'], r
    text = lab.run('room', status=1).stdout
    assert text.splitlines()[-1].split() == ['gamma', 'unreached:', 'refused'], text
    assert 'cpu 4%' in text and 'GB' in text and '/core)' in text


def room_unreached_why(lab):
    for mode, why in [('Permission denied', 'key refused'), ('sleep', 'timed out'), ('nonsense', 'wrong answer'),
                      ('Host key verification failed', 'host key refused'), ('Could not resolve hostname', 'name not resolved'),
                      ('No route to host', 'no route'), ('Connection timed out', 'timed out'), ('strange failure', 'ssh exited 255'), ('probe-failed', 'wrong answer')]:
        write(lab.root / 'beta/ssh', mode)
        result = lab.run('room', 'beta', status=1, FLEET_READ_SECONDS='2')
        assert result.stdout.strip() == f'beta  unreached: {why}', result.stdout
        assert mode not in result.stdout
    write(lab.root / 'beta/ssh', 'warning')
    warning = lab.run('room', 'beta')
    assert 'SSH-WARNING' in warning.stderr and 'SSH-WARNING' not in warning.stdout
    lab.answer('kache', '', sleep=10)
    assert lab.rooms('alpha', status=1, FLEET_READ_SECONDS='2')[0]['unreached'] == 'timed out'
    write(lab.root / 'beta/ssh', 'answer:[]')
    assert lab.rooms('beta', status=1)[0]['unreached'] == 'wrong answer'


def room_new_machine(lab):
    lab.machine('delta')
    with (lab.tmp() / 'post/machines').open('a') as out: out.write('delta free@delta\n')
    assert {x['machine'] for x in lab.rooms(status=1)} == {'alpha', 'beta', 'gamma', 'delta'}


def room_named(lab):
    assert [x['machine'] for x in lab.rooms('beta')] == ['beta']
    assert [p.name for p in lab.trace.glob('*.args')] == ['beta.args']
    lab.run('room', 'nowhere', status=2)
    for contents in ('', 'wrong fields here\n', 'alpha -option\n'):
        write(lab.tmp() / 'post/machines', contents)
        lab.run('room', status=2)
    (lab.tmp() / 'post/machines').unlink(); lab.run('room', status=2)


def room_piped(lab):
    lab.run('room', 'beta')
    assert (lab.trace / 'beta.source').read_bytes() == SCRIPT.read_bytes()
    args = json.loads((lab.trace / 'beta.args').read_text())
    assert args == [*API['SSH'][1:], 'free@beta', "bash -lc 'exec python3 -I - probe'"], args
    lab.run('room', '--targets', 'beta')
    assert json.loads((lab.trace / 'beta.args').read_text())[-1] == "bash -lc 'exec python3 -I - probe --sizes'"


def room_targets(lab):
    a = lab.target('owners/mission/wt-a', 2*GB)
    b = lab.target('owners/mission/wt-b', 4*GB)
    c = lab.target('director/wt', GB)
    out = lab.run('room', '--targets', 'alpha').stdout.splitlines()
    assert ['director' in out[1], 'wt-b' in out[2], 'wt-a' in out[3]] == [True]*3, out
    sizes = lab.root / 'alpha/du.json'; values = json.loads(sizes.read_text())
    values[str(b)]['sleep'] = 10; write(sizes, json.dumps(values))
    out = lab.run('room', '--targets', 'alpha', FLEET_DU_SECONDS='1').stdout
    assert 'mission  ?  owners/mission/wt-b/target' in out and 'mission  2.0 GB' in out, out
    rows = lab.probe('--sizes', FLEET_DU_SECONDS='1')['targets']
    expected = {str(a.relative_to(lab.tmp())): 2*GB, str(b.relative_to(lab.tmp())): None, str(c.relative_to(lab.tmp())): GB}
    assert {t['path']: t['size'] for t in rows} == expected
    values[str(b)] = {'out': ''}; write(sizes, json.dumps(values))
    assert {t['path']: t['size'] for t in lab.probe('--sizes')['targets']} == expected


def room_json(lab):
    output = json.loads(lab.run('room', '--json', status=1).stdout)
    assert set(output) == {'time', 'machines'} and API['SCHEMAS']['time'](output['time'])
    assert [r['machine'] for r in output['machines']] == ['alpha', 'beta', 'gamma']
    assert set(output['machines'][0]) == {'machine', 'reading', 'verdict', 'short'}
    assert output['machines'][-1] == {'machine': 'gamma', 'unreached': 'refused'}


CASES = [reading_fields, reading_floor, reading_absent, reading_source_fails, reading_no_text,
         reading_implementers_stale, reading_targets, reading_tend_since, room_verdicts,
         room_order_and_exit, room_unreached_why, room_new_machine, room_named, room_piped,
         room_targets, room_json]


def run(case, directory, built):
    case(Lab(directory))


if __name__ == '__main__':
    if sys.argv[1:2] != ['--one']:
        unknown = set(sys.argv[1:]) - {case.__name__ for case in CASES}
        if unknown:
            sys.exit('Unknown cases: ' + ', '.join(sorted(unknown)))
    sys.exit(case_runner.main(__file__, CASES, run, prefix='fleet-fixture-'))
