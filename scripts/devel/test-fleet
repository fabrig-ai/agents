def reading_source_fails(lab):
    rows = [('kache', '', {'exit': 1}, 'kache', 'exit 1'), ('claude', 'no JSON', {}, 'sessions', 'shape'),
            ('post', '', {'exit': 2}, 'mail', 'exit 2'), ('codex-run', '', {'exit': 1}, 'stale', 'exit 1'),
            ('systemctl', '', {'exit': 1}, 'implementers', 'exit 1'),
            ('kache', {'disk': {'store_bytes': 'x', 'store_limit_bytes': 100}}, {}, 'kache', 'shape')]
    expected_fields = set(lab.probe())
    originals = {name: (lab.root / 'alpha' / (name + '.json')).read_text() for name, *_ in rows}
    for name, out, extra, source, kind in rows:
        lab.answer(name, out, **extra)
        r = lab.probe()
        assert r['errors'].get(source) == kind and source not in r, (name, r)
        affected = {'sessions', 'implementers'} if name == 'systemctl' else {source}
        assert set(r['errors']) == affected and set(r) == expected_fields - affected, r
        write(lab.root / 'alpha' / (name + '.json'), originals[name])
    # Receiving side uses exactly the same shape checks and drops unknown keys.
    write(lab.root / 'beta/ssh', 'answer:' + json.dumps({'disk': {'free': 'x', 'total': 1}, 'private': 'SECRET'}))
    r = lab.rooms('beta')[0]['reading']
    assert r == {'errors': {'disk': 'shape'}}, r


