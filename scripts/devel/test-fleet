def reading(**changes):
    r = {'errors': {}, 'cores': 4, 'load': [1, 1, 1], 'floor': 40*GB,
         'disk': {'free': 100*GB, 'total': 600*GB}, 'memory': {'available': 50, 'total': 100},
         'kache': {'store': 50*GB, 'limit': 100*GB}, 'quiet': False,
         'mail': {}, 'stale': [], 'sessions': [], 'tend': [tend_record(NOW)]}
    r.update(changes)
    return r


def tend_record(now, exits=(0, 0, 0), lines=((), (), ())):
    return {'end': API['iso'](now), 'commands': [
        {'argv': list(argv), 'exit': code, 'lines': list(output)}
        for argv, code, output in zip(API['TENDING'], exits, lines)]}


def row(r=None, machine='alpha', **changes):
    return {'machine': machine, 'reading': reading() if r is None else r, **changes}


def rounds(r, state=None, missions=(), now=NOW, count=2):
    for n in range(count):
        state = API['judge'](state or {}, [row(r)], set(missions), now+n*300)
    return state


