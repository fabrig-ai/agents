#!/usr/bin/env bash
# Land the current branch on main (owners.md, 4).
#
#   land [--docs] [--local] [--no-push] [--gate COMMAND] [--tries N]
#
# From a clean worktree on the branch to land: rebase it on origin/main,
# build it, run its lints and the repository's gate through heavy where
# installed, and run them plain elsewhere (build-infrastructure.md 12).
# Record the gate's evidence in the tip commit's trailers, and push the tip
# to origin's main. The build lane's pass leaves
# the gate's own build and lints nothing to redo, so the gate, first by its
# CPU weight beside the machine's builds, runs only the suites, and a tree
# that does not build or lint never reaches it.
# A gate that passed before the rebase still holds when what moved main
# changed only Markdown files under docs/ outside declared gate inputs.
# The push only fast-forwards: a rejected push means main moved, and land
# starts again from the rebase. Then the local main, and the checkout that
# has it, follow. A code landing holds its repository's turn on this
# machine from its rebase to its push, so that another landing here never
# moves main under its gate. In skein, smith, hearth, jig and temper, a
# landing that pushes also holds the set lock on hetzner3, land-set's, a
# code landing once it has proved its tree without it, and for as long as
# that proof holds.
# After a push or --local landing, mark the branch landed, clear a linked
# worktree's own target/, and start tidy REPO detached, logging to
# $tmp/logs/tidy.log. LAND_TIDY is a shell command (default "$kit/tidy");
# set and empty, none starts. Cleanup warnings do not change the result.
#
# After a push, append the landing's record, with what its commits taught,
# to the landing feed (landing-flow.md, 12). LAND_FEED, a local path,
# replaces hetzner3's feed; set and empty, none is written.
#
# land starts no tier after landing, not even a repository's
# scripts/after-landing.sh: the runner runs it (landing-flow.md, 4, step 8).
#
# --docs   Markdown only, or the mockups under docs/design/ (a directory
#          named mockups), which need no build or test: check that, and
#          skip the gate, except paths declared in scripts/gated-docs.
# --local  No remote: land on the local main under a lock (LAND_LOCK, or
#          the repository's land.lock) instead of pushing.
# --no-push  Gate and record trailers, then stop with not pushed; no main
#          follows. Incompatible with --docs and --local.
# --gate   The gate, a shell command, instead of scripts/check.sh.
# --tries  How many times to start again when main moves (default 5).
#
# LAND_PREBUILD is the build lane's command before the gate, in a Cargo
# repository: by default formatting, clippy as the gates run it, and the
# tests' build. Empty, there is none.
# LAND_SET_BASE is land-set's sampled main commit for --no-push: rebase
# and gate against it without fetching a newer main.
#
# Once it has rebased, land ends with one line on stdout, `land: result
# JSON` (landing-flow.md, 10), and writes the same JSON to the file
# LAND_RESULT names, when it is set.
#
# Exit status:
#   0  landed
#   2  refused: before starting, or nothing to land
#   3  the rebase stopped on conflicts no rule settles, left stopped or undone
#   4  the gate failed
#   5  the local main could not follow: with a push, the commit landed on
#      origin/main; with --local, nothing landed
#   6  main kept moving, or its ref stayed locked
#   7  fetching or pushing failed
#   8  another command failed
#   9  heavy is installed, or can't tell, and refused to run the build or
#      gate, so nothing ran
#  10  with LAND_PROVED=1, between land's own passes: the gate was not in
#      the cache, so nothing ran and nothing landed
set -euo pipefail
umask 077

kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# The workspace: DEV_ROOT, or the directory holding the agents checkout these
# tools come from, or ~/src/rust.
workspace() {
    local agents
    agents=$(cd "$kit/../.." && pwd)
    if [[ $(basename "$agents") == agents ]]; then dirname "$agents"; else echo "$HOME/src/rust"; fi
}
root=${DEV_ROOT:-$(workspace)}
tmp=${DEV_TMP:-$root/tmp}
if [[ -f $kit/kit.sh ]]; then
    # shellcheck source=kit.sh
    source "$kit/kit.sh"
fi
# shellcheck source=gate-policy.sh
source "$kit/gate-policy.sh"
start_dir=$PWD
original_args=("$@")

docs=0 local=0 no_push=0 gate=scripts/check.sh tries=5
while (($#)); do
    case $1 in
    --docs) docs=1; shift ;;
    --local) local=1; shift ;;
    --no-push) no_push=1; shift ;;
    --gate) gate=${2:?}; shift 2 ;;
    --tries) tries=${2:?}; shift 2 ;;
    *) echo "usage: land [--docs] [--local] [--no-push] [--gate COMMAND] [--tries N]" >&2; exit 2 ;;
    esac
done

die() { echo "land: $2" >&2; exit "$1"; }
trap 'echo "land: line $LINENO failed" >&2; exit 8' ERR
((!no_push || (!docs && !local))) || die 2 "--no-push cannot be combined with --docs or --local"
if [[ -n ${LAND_SET_BASE:-} ]]; then
    ((no_push)) && [[ $LAND_SET_BASE =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] ||
        die 2 "LAND_SET_BASE requires --no-push and a full commit ID"
fi

top=$(git rev-parse --show-toplevel)
cd "$top"
branch=$(git symbolic-ref --quiet --short HEAD) || die 2 "not on a branch"
[[ $branch != main ]] || die 2 "on main; land a branch"
[[ -z $(git status --porcelain --untracked-files=normal --ignore-submodules=none) ]] || die 2 "the index/worktree is not clean; rerun land after committing changes"
for state in rebase-merge rebase-apply MERGE_HEAD; do
    [[ ! -e $(git rev-parse --git-path "$state") ]] || die 2 "a rebase or merge is in progress; finish it and rerun land"
done
common=$(git rev-parse --path-format=absolute --git-common-dir)
# The repository: origin's last path component, without .git. Without
# origin, keep the checkout's directory or a bare clone's name.
if origin=$(git remote get-url origin 2>/dev/null); then
    repo=$(basename "$origin")
    repo=${repo##*:}
    repo=${repo%.git}
elif [[ $(basename "$common") == .git ]]; then
    repo=$(basename "$(dirname "$common")")
else
    repo=$(basename "$common" .git)
fi
lock=${LAND_LOCK:-$common/land.lock}
[[ $lock == /* ]] || lock=$start_dir/$lock
result_file=${LAND_RESULT:-}
[[ -z $result_file || $result_file == /* ]] || result_file=$start_dir/$result_file

# heavy is optional (build-infrastructure.md 12): where it isn't
# installed, land runs its build and gate itself.
runner=
if ((!docs)); then
    status=0
    "$kit/heavy" --installed || status=$?
    case $status in
    0) runner=heavy ;;
    1) runner=plain
       echo "land: heavy is not installed here; the build and gate run plain" >&2 ;;
    *) die 9 "heavy cannot tell whether it is installed (its reason above), so nothing ran; land again once that is put right" ;;
    esac
fi

# Every write to a set repository's main holds the set lock, land-set's
# (landing-flow.md, 9.2), so that no main moves under a set's run. The
# connection spans retries, before the host turn.
in_set=0
case $repo in skein | smith | hearth | jig | temper) in_set=1 ;; esac
if ((in_set && !local && !no_push)) && [[ ${LAND_TURN_ACTIVE:-0} != 1 &&
    -f $HOME/.config/agents-land-turn/enabled ]]; then
    export LAND_TURN=1 LAND_TURN_HOLDER="$kit/land-turn.py"
    LAND_TURN_MODE=$(cat "$HOME/.config/agents-land-turn/enabled" 2>/dev/null) || LAND_TURN_MODE=invalid
    export LAND_TURN_MODE
fi

if ((in_set && !local && !no_push)) && [[ ${LAND_TURN:-0} == 1 &&
    ${LAND_TURN_ACTIVE:-0} != 1 ]]; then
    turn=(python3 -I -B "$kit/land-turn.py" client "$tmp" set "$kit/land" "${original_args[@]}")
    if ((docs)); then
        echo "land: waiting for the set lock" >&2
        LAND_LOCK=$lock LAND_RESULT=$result_file exec "${turn[@]}"
    fi
    # A code landing proves its tree without the lock, as land --no-push,
    # and lands under it only while that gate is a cache hit there: when
    # main moved meanwhile, it gives the lock back (10) and proves again.
    # The third landing pass gates under the lock, so that a busy main
    # cannot starve it. A red proof, or the landing's own outcome, is
    # land's; the others go to stderr, so that stdout and LAND_RESULT hold
    # only the final one.
    shown=$(mktemp)
    for round in 1 2 3; do
        status=0
        LAND_TURN_ACTIVE=1 LAND_PROVED=0 LAND_RESULT=$result_file \
            "$kit/land" --no-push "${original_args[@]}" >"$shown" || status=$?
        if ((status == 0)); then
            cat "$shown" >&2
            [[ -z $result_file ]] || rm -f "$result_file"
            echo "land: proved; landing under the set lock" >&2
            echo "land: waiting for the set lock" >&2
            LAND_LOCK=$lock LAND_RESULT=$result_file LAND_PROVED=$((round < 3)) \
                "${turn[@]}" >"$shown" || status=$?
        fi
        if ((status != 10 || round == 3)); then
            cat "$shown"
            rm -f "$shown"
            exit "$status"
        fi
        cat "$shown" >&2
        [[ -z $result_file ]] || rm -f "$result_file"
        echo "land: main moved since the proof; proving again without the lock" >&2
    done
fi

# One landing at a time in each repository on this machine
# (build-infrastructure.md, 8), from its rebase to its push: gates run
# one at a time anyway, and
# a gate that passed on a base another landing moved would be thrown
# away. Markdown and mockups landings take no turn, and --no-push, which
# moves no main, takes none either.
if ((!docs && !no_push)); then
    exec 6>"$common/land-turn.lock"
    if ! flock --nonblock 6; then
        echo "land: another landing in $repo has its turn; waiting for it" >&2
        flock 6
    fi
fi

fetch() {
    local wait
    for wait in 1 2 4; do
        git fetch --quiet origin main 2>/dev/null && return
        sleep "$wait"
    done
    die 7 "cannot fetch origin's main"
}

# Move the local main, and the checkout that has it, to $1. Returns 0 when
# main is there or past it, 1 when a checkout of main has changes, 2 when
# main has commits that $1 lacks. An empty-index anchor counts as no
# checkout: move only the ref and leave its files alone. Called under the lock.
follow() {
    local commit=$1 main wt tracked=
    main=$(git rev-parse main)
    if git merge-base --is-ancestor "$commit" "$main"; then
        return 0
    fi
    git merge-base --is-ancestor "$main" "$commit" || return 2
    wt=$(git worktree list --porcelain | awk '
        /^worktree / { w = substr($0, 10) } $0 == "branch refs/heads/main" { print w }')
    if [[ -n $wt ]]; then
        tracked=$(git -C "$wt" ls-files) || return 1
    fi
    if [[ -z $wt || -z $tracked ]]; then
        git update-ref refs/heads/main "$commit" "$main"
    elif [[ -n $(git -C "$wt" status --porcelain --untracked-files=no) ]]; then
        return 1
    else
        git -C "$wt" merge --quiet --ff-only "$commit"
    fi
}

# A result holds for one tree, gate command, effective runtime policy and runner.
gate_key() {
    printf '%s\0%s\0%s\0%s\0' "$1" "$gate" "$policy" "$runner" | sha256sum | cut -c1-64
}

cache_read() {
    local lines=()
    [[ -f $1 ]] || return 1
    mapfile -t lines <"$1"
    [[ ${#lines[@]} == 3 && ${lines[0]} == gate-evidence-v3 &&
        ${lines[1]} == "$policy" &&
        ${lines[2]} =~ \ passed:.*\ [0-9]+([.][0-9]+)?\ s\ in\ all$ &&
        ${lines[2]} != *'? s'* ]] || return 1
    printf '%s\n' "${lines[2]}"
}

# Recheck the effective tree (replacement refs can change it without moving
# HEAD) and the worktree's current administrative paths at every boundary.
candidate_check() {
    local expected=${1:-$candidate} status line oid='' head='' dirty=0 state current values checked=0
    local checks=()
    if ! status=$(git status --porcelain=v2 --branch --no-ahead-behind \
        --untracked-files=normal --ignore-submodules=none); then
        # Preserve the earlier HEAD/ref refusal when status itself cannot run.
        current=$(git rev-parse HEAD) || die 4 "candidate HEAD is unavailable; rerun land"
        [[ $(git symbolic-ref --quiet HEAD) == "$candidate_ref" && $current == "$expected" &&
            $(git rev-parse 'HEAD^{tree}') == "$tree" ]] ||
            die 4 "candidate HEAD or tree changed; rerun land"
        die 4 "candidate index/worktree cannot be checked; rerun land"
    fi
    while IFS= read -r line; do
        case $line in
        '# branch.oid '*) oid=${line#\# branch.oid } ;;
        '# branch.head '*) head=${line#\# branch.head } ;;
        '#'*) ;;
        *) dirty=1 ;;
        esac
    done <<<"$status"
    if values=$(git rev-parse 'HEAD^{tree}' --git-path rebase-merge --git-path rebase-apply --git-path MERGE_HEAD); then
        checked=1
    fi
    [[ -n $oid && $oid != '(initial)' ]] || die 4 "candidate HEAD is unavailable; rerun land"
    if [[ $head == '(detached)' ]]; then
        head=''
        # Git also permits this literal branch name. Only that ambiguous
        # header needs symbolic-ref to distinguish it from a detached HEAD.
        if [[ $candidate_ref == 'refs/heads/(detached)' ]]; then
            head=$(git symbolic-ref --quiet HEAD || true)
        fi
    else
        head=refs/heads/$head
    fi
    [[ $head == "$candidate_ref" && $oid == "$expected" && $checked == 1 ]] ||
        die 4 "candidate HEAD or tree changed; rerun land"
    mapfile -t checks <<<"$values"
    # The effective tree is always first, independent of path framing. Keep
    # its refusal and status's dirty refusal ahead of ambiguous state paths.
    [[ ${checks[0]} == "$tree" ]] || die 4 "candidate HEAD or tree changed; rerun land"
    ((dirty == 0)) || die 4 "candidate index/worktree changed; rerun land"
    # --git-path emits unquoted paths; validate framing before reading a path.
    ((${#checks[@]} == 4)) || die 4 "candidate merge/rebase state cannot be checked; rerun land"
    for state in "${checks[@]:1}"; do
        [[ ! -e $state ]] || die 4 "candidate merge/rebase state changed; rerun land"
    done
}

# Fixture barriers use the recovery fixture's isolated flag/path contract.
land_fault() {
    [[ -n ${HEAVY_FAULT_DIR:-} ]] || return 0
    python3 -I -S -B - "$1" "$tmp" "$HEAVY_FAULT_DIR" "${HEAVY_RECOVERY_FIXTURE:-}" <<'PYFAULT'
import os
from pathlib import Path
import sys
import time
point, temporary, directory, enabled = sys.argv[1:]
path = Path(directory).resolve()
if enabled != '1' or not path.is_relative_to(Path(temporary).resolve()):
    sys.exit('land: fault barriers require an isolated recovery fixture')
if (path / ('arm-' + point)).exists():
    (path / ('land-' + point)).write_text(str(os.getpid()))
    while not (path / ('continue-' + point)).exists():
        time.sleep(.02)
PYFAULT
}

policy_recheck() {
    candidate_check
    gate_policy_prepare || die 4 "the gate policy no longer validates; rerun land"
    [[ $SKEIN_GATE_POLICY_ID == "$policy" ]] || die 4 "the gate policy changed; evidence was not accepted"
    candidate_check
}

# Both exemptions use the candidate repository's tracked declaration. Literal
# paths ending in / cover descendants; no declaration preserves the old rules.
# Read Git objects, with NUL-delimited names, including deleted/renamed inputs.
docs_exempt() { # BEFORE AFTER docs|cache
    python3 -I -S -B - "$@" <<'PYDOCS'
import subprocess
import sys

before, after, mode = sys.argv[1:]
declaration = 'scripts/gated-docs'


def git(*args):
    return subprocess.check_output(['git', *args], stderr=subprocess.DEVNULL)


try:
    entries = git('ls-tree', '-z', after, '--', declaration)
    paths = []
    if entries:
        metadata, name = entries.rstrip(b'\0').split(b'\t', 1)
        if metadata.split()[0] not in (b'100644', b'100755'):
            raise ValueError('declaration must be a regular file')
        for line in git('show', after + ':' + declaration).decode().splitlines():
            path = line.strip()
            if not path or path.startswith('#'):
                continue
            parts = path.removesuffix('/').split('/')
            if any(part in ('', '.', '..') for part in parts) or '\0' in path:
                raise ValueError('expected repository-relative literal paths')
            paths.append(path.encode())
    changes = git('diff', '--no-renames', '--name-only', '-z', before, after)
    for path in changes.split(b'\0'):
        if not path:
            continue
        declared = any(path.startswith(p) if p.endswith(b'/') else path == p for p in paths)
        mockup = path.startswith(b'docs/design/') and b'mockups' in path.split(b'/')[2:-1]
        exempt = path.endswith(b'.md') and (mode == 'docs' or path.startswith(b'docs/'))
        if declared or not (exempt or (mode == 'docs' and mockup)):
            print('land: ' + repr(path.decode(errors='backslashreplace')) +
                  (' is a declared gate input; use land' if declared else
                   " is neither Markdown nor docs/design/'s mockups; use land"), file=sys.stderr)
            sys.exit(1)
except (OSError, ValueError, subprocess.CalledProcessError):
    print('land: cannot read scripts/gated-docs or changed paths; use land', file=sys.stderr)
    sys.exit(1)
PYDOCS
}

# The tip's Gate-Tree from an earlier try, with evidence still in the cache,
# holds across docs/ Markdown changes only outside declared gate inputs.
gated_before() {
    local tree=$1 before
    [[ $(git log -1 --format='%(trailers:key=Gate-Policy,valueonly,separator=)' "$candidate") == "$policy" ]] || return 1
    before=$(git log -1 --format='%(trailers:key=Gate-Tree,valueonly,separator=)' "$candidate")
    [[ -n $before && $before != "$tree" ]] || return 1
    cache_read "$cache_dir/$(gate_key "$before")" >/dev/null || return 1
    docs_exempt "$before" "$tree" cache 2>/dev/null || return 1
    echo "$before"
}

# The build lane's pass before the gate (build-infrastructure.md, 10).
prebuild_command='cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo nextest run --workspace --no-run'
prebuild=${LAND_PREBUILD-$prebuild_command}

# A plain run (build-infrastructure.md 12): land's own child, with its
# own log and elapsed time. Keep the summary for land's result as well.
plain_run() { # KIND COMMAND
    local kind=$1 command=$2 started ended elapsed status=0
    # Called under ||: guard infrastructure failures explicitly as well.
    mkdir -p "$tmp/logs/land" || die 4 "cannot create the plain $kind log directory"
    plain_log=$(mktemp "$tmp/logs/land/$repo-$kind.XXXXXX.log") ||
        die 4 "cannot create the plain $kind log"
    if ! started=$(date +%s%N) || [[ ! $started =~ ^[0-9]+$ ]]; then
        die 4 "cannot measure the plain $kind start; nothing ran"
    fi
    bash -c "$command" </dev/null >"$plain_log" 2>&1 || status=$?
    if ! ended=$(date +%s%N) || [[ ! $ended =~ ^[0-9]+$ ]]; then
        die 4 "cannot measure the plain $kind end; evidence was not accepted"
    fi
    elapsed=$((ended - started))
    ((elapsed >= 0)) || die 4 "the clock moved backwards; plain $kind evidence was not accepted"
    printf -v plain_seconds '%d.%03d' "$((elapsed / 1000000000))" "$((elapsed % 1000000000 / 1000000))"
    tail -n 60 "$plain_log" || die 4 "cannot read the plain $kind log"
    plain_heard="land: plain $kind exit $status, ran $plain_seconds s, log $plain_log"
    echo "$plain_heard"
    return "$status"
}

# Heavy's token-owned receipt is its completion evidence (gate-policy.md
# 3); plain gates use land's own log and timing (3.2). Keep validation and
# the shared summary here so they are included in the policy identity.
evidence() {
    python3 -I -S -B - "$tree" "$policy" "$gate" "$@" <<'PY'
from decimal import Decimal
import hashlib
import json
import math
import os
from pathlib import Path
import re
import stat
import sys


def require(condition, reason):
    if not condition:
        raise ValueError(reason)


def read_regular(path, kind):
    # O_NOFOLLOW also closes the check/open race for the selected file.
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as source:
            require(stat.S_ISREG(os.fstat(source.fileno()).st_mode),
                    f"{kind} is not a regular file")
            return source.read()
    except OSError:
        raise ValueError(f"{kind} is missing, unreadable or a symlink") from None


def unique_fields(pairs):
    result = {}
    for key, value in pairs:
        require(key not in result, "receipt JSON has duplicate fields")
        result[key] = value
    return result


def invalid_constant(value):
    raise ValueError("receipt JSON has a non-finite number")


def receipt_evidence(output, tree, policy, command):
    lines = Path(output).read_text().splitlines()
    headers = [line for line in lines if line.startswith("heavy: queued task ")]
    receipts = [line for line in lines if line.startswith("heavy: receipt ")]
    require(len(headers) == 1, "expected exactly one queued gate header")
    header = re.fullmatch(r"heavy: queued task ([0-9]+) in the gate lane token ([0-9a-f]{32})", headers[0])
    require(header is not None, "malformed queued gate header or non-gate lane")
    task_id, token = header.groups()
    require(len(receipts) == 1, "expected exactly one receipt line")
    selected = re.fullmatch(r"heavy: receipt (/.+) token ([0-9a-f]{32})", receipts[0])
    require(selected is not None, "malformed receipt line")
    require(lines[-1] == receipts[0], "receipt line must be the final heavy output")
    receipt_path, receipt_token = selected.groups()
    require(receipt_token == token, "receipt line token differs from queued gate token")
    require(Path(receipt_path).name == token + ".json", "receipt filename differs from queued gate token")
    try:
        receipt = json.loads(read_regular(receipt_path, "receipt"),
                             object_pairs_hook=unique_fields, parse_constant=invalid_constant)
    except (json.JSONDecodeError, UnicodeError, RecursionError):
        raise ValueError("receipt JSON is malformed") from None
    fields = {"schema", "token", "id", "queue", "lane", "tree", "policy", "args",
              "outcome", "code", "payload_started", "payload_ended", "release_complete",
              "cgroup_empty", "elapsed_s", "log", "log_sha256"}
    # heavy adds the checkout's head and inputs when it can read them
    # (receipt_inputs.py); land checks only their form.
    optional = {"head", "inputs"}
    require(type(receipt) is dict and fields <= receipt.keys() <= fields | optional,
            "receipt schema fields are invalid")
    for field in sorted(optional & receipt.keys()):
        require(type(receipt[field]) is str and
                re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", receipt[field]) is not None,
                f"receipt {field} is malformed")
    expected = {"schema": "heavy-receipt-v1", "token": token, "id": task_id,
                "lane": "gate", "tree": tree, "policy": policy,
                "args": ["bash", "-c", command], "outcome": "completed"}
    for field, value in expected.items():
        require(receipt[field] == value, f"receipt {field} differs from requested gate")
    require(re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", receipt["tree"]) is not None,
            "receipt tree is malformed")
    require(re.fullmatch(r"sha256:[0-9a-f]{64}", receipt["policy"]) is not None,
            "receipt policy is malformed")
    require(type(receipt["queue"]) is str and bool(receipt["queue"].strip()),
            "receipt queue identity is missing")
    require(type(receipt["code"]) is int and receipt["code"] == 0, "receipt code is not zero")
    for field in ("payload_started", "payload_ended", "release_complete", "cgroup_empty"):
        require(receipt[field] is True, f"receipt {field} is not true")
    elapsed = receipt["elapsed_s"]
    require(type(elapsed) in (int, float), "receipt elapsed_s is not numeric")
    require((type(elapsed) is int or math.isfinite(elapsed)) and elapsed >= 0,
            "receipt elapsed_s is not finite and nonnegative")
    log = receipt["log"]
    require(type(log) is str and Path(log).is_absolute() and Path(log).name == token + ".log",
            "receipt log path does not name the token-owned absolute log")
    digest = receipt["log_sha256"]
    require(type(digest) is str and re.fullmatch(r"[0-9a-fA-F]{64}", digest) is not None,
            "receipt log_sha256 is malformed")
    contents = read_regular(log, "receipt log")
    require(hashlib.sha256(contents).hexdigest() == digest.lower(), "receipt log SHA-256 differs")
    return contents, elapsed


def main():
    tree, policy, command, mode, path, *seconds = sys.argv[1:]
    if mode == "receipt":
        contents, elapsed = receipt_evidence(path, tree, policy, command)
    else:
        contents = read_regular(path, "plain log")
        elapsed = Decimal(seconds[0])
        require(elapsed.is_finite() and elapsed >= 0, "plain elapsed time is invalid")
    # Both runners summarize the selected bytes without reopening the log.
    text = re.sub(r"\x1b\[[0-9;]*m", "", contents.decode("utf-8", errors="replace"))
    summaries = re.findall(r"^ *Summary \[ *([0-9]+(?:\.[0-9]+)?)s\] [0-9]+ tests? run: ([0-9]+) passed.*$",
                           text, re.MULTILINE)
    parts = [f"{count} tests / {seconds} s" for seconds, count in summaries]
    parts.append(f"{format(Decimal(str(elapsed)), 'f')} s in all")
    label = "gate" if any(char.isspace() for char in command) else command
    print(f"{label} passed: " + "; ".join(parts))


try:
    main()
except (OSError, UnicodeError, ValueError):
    # Field-specific errors contain no command, environment or JSON values.
    error = sys.exc_info()[1]
    reason = str(error) if isinstance(error, ValueError) and not isinstance(error, UnicodeError) else "receipt evidence could not be read or decoded"
    print("land: invalid gate receipt: " + reason, file=sys.stderr)
    sys.exit(1)
PY
}

# heavy's own lines in $out, for land's result.
heard() { grep -E '^heavy: (task|receipt) ' "$out" 2>/dev/null || true; }

# The landing's record in the landing feed (landing-flow.md, 12), once its
# push has succeeded. It never changes land's status.
land_feed() {
    local logs=()
    if [[ -n ${gate_log:-} ]]; then logs=("$gate_log"); fi
    python3 -I -S -B "$kit/land-feed.py" land "$repo" "$branch" "$base" "$1" "${logs[@]}" ||
        echo "land: warning: the landing feed was not written" >&2
}

# land's result (landing-flow.md, 10), at its exit once it has rebased: one
# line on stdout and, when LAND_RESULT is set, the same JSON in that file.
# Building or writing it never changes land's status or its other output.
land_result() {
    python3 -I -S -B - "$1" "${repo:-}" "${base:-}" "${tip:-}" "${tree:-}" "$((try < tries ? try : tries))" \
        "${prebuild_heard:-}" "${gate_kind:-}" "${gate_heard:-}" "${pushed:-false}" "${result_file:-}" "$2" <<'PYRESULT' ||
import json
import os
import re
import socket
import sys


def task(heard):
    # heavy's summary of its task: its times and exit, and its log.
    lines = [line for line in heard.splitlines() if line.startswith("heavy: task ")]
    found = lines and re.fullmatch(r"heavy: task [0-9]+ \(\S+\) exit (-?[0-9]+), "
                                   r"waited ([0-9]+(?:\.[0-9]+)?)s, ran ([0-9]+(?:\.[0-9]+)?)s, log (.+)",
                                   lines[-1])
    if not found:
        plain = re.fullmatch(r"land: plain (?:build|gate) exit ([0-9]+), ran ([0-9]+\.[0-9]+) s, log (.+)", heard)
        if plain:
            return {"wait_s": 0, "run_s": float(plain[2]), "exit": int(plain[1])}, plain[3]
        return None, None
    seconds = [float(found[n]) for n in (2, 3)]
    wait, run = (int(value) if value.is_integer() else value for value in seconds)
    return {"wait_s": wait, "run_s": run, "exit": int(found[1])}, found[4]


def steps(log):
    # The gate-step lines' seconds summed by name, in first-seen order, and
    # CPU seconds where present, the first failed step, and starved passes.
    sums, cpu, failed, starved = {}, {}, None, {}
    try:
        from pathlib import Path
        text = Path(log).read_text(errors="replace")
    except OSError:
        return sums, cpu, failed, list(starved)
    for line in text.splitlines():
        match = re.fullmatch(r"gate-starved (.+)", line)
        if match:
            starved[match[1]] = None
        step = re.fullmatch(r"gate-step (\S+) ([0-9]+(?:\.[0-9]+)?) ([0-9]+)(?: ([0-9]+(?:\.[0-9]+)?))?", line.rstrip())
        if step:
            sums[step[1]] = round(sums.get(step[1], 0) + float(step[2]), 3)
            if step[4] is not None:
                cpu[step[1]] = round(cpu.get(step[1], 0) + float(step[4]), 3)
            if failed is None and int(step[3]):
                failed = step[1]
    return sums, cpu, failed, list(starved)


def main():
    status, repo, base, tip, tree, tries, prebuild, kind, heard, pushed, path, runner = sys.argv[1:]
    gate = None
    starved = []
    if kind in ("cached", "none"):
        gate = {"kind": kind, "receipt": None, "wait_s": 0, "run_s": 0, "exit": 0,
                "steps": {}, "cpu": {}, "failed_step": None}
    elif kind == "ran":
        ran, log = task(heard)
        if ran:
            receipts = re.findall(r"^heavy: receipt .* token ([0-9a-f]{32})$", heard, re.MULTILINE)
            sums, cpu, failed, starved = steps(log)
            gate = {"kind": "ran", "receipt": receipts[-1] if receipts else None, **ran,
                    "steps": sums, "cpu": cpu, "failed_step": failed or ("other" if ran["exit"] else None)}
    result = {"schema": "land-result-v1", "repo": repo, "machine": socket.gethostname(),
              "runner": runner or None,
              "base": base or None, "commit": tip or None, "tree": tree or None,
              "tries": int(tries), "prebuild": task(prebuild)[0], "gate": gate,
              "pushed": pushed == "true", "exit": int(status), "starved": starved[:50]}
    if len(starved) > 50:
        result["starved_more"] = len(starved) - 50
    text = json.dumps(result, separators=(",", ":"))
    print("land: result " + text, flush=True)
    if path:
        from pathlib import Path
        import tempfile
        # Written whole: a reader sees the old file or the new one.
        target = Path(path)
        fd, temporary = tempfile.mkstemp(dir=target.parent, prefix="." + target.name + ".")
        try:
            with os.fdopen(fd, "w") as out:
                out.write(text + "\n")
            os.replace(temporary, target)
        except BaseException:
            os.unlink(temporary)
            raise


try:
    main()
except Exception as error:
    print(f"land: warning: the result was not written: {type(error).__name__}", file=sys.stderr)
PYRESULT
        echo "land: warning: the result was not written" >&2
}

land_cleanup() {
    git config "branch.$branch.landed" "$commit" ||
        echo "land: warning: cannot mark $branch landed" >&2
    python3 -S -B "$kit/tidy-hooks.py" "$top" "$tmp" "$repo" ||
        echo "land: warning: cleanup could not start" >&2
}

# The resolver finishes the rebase, or leaves it stopped or undone.
resolve_rebase() {
    local lines status=0
    lines=$(python3 -I -B "$kit/land-resolve.py" .) || status=$?
    if [[ -n $lines ]]; then
        while IFS= read -r line; do echo "land: $line" >&2; done <<<"$lines"
    fi
    return "$status"
}

try=0 pushed=false
while :; do
    try=$((try + 1))
    ((try <= tries)) || die 6 "main moved $tries times; giving up"
    prebuild_heard='' gate_kind='' gate_heard='' gate_log=''

    if [[ -n ${commit:-} ]]; then candidate_check "$commit"; fi
    if ((local)); then
        base=$(git rev-parse main)
    elif [[ -n ${LAND_SET_BASE:-} ]]; then
        base=$(git rev-parse --verify "$LAND_SET_BASE^{commit}")
    else
        fetch
        base=$(git rev-parse origin/main)
    fi
    if ! git rebase --quiet "$base" && ! resolve_rebase; then
        if [[ -d $(git rev-parse --git-path rebase-merge) || -d $(git rev-parse --git-path rebase-apply) ]]; then
            die 3 "the rebase on $(git rev-parse --short "$base") stopped on conflicts. \
Resolve them, run git rebase --continue, then land again."
        fi
        die 3 "the rebase on $(git rev-parse --short "$base") could not be settled (the lines above say why), and was undone: \
rebase on it by hand, resolve it, then land again."
    fi
    trap 'land_result "$?" "$runner"' EXIT
    candidate=$(git rev-parse HEAD)
    [[ $candidate != "$base" ]] ||
        die 2 "nothing to land: the branch has no commits beyond main"
    tip=$candidate
    candidate_ref=refs/heads/$branch
    tree=$(git rev-parse "$candidate^{tree}")
    candidate_check
    if ((docs)); then
        docs_exempt "$base" "$candidate" docs ||
            die 2 "--docs includes gate inputs; use land"
        summary="none (Markdown and mockups only)"
        policy="none (Markdown and mockups only)"
        gated=$tree
        gate_kind=none
    else
        [[ $gate != scripts/check.sh || -x $gate ]] ||
            die 2 "no scripts/check.sh: give the gate with --gate (see the repository's workflow)"
        export SKEIN_GATE_COMMAND=$gate
        gate_policy_prepare || die 2 "cannot prepare the gate runtime policy"
        policy=$SKEIN_GATE_POLICY_ID
        candidate_check
        cache_dir=$tmp/gates/$repo
        cache=$cache_dir/$(gate_key "$tree")
        gated=$tree
        gate_kind=cached
        if summary=$(cache_read "$cache"); then
            :
        elif gated=$(gated_before "$tree"); then
            summary=$(cache_read "$cache_dir/$(gate_key "$gated")")
            echo "land: the gate passed on $gated, which differs from this tree only in docs/ Markdown" >&2
        elif [[ ${LAND_PROVED:-0} == 1 ]]; then
            die 10 "main moved since the proof, so its gate no longer holds; nothing landed"
        else
            gated=$tree
            gate_kind=ran
            if [[ $runner == heavy ]]; then out=$(mktemp); fi
            if [[ -n $prebuild && -f Cargo.toml ]]; then
                if [[ $runner == plain ]]; then
                    status=0
                    plain_run build "$prebuild" || status=$?
                    prebuild_heard=$plain_heard
                    ((status == 0)) || die 4 "the build or its lints failed on $(git rev-parse --short HEAD), plainly; the gate did not run"
                else
                    if HEAVY_LABEL="land $repo prebuild" python3 -S -B "$kit/land-capture.py" "$out" "$kit/heavy" --tail 60 bash -c "$prebuild"; then
                        prebuild_heard=$(heard)
                    else
                        capture_status=$?
                        prebuild_heard=$(heard)
                        if ((capture_status == 74)); then
                            rm -f "$out"
                            die 4 "the build capture is unavailable; nothing landed; rerun land"
                        fi
                        cat "$out"
                        if ! grep -qE '^heavy: (queued )?task [0-9]+ ' "$out" ||
                        grep -qx 'heavy: disk floor refused before payload start' "$out"; then
                            rm -f "$out"
                            die 9 "heavy refused to run the build on $(git rev-parse --short HEAD), so nothing ran (its reason above); land again once that is put right"
                        fi
                        rm -f "$out"
                        die 4 "the build or its lints failed on $(git rev-parse --short HEAD), in the build lane; the gate did not run"
                    fi
                    grep '^heavy: task ' "$out" | tail -n1 >&2 || true
                fi
            fi
            policy_recheck
            if [[ $runner == plain ]]; then
                status=0
                plain_run gate "$gate" || status=$?
                gate_heard=$plain_heard
                gate_log=$plain_log
                ((status == 0)) || die 4 "the gate failed on $(git rev-parse --short HEAD)"
            else
                if HEAVY_LABEL="land $repo" python3 -S -B "$kit/land-capture.py" "$out" "$kit/heavy" --land --tail 60 bash -c "$gate"; then
                    gate_heard=$(heard)
                else
                    capture_status=$?
                    gate_heard=$(heard)
                    if ((capture_status == 74)); then
                        rm -f "$out"
                        die 4 "the gate capture is unavailable; nothing landed; rerun land"
                    fi
                    cat "$out"
                    if ! grep -qE '^heavy: (queued )?task [0-9]+ ' "$out" ||
                        grep -qx 'heavy: disk floor refused before payload start' "$out"; then
                        rm -f "$out"
                        die 9 "heavy refused to run the gate on $(git rev-parse --short HEAD), so nothing ran (its reason above); land again once that is put right"
                    fi
                    rm -f "$out"
                    die 4 "the gate failed on $(git rev-parse --short HEAD)"
                fi
                cat "$out"
                gate_log=$(sed -nE 's/^heavy: task [0-9]+ \([^)]*\) exit -?[0-9]+, waited [0-9.]+s, ran [0-9.]+s, log //p' <<<"$gate_heard" | tail -n1)
            fi
            land_fault after_receipt
            candidate_check
            if [[ $runner == plain ]]; then
                summary=$(evidence plain "$plain_log" "$plain_seconds") ||
                    die 4 "the plain gate evidence was not accepted; nothing landed"
            else
                if ! summary=$(evidence receipt "$out"); then
                    rm -f "$out"
                    die 4 "the gate completion evidence was not accepted; nothing landed"
                fi
                rm -f "$out"
            fi
            policy_recheck
            candidate_check
            mkdir -p "$(dirname "$cache")"
            cache_tmp=$(mktemp "$cache_dir/.evidence.XXXXXX")
            printf 'gate-evidence-v3\n%s\n%s\n' "$policy" "$summary" >"$cache_tmp"
            mv -f "$cache_tmp" "$cache"
        fi
        policy_recheck
    fi

    # Construct the amendment from the verified object, then compare-and-swap
    # its branch. A concurrent HEAD can never supply the tree being pushed.
    candidate_check
    original_message=$(git log -1 --format=%B "$candidate")
    runner_trailer=()
    if ((!docs)); then runner_trailer=(--trailer "Gate-Runner: $runner"); fi
    message=$(printf '%s\n' "$original_message" |
        git interpret-trailers --if-exists replace \
            --trailer "Gate-Tree: $gated" --trailer "Gate-Result: $summary" \
            --trailer "Gate-Policy: $policy" "${runner_trailer[@]}")
    commit=$candidate
    if [[ $message != "$original_message" ]]; then
        metadata=$(git show -s --format='%P%n%an%n%ae%n%aI' "$candidate")
        mapfile -t author_parent <<<"$metadata"
        read -r -a parents <<<"${author_parent[0]}"
        parent_args=()
        for parent in "${parents[@]}"; do parent_args+=(-p "$parent"); done
        commit=$(GIT_AUTHOR_NAME="${author_parent[1]}" \
            GIT_AUTHOR_EMAIL="${author_parent[2]}" \
            GIT_AUTHOR_DATE="${author_parent[3]}" \
            git commit-tree "$tree" "${parent_args[@]}" <<<"$message")
    fi
    [[ $(git rev-parse "$commit^{tree}") == "$tree" ]] || die 4 "amended tree differs; rerun land"
    candidate_check
    land_fault before_candidate_cas
    git update-ref "$candidate_ref" "$commit" "$candidate" ||
        die 4 "candidate ref changed during amendment; rerun land"
    tip=$commit
    candidate_check "$commit"
    land_fault before_push
    candidate_check "$commit"

    if ((no_push)); then
        where="not pushed"
        break
    fi

    if ((local)); then
        exec 9>"$lock"
        flock 9
        if [[ $(git rev-parse main) != "$base" ]]; then
            flock -u 9
            echo "land: main moved; again" >&2
            continue
        fi
        candidate_check "$commit"
        status=0
        follow "$commit" || status=$?
        flock -u 9
        ((status == 0)) || die 5 "nothing landed: a checkout of main has changes"
        where="local main"
        break
    fi

    if ! err=$(git push --quiet origin "$commit:refs/heads/main" 2>&1); then
        if grep -qE 'non-fast-forward|fetch first|stale info|cannot lock ref|reference already exists' <<<"$err"; then
            echo "land: main moved on origin; again" >&2
            continue
        fi
        die 7 "the push failed: $err"
    fi
    where="origin/main" pushed=true
    land_feed "$commit"
    exec 9>"$lock"
    flock 9
    status=0
    follow "$commit" || status=$?
    flock -u 9
    land_cleanup
    case $status in
    0) ;;
    1) die 5 "landed $commit on origin/main, but a checkout of main has changes and did not follow" ;;
    *) die 5 "landed $commit on origin/main, but the local main has commits origin lacks: reconcile it" ;;
    esac
    break
done

if ((local)); then land_cleanup; fi

location="on $where"
if ((no_push)); then location="not pushed"; fi
cat <<EOF
land: landed $repo $branch $location
  commit  $commit
  parent  $base
  tree    $tree${gated:+$([[ $gated == "$tree" ]] || printf ', gated as %s' "$gated")}
  gate    $summary
EOF
