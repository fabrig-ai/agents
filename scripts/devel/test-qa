        + f'child = subprocess.Popen([{sys.executable!r}, "-S", "-c", "import time; time.sleep(60)"])\n'
          "Path('export-pids').write_text(f'{os.getpid()} {child.pid}')\n"
          'time.sleep(60)\n')
    started = time.monotonic()
    lab.run('_give-back', str(directory), '2')
