    assert all(state['finished'] and state['released'] for _, state in lab.watch_states())
    assert {state['repository'] for _, state in lab.watch_states()} == {'temper', 'jig'}
    temper = next(state for _, state in lab.watch_states() if state['repository'] == 'temper')
