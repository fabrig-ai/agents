tool['Repositories'].checkout = checkout
""")
    assert 'temper: preparation failed' in result.stdout and 'symlink refused' in result.stdout
    assert marker.read_text() == 'outside contents\n' and sorted(p.name for p in outside.iterdir()) == ['keep']
    assert not lab.calls('codex-run')
    path = qa / 'repos/temper-2'
    assert path.is_symlink()
    path.unlink()
    # A qa link appearing after the watch lock is acquired is logged per repository.
    result = driven_watch(lab, f"""from contextlib import contextmanager
original = tool['Repositories'].fetched
@contextmanager
def fetched(self, repo):
    qa = self.workspace.tmp / 'qa'
    backup = self.workspace.tmp / 'saved-qa'
    qa.rename(backup)
    qa.symlink_to({str(outside)!r}, target_is_directory=True)
    try:
        with original(self, repo) as root:
            yield root
    finally:
        qa.unlink()
        backup.rename(qa)
tool['Repositories'].fetched = fetched
""")
    assert 'temper: preparation failed' in result.stdout and 'symlink refused' in result.stdout
    # Check the anchor, qa, repos, and the slot itself before a direct preparation.
    driven_watch(lab, f"""workspace = tool['Workspace']()
repositories = tool['Repositories'](workspace)
for relative in ('qa', 'qa/repos', 'qa/repos/temper-2', ''):
    path = workspace.tmp / relative
    backup = path.with_name(path.name + '-before-link')
    existed = path.exists()
    if existed:
        path.rename(backup)
    path.symlink_to({str(outside)!r}, target_is_directory=True)
    try:
        repositories.checkout(workspace.tmp / 'qa/repos/temper', 'temper', 2, 'HEAD')
    except tool['Problem'] as error:
        assert 'symlink refused' in str(error)
    else:
        raise AssertionError('linked component accepted: ' + relative)
    finally:
