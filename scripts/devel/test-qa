                       "if sys.argv[1] == 'commit':\n print('fixture record refusal', file=sys.stderr)\n sys.exit(2)\n"
                       f'sys.exit(subprocess.run([{str(KIT / "record")!r}, *sys.argv[1:]]).returncode)\n')
