    try:
        return Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[0] != 'Z'
    except FileNotFoundError:
        return False

def stop_group(pid):
    try:
        os.killpg(pid, signal.SIGTERM)
        deadline = time.monotonic() + 0.5
        while alive(pid) and time.monotonic() < deadline:
            time.sleep(0.01)
