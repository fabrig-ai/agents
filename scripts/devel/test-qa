def deeply_nested_and_oversized_states_keep_custody_without_stopping_checks(lab):
    lab.walk('b0', '--login', CHATGPT)
    lab.walk('b1', '--kind', 'claude', '--login', CLAUDE)
    _, broken_walk = lab.walk_states()[0]
    lab.rung('temper', REAL, CHATGPT)
    lab.waiting(1)
    lab.watch()
    directory, broken_pass = lab.watch_state()
    walk_path = lab.tmp / 'qa/walks' / (broken_walk['walk'] + '.json')
    pass_path = directory / 'pass.json'
    nested = '[' * 40001 + '0' + ']' * 40001
    oversized = ' ' * (1024 * 1024) + '{}'
    walk_path.write_text(nested)
    pass_path.write_text(oversized)
    jig = lab.commit('jig alongside damaged states', 'fixture', repo='jig')
    lab.run('decide', 'jig', jig, 'run')
    lab.configure(cleared={'jig': jig}, inactive=True)
    result = lab.watch()
    assert 'invalid walk state; keeping custody' in result.stdout
    assert 'invalid pass state; keeping custody' in result.stdout
    good_walk = json.loads((lab.tmp / 'qa/walks/rung-b1-claude-1.json').read_text())
    assert good_walk['stage'] == 'ended' and good_walk['given'] == [CLAUDE]
    jig_path, = (p for p in (lab.tmp / 'qa').glob('*/pass.json') if p != pass_path)
    good_pass = json.loads(jig_path.read_text())
    assert good_pass['repository'] == 'jig' and good_pass['run'] and not good_pass['finished']
    # The same isolation covers either parser, integer conversion and an over-limit read.
    lab.configure(inactive=False)
    for walk_data, pass_data in ((oversized, nested), ('{"n":' + '9' * 5000 + '}', '{broken json'),
                                 (nested, json.dumps(dict(broken_pass, kinds=[])))):
        walk_path.write_text(walk_data)
        pass_path.write_text(pass_data)
        result = lab.watch(extra={'QA_CAP_MINUTES': '0'})
        assert 'invalid walk state; keeping custody' in result.stdout
        assert 'invalid pass state; keeping custody' in result.stdout
    good_pass = json.loads(jig_path.read_text())
    assert good_pass['finished'] and good_pass['capped'] and good_pass['released']
    config = json.loads((lab.root / 'tools.json').read_text())
    assert config['login_holders'][CHATGPT] == broken_walk['holder']
    assert config['login_holders']['chatgpt-2'] == broken_pass['holder']
    assert not any(args[0] == 'give' and args[1] in (CHATGPT, 'chatgpt-2') for args in lab.calls('logins'))


def a_walk_resolves_remote_branches_despite_colliding_tags(lab):
    old = lab.git(lab.products['temper'], 'rev-parse', 'HEAD')
    main = lab.marked()
    fix = lab.commit('remote fix', branch='fix')
    origin = lab.origins / 'temper.git'
