def command(argv, cwd=None, timeout=None, pass_fds=()):
    name = str(argv[0]).rsplit('/', 1)[-1]
    expected = {'git': 300, 'record': 300, 'systemctl': 30, 'logins': 60,
                'post': 60, 'landings': 120, 'codex-run': 120}
