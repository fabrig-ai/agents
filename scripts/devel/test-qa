def deploy_stops_a_real_unit_by_its_give_back_first(lab):
    lab.env.pop('QA_SYSTEMD_RUN')
    lab.env.pop('QA_SYSTEMCTL')
    # The manager belongs to the caller; all qa state still belongs to the Lab.
    lab.env.update({key: os.environ[key] for key in ('XDG_RUNTIME_DIR', 'DBUS_SESSION_BUS_ADDRESS')
                    if key in os.environ})
    manager = subprocess.run(['systemctl', '--user', 'is-system-running'], env=lab.env,
                             capture_output=True, text=True, timeout=30)
    if manager.returncode != 0 and manager.stdout.strip() not in ('running', 'degraded'):
        print('skipped: no user manager')
        return
    directory = lab.root / ('qa-fixture-' + os.urandom(8).hex())
    directory.mkdir()
    assert not any(c in str(directory) for c in '$%"\\ \t\n')
    executable(directory / 'give-back', 'import os\nfrom pathlib import Path\n'
        + f'pid = int(Path({str(directory / "pid")!r}).read_text())\n'
          'try:\n'
          '    os.kill(pid, 0)\n'
          '    state = "alive"\n'
          'except ProcessLookupError:\n'
          '    state = "gone"\n'
        + f'Path({str(directory / "give-back-state")!r}).write_text(state)\n')
    unit = f'qa-{directory.name}-sleeper'
    try:
        assert lab.run('deploy', str(directory), 'sleeper', '--', '/bin/sh', '-c',
                       'echo $$ > pid; exec sleep 600').stdout == unit + '\n'
        pid_file = directory / 'pid'
        wait_for(lambda: pid_file.exists() and pid_file.read_text().strip())
        pid = int(pid_file.read_text())
        assert alive(pid)
        stopped = subprocess.run(['systemctl', '--user', 'stop', unit], env=lab.env,
                                 capture_output=True, text=True, timeout=120)
        assert stopped.returncode == 0, stopped.stderr
        assert (directory / 'give-back-state').read_text() == 'alive'
        dead(pid)
        lines = (directory / 'give-back.log').read_text().splitlines()
        assert lines and lines[-1].endswith(' exit 0'), lines
    finally:
        try:
            subprocess.run(['systemctl', '--user', 'stop', unit], env=lab.env,
                           capture_output=True, timeout=120)
        finally:
            subprocess.run(['systemctl', '--user', 'reset-failed', unit], env=lab.env,
                           capture_output=True, timeout=30)


