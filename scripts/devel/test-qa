    assert 'symlink refused' in result.stderr and sorted(p.name for p in outside.iterdir()) == ['keep']
    qa.unlink()
    # Refusal inside the repository boundary also catches a link appearing later.
    lab.env['QA_SLOTS'] = '2'
    result = driven_watch(lab, f"""original = tool['Repositories'].checkout
def checkout(self, root, repo, slot, main):
    if slot == 2:
        path = root.with_name(repo + '-2')
        path.symlink_to({str(outside)!r}, target_is_directory=True)
