def driven_watch(lab, patch):
    driver = f'''import runpy, sys
tool = runpy.run_path({str(SCRIPT)!r})
{patch}
sys.exit(tool['main']())
'''
    result = subprocess.run([sys.executable, '-I', '-S', '-c', driver, 'watch', '--director',
                             'director@fixture', '--once'], env=lab.env, capture_output=True,
                            text=True, timeout=HUNG_TOOL_S)
    assert result.returncode == 0, (result.stdout, result.stderr)
    return result


