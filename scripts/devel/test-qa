def ambiguous_prefix_is_refused(lab):
    checkout = lab.products['temper']
    parent = lab.git(checkout, 'rev-parse', 'HEAD')
    tree = lab.git(checkout, 'rev-parse', 'HEAD^{tree}')
    seen = {}
    for nonce in range(200000):
        data = (f'tree {tree}\nparent {parent}\nauthor Fixture <fixture@invalid> 1792972800 +0000\n'
                f'committer Fixture <fixture@invalid> 1792972800 +0000\n\ncollision {nonce}\n\nQA: feature\n').encode()
        sha = hashlib.sha1(b'commit ' + str(len(data)).encode() + b'\0' + data).hexdigest()
        prefix = sha[:7]
        if prefix in seen:
            pair = (seen[prefix], data)
            break
        seen[prefix] = data
    else:
        raise AssertionError('fixture found no 7-digit prefix collision')
    for index, data in enumerate(pair):
        result = subprocess.run(['git', '-C', str(checkout), 'hash-object', '-w', '-t', 'commit', '--stdin'],
                                input=data, env=lab.env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=HUNG_TOOL_S)
        assert result.returncode == 0, result.stderr
        sha = result.stdout.decode().strip()
        lab.git(checkout, 'update-ref', 'refs/heads/collision-' + str(index), sha)
        lab.git(checkout, 'push', 'origin', 'collision-' + str(index))
    old = lab.head()
    assert 'ambiguous commit' in lab.run('decide', 'temper', prefix, 'run', status=2).stderr
    assert lab.head() == old and not (lab.records / 'qa/decisions.md').exists()


