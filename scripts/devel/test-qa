#!/usr/bin/env -S python3 -S
"""Offline QA fixtures, each selectable by name in a fresh Lab."""
from datetime import datetime, timedelta, timezone
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import traceback

os.umask(0o077)
KIT = Path(__file__).resolve().parent
SCRIPT = KIT / 'qa'
REPOS = ('skein', 'smith', 'hearth', 'jig', 'temper')
P = '20261026-0915-temper'


class Lab:
    def __init__(self, root):
        self.root = root
        self.home, self.tmp, self.records = (root / n for n in ('home', 'tmp', 'records'))
        self.origins = root / 'origins'
        self.post_log = root / 'post.jsonl'
        self.post = root / 'post'
        for path in (self.home, self.tmp, self.records, self.origins):
            path.mkdir()
        self.env = dict(PATH=os.environ['PATH'], HOME=str(self.home), DEV_ROOT=str(root),
                        DEV_TMP=str(self.tmp), RECORDS=str(self.records), QA_FIXTURE=str(root),
                        QA_RECORD=str(KIT / 'record'), QA_POST=str(self.post),
                        QA_POST_LOG=str(self.post_log), QA_POST_STATUS='0',
                        USER='fixture', POST_NAME='o/fixture', RECORD_TIDY='',
                        GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@invalid',
                        GIT_ALLOW_PROTOCOL='file', LC_ALL='C.UTF-8')
        # Keep command-scope policy, then disable all automatic maintenance in scratch.
        self.env.update({k: v for k, v in os.environ.items()
                         if k == 'GIT_CONFIG_COUNT' or k.startswith(('GIT_CONFIG_KEY_', 'GIT_CONFIG_VALUE_'))})
        count = int(self.env.get('GIT_CONFIG_COUNT', '0'))
        for index, (key, value) in enumerate((('maintenance.auto', 'false'), ('gc.auto', '0'),
                                             ('fetch.autoMaintenance', 'false'), ('receive.autogc', 'false'))):
            self.env[f'GIT_CONFIG_KEY_{count + index}'] = key
            self.env[f'GIT_CONFIG_VALUE_{count + index}'] = value
        self.env['GIT_CONFIG_COUNT'] = str(count + 4)
        self.post.write_text(f'#!{sys.executable} -S\nimport json, os, sys\nfrom pathlib import Path\n'
                             "with Path(os.environ['QA_POST_LOG']).open('a') as log:\n"
                             " log.write(json.dumps(dict(args=sys.argv[1:], body=Path(sys.argv[4]).read_text())) + '\\n')\n"
                             "sys.exit(int(os.environ['QA_POST_STATUS']))\n")
        self.post.chmod(0o700)
        self.git(self.records, 'init', '-b', 'main')
        self.put('STATUS.md', '# Status\n')
        self.put('director/backlog.md', '# Backlog\n')
        self.git(self.records, 'add', '.')
        self.git(self.records, 'commit', '-m', 'records baseline')
        self.origin = root / 'records.git'
        self.git(root, 'clone', '--bare', str(self.records), str(self.origin))
        self.git(self.records, 'remote', 'add', 'origin', str(self.origin))
        self.git(self.records, 'fetch', 'origin')
        self.products = {}
        self.serial = 0
        for repo in REPOS:
            checkout = root / repo
            self.git(root, 'init', '-b', 'main', str(checkout))
            self.git(checkout, 'commit', '--allow-empty', '-m', 'unmarked baseline')
            origin = self.origins / (repo + '.git')
            self.git(root, 'clone', '--bare', str(checkout), str(origin))
            self.git(checkout, 'remote', 'add', 'origin', str(origin))
            self.products[repo] = checkout

    def git(self, root, *args):
        result = subprocess.run(['git', '-C', str(root), *args], env=self.env, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20)
        assert result.returncode == 0, (args, result.stderr)
        return result.stdout.strip()

    def put(self, name, text):
        path = self.records / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
        return path

    def publish(self, name, text):
        self.put(name, text)
        self.git(self.records, 'add', name)
        self.git(self.records, 'commit', '-m', 'fixture ' + name)
        self.git(self.records, 'push', 'origin', 'main')

    def commit(self, subject, trailer=None, repo='temper', branch='main'):
        checkout = self.products[repo]
        self.serial += 1
        stamp = (datetime(2026, 10, 26, tzinfo=timezone.utc) + timedelta(minutes=self.serial)).isoformat()
        self.env['GIT_AUTHOR_DATE'] = self.env['GIT_COMMITTER_DATE'] = stamp
        self.git(checkout, 'checkout', '-B', branch)
        args = ['commit', '--allow-empty', '-m', subject]
        if trailer is not None:
            args += ['-m', 'QA: ' + trailer]
        self.git(checkout, *args)
        sha = self.git(checkout, 'rev-parse', 'HEAD')
        self.git(checkout, 'push', 'origin', branch)
        return sha

    def marked(self):
        return self.commit('B: refuses a frame', 'a task past the page is refused by name')

    def pass_file(self, name=P, commits=None, outcome='done', started='2026-10-26T09:15:23Z', repo='temper', findings=3):
        commits = commits or ['a' * 40]
        fields = dict(repository=repo, main=commits[-1], commits=' '.join(commits), machine='fixture',
                      model='gpt-6.1-sol', effort='high', started=started, ended='unknown',
                      wall='0:12', tokens='100/20/30', outcome=outcome)
        body = f'# QA pass {name}\n\n## Findings\n\n'
        # Reverse headings to check numeric ordering, and stop at the next section.
        body += ''.join(f'### {n}. Problem {n}\n\nReproduce {n}.\n\n' for n in reversed(range(1, findings + 1)))
        body += '## Automation\n\n### 99. Not a finding\n'
        text = '---\n' + ''.join(f'{k}: {v}\n' for k, v in fields.items()) + '---\n' + body
        self.publish('qa/passes/' + name + '.md', text)

    def run(self, *args, status=0, extra=None):
        result = subprocess.run([str(SCRIPT), *args], env=dict(self.env, **(extra or {})), cwd=self.root,
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, timeout=30)
        assert result.returncode == status, (args, result.returncode, result.stdout, result.stderr)
        return result

    def head(self):
        return self.git(self.origin, 'rev-parse', 'main')

    def content(self, name):
        return self.git(self.origin, 'show', 'main:' + name)

    def sent(self):
        return [json.loads(line) for line in self.post_log.read_text().splitlines()] if self.post_log.exists() else []


def candidates_are_marked_commits_oldest_first(lab):
    a = lab.commit('Unmarked')
    b = lab.marked()
    c = lab.commit('C: retries', 'a retry succeeds')
    expected = [f'temper {b[:9]} ', '  QA: a task past the page is refused by name',
                f'temper {c[:9]} ', '  QA: a retry succeeds']
    for args in [('candidates', 'temper'), ('candidates',)]:
        result = lab.run(*args)
        lines = result.stdout.splitlines()
        assert len(lines) == 4 and all(line.startswith(want) for line, want in zip(lines, expected)), lines
        assert a[:9] not in result.stdout and 'Unmarked' not in result.stdout
    assert lab.run('candidates', 'jig').stdout == 'no candidates\n'


def deciding_records_the_choice(lab):
    b = lab.marked()
    c = lab.commit('C: retries', 'a retry succeeds')
    assert lab.run('decide', 'temper', b[:7], 'run', '--why', 'first pilot').stdout == f'decided: temper {b[:9]} run\n'
    line = lab.content('qa/decisions.md').splitlines()[-1]
    assert line.endswith(f' temper {b} run first pilot'), line
    assert lab.content('qa/decisions.md').startswith('# QA decisions\n\n')
    assert f'qa decide: temper {b[:9]} run' in lab.git(lab.origin, 'log', '-1', '--format=%s')
    output = lab.run('candidates', 'temper').stdout
    assert b[:9] not in output and c[:9] in output
    output = lab.run('passes').stdout
    assert 'waiting: 1 commits chosen to run\n' in output and f'temper {b[:9]} ' in output
    # One command accepts multiple full/short IDs, without duplicating a repeated SHA.
    assert lab.run('decide', 'temper', b, c[:9], b[:7], 'backlog').stdout.splitlines() == [
        f'decided: temper {b[:9]} backlog', f'decided: temper {c[:9]} backlog']


def decide_refuses_what_is_not_eligible(lab):
    a = lab.commit('Unmarked')
    b = lab.marked()
    branch = lab.commit('Off main', 'branch only', branch='other')
    old = lab.head()
    cases = [(['temper', a, 'run'], 'no QA: trailer'),
             (['temper', 'f' * 40, 'run'], 'not found'),
             (['other', b, 'run'], 'unknown repository'),
             (['temper', branch, 'run'], 'not on origin/main'),
             (['temper', b, 'run', '--why', 'two\nlines'], 'newline'),
             (['temper', b, 'run', '--why', 'two\tcolumns'], 'tab'),
             (['temper', b[:6], 'run'], '7 to 40'),
             (['temper', b, a, 'run'], 'no QA: trailer')]
    for args, reason in cases:
        result = lab.run('decide', *args, status=2)
        assert reason in result.stderr, result
        assert lab.head() == old and not (lab.records / 'qa/decisions.md').exists()


def the_latest_decision_wins(lab):
    b = lab.marked()
    lab.run('decide', 'temper', b, 'backlog', '--why', 'later')
    output = lab.run('backlog').stdout
    assert f'temper {b[:9]}' in output and '  why: later\n' in output
    assert lab.run('backlog', 'jig').stdout == 'no commits kept for later\n'
    lab.run('decide', 'temper', b, 'run')
    assert lab.run('backlog').stdout == 'no commits kept for later\n'
    assert b[:9] in lab.run('passes').stdout


def a_pass_takes_its_commits(lab):
    b = lab.marked()
    lab.run('decide', 'temper', b, 'run')
    # Give the prior decision a known earlier instant; no fixture-only clock in qa.
    decisions = lab.content('qa/decisions.md')
    stamp = datetime.now(timezone.utc) - timedelta(seconds=2)
    started = stamp.strftime('%Y-%m-%dT%H:%M:%SZ')
    earlier = (stamp - timedelta(seconds=1)).strftime('%Y-%m-%dT%H:%M:%SZ')
    words = decisions.splitlines()[-1].split(' ')
    lab.publish('qa/decisions.md', '# QA decisions\n\n' + ' '.join([words[0], earlier, *words[2:]]) + '\n')
    lab.pass_file(commits=[b], outcome='running', started=started)
    output = lab.run('passes', '--running').stdout
    assert f'{P} temper running 0:12 100/20/30 {b[:9]}\n' in output
    assert 'waiting: 0 commits chosen to run\n' in output
    assert lab.run('candidates', 'temper').stdout == 'no candidates\n'
    lab.run('decide', 'temper', b, 'run')
    assert 'waiting: 1 commits chosen to run\n' in lab.run('passes').stdout
    # Equal timestamps: a pass wins over even the latest decision at that second.
    now = lab.content('qa/decisions.md').splitlines()[-1].split(' ')[1]
    lab.pass_file(name=P + '-2', commits=[b], outcome='running', started=now)
    assert 'waiting: 0 commits chosen to run\n' in lab.run('passes').stdout


def findings_wait_until_triaged(lab):
    lab.pass_file()
    lab.pass_file(name=P + '-2', outcome='running', findings=1)
    assert lab.run('findings').stdout.splitlines() == [f'{P} {n} Problem {n}' for n in range(1, 4)]
    assert P + '-2' in lab.run('passes', '--running').stdout
    assert f'{P} temper done' not in lab.run('passes', '--running').stdout


def triage_routes_a_finding(lab):
    lab.pass_file()
    assert lab.run('triage', P, '1', 'owner', 'o/x@hetzner2', '--why', 'ctl').stdout == f'triaged: {P} 1 o/x@hetzner2\n'
    sent = lab.sent()
    assert len(sent) == 1 and sent[0]['args'][:3] == ['send', 'o/x@hetzner2', f'QA finding {P} 1: Problem 1']
    assert sent[0]['body'] == (f'QA pass {P} on temper found this, and the director routes it to you.\n'
                               f"The report is records' qa/passes/{P}.md, finding 1: record pull, then read it.\nctl\n")
    lab.run('triage', P, '2', 'backlog')
    assert lab.content('director/backlog.md').endswith(
        f"- QA pass {P}, finding 2: Problem 2. Source/repro: records' qa/passes/{P}.md, finding 2.")
    lab.run('triage', P, '3', 'drop')
    assert len(lab.sent()) == 1
    triage = lab.content('qa/triage.md').splitlines()
    assert len(triage) == 5 and all(f' {P} {n} {route}' in triage[n + 1]
                                   for n, route in enumerate(('o/x@hetzner2', 'backlog', 'drop'), 1))
    assert lab.run('findings').stdout == 'no findings waiting\n'
    lab.run('triage', P, '1', 'drop', '--why', 'resolved')
    assert lab.content('qa/triage.md').splitlines()[-1].endswith(f'{P} 1 drop resolved')
    assert lab.run('findings').stdout == 'no findings waiting\n'


def triage_refuses_and_writes_nothing(lab):
    lab.pass_file()
    lab.pass_file(name=P + '-2', outcome='running')
    old = lab.head()
    cases = [(['unknown', '1', 'drop'], 'unknown pass'),
             ([P + '-2', '1', 'drop'], 'running'),
             ([P, '4', 'drop'], 'no finding'),
             ([P, '1', 'owner', 'bad'], 'address'),
             ([P, '1', 'owner', 'o/x_y@hetzner2'], 'address'),
             ([P, '1', 'owner', 'o/x@-host'], 'address'),
             ([P, '1', 'owner', 'o/x@hetzner2', '--why', 'a\nb'], 'newline'),
             ([P, '1', 'drop', '--why', 'a\tb'], 'tab')]
    for args, reason in cases:
        result = lab.run('triage', *args, status=2)
        assert reason in result.stderr and not lab.sent()
        assert lab.head() == old and not (lab.records / 'qa/triage.md').exists()
    result = lab.run('triage', P, '1', 'owner', 'o/x@hetzner2', status=2, extra={'QA_POST_STATUS': '2'})
    assert 'post send failed' in result.stderr and lab.head() == old
    assert not (lab.records / 'qa/triage.md').exists()
    result = lab.run('triage', P, '1', 'owner', 'o/x@hetzner2', extra={'QA_POST_STATUS': '3'})
    assert 'warning' in result.stderr and 'nobody will wake' in result.stderr
    assert lab.head() != old


def record_refusal_leaves_both_files(lab):
    lab.pass_file()
    lab.run('triage', P, '1', 'drop')
    triage = (lab.records / 'qa/triage.md').read_bytes()
    backlog = '# Backlog\n' + 'x' * (32 * 1024 - 20) + '\n'
    lab.publish('director/backlog.md', backlog)
    old = lab.head()
    result = lab.run('triage', P, '2', 'backlog', status=2)
    assert 'cap exceeded' in result.stderr and lab.head() == old
    assert (lab.records / 'qa/triage.md').read_bytes() == triage
    assert (lab.records / 'director/backlog.md').read_text() == backlog
    assert lab.content('qa/triage.md') == triage.decode().strip()
    assert lab.content('director/backlog.md') == backlog.strip()
    # Roll back a newly created triage file as well as an existing one.
    (lab.records / 'qa/triage.md').unlink()
    lab.git(lab.records, 'commit', '-am', 'fixture remove triage')
    lab.git(lab.records, 'push', 'origin', 'main')
    old = lab.head()
    lab.run('triage', P, '2', 'backlog', status=2)
    assert not (lab.records / 'qa/triage.md').exists() and lab.head() == old


def repository_failures_are_read_errors(lab):
    lab.marked()
    lab.run('candidates', 'temper')
    lab.env['QA_FIXTURE'] = str(lab.root / 'missing')
    assert 'QA_FIXTURE' in lab.run('candidates', 'temper', status=2).stderr
    lab.env['QA_FIXTURE'] = str(lab.root)
    lab.git(lab.tmp / 'qa/repos/temper', 'remote', 'set-url', 'origin', str(lab.origins / 'jig.git'))
    assert 'unexpected origin' in lab.run('candidates', 'temper', status=4).stderr
    lab.git(lab.tmp / 'qa/repos/temper', 'remote', 'set-url', 'origin', str(lab.origins / 'temper.git'))
    (lab.origins / 'temper.git').rename(lab.origins / 'temporarily-offline.git')
    assert 'cannot fetch' in lab.run('candidates', 'temper', status=4).stderr


def failed_pull_warns_and_uses_local_record(lab):
    lab.pass_file()
    lab.git(lab.records, 'remote', 'set-url', 'origin', str(lab.root / 'offline.git'))
    result = lab.run('findings')
    assert 'warning: record pull failed' in result.stderr and f'{P} 1 Problem 1' in result.stdout
    # record's committed-but-not-pushed exit is success, and keeps the triage locally.
    result = lab.run('triage', P, '1', 'drop')
    assert 'warning' in result.stderr and f'triaged: {P} 1 drop' in result.stdout
    assert f'{P} 1 drop' in (lab.records / 'qa/triage.md').read_text()
    assert f'{P} 1 Problem 1' not in lab.run('findings').stdout


def merged_commits_are_candidates(lab):
    b = lab.marked()
    side = lab.commit('side branch', 'side feature', branch='side')
    checkout = lab.products['temper']
    lab.git(checkout, 'checkout', 'main')
    lab.git(checkout, 'merge', '--no-ff', 'side', '-m', 'merge without marker')
    lab.git(checkout, 'push', 'origin', 'main')
    lines = lab.run('candidates', 'temper').stdout.splitlines()
    assert lines[0].startswith(f'temper {b[:9]} ') and lines[2].startswith(f'temper {side[:9]} '), lines
    lab.run('decide', 'temper', side, 'run')


def candidates_sort_across_repositories(lab):
    early = lab.marked()
    late = lab.commit('later on jig', 'jig feature', repo='jig')
    lines = lab.run('candidates').stdout.splitlines()
    assert lines[0].startswith(f'temper {early[:9]} ') and lines[2].startswith(f'jig {late[:9]} '), lines


def default_records_matches_record(lab):
    lab.pass_file()
    parent = lab.home / 'src/rust'
    parent.mkdir(parents=True)
    destination = parent / 'records'
    lab.records.rename(destination)
    lab.records = destination
    del lab.env['RECORDS']
    assert f'{P} 1 Problem 1' in lab.run('findings').stdout
    lab.run('triage', P, '1', 'drop')
    assert f'{P} 1 drop' in (destination / 'qa/triage.md').read_text()


def ambiguous_prefix_is_refused(lab):
    checkout = lab.products['temper']
    parent = lab.git(checkout, 'rev-parse', 'HEAD')
    tree = lab.git(checkout, 'rev-parse', 'HEAD^{tree}')
    seen = {}
    for nonce in range(200000):
        data = (f'tree {tree}\nparent {parent}\nauthor Fixture <fixture@invalid> 1792972800 +0000\n'
                f'committer Fixture <fixture@invalid> 1792972800 +0000\n\ncollision {nonce}\n\nQA: feature\n').encode()
        sha = hashlib.sha1(b'commit ' + str(len(data)).encode() + b'\0' + data).hexdigest()
        prefix = sha[:7]
        if prefix in seen:
            pair = (seen[prefix], data)
            break
        seen[prefix] = data
    else:
        raise AssertionError('fixture found no 7-digit prefix collision')
    for index, data in enumerate(pair):
        result = subprocess.run(['git', '-C', str(checkout), 'hash-object', '-w', '-t', 'commit', '--stdin'],
                                input=data, env=lab.env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=20)
        assert result.returncode == 0, result.stderr
        sha = result.stdout.decode().strip()
        lab.git(checkout, 'update-ref', 'refs/heads/collision-' + str(index), sha)
        lab.git(checkout, 'push', 'origin', 'collision-' + str(index))
    old = lab.head()
    assert 'ambiguous commit' in lab.run('decide', 'temper', prefix, 'run', status=2).stderr
    assert lab.head() == old and not (lab.records / 'qa/decisions.md').exists()


def fixture_overrides_are_gated(lab):
    program = ("import json, runpy, sys; ns=runpy.run_path(sys.argv[1]); w=ns['Workspace'](); "
               "print(json.dumps([str(w.tool('post')), str(w.tool('record')), w.origin('temper')]))")
    env = dict(lab.env)
    del env['QA_FIXTURE']
    result = subprocess.run([sys.executable, '-S', '-c', program, str(SCRIPT)], env=env,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=20)
    assert result.returncode == 0, result.stderr
    assert json.loads(result.stdout) == [str(KIT / 'post'), str(KIT / 'record'),
                                         'git@github.com:fabrig-ai/temper.git']


def main():
    cases = (candidates_are_marked_commits_oldest_first, deciding_records_the_choice,
             decide_refuses_what_is_not_eligible, the_latest_decision_wins, a_pass_takes_its_commits,
             findings_wait_until_triaged, triage_routes_a_finding, triage_refuses_and_writes_nothing,
             record_refusal_leaves_both_files, repository_failures_are_read_errors,
             failed_pull_warns_and_uses_local_record, merged_commits_are_candidates,
             candidates_sort_across_repositories, default_records_matches_record, ambiguous_prefix_is_refused, fixture_overrides_are_gated)
    if len(sys.argv) > 1:
        known = {case.__name__ for case in cases}
        assert all(name in known for name in sys.argv[1:]), 'unknown case'
        cases = tuple(case for case in cases if case.__name__ in sys.argv[1:])
    failed = 0
    for case in cases:
        try:
            with tempfile.TemporaryDirectory(prefix='qa-fixture-') as directory:
                case(Lab(Path(directory)))
            print('ok: ' + case.__name__, flush=True)
        except Exception:
            failed += 1
            print('FAIL: ' + case.__name__, flush=True)
            traceback.print_exc()
    print(f'completed {len(cases)} isolated cases', flush=True)
    return int(bool(failed))


if __name__ == '__main__':
    sys.exit(main())
