def build_baseline(directory):
    Lab(directory)


def run(case, directory, built):
    try:
        case(Lab(directory, built=built))
    finally:
        case_runner.reap_descendants()


if __name__ == '__main__':
    names = {case.__name__ for case in CASES}
    if sys.argv[1:2] != ['--one'] and any(name not in names for name in sys.argv[1:]):
        sys.exit('unknown case; choose: ' + ' '.join(case.__name__ for case in CASES))
    # Measured individually: these five take longest after the setup is copied.
    slow = ('triage_refuses_and_writes_nothing', 'triage_routes_a_finding',
            'watch_reads_settings_and_stops_on_an_unreadable_feed',
            'watch_refusals_are_recorded', 'a_pass_takes_its_commits')
    sys.exit(case_runner.main(__file__, CASES, run, slow=slow,
                              template=build_baseline, prefix='qa-fixture-'))
