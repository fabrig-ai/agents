    result = lab.run('keep', '--check', str(scratch))
    size = sum(len(text.encode()) for text in files.values())
    assert result.stdout.splitlines() == [f'qa keep: {len(files)} files, {size} bytes'] + [
        f'  {name} {len(files[name].encode())}' for name in sorted(files)], result.stdout
    assert not result.stderr and ignored not in result.stdout


def keep_check_reads_one_snapshot(lab):
    first, changed, outside = (secrets.token_hex(8) for _ in range(3))
    scratch = lab.scratch({'evidence/a.txt': first, 'evidence/b.txt': 'b', 'evidence/c.txt': 'c'})
    target = lab.root / 'outside'
    target.write_text(outside)
    driver = f'''
import json, os, runpy
from pathlib import Path
tool = runpy.run_path({str(SCRIPT)!r})
scratch = Path({str(scratch)!r})
original = os.open
def swapped(path, flags, *args, **kwargs):
    if path == 'b.txt':
        (scratch / 'evidence/a.txt').write_text({changed!r})
        (scratch / 'evidence/c.txt').unlink()
        (scratch / 'evidence/c.txt').symlink_to({str(target)!r})
    return original(path, flags, *args, **kwargs)
os.open = swapped
snapshot = tool['Snapshot'].read(scratch, 2048)
print(json.dumps({{'files': {{k: v.decode() for k, v in snapshot.files.items()}},
                   'refusals': [str(r) for r in snapshot.refusals]}}))
'''
    result = subprocess.run([sys.executable, '-I', '-S', '-c', driver], env=lab.env,
                            capture_output=True, text=True, timeout=HUNG_TOOL_S)
    assert result.returncode == 0, result.stderr
    row = json.loads(result.stdout)
    assert row == {'files': {'evidence/a.txt': first, 'evidence/b.txt': 'b'},
                   'refusals': ['evidence/c.txt: kind']}, row
    assert outside not in result.stdout + result.stderr and changed not in result.stdout + result.stderr
    shutil.rmtree(scratch / 'evidence')
    (scratch / 'evidence').symlink_to(lab.root, target_is_directory=True)
    result = lab.run('keep', '--check', str(scratch), status=2)
    assert result.stdout == 'qa keep: 0 files, 0 bytes\nrefused: evidence: kind\n'
    assert outside not in result.stdout + result.stderr
    (scratch / 'evidence').unlink()
    (scratch / 'evidence').write_text('not a tree')
    (scratch / 'brief.md').mkdir()
    result = lab.run('keep', '--check', str(scratch), status=2)
    assert result.stdout == ('qa keep: 0 files, 0 bytes\nrefused: brief.md: kind\n'
                             'refused: evidence: kind\n')


def keep_check_leaves_out_past_the_cap(lab):
    token = 'gh' + 'p_' + secrets.token_hex(18)
    scratch = lab.scratch({'brief.md': 'b' * 150, 'plan.md': 'p' * 150,
                           'scripts/a': 'a' * 200, 'scripts/b': 'b' * 200,
                           'evidence/a': 'a' * 200, 'evidence/b': 'b' * 200,
                           'evidence/c': token.ljust(200, '.')})
    extra = {'QA_EVIDENCE_KIB': '1'}
    result = lab.run('keep', '--check', str(scratch), extra=extra)
    assert result.stdout == ('qa keep: 4 files, 700 bytes\n  brief.md 150\n  plan.md 150\n'
                             '  scripts/a 200\n  scripts/b 200\n'
                             'left out: evidence/, 3 files, 600 bytes, past 1 KiB\n'), result.stdout
    assert token not in result.stdout + result.stderr
    lab.scratch({'scripts/a': 'a' * 600})
    result = lab.run('keep', '--check', str(scratch), extra=extra)
    assert result.stdout == ('qa keep: 2 files, 300 bytes\n  brief.md 150\n  plan.md 150\n'
                             'left out: evidence/, 3 files, 600 bytes, past 1 KiB\n'
                             'left out: scripts/, 2 files, 800 bytes, past 1 KiB\n'), result.stdout
    assert token not in result.stdout + result.stderr
    lab.scratch({'brief.md': 'b' * 950})
    result = lab.run('keep', '--check', str(scratch), status=2, extra=extra)
    assert 'refused: documents: cap\n' in result.stdout
    assert result.stderr == 'qa: copy refused (1)\n' and token not in result.stdout + result.stderr
    # The file setting is read without a write, and the environment wins.
    (lab.tmp / 'machine.env').write_text('QA_EVIDENCE_KIB=1\n')
    assert 'documents: cap' in lab.run('keep', '--check', str(scratch), status=2).stdout
    lab.run('keep', '--check', str(scratch), extra={'QA_EVIDENCE_KIB': '4'}, status=2)
    result = lab.run('keep', '--check', str(scratch), status=2, extra={'QA_EVIDENCE_KIB': '0'})
    assert result.stderr == 'qa: QA_EVIDENCE_KIB must be positive\n'
    shutil.rmtree(scratch / 'scripts')
    shutil.rmtree(scratch / 'evidence')
    lab.scratch({'brief.md': 'b' * 874})
    result = lab.run('keep', '--check', str(scratch), extra=extra)
    assert result.stdout == 'qa keep: 2 files, 1024 bytes\n  brief.md 874\n  plan.md 150\n'


def keep_check_writes_nothing(lab):
    scratch = lab.scratch({'brief.md': 'brief\n', 'evidence/plain.txt': 'plain\n'})
    missing_records, missing_tmp = lab.root / 'no-records', lab.root / 'no-tmp'
    shutil.rmtree(lab.origins)
    extra = {'RECORDS': str(missing_records), 'DEV_TMP': str(missing_tmp)}
    def listing():
        return {str(p.relative_to(scratch)): (p.stat().st_size, p.stat().st_mtime_ns)
                for p in [scratch, *scratch.rglob('*')]}
    before = listing()
    tools = lab.root / 'tools.jsonl'
    previous = tools.read_bytes() if tools.exists() else b''
    result = lab.run('keep', '--check', str(scratch), extra=extra)
    assert result.stdout.startswith('qa keep: 2 files, 12 bytes\n')
    assert not missing_records.exists() and not missing_tmp.exists() and listing() == before
    assert (tools.read_bytes() if tools.exists() else b'') == previous
    for name in ('missing', 'linked', 'regular'):
        path = lab.root / name
        if name == 'linked':
            path.symlink_to(scratch, target_is_directory=True)
        elif name == 'regular':
            path.write_text('plain')
        result = lab.run('keep', '--check', str(path), status=2, extra=extra)
        assert str(path) in result.stderr and not result.stdout
    lab.run('keep', status=2, extra=extra)
    lab.run('keep', '--check', str(scratch), status=2, extra=dict(extra, QA_EVIDENCE_KIB='bad'))
    assert not missing_records.exists() and not missing_tmp.exists()


