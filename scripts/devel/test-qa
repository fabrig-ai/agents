def setup_installs_the_service(lab):
    kit = lab.root / 'kit/scripts'
    (kit / 'infra').mkdir(parents=True)
    (kit / 'devel').mkdir()
    shutil.copyfile(KIT / 'kit.sh', kit / 'devel/kit.sh')
    shutil.copyfile(KIT.parent / 'infra/after-landing-units', kit / 'infra/after-landing-units')
    shutil.copyfile(KIT.parent / 'infra/fleet-units', kit / 'infra/fleet-units')
    source = (KIT.parent / 'infra/setup').read_text()
    harness = '''fix=${FIX:-0}; failed=0; bus=${BUS:-1}
ok() { echo "ok $*"; }; warn() { echo "warn $*"; }; fail() { echo "FAIL $*"; failed=1; }
check_qa_watch
exit "$failed"'''
    check = kit / 'infra/setup'
    check.write_text(source.replace('check "$@"', harness))
    binary = lab.root / 'bin'
    binary.mkdir()
    ctl = binary / 'systemctl'
    ctl.write_text('#!/bin/sh\nprintf "%s\\n" "$*" >> "$HOME/systemctl.calls"\n'
                   'case "$2" in\nis-active|is-enabled) test -f "$HOME/enabled";;\n'
                   'enable) touch "$HOME/enabled";;\n*) exit 0;;\nesac\n')
    ctl.chmod(0o700)
    env = dict(lab.env, PATH=str(binary) + ':' + lab.env['PATH'])
    def run(status=0, **extra):
        result = subprocess.run(['bash', str(check)], env=dict(env, **extra), capture_output=True, text=True, timeout=HUNG_TOOL_S)
        assert result.returncode == status, (result.stdout, result.stderr)
        return result.stdout
    assert 'ok' in run()
    marker = lab.home / '.config/agents-qa/director'
    marker.parent.mkdir(parents=True)
    marker.write_text('director@fixture\n')
    assert 'missing or differs' in run(1)
    run(FIX='1')
    unit = lab.home / '.config/systemd/user/agents-qa-watch.service'
    text = unit.read_text()
    assert '''ExecStart=/bin/bash -lc 'exec qa watch --director "$1"' qa-watch director@fixture''' in text
    assert 'RestartPreventExitStatus=2' in text and 'WantedBy=default.target' in text
    assert '--user enable --now agents-qa-watch.service' in (lab.home / 'systemctl.calls').read_text()
    assert 'current' in run() and 'enabled and active' in run()
    marker.unlink()
    assert 'warn' in run()
    for address in ('bad address', 'Director@fixture', 'x_y@fixture'):
        marker.write_text(address + '\n')
        assert 'one director address' in run(1, FIX='1')


