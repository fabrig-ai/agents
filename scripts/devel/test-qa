    result = lab.run('keep', '--check', str(scratch), status=2)
    assert set(line for line in result.stdout.splitlines() if line.startswith('refused:')) == expected, result.stdout
    assert result.stderr == f'qa: copy refused ({len(expected)})\n'
    assert f'  evidence/, entry {children.index(token) + 1} 6\n' in result.stdout
    for planted in (value, token, private, jwt, unsafe, binary_name):
        assert planted not in result.stdout + result.stderr
        assert all(planted not in path.read_text(errors='replace') for path in lab.records.rglob('*.md'))
