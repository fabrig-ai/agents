    # Record refusal also gives back, and leaves custody recorded locally.
    lab.waiting(1)
    wrapper = lab.root / 'record-wrapper'
    wrapper.write_text(f'#!{sys.executable} -S\nimport subprocess, sys\n'
                       "if sys.argv[1] == 'commit':\n print('fixture record refusal', file=sys.stderr)\n sys.exit(2)\n"
                       f'sys.exit(subprocess.run([{str(KIT / "record")!r}, *sys.argv[1:]]).returncode)\n')
    wrapper.chmod(0o700)
    before = lab.head()
    lab.watch(extra={'QA_RECORD': str(wrapper)})
    _, state = lab.watch_states()[-1]
    assert state['finished'] and state['given'] == [CHATGPT] and lab.head() == before
    assert len(lab.calls('codex-run')) == 1 and len(lab.calls('logins')) == 6
    # A refused launch frees custody even when recording its failure is refused.
    wrapper.write_text(f'#!{sys.executable} -S\nimport subprocess, sys\n'
                       "if sys.argv[1] == 'commit' and not sys.argv[sys.argv.index('-m') + 1].endswith(' started'):\n"
                       " print('fixture completion refusal', file=sys.stderr)\n sys.exit(2)\n"
                       f'sys.exit(subprocess.run([{str(KIT / "record")!r}, *sys.argv[1:]]).returncode)\n')
    lab.watch(status=2, extra={'QA_RECORD': str(wrapper)})
    _, state = lab.watch_states()[-1]
    assert not state['finished'] and state['given'] == [CHATGPT]
    assert len(lab.calls('codex-run')) == 2 and len(lab.calls('logins')) == 9
    lab.watch()
    assert lab.watch_states()[-1][1]['finished'] and len(lab.calls('logins')) == 10


