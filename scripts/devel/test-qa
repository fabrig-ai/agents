def watch_takes_a_batch(lab):
    commits = lab.waiting(3)
    # The -2 assertion is a collision in one minute, however slow the watches.
    now = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
    lab.watch(extra={'QA_BATCH': '2'}, now=now)
    _, state = lab.watch_state()
    assert state['commits'] == commits[:2]
    lab.watch(extra={'QA_BATCH': '2'}, now=now)
    assert len(lab.calls('codex-run')) == 1
    lab.end_run()
    lab.watch(extra={'QA_BATCH': '2'}, now=now)
    assert len(lab.calls('codex-run')) == 2
    running = [(d, s) for d, s in lab.watch_states() if not s['finished']]
    assert len(running) == 1 and running[0][1]['commits'] == commits[2:]
    assert running[0][1]['pass'].endswith('-2')


