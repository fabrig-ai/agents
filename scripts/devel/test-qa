        (directory / 'pass.json').write_text(json.dumps(state))
        lab.configure(logins_held=[CLAUDE])
        # Reset only our fixture trace before qa deploy appends to it.
        if registry.is_dir():
            registry.rmdir()
        elif registry.exists() or registry.is_symlink():
            registry.unlink()
        unit, pid = deployment(lab, directory, variant)
        registry.unlink()
        if variant == 'empty':
            registry.touch()
        elif variant == 'foreign':
            registry.write_text('codex-run-foreign\nqa-otherpass-box\n')
        elif variant == 'link':
            registry.symlink_to(outside)
        elif variant == 'directory':
            registry.mkdir()
        elif variant == 'fifo':
