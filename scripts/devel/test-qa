    expected = {f'refused: evidence/{name}: kind' for name in ('a-link', 'hard-a.txt', 'hard-b.txt', 'pipe')}
    expected.update(f'refused: {name}: binary' for name in ('evidence/nul.txt', 'evidence/latin.txt'))
