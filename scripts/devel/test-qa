        assert stop < show < give, variant
    # Historical confirmation cannot exempt a unit recreated under the same name.
    registry.unlink()
    state = json.loads((directory / 'pass.json').read_text())
    state['stopped'] = [unit]
    (directory / 'pass.json').write_text(json.dumps(state))
    unit, pid = deployment(lab, directory, 'hardlink')
    lab.watch()
    dead(pid)
    assert 'stopped' not in json.loads((directory / 'pass.json').read_text())
    aged(lab, directory)
    lab.watch()
    assert not directory.exists()


