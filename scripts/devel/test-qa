class Lab:
    def __init__(self, root, built=None):
        if built is not None:
            # Copy bytes (or private reflinks), never hardlink mutable Git state.
            subprocess.run(['cp', '-R', '--preserve=mode,timestamps', '--reflink=auto',
                            '--', str(built) + '/.', str(root)], check=True)
            for config in root.rglob('config'):
                config.write_text(config.read_text().replace(str(built), str(root)))
        self.root = root
        self.home, self.tmp, self.records = (root / n for n in ('home', 'tmp', 'records'))
        self.origins = root / 'origins'
        self.post_log = root / 'post.jsonl'
        self.post = root / 'post'
        for path in (self.home, self.tmp, self.records, self.origins):
            path.mkdir(exist_ok=True)
        self.env = dict(PATH=os.environ['PATH'], HOME=str(self.home), DEV_ROOT=str(root),
                        DEV_TMP=str(self.tmp), RECORDS=str(self.records), QA_FIXTURE=str(root),
                        QA_RECORD=str(KIT / 'record'), QA_POST=str(self.post),
                        QA_POST_LOG=str(self.post_log), QA_POST_STATUS='0',
                        QA_LOGIN_RESERVE='2', USER='fixture', POST_NAME='o/fixture', RECORD_TIDY='',
                        GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@invalid',
                        GIT_ALLOW_PROTOCOL='file', LC_ALL='C.UTF-8')
        # Keep command-scope policy, then disable all automatic maintenance in scratch.
        self.env.update({k: v for k, v in os.environ.items()
                         if k == 'GIT_CONFIG_COUNT' or k.startswith(('GIT_CONFIG_KEY_', 'GIT_CONFIG_VALUE_'))})
        count = int(self.env.get('GIT_CONFIG_COUNT', '0'))
        for index, (key, value) in enumerate((('maintenance.auto', 'false'), ('gc.auto', '0'),
                                             ('fetch.autoMaintenance', 'false'), ('receive.autogc', 'false'))):
            self.env[f'GIT_CONFIG_KEY_{count + index}'] = key
            self.env[f'GIT_CONFIG_VALUE_{count + index}'] = value
        self.env['GIT_CONFIG_COUNT'] = str(count + 4)
        self.configure(cleared={}, pools={CHATGPT: [CHATGPT, 'chatgpt-2', 'chatgpt-3'], CLAUDE: [CLAUDE, 'claude-2', 'claude-3']})
        for name in ('post', 'codex-run', 'landings', 'systemctl', 'systemd-run', 'logins'):
            tool = root / name
            tool.write_text(f'#!{sys.executable} -S\n' + WATCH_TOOLS)
            tool.chmod(0o700)
            self.env['QA_' + name.upper().replace('-', '_')] = str(tool)
        self.origin = root / 'records.git'
        self.products = {repo: root / repo for repo in REPOS}
        self.serial = 0
        if built is not None:
            return
        self.git(self.records, 'init', '-b', 'main')
        self.put('STATUS.md', '# Status\n')
        self.put('director/backlog.md', '# Backlog\n')
        self.git(self.records, 'add', '.')
        self.git(self.records, 'commit', '-m', 'records baseline')
        self.git(root, 'clone', '--bare', str(self.records), str(self.origin))
        self.git(self.records, 'remote', 'add', 'origin', str(self.origin))
        self.git(self.records, 'fetch', 'origin')
        for repo, checkout in self.products.items():
            self.git(root, 'init', '-b', 'main', str(checkout))
            self.git(checkout, 'commit', '--allow-empty', '-m', 'unmarked baseline')
            origin = self.origins / (repo + '.git')
            self.git(root, 'clone', '--bare', str(checkout), str(origin))
            self.git(checkout, 'remote', 'add', 'origin', str(origin))

    def git(self, root, *args):
        result = subprocess.run(['git', '-C', str(root), *args], env=self.env, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=HUNG_TOOL_S)
        assert result.returncode == 0, (args, result.stderr)
        return result.stdout.strip()

    def put(self, name, text):
        path = self.records / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
        return path

    def scratch(self, files):
        root = self.root / 'scratch'
        root.mkdir(exist_ok=True)
        for name, data in files.items():
            path = root / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data if isinstance(data, bytes) else data.encode())
        return root

    def publish(self, name, text):
        self.put(name, text)
        self.git(self.records, 'add', name)
        self.git(self.records, 'commit', '-m', 'fixture ' + name)
        self.git(self.records, 'push', 'origin', 'main')

    def commit(self, subject, trailer=None, repo='temper', branch='main'):
        checkout = self.products[repo]
        self.serial += 1
        stamp = (datetime(2026, 10, 26, tzinfo=timezone.utc) + timedelta(minutes=self.serial)).isoformat()
        self.env['GIT_AUTHOR_DATE'] = self.env['GIT_COMMITTER_DATE'] = stamp
        self.git(checkout, 'checkout', '-B', branch)
        args = ['commit', '--allow-empty', '-m', subject]
        if trailer is not None:
            args += ['-m', 'QA: ' + trailer]
        self.git(checkout, *args)
        sha = self.git(checkout, 'rev-parse', 'HEAD')
        self.git(checkout, 'push', 'origin', branch)
        return sha

    def marked(self):
        return self.commit('B: refuses a frame', 'a task past the page is refused by name')

    def pass_file(self, name=P, commits=None, outcome='done', started='2026-10-26T09:15:23Z', repo='temper', findings=3):
        commits = commits or ['a' * 40]
        fields = dict(repository=repo, main=commits[-1], commits=' '.join(commits), rung='-', machine='fixture',
                      model='gpt-6.1-sol', effort='high', started=started, ended='unknown',
                      wall='0:12', tokens='100/20/30', outcome=outcome)
        body = f'# QA pass {name}\n\n## Findings\n\n'
        # Reverse headings to check numeric ordering, and stop at the next section.
        body += ''.join(f'### {n}. Problem {n}\n\nReproduce {n}.\n\n' for n in reversed(range(1, findings + 1)))
        body += '## Automation\n\n### 99. Not a finding\n'
        text = '---\n' + ''.join(f'{k}: {v}\n' for k, v in fields.items()) + '---\n' + body
        self.publish('qa/passes/' + name + '.md', text)

    def run(self, *args, status=0, extra=None, now=None):
        command = [str(SCRIPT), *args]
        if now is not None:
            # Own the clock only in the fixture interpreter, never in qa's CLI.
            driver = (f'import runpy, sys; tool = runpy.run_path({str(SCRIPT)!r}); '
                      f'tool["main"].__globals__["timestamp"] = lambda: {now!r}; '
                      'sys.exit(tool["main"]())')
            command = [sys.executable, '-I', '-S', '-c', driver, *args]
        result = subprocess.run(command, env=dict(self.env, **(extra or {})), cwd=self.root,
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, timeout=HUNG_TOOL_S)
        assert result.returncode == status, (args, result.returncode, result.stdout, result.stderr)
        return result

    def head(self):
        return self.git(self.origin, 'rev-parse', 'main')

    def content(self, name):
        return self.git(self.origin, 'show', 'main:' + name)

    def sent(self):
        return [json.loads(line) for line in self.post_log.read_text().splitlines()] if self.post_log.exists() else []


    def configure(self, **values):
        path = self.root / 'tools.json'
        config = json.loads(path.read_text()) if path.exists() else {}
        config.update(values)
        path.write_text(json.dumps(config))

    def calls(self, tool):
        path = self.root / 'tools.jsonl'
        return [row['args'] for row in map(json.loads, path.read_text().splitlines()) if row['tool'] == tool] if path.exists() else []

    def waiting(self, count):
        commits = [self.commit(f'feature {self.serial + 1}', f'feature {self.serial + 1}') for _ in range(count)]
        # Watch cases need published choices, not another test of decide's
        # pull/resolve/record round trip (covered by the decision cases below).
        path = self.records / 'qa/decisions.md'
        text = path.read_text() if path.exists() else '# QA decisions\n\n'
        stamp = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
        text += ''.join(f'- {stamp} temper {sha} run \n' for sha in commits)
        self.publish('qa/decisions.md', text)
        self.configure(cleared={'temper': commits[-1]})
        return commits

    def rung(self, repo, rung, *logins):
        path = self.records / 'qa/rungs.md'
        text = path.read_text() if path.exists() else '# QA rungs\n\n'
        stamp = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
        text += f'- {stamp} {repo} {rung} {",".join(sorted(logins)) or "-"} fixture\n'
        self.publish('qa/rungs.md', text)

    def default(self, switch, repo='temper', now='2026-10-27T10:00:00Z'):
        path = self.records / 'qa/defaults.md'
        text = path.read_text() if path.exists() else '# QA defaults\n\n'
        main = self.git(self.products[repo], 'rev-parse', 'main')
        self.publish('qa/defaults.md', text + f'- {now} {repo} {switch} {main} fixture\n')

    def watch(self, status=0, extra=None, now=None):
        return self.run('watch', '--director', 'director@fixture', '--once', status=status, extra=extra, now=now)

    def walk(self, rung='b0', *args, status=0, now=None):
        path = self.tmp / 'qa-focused' / ('rung-' + rung + '-brief.md')
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.exists():
            path.write_bytes(b'Rung fixture brief.\n\x00Preserve these bytes.\n')
        return self.run('walk', 'temper', rung, *args, status=status, now=now)

    def walk_states(self):
        return [(self.tmp / 'qa-focused' / path.stem, json.loads(path.read_text()))
                for path in sorted((self.tmp / 'qa/walks').glob('*.json'))]

    def walk_state(self):
        state, = self.walk_states()
        return state

    def watch_states(self):
        return [(path.parent, json.loads(path.read_text())) for path in sorted((self.tmp / 'qa').glob('*/pass.json'))]

    def watch_state(self):
        state, = self.watch_states()
        return state

    def end_run(self, state=None, report='## Findings\nNone.\n', code=0):
        state = state or self.watch_state()[1]
        directory = (self.tmp / 'qa-focused' / state['walk'] if 'walk' in state
                     else self.tmp / 'qa' / state['pass'])
        (directory / 'report.md').write_text(report)
        run = self.tmp / 'codex-run' / state['run']
        meta = dict(line.split('=', 1) for line in (run / 'meta').read_text().splitlines())
        ended = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
        row = [state['run'], 'qa-watch', state['started'], ended, str(code), '1', meta['model'], meta['effort'],
               str(directory / 'brief.md'), str(directory / 'report.md'), 'thread', '100/20/30', '0']
        with (self.tmp / 'codex-run/runs.tsv').open('a') as out:
            out.write('\t'.join(row) + '\n')
        (run / 'ended').touch()
        return ended


def candidates_are_marked_commits_oldest_first(lab):
    a = lab.commit('Unmarked')
    b = lab.marked()
    c = lab.commit('C: retries', 'a retry succeeds')
    expected = [f'temper {b[:9]} ', '  QA: a task past the page is refused by name',
                f'temper {c[:9]} ', '  QA: a retry succeeds']
    for args in [('candidates', 'temper'), ('candidates',)]:
        result = lab.run(*args)
        lines = result.stdout.splitlines()
        assert len(lines) == 4 and all(line.startswith(want) for line, want in zip(lines, expected)), lines
        assert a[:9] not in result.stdout and 'Unmarked' not in result.stdout
    assert lab.run('candidates', 'jig').stdout == 'no candidates\n'


def deciding_records_the_choice(lab):
    b = lab.marked()
    c = lab.commit('C: retries', 'a retry succeeds')
    assert lab.run('decide', 'temper', b[:7], 'run', '--why', 'first pilot').stdout == f'decided: temper {b[:9]} run\n'
    line = lab.content('qa/decisions.md').splitlines()[-1]
    assert line.endswith(f' temper {b} run first pilot'), line
    assert lab.content('qa/decisions.md').startswith('# QA decisions\n\n')
    assert f'qa decide: temper {b[:9]} run' in lab.git(lab.origin, 'log', '-1', '--format=%s')
    output = lab.run('candidates', 'temper').stdout
    assert b[:9] not in output and c[:9] in output
    output = lab.run('passes').stdout
    assert 'waiting: 1 commits chosen to run\n' in output and f'temper {b[:9]} ' in output
    # One command accepts multiple full/short IDs, without duplicating a repeated SHA.
    assert lab.run('decide', 'temper', b, c[:9], b[:7], 'backlog').stdout.splitlines() == [
        f'decided: temper {b[:9]} backlog', f'decided: temper {c[:9]} backlog']


def decide_refuses_what_is_not_eligible(lab):
    a = lab.commit('Unmarked')
    b = lab.marked()
    branch = lab.commit('Off main', 'branch only', branch='other')
    old = lab.head()
    cases = [(['temper', a, 'run'], 'no QA: trailer'),
             (['temper', 'f' * 40, 'run'], 'not found'),
             (['other', b, 'run'], 'unknown repository'),
             (['temper', branch, 'run'], 'not on origin/main'),
             (['temper', b, 'run', '--why', 'two\nlines'], 'newline'),
             (['temper', b, 'run', '--why', 'two\tcolumns'], 'tab'),
             (['temper', b[:6], 'run'], '7 to 40'),
             (['temper', b, a, 'run'], 'no QA: trailer')]
    for args, reason in cases:
        result = lab.run('decide', *args, status=2)
        assert reason in result.stderr, result
        assert lab.head() == old and not (lab.records / 'qa/decisions.md').exists()


def the_latest_decision_wins(lab):
    b = lab.marked()
    lab.run('decide', 'temper', b, 'backlog', '--why', 'later')
    output = lab.run('backlog').stdout
    assert f'temper {b[:9]}' in output and '  why: later\n' in output
    assert lab.run('backlog', 'jig').stdout == 'no commits kept for later\n'
    lab.run('decide', 'temper', b, 'run')
    assert lab.run('backlog').stdout == 'no commits kept for later\n'
    assert b[:9] in lab.run('passes').stdout


def a_pass_takes_its_commits(lab):
    b = lab.marked()
    lab.run('decide', 'temper', b, 'run')
    # Give the prior decision a known earlier instant; no fixture-only clock in qa.
    decisions = lab.content('qa/decisions.md')
    stamp = datetime.now(timezone.utc) - timedelta(seconds=2)
    started = stamp.strftime('%Y-%m-%dT%H:%M:%SZ')
    earlier = (stamp - timedelta(seconds=1)).strftime('%Y-%m-%dT%H:%M:%SZ')
    words = decisions.splitlines()[-1].split(' ')
    lab.publish('qa/decisions.md', '# QA decisions\n\n' + ' '.join([words[0], earlier, *words[2:]]) + '\n')
    lab.pass_file(commits=[b], outcome='running', started=started)
    output = lab.run('passes', '--running').stdout
    assert f'{P} temper - running 0:12 100/20/30 {b[:9]}\n' in output
    assert 'waiting: 0 commits chosen to run\n' in output
    assert lab.run('candidates', 'temper').stdout == 'no candidates\n'
    lab.run('decide', 'temper', b, 'run')
    assert 'waiting: 1 commits chosen to run\n' in lab.run('passes').stdout
    # Equal timestamps: a pass wins over even the latest decision at that second.
    now = lab.content('qa/decisions.md').splitlines()[-1].split(' ')[1]
    lab.pass_file(name=P + '-2', commits=[b], outcome='running', started=now)
    assert 'waiting: 0 commits chosen to run\n' in lab.run('passes').stdout


def default_on_chooses_the_marked_commits_after_it(lab):
    before = [lab.marked() for _ in range(3)]
    now = '2026-10-27T10:00:00Z'
    result = lab.run('default', 'temper', 'on', '--why', 'automatic QA', now=now)
    assert result.stdout == f'default: temper on from {before[-1][:9]}\n'
    assert lab.content('qa/defaults.md') == f'# QA defaults\n\n- {now} temper on {before[-1]} automatic QA'
    assert 'qa default: temper on' in lab.git(lab.origin, 'log', '-1', '--format=%s')
    after = [lab.marked() for _ in range(2)]
    unmarked = lab.commit('no QA marker')
    output = lab.run('candidates', 'temper').stdout
    assert [line.split()[1] for line in output.splitlines() if line.startswith('temper ')] == [sha[:9] for sha in before]
    output = lab.run('passes').stdout
    assert 'waiting: 2 commits chosen to run' in output and all(sha[:9] in output for sha in after)
    assert unmarked[:9] not in output
    lab.configure(cleared={'temper': unmarked})
    lab.watch(now=now)
    assert lab.watch_state()[1]['commits'] == after


def default_off_keeps_what_it_covered(lab):
    lab.default('on')
    covered = [lab.marked() for _ in range(2)]
    result = lab.run('default', 'temper', 'off', now='2026-10-27T10:01:00Z')
    assert result.stdout == f'default: temper off from {covered[-1][:9]}\n'
    later = lab.marked()
    output = lab.run('candidates', 'temper').stdout
    assert later[:9] in output and all(sha[:9] not in output for sha in covered)
    lab.configure(cleared={'temper': later})
    lab.watch(now='2026-10-27T10:02:00Z')
    assert lab.watch_state()[1]['commits'] == covered


def a_later_decision_wins_over_a_default(lab):
    now = '2026-10-27T10:00:00Z'
    lab.default('on', now=now)
    first, second = [lab.marked() for _ in range(2)]
    # The equal-second decision wins too; the pass at that second wins over both.
    lab.run('decide', 'temper', first, 'backlog', '--why', 'later', now=now)
    output = lab.run('backlog').stdout
    assert first[:9] in output and second[:9] not in output and 'why: later' in output
    lab.configure(cleared={'temper': second})
    lab.watch(now=now)
    assert lab.watch_state()[1]['commits'] == [second]
    lab.end_run()
    lab.watch(now='2026-10-27T10:01:00Z')
    lab.watch(now='2026-10-27T10:02:00Z')
    assert len(lab.calls('codex-run')) == 1
    assert 'waiting: 0 commits chosen to run' in lab.run('passes').stdout
    assert first[:9] in lab.run('backlog', 'temper').stdout


def coverage_is_by_ancestry_not_time(lab):
    checkout = lab.products['temper']
    lab.env['GIT_AUTHOR_DATE'] = lab.env['GIT_COMMITTER_DATE'] = '2030-01-01T00:00:00Z'
    lab.git(checkout, 'commit', '--allow-empty', '-m', 'future date already landed', '-m', 'QA: already present')
    before = lab.git(checkout, 'rev-parse', 'HEAD')
    lab.git(checkout, 'push', 'origin', 'main')
    old = lab.commit('old date branch', 'lands later', branch='side')
    lab.run('default', 'temper', 'on', now='2026-10-27T10:00:00Z')
    lab.git(checkout, 'checkout', 'main')
    lab.git(checkout, 'merge', '--no-ff', 'side', '-m', 'land old branch')
    lab.git(checkout, 'push', 'origin', 'main')
    output = lab.run('candidates', 'temper').stdout
    assert before[:9] in output and old[:9] not in output
    output = lab.run('passes').stdout
    assert 'waiting: 1 commits chosen to run' in output and old[:9] in output and before[:9] not in output


def default_refuses_a_repeated_switch_and_shows_the_state(lab):
    now = '2026-10-27T10:00:00Z'
    assert lab.run('default', 'temper').stdout == 'temper off\n'
    before = lab.head()
    assert 'already off' in lab.run('default', 'temper', 'off', status=2).stderr
    assert lab.head() == before and not (lab.records / 'qa/defaults.md').exists()
    main = lab.marked()
    lab.run('default', 'temper', 'on', now=now)
    before = lab.head()
    assert 'already on' in lab.run('default', 'temper', 'on', status=2).stderr
    assert lab.head() == before and len(lab.content('qa/defaults.md').splitlines()) == 3
    assert lab.run('default', 'temper').stdout == f'temper on since {now} at {main[:9]}\n'
    lab.run('default', 'temper', 'off', now=now)
    assert lab.run('default', 'temper').stdout == f'temper off since {now} at {main[:9]}\n'
    before = lab.head()
    for args, reason in [(('temper', 'off'), 'already off'), (('qa', 'on'), 'unknown repository'),
                         (('temper', '--why', 'needs switch'), 'needs on or off'),
                         (('temper', 'on', '--why', 'two\nlines'), 'newline')]:
        assert reason in lab.run('default', *args, status=2).stderr
        assert lab.head() == before


def failed_default_coverage_keeps_reservations_and_other_repositories_running(lab):
    lab.default('on')
    temper = lab.marked()
    lab.rung('temper', REAL, CHATGPT)
    lab.configure(cleared={'temper': temper})
    driven_watch(lab, """def fail(*args):
    raise tool['Problem']('fixture checkout failed', 4)
tool['Repositories'].checkout = fail
""")
    directory, before = lab.watch_state()
    assert before['stage'] == 'reserving' and before['pools'] == {CHATGPT: CHATGPT}
    lab.default('on', repo='jig')
    jig = lab.commit('jig covered feature', 'jig feature', repo='jig')
    lab.configure(cleared={'temper': temper, 'jig': jig})
    origin = lab.origins / 'temper.git'
    offline = lab.origins / 'temper-offline.git'
    origin.rename(offline)
    for args in [('candidates', 'temper'), ('backlog', 'temper'), ('passes',)]:
        assert 'cannot fetch temper' in lab.run(*args, status=4).stderr
    result = lab.watch(extra={'QA_SLOTS': '2'})
    assert 'temper: preparation failed' in result.stdout and 'cannot fetch temper' in result.stdout
    assert json.loads((directory / 'pass.json').read_text()) == before
    assert [s['repository'] for _, s in lab.watch_states() if s['run']] == ['jig']
    assert not any(args[0] == 'give' for args in lab.calls('logins'))
    offline.rename(origin)
    lab.watch(extra={'QA_SLOTS': '2'})
    assert json.loads((directory / 'pass.json').read_text())['commits'] == [temper]


def malformed_defaults_are_read_errors(lab):
    main = lab.marked()
    for line in [f'- yesterday temper on {main}',
                 '- 2026-10-27T10:00:00Z temper on short',
                 f'- 2026-10-27T10:00:00Z temper maybe {main}']:
        lab.publish('qa/defaults.md', '# QA defaults\n\n' + line + '\n')
        before = lab.head()
        for args in [('default', 'temper', 'on'), ('candidates', 'temper'), ('backlog',), ('passes',)]:
            result = lab.run(*args, status=4)
            assert 'invalid' in result.stderr and lab.head() == before
        lab.watch(status=4)
