    lab.env.update({key: os.environ[key] for key in ('XDG_RUNTIME_DIR', 'DBUS_SESSION_BUS_ADDRESS')
                    if key in os.environ})
    manager = subprocess.run(['systemctl', '--user', 'is-system-running'], env=lab.env,
                             capture_output=True, text=True, timeout=30)
