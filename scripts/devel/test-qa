def refused_default_writes_restore_the_record(lab):
    refusal = lab.root / 'refuse-record'
    executable(refusal, "import sys\nif sys.argv[1] == 'pull':\n    sys.exit(0)\nprint('fixture refusal', file=sys.stderr)\nsys.exit(2)\n")
    for existing in (False, True):
        if existing:
            lab.default('on')
        path = lab.records / 'qa/defaults.md'
        content = path.read_bytes() if existing else None
        before = lab.head()
        result = lab.run('default', 'temper', 'off' if existing else 'on', status=2,
                         extra={'QA_RECORD': str(refusal)})
        assert 'fixture refusal' in result.stderr and lab.head() == before
        assert (path.read_bytes() if path.exists() else None) == content


def overlapping_defaults_keep_the_first_openings_time(lab):
    baseline = lab.git(lab.products['temper'], 'rev-parse', 'main')
    lab.default('on', now='2026-10-27T10:00:00Z')
    first = lab.marked()
    lab.default('off', now='2026-10-27T10:01:00Z')
    lab.run('decide', 'temper', first, 'backlog', now='2026-10-27T10:02:00Z')
    # A later stretch can cover the same ancestry after main has been rewritten.
    text = lab.content('qa/defaults.md') + f'\n- 2026-10-27T10:03:00Z temper on {baseline} rewritten main\n'
    lab.publish('qa/defaults.md', text)
    second = lab.marked()
    output = lab.run('backlog').stdout
    assert first[:9] in output and second[:9] not in output
    output = lab.run('passes').stdout
    assert 'waiting: 1 commits chosen to run' in output and second[:9] in output and first[:9] not in output


