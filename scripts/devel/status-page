HOUR, DAY, WEEK = 3600, 86400, 7 * 86400
SAMPLES_KEPT = 5000
# A release's version: two to four ASCII numbers, no leading zero but 0.
RELEASE = re.compile(r'v(0|[1-9][0-9]*)(?:\.(0|[1-9][0-9]*)){1,3}\.html')
# Copied from scripts/devel/landings: SSH's options and feed()'s path, but
# for LogLevel=QUIET, so that a refused key or host key says so.
