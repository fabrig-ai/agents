--info:#3987e5;--code:#262624}
*{box-sizing:border-box}
body{margin:0;background:var(--page);color:var(--ink);font:14px/1.45 system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:1280px;margin:0 auto;padding:20px 16px 48px}
header{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 16px;margin-bottom:16px}
h1{font-size:22px;margin:0;font-weight:650}
h2{font-size:17px;margin:32px 0 10px;font-weight:650}
h3{font-size:14px;margin:20px 0 8px;font-weight:650}
h4{font-size:12px;margin:12px 0 4px;color:var(--ink2);font-weight:600;text-transform:uppercase;letter-spacing:.04em}
p{margin:6px 0}
.meta,.muted,.empty{color:var(--ink2)}
.empty{font-style:italic}
code{background:var(--code);padding:0 4px;border-radius:4px;font-size:12.5px;overflow-wrap:anywhere}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:10px}
.tile,.card,.panel{background:var(--surface);border:1px solid var(--ring);border-radius:10px}
.tile{padding:12px 14px}
.tile .label{color:var(--ink2);font-size:12.5px}
.tile .value{font-size:28px;font-weight:650;margin:2px 0}
.tile .sub{color:var(--ink2);font-size:12px}
.panel{padding:4px 14px 12px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:10px}
.card{padding:4px 14px 12px}
.card ul{margin:2px 0;padding-left:0;list-style:none}
.card li{margin:3px 0}
.facts{color:var(--ink2);font-size:12.5px}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}
th,td{text-align:left;padding:6px 12px 6px 0;border-bottom:1px solid var(--grid);vertical-align:top;
white-space:nowrap}
td.wrap{white-space:normal;min-width:220px}
th{color:var(--ink2);font-weight:600;font-size:12.5px;white-space:nowrap}
td.num,th.num{text-align:right}
.badge{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;font-size:12px;color:var(--ink);
border:1px solid var(--ring);border-radius:999px;padding:0 8px 0 6px;line-height:20px}
.badge i{width:8px;height:8px;border-radius:50%;background:var(--neutral)}
.badge.good i{background:var(--good)}.badge.warning i{background:var(--warning)}
.badge.critical i{background:var(--critical)}.badge.info i{background:var(--info)}
.windows{display:flex;gap:6px;margin:6px 0 4px}
.windows button{font:inherit;color:var(--ink);background:var(--surface);border:1px solid var(--ring);
border-radius:999px;padding:3px 12px;cursor:pointer}
.windows button[aria-pressed="true"]{border-color:var(--ink);font-weight:600}
[data-window]{display:none}
#stats[data-show="24h"] [data-window="24h"],#stats[data-show="7d"] [data-window="7d"]{display:block}
.legend{display:flex;gap:16px;color:var(--ink2);font-size:12.5px;margin:6px 0}
.legend span{display:inline-flex;align-items:center;gap:6px}
.swatch{width:12px;height:12px;border-radius:3px;display:inline-block}
.swatch.run,.chart .run{fill:var(--run);background:var(--run)}
.swatch.wait,.chart .wait{fill:var(--wait);background:var(--wait)}
.chartbox{position:relative}
.chart{width:100%;height:auto;display:block}
.chart .grid{stroke:var(--grid);stroke-width:1}
.chart .base{stroke:var(--axis);stroke-width:1}
.chart .axis{fill:var(--muted);font-size:11px;font-variant-numeric:tabular-nums}
.chart .hit{fill:transparent;outline:none}
.chart .hit:hover,.chart .hit:focus{fill:var(--ink);fill-opacity:.05}
.tip{position:absolute;pointer-events:none;background:var(--surface);border:1px solid var(--ring);
border-radius:8px;padding:6px 10px;font-size:12.5px;box-shadow:0 2px 8px rgba(0,0,0,.12);white-space:nowrap}
.tip b{font-weight:650}.tip .k{display:inline-block;width:10px;height:2px;margin-right:6px;vertical-align:middle}
details{margin:6px 0}
summary{cursor:pointer;color:var(--ink2)}
footer{margin-top:36px;color:var(--ink2);font-size:12.5px}
"""

SCRIPT = """
(function(){
  var stats=document.getElementById('stats');
  document.querySelectorAll('.windows button').forEach(function(b){
    b.addEventListener('click',function(){
      stats.dataset.show=b.dataset.for;
      document.querySelectorAll('.windows button').forEach(function(o){o.setAttribute('aria-pressed',o===b);});
    });
  });
  document.querySelectorAll('.chartbox').forEach(function(box){
    var tip=box.querySelector('.tip');
    function line(color,value,name){
      var row=document.createElement('div'),k=document.createElement('span'),v=document.createElement('b');
      k.className='k';k.style.background=color;v.textContent=value;row.append(k,v,document.createTextNode(' '+name));
      return row;
    }
    function show(e){
      var t=e.target;if(!t.classList.contains('hit'))return;
      tip.replaceChildren();
      var head=document.createElement('div');head.textContent=t.dataset.label;
      tip.append(head,line('var(--run)',t.dataset.run,'running'),line('var(--wait)',t.dataset.wait,'waiting'));
      var n=document.createElement('div');n.textContent=t.dataset.commands+' commands ended';tip.append(n);
      tip.hidden=false;
      var r=box.getBoundingClientRect(),h=t.getBoundingClientRect();
      var x=h.left-r.left+h.width/2-tip.offsetWidth/2;
      tip.style.left=Math.max(0,Math.min(r.width-tip.offsetWidth,x))+'px';tip.style.top='0px';
    }
    box.addEventListener('pointermove',show);box.addEventListener('focusin',show);
    box.addEventListener('pointerleave',function(){tip.hidden=true;});
    box.addEventListener('focusout',function(){tip.hidden=true;});
  });
})();
"""


def render(data):
    fleet = Fleet(data)
    now = fleet.now
    problems = list(data['errors'])

    def guard(name, build, *args):
        try:
            return build(*args)
        except Exception as error:  # One section's bad data leaves the rest of the page.
            print(f'status-page: {name}:\n{traceback.format_exc()}', file=sys.stderr)
            problems.append(f'{name}: not shown: {type(error).__name__}: {error}')
            return '<p class="empty">Not shown this time: its data could not be read.</p>'

    shown = guard('missions', missions, fleet)
    shown, mission_table = shown if isinstance(shown, tuple) else (None, shown)
    reached = len(fleet.up)
    down = [n for n in fleet.names if n not in fleet.up]
    problems += [f'{n}: {fleet.data["fleet"][n]["unreachable"]}' for n in down if n in fleet.data['fleet']]
    problems += [f'{n}: {e}' for n, d in fleet.up.items() for e in shaped(d.get('errors'), [])]
    if not fleet.feed_seen:
        problems.append('landings feed: no reachable machine holds it')
    stats = []
    for key, seconds, title in WINDOWS:
        since = now - seconds
        rows = fleet.window(seconds)
        stats.append(f'''<div data-window="{key}">
<h3>Command time on the fleet, {E(title.lower())}</h3>
<p class="muted">Hours of heavy command time per {"hour" if seconds == DAY else "4 hours"}, every machine together:
running, and waiting in heavy’s queue before it.</p>
<div class="panel">{guard("chart", chart, fleet, seconds, HOUR if seconds == DAY else 4 * HOUR)}</div>
<h3>Builds and tests by kind</h3>
<p class="muted">Every heavy command, by the kind <code>record runs</code> counts (records.md 5.1); land’s own
commands are its prebuild and gate. Failed is a nonzero exit.</p>
<div class="panel">{guard("kinds", kind_table, rows)}</div>
<h3>By machine</h3><div class="panel">{guard("machines", machine_table, fleet, rows)}</div>
<h3>Landing: gates by repository</h3>
<p class="muted">Every <code>land</code> on any machine, plain or under <code>land-set</code>, from heavy’s
rows: its prebuild in the build lane, then its gate.</p>
<div class="panel">{guard("gates", gates_table, rows)}</div>
<h3>Landing: gate steps under land-set</h3>
<p class="muted">From the landings feed’s results (landing-flow.md 10): the medians of each
<code>gate-step</code>.</p>
<div class="panel">{guard("gate steps", steps_table, fleet, since)}</div>
<h3>Landing: set runs</h3>
<p class="muted">Lock wait is <code>waiting</code> to <code>started</code>; the run is <code>started</code> to
landed or stopped.</p>
<div class="panel">{guard("set runs", sets_table, fleet, since)}</div>
<h3>Landing: the landing turn</h3>
<p class="muted">How long each machine’s <code>land</code> waited for, and held, its repository’s turn.</p>
<div class="panel">{guard("landing turns", turns_table, fleet, since)}</div>
<h3>Codex runs</h3>
<p class="muted">Every <code>codex-run</code> task that ended, from each machine’s <code>runs.tsv</code>.</p>
<div class="panel">{guard("Codex runs", codex_table, fleet, since)}</div>
</div>''')
    return f'''<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="300">
<meta name="robots" content="noindex">
<title>Fabrig status</title>
<style>{STYLE}</style>
</head>
<body>
<main>
<header><h1>Fabrig status</h1>
<span class="meta">Written {E(utc(now, "%Y-%m-%d %H:%M UTC"))}, every 10 minutes ·
{reached} of {len(fleet.names)} machines reached{(" · down: " + E(", ".join(down))) if down else ""}</span></header>
{guard("tiles", kpis, fleet, shown)}
<h2>In flight</h2>
<h3>Landing now</h3>
<div class="panel">{guard("landing now", landing_now, fleet)}</div>
<h3>Missions</h3>
<p class="muted">Missions the record holds as active or paused, any mission with something running now (a heavy
command, a Codex run or owner, a Claude session named for it), and any the record doesn’t call ended with heavy
commands in the last 24 hours. Last activity is its last command, run or owner turn.</p>
<div class="panel">{mission_table}</div>
<h3>Machines</h3>
<div class="cards">{"".join(guard(f"card of {name}", machine_card, fleet, name) for name in fleet.names)}</div>
<h2>Costs</h2>
<section id="stats" data-show="24h">
<div class="windows" role="group" aria-label="Window">
<button type="button" data-for="24h" aria-pressed="true">Last 24 hours</button>
<button type="button" data-for="7d" aria-pressed="false">Last 7 days</button></div>
{"".join(stats)}
</section>
<footer>
<p>Written by agents’ <code>scripts/devel/status-page</code> from what the tools already keep: heavy’s
<code>heavy.tsv</code> and ledger, the landings feed, the landing turns, <code>codex-run</code>’s runs, post’s
mailboxes, Claude’s sessions and the missions’ front matter in the records repository
(docs/design/status-page.md). Times are UTC; p90 is the
nearest rank.</p>
{('<p>Not read this time:</p><ul>' + "".join(f"<li>{E(short(p, 300))}</li>" for p in problems) + '</ul>') if problems else ''}
</footer>
</main>
<script>{SCRIPT}</script>
</body>
</html>
'''


def write(path, content, mode):
    """Replace path whole: a reader sees the old file or the new one."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    out = tempfile.NamedTemporaryFile('w', encoding='utf-8', dir=path.parent, prefix='.' + path.name + '.',
                                      delete=False)
    try:
        with out:
            out.write(content)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(out.name, mode)
        os.replace(out.name, path)
    except BaseException:
        Path(out.name).unlink(missing_ok=True)
        raise


def install(out):
    script = Path(__file__).resolve()
    out = Path(out).expanduser().absolute()
    for path in (script, out):
        if re.search(r'[\s"\'\\$%]', str(path)):
            raise ValueError(f'{path}: a path for a unit must have no spaces, quotes, $, % or backslashes')
    units = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'systemd/user'
    units.mkdir(parents=True, exist_ok=True)
    # A login shell, so the run sees the PATH and settings every shell sees (infra.md 2).
    (units / 'status-page.service').write_text(f'''[Unit]
Description=Write the fleet's status page (agents docs/design/status-page.md)

[Service]
Type=oneshot
TimeoutStartSec=8min
ExecStart=/bin/bash -lc 'exec "$$0" --out "$$1"' {script} {out}
''')
    (units / 'status-page.timer').write_text('''[Unit]
Description=Write the fleet's status page every 10 minutes

[Timer]
OnCalendar=*:0/10
Persistent=true

[Install]
WantedBy=timers.target
''')
    for command in (['daemon-reload'], ['enable', '--now', 'status-page.timer']):
        subprocess.run(['systemctl', '--user', *command], check=True, stdin=subprocess.DEVNULL)
    print(f'status-page: installed {units}/status-page.timer, writing {out} every 10 minutes')


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--out', default='-', help='the page; - for stdout')
    parser.add_argument('--json', help='also write the gathered data here')
    parser.add_argument('--no-pull', action='store_true', help='read the records checkout as it is')
    commands = parser.add_subparsers(dest='command')
    commands.add_parser('collect', help="print this machine's part as JSON")
    installer = commands.add_parser('install', help='write and start the user timer')
    installer.add_argument('--out', dest='install_out', required=True)
    args = parser.parse_args(sys.argv[1:])
    if args.command == 'collect':
        json.dump(collect(), sys.stdout)
        return 0
    try:
        if args.command == 'install':
            install(args.install_out)
            return 0
        # Read once, so that a fast-forward during the run sends every
        # machine the collector that renders.
        source = Path(__file__).read_bytes()
        root = workspace()
        machines_file = Path(os.environ.get('STATUS_MACHINES', tmp_dir() / 'post/machines'))
        records_root = Path(os.environ.get('RECORDS', root / 'records')).expanduser().absolute()
        data = gather_all(machines_file, records_root, not args.no_pull, source)
        page = render(data)
        if args.out == '-':
            sys.stdout.write(page)
        else:
            # The web server reads it as another user.
            write(args.out, page, 0o644)
        if args.json:
            # The data holds the missions' fields the page leaves out.
            write(args.json, json.dumps(data), 0o600)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'status-page: {error}', file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main())
