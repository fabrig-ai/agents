def release_pages(directory):
    """The release pages beside the page, by name, newest first
    (status-page.md 3): [] where directory is None or missing; an
    OSError where it can't be listed."""
    if directory is None:
        return []
    try:
        with os.scandir(directory) as entries:
            names = [entry.name for entry in entries if RELEASE.fullmatch(entry.name) and entry.is_file()]
    except FileNotFoundError:
        return []

    def order(name):
        version = [int(n) for n in name[1:-5].split('.')]
        return tuple(-n for n in version + [0] * (4 - len(version))), name

    return sorted(names, key=order)


