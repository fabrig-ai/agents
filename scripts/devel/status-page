REMOTE = "bash -lc 'exec python3 -I - collect'"
FEED = Path.home() / '.local/state/agents-land-set/feed.jsonl'
# heavy's task states before release (build-infrastructure.md 3).
LIVE = {'submitted', 'enqueuing', 'queued', 'waiting', 'launching', 'active', 'finishing', 'closing'}
RUNNING = {'launching', 'active', 'finishing', 'closing'}
ORDER = 'workspace package focused check.sh clippy check doc fmt other'.split()
GROUPS = [('Tests', ['focused', 'package', 'workspace', 'doc']),
          ('Builds and lints', ['clippy', 'check', 'fmt', 'check.sh', 'other']),
          ('Landing', ['prebuild', 'land'])]
STEPS = ('fmt', 'clippy', 'wasm', 'build', 'focused', 'fuzzy', 'bundle', 'browser')
WINDOWS = (('24h', DAY, 'Last 24 hours'), ('7d', WEEK, 'Last 7 days'))
