def issues_link(repo, label):
    """Where a signed-in user sees a repository's open issues so labelled."""
    return f'https://git.fabrig.ai/fabrig-ai/{repo}/issues?state=open&labels={label}'


def clock():
    # Fixtures fix the time; the page is otherwise about now.
    return float(os.environ.get('STATUS_NOW') or time.time())


def workspace():
    home = Path.home()
    return home / ('src/rust' if (home / 'src/rust').exists() else 'src')


def tmp_dir():
    return Path(os.environ.get('DEV_TMP', Path(os.environ.get('DEV_ROOT', workspace())) / 'tmp')).expanduser().absolute()


def stamp(value):
    try:
        moment = datetime.fromisoformat(str(value).replace('Z', '+00:00'))
    except ValueError:
        return None
    return moment.timestamp() if moment.tzinfo else None


# What the tools' files hold is checked where it is read, as landings does:
# a field of the wrong type is a missing one.

def number(value):
    ok = isinstance(value, (int, float)) and not isinstance(value, bool)
    return value if ok and math.isfinite(value) else None


def text(value):
    return value if isinstance(value, str) else ''


def part(record, name):
    value = record.get(name)
    return value if isinstance(value, dict) else {}


def short(message, limit=200):
    """One line of an error, for the public page; the rest goes to the journal."""
    lines = str(message).strip().splitlines()
    line = lines[0] if lines else ''
    return line if len(line) <= limit else line[:limit - 1] + '…'


def mission(path, tmp):
    """The mission a path under tmp/owners belongs to, or ''."""
    try:
        parts = Path(path).relative_to(tmp / 'owners').parts
    except (ValueError, TypeError):
        return ''
    if not parts:
        return ''
    return parts[0]


def kinds(command):
    # Copied from scripts/devel/record: kinds(), without its flags.
    segments = re.split(r'&&|\|\||[;\n]', command)
    result = []
    for segment in segments:
        if 'nextest' in segment or (re.search(r'\bcargo\s+test\b', segment) and '--doc' not in segment):
            focused = bool(re.search(r'--(?:test(?:[=\s]|$)|lib\b)', segment))
            result.append('focused' if focused else 'package' if re.search(r'(?:^|\s)-p(?:\s|=|\S)', segment) else 'workspace')
        elif re.search(r'\bcheck\.sh\b', segment):
            result.append('check.sh')
        elif re.search(r'\bcargo\s+test\b.*--doc\b', segment):
            result.append('doc')
        else:
            match = re.search(r'\bcargo\s+(check|clippy|fmt)\b', segment)
            result.append(match[1] if match else 'other')
    return result


def kind_of(command, label):
    """A heavy command's kind, and the repository of a land's."""
    match = re.fullmatch(r'land (\S+)( prebuild)?', label or '')
    if match:
        return ('prebuild' if match[2] else 'land'), match[1]
    return min(kinds(command), key=ORDER.index), ''


# What one machine holds. Each part reads what a tool already keeps; none
# changes anything.

def part_machine(tmp, now):
    import ipaddress

    usage = shutil.disk_usage(tmp)
    memory = {}
    for line in Path('/proc/meminfo').read_text().splitlines():
        key, _, value = line.partition(':')
        if value.split():
            memory[key] = int(value.split()[0]) * 1024
    ips = []
    try:
        result = subprocess.run(['ip', '-j', '-4', 'addr', 'show', 'scope', 'global'],
                                stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
        if result.returncode == 0:
            for interface in shaped(json.loads(result.stdout), []):
                for address in shaped(shaped(interface, {}).get('addr_info'), []):
                    try:
                        ip = ipaddress.ip_address(text(shaped(address, {}).get('local')))
                    except ValueError:
                        continue
                    if ip.version == 4 and ip.is_global:
                        ips.append(str(ip))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass  # The optional IP probe must not hide load, memory or disk.
    return {'ips': ips, 'load': os.getloadavg(), 'cpus': os.cpu_count(), 'disk_free': usage.free,
            'disk_total': usage.total, 'mem_available': memory.get('MemAvailable'),
            'mem_total': memory.get('MemTotal')}


def part_heavy(tmp, now):
    state = json.loads((tmp / 'heavy/state.json').read_text())
    tasks = []
    for task in part(state, 'tasks').values():
        if not isinstance(task, dict) or task.get('state') not in LIVE:
            continue
        args = task.get('args') if isinstance(task.get('args'), list) else []
        kind, repo = kind_of(' '.join(map(str, args)), text(task.get('label')))
        tasks.append({'lane': text(task.get('lane')), 'label': text(task.get('label')),
                      'state': task['state'], 'submitted': number(task.get('submitted')),
                      'started': number(task.get('payload_started')), 'kind': kind, 'repo': repo,
                      'mission': mission(task.get('repo'), tmp)})
    return {'gate': bool(state.get('gate')), 'tasks': tasks}


def part_rows(tmp, now):
    """heavy.tsv's last week: end, lane, wait, run, exit, mission, kind, repo."""
    rows = []
    with (tmp / 'logs/heavy.tsv').open(errors='replace') as source:
        for line in source:
            # heavy keeps tabs and newlines out of its fields; quotes are the command's.
            row = line.rstrip('\n').split('\t')
            if len(row) < 10:
                continue
            end = stamp(row[2])
            try:
                wait, run = float(row[3]), float(row[4])
            except ValueError:
                continue
            if end is None or end < now - WEEK:
                continue
            kind, repo = kind_of(row[9], row[10] if len(row) > 10 else '')
            rows.append([end, row[1], wait, run, row[5], mission(row[7], tmp), kind, repo])
    return rows


def jsonlines(path, last=None):
    try:
        lines = path.read_text(errors='replace').splitlines()
    except FileNotFoundError:
        return None
    result = []
    for line in lines[-last:] if last else lines:
        try:
            value = json.loads(line)
        except ValueError:
            continue  # A live writer can leave an incomplete last line.
        if isinstance(value, dict):
            result.append(value)
    return result


def part_turns(tmp, now):
    """The landing turns this machine asked for (build-infrastructure.md 8)."""
    done, open_ = [], {}
    for event in jsonlines(tmp / 'landing-turn/events.jsonl') or []:
        token, at = event.get('token'), number(event.get('timestamp'))
        if not isinstance(token, str) or at is None or at < now - WEEK:
            continue
        held = number(event.get('runtime_s'))
        if event.get('event') in ('release', 'fail-open'):
            # land goes on without the turn when its client fails open; one
            # granted before was held as long as a released one.
            open_.pop(token, None)
            if event['event'] == 'release' or held is not None:
                done.append([at, text(event.get('repository')), number(event.get('wait_s')), held])
        elif event.get('event') in ('request', 'grant'):
            open_[token] = {'repo': text(event.get('repository')), 'event': event['event'], 'since': at}
    # A turn neither released nor recent was lost with its client.
    return {'done': done, 'open': [t for t in open_.values() if t['since'] >= now - 6 * HOUR]}


def active_units():
    result = subprocess.run(['systemctl', '--user', 'list-units', '--plain', '--no-legend', '--no-pager',
                             '--state=active', 'codex-run-*'], stdin=subprocess.DEVNULL,
                            capture_output=True, text=True, timeout=20)
    if result.returncode:
        # Without the units every run would look dead.
        raise OSError(f'systemctl --user list-units exited {result.returncode}')
    return {line.split()[0] for line in result.stdout.splitlines() if line.split()}


def lines_of(path):
    """A file's lines, or none when its tool has just moved it away."""
    try:
        return path.read_text(errors='replace').splitlines()
    except FileNotFoundError:
        return []


def part_codex(tmp, now):
    units = active_units()
    running = []
    for meta_path in sorted((tmp / 'codex-run').glob('*/meta')):
        state = meta_path.parent
        if (state / 'ended').exists():
            continue
        meta = dict(line.split('=', 1) for line in lines_of(meta_path) if '=' in line)
        if not meta:
            continue
        started = stamp(meta.get('started'))
        alive = f'codex-run-{state.name}.service' in units
        if not alive and (started is None or started < now - WEEK):
            continue
        running.append({'id': state.name, 'to': meta.get('to', ''), 'model': meta.get('model', ''),
                        'effort': meta.get('effort', ''), 'started': started, 'alive': alive,
                        'mission': mission(meta.get('task'), tmp)})
    ended = []
    for line in lines_of(tmp / 'codex-run/runs.tsv'):
        row = line.split('\t')
        if len(row) < 12:
            continue
        start, end = stamp(row[2]), stamp(row[3])
        if start is None or end is None or end < now - WEEK:
            continue
        tokens = row[11].split('/')
        tokens = [int(t) for t in tokens] if len(tokens) == 3 and all(t.isdigit() for t in tokens) else None
        ended.append([start, end, row[4], row[6], row[7], tokens, mission(row[8], tmp)])
    return {'running': running, 'ended': ended}


def part_sessions(tmp, now):
    claude = claude_cli() or str(Path.home() / '.local/bin/claude')
    result = subprocess.run([claude, 'agents', '--json', '--all'], stdin=subprocess.DEVNULL,
                            capture_output=True, text=True, timeout=30)
    if result.returncode:
        raise OSError(f'claude agents exited {result.returncode}')
    live = []
    for session in json.loads(result.stdout):
        # A session with a process is live; the rest are history.
        if isinstance(session, dict) and session.get('pid'):
            started = session.get('startedAt')
            kind = text(session.get('kind'))
            # The launchers name background sessions, which carry a state;
            # any other is someone's own (post reads one without a state as
            # interactive), and its name stays off the public page.
            own = kind != 'background' or 'state' not in session
            name = '' if own else short(text(session.get('name')) or '?', 60)
            live.append({'name': name, 'kind': kind,
                         'status': text(session.get('status')) or text(session.get('state')),
                         'started': number(started) / 1000 if number(started) else stamp(started)})
    return live


def part_feed(tmp, now):
    # Only the coordinator holds the landings feed; elsewhere this is None.
    return jsonlines(Path(os.environ.get('STATUS_FEED', FEED)), last=5000)


def part_user_issues(tmp, now):
    """Counts by repository and failures by repository (status-page.md 2.3);
    None where this machine holds no token."""
    path = tmp / 'git-fabrig/status-read.token'
    try:
        mode = path.stat().st_mode
    except FileNotFoundError:
        return None
    if mode & 0o077:
        raise PermissionError('token file readable by others')
    try:
        token = path.read_text(encoding='ascii').strip()
    except UnicodeError:
        raise ValueError('token file holds no token') from None
    if not re.fullmatch(r'[A-Za-z0-9_-]{8,128}', token):
        raise ValueError('token file holds no token')
    base = os.environ.get('STATUS_FORGEJO', 'https://git.fabrig.ai').rstrip('/')
    timeout = float(os.environ.get('STATUS_ISSUES_TIMEOUT') or 15)
    deadline = time.monotonic() + 30

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        # A redirect must not forward the authorization header elsewhere.
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            return None

    opener = urllib.request.build_opener(NoRedirect)

    def ask(repo, endpoint, shape):
        remaining = min(timeout, deadline - time.monotonic())
        if remaining <= 0:
            raise OSError('timed out')
        request = urllib.request.Request(f'{base}/api/v1/repos/fabrig-ai/{repo}/{endpoint}',
                                         headers={'Authorization': 'token ' + token,
                                                  'Accept': 'application/json', 'User-Agent': 'status-page'})
        answer = concurrent.futures.Future()

        def fetch():
            try:
                with opener.open(request, timeout=remaining) as response:
                    value = json.load(response)
                answer.set_result(value)
            except Exception as error:
                answer.set_exception(error)

        # The caller's deadline also bounds a response trickling bytes forever.
        # A late worker is daemonized, never publishes, and holds only this request.
        threading.Thread(target=fetch, daemon=True).start()
        try:
            return answer.result(timeout=remaining)
        except urllib.error.HTTPError as error:
            raise OSError(f'HTTP {error.code}') from None
        except TimeoutError:
            raise OSError('timed out') from None
        except urllib.error.URLError as error:
            reason = 'timed out' if isinstance(error.reason, TimeoutError) else type(error.reason).__name__
            raise OSError(reason) from None
        except (ValueError, UnicodeError):
            raise ValueError(shape) from None
        except Exception as error:
            # HTTP parser errors can contain a raw response line, too.
            raise OSError(type(error).__name__) from None

    def read(repo, label_id):
        try:
            label = ask(repo, f'labels/{label_id}', 'label answer')
            if (not isinstance(label, dict) or type(label.get('id')) is not int or label['id'] != label_id
                    or not isinstance(label.get('name'), str) or not label['name'].strip()):
                raise ValueError('label answer')
            name = urllib.parse.quote(label['name'], safe='')
            count = 0
            for page in range(1, 21):
                issues = ask(repo, f'issues?state=open&type=issues&labels={name}&limit=50&page={page}', 'issues answer')
                if not isinstance(issues, list) or any(not isinstance(issue, dict) for issue in issues):
                    raise ValueError('issues answer')
                count += sum(any(isinstance(tag, dict) and type(tag.get('id')) is int and tag['id'] == label_id
                                 for tag in shaped(issue.get('labels'), [])) for issue in issues)
                if len(issues) < 50:
                    return count, None
            raise ValueError('more than 20 pages')
        except Exception as error:
            return None, str(error)

    result = {'open': {}, 'failed': {}}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(ISSUES)) as pool:
        futures = [(repo, pool.submit(read, repo, label)) for repo, label in ISSUES]
        for repo, future in futures:
            count, failure = future.result()
            result['open' if failure is None else 'failed'][repo] = count if failure is None else failure
    return result


def probe_timeout():
    return float(os.environ.get('STATUS_PROBE_TIMEOUT') or 30)


def label(cli, account, email):
    """No account text leaves the machine, even in an error."""
    import hashlib

    if not isinstance(account, str) or not isinstance(email, str):
        return ''
    return hashlib.sha256('\0'.join((cli, account, email)).encode()).hexdigest()[:8]


def plan(value):
    return value if re.fullmatch(r'[a-z0-9_]{1,40}', text(value)) else ''


def usage(state, plan_word='', identity='', limits=None):
    return {'state': state, 'plan': plan(plan_word), 'label': identity, 'limits': limits or []}


def claude_cli():
    found = shutil.which('claude')
    fallback = Path.home() / '.local/bin/claude'
    return found or (str(fallback) if fallback.is_file() and os.access(fallback, os.X_OK) else None)


def claude_reset(value, now):
    # Month words are English regardless of the machine's locale.
    match = re.fullmatch(r'(?:(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) ([0-9]{1,2}), )?'
                         r'([0-9]{1,2})(?::([0-9]{2}))?(am|pm)(?: \(UTC\))?', value)
    if not match:
        return None
    month, day, hour, minute, half = match.groups()
    hour, minute = int(hour), int(minute or 0)
    if not 1 <= hour <= 12 or minute > 59:
        return None
    hour = hour % 12 + (12 if half == 'pm' else 0)
    today = datetime.fromtimestamp(now, timezone.utc)
    threshold = now - HOUR
    if month:
        month = 'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'.split().index(month) + 1
        for year in range(today.year, today.year + 9):
            try:
                candidate = datetime(year, month, int(day), hour, minute, tzinfo=timezone.utc).timestamp()
            except ValueError:
                continue
            if candidate >= threshold:
                return candidate
        return None
    candidate = today.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if candidate.timestamp() < threshold:
        candidate += timedelta(days=1)
    return candidate.timestamp()


def part_claude_usage(tmp, now):
    """What Claude Code is signed in to here, and each limit's use."""
    cli = claude_cli()
    if not cli:
        return usage('absent')

    def ask(args):
        result = subprocess.run([cli, *args], stdin=subprocess.DEVNULL, cwd=tmp,
                                capture_output=True, text=True, timeout=probe_timeout(),
                                env=dict(os.environ, TZ='UTC'))
        try:
            answer = json.loads(result.stdout)
        except ValueError:
            raise ValueError('Claude answered invalid JSON') from None
        if not isinstance(answer, dict):
            raise ValueError('Claude answered no JSON object')
        return result.returncode, answer

    code, auth = ask(['auth', 'status', '--json'])
    if not isinstance(auth.get('loggedIn'), bool):
        raise ValueError('Claude auth lacks loggedIn')
    if not auth['loggedIn']:
        return usage('signed-out')
    if not isinstance(auth.get('subscriptionType'), str):
        return usage('no-subscription')
    code, answer = ask(['-p', '/usage', '--output-format', 'json', '--no-session-persistence',
                        '--strict-mcp-config', '--tools', '', '--model', 'haiku',
                        '--settings', '{"disableAllHooks": true}'])
    if (answer.get('local_command') != 'usage' or number(answer.get('num_turns')) != 0
            or number(answer.get('total_cost_usd')) != 0):
        raise ValueError('/usage was answered by a model')
    if code or answer.get('is_error'):
        raise ValueError('Claude /usage failed')
    limits = []
    for line in text(answer.get('result')).splitlines():
        match = re.fullmatch(r'Current ([A-Za-z0-9 ()\[\]]{1,40}): ([0-9]+(?:\.[0-9]+)?)% used'
                             r'(?: · resets (.*))?', line)
        if match:
            name, used, reset = match.groups()
            limits.append({'name': name,
                           'used': number(float(used)), 'resets': claude_reset(reset, now) if reset else None})
    if not limits:
        raise ValueError('Claude /usage has no Current limit line')
    return usage('subscribed', auth['subscriptionType'], label('claude', auth.get('orgId'), auth.get('email')), limits)


def codex_limits(answer):
    buckets = part(answer, 'rateLimitsByLimitId')
    buckets = [buckets[k] for k in sorted(buckets)] if buckets else [part(answer, 'rateLimits')]
    limits = []
    for bucket in buckets:
        if not isinstance(bucket, dict):
            continue
        prefix = ''
        if bucket.get('limitId') != 'codex':
            # Backend display names are free text and may identify an account.
            name = text(bucket.get('limitId'))
            prefix = (name if re.fullmatch(r'[a-z0-9_.-]{1,40}', name) else 'other') + ' '
        for field in ('primary', 'secondary'):
            window = bucket.get(field)
            if not isinstance(window, dict):
                continue
            minutes = number(window.get('windowDurationMins'))
            name = '?'
            if minutes is not None and minutes > 0 and minutes == int(minutes):
                minutes = int(minutes)
                name = ('week' if minutes == 10080 else f'{minutes // 1440} d' if minutes % 1440 == 0
                        else f'{minutes // 60} h' if minutes % 60 == 0 else f'{minutes} min')
            limits.append({'name': prefix + name, 'used': number(window.get('usedPercent')),
                           'resets': number(window.get('resetsAt'))})
    return limits


def end_probe(process):
    # The server can exit before its helpers: always address the whole group.
    try:
        process.stdin.close()
    except OSError:
        pass  # A closed reader must not prevent reaping the process group.
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + 5
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    while time.monotonic() < deadline:
        try:
            os.killpg(process.pid, 0)
        except ProcessLookupError:
            break
        time.sleep(.02)
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()
    process.stdout.close()


def part_codex_usage(tmp, now):
    """One read-only RPC exchange, with a deadline covering all answers."""
    cli = shutil.which('codex')
    if not cli:
        return usage('absent')
    deadline = time.monotonic() + probe_timeout()
    process = subprocess.Popen([cli, 'app-server'], cwd=tmp, start_new_session=True,
                               stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    buffer = b''
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)

            def send(message):
                process.stdin.write((json.dumps(message) + '\n').encode())
                process.stdin.flush()

            def ask(identity, method, params):
                nonlocal buffer
                send({'id': identity, 'method': method, 'params': params})
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise TimeoutError('Codex app-server timed out')
                    if b'\n' not in buffer:
                        if not selector.select(remaining):
                            raise TimeoutError('Codex app-server timed out')
                        chunk = os.read(process.stdout.fileno(), 65536)
                        if not chunk:
                            raise ValueError('Codex app-server closed before answering')
                        buffer += chunk
                        continue
                    line, buffer = buffer.split(b'\n', 1)
                    try:
                        answer = json.loads(line)
                    except ValueError:
                        raise ValueError('Codex app-server answered invalid JSON') from None
                    if not isinstance(answer, dict):
                        raise ValueError('Codex app-server answered no JSON object')
                    if 'id' not in answer:
                        continue
                    if answer['id'] != identity:
                        raise ValueError('Codex app-server answered an unexpected id')
                    if 'error' in answer:
                        raise ValueError(f'Codex {method} returned an error')
                    if not isinstance(answer.get('result'), dict):
                        raise ValueError(f'Codex {method} answered no result object')
                    return answer['result']

            ask(1, 'initialize', {'clientInfo': {'name': 'status-page', 'version': '1'}})
            send({'method': 'initialized'})
            account = ask(2, 'account/read', {}).get('account')
            if account is None:
                return usage('signed-out')
            if not isinstance(account, dict):
                raise ValueError('Codex account is no object')
            if account.get('type') != 'chatgpt':
                return usage('no-subscription')
            answer = ask(3, 'account/rateLimits/read', {'excludeResetCreditDetails': True})
            return usage('subscribed', account.get('planType'),
                         label('codex', answer.get('accountId'), account.get('email')), codex_limits(answer))
    finally:
        end_probe(process)


PARTS = [('machine', part_machine), ('heavy', part_heavy), ('rows', part_rows),
         ('turns', part_turns), ('codex', part_codex), ('sessions', part_sessions),
         ('feed', part_feed), ('user_issues', part_user_issues),
         ('claude_usage', part_claude_usage), ('codex_usage', part_codex_usage)]


def collect():
    tmp, now = tmp_dir(), clock()
    data = {'host': socket.gethostname(), 'time': now, 'errors': []}
    sessions_read = threading.Event()

    def read(name, build):
        if name == 'claude_usage':
            sessions_read.wait()
        try:
            return build(tmp, now)
        finally:
            if name == 'sessions':
                sessions_read.set()

    with concurrent.futures.ThreadPoolExecutor(max_workers=len(PARTS)) as pool:
        futures = [(name, pool.submit(read, name, build)) for name, build in PARTS]
        for name, future in futures:
            try:
                data[name] = future.result()
            except Exception as error:  # One source's failure leaves the others.
                data['errors'].append(f'{name}: {type(error).__name__}: {error}')
    return data


# The whole fleet.

def machines(path):
    result = []
    for line in path.read_text().splitlines():
        # As post reads it: what follows a # is a comment.
        fields = line.split('#', 1)[0].split()
        if not fields:
            continue
        if len(fields) != 2 or not re.fullmatch(r'[a-z][a-z0-9-]*', fields[0]) or fields[1].startswith('-'):
            raise ValueError(f'invalid machines file line: {line!r}')
        result.append(tuple(fields))
    if not result:
        raise ValueError('machines file names no machine')
    return result


# Why a machine was not reached, as the page says it: ssh's own words
# name the target, which stays in the journal.
UNREACHED = [('Connection timed out', 'connection timed out'), ('Connection refused', 'connection refused'),
             ('Permission denied', 'key refused'), ('Host key verification failed', 'host key not accepted'),
             ('Could not resolve', 'name not resolved'), ('No route to host', 'no route'),
             ('Network is unreachable', 'no route')]


def gather(target, source):
    if target == 'local':
        return collect()
    # The collector is this very script, so no machine needs it installed.
    try:
        result = subprocess.run([*SSH, target, REMOTE], input=source, capture_output=True, timeout=120)
    except subprocess.TimeoutExpired:
        raise OSError('no answer in 120 s') from None
    if result.returncode:
        reason = result.stderr.decode(errors='replace').strip()
        print(f'status-page: {target}: exited {result.returncode}', *reason.splitlines(), sep='\n  ',
              file=sys.stderr)
        if result.returncode != 255:
            raise OSError(f'the collector exited {result.returncode}')
        raise OSError(next((why for words, why in UNREACHED if words in reason), 'ssh exited 255'))
    data = json.loads(result.stdout)
    if not isinstance(data, dict):
        raise ValueError('the collector answered no JSON object')
    return data


def pull():
    """record pull, stopped with an interrupt on timeout, so that its own
    rollback runs and leaves the checkout whole."""
    process = subprocess.Popen(['record', 'pull'], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, text=True)
    try:
        _, err = process.communicate(timeout=90)
    except subprocess.TimeoutExpired:
        process.send_signal(signal.SIGINT)
        try:
            process.communicate(timeout=15)
        except subprocess.TimeoutExpired:
            process.kill()
            process.communicate()
        return 'record pull timed out'
    if process.returncode:
        print(f'status-page: record pull exited {process.returncode}:\n{err}', file=sys.stderr)
        return f'record pull exited {process.returncode}'
    return None


def references(value):
    """The issue references of a README's blocked, others dropped (status-page.md 2)."""
    repos = '|'.join(repo for repo, _ in ISSUES)
    return list(dict.fromkeys(word for word in value.split()
                              if re.fullmatch(rf'({repos})#[1-9][0-9]*', word)))


def front_matter(text):
    """A README's public front-matter fields, as section 2's records row reads them."""
    text = text.replace('\r\n', '\n').replace('\r', '\n')
    front = re.match(r'\A---\n(.*?)\n---', text, re.S)
    fields = {}
    for line in front[1].splitlines() if front else []:
        key, sep, value = line.partition(':')
        if sep and key.strip() in (*FRONT, 'started', 'blocked'):
            fields[key.strip()] = value.strip()
    return fields


def records(root):
    """Public missions: {'missions': [...]}; no STATUS.md or mission bodies."""
    if not (root / 'missions').is_dir():
        raise FileNotFoundError(f'{root}/missions: no such directory')
    missions = []
    for readme in sorted((root / 'missions').glob('*/README.md')):
        fields = front_matter(readme.read_text(errors='replace'))
        missions.append({'name': readme.parent.name, **{k: fields.get(k, '') for k in FRONT},
                         'started': stamp(fields.get('started')),
                         'blocked': references(fields.get('blocked', ''))})
    return {'missions': missions}


def history_timeout():
    return float(os.environ.get('STATUS_HISTORY_TIMEOUT') or 30)


def blocked_since(root, names):
    """Since when each named mission has waited on the user, from its
    README's first-parent history on HEAD (status-page.md 2.4):
    ({name: seconds or None}, [reason, ...]), each reason once, in fixed
    words. Only commit times leave git."""
    since = dict.fromkeys(sorted(names))
    reasons = []
    if not since:
        return since, reasons
    if not (root / '.git').exists():
        return since, ['no git repository']
    env = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    deadline = time.monotonic() + history_timeout()

    def git(*args, data=None):
        left = deadline - time.monotonic()
        if left <= 0:
            raise subprocess.TimeoutExpired('git', 0)
        result = subprocess.run(['git', '-C', str(root), '--literal-pathspecs', *args],
                                input=data, stdin=subprocess.DEVNULL if data is None else None,
                                capture_output=True, env=env, timeout=left)
        if result.stderr:
            print('status-page: records: history: ' + result.stderr.decode(errors='replace').rstrip(),
                  file=sys.stderr)
        if result.returncode:
            raise ValueError('git exited unsuccessfully')
        return result.stdout

    def failed(error):
        reason = 'timed out' if isinstance(error, subprocess.TimeoutExpired) else 'git failed'
        if reason not in reasons:
            reasons.append(reason)
        if isinstance(error, subprocess.TimeoutExpired) and error.stderr:
            print('status-page: records: history: ' + error.stderr.decode(errors='replace').rstrip(),
                  file=sys.stderr)
        print(f'status-page: records: history: {error}', file=sys.stderr)

    try:
        shallow = git('rev-parse', '--is-shallow-repository')
        if shallow == b'true\n':
            return since, ['shallow']
        if shallow != b'false\n':
            raise ValueError('invalid shallow answer')
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        failed(error)
        return since, reasons
    for name in since:
        try:
            path = f'missions/{name}/README.md'
            log = git('log', '--first-parent', '--format=%H %ct', '--', path)
            commits = []
            for line in log.splitlines():
                match = re.fullmatch(rb'([0-9a-f]{40}|[0-9a-f]{64}) (-?[0-9]+)', line)
                if not match:
                    raise ValueError('invalid history answer')
                commits.append((match[1].decode(), int(match[2])))
            if not commits:
                continue
            queries = [f'{commit}:{path}' for commit, _ in commits]
            answer = git('cat-file', '--batch', data=('\n'.join(queries) + '\n').encode())
            versions = []
            for query in queries:
                header, sep, answer = answer.partition(b'\n')
                if not sep:
                    raise ValueError('missing version header')
                if header == (query + ' missing').encode():
                    versions.append('')
                    continue
                match = re.fullmatch(rb'(?:[0-9a-f]{40}|[0-9a-f]{64}) blob ([0-9]+)', header)
                if not match:
                    raise ValueError('invalid version header')
                size = int(match[1])
                if len(answer) <= size or answer[size:size + 1] != b'\n':
                    raise ValueError('incomplete version')
                versions.append(answer[:size].decode(errors='replace'))
                answer = answer[size + 1:]
            if answer:
                raise ValueError('extra version data')
            for (_, at), version in zip(commits, versions):
                if not references(front_matter(version).get('blocked', '')):
                    break
                since[name] = at
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            since[name] = None
            failed(error)
            if isinstance(error, subprocess.TimeoutExpired):
                break
    return since, reasons


def gather_all(machines_file, records_root, pulling, source):
    errors = []
    pairs = machines(machines_file)
    if pulling:
        try:
            failed = pull()
        except OSError as error:
            failed = f'record pull failed: {error}'
        if failed:
            errors.append(f'records: {failed}')
    fleet = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(pairs)) as pool:
        futures = {pool.submit(gather, target, source): name for name, target in pairs}
        for future in concurrent.futures.as_completed(futures):
            name = futures[future]
            try:
                fleet[name] = future.result()
            except Exception as error:
                fleet[name] = {'unreachable': f'{type(error).__name__}: {error}'}
    try:
        recorded = records(records_root)
        since, reasons = blocked_since(records_root, [m['name'] for m in recorded['missions'] if parked(m)])
        for m in recorded['missions']:
            m['blocked_since'] = since.get(m['name'])
        errors.extend(f'records: history: {reason}' for reason in reasons)
    except OSError as error:
        recorded = None
        errors.append(f'records: {error}')
    return {'time': clock(), 'machines': [name for name, _ in pairs], 'fleet': fleet,
            'records': recorded, 'errors': errors}


# Figures.

def pct(values, q):
    # Nearest rank, as landings' report: the smallest value at or above q of them.
    values = sorted(v for v in values if v is not None)
    return values[math.ceil(q * len(values)) - 1] if values else None


def median(values):
    import statistics

    values = [v for v in values if v is not None]
    return statistics.median(values) if values else None


def span(seconds):
    if seconds is None:
        return '–'
    seconds = round(seconds)
    if seconds < 3600:
        return f'{seconds // 60}:{seconds % 60:02d}'
    return f'{seconds // 3600}:{seconds % 3600 // 60:02d}:{seconds % 60:02d}'


def hours(seconds):
    return '–' if not seconds else f'{seconds / 3600:.1f} h'


def ago(moment, now):
    if not moment:
        return '–'
    return age(now - moment)


def length(seconds):
    """A span as the page reads one: '42 min', '5 h 12 min', '3 d 6 h'."""
    seconds = max(0, seconds)
    if seconds >= DAY:
        return f'{int(seconds // DAY)} d {int(seconds % DAY // HOUR)} h'
    if seconds >= HOUR:
        return f'{int(seconds // HOUR)} h {int(seconds % HOUR // 60)} min'
    return f'{int(seconds // 60)} min'


def when(moment, now, text=None):
    """A moment relative to now, with its exact UTC time on hover."""
    if not moment:
        return '–'
    return (f'<time datetime="{utc(moment, "%Y-%m-%dT%H:%M:%SZ")}" '
            f'title="{utc(moment, "%Y-%m-%d %H:%M UTC")}">'
            f'{E(ago(moment, now) if text is None else text)}</time>')


def age(seconds):
    seconds = max(0, seconds)
    if seconds < 90:
        return 'just now'
    if seconds < HOUR:
        return f'{round(seconds / 60)} min ago'
    if seconds < 2 * DAY:
        return f'{int(seconds // HOUR)} h {int(seconds % HOUR // 60)} min ago'
    return f'{int(seconds // DAY)} d ago'


def lasted(moment, now):
    return ago(moment, now).replace(' ago', '').replace('just now', '<1 min')


def utc(moment, form='%m-%d %H:%MZ'):
    return datetime.fromtimestamp(moment, timezone.utc).strftime(form) if moment is not None else '–'


def resets(moment, now):
    if moment is None:
        return '–'
    return 'in ' + length(moment - now)


def size(value):
    return '–' if value is None else f'{value / 1024 ** 3:.0f} GB'


def compact(value):
    if value is None:
        return '–'
    for unit, scale in (('B', 1e9), ('M', 1e6), ('K', 1e3)):
        if value >= scale:
            return f'{value / scale:.1f}{unit}'
    return str(value)


E = html.escape


def badge(tone, text):
    return f'<span class="badge {tone}"><i aria-hidden="true"></i>{E(text)}</span>'


def table(head, rows, numeric_from=1, empty='Nothing here.', wrap=()):
    """Cells keep to one line, but those of the columns in wrap."""
    if not rows:
        return f'<p class="empty">{E(empty)}</p>'
    kind = lambda i: ' class=wrap' if i in wrap else ' class=num' if i >= numeric_from else ''
    cells = ''.join(f'<th{kind(i)}>{E(h)}</th>' for i, h in enumerate(head))
    body = ''.join('<tr>' + ''.join(f'<td{kind(i)}>{c}</td>' for i, c in enumerate(row)) + '</tr>'
                   for row in rows)
    return f'<div class="scroll"><table><thead><tr>{cells}</tr></thead><tbody>{body}</tbody></table></div>'


def feed_records(raw):
    # As landings' read_feed: what lacks a time, set, host or token, or holds
    # a field of the wrong type, is not an event.
    result = []
    for record in raw if isinstance(raw, list) else []:
        if not isinstance(record, dict) or record.get('kind') == 'land' or not all(
                isinstance(record.get(k), str) and record[k] for k in ('time', 'set', 'host', 'token')):
            continue
        moment = stamp(record['time'])
        if moment is None:
            continue
        record = dict(record, utc=moment)
        record.setdefault('event', 'landed')
        if not isinstance(record['event'], str) or any(
                k in record and not isinstance(record[k], str) for k in ('repo', 'commit', 'reason')):
            continue
        result.append(record)
    return result


def plain_landings(raw):
    """Plain lands' records in the feed (landing-flow.md 12), as their times
    alone: never a branch, repository or taught line."""
    result = []
    for record in raw if isinstance(raw, list) else []:
        if not isinstance(record, dict) or record.get('kind') != 'land' or record.get('event') != 'landed':
            continue
        if 'set' in record or not all(isinstance(record.get(k), str) and record[k]
                                      for k in ('time', 'host', 'token')):
            continue
        moment = stamp(record['time'])
        if moment is not None:
            result.append(moment)
    return result


def set_runs(records):
    runs = {}
    for record in records:
        runs.setdefault((record['set'], record['token']), []).append(record)
    result = []
    for (label, token), run in runs.items():
        first = lambda event: next((r['utc'] for r in run if r['event'] == event), None)
        end = next((r for r in reversed(run) if r['event'] in ('done', 'stopped')), None)
        result.append({'set': label, 'run': run, 'waiting': first('waiting'), 'started': first('started'),
                       'end': end, 'host': run[0]['host'],
                       'landed': [r.get('repo', '') for r in run if r['event'] == 'landed']})
    return result


def in_flight(fleet):
    """Each set's latest run, as landings' latest_runs, if it has not ended
    and was heard from in 6 hours: a killed land-set writes no end."""
    latest = {}
    for run in fleet.runs:
        if (run['waiting'] or run['started']) and run['run'][0]['utc'] >= latest.get(
                run['set'], {'run': [{'utc': -math.inf}]})['run'][0]['utc']:
            latest[run['set']] = run
    return sorted((r for r in latest.values() if r['end'] is None and r['run'][-1]['utc'] >= fleet.now - 6 * HOUR),
                  key=lambda r: r['waiting'] or r['started'])


def steps(result):
    gate = part(result, 'gate')
    found = gate.get('steps') if isinstance(gate.get('steps'), dict) else None
    row = {s: number(found.get(s)) if found else None for s in STEPS}
    run = number(gate.get('run_s'))
    row['other'] = (round(max(0, run - sum(v for v in row.values() if v)), 3)
                    if found is not None and run is not None and gate.get('kind') == 'ran' else None)
    return row


def shaped(value, like):
    return value if isinstance(value, type(like)) else like


def records_of(data, path, size, times):
    """The lists at path in a machine's data of the size its collector
    writes, with numbers where times says: one of another version may differ."""
    for key in path[:-1]:
        data = shaped(data.get(key), {})
    return [r for r in shaped(data.get(path[-1]), []) if isinstance(r, list) and len(r) == size
            and all(number(r[i]) is not None for i in times)]


class Fleet:
    """The gathered data, flattened for the page's figures."""

    def __init__(self, data):
        self.now = data['time']
        self.samples = None
        self.data = data
        self.names = data['machines']
        self.up = {n: d for n, d in data['fleet'].items() if 'unreachable' not in d}
        self.records_read = data['records'] is not None
        self.recorded = {m['name']: m for m in (data['records'] or {}).get('missions', [])}
        self.alias = {text(d.get('host')): n for n, d in self.up.items()}
        self.rows = [(n, *r[:5], self.mission(r[5]), *r[6:])
                     for n, d in self.up.items() for r in records_of(d, ['rows'], 8, (0, 2, 3))]
        raw_feed = next((d['feed'] for d in self.up.values() if d.get('feed') is not None), None)
        self.feed = feed_records(raw_feed)
        self.lands = plain_landings(raw_feed)
        self.feed_seen = any(d.get('feed') is not None for d in self.up.values())
        self.runs = set_runs(self.feed)
        self.turns = [(n, *t) for n, d in self.up.items() for t in records_of(d, ['turns', 'done'], 4, (0,))]
        self.usage = [(n, cli, subscription_data(d.get(cli + '_usage')))
                      for cli in ('claude', 'codex') for n, d in sorted(self.up.items())]
        self.codex = [(n, *r[:6], self.mission(r[6]))
                      for n, d in self.up.items() for r in records_of(d, ['codex', 'ended'], 7, (0, 1))]

    def mission(self, raw):
        """A mission's name: whole when the record holds it, else without an old
        milestone's -m<N> (status-page.md 2)."""
        raw = text(raw)
        if raw in self.recorded:
            return raw
        old = re.fullmatch(r'(.+)-m[1-9][0-9]*', raw)
        return old[1] if old else raw

    def tasks(self):
        return [(n, dict(t, mission=self.mission(t['mission'])))
                for n, d in self.up.items() for t in (d.get('heavy') or {}).get('tasks', [])]

    def window(self, seconds):
        since = self.now - seconds
        return [r for r in self.rows if r[1] >= since]


def subscription_data(raw):
    raw = shaped(raw, {})
    limits = []
    for limit in shaped(raw.get('limits'), []):
        if isinstance(limit, dict) and text(limit.get('name')):
            limits.append({'name': limit['name'], 'used': number(limit.get('used')),
                           'resets': number(limit.get('resets'))})
    identity = text(raw.get('label'))
    return {'state': text(raw.get('state')), 'plan': text(raw.get('plan')),
            'label': identity if re.fullmatch('[0-9a-f]{8}', identity) else '', 'limits': limits}


def merged_subscriptions(fleet):
    """Each distinct subscription as 2.1 merges it, and the machines with none."""
    merged, notes = {}, {}
    for host, cli, probe in fleet.usage:
        if probe['state'] in ('signed-out', 'no-subscription'):
            notes.setdefault((cli, probe['state']), []).append(host)
        if probe['state'] != 'subscribed':
            continue
        identity = probe['label']
        group = merged.setdefault((cli, identity, '' if identity else host),
                                  {'machines': [], 'plans': set(), 'limits': {}})
        group['machines'].append(host)
        if probe['plan']:
            group['plans'].add(probe['plan'])
        for limit in probe['limits']:
            previous = group['limits'].get(limit['name'])
            rank = lambda v: (v['resets'] if v['resets'] is not None else -math.inf,
                              v['used'] if v['used'] is not None else -math.inf)
            if previous is None or rank(limit) > rank(previous):
                group['limits'][limit['name']] = limit
    return merged, notes


def usage_samples(fleet):
    """One sample per limit with a use and reset, of each labelled subscription."""
    merged, _ = merged_subscriptions(fleet)
    return [dict(time=fleet.now, cli=cli, label=label, limit=limit['name'],
                 used=limit['used'], resets=limit['resets'])
            for (cli, label, _), group in merged.items() if label
            for limit in group['limits'].values() if limit['used'] is not None and limit['resets'] is not None]


def read_samples(path):
    """The file's samples and how many lines held none; a missing file has none."""
    samples, dropped = [], 0
    try:
        source = Path(path).open(encoding='utf-8')
    except FileNotFoundError:
        return samples, dropped
    with source:
        for line in source:
            try:
                sample = json.loads(line)
                valid = (isinstance(sample, dict)
                         and set(sample) == {'time', 'cli', 'label', 'limit', 'used', 'resets'}
                         and all(number(sample[k]) is not None for k in ('time', 'used', 'resets'))
                         and sample['cli'] in ('claude', 'codex')
                         and re.fullmatch('[0-9a-f]{8}', text(sample['label'])) and text(sample['limit']))
            except (ValueError, OverflowError, RecursionError):
                valid = False
            if valid:
                samples.append(sample)
            else:
                dropped += 1
    return samples, dropped


def kept_samples(samples, now):
    """Unexpired samples at most a day old, newest SAMPLES_KEPT, oldest first."""
    return sorted((s for s in samples if s['resets'] >= now and s['time'] >= now - DAY),
                  key=lambda s: s['time'])[-SAMPLES_KEPT:]


def rise(samples, limit, cli, label, now, lookback):
    """A limit's readings over the look-back (2.2): rate and since, or needs and has."""
    earlier = min((s for s in samples if s['cli'] == cli and s['label'] == label
                   and s['limit'] == limit['name'] and abs(s['resets'] - limit['resets']) <= 600
                   and now - lookback <= s['time'] <= now), key=lambda s: s['time'], default=None)
    needs = max(1800, lookback / 4)
    has = now - earlier['time'] if earlier is not None else 0
    if has < needs:
        return {'needs': needs, 'has': has}
    return {'rate': (limit['used'] - earlier['used']) / has, 'since': earlier['time']}


def pace(samples, limit, cli, label, now):
    """A limit's full time, projected use at reset, or wait for a pace (2.2)."""
    used, reset = limit['used'], limit['resets']
    if used is None or reset is None:
        return '–'
    if used >= 100:
        return 'full'
    reading = rise(samples, limit, cli, label, now, min(DAY, max(HOUR, reset - now)))
    if 'needs' in reading:
        needs, has = reading['needs'], reading['has']
        title = f'needs {length(needs)} of samples, has {length(has)}'
        return f'<span title="{E(title)}">{E("pace in " + length(needs - has))}</span>'
    rate = reading['rate']
    if rate > 0:
        full_at = now + (100 - used) / rate
        if full_at < reset:
            return when(full_at, now, 'full in ' + length(full_at - now))
    return f'lasts, {int(used + max(rate, 0) * (reset - now))}% at reset'


def rate(samples, limit, cli, label, now):
    """A limit's rate per hour, with its readings' span on hover (2.2)."""
    if limit['used'] is None or limit['resets'] is None:
        return '–'
    reading = rise(samples, limit, cli, label, now, HOUR)
    if 'rate' not in reading:
        return '–'
    title = (f'over {length(now - reading["since"])}, '
             f'since {utc(reading["since"], "%Y-%m-%d %H:%M UTC")}')
    return f'<span title="{E(title)}">{max(0, reading["rate"] * 3600):.1f}%/h</span>'


def subscriptions(fleet):
    """Each distinct subscription's limits, then machines with none."""
    merged, notes = merged_subscriptions(fleet)
    rows, highest = [], None
    cli_name = {'claude': 'Claude', 'codex': 'Codex'}
    order = lambda key: (key[0] != 'claude', not bool(key[1]), key[1], key[2])
    for key in sorted(merged, key=order):
        cli, identity, _ = key
        group = merged[key]
        title = E(cli_name[cli])
        if group['plans']:
            title += ' · ' + E(', '.join(sorted(group['plans'])))
        title += f' · <code>{E(identity)}</code>' if identity else ' · unidentified'
        for i, limit in enumerate(list(group['limits'].values()) or [dict(name='–', used=None, resets=None)]):
            used = limit['used']
            meter = '–'
            if used is not None:
                tone = 'critical' if used >= 95 else 'warning' if used >= 80 else 'info'
                meter = (f'<span class="meter {tone}" role="img" aria-label="{used:g}% used">'
                         f'<i style="width:{max(0, min(100, used)):g}%"></i></span> {used:g}%')
                if highest is None or used > highest[0]:
                    highest = (used, f'{cli_name[cli]} {limit["name"]}')
            rows.append([title if i == 0 else '', E(limit['name']), meter,
                         when(limit['resets'], fleet.now, resets(limit['resets'], fleet.now)),
                         rate(fleet.samples, limit, cli, identity, fleet.now)
                         if identity and fleet.samples is not None else '–',
                         pace(fleet.samples, limit, cli, identity, fleet.now)
                         if identity and fleet.samples is not None else '–'])
    out = table(['Subscription', 'Limit', 'Used', 'Resets', 'Rate', 'At this pace'], rows, numeric_from=2,
                empty='No subscriptions found.')
    for cli in ('claude', 'codex'):
        for state, word in (('signed-out', 'signed out'), ('no-subscription', 'no subscription')):
            hosts = notes.get((cli, state), [])
            if hosts:
                out += f'<p class="muted">{cli_name[cli]}: {word} on {E(", ".join(sorted(hosts)))}</p>'
    sub = f'highest {highest[0]:g}% · {highest[1]}' if highest else 'no limits reported'
    signed_out = {host for (_, state), hosts in notes.items() if state == 'signed-out' for host in hosts}
    if signed_out:
        sub += ' · signed out: ' + ', '.join(sorted(signed_out))
    return {'count': len(merged), 'sub': sub}, out


def kpis(fleet, shown, subscribed):
    now = fleet.now
    landed = [max(e['utc'] for e in r['run'] if e['event'] == 'landed')
              for r in fleet.runs if r['landed']]
    sets = sum(now - 6 * HOUR <= t <= now for t in landed)
    plain = sum(now - 6 * HOUR <= t <= now for t in fleet.lands)
    last = max(landed + fleet.lands, default=None)
    rate_title = (f'{sets + plain} in the last 6 h: {sets} set{"" if sets == 1 else "s"}, '
                  f'{plain} land{"" if plain == 1 else "s"}') if fleet.feed_seen else None
    sessions = [s for d in fleet.up.values() for s in d.get('sessions') or []]
    busy = sum(s['status'] in ('busy', 'working') for s in sessions)
    codex = sum(r['alive'] for d in fleet.up.values() for r in (d.get('codex') or {}).get('running', []))
    counts = role_counts(sessions, codex)
    agents = f'{busy + codex} busy' + (' · ' + counts if counts else '')
    issues = user_issues(fleet)
    counts = shaped(issues.get('open'), {}) if issues else {}
    counts = {repo: n for repo, _ in ISSUES if (n := number(counts.get(repo))) is not None}
    issues_sub = ' · '.join(f'<a href="{E(issues_link(repo, label))}" target="_blank" rel="noopener noreferrer">{E(repo)} '
                            f'{E(str(counts.get(repo, "–")))}</a>' for repo, label in ISSUES)
    if counts and len(counts) < len(ISSUES):
        issues_sub = E(f'{len(counts)} of {len(ISSUES)} read · ') + issues_sub
    waiting = blocked(fleet)
    if waiting:
        title = '; '.join(f'{name}: {", ".join(refs)}' for name, refs in waiting)
        blocked_sub = f'<a href="#blocked" title="{E(title)}">{len(waiting)} blocked</a>'
    else:
        blocked_sub = '<a href="#blocked">' + ('– blocked' if waiting is None else '0 blocked') + '</a>'
    issues_sub = blocked_sub + ' · ' + issues_sub
    day = fleet.window(DAY)
    lands = [r for r in day if r[7] == 'land']
    tiles = [
        ('Missions', str(shown['rows']), E(f'{shown["active"]} active, {shown["paused"]} paused in the record, '
                                           f'{shown["busy"]} busy now')) if shown else ('Missions', '–', 'not shown'),
        ('Landings per hour', f'{(sets + plain) / 6:.1f}' if fleet.feed_seen else '–',
         f'last landed {when(last, now)}' if fleet.feed_seen and last is not None else 'none landed in the feed',
         rate_title),
        ('Agents', str(len(sessions) + codex), E(agents)),
        ('Land gates, 24 h', str(len(lands)), E(f'{sum(r[5] != "0" for r in lands)} failed')),
        ('Waiting on the user', str(sum(counts.values())) if counts else '–', issues_sub),
        ('Subscriptions', str(subscribed['count']), E(subscribed['sub'])) if subscribed
        else ('Subscriptions', '–', 'not shown'),
    ]
    return '<div class="tiles">' + ''.join(
        f'<div class="tile"><div class="label">{E(a)}</div><div class="value"'
        + (f' title="{E(title[0])}"' if title and title[0] is not None else '') + f'>{E(b)}</div>'
        f'<div class="sub">{c}</div></div>' for a, b, c, *title in tiles) + '</div>'


def user_issues(fleet):
    return next((answer for name in fleet.names if name in fleet.up
                 if (answer := shaped(fleet.up[name].get('user_issues'), {}))
                 if any(number(shaped(answer.get('open'), {}).get(repo)) is not None for repo, _ in ISSUES)), None)


def parked(mission):
    """Whether the record holds the mission active or paused with a
    blocked naming an issue: those the blocked count counts (status-page.md 3)."""
    return mission.get('state') in ('active', 'paused') and bool(mission.get('blocked'))


def blocked(fleet):
    """The missions the record holds active or paused whose blocked names
    an issue, as (name, references), by name (status-page.md 3); None
    where the record was not read."""
    if not fleet.records_read:
        return None
    return [(name, mission['blocked']) for name, mission in sorted(fleet.recorded.items())
            if parked(mission)]


def reason_kind(reason):
    """'land-set:', the repository where it names one, and the first clause, before a colon
    or an ' outside …' (status-page.md 3): no path or file name."""
    reason = short(text(reason))
    prefix = ''
    if reason.startswith('land-set: '):
        prefix, reason = 'land-set: ', reason[len('land-set: '):]
        repo = re.match(r'[a-z][a-z0-9_-]*: ', reason)
        if repo:
            prefix += repo[0]
            reason = reason[repo.end():]
    return prefix + re.split(r':| outside\b', reason, maxsplit=1)[0].strip()


def landing_now(fleet):
    now = fleet.now
    rows = []
    for run in in_flight(fleet):
        progress = next((r for r in reversed(run['run']) if r['event'] in ('gated', 'landed')), None)
        since = run['started'] or run['waiting']
        rows.append([E(run['set']), badge('info', 'running') if run['started'] else badge('warning', 'waiting for lock'),
                     E(fleet.alias.get(run['host'], run['host'])), when(since, now, lasted(since, now)),
                     E(f'{progress["event"]} {progress.get("repo", "")}' if progress else '–')])
    for name, task in fleet.tasks():
        if task['kind'] in ('land', 'prebuild'):
            since = task['started'] or task['submitted']
            state = badge('info', 'running') if task['state'] in RUNNING else badge('warning', 'queued')
            rows.append([E(f'land {task["repo"]}' + (' (prebuild)' if task['kind'] == 'prebuild' else '')),
                         state, E(name), when(since, now, lasted(since, now)), E(task['mission'] or '–')])
    for name, data in fleet.up.items():
        for turn in (data.get('turns') or {}).get('open', []):
            state = badge('info', 'holds the turn') if turn['event'] == 'grant' else badge('warning', 'waiting for turn')
            rows.append([E(f'landing turn {turn["repo"]}'), state, E(name),
                         when(turn['since'], now, lasted(turn['since'], now)), '–'])
    out = table(['What', 'State', 'Machine', 'For', 'Progress / mission'], rows, numeric_from=9,
                empty='Nothing is landing right now.')
    ended = sorted((r for r in fleet.runs if r['end']), key=lambda r: r['end']['utc'], reverse=True)[:5]
    recent = []
    for run in ended:
        end = run['end']
        result = (badge('good', 'landed') if end['event'] == 'done'
                  else badge('critical', f'stopped in {end.get("repo") or "?"}'))
        took = end['utc'] - run['started'] if run['started'] else None
        recent.append([E(run['set']), result, E(fleet.alias.get(run['host'], run['host'])), when(end['utc'], now),
                       E(span(took)),
                       E(', '.join(run['landed']) or '–'),
                       E(reason_kind(end.get('reason', '')) if end['event'] == 'stopped' else '')])
    out += '<h3>Recent set runs</h3>' + table(
        ['Set', 'Result', 'Machine', 'Ended', 'Run', 'Landed', 'Reason'], recent, numeric_from=9, wrap=(5, 6),
        empty='No set run in the feed yet.' if fleet.feed_seen else 'The landings feed was not reachable.')
    return out


def session_role(name):
    """('owner', m) for o/<m>, ('designer', d) for design/<d>, ('director', '') for
    director, else ('', '')."""
    if name == 'director':
        return 'director', ''
    match = re.fullmatch(r'(o|design)/(.+)', name or '')
    if match:
        return ('owner' if match[1] == 'o' else 'designer'), match[2]
    return '', ''


def role_counts(sessions, implementers=0):
    roles = {'implementer': implementers}
    for session in sessions:
        role, _ = session_role(session['name'])
        role = role or 'other'
        roles[role] = roles.get(role, 0) + 1
    counts = []
    for role in ('director', 'designer', 'owner', 'implementer', 'other'):
        count = roles.get(role, 0)
        if count:
            counts.append('director' if role == 'director' and count == 1 else
                          f'{count} {role}' + ('s' if count > 1 and role != 'other' else ''))
    return ', '.join(counts)


def description(record):
    value = text(record.get('description'))
    return '' if value == 'unknown' else value


# What runs for a mission now: the first of these that holds wins its Now
# cell (status-page.md 3), running before waiting, nearest main first.
NOW = (('landing', 'info'), ('build', 'info'), ('implementer', 'info'),
       ('owner busy', 'info'), ('designer busy', 'info'),
       ('queued landing', 'warning'), ('queued build', 'warning'),
       ('owner idle', 'neutral'), ('designer idle', 'neutral'))


def missions(fleet):
    now = fleet.now
    seen = {}

    def entry(name, moment=None, doing=None):
        e = seen.setdefault(name, {'last': 0, 'now': []})
        e['last'] = max(e['last'], moment or 0)
        if doing:
            e['now'].append(doing)
        return e

    recorded = fleet.recorded
    for name, m in recorded.items():
        if m['state'] in ('active', 'paused'):
            entry(name)
    for host, data in fleet.up.items():
        for task in (data.get('heavy') or {}).get('tasks', []):
            name = fleet.mission(task['mission'])
            if name:
                label = 'landing' if task['kind'] in ('land', 'prebuild') else 'build'
                entry(name, task['submitted'], label if task['state'] in RUNNING else f'queued {label}')
        codex = data.get('codex') or {}
        for run in codex.get('running', []):
            name = fleet.mission(run['mission'])
            if run['alive'] and name:
                entry(name, run['started'], 'implementer')
        for session in data.get('sessions') or []:
            role, raw = session_role(session['name'])
            name = fleet.mission(raw)
            if name:
                status = 'busy' if session['status'] in ('busy', 'working') else 'idle'
                entry(name, None, f'{role} {status}')
    for run in in_flight(fleet):
        name = run['set'].split('/', 1)[0]
        if name in recorded:
            entry(name, doing='landing' if run['started'] else 'queued landing')
    # Commands alone bring in a mission the record doesn't say has ended.
    for host, end, lane, wait, run, code, name, kind, repo in fleet.window(DAY):
        if not name or (name not in seen and recorded.get(name, {}).get('state') in ('ended', 'abandoned')):
            continue
        entry(name, end)
    for host, start, end, code, model, effort, tokens, name in fleet.codex:
        if name in seen:
            entry(name, end)
    rows = []
    for name, e in sorted(seen.items(), key=lambda kv: (not kv[1]['now'], -kv[1]['last'], kv[0])):
        m = recorded.get(name, {})
        state = m.get('state') or ''
        tone = {'active': 'good', 'paused': 'warning'}.get(state, 'neutral')
        counts = {}
        for item in e['now']:
            counts[item] = counts.get(item, 0) + 1
        doing = next((badge(tone, f'{counts[label]} × {label}' if counts[label] > 1 else label)
                      for label, tone in NOW if label in counts), '–')
        rows.append([f'<strong>{E(name)}</strong>', badge(tone, state) if state else '<span class="muted">not recorded</span>',
                     E(description(m)), doing, when(e['last'], now)])
    shown = {'rows': len(rows), 'busy': sum(bool(e['now']) for e in seen.values()),
             **{s: sum(recorded.get(n, {}).get('state') == s for n in seen) for s in ('active', 'paused')}}
    return shown, table(['Mission', 'Record', 'Description', 'Now', 'Last activity'],
                        rows, numeric_from=9, wrap=(2,), empty='No mission is active, paused or busy.')


def issue_link(reference):
    """Where an issue reference (temper#9) is on git.fabrig.ai."""
    repo, issue = reference.split('#')
    return f'https://git.fabrig.ai/fabrig-ai/{repo}/issues/{issue}'


def blocked_table(fleet):
    """Blocked on you (status-page.md 3): each mission the blocked count
    counts, the longest waiting first, then those whose since is unknown,
    each set by name."""
    waiting = blocked(fleet)
    if waiting is None:
        return '<p class="empty">The record was not read this time.</p>'
    entries = [(number(fleet.recorded[name].get('blocked_since')), name, refs)
               for name, refs in waiting]
    rows = []
    for since, name, refs in sorted(entries, key=lambda e: (e[0] is None, e[0] or 0, e[1])):
        m = fleet.recorded[name]
        links = ', '.join(f'<a href="{E(issue_link(ref))}" target="_blank" '
                          f'rel="noopener noreferrer">{E(ref)}</a>' for ref in refs)
        rows.append([E(name), badge('good' if m['state'] == 'active' else 'warning', m['state']),
                     E(description(m)) or '–', links, when(since, fleet.now)])
    return table(['Mission', 'State', 'Description', 'Waiting on', 'Since'], rows,
                 numeric_from=9, wrap=(2,), empty='Nothing is blocked on you.')


def ended_missions(fleet):
    ended = [(stamp(m.get('ended')), name, m) for name, m in fleet.recorded.items()
             if m.get('state') in ('ended', 'abandoned')]
    ended = sorted((e for e in ended if e[0] is not None and fleet.now - WEEK <= e[0] <= fleet.now),
                   key=lambda e: (-e[0], e[1]))
    rows = []
    for at, name, m in ended[:10]:
        started = number(m.get('started'))
        duration = length(at - started) if started is not None and started <= at else '–'
        rows.append([E(name), badge('neutral', m['state']), when(at, fleet.now), duration, E(description(m))])
    out = table(['Mission', 'State', 'Ended', 'Duration', 'Description'], rows, numeric_from=9, wrap=(4,),
                empty='No mission ended this week.')
    if len(ended) > 10:
        out += f'<p class="muted">and {len(ended) - 10} more this week</p>'
    return out


def machine_card(fleet, name):
    now = fleet.now
    data = fleet.data['fleet'].get(name, {'unreachable': 'not gathered'})
    if 'unreachable' in data:
        return (f'<div class="card"><h3>{E(name)} {badge("critical", "unreachable")}</h3>'
                f'<p class="muted">{E(short(data["unreachable"]))}</p></div>')
    info = data.get('machine') or {}
    heavy = data.get('heavy') or {}
    head = [badge('good', 'reachable')]
    if heavy.get('gate'):
        head.append(badge('info', 'gate holds the machine'))
    free = info.get('disk_free')
    if free is not None and free < 40 * 1024 ** 3:
        head.append(badge('warning', 'disk low'))
    load = info.get('load') or [0, 0, 0]
    ips = ''.join(f'{E(ip)} · ' for ip in shaped(info.get('ips'), []))
    facts = (f'{E(data.get("host", ""))} · {ips}load {load[0]:.1f} / {info.get("cpus", "?")} CPUs · '
             f'{size(info.get("mem_available"))} memory free · {size(free)} disk free')
    body = []
    tasks = heavy.get('tasks', [])
    if tasks:
        body.append('<h4>heavy</h4><ul>' + ''.join(
            f'<li>{badge("info" if t["state"] in RUNNING else "warning", t["state"])} '
            f'{E(t["lane"])} · {E(t["kind"] + (" " + t["repo"] if t["repo"] else ""))} · '
            f'{E(fleet.mission(t["mission"]) or t["label"] or "–")} · '
            f'{when(t["started"] or t["submitted"], now, lasted(t["started"] or t["submitted"], now))}</li>'
            for t in tasks) + '</ul>')
    codex = data.get('codex') or {}
    runs = codex.get('running', [])
    if runs:
        groups = {}
        for run in runs:
            mission = fleet.mission(run['mission']) or 'no mission'
            state = 'running' if run['alive'] else 'stale'
            group = groups.setdefault((mission, state), {'count': 0, 'models': set()})
            group['count'] += 1
            model = ' '.join(x for x in (run['model'], run['effort']) if x)
            if model:
                group['models'].add(model)
        items = []
        for (mission, state), group in sorted(groups.items()):
            models = ' · ' + ', '.join(sorted(group['models'])) if group['models'] else ''
            items.append(f'<li>{E(mission)}: {group["count"]} {state}{E(models)}</li>')
        body.append('<h4>Implementers</h4><ul>' + ''.join(items) + '</ul>')
    sessions = data.get('sessions') or []
    if sessions:
        busy = sum(s['status'] in ('busy', 'working') for s in sessions)
        body.append(f'<h4>Claude sessions</h4><p>{E(role_counts(sessions))} · {busy} busy</p>')
    last = max((r[0] for r in data.get('rows') or []), default=None)
    if not body:
        body.append('<p class="muted">Idle: nothing queued or running.</p>')
    errors = data.get('errors') or []
    if errors:
        body.append('<p class="muted">Not read: ' + E('; '.join(errors)) + '</p>')
    return (f'<div class="card"><h3>{E(name)} {" ".join(head)}</h3><p class="facts">{facts}<br>'
            f'last heavy command {when(last, now)}</p>{"".join(body)}</div>')


def chart(fleet, seconds, bucket):
    """Command time per bucket, running and waiting, spread over when it happened."""
    now = fleet.now
    count = int(seconds // bucket)
    start = (now // bucket + 1) * bucket - count * bucket
    run, wait, commands = [0.0] * count, [0.0] * count, [0] * count

    def spread(series, a, b):
        first = max(0, int((a - start) // bucket))
        for i in range(first, min(count, int((b - start) // bucket) + 1)):
            lo, hi = start + i * bucket, start + (i + 1) * bucket
            series[i] += max(0.0, min(b, hi) - max(a, lo))

    for host, end, lane, w, r, *_ in fleet.window(seconds + bucket):
        spread(run, end - r, end)
        spread(wait, end - r - w, end - r)
        i = int((end - start) // bucket)
        if 0 <= i < count:
            commands[i] += 1
    top = max((a + b for a, b in zip(run, wait)), default=0) / 3600
    # A clean axis: 1, 2 or 5 times a power of ten, in at most five steps.
    step = 1
    if top > 0:
        raw = top / 4
        power = 10 ** math.floor(math.log10(raw))
        step = next(m * power for m in (1, 2, 5, 10) if m * power >= raw)
    ceiling = max(step, math.ceil(top / step) * step) if top else 1
    width, height, left, bottom, top_pad = 960, 240, 44, 26, 10
    plot = height - bottom - top_pad
    slot = (width - left) / count
    bar = min(24, slot * .7)
    y = lambda v: top_pad + plot - v / ceiling * plot
    parts = [f'<svg viewBox="0 0 {width} {height}" class="chart" role="img" '
             f'aria-label="Command time per {"hour" if bucket == HOUR else f"{bucket // HOUR} hours"}, running and waiting">']
    tick = 0.0
    while tick <= ceiling + 1e-9:
        parts.append(f'<line class="grid" x1="{left}" x2="{width}" y1="{y(tick):.1f}" y2="{y(tick):.1f}"/>'
                     f'<text class="axis" x="{left - 6}" y="{y(tick) + 4:.1f}" text-anchor="end">{tick:g}</text>')
        tick += step
    every = max(1, round(count / 12))
    for i in range(count):
        x = left + i * slot + (slot - bar) / 2
        r_h, w_h = run[i] / 3600 / ceiling * plot, wait[i] / 3600 / ceiling * plot
        base = top_pad + plot
        if r_h >= .5:
            top_mark = w_h < .5
            parts.append(column(x, base - r_h, bar, r_h, 'run', rounded=top_mark))
        if w_h >= .5:
            gap = 2 if r_h >= .5 else 0
            h = max(.5, w_h - gap)
            parts.append(column(x, base - r_h - gap - h, bar, h, 'wait', rounded=True))
        lo = start + i * bucket
        label = (f'{utc(lo, "%m-%d %H:00Z")}–{utc(lo + bucket, "%H:00Z")}')
        parts.append(f'<rect class="hit" x="{left + i * slot:.1f}" y="{top_pad}" width="{slot:.1f}" height="{plot}" '
                     f'tabindex="0" data-label="{E(label)}" data-run="{hours(run[i]) if run[i] else "0 h"}" '
                     f'data-wait="{hours(wait[i]) if wait[i] else "0 h"}" data-commands="{commands[i]}"/>')
        if i % every == 0:
            text = utc(lo, '%H:00') if bucket == HOUR else utc(lo, '%a %H:00')
            parts.append(f'<text class="axis" x="{left + i * slot + slot / 2:.1f}" y="{height - 8}" '
                         f'text-anchor="middle">{text}</text>')
    parts.append(f'<line class="base" x1="{left}" x2="{width}" y1="{top_pad + plot}" y2="{top_pad + plot}"/></svg>')
    rows = [[E(utc(start + i * bucket, '%m-%d %H:00Z')), E(hours(run[i])), E(hours(wait[i])), str(commands[i])]
            for i in range(count) if run[i] or wait[i] or commands[i]]
    legend = ('<div class="legend"><span><i class="swatch run"></i>Running</span>'
              '<span><i class="swatch wait"></i>Waiting in heavy’s queue</span></div>')
    return (legend + '<div class="chartbox">' + ''.join(parts) + '<div class="tip" hidden></div></div>'
            + '<details><summary>As a table</summary>'
            + table(['From', 'Running', 'Waiting', 'Commands ended'], rows) + '</details>')


def column(x, top, width, height, cls, rounded):
    if not rounded:
        return f'<rect class="{cls}" x="{x:.1f}" y="{top:.1f}" width="{width:.1f}" height="{height:.1f}"/>'
    r = min(4, height, width / 2)
    return (f'<path class="{cls}" d="M{x:.1f},{top + height:.1f} L{x:.1f},{top + r:.1f} Q{x:.1f},{top:.1f} '
            f'{x + r:.1f},{top:.1f} L{x + width - r:.1f},{top:.1f} Q{x + width:.1f},{top:.1f} {x + width:.1f},'
            f'{top + r:.1f} L{x + width:.1f},{top + height:.1f} Z"/>')


def kind_table(rows):
    out = []
    for group, names in GROUPS:
        for name in names:
            mine = [r for r in rows if r[7] == name]
            if not mine:
                continue
            runs, waits = [r[4] for r in mine], [r[3] for r in mine]
            failed = sum(r[5] != '0' for r in mine)
            label = {'land': 'land gate', 'prebuild': 'land prebuild', 'other': 'other'}.get(name, name)
            out.append([f'<span class="muted">{E(group)}</span> {E(label)}', f'{len(mine):,}',
                        str(failed) if failed else '–', span(median(runs)), span(pct(runs, .9)),
                        span(median(waits)), span(pct(waits, .9)), hours(sum(runs)), hours(sum(waits))])
    return table(['Kind', 'Commands', 'Failed', 'Run median', 'Run p90', 'Wait median', 'Wait p90',
                  'Running', 'Waiting'], out, empty='No heavy command in this window.')


def machine_table(fleet, rows):
    out = []
    for name in fleet.names:
        mine = [r for r in rows if r[0] == name]
        if name not in fleet.up:
            out.append([E(name), '–', '–', '–', '–', '–', '–', badge('critical', 'unreachable')])
            continue
        waits = [r[3] for r in mine]
        lands = sum(r[7] == 'land' for r in mine)
        out.append([E(name), f'{len(mine):,}', str(sum(r[5] != '0' for r in mine) or '–'),
                    hours(sum(r[4] for r in mine)), hours(sum(waits)), span(median(waits)), span(pct(waits, .9)),
                    str(lands or '–')])
    return table(['Machine', 'Commands', 'Failed', 'Running', 'Waiting', 'Wait median', 'Wait p90', 'Land gates'],
                 out)


def gates_table(rows):
    out = []
    for repo in sorted({r[8] for r in rows if r[7] in ('land', 'prebuild')}):
        gates = [r for r in rows if r[7] == 'land' and r[8] == repo]
        pre = [r for r in rows if r[7] == 'prebuild' and r[8] == repo]
        runs = [r[4] for r in gates]
        out.append([E(repo), str(len(gates)), str(sum(r[5] != '0' for r in gates) or '–'),
                    span(median(runs)), span(pct(runs, .9)), span(median([r[3] for r in gates])),
                    span(median([r[4] for r in pre])), span(median([r[3] for r in pre])),
                    str(sum(r[5] != '0' for r in pre) or '–')])
    return table(['Repository', 'Gates', 'Failed', 'Gate median', 'Gate p90', 'Gate wait', 'Prebuild median',
                  'Prebuild wait', 'Prebuild failed'], out, empty='No land in this window.')


def steps_table(fleet, since):
    results = [r['result'] for r in fleet.feed if r['utc'] >= since and isinstance(r.get('result'), dict)
               and isinstance(r['result'].get('repo'), str)]
    out = []
    for repo in sorted({x['repo'] for x in results}):
        mine = [x for x in results if x['repo'] == repo]
        ran = [x for x in mine if part(x, 'gate').get('kind') == 'ran']
        cached = sum(part(x, 'gate').get('kind') == 'cached' for x in mine)
        timed = [steps(x) for x in ran]
        gate = [number(part(x, 'gate').get('run_s')) for x in ran]
        failed = sum(any(part(x, p).get('exit') not in (None, 0) for p in ('prebuild', 'gate')) for x in mine)
        shown = [s for s in (*STEPS, 'other') if any(t[s] is not None for t in timed)]
        out.append([E(repo), str(len(ran)), str(cached or '–'), str(failed or '–'), span(median(gate)),
                    span(pct(gate, .9)), E(' · '.join(f'{s} {span(median([t[s] for t in timed]))}' for s in shown) or '–')])
    return table(['Repository', 'Gates run', 'Cached', 'Failed', 'Gate median', 'Gate p90', 'Step medians'], out,
                 empty='No land-set result in this window.', wrap=(6,))


def sets_table(fleet, since):
    sets = {}
    for run in fleet.runs:
        moment = run['waiting'] or run['started'] or run['run'][0]['utc']
        if moment < since:
            continue
        e = sets.setdefault(run['set'], {'runs': 0, 'done': 0, 'stopped': 0, 'wait': [], 'run': []})
        e['runs'] += 1
        if run['end']:
            e[run['end']['event']] += 1
        if run['waiting'] and run['started']:
            e['wait'].append(run['started'] - run['waiting'])
        if run['started'] and run['end']:
            e['run'].append(run['end']['utc'] - run['started'])
    rows = [[E(name), str(e['runs']), str(e['done'] or '–'), str(e['stopped'] or '–'), span(median(e['wait'])),
             span(max(e['wait'], default=None)), span(median(e['run'])), span(max(e['run'], default=None))]
            for name, e in sorted(sets.items())]
    return table(['Set', 'Runs', 'Landed', 'Stopped', 'Lock wait median', 'Longest', 'Run median', 'Longest'],
                 rows, empty='No set run in this window.')


def turns_table(fleet, since):
    turns = [t for t in fleet.turns if t[1] >= since]
    out = []
    for repo in sorted({t[2] for t in turns}):
        mine = [t for t in turns if t[2] == repo]
        waits = [t[3] for t in mine if isinstance(t[3], (int, float))]
        held = [t[4] for t in mine if isinstance(t[4], (int, float))]
        out.append([E(repo or '?'), str(len(mine)), span(median(waits)), span(pct(waits, .9)),
                    span(median(held)), span(pct(held, .9))])
    return table(['Repository', 'Turns', 'Wait median', 'Wait p90', 'Held median', 'Held p90'], out,
                 empty='No landing turn in this window.')


def codex_table(fleet, since):
    runs = [r for r in fleet.codex if r[2] >= since]
    out = []
    for model, effort in sorted({(r[4], r[5]) for r in runs}):
        mine = [r for r in runs if (r[4], r[5]) == (model, effort)]
        took = [r[2] - r[1] for r in mine]
        tokens = [r[6] for r in mine if r[6]]
        total = [sum(t[i] for t in tokens) for i in range(3)] if tokens else [None] * 3
        cached = f'{total[1] / total[0]:.0%}' if total[0] else '–'
        out.append([E(f'{model} {effort}'), str(len(mine)), str(sum(r[3] != '0' for r in mine) or '–'),
                    span(median(took)), span(pct(took, .9)), compact(total[0]), cached, compact(total[2])])
    return table(['Model and effort', 'Runs', 'Failed', 'Median', 'p90', 'Input tokens', 'Cached', 'Output tokens'],
                 out, empty='No implementer run ended in this window.')


