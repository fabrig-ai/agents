# record's SECRET (records.md 2)
KEY = re.compile(r'-----BEGIN [^\n]*PRIVATE KEY-----|(?<![\w-])(?:gh[pousr]_[A-Za-z0-9_-]{20,}|github_pat_[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9_-]{20,})|xox[abpr]-|AKIA[A-Z0-9]{16}')
JWT = re.compile(r'(?<![A-Za-z0-9_-])eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+')
HEADER = re.compile(r'''(?<![\w-])(["']?)(?:Proxy-)?Authorization(["']?)\s*:\s*(["']?)[A-Za-z][A-Za-z0-9_-]*[ \t]+''', re.I)
COOKIE = re.compile(r'''(?<![\w-])(["']?)(Set-)?Cookie(["']?)\s*:\s*(["']?)''', re.I)
COOKIE_PAIR = re.compile(r'''[ \t]*[^\s=;"']+=''')
JAR_HEADING = re.compile(r'^# (?:Netscape HTTP|HTTP) Cookie File\s*$')
JAR = re.compile(r'^(?:#HttpOnly_)?[^\t]+\t(?:TRUE|FALSE)\t[^\t]+\t(?:TRUE|FALSE)\t[0-9]+\t[^\t]+\t([^\t]*)$')
URL = re.compile(r'''(?<![A-Za-z0-9+.-])[A-Za-z][A-Za-z0-9+.-]*://[^\s"'<>]+''')
URL_USER = re.compile(r'^[^:/?#]+://[^/@:?#]*:([^/@?#]*)@[^/?#]+')
PARAMETER = re.compile(r'[?&#;](?:code|token|secret|key|password|access_token|refresh_token|id_token|client_secret|signature)=([^&#;]*)', re.I)
ASSIGN_NAME = r'(?:password|passwd|secret|token|api_key|client_secret|access_token|refresh_token|private_key)'
ASSIGNED = re.compile(r'''(?<![\w])(?:(?P<json>["']''' + ASSIGN_NAME + r'''["']\s*:\s*)(?=["'])|''' + ASSIGN_NAME + r'(?![\w])\s*=\s*)', re.I)
COLON = re.compile(r'^\s*' + ASSIGN_NAME + r'\s*:\s*(.*)$', re.I)
USER = re.compile(r'(?<!\S)(?:--user(?:[ \t]+|=)|-u(?:[ \t]+|=)?)')
PLACEHOLDER = re.compile(r'(?:null|true|false|[A-Z][A-Z0-9_]*|<[^\n]*>|\$[A-Za-z_][A-Za-z0-9_]*|\$\{[A-Za-z_][A-Za-z0-9_]*\}|@[^\s]+|…|\.\.\.|\*+)?')
NAME_PART = re.compile(r'(?:^|[-_.])(?:cookies?|password|passwd|secret|token|credentials?|netrc)(?:$|[-_.])', re.I)
NAME_END = re.compile(r'(?:^auth\.json$|^id_rsa$|^id_ed25519$|^login(?:\..*)?$|\.(?:headers?|pem|key|env)$)', re.I)


class Refusal(NamedTuple):
    """A refused file, line and rule: never the text that matched (qa-flow.md 11.2)."""
    where: str
    line: int
    rule: str

    def __str__(self):
        return f'{self.where}, line {self.line}: {self.rule}' if self.line else f'{self.where}: {self.rule}'


def placeholder(value):
    if len(value) >= 2 and value[0] in ('"', "'") and value[-1] == value[0]:
        value = value[1:-1]
    return PLACEHOLDER.fullmatch(value) is not None


def refused_name(part):
    return bool(NAME_PART.search(part) or NAME_END.search(part))


def value_at(text, start, stops='', wrapper='', string=False):
    """One whole value, including adjacent chunks; an unmatched opener consumes its tail."""
    end = start
    while end < len(text):
        char = text[end]
        if char.isspace() or char in stops or (wrapper and char == wrapper):
            break
        if char in ('"', "'"):
            quote = char
            finish = end + 1
            while finish < len(text):
                if text[finish] == '\\':
                    finish += 2
                elif text[finish] == quote:
                    break
                else:
                    finish += 1
            if finish >= len(text):
                # Keep truncated values nonempty rather than accepting an empty placeholder.
                return text[start:], len(text)
            end = finish + 1
            if string:
                break  # A JSON string ends here; following punctuation is not its value.
        elif char == '<':
            finish = text.find('>', end + 1)
            if finish < 0:
                return text[start:], len(text)
            end = finish + 1
        else:
            end += 1
    return text[start:end], end


def scan(text):
    result = []
    for number, line in enumerate(text.split('\n'), 1):
        line = line.removesuffix('\r')
        rules = []
        if KEY.search(line):
            rules.append('key')
        if JWT.search(line):
            rules.append('jwt')
        header = False
        end = 0
        for match in HEADER.finditer(line):
            if match.start() < end:
                continue
            wrapper = match[3] or (match[1] if not match[2] else '')
            value, end = value_at(line, match.end(), wrapper=wrapper)
            if not placeholder(value):
                header = True
                break
        end = 0
        for cookie in COOKIE.finditer(line):
            if header:
                break
            if cookie.start() < end:
                continue
            wrapper = cookie[4] or (cookie[1] if not cookie[3] else '')
            offset = cookie.end()
            while pair := COOKIE_PAIR.match(line, offset):
                value, end = value_at(line, pair.end(), stops=';', wrapper=wrapper)
                header |= not placeholder(value)
                if header or cookie[2] or line[end:end + 1] != ';':
                    break  # Set-Cookie's remaining pairs are attributes, not cookies.
                offset = end + 1
        if header:
            rules.append('header')
        jar = JAR.fullmatch(line)
        if JAR_HEADING.fullmatch(line) or (jar and not placeholder(jar[1])):
            rules.append('cookie-jar')
        for url in URL.finditer(line):
            user = URL_USER.match(url[0])
            if ((user and not placeholder(user[1]))
                    or any(not placeholder(m[1]) for m in PARAMETER.finditer(url[0]))):
                rules.append('link')
                break
        colon = COLON.fullmatch(line)
        assigned = bool(colon and not placeholder(colon[1].rstrip()))
        end = 0
        for match in ASSIGNED.finditer(line):
            if assigned:
                break
            if match.start() < end:
                continue
            value, end = value_at(line, match.end(), stops='&;', string=bool(match['json']))
            assigned = not placeholder(value)
        if assigned:
            rules.append('assigned')
        end = 0
        for user in USER.finditer(line):
            if user.start() < end:
                continue
            value, end = value_at(line, user.end(), stops='&;')
            if value[:1] in ('"', "'") and value[-1:] == value[:1]:
                value = value[1:-1]
            if ':' in value and not placeholder(value.partition(':')[2]):
                rules.append('user')
                break
        result.extend((number, rule) for rule in rules)
    return result


class Snapshot:
    """A scratch directory's allowlist, read once through no-follow descriptors (qa-flow.md 11.1, 11.2)."""

    def __init__(self, files, left_out, refusals):
        self.files = files
        self.left_out = left_out
        self.refusals = refusals
        self.names = {}

    @classmethod
    def read(cls, directory, cap):
        flags = os.O_RDONLY | os.O_NOFOLLOW
        try:
            root = os.open(directory, flags | os.O_DIRECTORY)
        except OSError:
            raise Problem(f'{directory}: cannot open directory without following links') from None
        files, left_out, refusals, names = {}, {}, [], {}
        used = 0

        def walk(parent, entries, budget, count_only=False):
            held, labels, refused = {}, {}, []
            count = size = total = 0
            past = count_only
            # A stack keeps deep trees independent of Python's recursion limit.
            stack = [(parent, iter(entries), '', False)]
            try:
                while stack:
                    fd, listing, prefix, close = stack[-1]
                    item = next(listing, None)
                    if item is None:
                        stack.pop()
                        if close:
                            os.close(fd)
                        continue
                    entry, part, tree = item
                    path = prefix + part
                    label = f'{prefix or "./"}, entry {entry}'
                    rules = []
                    if not past:
                        try:
                            part.encode('utf-8')
                            binary = any(ord(c) < 32 or ord(c) == 127 for c in part)
                        except UnicodeError:
                            binary = True
                        rules = ['binary'] if binary else list(dict.fromkeys(rule for _, rule in scan(part)))
                        if not rules:
                            label = path
                            if refused_name(part):
                                rules = ['name']
                    try:
                        before = os.stat(part, dir_fd=fd, follow_symlinks=False)
                    except FileNotFoundError:
                        if not prefix:  # Absent allowlist entries are normal.
                            continue
                        refused.append(Refusal(label, 0, 'kind'))
                        continue
                    except OSError:
                        refused.append(Refusal(label, 0, 'kind'))
                        continue
                    refused.extend(Refusal(label, 0, rule) for rule in rules)
                    is_dir = stat.S_ISDIR(before.st_mode)
                    if (tree is False and is_dir) or (tree is True and not is_dir):
                        refused.append(Refusal(label, 0, 'kind'))
                        continue
                    if is_dir and rules:
                        continue  # Never walk or name anything under a refused directory.
                    regular = stat.S_ISREG(before.st_mode)
                    if regular:
                        count += 1
                        size += before.st_size
                    if not is_dir and (not regular or before.st_nlink != 1):
                        refused.append(Refusal(label, 0, 'kind'))
                        continue
                    if past and not is_dir:
                        continue
                    child = None
                    try:
                        child = os.open(part, flags | (os.O_DIRECTORY if is_dir else os.O_NONBLOCK), dir_fd=fd)
                        after = os.fstat(child)
                        if any(getattr(before, key) != getattr(after, key) for key in
                               ('st_dev', 'st_ino', 'st_mode', 'st_nlink', 'st_size', 'st_mtime_ns', 'st_ctime_ns')):
                            refused.append(Refusal(label, 0, 'kind'))
                            continue
                        if is_dir:
                            children = sorted(os.listdir(child), key=os.fsencode)
                            stack.append((child, iter((n, name, None) for n, name in enumerate(children, 1)), path + '/', True))
                            child = None  # The stack owns this descriptor.
                            continue
                        with os.fdopen(child, 'rb') as stream:
                            child = None
                            data = stream.read(max(0, budget - total) + 1)
                        total += len(data)
                        if total > budget:
                            past = True
                            held.clear()
                            labels.clear()
                            refused.clear()
                        else:
                            held[path] = data
                            labels[path] = label
                    except OSError:
                        refused.append(Refusal(label, 0, 'kind'))
                    finally:
                        if child is not None:
                            os.close(child)
            finally:
                for fd, _, _, close in stack:
                    if close:
                        os.close(fd)
            return held, labels, refused, past, (count, size)

        try:
            docs, labels, refused, past, _ = walk(root, [(n, name, False) for n, name in enumerate(DOCUMENTS, 1)], cap)
            files.update(docs)
            names.update(labels)
            refusals.extend([Refusal('documents', 0, 'cap')] if past else refused)
            used = sum(map(len, files.values()))
            omit = past
            for tree in TREES:
                held, labels, refused, over, counts = walk(root, [(1, tree, True)], cap - used, omit)
                if over:
                    if counts[0]:
                        left_out[tree + '/'] = counts
                    omit = True
                else:
                    files.update(held)
                    names.update(labels)
                    refusals.extend(refused)
                    used += sum(map(len, held.values()))
        finally:
            os.close(root)
        for path, data in files.items():
            where = names[path]
            try:
                text = data.decode('utf-8')
                if '\0' in text:
                    raise ValueError('NUL')
            except (UnicodeError, ValueError):
                refusals.append(Refusal(where, 0, 'binary'))
                continue
            refusals.extend(Refusal(where, line, rule) for line, rule in scan(text))
        snapshot = cls(dict(sorted(files.items())),
                       {tree + '/': left_out[tree + '/'] for tree in reversed(TREES) if tree + '/' in left_out},
                       sorted(set(refusals)))
        snapshot.names = names
        return snapshot

    def bytes(self):
        return sum(map(len, self.files.values()))


def keep_check(directory, options):
    cap = options['QA_EVIDENCE_KIB']
    snapshot = Snapshot.read(directory, cap * 1024)
    print(f'qa keep: {len(snapshot.files)} files, {snapshot.bytes()} bytes')
    for path, data in snapshot.files.items():
        print(f'  {snapshot.names[path]} {len(data)}')
    for tree, (count, size) in snapshot.left_out.items():
        print(f'left out: {tree}, {count} files, {size} bytes, past {cap} KiB')
    for refusal in snapshot.refusals:
        print(f'refused: {refusal}')
    need(not snapshot.refusals, f'copy refused ({len(snapshot.refusals)})')
    return 0


BRIEF = '''# QA pass {name}

Read {agents}/roles/qa.md first: it is your role.

- Repository: {repo}, at main {main}, checked out in {checkout}, your
  working directory. Leave its tracked files as they are.
- The commits to test, oldest first:
{commits}
- Your scratch directory: {directory}.
{rung_brief}
- Your wall time is capped at {cap} minutes, from {started}: past it
  your session is stopped, and your report is what the file holds
  then. Write it early and keep it current.
- Your report: {directory}/report.md, at most 7 KiB.
'''


def log(message):
    for line in str(message).splitlines():
        print('qa watch: ' + line, flush=True)


def settings(workspace):
    # Same precedence and valid machine.env lines as kit.sh's machine_setting.
    values = dict(QA_SLOTS='1', QA_BATCH='5', QA_CAP_MINUTES='120', QA_INTERVAL_SECONDS='300',
                  QA_GIVE_BACK_SECONDS='90', QA_EVIDENCE_KIB='2048')
    path = workspace.tmp / 'machine.env'
    try:
        text = path.read_text(errors='replace')
    except OSError:
        text = ''  # kit.sh ignores an absent or unreadable machine file.
    for line in text.split('\n'):
        match = re.fullmatch(r'(QA_SLOTS|QA_BATCH|QA_CAP_MINUTES|QA_INTERVAL_SECONDS|QA_GIVE_BACK_SECONDS|QA_EVIDENCE_KIB)=([0-9]+)', line)
        if match:
            values[match[1]] = match[2]
    for key in values:
        value = os.environ.get(key, values[key])
        need(re.fullmatch(r'[0-9]+', value), f'{key} must be a nonnegative integer')
        values[key] = int(value)
    need(values['QA_BATCH'] > 0, 'QA_BATCH must be positive')
    need(values['QA_EVIDENCE_KIB'] > 0, 'QA_EVIDENCE_KIB must be positive')
    return values


class Watch:
    def __init__(self, workspace, director):
        self.workspace, self.director = workspace, director
        self.directory = workspace.tmp / 'qa'
        self.runs = workspace.root / 'tmp/codex-run'
        self.record = Record(workspace, log)
        self.repositories = Repositories(workspace)

    def call(self, tool, *args):
        return command([self.workspace.tool(tool), *args])

    def save(self, directory, state):
        replace(directory / 'pass.json', (json.dumps(state, indent=2) + '\n').encode())

    def local_passes(self):
        result = []
        for path in sorted(self.directory.glob('*/pass.json')):
            need(not path.is_symlink() and not path.parent.is_symlink(), f'{path}: symlink refused', 4)
            state = json.loads(path.read_text())
            need(state['pass'] == path.parent.name and re.fullmatch(NAME, state['pass'])
                 and state['repository'] in REPOSITORIES, f'{path}: invalid pass', 4)
            need(not state['run'] or re.fullmatch(r'[a-zA-Z0-9_-]+', state['run']), f'{path}: invalid run', 4)
            result.append((path.parent, state))
        return result

    def outstanding(self, state):
        return {name: path for name, path in state.get('logins', {}).items() if name not in state.get('given', [])}

    def give(self, directory, state):
        for name in self.outstanding(state):
            result = self.call('logins', 'give', name, '--as', 'qa-watch')
            if result.returncode == 0:
                state.setdefault('given', []).append(name)
                self.save(directory, state)
                log(f'{state["pass"]}: gave {name} back')
            else:
                log(f'{state["pass"]}: cannot give {name} back: {result.stderr.strip()}')

    def give_strays(self, passes):
        # qa-flow.md 10: a take can survive a crash before pass.json is saved.
        held = {name for _, state in passes for name in self.outstanding(state)}
        names = {name for event in self.record.events('rungs') for name in event['route'].split(',') if name != '-'}
        path = self.directory / 'strays.json'
        need(not path.is_symlink(), f'{path}: symlink refused', 4)
        strays = json.loads(path.read_text()) if path.exists() else {}
        need(isinstance(strays, dict), f'{path}: invalid strays', 4)
        for name in sorted(names - held):
            result = self.call('logins', 'give', name, '--as', 'qa-watch')
            if result.returncode == 0:
                if result.stdout.strip() != f'already free: {name}':
                    log(f'gave back {name}: held without a pass')
                if name in strays:
                    strays.pop(name)
                    replace(path, (json.dumps(strays, indent=2) + '\n').encode())
            elif result.returncode == 1:
                log(f'{name} is out with no pass: {result.stderr.strip()}')
                if name not in strays:
                    message = self.directory / 'stray-post-body'
                    replace(message, (f'Login {name} is out with no QA pass holding it.\n'
                                      'Read logins list on this machine to recover it.\n').encode())
                    sent = self.call('post', 'send', '--as', 'qa-watch', self.director,
                                     f'qa: login {name} out with no pass', message)
                    if sent.returncode in (0, 3):
                        strays[name] = timestamp()
                        replace(path, (json.dumps(strays, indent=2) + '\n').encode())
                    else:
                        log(f'{name}: post failed: {sent.stderr.strip() or sent.stdout.strip()}')
            elif result.returncode != 2:
                log(f'{name}: cannot give stray login back: {result.stderr.strip()}')

    def unit_status(self, state):
        # qa-flow.md 10: deactivating still runs the unit's give-back.
        result = self.call('systemctl', '--user', 'show', '--property=LoadState',
                           '--property=ActiveState', '--', 'codex-run-' + state['run'])
        fields = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
        if result.returncode == 0 and set(fields) == {'LoadState', 'ActiveState'}:
            load, active = fields['LoadState'], fields['ActiveState']
            if (load == 'loaded' and active in ('inactive', 'failed')
                    or load == 'not-found' and active == 'inactive'):
                return 'stopped'
            if load == 'loaded' and active in ('activating', 'active', 'reloading', 'deactivating'):
                return 'busy'
        log(f'{state["pass"]}: cannot establish unit state; keeping logins held')
        return 'unknown'

    def unit_stopped(self, state, seconds):
        # qa-flow.md 10: ended precedes the unit's on-stop give-back.
        deadline = time.monotonic() + seconds
        while True:
            status = self.unit_status(state)
            if status == 'stopped':
                return True
            if status == 'unknown':
                return False
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                log(f'{state["pass"]}: waiting for unit to stop before giving logins back')
                return False
            time.sleep(min(2, remaining))

    def notify(self, directory, state):
        notice = state.get('notice')
        if not notice:
            return
        message = directory / 'post-body'
        replace(message, notice['body'].encode())
        sent = self.call('post', 'send', '--as', 'qa-watch', self.director, notice['subject'], message)
        if sent.returncode in (0, 3):
            state.pop('notice')
            self.save(directory, state)
            log(f'{state["pass"]}: posted director')
        else:
            log(f'{state["pass"]}: post failed: {sent.stderr.strip() or sent.stdout.strip()}')

    def facts(self, run):
        model = effort = ended = tokens = 'unknown'
        exit_code = 'unknown'
        if run:
            meta = self.runs / run / 'meta'
            if meta.exists():
                fields = dict(line.split('=', 1) for line in meta.read_text().splitlines() if '=' in line)
                model, effort = fields.get('model', model), fields.get('effort', effort)
            rows = self.runs / 'runs.tsv'
            if rows.exists():
                for line in rows.read_text().splitlines():
                    row = line.split('\t')
                    if len(row) >= 13 and row[0] == run:
                        ended, exit_code, model, effort, tokens = row[3], row[4], row[6], row[7], row[11]
        return dict(ended=ended, exit=exit_code, model=model, effort=effort, tokens=tokens)

    def finish(self, directory, state, failure=None):
        name = state['pass']
        report_path = directory / 'report.md'
        report = report_path.read_text(errors='replace') if report_path.exists() else ''
        facts = self.facts(state['run'])
        outcome = ('capped' if state['capped'] else 'failed' if failure or facts['exit'] != '0'
                   or not report.strip() or report.startswith('codex-run: the run wrote no report') else 'done')
        if failure:
            report = failure + '\n' + report
        path = self.record.path(f'qa/passes/{name}.md')
        result = Pass.read(path)
        ended = facts['ended'] if facts['ended'] != 'unknown' else timestamp()
        minutes = max(0, int((utc(ended) - utc(state['started'])).total_seconds()) // 60)
        wall = f'{minutes // 60}:{minutes % 60:02}'
        result.fields.update(ended=ended, wall=wall, tokens=facts['tokens'], model=facts['model'],
                             effort=facts['effort'], outcome=outcome)
        result.body = f'# QA pass {name}\n\n' + report
        if len(result.text().encode()) > 8192:
            suffix = f'\n(Cut at 8 KiB: the report was {len(report.encode())} bytes.)\n'
            result.body = f'# QA pass {name}\n\n'
            budget = 8192 - len((result.text() + suffix).encode())
            prefix = report.encode()[:max(0, budget)]
            # A long first line contributes nothing; no partial UTF-8 or partial line.
            prefix = prefix[:prefix.rfind(b'\n') + 1]
            result.body += prefix.decode() + suffix
        try:
            self.record.commit({f'qa/passes/{name}.md': result.text()}, f'qa watch: {name} {outcome}')
        except Problem as error:
            if error.code != 2:
                raise
            outcome = 'failed'
            result.fields['outcome'] = outcome
            result.body = f'# QA pass {name}\n\nThe report was refused by record: {error}.\n'
            self.record.commit({f'qa/passes/{name}.md': result.text()}, f'qa watch: {name} failed')
            log(f'{name}: report refused by record: {error}')
        count = len(result.findings())
        self.give(directory, state)
        state.update(finished=True, ended=ended)
        missing = self.outstanding(state)
        if outcome in ('failed', 'capped') or count or missing:
            state['notice'] = dict(subject=f'qa: pass {name} {outcome}, {count} findings', body=(
                f'QA pass {name} on {state["repository"]} ended {outcome} after {wall}, with {count} findings: '
                f"records' qa/passes/{name}.md; qa findings lists them.\n"
                + ''.join(f'Login {login} is not back at {path}: its deployment is in {directory}; '
                          'qa watch gives it back once it is.\n' for login, path in missing.items())))
        self.save(directory, state)
        log(f'{name}: {outcome}, {count} findings, {wall}')
        self.notify(directory, state)

    def start(self, repo, main, commits, checkout, cap, rung, logins):
        started = timestamp()
        base = utc(started).strftime('%Y%m%d-%H%M-') + repo
        name, index = base, 1
        while (self.directory / name).exists() or self.record.path(f'qa/passes/{name}.md').exists():
            index += 1
            name = base + '-' + str(index)
        directory = self.directory / name
        directory.mkdir(mode=0o700)
        state = {'pass': name, 'repository': repo, 'main': main, 'commits': [c['commit'] for c in commits],
                 'started': started, 'run': '', 'capped': False, 'finished': False,
                 'rung': rung, 'logins': logins, 'given': []}
        # Persist custody before preparing the checkout or committing its start.
        self.save(directory, state)
        git(checkout, 'checkout', '--detach', '--force', main)
        git(checkout, 'clean', '-fdq')
        if rung == '-':
            rung_brief = "- Your rung: the binding's first; no held login."
        else:
            rung_brief = (f"- Your rung: {rung}, as the product's binding names it: set your\n"
                          '  deployment up on it.')
            if not logins:
                rung_brief += '\nNo held login.'
            else:
                rung_brief += ('\n- Held logins, taken for you by the service, each at rest at its path:\n'
                               + '\n'.join(f'    - {name}: {path}' for name, path in logins.items())
                               + f"\n  Move each into your deployment as the binding says. At once after,\n"
                               f'  write {directory}/give-back: an executable that moves each back to\n'
                               "  its path by the product's export, every program in it named by its\n"
                               '  absolute path (it runs outside your shell). Run it yourself before\n'
                               '  your deployment stops, and check each path by stat alone (a regular\n'
                               '  file, 0600, not empty). Your unit runs it too when it stops, whatever\n'
                               '  stops it. Never run `logins`, never read or copy a login.')
        brief = BRIEF.format(name=name, agents=Path(__file__).resolve().parents[2], repo=repo, main=main,
                             checkout=checkout, directory=directory, cap=cap, started=started, rung_brief=rung_brief,
                             commits='\n'.join(f'  - {c["commit"]} {c["subject"]}\n    QA: {c["qa"]}' for c in commits))
        replace(directory / 'brief.md', brief.encode())
        fields = dict(repository=repo, main=main, commits=' '.join(state['commits']), rung=rung, machine=self.workspace.machine(),
                      model='unknown', effort='unknown', started=started, ended='unknown', wall='unknown',
                      tokens='unknown', outcome='running')
        report = Pass(name, fields, f'# QA pass {name}\n')
        try:
            self.record.commit({f'qa/passes/{name}.md': report.text()}, f'qa watch: {name} started')
        except Problem as error:
            log(f'{name}: record refused start: {error}')
            self.give(directory, state)
            state.update(finished=True, ended=timestamp())
            self.save(directory, state)
            message = directory / 'post-body'
            replace(message, f'QA pass {name} could not start: {error}.\n'.encode())
            sent = self.call('post', 'send', '--as', 'qa-watch', self.director, f'qa: pass {name} refused', message)
            if sent.returncode not in (0, 3):
                log(f'{name}: post failed: {sent.stderr.strip()}')
            if not logins:
                shutil.rmtree(directory)
            return False
        launch = self.call('codex-run', 'task', '--to', 'qa-watch', '--on-stop', directory / 'give-back',
                           directory / 'brief.md', checkout, directory / 'report.md')
        words = launch.stdout.split()
        if launch.returncode or not words or not re.fullmatch(r'[a-zA-Z0-9_-]+', words[0]):
            # No unit launched: a record failure must not keep resting logins held.
            self.give(directory, state)
            self.finish(directory, state, 'codex-run refused: ' + (launch.stderr.strip() or launch.stdout.strip() or 'no run id'))
        else:
            state['run'] = words[0]
            self.save(directory, state)
            log(f'{name}: started run {state["run"]} at {main}')
        return True

    def recover_run(self, directory, state):
        # codex-run writes meta before launching its unit. Recover an acknowledged
        # launch even if this service died before saving the returned id.
        matches = []
        for path in self.runs.glob('*/meta'):
            fields = dict(line.split('=', 1) for line in path.read_text().splitlines() if '=' in line)
            if fields.get('task') == str(directory / 'brief.md') and fields.get('report') == str(directory / 'report.md'):
                need(re.fullmatch(r'[a-zA-Z0-9_-]+', path.parent.name), 'invalid recovered run', 4)
                matches.append(path.parent.name)
        need(len(matches) <= 1, f'{state["pass"]}: multiple runs for one brief', 4)
        if matches:
            state['run'] = matches[0]
            self.save(directory, state)
            log(f'{state["pass"]}: recovered run {state["run"]}')

    def check(self, options):
        log('checking')
        with self.record.locked():
            passes = self.local_passes()
            self.give_strays(passes)
            for directory, state in passes:
                if state['finished']:
                    self.give(directory, state)
                    self.notify(directory, state)
                    continue
                if not state['run']:
                    if not self.record.path(f'qa/passes/{state["pass"]}.md').exists():
                        self.give(directory, state)
                        if self.outstanding(state):
                            continue
                        shutil.rmtree(directory)
                        log(f'{state["pass"]}: removed uncommitted start')
                        continue
                    self.recover_run(directory, state)
                run = state['run']
                ended = self.runs / run / 'ended' if run else None
                if ended and ended.exists():
                    if self.outstanding(state) and not self.unit_stopped(state, options['QA_GIVE_BACK_SECONDS']):
                        continue
                    self.finish(directory, state)
                elif not run:
                    self.finish(directory, state, 'The service stopped before saving a run id.')
                else:
                    status = self.unit_status(state)
                    if status == 'unknown':
                        continue
                    if status == 'stopped':
                        self.finish(directory, state, None if ended.exists() else 'The run unit vanished without its end.')
                        continue
                    if not (state['capped'] or (utc(timestamp()) - utc(state['started'])).total_seconds() >= options['QA_CAP_MINUTES'] * 60):
                        continue
                    state['capped'] = True
                    self.save(directory, state)
                    stopped = self.call('systemctl', '--user', 'stop', 'codex-run-' + run)
                    if stopped.returncode:
                        state['capped'] = False
                        self.save(directory, state)
                        log(f'{state["pass"]}: stop failed: {stopped.stderr.strip()}')
                    else:
                        log(f'{state["pass"]}: capped run {run}')
            running = [s for _, s in self.local_passes() if not s['finished']]
            free = max(0, options['QA_SLOTS'] - len(running))
            busy = {s['repository'] for s in running}
            # Preflight every source before any launch: an unreadable feed starts none.
            waiting = chosen(self.record, 'run')
            repos = list(dict.fromkeys(r for r, _, _ in waiting if r not in busy)) if free else []
            cleared = {}
            for repo in repos:
                result = self.call('landings', 'cleared', repo)
                if result.returncode == 1:
                    log(f'{repo}: no cleared main')
                    continue
                if result.returncode:
                    log(f'{repo}: cannot read cleared main: {result.stderr.strip() or result.stdout.strip()}')
                    cleared = {}
                    break
                main = result.stdout.strip()
                need(re.fullmatch(SHA, main), f'{repo}: invalid cleared main', 4)
                cleared[repo] = main
            for repo, main in cleared.items():
                if not free:
                    break
                with self.repositories.fetched(repo) as checkout:
                    order = git(checkout, 'rev-list', '--reverse', 'origin/main').splitlines()
                    selected = {sha for r, sha, _ in waiting if r == repo}
                    need(selected <= set(order), f'{repo}: waiting commit missing from origin/main', 4)
                    selected = [sha for sha in order if sha in selected]
                    def holds(sha):
                        result = git(checkout, 'merge-base', '--is-ancestor', sha, main, check=False)
                        need(result.returncode in (0, 1), f'{repo}: cannot read cleared commit {main}', 4)
                        return result.returncode == 0
                    if not holds(selected[0]):
                        log(f'{repo}: cleared main does not hold oldest waiting commit')
                        continue
                    commits = []
                    for sha in selected:
                        if holds(sha):
                            subject = git(checkout, 'show', '-s', '--format=%s', sha)
                            trailer = git(checkout, 'show', '-s', '--format=%(trailers:key=QA,valueonly)', sha)
                            commits.append(dict(commit=sha, subject=subject, qa=' '.join(trailer.splitlines())))
                            if len(commits) == options['QA_BATCH']:
                                break
                    opening = rung(self.record, repo)
                    names = sorted(opening['logins']) if opening else []
                    held = [(name, state['pass']) for _, state in self.local_passes()
                            for name in self.outstanding(state) if name in names]
                    if held:
                        for name, pass_name in held:
                            log(f'{repo}: login {name} not back from {pass_name}')
                        continue
                    logins = {}
                    for name in names:
                        taken = self.call('logins', 'take', name, '--as', 'qa-watch', '--note', repo)
                        if taken.returncode:
                            for login in logins:
                                given = self.call('logins', 'give', login, '--as', 'qa-watch')
                                if given.returncode:
                                    log(f'{repo}: cannot give {login} back: {given.stderr.strip()}')
                            log(f'{repo}: waiting for login {name}: {taken.stderr.strip()}')
                            break
                        logins[name] = taken.stdout.strip()
                    else:
                        if not self.start(repo, main, commits, checkout, options['QA_CAP_MINUTES'],
                                          opening['rung'] if opening else '-', logins):
                            break
                        free -= 1
            for directory, state in self.local_passes():
                if state['finished'] and not self.outstanding(state) and not state.get('notice') and (utc(timestamp()) - utc(state['ended'])).total_seconds() >= 7 * 86400:
                    shutil.rmtree(directory)
                    log(f'{state["pass"]}: pruned')


def watch(director, once, workspace):
    os.environ['POST_NAME'] = 'qa-watch'
    # Check assignment before mkdir, locks, record pull, or any other side effect.
    need(workspace.fixture or (Path.home() / '.config/agents-qa/director').is_file(),
         "this is not the service's machine (no ~/.config/agents-qa/director)")
    need(re.fullmatch(r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*@[a-z][a-z0-9-]*', director),
         'invalid director address: expected NAME@MACHINE')
    service = Watch(workspace, director)
    service.directory.mkdir(parents=True, exist_ok=True)
    with (service.directory / 'watch.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Problem('another service runs') from None
        while True:
            options = settings(workspace)
            service.check(options)
            if once:
                return 0
            interval = options['QA_INTERVAL_SECONDS']
            waited = service.call('post', 'wait', 'qa-watch', '--timeout', str(interval), '--holder', str(os.getpid()), '--kind', 'codex')
            if waited.returncode == 0:
                read = service.call('post', 'read', 'qa-watch')
                log(read.stdout)
                if read.returncode:
                    log('post read failed: ' + read.stderr.strip())
            elif waited.returncode == 4:
                log('another waiter took qa-watch')
                return 2
            elif waited.returncode != 1:
                log('post wait failed: ' + (waited.stderr.strip() or waited.stdout.strip()))
                time.sleep(interval)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('candidates', 'backlog'):
        sub.add_parser(name).add_argument('repo', nargs='?')
    decide_parser = sub.add_parser('decide')
    decide_parser.add_argument('repo')
    decide_parser.add_argument('choices', nargs='+')
    decide_parser.add_argument('--why', default='')
    sub.add_parser('passes').add_argument('--running', action='store_true')
    sub.add_parser('findings')
    rung_parser = sub.add_parser('rung')
    rung_parser.add_argument('repo')
    rung_parser.add_argument('rung', nargs='?')
    rung_parser.add_argument('--login', action='append', default=[])
    rung_parser.add_argument('--why', default='')
    triage_parser = sub.add_parser('triage')
    triage_parser.add_argument('pass_name')
    triage_parser.add_argument('number', type=int)
    triage_parser.add_argument('route', nargs='+')
    triage_parser.add_argument('--why', default='')
    keep = sub.add_parser('keep')
    keep.add_mutually_exclusive_group(required=True).add_argument('--check', metavar='DIRECTORY')
    service = sub.add_parser('watch')
    service.add_argument('--director', required=True)
    service.add_argument('--once', action='store_true')
    args = parser.parse_args()
    try:
        workspace = Workspace()
        if args.command == 'keep':
            return keep_check(args.check, settings(workspace))
        if args.command == 'watch':
            return watch(args.director, args.once, workspace)
        why = getattr(args, 'why', '') or ''
        need(not any(c in why for c in '\n\r\t'), '--why must not contain a newline or tab')
        repo = getattr(args, 'repo', None)
        if repo:
            workspace.origin(repo)
        workspace.tmp.mkdir(parents=True, exist_ok=True)
        record = Record(workspace)
        with record.locked():
            repositories = Repositories(workspace)
            if args.command == 'candidates':
                candidates(repo, record, repositories)
            elif args.command == 'decide':
                decide(args, record, repositories)
            elif args.command == 'backlog':
                backlog(repo, record, repositories)
            elif args.command == 'passes':
                passes(args.running, record, repositories)
            elif args.command == 'rung':
                open_rung(args, record)
            elif args.command == 'findings':
                findings(record)
            elif args.command == 'triage':
                triage(args, workspace, record)
        return 0
    except Problem as error:
        print(f'qa: {error}', file=sys.stderr)
        return error.code
    except (OSError, ValueError, UnicodeError) as error:
        print(f'qa: {error}', file=sys.stderr)
        return 4


if __name__ == '__main__':
    sys.exit(main())
