PASS_KEYS = 'repository main commits machine model effort started ended wall tokens outcome'.split()


class Problem(Exception):
    def __init__(self, why, code=2):
        super().__init__(why)
        self.code = code


def need(ok, why, code=2):
    if not ok:
        raise Problem(why, code)


def command(argv, cwd=None, timeout=None):
    argv = [str(a) for a in argv]
    with subprocess.Popen(argv, cwd=cwd, stdin=subprocess.DEVNULL,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                          env=dict(os.environ, GIT_TERMINAL_PROMPT='0'),
                          start_new_session=timeout is not None) as child:
        try:
            stdout, stderr = child.communicate(timeout=timeout)
            return subprocess.CompletedProcess(argv, child.returncode, stdout, stderr)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            stdout, stderr = child.communicate()
            return subprocess.CompletedProcess(argv, 124, stdout, stderr + 'command timed out\n')


def git(root, *args, check=True, timeout=300):
    result = command(['git', '-C', root, *args], timeout=timeout)
    if check:
        need(result.returncode == 0, result.stderr.strip() or 'git failed', 4)
    return result.stdout.strip() if check else result


def timestamp():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def utc(value):
    if value == 'unknown':
        return datetime.min.replace(tzinfo=timezone.utc)
    need(re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d(?::\d\d)?Z', value),
         f'invalid UTC time: {value}', 4)
    return datetime.fromisoformat(value.replace('Z', '+00:00'))


class Workspace:
    def __init__(self):
        self.kit = Path(__file__).resolve().parent
        agents = self.kit.parent.parent
        self.root = Path(os.environ.get('DEV_ROOT', agents.parent if agents.name == 'agents'
                                        else Path.home() / 'src/rust')).expanduser().absolute()
        self.tmp = Path(os.environ.get('DEV_TMP', self.root / 'tmp')).expanduser().absolute()
        record_workspace = Path.home() / ('src/rust' if (Path.home() / 'src/rust').exists() else 'src')
        self.records = Path(os.environ.get('RECORDS', record_workspace / 'records')).expanduser().absolute()
        fixture = os.environ.get('QA_FIXTURE')
        self.fixture = Path(fixture).absolute() if fixture else None
        need(fixture is None or (fixture and self.fixture.is_dir()), 'QA_FIXTURE must be a directory')

    def machine(self):
        try:
            lines = (self.root / 'tmp/post/machines').read_text().splitlines()
        except OSError:
            lines = []
        for line in lines:
            fields = line.partition('#')[0].split()
            if len(fields) >= 2 and fields[1] == 'local':
                return fields[0]
        return socket.gethostname()

    def tool(self, name):
        default = Path(name) if name in ('systemctl', 'systemd-run') else self.kit / name
        return Path(os.environ.get('QA_' + name.upper().replace('-', '_'), default)) if self.fixture else default

    def origin(self, repo):
        need(repo in REPOSITORIES, f'unknown repository: {repo}')
        return str(self.fixture / 'origins' / (repo + '.git')) if self.fixture else f'git@github.com:fabrig-ai/{repo}.git'


def no_links(anchor, path):
    parts = path.relative_to(anchor).parts
    current = anchor
    for part in ('', *parts):
        if part:
            current /= part
        try:
            mode = os.lstat(current).st_mode
        except FileNotFoundError:
            break
        need(not stat.S_ISLNK(mode), f'{current}: symlink refused', 4)


class Repositories:
    def __init__(self, workspace):
        self.workspace = workspace

    @contextmanager
    def fetched(self, repo):
        origin = self.workspace.origin(repo)
        parent = self.workspace.tmp / 'qa/repos'
        no_links(self.workspace.tmp, parent)
        parent.mkdir(parents=True, exist_ok=True)
        root = parent / repo
        with (parent / (repo + '.lock')).open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            no_links(self.workspace.tmp, root)
            if not root.exists():
                # A failed clone leaves no half-built repository at the shared path.
                with tempfile.TemporaryDirectory(prefix=repo + '-', dir=parent) as directory:
                    clone = Path(directory) / 'repo'
                    result = command(['git', 'clone', '--filter=blob:none', '--no-checkout', origin, clone], timeout=300)
                    need(result.returncode == 0, f'cannot clone {repo}: {result.stderr.strip()}', 4)
                    clone.rename(root)
            need(git(root, 'config', '--get', 'remote.origin.url') == origin,
                 f'{root}: unexpected origin', 4)
            result = git(root, 'fetch', '--quiet', 'origin', '+refs/heads/*:refs/remotes/origin/*', check=False)
            need(result.returncode == 0, f'cannot fetch {repo}: {result.stderr.strip()}', 4)
            yield root

    def commits(self, repo):
        with self.fetched(repo) as root:
            # NULs frame each commit; unit separators preserve multi-line trailer values.
            text = git(root, 'log', '--reverse', '--format=%H%x1f%cs%x1f%ct%x1f%s%x1f%(trailers:key=QA,valueonly)%x00', 'origin/main')
        result = []
        for row in text.split('\0'):
            if row.strip():
                sha, date, seconds, subject, trailer = row.lstrip('\n').split('\x1f', 4)
                result.append(dict(repository=repo, commit=sha, short=sha[:9], date=date,
                                   subject=subject, seconds=int(seconds), qa=' '.join(trailer.splitlines()).strip()))
        return result

    def checkout(self, root, repo, slot, main):
        # The caller holds fetched's clone lock throughout validation and add.
        path = root if slot == 1 else root.with_name(f'{repo}-{slot}')
        no_links(self.workspace.tmp, path)
        if slot != 1:
            listed = git(root, 'worktree', 'list', '--porcelain').splitlines()
            common = git(root, 'rev-parse', '--path-format=absolute', '--git-common-dir')
            own = (git(path, 'rev-parse', '--path-format=absolute', '--git-common-dir', check=False)
                   if path.is_dir() and not path.is_symlink() else None)
            valid = (f'worktree {path}' in listed and own is not None
                     and own.returncode == 0 and own.stdout.strip() == common)
            if not valid:
                no_links(self.workspace.tmp, path)
                if path.exists() and not path.is_dir():
                    path.unlink()
                elif path.exists():
                    shutil.rmtree(path)
                git(root, 'worktree', 'prune')
                git(root, 'worktree', 'add', '--detach', str(path), main)
        git(path, 'checkout', '--detach', '--force', main)
        git(path, 'clean', '-fdq')
        return path

    def resolve(self, repo, prefixes):
        with self.fetched(repo) as root:
            commits = []
            for prefix in prefixes:
                need(re.fullmatch(r'[0-9a-fA-F]{7,40}', prefix), f'commit needs 7 to 40 hex digits: {prefix}')
                matches = git(root, 'rev-parse', '--disambiguate=' + prefix.lower()).splitlines()
                matches = [sha for sha in matches if git(root, 'cat-file', '-t', sha) == 'commit']
                need(matches, f'commit not found: {prefix}')
                need(len(matches) == 1, f'ambiguous commit: {prefix}')
                sha = matches[0]
                need(git(root, 'merge-base', '--is-ancestor', sha, 'origin/main', check=False).returncode == 0,
                     f'commit not on origin/main: {prefix}')
                trailer = git(root, 'show', '-s', '--format=%(trailers:key=QA,valueonly)', sha)
                need(trailer, f'commit has no QA: trailer: {prefix}')
                if sha not in commits:
                    commits.append(sha)
            return commits


class Pass:
    def __init__(self, name, fields, body):
        self.name, self.fields, self.body = name, fields, body

    @classmethod
    def read(cls, path):
        text = path.read_text()
        front = re.match(r'\A---\n(.*?)\n---(?:\n|$)', text, re.S)
        need(front, f'{path}: front matter missing', 4)
        fields = {}
        for line in front[1].splitlines():
            key, sep, value = line.partition(':')
            need(sep and key not in fields and value.strip(), f'{path}: invalid front matter', 4)
            fields[key] = value.strip()
        fields.setdefault('rung', '-')
        fields.setdefault('logins', '-')
        need(fields['rung'] == '-' or re.fullmatch(NAME, fields['rung']), f'{path}: invalid rung', 4)
        need(all(key in fields for key in PASS_KEYS), f'{path}: incomplete front matter', 4)
        need(fields['repository'] in REPOSITORIES and fields['outcome'] in ('running', 'done', 'capped', 'failed'),
             f'{path}: invalid repository or outcome', 4)
        need(all(re.fullmatch(SHA, sha) for sha in fields['commits'].split()), f'{path}: invalid commits', 4)
        utc(fields['started'])
        utc(fields['ended'])
        return cls(path.stem, fields, text[front.end():])

    def text(self):
        return '---\n' + ''.join(f'{key}: {value}\n' for key, value in self.fields.items()) + '---\n' + self.body

    def findings(self):
        section = re.search(r'^## Findings[ \t]*\n(.*?)(?=^##[ \t]+|\Z)', self.body, re.M | re.S)
        return sorted((int(n), title) for n, title in re.findall(r'^### ([1-9][0-9]*)\. (.+)$', section[1], re.M)) if section else []


class Record:
    def __init__(self, workspace, logger=None):
        self.workspace, self.root = workspace, workspace.records
        self.logger = logger

    def warn(self, message):
        if self.logger:
            self.logger("warning: " + message)
        else:
            print("qa: warning: " + message, file=sys.stderr)

    @contextmanager
    def locked(self):
        common = Path(git(self.root, 'rev-parse', '--path-format=absolute', '--git-common-dir'))
        # Separate from record.lock: record's subprocess must acquire that itself.
        with (common / 'qa.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            result = command([self.workspace.tool('record'), 'pull'], timeout=300)
            if result.returncode:
                self.warn('record pull failed: ' + result.stderr.strip())
            yield self

    def path(self, name):
        path = self.root / name
        for part in (path, *path.parents):
            if part == self.root:
                break
            need(not part.is_symlink(), f'{name}: symlink refused')
        return path

    def events(self, kind):
        path = self.path('qa/' + kind + '.md')
        if not path.exists():
            return []
        rows = []
        patterns = dict(decisions=rf'- (\S+) (\S+) ({SHA}) (run|backlog)(?: (.*))?',
                        triage=r'- (\S+) (\S+) ([1-9][0-9]*) (\S+)(?: (.*))?',
                        rungs=rf'- (\S+) (\S+) ({NAME}) (-|{LOGIN}(?:,{LOGIN})*)(?: (.*))?')
        pattern = patterns[kind]
        for line in path.read_text().splitlines():
            if not line.strip() or line.startswith('#'):
                continue
            match = re.fullmatch(pattern, line)
            need(match, f'{path}: invalid event line', 4)
            stamp, who, item, route, why = match.groups()
            rows.append(dict(time=utc(stamp), who=who, item=item, route=route, why=why or ''))
        return rows

    def passes(self):
        directory = self.path('qa/passes')
        result = []
        for path in sorted(directory.glob('*.md')):
            need(re.fullmatch(NAME, path.stem), f'{path}: invalid pass name', 4)
            result.append(Pass.read(self.path('qa/passes/' + path.name)))
        return sorted(result, key=lambda p: (utc(p.fields['started']), p.name))

    def append(self, name, line, heading=None):
        path = self.path(name)
        text = path.read_text() if path.exists() else (heading + '\n\n' if heading else '')
        return text + ('' if not text or text.endswith('\n') else '\n') + line + '\n'

    def commit(self, changes, message):
        before = {}
        try:
            for name, text in changes.items():
                path = self.path(name)
                before[name] = (path.read_bytes(), path.stat().st_mode) if path.exists() else None
                replace(path, text.encode(), before[name][1] if before[name] else 0o600)
            result = command([self.workspace.tool('record'), 'commit', '-m', message, *changes], timeout=300)
            need(result.returncode in (0, 3), result.stderr.strip() or 'record commit failed',
                 2 if result.returncode == 2 else 1)
            if result.returncode == 3:
                self.warn(result.stderr.strip())
        except BaseException:
            for name, old in before.items():
                path = self.path(name)
                if old is None:
                    path.unlink(missing_ok=True)
                else:
                    replace(path, *old)
            raise


def replace(path, data, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as target:
        temporary = Path(target.name)
        try:
            target.write(data)
            target.flush()
            os.chmod(temporary, mode)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def states(decisions, passes):
    """Latest event wins; at equal times a pass takes precedence."""
    result, keys = {}, {}
    for index, event in enumerate(decisions):
        identity = event['who'], event['item']
        key = event['time'], 0, index
        if identity not in keys or key > keys[identity]:
            keys[identity], result[identity] = key, event
    for index, report in enumerate(passes):
        key = utc(report.fields['started']), 1, index
        for sha in report.fields['commits'].split():
            identity = report.fields['repository'], sha
            if identity not in keys or key > keys[identity]:
                keys[identity] = key
                result[identity] = dict(time=key[0], route='taken', pass_name=report.name)
    return result


def first_line(commit):
    return '{repository} {short} {date} {subject}'.format(**commit)


def show_commits(repositories, selected):
    cache = {repo: {c['commit']: c for c in repositories.commits(repo)} for repo in dict.fromkeys(r for r, _, _ in selected)}
    for repo, sha, event in selected:
        need(sha in cache[repo], f'{repo} {sha}: recorded commit is not on origin/main', 4)
        yield cache[repo][sha], event


def decide(args, record, repositories):
    repo, why = args.repo, args.why
    need(len(args.choices) >= 2 and args.choices[-1] in ('run', 'backlog'), 'decide needs COMMIT... run|backlog')
    shas = repositories.resolve(repo, args.choices[:-1])
    route = args.choices[-1]
    name = 'qa/decisions.md'
    text = record.append(name, '\n'.join(f'- {timestamp()} {repo} {sha} {route} {why}' for sha in shas), '# QA decisions')
    record.commit({name: text}, f'qa decide: {repo} ' + ' '.join(s[:9] for s in shas) + ' ' + route)
    for sha in shas:
        print(f'decided: {repo} {sha[:9]} {route}')
    return


def rung(record, repo):
    opening = next((event for event in reversed(record.events('rungs')) if event['who'] == repo), None)
    if opening:
        return dict(rung=opening['item'], logins=[] if opening['route'] == '-' else opening['route'].split(','),
                    time=opening['time'])
    return None


def open_rung(args, record):
    if args.rung is None:
        need(not args.login and not args.why, '--login and --why need a rung')
        opening = rung(record, args.repo)
        if opening:
            logins = ','.join(opening['logins']) or '-'
            stamp = opening['time'].strftime('%Y-%m-%dT%H:%M:%SZ')
            print(f'{args.repo} {opening["rung"]} {logins} since {stamp}')
        else:
            print(f"{args.repo}: no rung opened: the binding's first, no login")
        return
    need(re.fullmatch(NAME, args.rung), 'invalid rung: expected NAME')
    need(all(re.fullmatch(LOGIN, name) for name in args.login), 'invalid login: expected NAME')
    for name in args.login:
        need(not re.search(r'-[0-9]+$', name), f'not a pool: {name}')
    need(len(args.login) == len(set(args.login)), 'repeated login')
    logins = ','.join(sorted(args.login)) or '-'
    name = 'qa/rungs.md'
    text = record.append(name, f'- {timestamp()} {args.repo} {args.rung} {logins} {args.why}', '# QA rungs')
    record.commit({name: text}, f'qa rung: {args.repo} {args.rung}')
    print(f'opened: {args.repo} {args.rung} {logins}')


def findings(record):
    triaged = {(r['who'], int(r['item'])) for r in record.events('triage')}
    lines = [f'{p.name} {n} {title}' for p in record.passes() if p.fields['outcome'] != 'running'
             for n, title in p.findings() if (p.name, n) not in triaged]
    print('\n'.join(lines) or 'no findings waiting')


def triage(args, workspace, record):
    why, passes = args.why, record.passes()
    report = next((p for p in passes if p.name == args.pass_name), None)
    need(report, f'unknown pass: {args.pass_name}')
    need(report.fields['outcome'] != 'running', f'pass is running: {report.name}')
    title = dict(report.findings()).get(args.number)
    need(title is not None, f'pass has no finding {args.number}')
    need(args.route in (['backlog'], ['drop']) or (len(args.route) == 2 and args.route[0] == 'owner'), 'route must be owner ADDRESS, backlog or drop')
    route = args.route[-1]
    if args.route[0] == 'owner':
        need(re.fullmatch(r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*@[a-z][a-z0-9-]*', route), 'invalid owner address: expected NAME@MACHINE')
        body = (f'QA pass {report.name} on {report.fields["repository"]} found this, and the director routes it to you.\n'
                f"The report is records' qa/passes/{report.name}.md, finding {args.number}: record pull, then read it.\n")
        with tempfile.NamedTemporaryFile(mode='w', dir=workspace.tmp) as message:
            message.write(body + (why + '\n' if why else ''))
            message.flush()
            sent = command([workspace.tool('post'), 'send', route, f'QA finding {report.name} {args.number}: {title}', message.name])
        need(sent.returncode in (0, 3), 'post send failed: ' + sent.stderr.strip())
        if sent.returncode == 3:
            print('qa: warning: message queued; nobody will wake its reader', file=sys.stderr)
    name = 'qa/triage.md'
    changes = {name: record.append(name, f'- {timestamp()} {report.name} {args.number} {route} {why}', '# QA triage')}
    if route == 'backlog':
        name = 'director/backlog.md'
        changes[name] = record.append(name, f"- QA pass {report.name}, finding {args.number}: {title}. Source/repro: records' qa/passes/{report.name}.md, finding {args.number}.")
    record.commit(changes, f'qa triage: {report.name} {args.number} {route}')
    print(f'triaged: {report.name} {args.number} {route}')
    return


def chosen(record, route, repo=None):
    current = states(record.events('decisions'), record.passes())
    return sorted([(r, sha, event) for (r, sha), event in current.items()
                   if event['route'] == route and (not repo or repo == r)], key=lambda row: row[2]['time'])


def candidates(repo, record, repositories):
    current = states(record.events('decisions'), record.passes())
    commits = [c for r in ([repo] if repo else REPOSITORIES) for c in repositories.commits(r)
               if c['qa'] and (r, c['commit']) not in current]
    commits.sort(key=lambda c: c['seconds'])
    print('\n'.join(first_line(c) + '\n  QA: ' + c['qa'] for c in commits) or 'no candidates')


def backlog(repo, record, repositories):
    selected = chosen(record, 'backlog', repo)
    if not selected:
        print('no commits kept for later')
    for commit, event in show_commits(repositories, selected):
        print(first_line(commit))
        if event['why']:
            print('  why: ' + event['why'])


def passes(running, record, repositories):
    lines = [f'{p.name} {p.fields["repository"]} {p.fields["rung"]} {p.fields["outcome"]} {p.fields["wall"]} {p.fields["tokens"]} '
             + ' '.join(s[:9] for s in p.fields['commits'].split()) for p in record.passes()
             if not running or p.fields['outcome'] == 'running']
    print('\n'.join(lines) or 'no passes')
    selected = chosen(record, 'run')
    print(f'waiting: {len(selected)} commits chosen to run')
    for commit, _ in show_commits(repositories, selected):
        print(first_line(commit))


BRIEF = '''# QA pass {name}

Read {agents}/roles/qa.md first: it is your role.

- Repository: {repo}, at main {main}, checked out in {checkout}, your
  working directory. Leave its tracked files as they are.
- The commits to test, oldest first:
{commits}
- Your scratch directory: {directory}.
{rung_brief}
- Your wall time is capped at {cap} minutes, from {started}: past it
  your session is stopped, and your report is what the file holds
  then. Write it early and keep it current.
- Start each deployment with `qa deploy {directory} NAME -- COMMAND...`:
  it runs as the unit qa-{name}-NAME, outside your session, and its stop
  runs your give-back file before it signals the deployment. Never
  systemd-run one yourself, and never stop one whose moved login isn't
  back by stat: leave it up and name its unit in your report's first line.
- Your report: {directory}/report.md, at most 7 KiB.
'''


def log(message):
    for line in str(message).splitlines():
        print('qa watch: ' + line, flush=True)


def settings(workspace):
    # Same precedence and valid machine.env lines as kit.sh's machine_setting.
    values = dict(QA_SLOTS='1', QA_BATCH='5', QA_CAP_MINUTES='120', QA_INTERVAL_SECONDS='300',
                  QA_GIVE_BACK_SECONDS='90', QA_STOP_SECONDS='50')
    path = workspace.tmp / 'machine.env'
    try:
        text = path.read_text(errors='replace')
    except OSError:
        text = ''  # kit.sh ignores an absent or unreadable machine file.
    for line in text.split('\n'):
        match = re.fullmatch(r'(QA_SLOTS|QA_BATCH|QA_CAP_MINUTES|QA_INTERVAL_SECONDS|QA_GIVE_BACK_SECONDS|QA_STOP_SECONDS)=([0-9]+)', line)
        if match:
            values[match[1]] = match[2]
    for key in values:
        value = os.environ.get(key, values[key])
        need(re.fullmatch(r'[0-9]+', value), f'{key} must be a nonnegative integer')
        values[key] = int(value)
    need(values['QA_BATCH'] > 0, 'QA_BATCH must be positive')
    need(0 < values['QA_STOP_SECONDS'] < 60, 'QA_STOP_SECONDS must be positive and below 60')
    return values


def stop_path(path):
    need(not any(c in str(path) for c in '$%"\\ \t\n'), f'{path}: unsafe path in a stop command')
    return path


def deploy(args, workspace):
    directory = Path(args.directory)
    need(directory.is_absolute() and directory.is_dir() and not directory.is_symlink(),
         'DIRECTORY must be an absolute directory, not a link')
    need(re.fullmatch(NAME, directory.name), 'DIRECTORY must have a pass or walk name')
    stop_path(directory)
    script = stop_path(Path(__file__).resolve())
    need(re.fullmatch(r'[a-z][a-z0-9-]*', args.name), 'NAME must be a lowercase slug')
    need(args.argv, 'deploy needs COMMAND')
    executable = shutil.which(args.argv[0])
    need(executable, f'COMMAND not found: {args.argv[0]}')
    executable = str(Path(executable).absolute())
    seconds = settings(workspace)['QA_STOP_SECONDS']
    unit = f'qa-{directory.name}-{args.name}'
    try:
        descriptor = os.open(directory / 'deployments', os.O_RDWR | os.O_CREAT | os.O_APPEND
                             | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    except OSError:
        raise Problem('cannot open deployments safely') from None
    with os.fdopen(descriptor, 'r') as recorded:
        info = os.fstat(recorded.fileno())
        need(stat.S_ISREG(info.st_mode) and info.st_nlink == 1,
             'deployments must be a regular file with one link')
        fcntl.flock(recorded, fcntl.LOCK_EX)
        text = recorded.read()
        if unit not in text.splitlines():
            line = (('' if not text or text.endswith('\n') else '\n') + unit + '\n').encode()
            need(os.write(recorded.fileno(), line) == len(line), 'cannot record deployment', 4)
    stop = ' '.join('"' + str(word) + '"' for word in (script, '_give-back', directory, seconds))
    result = command([workspace.tool('systemd-run'), '--user', '--collect', '--quiet', '--unit', unit,
                      '--service-type=exec', '--expand-environment=no', f'--working-directory={directory}', '--setenv=PATH',
                      '--property=KillMode=control-group',
                      f'--property=StandardOutput=append:{directory}/{args.name}.log',
                      f'--property=StandardError=append:{directory}/{args.name}.log',
                      '--property=ExecStop=-' + stop, f'--property=TimeoutStopSec={seconds + 60}',
                      '--', executable, *args.argv[1:]])
    need(result.returncode == 0, result.stderr.strip() or 'systemd-run failed', 4)
    print(unit)


def give_back(args):
    # Stop commands cannot fail their unit, even if their scratch has gone away.
    output = None
    started = time.monotonic()
    try:
        directory = Path(args[0])
        try:
            descriptor = os.open(directory / 'give-back.log', os.O_WRONLY | os.O_APPEND | os.O_CREAT
                                 | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
            info = os.fstat(descriptor)
            if stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
                output = os.fdopen(descriptor, 'a')
            else:
                os.close(descriptor)
        except OSError:
            pass
        if output is None:
            # Returning the login matters even when the pass's log is unsafe.
            output = open(os.devnull, 'w')
        need(len(args) == 2, 'expected DIRECTORY SECONDS')
        seconds = int(args[1])
        need(seconds > 0, 'SECONDS must be positive')
        deadline = started + seconds
        with os.fdopen(os.open(directory / 'give-back.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW
                               | os.O_NONBLOCK, 0o600), 'r+') as lock:
            need(stat.S_ISREG(os.fstat(lock.fileno()).st_mode), 'give-back.lock must be a regular file')
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        output.write(f'{timestamp()} lock busy past {seconds} s\n')
                        return 0
                    time.sleep(min(0.05, remaining))
            path = directory / 'give-back'
            try:
                regular = stat.S_ISREG(path.lstat().st_mode) and os.access(path, os.X_OK)
            except FileNotFoundError:
                regular = False
            status = 'absent'
            if regular:
                with subprocess.Popen([str(path)], cwd=directory, stdin=subprocess.DEVNULL,
                                      stdout=output, stderr=output, start_new_session=True) as child:
                    try:
                        code = child.wait(timeout=max(0, deadline - time.monotonic()))
                        status = f'exit {code}'
                    except subprocess.TimeoutExpired:
                        os.killpg(child.pid, signal.SIGKILL)
                        child.wait()
                        status = f'killed past {seconds} s'
                    finally:
                        # A successful exporter must not leave background work outside the lock.
                        try:
                            os.killpg(child.pid, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
            output.write(f'{timestamp()} {status}\n')
    except BaseException as error:
        try:
            if output:
                output.write(f'{timestamp()} error: {error}\n')
        except BaseException:
            pass
    finally:
        if output:
            try:
                output.close()
            except BaseException:
                pass
    return 0


class Watch:
    def __init__(self, workspace, director):
        self.workspace, self.director = workspace, director
        self.directory = workspace.tmp / 'qa'
        self.runs = workspace.root / 'tmp/codex-run'
        self.record = Record(workspace, log)
        self.repositories = Repositories(workspace)
        self.giving = True

    def call(self, tool, *args):
        seconds = dict(systemctl=30, logins=60, post=60, landings=120, **{'codex-run': 120})
        return command([self.workspace.tool(tool), *args], timeout=seconds[tool])

    def save(self, directory, state):
        replace(directory / 'pass.json', (json.dumps(state, indent=2) + '\n').encode())

    def local_passes(self):
        result = []
        for path in sorted(self.directory.glob('*/pass.json')):
            need(not path.is_symlink() and not path.parent.is_symlink(), f'{path}: symlink refused', 4)
            state = json.loads(path.read_text())
            need(state['pass'] == path.parent.name and re.fullmatch(NAME, state['pass'])
                 and state['repository'] in REPOSITORIES, f'{path}: invalid pass', 4)
            need(not state['run'] or re.fullmatch(r'[a-zA-Z0-9_-]+', state['run']), f'{path}: invalid run', 4)
            result.append((path.parent, state))
        return result

    def outstanding(self, state):
        return {name: path for name, path in state.get('logins', {}).items() if name not in state.get('given', [])}

    def give(self, directory, state, kind=None):
        if not self.giving:
            return
        for name in self.outstanding(state):
            if kind and state.get('kinds', {}).get(name, 'moved') != kind:
                continue
            result = self.call('logins', 'give', name, '--as', state.get('holder', 'qa-watch'))
            if result.returncode == 0:
                state.setdefault('given', []).append(name)
                self.save(directory, state)
                log(f'{state["pass"]}: gave {name} back')
            else:
                log(f'{state["pass"]}: cannot give {name} back: {result.stderr.strip()}')

    def give_strays(self, passes):
        # qa-flow.md 10: a take can survive a crash before pass.json is saved.
        held = {(state.get('holder', 'qa-watch'), name)
                for _, state in passes for name in self.outstanding(state)}
        listing = self.call('logins', 'list')
        self.giving = listing.returncode == 0
        if listing.returncode:
            log(f'cannot list stray logins: {listing.stderr.strip()}')
            return
        names = {}
        for line in listing.stdout.splitlines():
            match = re.fullmatch(r'(' + LOGIN + r'): held by (qa-watch(?:/\S+)?)'
                                 r'(?: \([^\n]*\))? since \S+, .+', line)
            if match and (match[2], match[1]) not in held:
                names[match[1]] = match[2]
        path = self.directory / 'strays.json'
        need(not path.is_symlink(), f'{path}: symlink refused', 4)
        strays = json.loads(path.read_text()) if path.exists() else {}
        need(isinstance(strays, dict), f'{path}: invalid strays', 4)
        for name, holder in sorted(names.items()):
            result = self.call('logins', 'give', name, '--as', holder)
            if result.returncode == 0:
                if result.stdout.strip() != f'already free: {name}':
                    log(f'gave back {name}: held without a pass')
                if name in strays:
                    strays.pop(name)
                    replace(path, (json.dumps(strays, indent=2) + '\n').encode())
            elif result.returncode == 1:
                log(f'{name} is out with no pass: {result.stderr.strip()}')
                if name not in strays:
                    message = self.directory / 'stray-post-body'
                    replace(message, (f'Login {name} is out with no QA pass holding it.\n'
                                      'Read logins list on this machine to recover it.\n').encode())
                    sent = self.call('post', 'send', '--as', 'qa-watch', self.director,
                                     f'qa: login {name} out with no pass', message)
                    if sent.returncode in (0, 3):
                        strays[name] = timestamp()
                        replace(path, (json.dumps(strays, indent=2) + '\n').encode())
                    else:
                        log(f'{name}: post failed: {sent.stderr.strip() or sent.stdout.strip()}')
            elif result.returncode != 2:
                log(f'{name}: cannot give stray login back: {result.stderr.strip()}')

    def unit_status(self, unit, directory=None):
        properties = ['--property=LoadState', '--property=ActiveState']
        if directory is not None:
            properties.append('--property=WorkingDirectory')
        result = self.call('systemctl', '--user', 'show', *properties, '--', unit)
        rows = [line.partition('=') for line in result.stdout.splitlines()]
        keys = {prop.removeprefix('--property=') for prop in properties}
        if (result.returncode == 0 and len(rows) == len(keys)
                and all(sep for _, sep, _ in rows) and {key for key, _, _ in rows} == keys):
            fields = {key: value for key, _, value in rows}
            load, active = fields['LoadState'], fields['ActiveState']
            if directory is not None and load == 'loaded' and fields['WorkingDirectory'] != str(directory):
                log(f'{unit}: WorkingDirectory is not the pass directory; keeping logins held')
                return 'unknown'
            if (load == 'loaded' and active in ('inactive', 'failed')
                    or load == 'not-found' and active == 'inactive'):
                return 'stopped'
            if load == 'loaded' and active in ('activating', 'active', 'reloading', 'deactivating'):
                return 'busy'
        log(f'{unit}: cannot establish unit state; keeping logins held')
        return 'unknown'

    def unit_stopped(self, unit, seconds, directory=None):
        # ended precedes the session's on-stop; deactivating still runs give-back.
        deadline = time.monotonic() + seconds
        while True:
            status = self.unit_status(unit, directory)
            if status == 'stopped':
                return True
            if status == 'unknown':
                return False
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                log(f'{unit}: waiting for unit to stop before giving logins back')
                return False
            time.sleep(min(2, remaining))

    def deployments(self, directory, state):
        if 'kinds' not in state:
            return {}  # A legacy pass never used the deployment protocol.
        result = self.call('systemctl', '--user', 'list-units', '--all', '--plain', '--no-legend',
                           '--full', 'qa-' + state['pass'] + '-*')
        if result.returncode:
            log(f'{state["pass"]}: deployment listing failed; units unknown')
            return None
        units = {}
        pattern = re.escape('qa-' + state['pass'] + '-') + r'[a-z][a-z0-9-]*'
        for line in result.stdout.splitlines():
            fields = line.split(maxsplit=4)
            if (len(fields) < 4 or not fields[0].startswith('qa-' + state['pass'] + '-')
                    or fields[1] != 'loaded'
                    or fields[2] not in ('active', 'inactive', 'activating', 'deactivating', 'failed', 'reloading')
                    or not re.fullmatch(r'[a-z][a-z0-9-]*', fields[3])):
                log(f'{state["pass"]}: malformed deployment listing; units unknown')
                return None
            # list-units prints canonical service names, unlike --unit's input.
            unit = fields[0].removesuffix('.service')
            if not re.fullmatch(pattern, unit):
                continue
            if unit in units:
                log(f'{state["pass"]}: duplicate deployment listing; units unknown')
                return None
            units[unit] = self.unit_status(unit, directory)
        return units

    def end(self, directory, state):
        if 'stopped' in state:
            state.pop('stopped')
            self.save(directory, state)
        self.give(directory, state, 'moved')
        units = self.deployments(directory, state)
        moved = [name for name in self.outstanding(state)
                 if state.get('kinds', {}).get(name, 'moved') == 'moved']
        if not moved and units is not None:
            for unit, status in units.items():
                if status != 'busy':
                    continue
                stopped = self.call('systemctl', '--user', 'stop', '--no-block', '--', unit)
                if stopped.returncode:
                    log(f'{state["pass"]}: stop {unit} failed')
                units[unit] = ('stopped' if self.unit_stopped(unit, self.options['QA_GIVE_BACK_SECONDS'], directory)
                               else 'unknown')
        remaining = [unit for unit, status in (units or {}).items() if status != 'stopped']
        complete = units is not None and not remaining
        if complete:
            self.give(directory, state, 'in-place')
        if (complete and not state.get('released') and (not state['run']
                or self.unit_status('codex-run-' + state['run']) == 'stopped')):
            state['released'] = True
            self.save(directory, state)
        pending = state.pop('notice_pending', None)
        if pending:
            missing = self.outstanding(state)
            if pending.pop('required') or missing or not complete:
                pending['body'] += ''.join(
                    f'Login {login} is not back at {path}: its deployment is in {directory}; '
                    'qa watch gives it back once it is.\n' for login, path in missing.items())
                pending['body'] += ''.join(f'Unit {unit} is still up or of unknown state.\n' for unit in remaining)
                if units is None:
                    pending['body'] += 'Deployment units are unknown.\n'
                pending['body'] += f'Scratch: {directory}. The service tries again at each check.\n'
                state['notice'] = pending
            self.save(directory, state)
        self.notify(directory, state)
        return complete

    def notify(self, directory, state):
        notice = state.get('notice')
        if not notice:
            return
        message = directory / 'post-body'
        replace(message, notice['body'].encode())
        sent = self.call('post', 'send', '--as', 'qa-watch', self.director, notice['subject'], message)
        if sent.returncode in (0, 3):
            state.pop('notice')
            self.save(directory, state)
            log(f'{state["pass"]}: posted director')
        else:
            log(f'{state["pass"]}: post failed: {sent.stderr.strip() or sent.stdout.strip()}')

    def facts(self, run):
        model = effort = ended = tokens = 'unknown'
        exit_code = 'unknown'
        if run:
            meta = self.runs / run / 'meta'
            if meta.exists():
                fields = dict(line.split('=', 1) for line in meta.read_text().splitlines() if '=' in line)
                model, effort = fields.get('model', model), fields.get('effort', effort)
            rows = self.runs / 'runs.tsv'
            if rows.exists():
                for line in rows.read_text().splitlines():
                    row = line.split('\t')
                    if len(row) >= 13 and row[0] == run:
                        ended, exit_code, model, effort, tokens = row[3], row[4], row[6], row[7], row[11]
        return dict(ended=ended, exit=exit_code, model=model, effort=effort, tokens=tokens)

    def finish(self, directory, state, failure=None):
        name = state['pass']
        report = ''
        try:
            with os.fdopen(os.open(directory / 'report.md', os.O_RDONLY | os.O_NOFOLLOW
                                   | os.O_NONBLOCK)) as source:
                info = os.fstat(source.fileno())
                if stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
                    report = source.read()
        except (OSError, UnicodeError):
            pass
        facts = self.facts(state['run'])
        outcome = ('capped' if state['capped'] else 'failed' if failure or facts['exit'] != '0'
                   or not report.strip() or report.startswith('codex-run: the run wrote no report') else 'done')
        if failure:
            report = failure + '\n' + report
        path = self.record.path(f'qa/passes/{name}.md')
        result = Pass.read(path)
        ended = facts['ended'] if facts['ended'] != 'unknown' else timestamp()
        minutes = max(0, int((utc(ended) - utc(state['started'])).total_seconds()) // 60)
        wall = f'{minutes // 60}:{minutes % 60:02}'
        result.fields.update(ended=ended, wall=wall, tokens=facts['tokens'], model=facts['model'],
                             effort=facts['effort'], outcome=outcome)
        result.body = f'# QA pass {name}\n\n' + report
        if len(result.text().encode()) > 8192:
            suffix = f'\n(Cut at 8 KiB: the report was {len(report.encode())} bytes.)\n'
            result.body = f'# QA pass {name}\n\n'
            budget = 8192 - len((result.text() + suffix).encode())
            prefix = report.encode()[:max(0, budget)]
            # A long first line contributes nothing; no partial UTF-8 or partial line.
            prefix = prefix[:prefix.rfind(b'\n') + 1]
            result.body += prefix.decode() + suffix
        try:
            self.record.commit({f'qa/passes/{name}.md': result.text()}, f'qa watch: {name} {outcome}')
        except Problem as error:
            if error.code != 2:
                raise
            outcome = 'failed'
            result.fields['outcome'] = outcome
            result.body = f'# QA pass {name}\n\nThe report was refused by record: {error}.\n'
            self.record.commit({f'qa/passes/{name}.md': result.text()}, f'qa watch: {name} failed')
            log(f'{name}: report refused by record: {error}')
        count = len(result.findings())
        state.update(finished=True, ended=ended)
        state['notice_pending'] = dict(required=outcome in ('failed', 'capped') or bool(count),
            subject=f'qa: pass {name} {outcome}, {count} findings', body=(
                f'QA pass {name} on {state["repository"]} ended {outcome} after {wall}, with {count} findings: '
                f"records' qa/passes/{name}.md; qa findings lists them.\n"))
        self.save(directory, state)
        log(f'{name}: {outcome}, {count} findings, {wall}')
        return self.end(directory, state)

    def reserve(self, repo, slot, opening):
        started = timestamp()
        base = utc(started).strftime('%Y%m%d-%H%M-') + repo
        name, index = base, 1
        while (self.directory / name).exists() or self.record.path(f'qa/passes/{name}.md').exists():
            index += 1
            name = base + '-' + str(index)
        directory = self.directory / name
        directory.mkdir(mode=0o700)
        state = {'pass': name, 'repository': repo, 'commits': [],
                 'started': started, 'run': '', 'capped': False, 'finished': False,
                 'holder': 'qa-watch/' + name, 'slot': slot, 'stage': 'reserving',
                 'rung': opening['rung'] if opening else '-',
                 'requests': sorted(opening['logins']) if opening else [],
                 'pools': {}, 'logins': {}, 'given': [], 'kinds': {}}
        self.save(directory, state)
        return directory, state

    def take(self, directory, state, opening):
        for pool in state['requests']:
            if pool in state['pools']:
                continue
            taken = self.call('logins', 'take', pool, '--any', '--as', state['holder'],
                              '--note', state['repository'])
            if taken.returncode:
                log(f'{state["repository"]}: waiting for login {pool}: {taken.stderr.strip()}')
                return False
            name, sep, path = taken.stdout.strip().partition(' ')
            need(sep and re.fullmatch(LOGIN, name) and Path(path).is_absolute(),
                 f'{state["pass"]}: invalid login grant', 4)
            state['pools'][pool] = name
            state['logins'][name] = path
            try:
                mode = os.lstat(path).st_mode
            except FileNotFoundError:
                mode = 0
            state['kinds'][name] = 'in-place' if stat.S_ISDIR(mode) else 'moved'
            self.save(directory, state)
        return True

    def launch(self, directory, state, checkout, options):
        name, repo, main = state['pass'], state['repository'], state['main']
        started, rung, logins = state['started'], state['rung'], state['logins']
        cap, seconds = options['QA_CAP_MINUTES'], options['QA_STOP_SECONDS']
        commits = state['details']
        pools = {name: pool for pool, name in state['pools'].items()}
        if rung == '-':
            rung_brief = "- Your rung: the binding's first; no held login."
        else:
            rung_brief = (f"- Your rung: {rung}, as the product's binding names it: set your\n"
                          '  deployment up on it.')
            if not logins:
                rung_brief += '\nNo held login.'
            else:
                rung_brief += ('\n- Held logins, taken for you by the service, each at rest at its path:\n'
                               + '\n'.join(f'    - {name} (pool {pools[name]}): {path}' for name, path in logins.items())
                               + f"\n  Move each into your deployment as the binding says. At once after,\n"
                               f'  write {directory}/give-back: an executable that moves each back to\n'
                               "  its path by the product's export, every program in it named by its\n"
                               '  absolute path (it runs outside your shell). Run it yourself before\n'
                               '  your deployment stops, and check each path by stat alone (a regular\n'
                               '  file, 0600, not empty). Your unit runs it too when it stops, whatever\n'
                               '  stops it. Never run `logins`, never read or copy a login.')
        brief = BRIEF.format(name=name, agents=Path(__file__).resolve().parents[2], repo=repo, main=main,
                             checkout=checkout, directory=directory, cap=cap, started=started, rung_brief=rung_brief,
                             commits='\n'.join(f'  - {c["commit"]} {c["subject"]}\n    QA: {c["qa"]}' for c in commits))
        replace(directory / 'brief.md', brief.encode())
        script = stop_path(Path(__file__).resolve())
        stop_path(directory)
        on_stop = '#!/bin/sh\nexec ' + ' '.join(shlex.quote(str(word)) for word in
                      (script, '_give-back', directory, seconds)) + '\n'
        replace(directory / 'on-stop', on_stop.encode(), 0o700)
        fields = dict(repository=repo, main=main, commits=' '.join(state['commits']), rung=rung, machine=self.workspace.machine(),
                      model='unknown', effort='unknown', started=started, ended='unknown', wall='unknown',
                      tokens='unknown', outcome='running', logins=','.join(sorted(logins)) or '-')
        report = Pass(name, fields, f'# QA pass {name}\n')
        try:
            self.record.commit({f'qa/passes/{name}.md': report.text()}, f'qa watch: {name} started')
        except Problem as error:
            log(f'{name}: record refused start: {error}')
            self.give(directory, state)
            state.update(finished=True, ended=timestamp())
            self.save(directory, state)
            self.end(directory, state)
            message = directory / 'post-body'
            replace(message, f'QA pass {name} could not start: {error}.\n'.encode())
            sent = self.call('post', 'send', '--as', 'qa-watch', self.director, f'qa: pass {name} refused', message)
            if sent.returncode not in (0, 3):
                log(f'{name}: post failed: {sent.stderr.strip()}')
            if not logins:
                shutil.rmtree(directory)
            return False
        launch = self.call('codex-run', 'task', '--to', 'qa-watch', '--on-stop', directory / 'on-stop',
                           directory / 'brief.md', checkout, directory / 'report.md')
        if launch.returncode == 124:
            log(f'{name}: launch timed out; keeping custody for run recovery')
            return False
        words = launch.stdout.split()
        if launch.returncode or not words or not re.fullmatch(r'[a-zA-Z0-9_-]+', words[0]):
            # No unit launched: a record failure must not keep resting logins held.
            self.give(directory, state)
            self.finish(directory, state, 'codex-run refused: ' + (launch.stderr.strip() or launch.stdout.strip() or 'no run id'))
            return False
        else:
            state['run'] = words[0]
            state.pop('stage', None)
            self.save(directory, state)
            log(f'{name}: started run {state["run"]} at {main}')
        return True

    def cancel(self, directory, state):
        state.update(cancelled=True, finished=True, ended=timestamp())
        state.pop('stage', None)
        self.save(directory, state)
        self.end(directory, state)
        if state.get('released') and not self.outstanding(state):
            shutil.rmtree(directory)

    def recover_run(self, directory, state):
        # codex-run writes meta before launching its unit. Recover an acknowledged
        # launch even if this service died before saving the returned id.
        matches = []
        for path in self.runs.glob('*/meta'):
            fields = dict(line.split('=', 1) for line in path.read_text().splitlines() if '=' in line)
            if fields.get('task') == str(directory / 'brief.md') and fields.get('report') == str(directory / 'report.md'):
                need(re.fullmatch(r'[a-zA-Z0-9_-]+', path.parent.name), 'invalid recovered run', 4)
                matches.append(path.parent.name)
        need(len(matches) <= 1, f'{state["pass"]}: multiple runs for one brief', 4)
        if matches:
            state['run'] = matches[0]
            state.pop('stage', None)
            self.save(directory, state)
            log(f'{state["pass"]}: recovered run {state["run"]}')

    def check(self, options):
        log('checking')
        self.options = options
        complete = {}
        with self.record.locked():
            passes = self.local_passes()
            self.give_strays(passes)
            for directory, state in passes:
                try:
                    if state['finished']:
                        complete[state['pass']] = self.end(directory, state)
                        if state.get('cancelled') and state.get('released') and not self.outstanding(state):
                            shutil.rmtree(directory)
                        continue
                    if state.get('stage') == 'reserving':
                        continue
                    if not state['run']:
                        if not self.record.path(f'qa/passes/{state["pass"]}.md').exists():
                            self.give(directory, state)
                            if self.outstanding(state):
                                continue
                            shutil.rmtree(directory)
                            log(f'{state["pass"]}: removed uncommitted start')
                            continue
                        self.recover_run(directory, state)
                    run = state['run']
                    ended = self.runs / run / 'ended' if run else None
                    if ended and ended.exists():
                        if self.outstanding(state) and not self.unit_stopped('codex-run-' + state['run'], options['QA_GIVE_BACK_SECONDS']):
                            continue
                        complete[state['pass']] = self.finish(directory, state)
                    elif not run:
                        complete[state['pass']] = self.finish(directory, state, 'The service stopped before saving a run id.')
                    else:
                        status = self.unit_status('codex-run-' + state['run'])
                        if status == 'unknown':
                            continue
                        if status == 'stopped':
                            complete[state['pass']] = self.finish(directory, state, None if ended.exists() else 'The run unit vanished without its end.')
                            continue
                        if not (state['capped'] or (utc(timestamp()) - utc(state['started'])).total_seconds() >= options['QA_CAP_MINUTES'] * 60):
                            continue
                        state['capped'] = True
                        self.save(directory, state)
                        stopped = self.call('systemctl', '--user', 'stop', 'codex-run-' + run)
                        if stopped.returncode:
                            state['capped'] = False
                            self.save(directory, state)
                            log(f'{state["pass"]}: stop failed: {stopped.stderr.strip()}')
                        else:
                            log(f'{state["pass"]}: capped run {run}')
                except (Problem, OSError, ValueError, UnicodeError) as error:
                    log(f'{state["pass"]}: cleanup failed ({type(error).__name__}); keeping logins and scratch')
            local = self.local_passes()
            def holds_slot(state):
                return not state.get('released', False)
            # Preflight every source before any launch: an unreadable feed starts none.
            taken = {(s['repository'], sha) for _, s in local if not s['finished']
                     for sha in s['commits']}
            waiting = [row for row in chosen(self.record, 'run') if row[:2] not in taken]
            pending = {}
            for directory, state in local:
                if state.get('stage') == 'reserving':
                    pending.setdefault(state['repository'], []).append((directory, state))
            for reservations in pending.values():
                reservations.sort(key=lambda item: (item[1]['started'],
                    int(item[1]['pass'].rsplit('-', 1)[-1]) if item[1]['pass'].rsplit('-', 1)[-1].isdigit() else 1))
            wanted = {r for r, _, _ in waiting}
            for repo, reservations in list(pending.items()):
                if repo not in wanted:
                    for directory, state in reservations:
                        try:
                            self.cancel(directory, state)
                        except (Problem, OSError, ValueError, UnicodeError) as error:
                            log(f'{repo}: cleanup failed ({type(error).__name__}); keeping logins and scratch')
                    pending.pop(repo)
            free = max(0, options['QA_SLOTS'] - sum(holds_slot(s) for _, s in self.local_passes()))
            repos = list(dict.fromkeys(r for r, _, _ in waiting)) if free or pending else []
            cleared = {}
            for repo in repos:
                result = self.call('landings', 'cleared', repo)
                if result.returncode == 1:
                    log(f'{repo}: no cleared main')
                    continue
                if result.returncode:
                    log(f'{repo}: cannot read cleared main: {result.stderr.strip() or result.stdout.strip()}')
                    cleared = {}
                    break
                main = result.stdout.strip()
                need(re.fullmatch(SHA, main), f'{repo}: invalid cleared main', 4)
                cleared[repo] = main
            for repo, main in cleared.items():
                free = max(0, options['QA_SLOTS'] - sum(holds_slot(s) for _, s in self.local_passes()))
                if not free and repo not in pending:
                    continue
                try:
                    with self.repositories.fetched(repo) as root:
                        order = git(root, 'rev-list', '--reverse', 'origin/main').splitlines()
                        selected = {sha for r, sha, _ in waiting if r == repo}
                        need(selected <= set(order), f'{repo}: waiting commit missing from origin/main', 4)
                        selected = [sha for sha in order if sha in selected]
                        def holds(sha):
                            result = git(root, 'merge-base', '--is-ancestor', sha, main, check=False)
                            need(result.returncode in (0, 1), f'{repo}: cannot read cleared commit {main}', 4)
                            return result.returncode == 0
                        if not holds(selected[0]):
                            log(f'{repo}: cleared main does not hold oldest waiting commit')
                            continue
                        commits = []
                        for sha in selected:
                            if holds(sha):
                                subject = git(root, 'show', '-s', '--format=%s', sha)
                                trailer = git(root, 'show', '-s', '--format=%(trailers:key=QA,valueonly)', sha)
                                commits.append(dict(commit=sha, subject=subject, qa=' '.join(trailer.splitlines())))
                        opening = rung(self.record, repo)
                        granted = []
                        incomplete = False
                        for directory, state in pending.pop(repo, []):
                            if not self.take(directory, state, opening):
                                if incomplete:
                                    self.cancel(directory, state)
                                incomplete = True
                                continue
                            if len(granted) == len(commits):
                                self.cancel(directory, state)
                                continue
                            checkout = self.repositories.checkout(root, repo, state['slot'], main)
                            granted.append((directory, state, checkout))
                        free = max(0, options['QA_SLOTS'] - sum(holds_slot(s) for _, s in self.local_passes()))
                        while not incomplete and free and len(granted) < len(commits):
                            slots = {s.get('slot', 1) for _, s in self.local_passes()
                                     if s['repository'] == repo and holds_slot(s)}
                            slot = next(n for n in range(1, len(slots) + 2) if n not in slots)
                            directory, state = self.reserve(repo, slot, opening)
                            free -= 1
                            if not self.take(directory, state, opening):
                                break
                            checkout = self.repositories.checkout(root, repo, state['slot'], main)
                            granted.append((directory, state, checkout))
                        if not granted:
                            continue
                        share = min(options['QA_BATCH'], (len(commits) + len(granted) - 1) // len(granted))
                        # Save every share before the first record or session can start.
                        offset = 0
                        for index, (directory, state, checkout) in enumerate(granted):
                            count = min(share, len(commits) - offset - (len(granted) - index - 1))
                            details = commits[offset:offset + count]
                            offset += count
                            state.update(main=main, commits=[c['commit'] for c in details], details=details,
                                         stage='starting', started=timestamp())
                            self.save(directory, state)
                        for directory, state, checkout in granted:
                            self.launch(directory, state, checkout, options)
                except (Problem, OSError, ValueError, UnicodeError) as error:
                    log(f'{repo}: preparation failed ({type(error).__name__}): {error}; keeping saved custody')
            for directory, state in self.local_passes():
                if (state['finished'] and not self.outstanding(state) and not state.get('notice')
                        and not state.get('notice_pending')
                        and complete.get(state['pass'], False) and state.get('released', False)
                        and (utc(timestamp()) - utc(state['ended'])).total_seconds() >= 7 * 86400):
                    shutil.rmtree(directory)
                    log(f'{state["pass"]}: pruned')


def watch(director, once, workspace):
    os.environ['POST_NAME'] = 'qa-watch'
    # Check assignment before mkdir, locks, record pull, or any other side effect.
    need(workspace.fixture or (Path.home() / '.config/agents-qa/director').is_file(),
         "this is not the service's machine (no ~/.config/agents-qa/director)")
    need(re.fullmatch(r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*@[a-z][a-z0-9-]*', director),
         'invalid director address: expected NAME@MACHINE')
    service = Watch(workspace, director)
    no_links(workspace.tmp, service.directory)
    service.directory.mkdir(parents=True, exist_ok=True)
    with (service.directory / 'watch.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Problem('another service runs') from None
        while True:
            options = settings(workspace)
            service.check(options)
            if once:
                return 0
            interval = options['QA_INTERVAL_SECONDS']
            waited = service.call('post', 'wait', 'qa-watch', '--timeout', str(interval), '--holder', str(os.getpid()), '--kind', 'codex')
            if waited.returncode == 0:
                read = service.call('post', 'read', 'qa-watch')
                log(read.stdout)
                if read.returncode:
                    log('post read failed: ' + read.stderr.strip())
            elif waited.returncode == 4:
                log('another waiter took qa-watch')
                return 2
            elif waited.returncode != 1:
                log('post wait failed: ' + (waited.stderr.strip() or waited.stdout.strip()))
                time.sleep(interval)


def main():
    if sys.argv[1:2] == ['_give-back']:
        return give_back(sys.argv[2:])
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('candidates', 'backlog'):
        sub.add_parser(name).add_argument('repo', nargs='?')
    decide_parser = sub.add_parser('decide')
    decide_parser.add_argument('repo')
    decide_parser.add_argument('choices', nargs='+')
    decide_parser.add_argument('--why', default='')
    sub.add_parser('passes').add_argument('--running', action='store_true')
    sub.add_parser('findings')
    rung_parser = sub.add_parser('rung')
    rung_parser.add_argument('repo')
    rung_parser.add_argument('rung', nargs='?')
    rung_parser.add_argument('--login', action='append', default=[])
    rung_parser.add_argument('--why', default='')
    triage_parser = sub.add_parser('triage')
    triage_parser.add_argument('pass_name')
    triage_parser.add_argument('number', type=int)
    triage_parser.add_argument('route', nargs='+')
    triage_parser.add_argument('--why', default='')
    deployment = sub.add_parser('deploy')
    deployment.add_argument('directory')
    deployment.add_argument('name')
    deployment.add_argument('argv', nargs=argparse.REMAINDER)
    service = sub.add_parser('watch')
    service.add_argument('--director', required=True)
    service.add_argument('--once', action='store_true')
    args = parser.parse_args()
    try:
        workspace = Workspace()
        if args.command == 'deploy':
            need('--' in sys.argv[2:] and sys.argv[2:].index('--') == 2, 'deploy needs DIRECTORY NAME -- COMMAND...')
            return deploy(args, workspace)
        if args.command == 'watch':
            return watch(args.director, args.once, workspace)
        why = getattr(args, 'why', '') or ''
        need(not any(c in why for c in '\n\r\t'), '--why must not contain a newline or tab')
        repo = getattr(args, 'repo', None)
        if repo:
            workspace.origin(repo)
        workspace.tmp.mkdir(parents=True, exist_ok=True)
        record = Record(workspace)
        with record.locked():
            repositories = Repositories(workspace)
            if args.command == 'candidates':
                candidates(repo, record, repositories)
            elif args.command == 'decide':
                decide(args, record, repositories)
            elif args.command == 'backlog':
                backlog(repo, record, repositories)
            elif args.command == 'passes':
                passes(args.running, record, repositories)
            elif args.command == 'rung':
                open_rung(args, record)
            elif args.command == 'findings':
                findings(record)
            elif args.command == 'triage':
                triage(args, workspace, record)
        return 0
    except Problem as error:
        print(f'qa: {error}', file=sys.stderr)
        return error.code
    except (OSError, ValueError, UnicodeError) as error:
        print(f'qa: {error}', file=sys.stderr)
        return 4


if __name__ == '__main__':
    sys.exit(main())
