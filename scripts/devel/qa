os.umask(0o077)
REPOSITORIES = ('skein', 'smith', 'hearth', 'jig', 'temper')
NAME = r'[a-z0-9][a-z0-9_-]*'
SHA = r'[0-9a-f]{40}'
PASS_KEYS = 'repository main commits machine model effort started ended wall tokens outcome'.split()


class Problem(Exception):
    def __init__(self, why, code=2):
        super().__init__(why)
        self.code = code


def need(ok, why, code=2):
    if not ok:
        raise Problem(why, code)


def command(argv, cwd=None):
    return subprocess.run([str(a) for a in argv], cwd=cwd, stdin=subprocess.DEVNULL,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                          env=dict(os.environ, GIT_TERMINAL_PROMPT='0'))


def git(root, *args, check=True):
    result = command(['git', '-C', root, *args])
    if check:
        need(result.returncode == 0, result.stderr.strip() or 'git failed', 4)
    return result.stdout.strip() if check else result


def timestamp():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def utc(value):
    if value == 'unknown':
        return datetime.min.replace(tzinfo=timezone.utc)
    need(re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d(?::\d\d)?Z', value),
         f'invalid UTC time: {value}', 4)
    return datetime.fromisoformat(value.replace('Z', '+00:00'))


class Workspace:
    def __init__(self):
        self.kit = Path(__file__).resolve().parent
        agents = self.kit.parent.parent
        self.root = Path(os.environ.get('DEV_ROOT', agents.parent if agents.name == 'agents'
                                        else Path.home() / 'src/rust')).expanduser().absolute()
        self.tmp = Path(os.environ.get('DEV_TMP', self.root / 'tmp')).expanduser().absolute()
        record_workspace = Path.home() / ('src/rust' if (Path.home() / 'src/rust').exists() else 'src')
        self.records = Path(os.environ.get('RECORDS', record_workspace / 'records')).expanduser().absolute()
        fixture = os.environ.get('QA_FIXTURE')
        self.fixture = Path(fixture).absolute() if fixture else None
        need(fixture is None or (fixture and self.fixture.is_dir()), 'QA_FIXTURE must be a directory')

    def machine(self):
        try:
            lines = (self.root / 'tmp/post/machines').read_text().splitlines()
        except OSError:
            lines = []
        for line in lines:
            fields = line.partition('#')[0].split()
            if len(fields) >= 2 and fields[1] == 'local':
                return fields[0]
        return socket.gethostname()

    def tool(self, name):
        default = Path('systemctl') if name == 'systemctl' else self.kit / name
        return Path(os.environ.get('QA_' + name.upper().replace('-', '_'), default)) if self.fixture else default

    def origin(self, repo):
        need(repo in REPOSITORIES, f'unknown repository: {repo}')
        return str(self.fixture / 'origins' / (repo + '.git')) if self.fixture else f'git@github.com:fabrig-ai/{repo}.git'


class Repositories:
    def __init__(self, workspace):
        self.workspace = workspace

    @contextmanager
    def fetched(self, repo):
        origin = self.workspace.origin(repo)
        parent = self.workspace.tmp / 'qa/repos'
        parent.mkdir(parents=True, exist_ok=True)
        root = parent / repo
        with (parent / (repo + '.lock')).open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            need(not root.is_symlink(), f'{root}: symlink refused', 4)
            if not root.exists():
                # A failed clone leaves no half-built repository at the shared path.
                with tempfile.TemporaryDirectory(prefix=repo + '-', dir=parent) as directory:
                    clone = Path(directory) / 'repo'
                    result = command(['git', 'clone', '--filter=blob:none', '--no-checkout', origin, clone])
                    need(result.returncode == 0, f'cannot clone {repo}: {result.stderr.strip()}', 4)
                    clone.rename(root)
            need(git(root, 'config', '--get', 'remote.origin.url') == origin,
                 f'{root}: unexpected origin', 4)
            result = git(root, 'fetch', '--quiet', 'origin', '+refs/heads/*:refs/remotes/origin/*', check=False)
            need(result.returncode == 0, f'cannot fetch {repo}: {result.stderr.strip()}', 4)
            yield root

    def commits(self, repo):
        with self.fetched(repo) as root:
            # NULs frame each commit; unit separators preserve multi-line trailer values.
            text = git(root, 'log', '--reverse', '--format=%H%x1f%cs%x1f%ct%x1f%s%x1f%(trailers:key=QA,valueonly)%x00', 'origin/main')
        result = []
        for row in text.split('\0'):
            if row.strip():
                sha, date, seconds, subject, trailer = row.lstrip('\n').split('\x1f', 4)
                result.append(dict(repository=repo, commit=sha, short=sha[:9], date=date,
                                   subject=subject, seconds=int(seconds), qa=' '.join(trailer.splitlines()).strip()))
        return result

    def resolve(self, repo, prefixes):
        with self.fetched(repo) as root:
            commits = []
            for prefix in prefixes:
                need(re.fullmatch(r'[0-9a-fA-F]{7,40}', prefix), f'commit needs 7 to 40 hex digits: {prefix}')
                matches = git(root, 'rev-parse', '--disambiguate=' + prefix.lower()).splitlines()
                matches = [sha for sha in matches if git(root, 'cat-file', '-t', sha) == 'commit']
                need(matches, f'commit not found: {prefix}')
                need(len(matches) == 1, f'ambiguous commit: {prefix}')
                sha = matches[0]
                need(git(root, 'merge-base', '--is-ancestor', sha, 'origin/main', check=False).returncode == 0,
                     f'commit not on origin/main: {prefix}')
                trailer = git(root, 'show', '-s', '--format=%(trailers:key=QA,valueonly)', sha)
                need(trailer, f'commit has no QA: trailer: {prefix}')
                if sha not in commits:
                    commits.append(sha)
            return commits


class Pass:
    def __init__(self, name, fields, body):
        self.name, self.fields, self.body = name, fields, body

    @classmethod
    def read(cls, path):
        text = path.read_text()
        front = re.match(r'\A---\n(.*?)\n---(?:\n|$)', text, re.S)
        need(front, f'{path}: front matter missing', 4)
        fields = {}
        for line in front[1].splitlines():
            key, sep, value = line.partition(':')
            need(sep and key not in fields and value.strip(), f'{path}: invalid front matter', 4)
            fields[key] = value.strip()
        need(all(key in fields for key in PASS_KEYS), f'{path}: incomplete front matter', 4)
        need(fields['repository'] in REPOSITORIES and fields['outcome'] in ('running', 'done', 'capped', 'failed'),
             f'{path}: invalid repository or outcome', 4)
        need(all(re.fullmatch(SHA, sha) for sha in fields['commits'].split()), f'{path}: invalid commits', 4)
        utc(fields['started'])
        utc(fields['ended'])
        return cls(path.stem, fields, text[front.end():])

    def text(self):
        return '---\n' + ''.join(f'{key}: {value}\n' for key, value in self.fields.items()) + '---\n' + self.body

    def findings(self):
        section = re.search(r'^## Findings[ \t]*\n(.*?)(?=^##[ \t]+|\Z)', self.body, re.M | re.S)
        return sorted((int(n), title) for n, title in re.findall(r'^### ([1-9][0-9]*)\. (.+)$', section[1], re.M)) if section else []


class Record:
    def __init__(self, workspace, logger=None):
        self.workspace, self.root = workspace, workspace.records
        self.logger = logger

    def warn(self, message):
        if self.logger:
            self.logger("warning: " + message)
        else:
            print("qa: warning: " + message, file=sys.stderr)

    @contextmanager
    def locked(self):
        common = Path(git(self.root, 'rev-parse', '--path-format=absolute', '--git-common-dir'))
        # Separate from record.lock: record's subprocess must acquire that itself.
        with (common / 'qa.lock').open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            result = command([self.workspace.tool('record'), 'pull'])
            if result.returncode:
                self.warn('record pull failed: ' + result.stderr.strip())
            yield self

    def path(self, name):
        path = self.root / name
        for part in (path, *path.parents):
            if part == self.root:
                break
            need(not part.is_symlink(), f'{name}: symlink refused')
        return path

    def events(self, kind):
        path = self.path('qa/' + kind + '.md')
        if not path.exists():
            return []
        rows = []
        pattern = (rf'- (\S+) (\S+) ({SHA}) (run|backlog)(?: (.*))?' if kind == 'decisions'
                   else r'- (\S+) (\S+) ([1-9][0-9]*) (\S+)(?: (.*))?')
        for line in path.read_text().splitlines():
            if not line.strip() or line.startswith('#'):
                continue
            match = re.fullmatch(pattern, line)
            need(match, f'{path}: invalid event line', 4)
            stamp, who, item, route, why = match.groups()
            rows.append(dict(time=utc(stamp), who=who, item=item, route=route, why=why or ''))
        return rows

    def passes(self):
        directory = self.path('qa/passes')
        result = []
        for path in sorted(directory.glob('*.md')):
            need(re.fullmatch(NAME, path.stem), f'{path}: invalid pass name', 4)
            result.append(Pass.read(self.path('qa/passes/' + path.name)))
        return sorted(result, key=lambda p: (utc(p.fields['started']), p.name))

    def append(self, name, line, heading=None):
        path = self.path(name)
        text = path.read_text() if path.exists() else (heading + '\n\n' if heading else '')
        return text + ('' if not text or text.endswith('\n') else '\n') + line + '\n'

    def commit(self, changes, message):
        before = {}
        try:
            for name, text in changes.items():
                path = self.path(name)
                before[name] = (path.read_bytes(), path.stat().st_mode) if path.exists() else None
                replace(path, text.encode(), before[name][1] if before[name] else 0o600)
            result = command([self.workspace.tool('record'), 'commit', '-m', message, *changes])
            need(result.returncode in (0, 3), result.stderr.strip() or 'record commit failed',
                 2 if result.returncode == 2 else 1)
            if result.returncode == 3:
                self.warn(result.stderr.strip())
        except BaseException:
            for name, old in before.items():
                path = self.path(name)
                if old is None:
                    path.unlink(missing_ok=True)
                else:
                    replace(path, *old)
            raise


def replace(path, data, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as target:
        temporary = Path(target.name)
        try:
            target.write(data)
            target.flush()
            os.chmod(temporary, mode)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def states(decisions, passes):
    """Latest event wins; at equal times a pass takes precedence."""
    result, keys = {}, {}
    for index, event in enumerate(decisions):
        identity = event['who'], event['item']
        key = event['time'], 0, index
        if identity not in keys or key > keys[identity]:
            keys[identity], result[identity] = key, event
    for index, report in enumerate(passes):
        key = utc(report.fields['started']), 1, index
        for sha in report.fields['commits'].split():
            identity = report.fields['repository'], sha
            if identity not in keys or key > keys[identity]:
                keys[identity] = key
                result[identity] = dict(time=key[0], route='taken', pass_name=report.name)
    return result


def first_line(commit):
    return '{repository} {short} {date} {subject}'.format(**commit)


def show_commits(repositories, selected):
    cache = {repo: {c['commit']: c for c in repositories.commits(repo)} for repo in dict.fromkeys(r for r, _, _ in selected)}
    for repo, sha, event in selected:
        need(sha in cache[repo], f'{repo} {sha}: recorded commit is not on origin/main', 4)
        yield cache[repo][sha], event


def decide(args, record, repositories):
    repo, why = args.repo, args.why
    need(len(args.choices) >= 2 and args.choices[-1] in ('run', 'backlog'), 'decide needs COMMIT... run|backlog')
    shas = repositories.resolve(repo, args.choices[:-1])
    route = args.choices[-1]
    name = 'qa/decisions.md'
    text = record.append(name, '\n'.join(f'- {timestamp()} {repo} {sha} {route} {why}' for sha in shas), '# QA decisions')
    record.commit({name: text}, f'qa decide: {repo} ' + ' '.join(s[:9] for s in shas) + ' ' + route)
    for sha in shas:
        print(f'decided: {repo} {sha[:9]} {route}')
    return


def findings(record):
    triaged = {(r['who'], int(r['item'])) for r in record.events('triage')}
    lines = [f'{p.name} {n} {title}' for p in record.passes() if p.fields['outcome'] != 'running'
             for n, title in p.findings() if (p.name, n) not in triaged]
    print('\n'.join(lines) or 'no findings waiting')


def triage(args, workspace, record):
    why, passes = args.why, record.passes()
    report = next((p for p in passes if p.name == args.pass_name), None)
    need(report, f'unknown pass: {args.pass_name}')
    need(report.fields['outcome'] != 'running', f'pass is running: {report.name}')
    title = dict(report.findings()).get(args.number)
    need(title is not None, f'pass has no finding {args.number}')
    need(args.route in (['backlog'], ['drop']) or (len(args.route) == 2 and args.route[0] == 'owner'), 'route must be owner ADDRESS, backlog or drop')
    route = args.route[-1]
    if args.route[0] == 'owner':
        need(re.fullmatch(r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*@[a-z][a-z0-9-]*', route), 'invalid owner address: expected NAME@MACHINE')
        body = (f'QA pass {report.name} on {report.fields["repository"]} found this, and the director routes it to you.\n'
                f"The report is records' qa/passes/{report.name}.md, finding {args.number}: record pull, then read it.\n")
        with tempfile.NamedTemporaryFile(mode='w', dir=workspace.tmp) as message:
            message.write(body + (why + '\n' if why else ''))
            message.flush()
            sent = command([workspace.tool('post'), 'send', route, f'QA finding {report.name} {args.number}: {title}', message.name])
        need(sent.returncode in (0, 3), 'post send failed: ' + sent.stderr.strip())
        if sent.returncode == 3:
            print('qa: warning: message queued; nobody will wake its reader', file=sys.stderr)
    name = 'qa/triage.md'
    changes = {name: record.append(name, f'- {timestamp()} {report.name} {args.number} {route} {why}', '# QA triage')}
    if route == 'backlog':
        name = 'director/backlog.md'
        changes[name] = record.append(name, f"- QA pass {report.name}, finding {args.number}: {title}. Source/repro: records' qa/passes/{report.name}.md, finding {args.number}.")
    record.commit(changes, f'qa triage: {report.name} {args.number} {route}')
    print(f'triaged: {report.name} {args.number} {route}')
    return


def chosen(record, route, repo=None):
    current = states(record.events('decisions'), record.passes())
    return sorted([(r, sha, event) for (r, sha), event in current.items()
                   if event['route'] == route and (not repo or repo == r)], key=lambda row: row[2]['time'])


def candidates(repo, record, repositories):
    current = states(record.events('decisions'), record.passes())
    commits = [c for r in ([repo] if repo else REPOSITORIES) for c in repositories.commits(r)
               if c['qa'] and (r, c['commit']) not in current]
    commits.sort(key=lambda c: c['seconds'])
    print('\n'.join(first_line(c) + '\n  QA: ' + c['qa'] for c in commits) or 'no candidates')


def backlog(repo, record, repositories):
    selected = chosen(record, 'backlog', repo)
    if not selected:
        print('no commits kept for later')
    for commit, event in show_commits(repositories, selected):
        print(first_line(commit))
        if event['why']:
            print('  why: ' + event['why'])


def passes(running, record, repositories):
    lines = [f'{p.name} {p.fields["repository"]} {p.fields["outcome"]} {p.fields["wall"]} {p.fields["tokens"]} '
             + ' '.join(s[:9] for s in p.fields['commits'].split()) for p in record.passes()
             if not running or p.fields['outcome'] == 'running']
    print('\n'.join(lines) or 'no passes')
    selected = chosen(record, 'run')
    print(f'waiting: {len(selected)} commits chosen to run')
    for commit, _ in show_commits(repositories, selected):
        print(first_line(commit))


BRIEF = '''# QA pass {name}

Read {agents}/roles/qa.md first: it is your role.

- Repository: {repo}, at main {main}, checked out in {checkout}, your
  working directory. Leave its tracked files as they are.
- The commits to test, oldest first:
{commits}
- Your scratch directory: {directory}.
- Your wall time is capped at {cap} minutes, from {started}: past it
  your session is stopped, and your report is what the file holds
  then. Write it early and keep it current.
- Your report: {directory}/report.md, at most 7 KiB.
'''


def log(message):
    for line in str(message).splitlines():
        print('qa watch: ' + line, flush=True)


def settings(workspace):
    # Same precedence and valid machine.env lines as kit.sh's machine_setting.
    values = dict(QA_SLOTS='1', QA_BATCH='5', QA_CAP_MINUTES='120', QA_INTERVAL_SECONDS='300')
    path = workspace.tmp / 'machine.env'
    try:
        text = path.read_text(errors='replace')
    except OSError:
        text = ''  # kit.sh ignores an absent or unreadable machine file.
    for line in text.split('\n'):
        match = re.fullmatch(r'(QA_SLOTS|QA_BATCH|QA_CAP_MINUTES|QA_INTERVAL_SECONDS)=([0-9]+)', line)
        if match:
            values[match[1]] = match[2]
    for key in values:
        value = os.environ.get(key, values[key])
        need(re.fullmatch(r'[0-9]+', value), f'{key} must be a nonnegative integer')
        values[key] = int(value)
    need(values['QA_BATCH'] > 0, 'QA_BATCH must be positive')
    return values


class Watch:
    def __init__(self, workspace, director):
        self.workspace, self.director = workspace, director
        self.directory = workspace.tmp / 'qa'
        self.runs = workspace.root / 'tmp/codex-run'
        self.record = Record(workspace, log)
        self.repositories = Repositories(workspace)

    def call(self, tool, *args):
        return command([self.workspace.tool(tool), *args])

    def save(self, directory, state):
        replace(directory / 'pass.json', (json.dumps(state, indent=2) + '\n').encode())

    def local_passes(self):
        result = []
        for path in sorted(self.directory.glob('*/pass.json')):
            need(not path.is_symlink() and not path.parent.is_symlink(), f'{path}: symlink refused', 4)
            state = json.loads(path.read_text())
            need(state['pass'] == path.parent.name and re.fullmatch(NAME, state['pass'])
                 and state['repository'] in REPOSITORIES, f'{path}: invalid pass', 4)
            need(not state['run'] or re.fullmatch(r'[a-zA-Z0-9_-]+', state['run']), f'{path}: invalid run', 4)
            result.append((path.parent, state))
        return result

    def notify(self, directory, state):
        notice = state.get('notice')
        if not notice:
            return
        message = directory / 'post-body'
        replace(message, notice['body'].encode())
        sent = self.call('post', 'send', '--as', 'qa-watch', self.director, notice['subject'], message)
        if sent.returncode in (0, 3):
            state.pop('notice')
            self.save(directory, state)
            log(f'{state["pass"]}: posted director')
        else:
            log(f'{state["pass"]}: post failed: {sent.stderr.strip() or sent.stdout.strip()}')

    def facts(self, run):
        model = effort = ended = tokens = 'unknown'
        exit_code = 'unknown'
        if run:
            meta = self.runs / run / 'meta'
            if meta.exists():
                fields = dict(line.split('=', 1) for line in meta.read_text().splitlines() if '=' in line)
                model, effort = fields.get('model', model), fields.get('effort', effort)
            rows = self.runs / 'runs.tsv'
            if rows.exists():
                for line in rows.read_text().splitlines():
                    row = line.split('\t')
                    if len(row) >= 13 and row[0] == run:
                        ended, exit_code, model, effort, tokens = row[3], row[4], row[6], row[7], row[11]
        return dict(ended=ended, exit=exit_code, model=model, effort=effort, tokens=tokens)

    def finish(self, directory, state, failure=None):
        name = state['pass']
        report_path = directory / 'report.md'
        report = report_path.read_text(errors='replace') if report_path.exists() else ''
        facts = self.facts(state['run'])
        outcome = ('capped' if state['capped'] else 'failed' if failure or facts['exit'] != '0'
                   or not report.strip() or report.startswith('codex-run: the run wrote no report') else 'done')
        if failure:
            report = failure + '\n' + report
        path = self.record.path(f'qa/passes/{name}.md')
        result = Pass.read(path)
        ended = facts['ended'] if facts['ended'] != 'unknown' else timestamp()
        minutes = max(0, int((utc(ended) - utc(state['started'])).total_seconds()) // 60)
        wall = f'{minutes // 60}:{minutes % 60:02}'
        result.fields.update(ended=ended, wall=wall, tokens=facts['tokens'], model=facts['model'],
                             effort=facts['effort'], outcome=outcome)
        result.body = f'# QA pass {name}\n\n' + report
        if len(result.text().encode()) > 8192:
            suffix = f'\n(Cut at 8 KiB: the report was {len(report.encode())} bytes.)\n'
            result.body = f'# QA pass {name}\n\n'
            budget = 8192 - len((result.text() + suffix).encode())
            prefix = report.encode()[:max(0, budget)]
            # A long first line contributes nothing; no partial UTF-8 or partial line.
            prefix = prefix[:prefix.rfind(b'\n') + 1]
            result.body += prefix.decode() + suffix
        try:
            self.record.commit({f'qa/passes/{name}.md': result.text()}, f'qa watch: {name} {outcome}')
        except Problem as error:
            if error.code != 2:
                raise
            outcome = 'failed'
            result.fields['outcome'] = outcome
            result.body = f'# QA pass {name}\n\nThe report was refused by record: {error}.\n'
            self.record.commit({f'qa/passes/{name}.md': result.text()}, f'qa watch: {name} failed')
            log(f'{name}: report refused by record: {error}')
        count = len(result.findings())
        state.update(finished=True, ended=ended)
        if outcome in ('failed', 'capped') or count:
            state['notice'] = dict(subject=f'qa: pass {name} {outcome}, {count} findings', body=(
                f'QA pass {name} on {state["repository"]} ended {outcome} after {wall}, with {count} findings: '
                f"records' qa/passes/{name}.md; qa findings lists them.\n"))
        self.save(directory, state)
        log(f'{name}: {outcome}, {count} findings, {wall}')
        self.notify(directory, state)

    def start(self, repo, main, commits, checkout, cap):
        started = timestamp()
        base = utc(started).strftime('%Y%m%d-%H%M-') + repo
        name, index = base, 1
        while (self.directory / name).exists() or self.record.path(f'qa/passes/{name}.md').exists():
            index += 1
            name = base + '-' + str(index)
        directory = self.directory / name
        directory.mkdir(mode=0o700)
        state = {'pass': name, 'repository': repo, 'main': main, 'commits': [c['commit'] for c in commits],
                 'started': started, 'run': '', 'capped': False, 'finished': False}
        git(checkout, 'checkout', '--detach', '--force', main)
        git(checkout, 'clean', '-fdq')
        brief = BRIEF.format(name=name, agents=Path(__file__).resolve().parents[2], repo=repo, main=main,
                             checkout=checkout, directory=directory, cap=cap, started=started,
                             commits='\n'.join(f'  - {c["commit"]} {c["subject"]}\n    QA: {c["qa"]}' for c in commits))
        replace(directory / 'brief.md', brief.encode())
        fields = dict(repository=repo, main=main, commits=' '.join(state['commits']), machine=self.workspace.machine(),
                      model='unknown', effort='unknown', started=started, ended='unknown', wall='unknown',
                      tokens='unknown', outcome='running')
        report = Pass(name, fields, f'# QA pass {name}\n')
        # State precedes the commit: a restart can always find a committed start.
        self.save(directory, state)
        try:
            self.record.commit({f'qa/passes/{name}.md': report.text()}, f'qa watch: {name} started')
        except Problem as error:
            log(f'{name}: record refused start: {error}')
            message = directory / 'post-body'
            replace(message, f'QA pass {name} could not start: {error}.\n'.encode())
            sent = self.call('post', 'send', '--as', 'qa-watch', self.director, f'qa: pass {name} refused', message)
            if sent.returncode not in (0, 3):
                log(f'{name}: post failed: {sent.stderr.strip()}')
            shutil.rmtree(directory)
            return False
        launch = self.call('codex-run', 'task', '--to', 'qa-watch', directory / 'brief.md', checkout, directory / 'report.md')
        words = launch.stdout.split()
        if launch.returncode or not words or not re.fullmatch(r'[a-zA-Z0-9_-]+', words[0]):
            self.finish(directory, state, 'codex-run refused: ' + (launch.stderr.strip() or launch.stdout.strip() or 'no run id'))
        else:
            state['run'] = words[0]
            self.save(directory, state)
            log(f'{name}: started run {state["run"]} at {main}')
        return True

    def recover_run(self, directory, state):
        # codex-run writes meta before launching its unit. Recover an acknowledged
        # launch even if this service died before saving the returned id.
        matches = []
        for path in self.runs.glob('*/meta'):
            fields = dict(line.split('=', 1) for line in path.read_text().splitlines() if '=' in line)
            if fields.get('task') == str(directory / 'brief.md') and fields.get('report') == str(directory / 'report.md'):
                need(re.fullmatch(r'[a-zA-Z0-9_-]+', path.parent.name), 'invalid recovered run', 4)
                matches.append(path.parent.name)
        need(len(matches) <= 1, f'{state["pass"]}: multiple runs for one brief', 4)
        if matches:
            state['run'] = matches[0]
            self.save(directory, state)
            log(f'{state["pass"]}: recovered run {state["run"]}')

    def check(self, options):
        log('checking')
        with self.record.locked():
            for directory, state in self.local_passes():
                if state['finished']:
                    self.notify(directory, state)
                    continue
                if not state['run']:
                    if not self.record.path(f'qa/passes/{state["pass"]}.md').exists():
                        shutil.rmtree(directory)
                        log(f'{state["pass"]}: removed uncommitted start')
                        continue
                    self.recover_run(directory, state)
                run = state['run']
                ended = self.runs / run / 'ended' if run else None
                if ended and ended.exists():
                    self.finish(directory, state)
                elif not run:
                    self.finish(directory, state, 'The service stopped before saving a run id.')
                elif self.call('systemctl', '--user', 'is-active', '--quiet', 'codex-run-' + run).returncode:
                    self.finish(directory, state, None if ended.exists() else 'The run unit vanished without its end.')
                elif state['capped'] or (utc(timestamp()) - utc(state['started'])).total_seconds() >= options['QA_CAP_MINUTES'] * 60:
                    state['capped'] = True
                    self.save(directory, state)
                    stopped = self.call('systemctl', '--user', 'stop', 'codex-run-' + run)
                    if stopped.returncode:
                        state['capped'] = False
                        self.save(directory, state)
                        log(f'{state["pass"]}: stop failed: {stopped.stderr.strip()}')
                    else:
                        log(f'{state["pass"]}: capped run {run}')
            running = [s for _, s in self.local_passes() if not s['finished']]
            free = max(0, options['QA_SLOTS'] - len(running))
            busy = {s['repository'] for s in running}
            # Preflight every source before any launch: an unreadable feed starts none.
            waiting = chosen(self.record, 'run')
            repos = list(dict.fromkeys(r for r, _, _ in waiting if r not in busy)) if free else []
            cleared = {}
            for repo in repos:
                result = self.call('landings', 'cleared', repo)
                if result.returncode == 1:
                    log(f'{repo}: no cleared main')
                    continue
                if result.returncode:
                    log(f'{repo}: cannot read cleared main: {result.stderr.strip() or result.stdout.strip()}')
                    cleared = {}
                    break
                main = result.stdout.strip()
                need(re.fullmatch(SHA, main), f'{repo}: invalid cleared main', 4)
                cleared[repo] = main
            for repo, main in cleared.items():
                if not free:
                    break
                with self.repositories.fetched(repo) as checkout:
                    order = git(checkout, 'rev-list', '--reverse', 'origin/main').splitlines()
                    selected = {sha for r, sha, _ in waiting if r == repo}
                    need(selected <= set(order), f'{repo}: waiting commit missing from origin/main', 4)
                    selected = [sha for sha in order if sha in selected]
                    def holds(sha):
                        result = git(checkout, 'merge-base', '--is-ancestor', sha, main, check=False)
                        need(result.returncode in (0, 1), f'{repo}: cannot read cleared commit {main}', 4)
                        return result.returncode == 0
                    if not holds(selected[0]):
                        log(f'{repo}: cleared main does not hold oldest waiting commit')
                        continue
                    commits = []
                    for sha in selected:
                        if holds(sha):
                            subject = git(checkout, 'show', '-s', '--format=%s', sha)
                            trailer = git(checkout, 'show', '-s', '--format=%(trailers:key=QA,valueonly)', sha)
                            commits.append(dict(commit=sha, subject=subject, qa=' '.join(trailer.splitlines())))
                            if len(commits) == options['QA_BATCH']:
                                break
                    if not self.start(repo, main, commits, checkout, options['QA_CAP_MINUTES']):
                        break
                    free -= 1
            for directory, state in self.local_passes():
                if state['finished'] and not state.get('notice') and (utc(timestamp()) - utc(state['ended'])).total_seconds() >= 7 * 86400:
                    shutil.rmtree(directory)
                    log(f'{state["pass"]}: pruned')


def watch(director, once, workspace):
    os.environ['POST_NAME'] = 'qa-watch'
    # Check assignment before mkdir, locks, record pull, or any other side effect.
    need(workspace.fixture or (Path.home() / '.config/agents-qa/director').is_file(),
         "this is not the service's machine (no ~/.config/agents-qa/director)")
    need(re.fullmatch(r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*@[a-z][a-z0-9-]*', director),
         'invalid director address: expected NAME@MACHINE')
    service = Watch(workspace, director)
    service.directory.mkdir(parents=True, exist_ok=True)
    with (service.directory / 'watch.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Problem('another service runs') from None
        while True:
            options = settings(workspace)
            service.check(options)
            if once:
                return 0
            interval = options['QA_INTERVAL_SECONDS']
            waited = service.call('post', 'wait', 'qa-watch', '--timeout', str(interval), '--holder', str(os.getpid()), '--kind', 'codex')
            if waited.returncode == 0:
                read = service.call('post', 'read', 'qa-watch')
                log(read.stdout)
                if read.returncode:
                    log('post read failed: ' + read.stderr.strip())
            elif waited.returncode == 4:
                log('another waiter took qa-watch')
                return 2
            elif waited.returncode != 1:
                log('post wait failed: ' + (waited.stderr.strip() or waited.stdout.strip()))
                time.sleep(interval)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    for name in ('candidates', 'backlog'):
        sub.add_parser(name).add_argument('repo', nargs='?')
    decide_parser = sub.add_parser('decide')
    decide_parser.add_argument('repo')
    decide_parser.add_argument('choices', nargs='+')
    decide_parser.add_argument('--why', default='')
    sub.add_parser('passes').add_argument('--running', action='store_true')
    sub.add_parser('findings')
    triage_parser = sub.add_parser('triage')
    triage_parser.add_argument('pass_name')
    triage_parser.add_argument('number', type=int)
    triage_parser.add_argument('route', nargs='+')
    triage_parser.add_argument('--why', default='')
    service = sub.add_parser('watch')
    service.add_argument('--director', required=True)
    service.add_argument('--once', action='store_true')
    args = parser.parse_args()
    try:
        workspace = Workspace()
        if args.command == 'watch':
            return watch(args.director, args.once, workspace)
        why = getattr(args, 'why', '') or ''
        need(not any(c in why for c in '\n\r\t'), '--why must not contain a newline or tab')
        repo = getattr(args, 'repo', None)
        if repo:
            workspace.origin(repo)
        workspace.tmp.mkdir(parents=True, exist_ok=True)
        record = Record(workspace)
        with record.locked():
            repositories = Repositories(workspace)
            if args.command == 'candidates':
                candidates(repo, record, repositories)
            elif args.command == 'decide':
                decide(args, record, repositories)
            elif args.command == 'backlog':
                backlog(repo, record, repositories)
            elif args.command == 'passes':
                passes(args.running, record, repositories)
            elif args.command == 'findings':
                findings(record)
            elif args.command == 'triage':
                triage(args, workspace, record)
        return 0
    except Problem as error:
        print(f'qa: {error}', file=sys.stderr)
        return error.code
    except (OSError, ValueError, UnicodeError) as error:
        print(f'qa: {error}', file=sys.stderr)
        return 4


if __name__ == '__main__':
    sys.exit(main())
