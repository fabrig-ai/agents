    (jobs.parent / 'linked.md').symlink_to(private[0])
    refused(jobs.parent / 'linked.md', rule='private place')
    fifo = lab.root / 'fifo'
    os.mkfifo(fifo)
    refused(fifo, rule='regular file')
    refused(lab.root, rule='regular file')
    refused(lab.root / 'missing', rule='regular file')
