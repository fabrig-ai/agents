    for value, rule in [(lab.token, 'a forge credential'), (lab.secret, 'a forge credential'),
                        ('ghp_' + 'a' * 30, 'a secret'), ('-----BEGIN OPENSSH PRIVATE KEY-----', 'a secret')]:
        lab.file.write_text('Question\n\nDetail\n' + value + '\n')
        refused(rule='FILE line 4: ' + rule)
        # Titles share the very same checks.
