class Lab:
    """A private workspace, records, credentials, fake post and fake Forgejo."""
    def __init__(self, root):
        self.root, self.outputs, self.logs = root, [], []
        self.home, self.tmp, self.records, self.bin, self.state = (root / n for n in ('home', 'tmp', 'records', 'bin', 'state'))
        for path in (self.home, self.tmp / 'post', self.tmp / 'git-fabrig', self.records / 'missions/fixture',
                     self.bin, self.state, root / 'posts', root / 'config'):
            path.mkdir(parents=True, exist_ok=True)
        (self.tmp / 'post/machines').write_text('m1 local\nhel8 fixture@invalid\nhetzner2 ssh-fixture\n')
        self.token, self.secret = 'made-up-issue-token-123', 'made-up-hook-secret-456'
        for name, value in [('agents-issues.token', self.token), ('webhook.secret', self.secret)]:
            path = self.tmp / 'git-fabrig' / name
            path.write_text(value + '\n')
            path.chmod(0o600)
        for mission, repo in [('fixture', 'temper'), ('tooling', 'agents')]:
            self.readme(mission, repo=repo)
        (self.bin / 'post').write_text(f'#!{sys.executable} -S\n' + POST)
        (self.bin / 'post').chmod(0o700)
        (self.bin / 'record').write_text(f'#!{sys.executable} -S\n' + RECORD)
        (self.bin / 'record').chmod(0o700)
        (self.bin / 'systemctl').write_text(f'#!{sys.executable} -S\n' + SYSTEMCTL)
        (self.bin / 'systemctl').chmod(0o700)
        (root / 'exits.json').write_text('{}')
        self.file = root / 'question.md'
        self.file.write_text('Which cache should we use?\n\n  \n')
        self.forge = Forge(self.token)
        self.env = dict(PATH=f'{self.bin}:/usr/bin:/bin', HOME=str(self.home), DEV_ROOT=str(root),
                        DEV_TMP=str(self.tmp), RECORDS=str(self.records), POST_NAME='o/fixture',
                        XDG_STATE_HOME=str(self.state), XDG_CONFIG_HOME=str(root / 'config'),
                        ISSUE_FORGE=self.forge.url, ISSUE_LAB=str(root), LC_ALL='C.UTF-8')
        self.spool = self.state / 'issue-router'

    def readme(self, mission, repo='agents', owner='o/fixture@m1', parent='director@hel8'):
        path = self.records / 'missions' / mission / 'README.md'
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(f'---\nfeature: {repo} docs/x.md\nowner: {owner}\nparent: {parent}\n---\nFixture.\n')

    def safe(self, value):
        for secret in (self.token, self.secret):
            assert secret not in str(value), value

    def run(self, *args, status=0, extra=None) -> str:
        result = subprocess.run([str(SCRIPT), *map(str, args)], env=dict(self.env, **(extra or {})),
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, timeout=HUNG_TOOL_S)
        output = result.stdout + result.stderr
        self.outputs.append(output)
        self.safe(output)
        assert result.returncode == status, (args, result.returncode, output)
        return output

    @contextmanager
    def router(self, *args):
        log = self.root / f'router-{len(self.logs)}.log'
        self.logs.append(log)
        with log.open('w') as err:
            proc = subprocess.Popen([str(SCRIPT), 'serve', '--listen', '127.0.0.1:0', *args], env=self.env,
                                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=err, text=True)
            try:
                with selectors.DefaultSelector() as poll:
                    poll.register(proc.stdout, selectors.EVENT_READ)
                    assert poll.select(HUNG_TOOL_S), 'router did not start'
                line = proc.stdout.readline()
                self.safe(line)
                assert line.startswith('issue: listening on 127.0.0.1:'), (line, log.read_text())
                yield 'http://' + line.strip().split()[-1] + '/hook'
            finally:
                proc.terminate()
                try:
                    proc.wait(timeout=CHILD_STOP_S)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait()
                proc.stdout.close()
                self.safe(log.read_text())

    def exits(self, address: str, code: int, line: str):
        path = self.root / 'exits.json'
        rows = json.loads(path.read_text())
        rows[address] = [code, line]
        staged = path.with_suffix('.tmp')
        staged.write_text(json.dumps(rows))
        staged.replace(path)

    def posts(self, count: int) -> list[dict]:
        until = time.monotonic() + HUNG_TOOL_S
        while True:
            paths = sorted((self.root / 'posts').glob('*.json'))
            if len(paths) >= count:
                rows = [json.loads(path.read_text()) for path in paths]
                self.safe(rows)
                return rows
            assert time.monotonic() < until, (count, paths)
            time.sleep(.02)

    def settled(self, comment, state='done', repo='temper'):
        path = self.spool / state / f'{repo}-{comment}.json'
        until = time.monotonic() + HUNG_TOOL_S
        while not path.exists():
            assert time.monotonic() < until, path
            time.sleep(.02)
        return json.loads(path.read_text())

    def open(self):
        return self.run('open', '--public', 'Pick a cache server', self.file)

    def close(self):
        self.forge.close()
        self.safe(self.forge.requests)
        for path in self.logs:
            self.safe(path.read_text())


def open_files_an_issue_in_the_missions_repository(lab):
    output = lab.run('open', 'Pick a cache server', lab.file, extra={'POST_NAME': 'o/tooling'})
    assert output == f'agents#1 {lab.forge.url}/{OWNER}/agents/issues/1\n'
    issue = lab.forge.issues['agents'][1]
    assert issue['title'] == 'Pick a cache server' and issue['labels'] == [1], issue
    assert issue['body'] == ('Which cache should we use?\n\n---\n'
                             'Asked for the mission `tooling`. Your comment here '
                             'reaches it by post, and it closes the issue.\n'
                             '<!-- waiting-on-user mission=tooling -->')
    assert all(word not in issue['body'] for word in ('@', 'm1', 'hel8'))
    assert len(lab.forge.requests) == 2
    assert all(row['authorized'] for row in lab.forge.requests)


def a_public_repository_needs_the_askers_word(lab):
    assert "issue: temper's issues are public: write the text for anyone, then pass --public" in lab.run(
        'open', 'Question', lab.file, status=2)
    assert lab.forge.requests == []
    assert lab.open() == f'temper#1 {lab.forge.url}/{OWNER}/temper/issues/1 public\n'
    assert lab.forge.issues['temper'][1]['labels'] == [6]
    assert lab.run('open', '--repo', 'qa', 'Question', lab.file).startswith('qa#1 ')
    lab.run('open', '--repo', 'nope', 'Question', lab.file, status=2)
    for repo in ('skein', 'smith', 'jig', 'hearth'):
        before = len(lab.forge.requests)
        lab.run('open', '--repo', repo, 'Question', lab.file, status=2)
        assert len(lab.forge.requests) == before
        assert lab.run('open', '--repo', repo, '--public', 'Question', lab.file).endswith(' public\n')
        assert lab.forge.issues[repo][1]['labels'] == [REPOS.index(repo) + 1]


def open_names_who_asks(lab):
    lab.run('open', 'Director asks', lab.file, extra={'POST_NAME': 'director'})
    assert lab.forge.issues['agents'][1]['body'].endswith('<!-- waiting-on-user director -->')
    lab.run('open', '--mission', 'other', 'Other asks', lab.file)
    assert lab.forge.issues['agents'][2]['body'].endswith('<!-- waiting-on-user mission=other -->')
    lab.run('open', 'Question', lab.file, status=2, extra={'POST_NAME': ''})
    lab.run('open', '--mission', 'Bad', 'Question', lab.file, status=2)
