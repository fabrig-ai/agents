def comment_and_close_take_only_the_askers_own(lab):
    marker = TOOL['write_marker']
    lab.forge.add('agents', body=marker('tooling'))
    lab.forge.add('agents')
    lab.forge.add('agents', body=marker('fixture'))
    lab.forge.add('agents', body=marker('fixture'), pull_request={'url': 'pull'})
    for command in ('comment', 'close'):
        for number in (1, 2, 4):
            before = len(lab.forge.requests)
            output = lab.run(command, f'agents#{number}', lab.file, status=2)
            assert len(lab.forge.requests) == before + 1
            assert lab.forge.requests[-1]['method'] == 'GET'
            assert ('asked by tooling, not fixture' if number == 1 else "has no asker's marker" if number == 2 else 'pull request') in output
        for bad in ('agents#x', 'nope#1', 'agents#0', 'agents#-1', '#1', 'agents#١', 'agents#' + '9' * 5000):
            before = len(lab.forge.requests)
            lab.run(command, bad, lab.file, status=2)
            assert len(lab.forge.requests) == before
    assert lab.run('comment', 'agents#3', lab.file) == f'agents#3 {lab.forge.url}/{OWNER}/agents/issues/3#issuecomment-1\n'
    assert lab.run('close', 'agents#3', lab.file) == 'agents#3 closed\n'
    own = lab.forge.issues['agents'][3]
    assert [c['body'] for c in own['comments']] == [lab.file.read_text()] * 2
    assert own['state'] == 'closed'
    before = len(lab.forge.requests)
    assert lab.run('close', 'agents#3') == 'agents#3 was closed already\n'
    assert len(lab.forge.requests) == before + 1
    assert lab.run('close', '--mission', 'tooling', 'agents#1') == 'agents#1 closed\n'
    lab.forge.add('temper', body=marker('fixture'))
    lab.run('comment', 'temper#1', lab.file)
    for command in ('comment', 'close'):
        for data in (b'\xff', b'x' * (60 * 1024 + 1), b'<!-- waiting-on-user director -->'):
            lab.file.write_bytes(data)
            before = len(lab.forge.requests)
            lab.run(command, 'temper#1', lab.file, status=2)
            assert len(lab.forge.requests) == before
        lab.run(command, 'temper#1', lab.root, status=2)
    assert lab.forge.issues['temper'][1]['state'] == 'open'
    lab.file.write_text('valid')
    lab.forge.error = (500, {'message': 'comment failed'})
    lab.forge.error_route = ('POST', f'/api/v1/repos/{OWNER}/temper/issues/1/comments')
    before = len(lab.forge.requests)
    lab.run('close', 'temper#1', lab.file, status=1)
    assert [r['method'] for r in lab.forge.requests[before:]] == ['GET', 'POST']
    assert lab.forge.issues['temper'][1]['state'] == 'open'
    lab.forge.error_route = ('PATCH', f'/api/v1/repos/{OWNER}/temper/issues/1')
    before = len(lab.forge.requests)
    lab.run('close', 'temper#1', status=1)
    assert [r['method'] for r in lab.forge.requests[before:]] == ['GET', 'PATCH']
    assert lab.forge.issues['temper'][1]['state'] == 'open'


def a_user_comment_reaches_the_missions_owner(lab):
    lab.open()
    with lab.router() as url:
        lab.forge.hook(url, lab.secret)
        assert lab.forge.comment(1, 'free', 'Try the second cache.\nKeep the first as spare.') == 204
        sent, = lab.posts(1)
        assert sent['argv'] == ['send', '--as', 'issues', 'o/fixture@m1', 'temper#1 free replied: Pick a cache server']
        assert sent['stdin'] == (f'free on temper#1, {lab.forge.last["comment"]["html_url"]}:\n\n'
                                 'Try the second cache.\nKeep the first as spare.\n\n'
                                 'Answer there with `issue comment temper#1 FILE`, and close it with `issue close temper#1` once done.\n')
        row = lab.settled(1)
        assert row['attempts'] == 0 and row['received'].endswith('Z')
        assert row['tried'] == [dict(recipient='o/fixture@m1', exit=0, line='fixture-id waiting')]
        assert not list((lab.spool / 'new').iterdir())
    assert 'Try the second cache' not in lab.logs[0].read_text()


def a_gone_owner_falls_back_to_its_parent(lab):
    lab.open()
    lab.exits('o/fixture@m1', 3, 'queued, nobody will wake it: stopped')
    with lab.router() as url:
        lab.forge.hook(url, lab.secret)
        assert lab.forge.comment(1, 'free', 'Use the second.') == 204
        sent = lab.posts(2)
        row = lab.settled(1)
        assert [p['argv'][3] for p in sent] == ['o/fixture@m1', 'director@hel8']
        assert [r['exit'] for r in row['tried']] == [3, 0]
        assert sent[1]['progress']['temper-1.json'] == row['tried'][:1]
        assert sent[1]['stdin'].splitlines()[0] == ('For o/fixture@m1, whom post could not wake: '
                                                   'queued, nobody will wake it: stopped.')
        assert len(lab.posts(0)) == 2
        lab.readme('fixture', repo='temper', owner='unknown')
        lab.exits('director@hel8', 3, 'parent stopped')
