    lab.file.write_text('Question\n<!-- waiting-on-user arbitrary -->')
    refused(rule='FILE line 2: a waiting-on-user marker')
    # Empty and unreadable credential entries are ignored, as are subdirectories.
    directory = lab.tmp / 'git-fabrig'
