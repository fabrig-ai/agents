def request(url, body=None, headers=None, method=None):
    assert urllib.parse.urlsplit(url).hostname == '127.0.0.1', url
    req = urllib.request.Request(url, data=body, headers=headers or {}, method=method)
    try:
        with OPENER.open(req, timeout=HUNG_TOOL_S) as response:
            return response.status, response.read()
    except urllib.error.HTTPError as error:
        return error.code, error.read()


class Forge:
    """An in-process Forgejo, including signed comment webhooks."""
    def __init__(self, token: str):
        self.token, self.requests = token, []
        self.issues = {repo: {} for repo in REPOS}
        self.serial, self.last, self.target = 0, None, None
        self.labels = {repo: [{'id': n, 'name': 'waiting-on-user'}] for n, repo in enumerate(REPOS, 1)}
        self.error, self.error_route = None, None
        forge = self
        class Handler(BaseHTTPRequestHandler):
            def log_message(self, *args):
                pass

            def do_GET(self):
                self.handle_api()

            def do_POST(self):
                self.handle_api()

            def do_PATCH(self):
                self.handle_api()

            def handle_api(self):
                parsed = urllib.parse.urlsplit(self.path)
                query = urllib.parse.parse_qs(parsed.query)
                raw = self.rfile.read(int(self.headers.get('Content-Length', '0')))
                body = json.loads(raw) if raw else None
                authorized = self.headers.get('Authorization') == 'token ' + forge.token
                forge.requests.append(dict(method=self.command, path=parsed.path, query=query,
                                           body=body, authorized=authorized))
                status, result = 200, None
                if not authorized:
                    status, result = 401, {'message': 'bad credentials'}
                elif forge.error and (forge.error_route is None or forge.error_route == (self.command, parsed.path)):
                    status, result = forge.error
                else:
                    parts = parsed.path.split('/')
                    repo = parts[5] if len(parts) > 6 and parts[:5] == ['', 'api', 'v1', 'repos', OWNER] else None
                    tail = '/'.join(parts[6:])
                    if repo not in REPOS:
                        status, result = 404, {'message': 'unknown repository'}
                    elif self.command == 'GET' and tail == 'labels':
                        page = int(query.get('page', ['1'])[0])
                        result = forge.labels[repo][(page - 1) * 50:page * 50]
                    elif self.command == 'POST' and tail == 'issues':
                        result = forge.add(repo, **body)
                        status = 201
                    elif self.command == 'GET' and tail == 'issues':
                        assert query['state'] == ['open'] and query['type'] == ['issues']
                        assert query['labels'] == ['waiting-on-user'] and query['limit'] == ['50']
                        rows = [r for r in forge.issues[repo].values() if r['state'] == 'open'
                                and not r.get('pull_request') and forge.labels[repo][0]['id'] in r['labels']]
                        page = int(query['page'][0])
                        result = sorted(rows, key=lambda r: -r['number'])[(page - 1) * 50:page * 50]
                    elif tail.startswith('issues/'):
                        number = int(parts[7])
                        issue = forge.issues[repo].get(number)
                        if issue is None:
                            status, result = 404, {'message': 'missing issue'}
                        elif self.command == 'GET' and len(parts) == 8:
                            result = issue
                        elif self.command == 'POST' and parts[8:] == ['comments']:
                            comments = issue.setdefault('comments', [])
                            result = dict(body, html_url=issue['html_url'] + f'#issuecomment-{len(comments) + 1}')
                            comments.append(result)
                            status = 201
                        elif self.command == 'PATCH' and len(parts) == 8:
                            issue.update(body)
                            result = issue
                        else:
                            status, result = 404, {'message': 'unknown route'}
                    else:
                        status, result = 404, {'message': 'unknown route'}
                data = json.dumps(result).encode()
                self.send_response(status)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Content-Length', str(len(data)))
                self.end_headers()
                self.wfile.write(data)
        self.server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
        self.url = f'http://127.0.0.1:{self.server.server_port}'
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()

    def add(self, repo, **fields):
        number = len(self.issues[repo]) + 1
        row = dict(number=number, html_url=f'{self.url}/{OWNER}/{repo}/issues/{number}',
                   state='open', user={'login': 'fabrig-agents'},
                   created_at=(datetime.now(timezone.utc) - timedelta(minutes=45)).isoformat(),
                   labels=[REPOS.index(repo) + 1], title='Choose', body='No marker')
        row.update(fields)
        self.issues[repo][number] = row
        return row

    def hook(self, url: str, secret: str):
        self.target, self.secret = url, secret

    def comment(self, number: int, author: str, text: str, *, secret: str | None = None,
                event: str = 'issue_comment', repo='temper') -> int:
        self.serial += 1
        self.last = dict(action='created', issue=dict(self.issues[repo][number]),
                         comment=dict(id=self.serial, html_url=f'{self.url}/{OWNER}/{repo}/issues/{number}#issuecomment-{self.serial}',
                                      body=text, user={'login': author}),
                         repository={'full_name': f'{OWNER}/{repo}'}, sender={'login': author}, is_pull=False)
        return self.emit(self.last, secret=secret, event=event)

    def emit(self, payload, *, secret=None, event='issue_comment', gitea=False):
        data = json.dumps(payload).encode()
        signature = hmac.new((self.secret if secret is None else secret).encode(), data, hashlib.sha256).hexdigest()
        headers = {'Content-Type': 'application/json', 'X-Gitea-Event': event,
                   'X-Gitea-Signature': signature, 'X-Forgejo-Delivery': f'fixture-{self.serial}'}
        if not gitea:
            headers.update({'X-Forgejo-Event': event, 'X-Forgejo-Signature': signature})
        return request(self.target, data, headers)[0]

    def redeliver(self) -> int:
        return self.emit(self.last)

    def close(self):
        self.server.shutdown()
        self.server.server_close()
        self.thread.join()


