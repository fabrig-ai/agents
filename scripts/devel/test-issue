def oversized_webhook_keeps_reading_after_413(lab):
    # Hold the upload until the handler either reads its body or returns.
    # On the old path, wait for the actual close before resuming the sender:
    # unread input then makes the upload fail, regardless of scheduling.
    progress, closed = queue.Queue(), threading.Event()

    class BodyReader:
        def __init__(self, stream):
            self.stream = stream

        def __getattr__(self, name):
            method = getattr(self.stream, name)
            if name in ('read', 'read1'):
                def read(*args):
                    progress.put('reading')
                    return method(*args)
                return read
            return method

    class Handler(TOOL['Hook']):
        def do_POST(self):
            self.rfile = BodyReader(self.rfile)
            try:
                # This case holds scheduling, not the production deadline;
                # the fake-clock case below proves that deadline separately.
                with patch.dict(TOOL['Hook'].do_POST.__globals__, REJECT_DRAIN_S=HUNG_TOOL_S):
                    super().do_POST()
            finally:
                progress.put('returned')

    class Server(ThreadingHTTPServer):
        def shutdown_request(self, connection):
            try:
                super().shutdown_request(connection)
            finally:
                closed.set()

    server = Server(('127.0.0.1', 0), Handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        with socket.create_connection(server.server_address, timeout=HUNG_TOOL_S) as client:
            length = 1024 * 1024 + 1
            client.sendall(f'POST /hook HTTP/1.1\r\nHost: localhost\r\n'
                           f'Content-Length: {length}\r\n\r\n'.encode() + b'x')
            if progress.get(timeout=HUNG_TOOL_S) == 'returned':
                assert closed.wait(HUNG_TOOL_S), 'server did not close'
            response = http.client.HTTPResponse(client)
            response.begin()
            assert response.status == 413
            assert response.read() == b''
            # Read EOF as well: the response must finish before upload finishes.
            assert client.recv(1) == b''
            client.sendall(b'x' * (length - 1))
            client.shutdown(socket.SHUT_WR)
            assert closed.wait(HUNG_TOOL_S), 'server did not finish draining'
            assert response.getheader('Connection') == 'close'
            response.close()
        assert not list(lab.spool.glob('*/*.json'))
    finally:
        server.shutdown()
        server.server_close()
        thread.join(timeout=HUNG_TOOL_S)
        assert not thread.is_alive()


def oversized_webhook_drain_has_a_total_deadline(lab):
    # A trickling sender consumes the total budget even while reads succeed.
    # Also cover EOF, a stalled reader and a peer gone before write shutdown.
    for reads, times, shutdown_error, expected_timeouts in (
            ([b'x', b'x'], [100, 100, 102, 105], None, [5, 3]),
            ([b''], [100, 100], None, [5]),
            ([TimeoutError()], [100, 100], None, [5]),
            ([], [100], ConnectionResetError(), [])):
        handler = TOOL['Hook'].__new__(TOOL['Hook'])
        handler.path = '/hook'
        handler.headers = {'Content-Length': str(1 << 60)}
        handler.answer = Mock()
        handler.connection = Mock()
        handler.connection.shutdown.side_effect = shutdown_error
        handler.rfile = Mock()
        handler.rfile.read1.side_effect = reads
        with patch.object(TOOL['time'], 'monotonic', side_effect=times):
            handler.do_POST()
        handler.answer.assert_called_once_with(413, 'body too large', close=True)
        handler.connection.shutdown.assert_called_once_with(socket.SHUT_WR)
        assert handler.connection.settimeout.call_args_list == [call(n) for n in expected_timeouts]
        assert handler.rfile.read1.call_args_list == [call(64 * 1024) for _ in reads]


def retries_restart_and_exhausted_chains_are_recorded(lab):
    lab.open()
    # Exercise worker retries through real child posts, without waiting 60 seconds.
    with patch.dict(os.environ, lab.env, clear=True):
        router = TOOL['Router'](TOOL['Paths']())
        asker = 'fixture'
        item = TOOL['Reply'](1, 1, 'Cache\nchoice', 'http://127.0.0.1/comment', 'free',
                             '\n'.join('x' * 400 for _ in range(14)), asker, 'temper')
        lab.exits('o/fixture@m1', 7, 'temporary failure')
        assert router.enqueue(item) == 'spooled'
        worker = threading.Thread(target=router.worker)
        worker.start()
        try:
            for attempt in range(1, 6):
                path = lab.spool / ('failed' if attempt == 5 else 'new') / 'temper-1.json'
                until = time.monotonic() + HUNG_TOOL_S
                while True:
                    if path.exists() and json.loads(path.read_text())['attempts'] == attempt:
                        break
                    assert time.monotonic() < until, (path, attempt)
                    time.sleep(.02)
                if attempt < 5:
                    router.wake.set()
            assert len(lab.posts(5)) == 5
        finally:
            router.stop.set()
            router.wake.set()
            worker.join(timeout=HUNG_TOOL_S)
            assert not worker.is_alive()
        # A startup worker discovers a reply spooled before the server starts.
        lab.exits('o/fixture@m1', 3, 'queued but stopped')
        lab.exits('director@hel8', 2, 'no route')
        lab.exits('director@m1', 3, 'queued but stopped')
        router.enqueue(TOOL['Reply'](2, 1, item.title, item.url, item.author, item.text, asker, 'temper'))
    with lab.router():
        lab.settled(2)
    sent = lab.posts(8)
    assert [p['argv'][3] for p in sent[-3:]] == ['o/fixture@m1', 'director@hel8', 'director@m1']
    for post in sent:
        assert len(post['stdin'].splitlines()) <= 15
        assert '\n' not in post['argv'][-1] and len(post['argv'][-1]) <= 200
        assert '[… 4 more lines on the issue.]' in post['stdin']
    with patch.dict(os.environ, lab.env, clear=True):
        router = TOOL['Router'](TOOL['Paths']())
        lab.exits('director@m1', 2, 'not delivered')
        failed = TOOL['Reply'](3, 1, item.title, item.url, item.author, item.text, asker, 'temper')
        router.enqueue(failed)
        path = lab.spool / 'new/temper-3.json'
        assert router.deliver(failed, json.loads(path.read_text()), path) == 'failed'
        # Each address is tried once even when asker, parent and director coincide.
        lab.exits('director@m1', 0, 'waiting')
        lab.readme('duplicate', owner='director@m1', parent='director@m1')
        duplicate = TOOL['Reply'](4, 1, 'title', item.url, 'free', 'answer', 'duplicate', 'temper')
        router.enqueue(duplicate)
        path = lab.spool / 'new/temper-4.json'
        assert router.deliver(duplicate, json.loads(path.read_text()), path) == 'done'
    assert len(lab.posts(12)) == 12


