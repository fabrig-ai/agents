        file.write_text('A question.')
        refused(file, rule='private place')
    link = lab.root / 'linked.md'
    link.symlink_to(private[0])
    refused(link, rule='private place')
    for file in ('/proc/version', '/run/no-such-issue-file', '/sys/no-such-issue-file'):
        refused(file, rule='private place')
    (lab.tmp / 'git-fabrig/file').unlink()
    jobs = lab.home / '.claude/jobs/x/tmp/question.md'
    jobs.parent.mkdir(parents=True)
    jobs.write_text('A question.')
    lab.run('open', '--repo', 'agents', 'Question', jobs)
