def red(lab):
    lab.green()
    one = lab.land(reds=['t1'], landed=True)
    lab.push()
    lab.run()
    verdict = lab.verdict(one)
    assert verdict['verdict'] == 'red' and verdict['tests'] == ['t1']
    assert 'attempt 2' in verdict['excerpt']
    assert 'failure text' in verdict['excerpt'] and verdict['landing_set'] == 'demo/m1'
    assert len(verdict['excerpt']) <= 8000 and len(verdict['excerpt'].splitlines()) <= 60
    assert lab.records('tier')[-1]['reds'] == [dict(landing=one, tests=['t1'])]
    two = lab.land()
    lab.push()
    lab.run()
    assert lab.verdict(two)['verdict'] == 'cleared'
    assert lab.records('tier')[-1]['state'] == 'red' and lab.state()['reds'] == {'t1': one}
    three = lab.land(reds=[])
    lab.push()
    lab.run()
    assert lab.verdict(three)['verdict'] == 'cleared'
    assert lab.records('tier')[-1]['state'] == 'green' and lab.state()['last_green'] == three
    assert len(lab.calls()) == 6 and lab.posts() == []


def bisect(lab):
    lab.green()
    one = lab.land()
    docs = lab.land(docs=True)
    two = lab.land(reds=['t2'])
    three = lab.land()
    lab.push()
    lab.run()
    calls = lab.calls()[1:]
    assert calls[0]['head'] == calls[1]['head'] == three
    assert 1 <= len(calls[2:]) <= 2 and all(c['head'] != docs for c in calls[2:])
    assert all(c['argv'][-2:] == ['--only', 't2'] for c in calls[1:])
    assert [(lab.verdict(t)['verdict'], lab.verdict(t)['tests']) for t in (one, docs, two, three)] == [
        ('cleared', []), ('cleared', []), ('red', ['t2']), ('cleared', [])]
    assert lab.state()['reds'] == {'t2': two} and lab.posts() == []
    assert lab.git(lab.root / 'runner/demo', 'rev-parse', 'HEAD') == three


