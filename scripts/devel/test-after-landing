def nested_faults(lab):
    green = lab.green()
    one = lab.land(reds=['t1'])
    lab.push()
    refuse = lab.root / 'refuse-call'
    refuse.write_text('3')  # Main fails, rerun cannot start.
    lab.run()
    assert lab.state()['last_run'] == green and lab.state()['reds'] == {}
    assert len(lab.records('verdict')) == 1 and len(lab.records('fault')) == 1
    refuse.unlink()
    two = lab.land(reds=['t1', 't2'])
    three = lab.land()
    lab.push()
    refuse.write_text('6')  # Main and rerun fail, first bisect probe cannot start.
    lab.run()
    assert lab.state()['last_run'] == green and lab.state()['reds'] == {}
    assert len(lab.records('verdict')) == 1 and len(lab.records('fault')) == 1
    refuse.unlink()
    lab.run()
    assert lab.state()['last_run'] == three and lab.state()['reds'] == {'t1': one, 't2': two}
    assert lab.state()['fault'] is None


