printf warm > target/warm
if test -s tier/target_bytes; then
    head -c "$(cat tier/target_bytes)" /dev/zero > target/fill
fi
head=$(git rev-parse HEAD)
count="$FIXTURE_COUNTS/$(basename "$PWD")-$head"
