    assert all(lab.verdict(t, tier='demo.2of2')['verdict'] == 'cleared'
               for t in (one, two, three, four))
    assert lab.state('demo.2of2')['reds'] == {} and lab.posts() == []
    env = dict(lab.env, AFTER_LANDING_RED_GRACE='0')
    lab.run(part='1/2', director=True, env=env)
    assert 'after-landing: demo.1of2 red at ' in lab.posts()[0]['argv'][4]


def part_star_rerun_passes_the_part(lab):
    lab.land()
    lab.push()
    lab.run(part='1/2')
    tip = lab.land(reds=['p1.t1'])
    lab.push()
    (lab.root / 'unnamed').touch()
    lab.run(part='1/2')
    assert lab.verdict(tip, tier='demo.1of2')['tests'] == ['*']
    assert lab.state('demo.1of2')['reds'] == {'*': tip}
