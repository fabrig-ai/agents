        parser.add_argument('cases', nargs='*', metavar='CASE')
        parser.add_argument('--case', action='append', choices=choices, default=[])
        args = parser.parse_args()
        for name in args.cases:
            if name not in choices:
                parser.error(f'unknown case {name!r}; choose: ' + ' '.join(choices))
        sys.argv[1:] = [name.replace('-', '_') for name in args.cases + args.case]
