               for c in lab.calls())


def whole_red(lab):
    green = lab.green()
    tip = lab.land(reds=['p2.t9'], landed=True)
    lab.push()
    lab.run()
    state = lab.state()
    assert state['reds'] == {'p2.t9': tip} and len(state['pending']) == 1
    state['fault'] = dict(since=datetime.now(timezone.utc).isoformat(), reason='whole fault',
                          commit=tip, posted=False)
    path = lab.root / 'state/demo.json'
    path.write_text(json.dumps(state) + '\n')
    return green, tip, path.read_bytes()


def part_from_whole_state(lab):
    green, previous, original = whole_red(lab)
    one, two = lab.land(), lab.land()
    lab.push()
    for k in (1, 2):
        name = f'demo.{k}of2'
        lab.run(part=f'{k}/2')
        records = lab.records(tier=name)
        assert lab.records('running', tier=name)[0]['from'] == previous
        assert not any(r.get('baseline') for r in records)
        assert [r['commit'] for r in lab.records('verdict', tier=name)] == [one, two]
        assert all(r['verdict'] == 'cleared' for r in lab.records('verdict', tier=name))
        state = lab.state(name)
        assert state['reds'] == ({'p2.t9': previous} if k == 2 else {})
        assert state['last_green'] == (green if k == 2 else two)
        assert state['pending'] == [] and state['fault'] is None
        assert 'starting from whole state at ' + previous in Path(records[-1]['log']).read_text()
    assert (lab.root / 'state/demo.json').read_bytes() == original
    assert lab.posts() == []


def part_from_whole_state_at_main(lab):
    green, previous, original = whole_red(lab)
    before = lab.calls()
    lab.run(part='2/2')
    state = lab.state('demo.2of2')
    assert state['last_run'] == previous and state['last_green'] == green
    assert state['reds'] == {'p2.t9': previous} and state['pending'] == [] and state['fault'] is None
    assert lab.records(tier='demo.2of2') == [] and lab.calls() == before
    assert (lab.root / 'state/demo.json').read_bytes() == original
    # A part's own fault survives seeding until the unchanged-main branch recovers it.
    path = lab.root / 'state/demo.1of2.json'
    own = lab.state()
    own.update(last_run=None, last_green=None, reds={},
               pending=[dict(own['pending'][0], tests=['own pending'])])
    own['fault']['reason'] = 'part fault'
    path.write_text(json.dumps(own))
    lab.run(part='1/2')
    recovered = lab.records(tier='demo.1of2')
    assert len(recovered) == 1 and recovered[0]['event'] == 'recovered'
    assert recovered[0]['since'] == own['fault']['since']
    assert lab.state('demo.1of2')['fault'] is None and lab.calls() == before
    assert lab.state('demo.1of2')['pending'] == own['pending']
    assert (lab.root / 'state/demo.json').read_bytes() == original


def part_not_from_whole_state(lab):
    for row in ('star', 'old_script', 'another_origin', 'absent', 'unreadable',
                'never_run', 'missing_object'):
        root = lab.root / row
        root.mkdir()
        sub = Lab(root)
        if row == 'old_script':
            (sub.work / 'scripts/after-landing.sh').write_text(TIER_WITHOUT_PART)
        head = sub.green()
        path = root / 'state/demo.json'
        state = sub.state()
        if row == 'star':
            state['reds'] = {'*': head}
        elif row == 'another_origin':
            state['origin'] = 'another-origin'
        elif row == 'never_run':
            state.update(last_run=None, last_green=None)
        elif row == 'missing_object':
            state['last_run'] = 'f' * 40
        if row == 'absent':
            path.unlink()
        elif row == 'unreadable':
            path.write_text('bad json')
        else:
            path.write_text(json.dumps(state))
        original = path.read_bytes() if path.exists() else None
        # Main's script supports parts even when the previous whole run did not.
        (sub.work / 'scripts/after-landing.sh').write_text(TIER)
        tip = sub.land()
        sub.push()
        sub.run(part='1/2')
        records = sub.records(tier='demo.1of2')
        assert records[0]['event'] == 'running' and records[0]['from'] is None, row
        assert all(r['baseline'] is True for r in records if r['event'] in ('verdict', 'tier')), row
        assert sub.state('demo.1of2')['last_run'] == tip, row
        assert (path.read_bytes() if path.exists() else None) == original, row
        assert len(sub.calls()) == 2, row
        assert 'whole state: ' in Path(records[-1]['log']).read_text(), row


def part_refusals(lab):
    for part in ('1/1', '0/2', '3/2', '2', 'a/b', '01/2', '1/02', '-1/2', '1/0'):
        result = lab.run(part=part, status=2)
        assert '--part' in result.stderr, part
        assert all(not (lab.root / name).exists() for name in ('runner', 'state', 'locks')), part
        assert lab.calls() == [] and lab.records() == [] and lab.posts() == [], part


