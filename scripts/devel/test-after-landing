def one_follower(lab):
    lab.land()
    lab.push()
    lock = lab.root / 'locks/demo.lock'
    lock.parent.mkdir()
    with lock.open('a') as out:
        fcntl.flock(out, fcntl.LOCK_EX | fcntl.LOCK_NB)
        result = lab.run(status=2)
        assert 'another follower' in result.stderr
    assert not (lab.root / 'runner/demo').exists()
    assert lab.calls() == [] and lab.posts() == [] and lab.records() == []


def refusals(lab):
    # Refuse alien checkout and state without deleting or repairing user evidence.
    head = lab.green()
    clone = lab.root / 'runner/demo'
    lab.git(clone, 'remote', 'set-url', 'origin', str(lab.root / 'elsewhere.git'))
    assert str(clone) in lab.run(status=2).stderr
    lab.git(clone, 'remote', 'set-url', 'origin', str(lab.origin))
    state = lab.root / 'state/demo.json'
    original = state.read_text()
    for content in ('bad json', '{}', original.replace(str(lab.origin), 'another-origin')):
        state.write_text(content)
        assert str(state) in lab.run(status=2).stderr
        assert state.read_text() == content
    state.write_text(original)
    missing = dict(lab.env, AFTER_LANDING_FIXTURE=str(lab.root / 'missing'))
    lab.run(status=2, env=missing)
    assert not (lab.root / 'missing').exists()
    assert lab.state()['last_run'] == head and len(lab.calls()) == 1
    assert lab.posts() == []


