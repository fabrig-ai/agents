def call(argv, cwd, env, status=0):
    result = subprocess.run([str(arg) for arg in argv], cwd=cwd, env=env,
                            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True, timeout=HUNG_TOOL_S)
    assert result.returncode == status, (argv, result.returncode, result.stdout, result.stderr)
    return result


def rows(path):
    return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []


class Lab:
    def __init__(self, root):
        self.root = root
        self.origin = root / 'origin/demo.git'
        self.work = root / 'work'
        self.env = dict({key: value for key, value in os.environ.items()
                         if not key.startswith('GIT_')}, AFTER_LANDING_FIXTURE=str(root),
                        AFTER_LANDING_HEAVY=str(root / 'heavy'), AFTER_LANDING_POST=str(root / 'post'),
                        FIXTURE_COUNTS=str(root / 'counts'), DEV_TMP=str(root / 'tmp'),
                        AFTER_LANDING_RED_GRACE='900', AFTER_LANDING_FAULT_POST='900',
                        AFTER_LANDING_GB=str(2 ** 30),
                        CARGO_TARGET_DIR='/must-not-reach-heavy',
                        GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL='/dev/null',
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@example.invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@example.invalid')
        (root / 'counts').mkdir()
        self.origin.parent.mkdir()
        self.git(None, 'init', '--bare', '--quiet', '--initial-branch=main', self.origin)
        self.git(None, 'clone', '--quiet', self.origin, self.work)
        # These standalone fakes use only the standard library; skip site setup.
        for name, body in (('heavy', HEAVY), ('post', POST)):
            path = root / name
            path.write_text(f'#!{PYTHON} -S\n' + body)
            path.chmod(0o700)
        # Any accidental transport is rejected locally, even with inherited ssh settings.
        bin_dir = root / 'bin'
        bin_dir.mkdir()
        ssh = bin_dir / 'ssh'
        ssh.write_text('#!/bin/sh\necho unexpected-ssh >&2\nexit 99\n')
        ssh.chmod(0o700)
        self.env['PATH'] = str(bin_dir) + ':' + self.env['PATH']
        self.env['GIT_SSH_COMMAND'] = str(ssh)
        (root / 'feed.jsonl').touch()
        (self.work / 'scripts').mkdir()
        (self.work / 'tier').mkdir()
        script = self.work / 'scripts/after-landing.sh'
        script.write_text(TIER)
        script.chmod(0o700)
        (self.work / '.gitignore').write_text('target/\n')
        for name in ('reds', 'flaky', 'lacks', 'starved'):
            (self.work / 'tier' / name).write_text('')
        self.serial = 0

    def git(self, cwd, *args):
        return call(['git', *args], cwd or self.root, self.env).stdout.strip()

    def land(self, reds=None, flaky=None, lacks=None, starved=None, docs=False, landed=False, trailer=True, body=''):
        self.serial += 1
        for name, value in (('reds', reds), ('flaky', flaky), ('lacks', lacks), ('starved', starved)):
            if value is not None:
                (self.work / 'tier' / name).write_text(''.join(test + '\n' for test in value))
        (self.work / 'story.md').write_text(str(self.serial))
        self.git(self.work, 'add', '.')
        tree = self.git(self.work, 'write-tree')
        message = f'landing {self.serial}' + ('\n\n' + body if body else '')
        if trailer:
            result = 'none (Markdown and mockups only)' if docs else 'pass fixture'
            message += f'\n\nGate-Tree: {tree}\nGate-Result: {result}\nGate-Policy: sha256:fixture'
        self.git(self.work, 'commit', '--quiet', '-m', message)
        commit = self.git(self.work, 'rev-parse', 'HEAD')
        if landed:
            self.append(event='landed', repo='demo', commit=commit, set='demo/m1')
        return commit

    def push(self):
        self.git(self.work, 'push', '--quiet', 'origin', 'main')

    def run(self, status=0, env=None, director=False, once=True, part=None):
        argv = [PYTHON, '-I', '-B', SCRIPT, 'follow', 'demo', '--origin', self.origin]
        if part is not None:
            argv += ['--part', part]
        if once:
            argv.append('--once')
        if director:
            argv += ['--director', 'director@x']
        return call(argv, self.root, env or self.env, status)

    def append(self, **fields):
        row = dict(time=datetime.now(timezone.utc).isoformat(), host='fixture', token='fixture')
        row.update(fields)
        with (self.root / 'feed.jsonl').open('a') as out:
            out.write(json.dumps(row) + '\n')

    def land_set(self, label, commit):
        self.append(event='started', set=label, token=label)
        self.append(event='landed', set=label, token=label, repo='demo', commit=commit)
        self.append(event='done', set=label, token=label)

    def landings(self, *args, status=0):
        env = dict(self.env, LANDINGS_FEED=str(self.root / 'feed.jsonl'), LANDINGS_POLL='.02',
                   DEV_ROOT=str(self.root / 'workspace'))
        return call([PYTHON, '-I', '-B', SCRIPT.with_name('landings'), *args],
                    self.root, env, status)

    def wait(self, label, status):
        return self.landings('wait', '--cleared', label, '--timeout', '0', status=status)

    def records(self, event=None, tier='demo'):
        result = [r for r in rows(self.root / 'feed.jsonl') if r.get('kind') == 'tier' and r.get('tier') == tier]
        return [r for r in result if r['event'] == event] if event else result

    def state(self, name='demo'):
        return json.loads((self.root / 'state' / (name + '.json')).read_text())

    def calls(self):
        return rows(self.root / 'calls.jsonl')

    def posts(self):
        return rows(self.root / 'posts.jsonl')

    def verdict(self, tip, tier='demo'):
        return next(r for r in reversed(self.records('verdict', tier=tier)) if r['commit'] == tip)

    def green(self):
        tip = self.land()
        self.push()
        self.run()
        return tip


def polls(lab):
    head = lab.green()
    records = lab.records()
    assert [r['event'] for r in records] == ['running', 'verdict', 'tier']
    assert records[0]['commit'] == head and records[0]['from'] is None
    assert lab.verdict(head)['verdict'] == 'cleared' and records[-1]['state'] == 'green'
    assert lab.verdict(head)['baseline'] is True and records[-1]['baseline'] is True
    assert all('set' not in r for r in records)
    assert len({r['token'] for r in records}) == 1
    first = lab.calls()[0]
    assert first['cls'] == 'background' and first['label'] == 'after-landing demo'
    assert first['argv'] == ['--', 'scripts/after-landing.sh'] and first['target'] is None
    assert first['cwd'] == str(lab.root / 'runner/demo') and first['head'] == head
    state_file = lab.root / 'state/demo.json'
    modified = state_file.stat().st_mtime_ns
    lab.run()
    assert state_file.stat().st_mtime_ns == modified, 'unchanged main wrote state'
    assert lab.records() == records and len(lab.calls()) == 1
    one, two = lab.land(), lab.land()
    lab.push()
    lab.run()
    assert len(lab.calls()) == 2 and lab.calls()[-1]['head'] == two
    assert lab.calls()[-1]['warm'], 'ignored target was not kept warm'
    assert [r['commit'] for r in lab.records('verdict')] == [head, one, two]
    assert all(r['verdict'] == 'cleared' for r in lab.records('verdict'))
    assert lab.state()['last_run'] == two and lab.state()['last_green'] == two


def target_past_its_cap_is_removed(lab):
    lab.env['AFTER_LANDING_GB'] = '65536'
    follow = lab.root / 'follow'
    follow.write_text('demo 1\n')
    fill = lab.work / 'tier/target_bytes'
    fill.write_text('131072')
    lab.green()
    target = lab.root / 'runner/demo/target'
    assert (target / 'fill').stat().st_blocks * 512 > 65536
    before = lab.calls(), lab.records()
    lab.run()
    assert (lab.calls(), lab.records()) == before and (target / 'fill').exists()
    fill.write_text('1')
    head = lab.land()
    lab.push()
    lab.run()
    assert lab.calls()[-1]['head'] == head and not lab.calls()[-1]['warm']
    assert lab.records('running')[-1]['fresh'] is True
    log = Path(lab.records('tier')[-1]['log']).read_text()
    assert ' GB allocated, past its cap of 1 GB: removed\n' in log
    assert log.count('target: ') == 1
    # Exactly the cap is retained too, including directories' allocated blocks.
    size = sum(path.lstat().st_blocks * 512 for path in (target, target / 'fill', target / 'warm'))
    lab.env['AFTER_LANDING_GB'] = str(size)
    lab.land()
    lab.push()
    lab.run()
    assert lab.calls()[-1]['warm'] and 'fresh' not in lab.records('running')[-1]
    lab.env['AFTER_LANDING_GB'] = '65536'
    # A changed line applies on the next pass; no second word restores 50 GB.
    fill.write_text('131072')
    lab.land()
    lab.push()
    lab.run()
    follow.write_text('demo\n')
    lab.land()
    lab.push()
    lab.run()
    assert lab.calls()[-1]['warm'] and 'fresh' not in lab.records('running')[-1]


def cap_never_mid_run(lab):
    lab.env['AFTER_LANDING_GB'] = '65536'
    (lab.root / 'follow').write_text('demo 1\n')
    lab.green()
    old = lab.land()
    (lab.work / 'tier/target_bytes').write_text('131072')
    red = lab.land(reds=['t2'])
    head = lab.land()
    lab.push()
    lab.run()
    calls = lab.calls()[1:]
    assert calls[0]['head'] == calls[1]['head'] == head
    assert len(calls) == 4 and {row['head'] for row in calls[2:]} == {old, red}
    assert all(row['warm'] for row in calls), calls
    assert 'fresh' not in lab.records('running')[-1]
    assert lab.state()['reds'] == {'t2': red}
    lab.land(reds=[])
    lab.push()
    lab.run()
    assert not lab.calls()[-1]['warm'] and lab.records('running')[-1]['fresh'] is True


def cap_from_follow_line(lab):
    for name, follow, part, gb, fresh, warning in (
        ('absent', None, None, 51, True, False),
        ('missing', 'other 1\n', None, 51, True, False),
        ('default', 'demo\n', None, 51, True, False),
        ('own', 'demo.1of2 2\n', '1/2', 1, False, False),
        ('own_tab', 'demo.1of2\t2\n', '1/2', 3, True, False),
        ('other_part', 'demo.1of2 2\n', '2/2', 3, False, False),
        ('bad', 'demo.1of2 0\n', '1/2', 51, True, True),
        ('bad_extra', 'demo.1of2 2 3\n', '1/2', 51, True, True),
    ):
        root = lab.root / name
        root.mkdir()
        sub = Lab(root)
        sub.env['AFTER_LANDING_GB'] = '65536'
        if follow is not None:
            (root / 'follow').write_text(follow)
        (sub.work / 'tier/target_bytes').write_text(str(gb * 65536))
        sub.land()
        sub.push()
        sub.run(part=part)
        sub.land()
        sub.push()
        result = sub.run(part=part)
        tier = 'demo' if part is None else 'demo.' + part.replace('/', 'of')
        running = sub.records('running', tier=tier)[-1]
        assert (running.get('fresh') is True) == fresh, (name, running)
        assert ('fresh' in running) == fresh, (name, running)
        assert sub.calls()[-1]['warm'] == (not fresh), name
        assert result.stderr.count('warning:') == int(warning), (name, result.stderr)
        if warning:
            assert 'line 1: invalid target cap; using 50 GB' in result.stderr


def cap_removal_fails(lab):
    lab.env['AFTER_LANDING_GB'] = '65536'
    (lab.root / 'follow').write_text('demo 1\n')
    previous = lab.green()
    target = lab.root / 'runner/demo/target'
    bulk = target / 'bulk'
    bulk.write_bytes(b'x' * 131072)
    locked = target / 'locked'
    locked.mkdir()
    (locked / 'fill').write_bytes(b'x')
    locked.chmod(0o500)
    try:
        head = lab.land()
        lab.push()
        before = lab.calls(), lab.records('running'), lab.records('verdict')
        for _ in range(2):
            lab.run()
            assert (lab.calls(), lab.records('running'), lab.records('verdict')) == before
            assert lab.state()['last_run'] == previous
            assert lab.state()['fault']['reason'] == 'target past its cap could not be removed'
        faults = lab.records('fault')
        assert len(faults) == 1 and faults[0]['commit'] == head
        # The writable bulk was removed before the small locked child failed.
        assert not bulk.exists()
        assert sum(path.lstat().st_blocks * 512 for path in
                   (target, locked, locked / 'fill')) < 65536
        # An unmeasurable remainder must not erase the pending whole removal.
        locked.chmod(0o000)
        lab.run()
        assert (lab.calls(), lab.records('running'), lab.records('verdict')) == before
        assert lab.state()['last_run'] == previous
        assert lab.state()['fault']['reason'] == 'target past its cap could not be removed'
    finally:
        locked.chmod(0o700)
    lab.run()
    assert lab.state()['last_run'] == head and lab.state()['fault'] is None
    assert lab.records('running')[-1]['fresh'] is True
    assert not lab.calls()[-1]['warm']


def cap_measure_fails(lab):
    previous = lab.green()
    target = lab.root / 'runner/demo/target'
    unreadable = target / 'unreadable'
    unreadable.mkdir()
    (unreadable / 'fill').write_bytes(b'x')
    unreadable.chmod(0o000)
    try:
        head = lab.land()
        lab.push()
        before = lab.calls(), lab.records('running'), lab.records('verdict'), lab.records('tier')
        for _ in range(2):
            lab.run()
            assert (lab.calls(), lab.records('running'), lab.records('verdict'), lab.records('tier')) == before
            assert lab.state()['last_run'] == previous
            assert lab.state()['fault']['reason'] == 'target could not be measured'
        faults = lab.records('fault')
        assert len(faults) == 1 and faults[0]['commit'] == head
    finally:
        unreadable.chmod(0o700)
    lab.run()
    assert lab.state()['last_run'] == head and lab.state()['fault'] is None
    assert len(lab.calls()) == len(before[0]) + 1 and lab.calls()[-1]['warm']
    assert lab.records('running')[-1]['commit'] == head
    assert 'fresh' not in lab.records('running')[-1]
    assert lab.verdict(head)['verdict'] == 'cleared'


def target_allocation(lab):
    allocated = runpy.run_path(str(SCRIPT))['allocated']
    target = lab.root / 'target'
    target.mkdir()
    nested = target / 'nested'
    nested.mkdir()
    data = nested / 'data'
    data.write_bytes(b'x' * 65536)
    (target / 'hardlink').hardlink_to(data)
    sparse = target / 'sparse'
    with sparse.open('wb') as out:
        out.truncate(2 ** 30)
    outside = lab.root / 'outside'
    outside.mkdir()
    (outside / 'fill').write_bytes(b'x' * 131072)
    link = target / 'link'
    link.symlink_to(outside, target_is_directory=True)
    broken = target / 'broken'
    broken.symlink_to(lab.root / 'missing')
    expected = sum(path.lstat().st_blocks * 512 for path in (target, nested, data, sparse, link, broken))
    assert allocated(target) == expected
    # A target symlink is never measured or removed by the cap.
    lab.env['AFTER_LANDING_GB'] = '1'
    (lab.root / 'follow').write_text('demo 1\n')
    lab.green()
    clone_target = lab.root / 'runner/demo/target'
    (clone_target / 'warm').unlink()
    clone_target.rmdir()
    clone_target.symlink_to(outside, target_is_directory=True)
    lab.land()
    lab.push()
    lab.run()
    # The existing git clean may replace the symlink; the cap leaves its destination alone.
    assert (outside / 'fill').stat().st_size == 131072
    assert 'fresh' not in lab.records('running')[-1]
    assert 'target: ' not in Path(lab.records('tier')[-1]['log']).read_text()


def no_tier(lab):
    (lab.work / 'scripts/after-landing.sh').unlink()
    one = lab.green()
    two, three = lab.land(), lab.land()
    lab.push()
    lab.run()
    assert [r['commit'] for r in lab.records('verdict')] == [one, two, three]
    assert all(r['verdict'] == 'cleared' for r in lab.records('verdict'))
    assert lab.state()['last_green'] == three and lab.calls() == [] and lab.posts() == []
    assert lab.records('tier')[-1]['ran_s'] == 0


def flake(lab):
    lab.green()
    head = lab.land(flaky=['t1'])
    lab.push()
    lab.run()
    verdict = lab.verdict(head)
    assert verdict['verdict'] == 'cleared' and verdict['flakes'] == ['t1']
    assert verdict['starved'] == [] and lab.records('tier')[-1]['starved'] == []
    assert lab.calls()[-1]['argv'][-2:] == ['--only', 't1']
    assert lab.records('tier')[-1]['state'] == 'green'
    assert lab.records('tier')[-1]['ran_s'] == 2.5
    assert lab.state()['reds'] == {} and lab.posts() == []


def starved_pass(lab):
    lab.green()
    before = len(lab.calls())
    head = lab.land(starved=['t5', 't5'])
    lab.push()
    lab.run()
    verdict = lab.verdict(head)
    assert verdict['verdict'] == 'cleared' and verdict['starved'] == ['t5'], verdict
    tier = lab.records('tier')[-1]
    assert tier['state'] == 'green' and tier['starved'] == ['t5'], tier
    assert len(lab.calls()) == before + 1
    # A part selects only its own starved passes; --only ignores the part.
    head = lab.land(starved=['p1.t5', 'p2.t6'])
    lab.push()
    for part, name in (('1/2', 'p1.t5'), ('2/2', 'p2.t6')):
        lab.run(part=part)
        tier = lab.records('tier', tier='demo.' + part.replace('/', 'of'))[-1]
        assert tier['state'] == 'green' and tier['starved'] == [name], tier


def starved_with_a_rerun(lab):
    lab.green()
    # t2 passes starved only at the older commit used by the bisect probe.
    old = lab.land(starved=['t2'])
    head = lab.land(reds=['t2'], flaky=['t1', 't6'], starved=['t6', 't5'])
    lab.push()
    lab.run()
    assert [call['head'] for call in lab.calls()[-3:]] == [head, head, old]
    assert lab.calls()[-2]['argv'][-6:] == ['--only', 't1', '--only', 't2', '--only', 't6']
    for tip in (old, head):
        verdict = lab.verdict(tip)
        assert verdict['starved'] == ['t5', 't6'], verdict
        assert verdict['flakes'] == ['t1', 't6'], verdict
    assert lab.verdict(old)['verdict'] == 'cleared'
