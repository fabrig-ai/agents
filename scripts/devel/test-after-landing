SCRIPT = Path(__file__).resolve().with_name('after-landing')
PYTHON = sys.executable
TIER = r'''#!/bin/sh
set -eu
mkdir -p target
printf warm > target/warm
head=$(git rev-parse HEAD)
count="$FIXTURE_COUNTS/$head"
n=0
if test -f "$count"; then n=$(cat "$count"); fi
n=$((n + 1))
printf '%s' "$n" > "$count"
if test -s tier/lacks; then
    while IFS= read -r name; do printf 'after-landing: lacks %s\n' "$name"; done < tier/lacks
    exit 3
fi
selected=$(mktemp "$FIXTURE_COUNTS/selected.XXXXXX")
trap 'rm -f "$selected"' EXIT
if test "$#" -gt 0; then
    while test "$#" -gt 0; do
        test "$1" = --only
        printf '%s\n' "$2" >> "$selected"
        shift 2
    done
else
    cat tier/reds tier/flaky | sort -u > "$selected"
fi
status=0
while IFS= read -r name; do
    test -n "$name" || continue
    if grep -Fxq "$name" tier/reds || { test "$n" -eq 1 && grep -Fxq "$name" tier/flaky; }; then
        printf 'after-landing: failed %s\n' "$name"
        printf 'failure text for %s\nstack detail\n' "$name"
        status=1
    fi
done < "$selected"
# Contract lines deliberately precede heavy's short tail.
i=0
while test "$i" -lt 70; do printf 'payload detail %s\n' "$i"; i=$((i + 1)); done
if test "$status" -ne 0; then
    printf 'failure text at end for excerpt, attempt %s\n' "$n"
fi
exit "$status"
'''
