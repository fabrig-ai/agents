    lab.push()
    lab.run()  # Queue even when there is no director yet.
    assert len(lab.state()['pending']) == 1
    env = dict(lab.env, AFTER_LANDING_RED_GRACE='0')
    (lab.root / 'post-refuse').touch()
    two = lab.land(reds=['t1'])
    lab.push()
    result = lab.run(director=True, env=env)
    assert 'warning: post failed' in result.stderr
    assert lab.state()['last_run'] == two
    assert len(lab.state()['pending']) == 1 and lab.posts() == []
    (lab.root / 'post-refuse').unlink()
    (lab.root / 'post-exit').write_text('3')
    lab.run(director=True, env=env)
    assert len(lab.posts()) == 1 and lab.state()['pending'] == []
    two = lab.land(reds=['t1', 't2'], landed=True)
    lab.push()
    lab.run(director=True)
    assert len(lab.state()['pending']) == 1
    lab.append(kind='watch', event='watching', target=two[:9])
    lab.run()  # A watcher claims the pending verdict even without a director argument.
    assert lab.state()['pending'] == [] and len(lab.posts()) == 1
    assert lab.verdict(tip)['landing_set'] == 'demo/m1'


def stale_watch(lab):
    tip = lab.land(reds=['t1'], landed=True)
    lab.push()
    old = datetime.now(timezone.utc) - timedelta(hours=3)
    lab.append(kind='watch', event='watching', target='demo/m1', time=old.isoformat())
    lab.run(director=True)
    assert len(lab.state()['pending']) == 1
    lab.run(director=True, env=dict(lab.env, AFTER_LANDING_RED_GRACE='0'))
    assert len(lab.posts()) == 1 and tip in lab.posts()[0]['body']


def history_reset(lab):
    first = lab.green()
    # A push around the landing tools is still the main tip.
    tip = lab.land(trailer=False)
    lab.push()
    lab.run()
    assert lab.verdict(tip)['verdict'] == 'cleared'
    lab.git(lab.work, 'checkout', '--quiet', '--orphan', 'replacement')
    replacement = lab.land(reds=['t1'])
    lab.git(lab.work, 'push', '--quiet', '--force', 'origin', 'HEAD:main')
    lab.run()
    assert lab.state()['last_run'] == replacement
    assert lab.state()['reds'] == {'t1': replacement}
    assert [r['commit'] for r in lab.records('verdict')] == [first, tip, replacement]



def trailers(lab):
    lab.green()
    ignored = lab.land(trailer=False, body='Gate-Tree: quoted example\nordinary body text')
    one = lab.land(reds=['t1'], body='Gate-Result: none (quoted example)\nordinary body text')
    docs = lab.land(docs=True)
    lab.push()
    lab.run()
    assert not any(r['commit'] == ignored for r in lab.records('verdict'))
    assert lab.verdict(one)['tests'] == ['t1'] and lab.verdict(one)['verdict'] == 'red'
    assert lab.verdict(docs)['verdict'] == 'cleared'
    assert lab.state()['reds'] == {'t1': one}


def feed_failure(lab):
    green = lab.green()
    tip = lab.land(reds=['t1'])
    lab.push()
    # Reject just the final summary append, after verdicts and the state write.
    shim = lab.root / 'bin/python3'
    shim.write_text(f'#!{PYTHON}\n' + """import json, os, subprocess, sys
from pathlib import Path
payload = sys.stdin.read()
if json.loads(payload)['event'] == 'tier':
    sys.exit(1)
sys.exit(subprocess.run([sys.executable, *sys.argv[1:]], input=payload, text=True).returncode)
""")
    shim.chmod(0o700)
    lab.run(status=1)
    assert lab.state()['last_run'] == green and lab.state()['reds'] == {}
    shim.unlink()
    lab.run()
    assert lab.state()['last_run'] == tip and lab.state()['reds'] == {'t1': tip}
    assert lab.records('tier')[-1]['commit'] == tip and lab.records('tier')[-1]['state'] == 'red'
    assert len(lab.state()['pending']) == 1


def main():
    os.umask(0o077)
    start = time.monotonic()
    cases = {'polls': polls, 'no-tier': no_tier, 'flake': flake, 'red': red, 'bisect': bisect,
             'already-red': already_red, 'fault': fault, 'unwatched-red': unwatched_red,
             'meets-landings': meets_landings, 'paused': paused, 'one-follower': one_follower, 'refusals': refusals,
             'multi-bisect': multi_bisect, 'limits': limits, 'nested-faults': nested_faults,
             'unnamed': unnamed, 'pending-delivery': pending_delivery, 'stale-watch': stale_watch,
             'history-reset': history_reset, 'trailers': trailers, 'feed-failure': feed_failure}
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--case', action='append', choices=cases)
    selected = parser.parse_args().case or list(cases)
    for number, name in enumerate(selected, 1):
        case_start = time.monotonic()
        with tempfile.TemporaryDirectory(prefix='after-landing-fixture-') as directory:
            lab = Lab(Path(directory))
            cases[name](lab)
        print(f'ok {number}: {name} ({time.monotonic() - case_start:.2f}s)', flush=True)
    print(f'completed {len(selected)} cases in {time.monotonic() - start:.2f}s', flush=True)


if __name__ == '__main__':
    main()
