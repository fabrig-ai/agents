def fault(lab):
    green = lab.green()
    hidden = lab.origin.with_name('hidden.git')
    lab.origin.rename(hidden)
    lab.run()
    since = lab.state()['fault']['since']
    hidden.rename(lab.origin)
    before = lab.records()
    lab.run()
    assert len(lab.calls()) == 1 and lab.state()['fault'] is None
    assert lab.records()[:-1] == before
    assert lab.records('recovered') == [lab.records()[-1]]
    assert lab.records()[-1]['commit'] == green and lab.records()[-1]['since'] == since
    lab.run()
    assert len(lab.records('recovered')) == 1
    tip = lab.land()
    lab.push()
    (lab.root / 'refuse').touch()
    lab.run()
    assert lab.records('fault')[-1]['reason'] == 'heavy: below the disk floor'
    assert lab.state()['last_run'] == green and len(lab.records('verdict')) == 1
    lab.run()
    assert len(lab.records('fault')) == 2
    env = dict(lab.env, AFTER_LANDING_FAULT_POST='0')
    (lab.root / 'post-refuse').write_text('2')
    assert 'warning: post failed' in lab.run(director=True, env=env).stderr
    assert not lab.state()['fault']['posted']
    (lab.root / 'post-refuse').unlink()
    (lab.root / 'post-exit').write_text('3')
    lab.run(director=True, env=env)
    lab.run(director=True, env=env)
    assert lab.state()['fault']['posted']
    assert len(lab.posts()) == 1 and 'fault for 0 minutes' in lab.posts()[0]['argv'][4]
    assert tip in lab.posts()[0]['body'] and 'log:' in lab.posts()[0]['body']
    (lab.root / 'refuse').unlink()
    lab.run()
    assert lab.state()['last_run'] == tip and lab.state()['fault'] is None
    lacks = lab.land(lacks=['Chromium', 'Forgejo'])
    lab.push()
    lab.run()
    assert lab.records('fault')[-1]['reason'] == 'lacks Chromium, Forgejo'
    assert lab.state()['last_run'] == tip and not any(r['commit'] == lacks for r in lab.records('verdict'))
    hidden = lab.origin.with_name('hidden.git')
    lab.origin.rename(hidden)
    lab.run()
    assert lab.records('fault')[-1]['reason'] == 'origin out of reach'
    assert lab.state()['last_run'] == tip and len(lab.records('fault')) == 4


def unwatched_red(lab):
    tip = lab.land(reds=['t1'], landed=True)
    lab.push()
    env = dict(lab.env, AFTER_LANDING_RED_GRACE='0')
    lab.run(director=True, env=env)
    assert not lab.posts() and len(lab.state()['pending']) == 1
    lab.run(director=True, env=env)
    lab.run(director=True, env=env)
    assert len(lab.posts()) == 1 and lab.state()['pending'] == []
    post = lab.posts()[0]
    assert post['argv'][0:4] == ['send', '--as', 'after-landing', 'director@x']
    assert f'red at {tip[:9]} (demo/m1): 1 tests' in post['argv'][4]
    assert 't1' in post['body'] and tip in post['body'] and 'failure text' in post['body']
    lab.append(kind='watch', event='watching', target='demo/m1')
    two = lab.land(reds=['t1', 't2'], landed=True)
    lab.push()
    lab.run(director=True, env=env)
    lab.run(director=True, env=env)
    assert lab.verdict(two)['tests'] == ['t2'] and len(lab.posts()) == 1
    assert lab.state()['pending'] == []
    three = lab.land(reds=['t1', 't2', 't3'])
    lab.push()
    lab.run(director=True, env=env)
    lab.append(kind='watch', event='watching', target=three[:7])
    lab.run(director=True, env=env)
    assert len(lab.posts()) == 1 and lab.state()['pending'] == []


def meets_landings(lab):
    env = dict(lab.env, LANDINGS_FEED=str(lab.root / 'feed.jsonl'), LANDINGS_POLL='.02')

    def land_set(label, commit):
        lab.append(event='started', set=label, token=label)
        lab.append(event='landed', set=label, token=label, repo='demo', commit=commit)
        lab.append(event='done', set=label, token=label)

    def wait(label, status):
        return call([PYTHON, '-I', '-B', SCRIPT.with_name('landings'), 'wait', '--cleared',
                     label, '--timeout', '0.5'], lab.root, env, status)

    one = lab.land()
    lab.push()
    land_set('demo/m1', one)
    assert one in wait('demo/m1', 3).stderr
    lab.run()
    assert one[:9] + ' cleared by run' in wait('demo/m1', 0).stdout
    two = lab.land(reds=['t1'])
    lab.push()
    land_set('demo/m2', two)
    lab.run()
    out = wait('demo/m2', 1).stdout
    assert two[:9] + ' red by run' in out and 't1' in out and 'failure text' in out, out
    runner_env = dict(lab.env, AFTER_LANDING_RED_GRACE='0')
    lab.run(director=True, env=runner_env)
    assert lab.posts() == [] and lab.state()['pending'] == []
    out = call([PYTHON, '-I', '-B', SCRIPT.with_name('landings')], lab.root, env).stdout
    assert f'demo: red at {two[:9]}' in out, out
    assert f'first red {two[:9]} (demo/m2); green at {one[:9]}' in out, out
    three = lab.land(reds=['t1', 't2'])
    lab.push()
    land_set('demo/m3', three)
    lab.run(director=True, env=runner_env)
    lab.run(director=True, env=runner_env)
    assert len(lab.posts()) == 1 and three[:9] in lab.posts()[0]['argv'][4]
    assert lab.verdict(three)['tests'] == ['t2']


