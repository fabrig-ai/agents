def limits(lab):
    tests = [f't{i:02}' for i in range(55)]
    tip = lab.land(reds=tests)
    lab.push()
    lab.run()
    verdict = lab.verdict(tip)
    assert verdict['tests'] == tests[:50] and verdict['tests_more'] == 5
    assert lab.records('tier')[-1]['reds'] == [dict(landing=tip, tests=tests[:50], tests_more=5)]
    assert len(lab.state()['reds']) == 55
    flake_tip = lab.land(reds=[], flaky=tests)
