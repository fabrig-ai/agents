def build_baseline(directory):
    lab = Lab(directory)
    # Cache the compiler's target probe too, once, before copying Cargo's cache.
    execute(lab.primary['temper'], ['cargo', 'metadata', '--format-version', '1'], lab.env)
    (directory / 'baseline.json').write_text(json.dumps(lab.base))


def run(case, directory, built):
    case(Lab(directory, trace_git=case.__name__ in GIT_TRACED, built=built))


