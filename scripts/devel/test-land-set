def land_failure(lab):
    lab.change('skein')
    output = lab.run(status=4, env=dict(FAIL_REPO='jig'))
    assert not lab.records()
    assert [r['repo'] for r in lab.records('gated')] == ['skein', 'smith', 'hearth']
    stopped = lab.records('stopped')[-1]
    assert stopped['repo'] == 'jig' and stopped['status'] == 4
    assert stopped['reason'] == 'land-set: jig: land --no-push failed (4)'
    assert 'jig: failed (4)' in output and 'temper: not reached' in output
    lab.untouched(ORDER)
    assert len(list((lab.tmp / 'land-set/worktrees').glob('*/jig'))) == 1
    assert not list((lab.tmp / 'land-set/worktrees').glob('*/hearth')), 'gated pin-only tree retained'
    assert (next((lab.tmp / 'land-set/worktrees').glob('*/jig')) / 'Cargo.lock').exists()
    assert (next((lab.tmp / 'land-set/worktrees').glob('*/jig')) / 'target/fixture').exists()
    assert str(next((lab.tmp / 'land-set/worktrees').glob('*/jig'))) in output
    lab.assert_released()
    # The failed pin-only worktree is inspectable; another set acquires immediately.
    output = lab.run(lab.spec({'temper': str(lab.work['temper'])}, 'retry/m1'))
    assert 'temper: skipped' in output
    # Interruption must reap the active child and close the real holder's pipes.
    lab.change('temper')
    ready, release = lab.root / 'ready', lab.root / 'release'
    env = dict(lab.env, PAUSE_REPO='temper', PAUSE_READY=str(ready), PAUSE_RELEASE=str(release))
    with (lab.root / 'signal.log').open('w') as out:
        proc = subprocess.Popen([PYTHON, '-I', str(SCRIPT),
                                 str(lab.spec({'temper': str(lab.work['temper'])}, 'interrupt/m1'))],
                                env=env, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
        try:
            until(ready.exists, proc)
            proc.send_signal(signal.SIGTERM)
            assert proc.wait(timeout=HANG) == 128 + signal.SIGTERM
        finally:
            if proc.poll() is None:
                proc.kill()
                proc.wait()
    lab.untouched(('temper',))
    lab.assert_released()
    # A failed gate left every main alone; retry gates the set from scratch.
    output = lab.run()
    assert all(f'{name}: landed ' in output for name in ORDER), output
    lab.verify()
    assert not list((lab.tmp / 'land-set/state').glob('*.json'))


