def proved(lab):
    """A prove gates the set without the lock; landing it then gates nothing again."""
    for name in ('skein', 'smith', 'temper'):
        lab.change(name)
    spec = lab.spec()
    output = lab.run(spec, prove=True)
    lab.untouched(ORDER)
    events = lab.records(None)
    assert [r['event'] for r in events] == ['proving'] + ['gated'] * 5 + ['proved'], events
    assert all(r['mode'] == 'prove' for r in events)
    assert all(r['result']['gate']['kind'] == 'ran' for r in events if r['event'] == 'gated')
    assert all(f'{name}: proved ' in output for name in ORDER), output
    assert 'land-set: proved; land it on ' in output, output
    assert not (lab.holder / 'set.lock').exists(), 'a prove took the set lock'
    assert not lab.worktrees(), 'pin-only worktree retained'
    proof = lab.proof()
    assert proof['repos'].keys() == set(ORDER) and proof['token'] == events[0]['token']
    assert {name for name, entry in proof['repos'].items() if entry['pin_only']} == {'hearth', 'jig'}
    output = lab.run(spec)
    heads = lab.verify()
    landing = lab.records(None)[len(events):]
    assert [r['event'] for r in landing] == ['waiting', 'started'] + ['gated'] * 5 + ['landed'] * 5 + ['done']
    assert landing[1]['proof'] == proof['token'] and 'mode' not in landing[1]
    gated = [r for r in landing if r['event'] == 'gated']
    # The pin-only repositories too: their repins took the proved commits.
    assert all(r['result']['gate']['kind'] == 'cached' for r in gated), gated
    assert {r['repo']: r['commit'] for r in gated} == {
        name: entry['commit'] for name, entry in proof['repos'].items()} == heads
    assert lab.proof() is None, 'a landed set kept its proof'
    lab.assert_released()


