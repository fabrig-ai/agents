#!/usr/bin/env python3
"""Eight disposable Git/Cargo fixtures for land-set; no project remotes."""
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import tomllib

os.umask(0o077)
SCRIPT = Path(__file__).resolve().with_name('land-set')
ORDER = ('skein', 'smith', 'hearth', 'jig', 'temper')
UPSTREAM = dict(skein=(), smith=('skein',), hearth=('skein',),
                jig=('skein', 'smith'), temper=('skein', 'smith', 'jig'))
PYTHON = sys.executable
HEAVY = '''#!{python}
import os, sys
os.execvp(sys.argv[1], sys.argv[1:])
'''
LAND = '''#!{python}
import os, subprocess, sys, time
from pathlib import Path
assert sys.argv[1:] == []
def git(*args):
    return subprocess.check_output(['git', *args]).decode().strip()
name = Path(git('remote', 'get-url', 'origin')).name.removesuffix('.git')
with open(os.environ['LAND_TRACE'], 'a') as out:
    out.write(name + '\\n')
if os.environ.get('PAUSE_REPO') == name:
    Path(os.environ['PAUSE_READY']).touch()
    until = time.monotonic() + 15
    while not Path(os.environ['PAUSE_RELEASE']).exists():
        assert time.monotonic() < until, 'fixture pause timed out'
        time.sleep(.02)
if os.environ.get('FAIL_REPO') == name:
    sys.exit(4)
git('rebase', 'origin/main')
message = git('log', '-1', '--format=%B') + '\\n\\nFixture-Landed: yes'
git('commit', '--amend', '-m', message)
git('push', 'origin', 'HEAD:main')
# A build directory must disappear with a successful pin-only worktree.
Path('target').mkdir(exist_ok=True)
Path('target/fixture').touch()
'''


def execute(root, argv, env, check=True):
    result = subprocess.run(argv, cwd=root, env=env, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if check and result.returncode:
        raise AssertionError(f'{argv}: {result.returncode}\n{result.stdout}')
    return result


def until(predicate, proc):
    deadline = time.monotonic() + 15
    while not predicate():
        assert proc.poll() is None and time.monotonic() < deadline, 'fixture did not become ready'
        time.sleep(.02)


class Lab:
    def __init__(self, root):
        self.root = root
        self.primary, self.work, self.origin, self.base = {}, {}, {}, {}
        self.bin = root / 'bin'
        self.bin.mkdir()
        self.tmp = root / 'tmp'
        self.tmp.mkdir()
        self.holder = self.tmp / 'holder'
        self.trace = root / 'land.trace'
        self.trace.touch()
        self.git_trace = root / 'git.trace'
        self.git_trace.touch()
        self.env = dict(os.environ, PATH=str(self.bin) + ':' + os.environ['PATH'],
                        DEV_ROOT=str(root / 'primary'), DEV_TMP=str(self.tmp),
                        HEAVY_RECOVERY_FIXTURE='1', LAND_SET_FIXTURE_DIR=str(self.holder),
                        LAND_TRACE=str(self.trace), GIT_TRACE_FILE=str(self.git_trace),
                        CARGO_HOME=str(root / 'cargo'), CARGO_NET_OFFLINE='false',
                        GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@invalid',
                        GIT_ALLOW_PROTOCOL='file', CARGO_NET_GIT_FETCH_WITH_CLI='true')
        for key in ('RUSTC_WRAPPER', 'RUSTC_WORKSPACE_WRAPPER', 'CARGO_TARGET_DIR'):
            self.env.pop(key, None)
        # Cargo can fetch only the fixture's file:// sources; no registry dependencies exist.
        for name, body in [('heavy', HEAVY), ('land', LAND)]:
            path = self.bin / name
            path.write_text(body.format(python=PYTHON))
            path.chmod(0o700)
        git = self.bin / 'git'
        git.write_text('#!' + PYTHON + '\nimport os, sys, json\n'
                       "with open(os.environ['GIT_TRACE_FILE'], 'a') as out:\n"
                       "    out.write(json.dumps(sys.argv[1:]) + '\\n')\n"
                       'os.execv(' + repr(shutil.which('git')) + ', sys.argv)\n')
        git.chmod(0o700)
        for name in ORDER:
            path = root / 'primary' / name
            path.mkdir(parents=True)
            self.primary[name] = path
            self.git(path, 'init', '-b', 'main')
            crates = [name + '-a'] + (['skein-b'] if name == 'skein' else [])
            (path / 'Cargo.toml').write_text('[workspace]\nresolver="2"\nmembers=' + json.dumps(crates) + '\n')
            (path / '.gitignore').write_text('/target/\n')
            (path / 'shared.txt').write_text('base\n')
            for crate in crates:
                sub = path / crate
                (sub / 'src').mkdir(parents=True)
                manifest = f'[package]\nname="{crate}"\nversion="0.1.0"\nedition="2021"\n[dependencies]\n'
                for up in UPSTREAM[name]:
                    manifest += f'{up}-a={{git=' + json.dumps(self.origin[up].as_uri()) + '}\n'
                if crate == 'skein-a':
                    manifest += 'skein-b={path="../skein-b"}\n'
                (sub / 'Cargo.toml').write_text(manifest)
                (sub / 'src/lib.rs').write_text('pub fn value() -> u8 { 1 }\n')
            execute(path, ['heavy', 'cargo', 'generate-lockfile'], self.env)
            self.git(path, 'add', '.')
            self.git(path, 'commit', '-m', 'baseline')
            self.base[name] = self.git(path, 'rev-parse', 'HEAD')
            bare = root / 'origins' / (name + '.git')
            bare.parent.mkdir(exist_ok=True)
            execute(root, ['git', 'clone', '--bare', str(path), str(bare)], self.env)
            self.origin[name] = bare
            self.git(path, 'remote', 'add', 'origin', bare.as_uri())
            self.git(path, 'fetch', 'origin')
            work = root / 'work' / name
            self.git(path, 'worktree', 'add', '-b', 'milestone', str(work), 'HEAD')
            self.work[name] = work
        self.git_trace.write_text('')

    def git(self, path, *args):
        return execute(path, ['git', *args], self.env).stdout.strip()

    def change(self, name, filename='change.txt', text='milestone\n', path=None):
        path = path or self.work[name]
        (path / filename).write_text(text)
        self.git(path, 'add', filename)
        self.git(path, 'commit', '-m', 'change ' + filename)

    def spec(self, names=None, label='fixture/m1'):
        names = names if names is not None else dict(skein=str(self.work['skein']),
            smith=str(self.work['smith']), hearth='pin-only', jig='pin-only', temper=str(self.work['temper']))
        path = self.root / (label.replace('/', '-') + '.json')
        path.write_text(json.dumps(dict(set=label, repos=names)))
        return path

    def run(self, spec=None, status=0, env=None):
        result = execute(self.root, [PYTHON, '-I', str(SCRIPT), str(spec or self.spec())],
                         dict(self.env, **(env or {})), check=False)
        assert result.returncode == status, result.stdout
        return result.stdout

    def heads(self):
        return {name: self.git(path, 'rev-parse', 'main') for name, path in self.origin.items()}

    def verify(self, names=ORDER):
        heads = self.heads()
        for name in names:
            lock = tomllib.loads(self.git(self.origin[name], 'show', 'main:Cargo.lock'))
            for up in UPSTREAM[name]:
                revisions = {p['source'].rsplit('#', 1)[1] for p in lock['package']
                             if p.get('source', '').split('#')[0].endswith('/' + up + '.git')}
                assert revisions == {heads[up]}, (name, up, revisions, heads[up])
            assert 'Fixture-Landed: yes' in self.git(self.origin[name], 'log', '-1', '--format=%B')
        return heads

    def records(self):
        return [json.loads(line) for line in (self.holder / 'feed.jsonl').read_text().splitlines()]

    def untouched(self, names):
        heads = self.heads()
        assert all(heads[name] == self.base[name] for name in names), heads

    def no_fetch(self):
        commands = [json.loads(line) for line in self.git_trace.read_text().splitlines()]
        assert not any('fetch' in command or 'push' in command for command in commands), commands

    def assert_released(self):
        # A second real holder must grant promptly, without the completed client's pipes.
        holder = SCRIPT.parent / 'recovery-v1/land-turn.py'
        with subprocess.Popen([PYTHON, '-I', str(holder), 'holder', str(self.holder), 'a' * 32,
                               'set', 'fixture', str(self.holder)], stdin=subprocess.PIPE,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as proc:
            import select
            try:
                assert select.select([proc.stdout], [], [], 2)[0], 'lock was not released'
                assert json.loads(proc.stdout.readline())['token'] == 'a' * 32
            finally:
                proc.stdin.close()
                proc.wait(timeout=2)


def success(lab):
    for name in ('skein', 'smith', 'temper'):
        lab.change(name)
    output = lab.run()
    heads = lab.verify()
    records = lab.records()
    assert [r['repo'] for r in records] == list(ORDER)
    assert len({r['token'] for r in records}) == 1
    assert all(r['commit'] == heads[r['repo']] and r['set'] == 'fixture/m1' for r in records)
    assert all('landed ' + heads[name] in output for name in ORDER)
    assert not any((lab.tmp / 'land-set').glob('*/*')), 'pin-only worktree retained'
    assert (lab.holder / 'feed.jsonl').stat().st_mode & 0o777 == 0o600
    assert lab.holder.stat().st_mode & 0o777 == 0o700
    lab.assert_released()


def lock_conflict(lab):
    lab.change('skein')
    # Separate lock comments force a conflict at the same context without invalid TOML.
    lock = lab.work['smith'] / 'Cargo.lock'
    lab.change('smith', 'Cargo.lock', '# milestone\n' + lock.read_text())
    primary = lab.primary['smith']
    lab.change('smith', 'Cargo.lock', '# moved main\n' + (primary / 'Cargo.lock').read_text(), primary)
    lab.git(primary, 'push', 'origin', 'HEAD:main')
    output = lab.run()
    assert 'CONFLICT' in output, output
    lab.verify()
    commands = [json.loads(line) for line in lab.git_trace.read_text().splitlines()]
    assert ['checkout', '--ours', '--', 'Cargo.lock'] in commands
    assert ['rebase', '--abort'] not in commands


def other_conflict(lab):
    lab.change('skein')
    lab.change('smith', 'shared.txt', 'branch\n')
    lab.change('smith', 'shared.txt', 'main\n', lab.primary['smith'])
    lab.git(lab.primary['smith'], 'push', 'origin', 'HEAD:main')
    lab.base['smith'] = lab.git(lab.origin['smith'], 'rev-parse', 'main')
    output = lab.run(status=3)
    lab.untouched(('smith', 'hearth', 'jig', 'temper'))
    assert lab.heads()['skein'] != lab.base['skein']
    assert 'smith: failed (3)' in output
    assert all(f'{name}: not reached' in output for name in ('hearth', 'jig', 'temper'))
    assert not Path(lab.git(lab.work['smith'], 'rev-parse', '--git-path', 'rebase-merge')).exists()
    lab.assert_released()


def land_failure(lab):
    lab.change('skein')
    output = lab.run(status=4, env=dict(FAIL_REPO='jig'))
    assert [r['repo'] for r in lab.records()] == ['skein', 'smith', 'hearth']
    assert 'jig: failed (4)' in output and 'temper: not reached' in output
    lab.untouched(('jig', 'temper'))
    assert len(list((lab.tmp / 'land-set').glob('*/jig'))) == 1
    lab.assert_released()
    # The failed pin-only worktree is inspectable; another set acquires immediately.
    output = lab.run(lab.spec({'temper': str(lab.work['temper'])}, 'retry/m1'))
    assert 'temper: skipped' in output
    # Interruption must reap the active child and close the real holder's pipes.
    lab.change('temper')
    ready, release = lab.root / 'ready', lab.root / 'release'
    env = dict(lab.env, PAUSE_REPO='temper', PAUSE_READY=str(ready), PAUSE_RELEASE=str(release))
    with (lab.root / 'signal.log').open('w') as out:
        proc = subprocess.Popen([PYTHON, '-I', str(SCRIPT), str(lab.spec({'temper': str(lab.work['temper'])}))],
                                env=env, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
        try:
            until(ready.exists, proc)
            proc.send_signal(signal.SIGTERM)
            assert proc.wait(timeout=5) == 128 + signal.SIGTERM
        finally:
            if proc.poll() is None:
                proc.kill()
                proc.wait()
    lab.untouched(('temper',))
    lab.assert_released()


def closure(lab):
    output = lab.run(lab.spec({'smith': str(lab.work['smith'])}), status=2)
    assert 'jig' in output and 'temper' in output
    assert not lab.holder.exists()
    lab.no_fetch()
    # All validation refusals must precede the holder and fetch too.
    for names, reason in [({'temper': 'relative'}, 'absolute'),
                          ({'temper': str(lab.primary['temper'])}, 'branch'),
                          ({'temper': str(lab.work['smith'])}, 'origin')]:
        output = lab.run(lab.spec(names), status=2)
        assert reason in output, output
    (lab.work['temper'] / 'dirty').touch()
    assert 'clean' in lab.run(lab.spec({'temper': str(lab.work['temper'])}), status=2)
    assert not lab.holder.exists()
    lab.no_fetch()


def concurrent(lab):
    first = lab.work['temper']
    second = lab.root / 'second-temper'
    lab.git(lab.primary['temper'], 'worktree', 'add', '-b', 'second', str(second), 'HEAD')
    lab.change('temper', 'first.txt', 'first\n')
    lab.change('temper', 'second.txt', 'second\n', second)
    a = lab.spec({'temper': str(first)}, 'first/m1')
    b = lab.spec({'temper': str(second)}, 'second/m1')
    ready, release = lab.root / 'ready', lab.root / 'release'
    env = dict(lab.env, PAUSE_REPO='temper', PAUSE_READY=str(ready), PAUSE_RELEASE=str(release))
    with (lab.root / 'a.log').open('w+') as aout, (lab.root / 'b.log').open('w+') as bout:
        pa = subprocess.Popen([PYTHON, '-I', str(SCRIPT), str(a)], env=env,
                              stdin=subprocess.DEVNULL, stdout=aout, stderr=subprocess.STDOUT)
        pb = None
        try:
            deadline = time.monotonic() + 10
            while not ready.exists():
                assert pa.poll() is None and time.monotonic() < deadline
                time.sleep(.02)
            pb = subprocess.Popen([PYTHON, '-I', str(SCRIPT), str(b)], env=lab.env,
                                  stdin=subprocess.DEVNULL, stdout=bout, stderr=subprocess.STDOUT)
            deadline = time.monotonic() + 10
            while 'waiting for the set lock' not in (lab.root / 'b.log').read_text():
                assert pb.poll() is None and time.monotonic() < deadline
                time.sleep(.02)
            time.sleep(.2)
            assert pb.poll() is None
            assert lab.trace.read_text().splitlines() == ['temper']
            release.touch()
            assert pa.wait(timeout=15) == 0, (lab.root / 'a.log').read_text()
            assert pb.wait(timeout=15) == 0, (lab.root / 'b.log').read_text()
            assert [r['set'] for r in lab.records()] == ['first/m1', 'second/m1']
            assert lab.git(lab.origin['temper'], 'show', 'main:first.txt') == 'first'
            assert lab.git(lab.origin['temper'], 'show', 'main:second.txt') == 'second'
        finally:
            release.touch()
            for proc in (pa, pb):
                if proc and proc.poll() is None:
                    proc.terminate()
                    proc.wait(timeout=3)


def refusal(lab):
    lab.change('skein')
    lab.holder.mkdir()
    (lab.holder / 'set.lock').mkdir()  # The real holder refuses a nonregular lock.
    lab.run(status=5)
    lab.no_fetch()
    lab.untouched(ORDER)
    env = dict(lab.env)
    env.pop('LAND_SET_FIXTURE_DIR')
    result = execute(lab.root, [PYTHON, '-I', str(SCRIPT), str(lab.spec())], env, check=False)
    assert result.returncode == 5 and 'holder path' in result.stdout, result.stdout
    lab.no_fetch()
    # A fixture cannot escape the isolated tmp root.
    lab.run(status=5, env=dict(LAND_SET_FIXTURE_DIR=str(lab.tmp)))
    lab.no_fetch()
    # A disposable source kit injects protocol faults without changing the real holder.
    kit = lab.root / 'kit'
    (kit / 'recovery-v1').mkdir(parents=True)
    script = kit / 'land-set'
    shutil.copyfile(SCRIPT, script)
    holder = kit / 'recovery-v1/land-turn.py'
    for response in ('', 'not-json\n', '{}\n', 'x' * 513 + '\n'):
        holder.write_text('import sys\nsys.stdout.write(' + repr(response) + ')\nsys.stdout.flush()\n')
        result = execute(lab.root, [PYTHON, '-I', str(script), str(lab.spec())], lab.env, check=False)
        assert result.returncode == 5, result.stdout
        lab.no_fetch()
    # Losing a granted transport lets the active repository finish, then stops the set.
    ready, release = lab.root / 'ready', lab.root / 'release'
    holder.write_text('import json, os, sys, time\nfrom pathlib import Path\n'
                      "print(json.dumps(dict(token=sys.argv[3], repository='set', holder=sys.argv[5], wait_s=0)), flush=True)\n"
                      "while not Path(os.environ['PAUSE_READY']).exists(): time.sleep(.02)\n")
    env = dict(lab.env, PAUSE_REPO='skein', PAUSE_READY=str(ready), PAUSE_RELEASE=str(release))
    with (lab.root / 'lost.log').open('w') as out:
        proc = subprocess.Popen([PYTHON, '-I', str(script), str(lab.spec())], env=env,
                                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
        try:
            until(ready.exists, proc)
            time.sleep(.3)
            release.touch()
            assert proc.wait(timeout=10) == 5
        finally:
            if proc.poll() is None:
                proc.kill()
                proc.wait()
    output = (lab.root / 'lost.log').read_text()
    assert 'skein: landed ' in output, output
    assert all(f'{name}: not reached' in output for name in ORDER[1:]), output
    lab.untouched(ORDER[1:])
    assert [r['repo'] for r in lab.records()] == ['skein']


def skipped(lab):
    names = {name: str(lab.work[name]) if name == 'skein' else 'pin-only' for name in ORDER}
    output = lab.run(lab.spec(names))
    assert all(f'{name}: skipped' in output for name in ORDER), output
    assert not lab.trace.read_text()
    assert not (lab.holder / 'feed.jsonl').exists()
    assert not any((lab.tmp / 'land-set').glob('*/*'))
    lab.untouched(ORDER)


def main():
    start = time.monotonic()
    with tempfile.TemporaryDirectory(prefix='land-set-fixture-') as directory:
        root = Path(directory)
        for number, case in enumerate((success, lock_conflict, other_conflict, land_failure,
                                       closure, concurrent, refusal, skipped), 1):
            path = root / str(number)
            path.mkdir()
            case_start = time.monotonic()
            case(Lab(path))
            print(f'ok {number}: {case.__name__} ({time.monotonic() - case_start:.2f}s)', flush=True)
    print(f'completed 8 cases in {time.monotonic() - start:.2f}s', flush=True)


if __name__ == '__main__':
    main()
