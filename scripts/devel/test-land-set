def interrupted_during_feed(lab):
    ready, release = lab.root / 'ready', lab.root / 'release'
    wrapper = lab.bin / 'python3'
    # No repository setup repeated for the active, successful and failed append.
    for kind, status in (('started', 143), ('done', 0), ('stopped', 4)):
        ready.unlink(missing_ok=True)
        release.unlink(missing_ok=True)
        wrapper.write_text('#!' + PYTHON + '\nimport json, subprocess, sys, time\nfrom pathlib import Path\n'
            'data = sys.stdin.buffer.read()\n'
            "if json.loads(data)['event'] == " + repr(kind) + ':\n'
            '    Path(' + repr(str(ready)) + ').touch()\n'
            '    while not Path(' + repr(str(release)) + ').exists(): time.sleep(.02)\n'
            'sys.exit(subprocess.run([' + repr(PYTHON) + '] + sys.argv[1:], input=data).returncode)\n')
        wrapper.chmod(0o700)
        env = dict(lab.env)
        if kind == 'stopped':
            lab.change('temper')
            env['FAIL_REPO'] = 'temper'
        with (lab.root / 'feed-interrupt.log').open('w') as out:
            proc = subprocess.Popen([PYTHON, '-I', str(SCRIPT), str(lab.spec())], env=env,
                                    stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
            try:
                until(ready.exists, proc)
                lab.assert_held()
                proc.send_signal(signal.SIGTERM)
                if kind != 'started':
                    time.sleep(.1)
                    assert proc.poll() is None, 'terminal append was interrupted'
                    release.touch()
                assert proc.wait(timeout=HANG) == status, (lab.root / 'feed-interrupt.log').read_text()
            finally:
                release.touch()
                if proc.poll() is None:
                    proc.kill()
                    proc.wait()
        lab.untouched(ORDER)
        lab.no_staging()
        if kind == 'started':
            assert not lab.trace.read_text(), 'interrupted feed continued into the gates'
            assert lab.records('stopped')[-1]['reason'] == 'land-set: interrupted'
        else:
            record = lab.records(None)[-1]
            assert record['event'] == kind
            if status:
                assert record['status'] == status
        lab.assert_released()


