def main():
    start = time.monotonic()
    with tempfile.TemporaryDirectory(prefix='land-set-fixture-') as directory:
        root = Path(directory)
        cases = (staging_cargo, rerun, advanced_main, recorded_commit_refusal, unchanged_downstream,
                 partial_set, split_source, success, moved_between_phases, moved_during_pushes,
                 moved_earlier_in_second_round, regate_failure_resume, catch_up,
                 pushed_then_failed, outside_snapshot, moved_gate_base,
                 interrupted_with_staging, interrupted_during_feed, interrupted_during_cleanup,
                 feed_failure, cleanup_warning,
                 moving_bound, kit_refusal, lock_conflict,
                 other_conflict, land_failure,
                 closure, concurrent, refusal, skipped)
        if len(sys.argv) > 1:
            cases = tuple(case for case in cases if case.__name__ in sys.argv[1:])
            assert cases, 'no cases selected'
        for number, case in enumerate(cases, 1):
            path = root / str(number)
            path.mkdir()
            case_start = time.monotonic()
            case(Lab(path))
            print(f'ok {number}: {case.__name__} ({time.monotonic() - case_start:.2f}s)', flush=True)
    print(f'completed {len(cases)} cases in {time.monotonic() - start:.2f}s', flush=True)


if __name__ == '__main__':
    main()
