def execute(root, argv, env, check=True):
    result = subprocess.run(argv, cwd=root, env=env, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if check and result.returncode:
        raise AssertionError(f'{argv}: {result.returncode}\n{result.stdout}')
    return result


def until(predicate, proc):
    deadline = time.monotonic() + HANG
    while not predicate():
        assert proc.poll() is None and time.monotonic() < deadline, 'fixture did not become ready'
        time.sleep(.02)


class Lab:
    def __init__(self, root, trace_git=False, built=None):
        if built is not None:
            # Copy bytes, never hardlink mutable refs, indexes, objects or caches.
            shutil.copytree(built, root, dirs_exist_ok=True)
            configs = list(root.glob('cargo/git/checkouts/*/*/.git/config'))
            for name in ORDER:
                primary, work = root / 'primary' / name, root / 'work' / name
                # Only Git's administrative paths change; committed bytes do not.
                configs.extend((primary / '.git/config', root / 'origins' / (name + '.git') / 'config'))
                (work / '.git').write_text(f'gitdir: {primary}/.git/worktrees/{name}\n')
                (primary / '.git/worktrees' / name / 'gitdir').write_text(str(work / '.git') + '\n')
            for config in configs:
                config.write_text(config.read_text().replace(built.as_uri(), root.as_uri())
                                  .replace(str(built), str(root)))
        self.root = root
        self.trace_git = trace_git
        self.primary, self.work, self.origin, self.base = {}, {}, {}, {}
        self.bin = root / 'bin'
        self.bin.mkdir(exist_ok=True)
        self.tmp = root / 'tmp'
        self.tmp.mkdir(exist_ok=True)
        self.holder = self.tmp / 'holder'
        self.trace = root / 'land.trace'
        self.trace.touch()
        self.git_trace = root / 'git.trace'
        self.git_trace.touch()
        self.env = dict(os.environ, PATH=str(self.bin) + ':' + os.environ['PATH'],
                        DEV_ROOT=str(root / 'primary'), DEV_TMP=str(self.tmp),
                        LAND_TIDY='',
                        HEAVY_RECOVERY_FIXTURE='1', LAND_SET_FIXTURE_DIR=str(self.holder),
                        LAND_TRACE=str(self.trace), GIT_TRACE_FILE=str(self.git_trace),
                        CARGO_HOME=str(root / 'cargo'), CARGO_NET_OFFLINE='false',
                        GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@invalid',
                        GIT_ALLOW_PROTOCOL='file', CARGO_NET_GIT_FETCH_WITH_CLI='true')
        for key in ('RUSTC_WRAPPER', 'RUSTC_WORKSPACE_WRAPPER', 'CARGO_TARGET_DIR'):
            self.env.pop(key, None)
        # Keep fixture maintenance out of every Git subprocess, Cargo's fetches too.
        count = int(self.env.get('GIT_CONFIG_COUNT', '0'))
        settings = (('maintenance.auto', 'false'), ('gc.auto', '0'),
                    ('fetch.autoMaintenance', 'false'), ('receive.autogc', 'false'),
                    ('url.' + (root / 'origins').as_uri() + '/.insteadOf', SOURCE))
        for offset, (key, value) in enumerate(settings):
            self.env[f'GIT_CONFIG_KEY_{count + offset}'] = key
            self.env[f'GIT_CONFIG_VALUE_{count + offset}'] = value
        self.env['GIT_CONFIG_COUNT'] = str(count + len(settings))
        # Metadata/update do not create target, so Cargo otherwise cannot save
        # .rustc_info.json and repeats both compiler probes on the next call.
        target = root / 'cargo-target'
        target.mkdir(exist_ok=True)
        self.env['CARGO_TARGET_DIR'] = str(target)
        # Resolve rustup proxies once, in this same /tmp toolchain context.
        # Real Cargo and rustc still run; repeated proxy startup buys nothing.
        toolchain = root / 'toolchain.json'
        if built is None:
            tools = {}
            for tool in ('cargo', 'rustc'):
                executable = shutil.which(tool)
                if Path(executable).resolve().name == 'rustup':
                    executable = execute(root, ['rustup', 'which', tool], self.env).stdout.strip()
                tools[tool] = executable
            toolchain.write_text(json.dumps(tools))
        else:
            tools = json.loads(toolchain.read_text())
        self.env.setdefault('RUSTC', tools['rustc'])
        if Path(shutil.which('cargo')).resolve().name == 'rustup':
            # Fixture wrappers still come first; call selected Cargo without
            # paying for another proxy/exec shell on every update or metadata.
            self.env['PATH'] = (str(self.bin) + ':' + str(Path(tools['cargo']).parent)
                                + ':' + os.environ['PATH'])
        # Cargo can fetch only the fixture's file:// sources; no registry dependencies exist.
        for name, body in [('heavy', HEAVY), ('land', LAND)]:
            path = self.bin / name
            path.write_text(body.format(python=PYTHON, hang=HANG))
            path.chmod(0o700)
        if built is not None:
            self.base = json.loads((root / 'baseline.json').read_text())
        for name in ORDER:
            path = root / 'primary' / name
            if built is not None:
                self.primary[name] = path
                self.origin[name] = root / 'origins' / (name + '.git')
                self.work[name] = root / 'work' / name
                continue
            path.mkdir(parents=True)
            self.primary[name] = path
            self.git(path, 'init', '-b', 'main')
            crates = [name + '-a'] + (['skein-b'] if name == 'skein' else [])
            if name in ('skein', 'smith'):
                crates.append(name + '-extra')
            (path / 'Cargo.toml').write_text('[workspace]\nresolver="2"\nmembers=' + json.dumps(crates) + '\n')
            (path / '.gitignore').write_text('/target/\n')
            (path / 'shared.txt').write_text('base\n')
            for crate in crates:
                sub = path / crate
                (sub / 'src').mkdir(parents=True)
                manifest = f'[package]\nname="{crate}"\nversion="0.1.0"\nedition="2021"\n[dependencies]\n'
                for up in UPSTREAM[name]:
                    manifest += f'{up}-a={{git=' + json.dumps(SOURCE + up + '.git') + '}\n'
                    if name == 'temper' and up in ('skein', 'smith'):
                        manifest += f'{up}-extra={{git=' + json.dumps(SOURCE + up + '.git') + '}\n'
                if crate == 'skein-a':
                    manifest += 'skein-b={path="../skein-b"}\n'
                (sub / 'Cargo.toml').write_text(manifest)
                (sub / 'src/lib.rs').write_text('pub fn value() -> u8 { 1 }\n')
            execute(path, ['heavy', 'cargo', 'generate-lockfile'], self.env)
            self.git(path, 'add', '.')
            self.git(path, 'commit', '-m', 'baseline')
            self.base[name] = self.git(path, 'rev-parse', 'HEAD')
            bare = root / 'origins' / (name + '.git')
            bare.parent.mkdir(exist_ok=True)
            execute(root, ['git', 'clone', '--bare', str(path), str(bare)], self.env)
            self.origin[name] = bare
            self.git(path, 'remote', 'add', 'origin', bare.as_uri())
            self.git(path, 'fetch', 'origin')
            work = root / 'work' / name
            self.git(path, 'worktree', 'add', '-b', 'milestone', str(work), 'HEAD')
            self.work[name] = work
        if trace_git:
            # One record per call, in one append: the argument count, then each argument, NUL-terminated.
            git = self.bin / 'git'
            git.write_text('#!/bin/sh\nprintf \'%s\\0\' "$#" "$@" >> "$GIT_TRACE_FILE" || exit 125\n'
                           'exec ' + shlex.quote(shutil.which('git')) + ' "$@"\n')
            git.chmod(0o700)

    def git(self, path, *args):
        return execute(path, ['git', *args], self.env).stdout.strip()

    def change(self, name, filename='change.txt', text='milestone\n', path=None):
        path = path or self.work[name]
        (path / filename).write_text(text)
        self.git(path, 'add', filename)
        self.git(path, 'commit', '-m', 'change ' + filename)

    def spec(self, names=None, label='fixture/m1'):
        names = names if names is not None else dict(skein=str(self.work['skein']),
            smith=str(self.work['smith']), hearth='pin-only', jig='pin-only', temper=str(self.work['temper']))
        path = self.root / (label.replace('/', '-') + '.json')
        path.write_text(json.dumps(dict(set=label, repos=names)))
        return path

    def run(self, spec=None, status=0, env=None, prove=False):
        result = execute(self.root, [PYTHON, '-I', str(SCRIPT), *(['--prove'] if prove else []),
                                     str(spec or self.spec())],
                         dict(self.env, **(env or {})), check=False)
        assert result.returncode == status, result.stdout
        self.no_staging()
        return result.stdout

    def heads(self):
        return {name: self.git(path, 'rev-parse', 'main') for name, path in self.origin.items()}

    def verify(self, names=ORDER):
        heads = self.heads()
        for name in names:
            lock = tomllib.loads(self.git(self.origin[name], 'show', 'main:Cargo.lock'))
            for up in UPSTREAM[name]:
                revisions = {p['source'].rsplit('#', 1)[1] for p in lock['package']
                             if p.get('source', '').split('#')[0].endswith('/' + up + '.git')}
                assert revisions == {heads[up]}, (name, up, revisions, heads[up])
            assert 'Fixture-Landed: yes' in self.git(self.origin[name], 'log', '-1', '--format=%B')
        return heads

    def records(self, event='landed'):
        records = [json.loads(line) for line in (self.holder / 'feed.jsonl').read_text().splitlines()]
        return [r for r in records if event is None or r['event'] == event]

    def worktrees(self):
        # land-set/worktrees/SET/NAME, and any other directory beside state/
        # and proofs/, which hold land-set's own files.
        return [*(self.tmp / 'land-set/worktrees').glob('*/*'),
                *(p for p in (self.tmp / 'land-set').glob('*/*')
                  if p.parent.name not in ('state', 'proofs', 'worktrees'))]

    def proof(self):
        proofs = list((self.tmp / 'land-set/proofs').glob('*.json'))
        assert len(proofs) <= 1, proofs
        return json.loads(proofs[0].read_text()) if proofs else None

    def no_staging(self):
        for path in self.origin.values():
            assert not self.git(path, 'for-each-ref', 'refs/heads/land-set'), path


    def untouched(self, names):
        heads = self.heads()
        assert all(heads[name] == self.base[name] for name in names), heads

    def git_commands(self):
        assert self.trace_git, 'case reads the git log without GIT_TRACED'
        fields = self.git_trace.read_bytes().decode().split('\0')
        assert fields.pop() == '', 'truncated git log'
        commands = []
        while fields:
            count = int(fields.pop(0))
            commands.append(fields[:count])
            del fields[:count]
            assert len(commands[-1]) == count, 'truncated git log'
        return commands

    def no_fetch(self):
        commands = self.git_commands()
        assert not any('fetch' in command or 'push' in command for command in commands), commands

    def assert_released(self):
        # A second real holder must grant, without the completed client's pipes.
        holder = SCRIPT.with_name('land-turn.py')
        with subprocess.Popen([PYTHON, '-I', str(holder), 'holder', str(self.holder), 'a' * 32,
                               'set', 'fixture', str(self.holder)], stdin=subprocess.PIPE,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as proc:
            import select
            try:
                assert select.select([proc.stdout], [], [], HANG)[0], 'lock was not released'
                assert json.loads(proc.stdout.readline())['token'] == 'a' * 32
            finally:
                proc.stdin.close()
                proc.wait(timeout=HANG)

    def assert_held(self):
        with (self.holder / 'set.lock').open() as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return
            raise AssertionError('lock released before active work finished')


def tidy_hooks(lab):
    lab.change('skein')
    stub = lab.root / 'tidy stub'
    calls = lab.root / 'tidy.calls'
    stub.write_text('#!/bin/sh\nprintf "%s\\n" "$*" >> ' + shlex.quote(str(calls)) + '\n')
    stub.chmod(0o700)
    lab.run(env=dict(LAND_TIDY=shlex.quote(str(stub))))
    deadline = time.monotonic() + HANG
    while not calls.exists() or not calls.read_text().endswith('\n'):
        assert time.monotonic() < deadline, 'tidy never started'
        time.sleep(.01)
    assert calls.read_text().splitlines() == [' '.join(ORDER)], calls.read_text()
    for name in ('skein', 'smith', 'temper'):
        branch = lab.git(lab.work[name], 'symbolic-ref', '--short', 'HEAD')
        assert lab.git(lab.work[name], 'config', f'branch.{branch}.landed') == lab.heads()[name]
        assert not (lab.work[name] / 'target').exists()
    for name in ('hearth', 'jig'):
        result = execute(lab.primary[name], ['git', 'config', '--get-regexp', r'branch\..*\.landed'], lab.env, check=False)
        assert result.returncode == 1, result.stdout


def tidy_hooks_partial(lab):
    lab.change('skein')
    calls = lab.root / 'tidy.calls'
    command = 'printf "%s\\n" > ' + shlex.quote(str(calls))
    lab.run(status=4, env=dict(LAND_TIDY=command, FAIL_PUSH_REPO='temper'))
    deadline = time.monotonic() + HANG
    while not calls.exists() or not calls.read_text():
        assert time.monotonic() < deadline, 'tidy never started'
        time.sleep(.01)
    assert calls.read_text().splitlines() == list(ORDER[:-1]), calls.read_text()
    assert (lab.work['temper'] / 'target').is_dir()
    result = execute(lab.work['temper'], ['git', 'config', '--get-regexp', r'branch\..*\.landed'], lab.env, check=False)
    assert result.returncode == 1, result.stdout


def staging_cargo(lab):
    """A fresh Cargo cache sees the candidate only through its staging ref."""
    lab.change('skein', 'skein-a/src/lib.rs', 'pub fn value() -> u8 { 42 }\n')
    candidate = lab.git(lab.work['skein'], 'rev-parse', 'HEAD')
    ref = 'refs/heads/land-set/proof/skein'
    lab.git(lab.work['skein'], 'push', 'origin', candidate + ':' + ref)
    assert lab.git(lab.origin['skein'], 'for-each-ref', '--contains', candidate,
                   '--format=%(refname)') == ref
    env = dict(lab.env, CARGO_HOME=str(lab.root / 'fresh-cargo'))
    downstream = lab.work['smith']
    print(execute(downstream, ['cargo', '--version'], env).stdout.strip(), flush=True)
    execute(downstream, ['cargo', 'update', '--precise', candidate, '-p', 'skein-a'], env)
    lock = tomllib.loads((downstream / 'Cargo.lock').read_text())
    pins = {p['source'].rsplit('#', 1)[1] for p in lock['package'] if 'source' in p}
    assert pins == {candidate}, pins
    execute(downstream, ['cargo', 'build', '--locked'], env)
    lab.untouched(ORDER)
    lab.git(lab.work['skein'], 'push', 'origin', ':' + ref)


def success(lab):
    (lab.bin / 'heavy').write_text('#!/bin/sh\nexit 93\n')
    for name in ('skein', 'smith', 'temper'):
        lab.change(name)
    output = lab.run()
    heads = lab.verify()
    events = lab.records(None)
    assert [r['event'] for r in events] == ['waiting', 'started'] + ['gated'] * 5 + ['landed'] * 5 + ['done']
    assert all({'time', 'set', 'event', 'host', 'token'} <= r.keys() for r in events)
    records = lab.records()
    assert {r['repo']: r['commit'] for r in lab.records('gated')} == heads
    assert [r['repo'] for r in records] == list(ORDER)
    assert len({r['token'] for r in records}) == 1
    assert all(r['commit'] == heads[r['repo']] and r['set'] == 'fixture/m1' for r in records)
    assert all('landed ' + heads[name] in output for name in ORDER)
    assert not lab.worktrees(), 'pin-only worktree retained'
    assert (lab.holder / 'feed.jsonl').stat().st_mode & 0o777 == 0o600
    assert lab.holder.stat().st_mode & 0o777 == 0o700
    lab.assert_released()


def partial_set(lab):
    # Upstreams outside this set must be caught up to their current mains,
    # including packages reachable through jig's dependency edges.
    for name in ('skein', 'smith'):
