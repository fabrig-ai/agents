def interrupted_with_staging(lab):
    lab.change('skein')
    ready, release = lab.root / 'ready', lab.root / 'release'
    done, pidfile = lab.root / 'descendant.done', lab.root / 'descendant.pid'
    entered, checked = lab.root / 'descendant.entered', lab.root / 'descendant.checked'
    for signum, ignore in ((signal.SIGINT, False), (signal.SIGTERM, False), (signal.SIGTERM, True)):
        for path in (ready, done, pidfile, entered, checked):
            path.unlink(missing_ok=True)
        env = dict(lab.env, DESCENDANT_REPO='smith', PAUSE_READY=str(ready),
                   DESCENDANT_DONE=str(done), DESCENDANT_PID=str(pidfile),
                   DESCENDANT_ENTERED=str(entered), DESCENDANT_CHECKED=str(checked))
        if ignore:
            env['DESCENDANT_IGNORE'] = '1'
        with (lab.root / 'interrupt.log').open('w') as out:
            proc = subprocess.Popen([PYTHON, '-I', str(SCRIPT), str(lab.spec())], env=env,
                                    stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                                    start_new_session=True)
            try:
                until(ready.exists, proc)
                assert lab.git(lab.origin['skein'], 'for-each-ref', 'refs/heads/land-set')
                os.killpg(proc.pid, signum)
                if not ignore:
                    until(entered.exists, proc)
                    lab.assert_held()
                    os.killpg(proc.pid, signum)  # A second signal must not abandon the group wait.
                    checked.touch()
                assert proc.wait(timeout=HANG) == 128 + signum
                if not ignore:
                    assert done.read_text() == str(signum)
                try:
                    os.kill(int(pidfile.read_text()), 0)
                except ProcessLookupError:
                    pass
                else:
                    raise AssertionError('descendant survived lock release')
            finally:
                if proc.poll() is None:
                    proc.kill()
                    proc.wait()
        lab.assert_released()
    lab.untouched(ORDER)
    lab.no_staging()
    stopped = lab.records('stopped')[-1]
    assert stopped['repo'] == 'smith' and stopped['status'] == 128 + signal.SIGTERM
    assert stopped['reason'] == 'land-set: interrupted'
    lab.assert_released()


