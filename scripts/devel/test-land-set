#!/usr/bin/env python3
"""Disposable Git/Cargo fixtures for land-set; no project remotes."""
import json
import fcntl
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import tomllib

os.umask(0o077)
SCRIPT = Path(__file__).resolve().with_name('land-set')
ORDER = ('skein', 'smith', 'hearth', 'jig', 'temper')
UPSTREAM = dict(skein=(), smith=('skein',), hearth=('skein',),
                jig=('skein', 'smith'), temper=('skein', 'smith', 'jig'))
PYTHON = sys.executable
HEAVY = '''#!{python}
import os, sys
os.execvp(sys.argv[1], sys.argv[1:])
'''
LAND = r'''#!{python}
import os, signal, subprocess, sys, time
from pathlib import Path
args = sys.argv[1:]
if args == ['--no-push', '--docs']:
    print('land: --no-push cannot be combined with --docs or --local', file=sys.stderr)
    sys.exit(2)
assert args in ([], ['--no-push'])
phase = 'gate' if args else 'push'
def git(*args):
    return subprocess.check_output(['git', *args]).decode().strip()
name = Path(git('remote', 'get-url', 'origin')).name.removesuffix('.git')
with open(os.environ['LAND_TRACE'], 'a') as out:
    out.write(name + '\n')
if os.environ.get('DESCENDANT_REPO') == name:
    child = subprocess.Popen([sys.executable, '-c', """import os, signal, sys, time
from pathlib import Path
def stopped(signum, frame):
    time.sleep(.25)
    Path(os.environ['DESCENDANT_DONE']).write_text(str(signum))
    sys.exit(0)
for sig in (signal.SIGINT, signal.SIGTERM):
    signal.signal(sig, signal.SIG_IGN if os.environ.get('DESCENDANT_IGNORE') else stopped)
Path(os.environ['DESCENDANT_PID']).write_text(str(os.getpid()))
while True: time.sleep(.02)
"""])
    while not Path(os.environ['DESCENDANT_PID']).exists(): time.sleep(.02)
    Path(os.environ['PAUSE_READY']).touch()
    while True: time.sleep(.02)
if os.environ.get('PAUSE_REPO') == name:
    Path(os.environ['PAUSE_READY']).touch()
    until = time.monotonic() + 15
    while not Path(os.environ['PAUSE_RELEASE']).exists():
        assert time.monotonic() < until, 'fixture pause timed out'
        time.sleep(.02)
# Failed builds leave targets too; keep only the failing repository's tree.
Path('target').mkdir(exist_ok=True)
Path('target/fixture').touch()
if (os.environ.get('FAIL_REPO') == name or
    (phase == 'push' and os.environ.get('FAIL_PUSH_REPO') == name) or
    (phase == 'gate' and os.environ.get('FAIL_REGATE_REPO') == name and
     (Path(os.environ['DEV_TMP']) / 'moved').exists())):
    sys.exit(4)
point = phase + ':' + name
marker = Path(os.environ['DEV_TMP']) / 'moved'
sequence = os.environ.get('MOVE_SEQUENCE', '').split(',') if os.environ.get('MOVE_SEQUENCE') else []
count = int(marker.read_text() or '0') if marker.exists() else 0
def move():
    if os.environ.get('MOVE_AT') != point or not (count < len(sequence) or not marker.exists() or os.environ.get('MOVE_ALWAYS')):
        return
    target = sequence[count] if sequence else os.environ['MOVE_REPO']
    primary = str(Path(os.environ['DEV_ROOT']) / target)
    git('-C', primary, 'fetch', 'origin')
    git('-C', primary, 'reset', '--hard', 'origin/main')
    race = Path(primary) / 'race.txt'
    race.write_text(race.read_text() + 'again\n' if race.exists() else 'race\n')
    git('-C', primary, 'add', 'race.txt')
    git('-C', primary, 'commit', '-m', 'concurrent main')
    git('-C', primary, 'push', 'origin', 'HEAD:main')
    marker.write_text(str(count + 1))
if not os.environ.get('MOVE_AFTER_REBASE'):
    move()
git('fetch', 'origin')
git('rebase', 'origin/main')
if os.environ.get('MOVE_AFTER_REBASE'):
    move()
message = git('log', '-1', '--format=%B')
updated = subprocess.check_output(['git', 'interpret-trailers', '--if-exists', 'replace',
                                   '--trailer', 'Fixture-Landed: yes'], input=message.encode()).decode().strip()
if updated != message:
    git('commit', '--amend', '-m', updated)
if phase == 'push':
    git('push', 'origin', 'HEAD:main')
    if os.environ.get('FAIL_AFTER_PUSH_REPO') == name:
        sys.exit(5)
'''


def execute(root, argv, env, check=True):
    result = subprocess.run(argv, cwd=root, env=env, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if check and result.returncode:
        raise AssertionError(f'{argv}: {result.returncode}\n{result.stdout}')
    return result


def until(predicate, proc):
    deadline = time.monotonic() + 15
    while not predicate():
        assert proc.poll() is None and time.monotonic() < deadline, 'fixture did not become ready'
        time.sleep(.02)


class Lab:
    def __init__(self, root):
        self.root = root
        self.primary, self.work, self.origin, self.base = {}, {}, {}, {}
        self.bin = root / 'bin'
        self.bin.mkdir()
        self.tmp = root / 'tmp'
        self.tmp.mkdir()
        self.holder = self.tmp / 'holder'
        self.trace = root / 'land.trace'
        self.trace.touch()
        self.git_trace = root / 'git.trace'
        self.git_trace.touch()
        self.env = dict(os.environ, PATH=str(self.bin) + ':' + os.environ['PATH'],
                        DEV_ROOT=str(root / 'primary'), DEV_TMP=str(self.tmp),
                        HEAVY_RECOVERY_FIXTURE='1', LAND_SET_FIXTURE_DIR=str(self.holder),
                        LAND_TRACE=str(self.trace), GIT_TRACE_FILE=str(self.git_trace),
                        CARGO_HOME=str(root / 'cargo'), CARGO_NET_OFFLINE='false',
                        GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@invalid',
                        GIT_ALLOW_PROTOCOL='file', CARGO_NET_GIT_FETCH_WITH_CLI='true')
        for key in ('RUSTC_WRAPPER', 'RUSTC_WORKSPACE_WRAPPER', 'CARGO_TARGET_DIR'):
            self.env.pop(key, None)
        # Cargo can fetch only the fixture's file:// sources; no registry dependencies exist.
        for name, body in [('heavy', HEAVY), ('land', LAND)]:
            path = self.bin / name
            path.write_text(body.format(python=PYTHON))
            path.chmod(0o700)
        git = self.bin / 'git'
        git.write_text('#!' + PYTHON + '\nimport os, sys, json\n'
                       "with open(os.environ['GIT_TRACE_FILE'], 'a') as out:\n"
                       "    out.write(json.dumps(sys.argv[1:]) + '\\n')\n"
                       'os.execv(' + repr(shutil.which('git')) + ', sys.argv)\n')
        git.chmod(0o700)
        for name in ORDER:
            path = root / 'primary' / name
            path.mkdir(parents=True)
            self.primary[name] = path
            self.git(path, 'init', '-b', 'main')
            crates = [name + '-a'] + (['skein-b'] if name == 'skein' else [])
            if name in ('skein', 'smith'):
                crates.append(name + '-extra')
            (path / 'Cargo.toml').write_text('[workspace]\nresolver="2"\nmembers=' + json.dumps(crates) + '\n')
            (path / '.gitignore').write_text('/target/\n')
            (path / 'shared.txt').write_text('base\n')
            for crate in crates:
                sub = path / crate
                (sub / 'src').mkdir(parents=True)
                manifest = f'[package]\nname="{crate}"\nversion="0.1.0"\nedition="2021"\n[dependencies]\n'
                for up in UPSTREAM[name]:
                    manifest += f'{up}-a={{git=' + json.dumps(self.origin[up].as_uri()) + '}\n'
                    if name == 'temper' and up in ('skein', 'smith'):
                        manifest += f'{up}-extra={{git=' + json.dumps(self.origin[up].as_uri()) + '}\n'
                if crate == 'skein-a':
                    manifest += 'skein-b={path="../skein-b"}\n'
                (sub / 'Cargo.toml').write_text(manifest)
                (sub / 'src/lib.rs').write_text('pub fn value() -> u8 { 1 }\n')
            execute(path, ['heavy', 'cargo', 'generate-lockfile'], self.env)
            self.git(path, 'add', '.')
            self.git(path, 'commit', '-m', 'baseline')
            self.base[name] = self.git(path, 'rev-parse', 'HEAD')
            bare = root / 'origins' / (name + '.git')
            bare.parent.mkdir(exist_ok=True)
            execute(root, ['git', 'clone', '--bare', str(path), str(bare)], self.env)
            self.origin[name] = bare
            self.git(path, 'remote', 'add', 'origin', bare.as_uri())
            self.git(path, 'fetch', 'origin')
            work = root / 'work' / name
            self.git(path, 'worktree', 'add', '-b', 'milestone', str(work), 'HEAD')
            self.work[name] = work
        self.git_trace.write_text('')

    def git(self, path, *args):
        return execute(path, ['git', *args], self.env).stdout.strip()

    def change(self, name, filename='change.txt', text='milestone\n', path=None):
        path = path or self.work[name]
        (path / filename).write_text(text)
        self.git(path, 'add', filename)
        self.git(path, 'commit', '-m', 'change ' + filename)

    def spec(self, names=None, label='fixture/m1'):
        names = names if names is not None else dict(skein=str(self.work['skein']),
            smith=str(self.work['smith']), hearth='pin-only', jig='pin-only', temper=str(self.work['temper']))
        path = self.root / (label.replace('/', '-') + '.json')
        path.write_text(json.dumps(dict(set=label, repos=names)))
        return path

    def run(self, spec=None, status=0, env=None):
        result = execute(self.root, [PYTHON, '-I', str(SCRIPT), str(spec or self.spec())],
                         dict(self.env, **(env or {})), check=False)
        assert result.returncode == status, result.stdout
        self.no_staging()
        return result.stdout

    def heads(self):
        return {name: self.git(path, 'rev-parse', 'main') for name, path in self.origin.items()}

    def verify(self, names=ORDER):
        heads = self.heads()
        for name in names:
            lock = tomllib.loads(self.git(self.origin[name], 'show', 'main:Cargo.lock'))
            for up in UPSTREAM[name]:
                revisions = {p['source'].rsplit('#', 1)[1] for p in lock['package']
                             if p.get('source', '').split('#')[0].endswith('/' + up + '.git')}
                assert revisions == {heads[up]}, (name, up, revisions, heads[up])
            assert 'Fixture-Landed: yes' in self.git(self.origin[name], 'log', '-1', '--format=%B')
        return heads

    def records(self, event='landed'):
        records = [json.loads(line) for line in (self.holder / 'feed.jsonl').read_text().splitlines()]
        return [r for r in records if event is None or r['event'] == event]

    def no_staging(self):
        for path in self.origin.values():
            assert not self.git(path, 'for-each-ref', 'refs/heads/land-set'), path


    def untouched(self, names):
        heads = self.heads()
        assert all(heads[name] == self.base[name] for name in names), heads

    def no_fetch(self):
        commands = [json.loads(line) for line in self.git_trace.read_text().splitlines()]
        assert not any('fetch' in command or 'push' in command for command in commands), commands

    def assert_released(self):
        # A second real holder must grant promptly, without the completed client's pipes.
        holder = SCRIPT.parent / 'recovery-v1/land-turn.py'
        with subprocess.Popen([PYTHON, '-I', str(holder), 'holder', str(self.holder), 'a' * 32,
                               'set', 'fixture', str(self.holder)], stdin=subprocess.PIPE,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as proc:
            import select
            try:
                assert select.select([proc.stdout], [], [], 2)[0], 'lock was not released'
                assert json.loads(proc.stdout.readline())['token'] == 'a' * 32
            finally:
                proc.stdin.close()
                proc.wait(timeout=2)

    def assert_held(self):
        with (self.holder / 'set.lock').open() as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                return
            raise AssertionError('lock released before active work finished')


def staging_cargo(lab):
    """A fresh Cargo cache sees the candidate only through its staging ref."""
    lab.change('skein', 'skein-a/src/lib.rs', 'pub fn value() -> u8 { 42 }\n')
    candidate = lab.git(lab.work['skein'], 'rev-parse', 'HEAD')
    ref = 'refs/heads/land-set/proof/skein'
    lab.git(lab.work['skein'], 'push', 'origin', candidate + ':' + ref)
    assert lab.git(lab.origin['skein'], 'for-each-ref', '--contains', candidate,
                   '--format=%(refname)') == ref
    env = dict(lab.env, CARGO_HOME=str(lab.root / 'fresh-cargo'))
    downstream = lab.work['smith']
    print(execute(downstream, ['cargo', '--version'], env).stdout.strip(), flush=True)
    execute(downstream, ['cargo', 'update', '--precise', candidate, '-p', 'skein-a'], env)
    lock = tomllib.loads((downstream / 'Cargo.lock').read_text())
    pins = {p['source'].rsplit('#', 1)[1] for p in lock['package'] if 'source' in p}
    assert pins == {candidate}, pins
    execute(downstream, ['cargo', 'build', '--locked'], env)
    lab.untouched(ORDER)
    lab.git(lab.work['skein'], 'push', 'origin', ':' + ref)


def success(lab):
    (lab.bin / 'heavy').write_text('#!/bin/sh\nexit 93\n')
    for name in ('skein', 'smith', 'temper'):
        lab.change(name)
    output = lab.run()
    heads = lab.verify()
    events = lab.records(None)
    assert [r['event'] for r in events] == ['waiting', 'started'] + ['gated'] * 5 + ['landed'] * 5 + ['done']
    assert all({'time', 'set', 'event', 'host', 'token'} <= r.keys() for r in events)
    records = lab.records()
    assert {r['repo']: r['commit'] for r in lab.records('gated')} == heads
    assert [r['repo'] for r in records] == list(ORDER)
    assert len({r['token'] for r in records}) == 1
    assert all(r['commit'] == heads[r['repo']] and r['set'] == 'fixture/m1' for r in records)
    assert all('landed ' + heads[name] in output for name in ORDER)
    assert not any((lab.tmp / 'land-set').glob('*/*')), 'pin-only worktree retained'
    assert (lab.holder / 'feed.jsonl').stat().st_mode & 0o777 == 0o600
    assert lab.holder.stat().st_mode & 0o777 == 0o700
    lab.assert_released()


def partial_set(lab):
    # Upstreams outside this set must be caught up to their current mains,
    # including packages reachable through jig's dependency edges.
    for name in ('skein', 'smith'):
        lab.change(name, path=lab.primary[name])
        lab.git(lab.primary[name], 'push', 'origin', 'HEAD:main')
    lab.change('jig')
    output = lab.run(lab.spec({'jig': str(lab.work['jig']), 'temper': 'pin-only'}))
    heads = lab.heads()
    assert 'jig: landed ' in output and 'temper: landed ' in output, output
    assert [r['repo'] for r in lab.records()] == ['jig', 'temper']
    for name in ('jig', 'temper'):
        lock = tomllib.loads(lab.git(lab.origin[name], 'show', 'main:Cargo.lock'))
        for up in UPSTREAM[name]:
            revisions = {p['source'].rsplit('#', 1)[1] for p in lock['package']
                         if p.get('source', '').split('#')[0].endswith('/' + up + '.git')}
            expected = heads[up]
            assert revisions == {expected}, (name, up, revisions, expected)


def rerun(lab, advance=False):
    lab.change('jig')
    spec = lab.spec({'jig': str(lab.work['jig']), 'temper': 'pin-only'}, 'resume/m1')
    output = lab.run(spec, status=4, env=dict(FAIL_PUSH_REPO='temper'))
    jig = lab.heads()['jig']
    assert jig != lab.base['jig'] and lab.heads()['temper'] == lab.base['temper']
    assert 'jig: landed ' + jig in output and 'temper: failed (4)' in output, output
    assert len(list((lab.tmp / 'land-set').glob('*/temper'))) == 1
    states = list((lab.tmp / 'land-set/state').glob('*.json'))
    assert len(states) == 1
    state = json.loads(states[0].read_text())
    assert state == {'set': 'resume/m1', 'landed': {'jig': jig}}, state
    assert states[0].stat().st_mode & 0o777 == 0o600
    if advance:
        # A later main must not replace the commit recorded for this set.
        lab.git(lab.primary['jig'], 'reset', '--hard', jig)
        lab.change('jig', 'later.txt', path=lab.primary['jig'])
        lab.git(lab.primary['jig'], 'push', 'origin', 'HEAD:main')
    before = lab.heads()['jig']
    output = lab.run(spec)
    assert lab.heads()['jig'] == before, 'rerun landed jig again'
    assert 'jig: recorded landed ' + jig in output, output
    assert 'temper: landed ' in output, output
    lock = tomllib.loads(lab.git(lab.origin['temper'], 'show', 'main:Cargo.lock'))
    pins = {p['source'].rsplit('#', 1)[1] for p in lock['package']
            if p.get('source', '').split('#')[0].endswith('/jig.git')}
    assert pins == {jig}, pins
    assert not states[0].exists(), 'completed set retained its records'
    assert lab.trace.read_text().splitlines() == ['jig', 'temper', 'jig', 'temper', 'temper', 'temper']
    assert [r['repo'] for r in lab.records()] == ['jig', 'temper']
    lab.assert_released()


def advanced_main(lab):
    rerun(lab, advance=True)


def recorded_commit_refusal(lab):
    lab.change('jig')
    spec = lab.spec({'jig': str(lab.work['jig']), 'temper': 'pin-only'})
    lab.run(spec, status=4, env=dict(FAIL_PUSH_REPO='temper'))
    jig = lab.heads()['jig']
    lab.git(lab.origin['jig'], 'update-ref', 'refs/heads/main', lab.base['jig'])
    output = lab.run(spec, status=1)
    assert f'jig: recorded commit {jig} is not on origin/main' in output, output
    assert 'temper: not reached' in output, output
    assert lab.trace.read_text().splitlines() == ['jig', 'temper', 'jig', 'temper']
    assert list((lab.tmp / 'land-set/state').glob('*.json')), 'failure lost records'
    lab.assert_released()


def unchanged_downstream(lab):
    lab.change('jig')
    spec = lab.spec({'jig': str(lab.work['jig']), 'temper': 'pin-only'})
    lab.run(spec, status=4, env=dict(FAIL_PUSH_REPO='temper'))
    # Another landing has already made the same pin. Resuming this set must
    # explicitly refuse the downstream with no change, keeping its records.
    kept = next((lab.tmp / 'land-set').glob('*/temper'))
    lab.change('temper', 'Cargo.lock', (kept / 'Cargo.lock').read_text(), lab.primary['temper'])
    lab.git(lab.primary['temper'], 'push', 'origin', 'HEAD:main')
    output = lab.run(spec, status=1)
    assert 'temper: no change after an upstream landed or gated; set is incomplete' in output, output
    assert 'temper: failed (1)' in output, output
    assert lab.trace.read_text().splitlines() == ['jig', 'temper', 'jig', 'temper']
    assert list((lab.tmp / 'land-set/state').glob('*.json')), 'failure lost records'
    lab.assert_released()


def split_source(lab):
    # The invariant covers every git identity, including sources outside ORDER,
    # both on entry and after metadata has had a chance to rewrite the lock.
    identity = 'git+https://example.invalid/' + 'x' * 210 + '/other.git'
    revisions = ('a' * 40, 'b' * 40)
    records = ''.join(f'\n[[package]]\nname="other-{i}"\nversion="0.1.0"\n'
                      f'source="{identity}#{revision}"\n'
                      for i, revision in enumerate(revisions))
    lock = lab.work['temper'] / 'Cargo.lock'
    lab.change('temper', 'Cargo.lock', lock.read_text() + records)
    spec = lab.spec({'temper': str(lab.work['temper'])})
    for after_metadata in (False, True):
        if after_metadata:
            lab.git(lab.work['temper'], 'reset', '--hard', lab.base['temper'])
            (lab.bin / 'cargo').write_text('#!' + PYTHON + '\n'
                'import subprocess, sys\nfrom pathlib import Path\n'
                'status = subprocess.run([' + repr(shutil.which('cargo')) + '] + sys.argv[1:]).returncode\n'
                "if status == 0 and sys.argv[1:2] == ['metadata']:\n"
                "    lock = Path('Cargo.lock')\n"
                '    lock.write_text(lock.read_text() + ' + repr(records) + ')\n'
                'sys.exit(status)\n')
            (lab.bin / 'cargo').chmod(0o700)
        output = lab.run(spec, status=1)
        assert 'multiple revisions' in output and identity in output, output
        assert all(revision in output for revision in revisions), output
        reason = next(line for line in output.splitlines() if line.startswith('land-set: temper: multiple'))
        assert lab.records('stopped')[-1]['reason'] == reason[:200]
        assert len(lab.records('stopped')[-1]['reason']) == 200
        assert not lab.trace.read_text(), 'invalid lock reached land'
        lab.untouched(ORDER)
        lab.assert_released()


def lock_conflict(lab):
    lab.change('skein')
    # Separate lock comments force a conflict at the same context without invalid TOML.
    lock = lab.work['smith'] / 'Cargo.lock'
    lab.change('smith', 'Cargo.lock', '# milestone\n' + lock.read_text())
    primary = lab.primary['smith']
    lab.change('smith', 'Cargo.lock', '# moved main\n' + (primary / 'Cargo.lock').read_text(), primary)
    lab.git(primary, 'push', 'origin', 'HEAD:main')
    output = lab.run()
    assert 'CONFLICT' in output, output
    lab.verify()
    commands = [json.loads(line) for line in lab.git_trace.read_text().splitlines()]
    assert ['checkout', '--ours', '--', 'Cargo.lock'] in commands
    assert ['rebase', '--abort'] not in commands


def other_conflict(lab):
    lab.change('skein')
    lab.change('smith', 'shared.txt', 'branch\n')
    lab.change('smith', 'shared.txt', 'main\n', lab.primary['smith'])
    lab.git(lab.primary['smith'], 'push', 'origin', 'HEAD:main')
    lab.base['smith'] = lab.git(lab.origin['smith'], 'rev-parse', 'main')
    output = lab.run(status=3)
    lab.untouched(('smith', 'hearth', 'jig', 'temper'))
    assert lab.heads()['skein'] == lab.base['skein']
    assert 'smith: failed (3)' in output
    assert all(f'{name}: not reached' in output for name in ('hearth', 'jig', 'temper'))
    assert not Path(lab.git(lab.work['smith'], 'rev-parse', '--git-path', 'rebase-merge')).exists()
    lab.assert_released()


def land_failure(lab):
    lab.change('skein')
    output = lab.run(status=4, env=dict(FAIL_REPO='jig'))
    assert not lab.records()
    assert [r['repo'] for r in lab.records('gated')] == ['skein', 'smith', 'hearth']
    stopped = lab.records('stopped')[-1]
    assert stopped['repo'] == 'jig' and stopped['status'] == 4
    assert stopped['reason'] == 'land-set: jig: land --no-push failed (4)'
    assert 'jig: failed (4)' in output and 'temper: not reached' in output
    lab.untouched(ORDER)
    assert len(list((lab.tmp / 'land-set').glob('*/jig'))) == 1
    assert not list((lab.tmp / 'land-set').glob('*/hearth')), 'gated pin-only tree retained'
    assert (next((lab.tmp / 'land-set').glob('*/jig')) / 'Cargo.lock').exists()
    assert (next((lab.tmp / 'land-set').glob('*/jig')) / 'target/fixture').exists()
    assert str(next((lab.tmp / 'land-set').glob('*/jig'))) in output
    lab.assert_released()
    # The failed pin-only worktree is inspectable; another set acquires immediately.
    output = lab.run(lab.spec({'temper': str(lab.work['temper'])}, 'retry/m1'))
    assert 'temper: skipped' in output
    # Interruption must reap the active child and close the real holder's pipes.
    lab.change('temper')
    ready, release = lab.root / 'ready', lab.root / 'release'
    env = dict(lab.env, PAUSE_REPO='temper', PAUSE_READY=str(ready), PAUSE_RELEASE=str(release))
    with (lab.root / 'signal.log').open('w') as out:
        proc = subprocess.Popen([PYTHON, '-I', str(SCRIPT),
                                 str(lab.spec({'temper': str(lab.work['temper'])}, 'interrupt/m1'))],
                                env=env, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
        try:
            until(ready.exists, proc)
            proc.send_signal(signal.SIGTERM)
            assert proc.wait(timeout=5) == 128 + signal.SIGTERM
        finally:
            if proc.poll() is None:
                proc.kill()
                proc.wait()
    lab.untouched(('temper',))
    lab.assert_released()
    # A failed gate left every main alone; retry gates the set from scratch.
    output = lab.run()
    assert all(f'{name}: landed ' in output for name in ORDER), output
    lab.verify()
    assert not list((lab.tmp / 'land-set/state').glob('*.json'))


