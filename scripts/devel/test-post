#!/usr/bin/env bash
# Test post in two isolated workspaces with fake SSH and Claude sessions.
set -Eeuo pipefail
# Fixture readiness and waiter lifetime only; timeout-zero cases remain subjects.
export HUNG_POST_S=300
umask 077
trap 'echo "test-post: failed at line $LINENO" >&2' ERR
started=$(date +%s.%N)
kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
root=$(mktemp -d)
failed=0 checks=0
pids=()
stop_children() {
    local pid
    for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
    for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null || true; done
}
cleanup() {
    stop_children
    rm -rf "$root"
}
trap cleanup EXIT
expect() {
    local what=$1 output=$2 want
    shift 2
    checks=$((checks + 1))
    for want in "$@"; do
        if [[ $output != *"$want"* ]]; then
            echo "FAIL $what: no \"$want\" in:"
            printf '    %s\n' "${output//$'\n'/$'\n'    }"
            failed=1
        fi
    done
}
capture() {
    local code=0 output
    output=$("$@" 2>&1) || code=$?
    printf 'status=%s\n%s\n' "$code" "$output"
}
poll_until() {
    local deadline=$((${EPOCHREALTIME//[.,]/} + HUNG_POST_S * 1000000))
    until "$@"; do
        ((${EPOCHREALTIME//[.,]/} < deadline)) || return 1
        sleep 0.01
    done
}
# Each part has its own workspaces, stubs and sessions under its own $t.
fixture() {
    t=$1
    export HOME=$t/home DEV_ROOT=$t/a POST_NAME=sender POST_RESUME_CHECK=0 POST_STOP_WAIT=0 POST_RETRY_DELAYS="0 0 0"
    # Waiters poll and stop checks retry quickly; post's defaults are 2 s and 1 s.
    export POST_POLL=0.02 POST_STOP_STEP=0.02
    export POST_TOOL=$kit/post FIXTURE=$t
    export RECORDS=$t/records
    mkdir -p "$RECORDS/missions"
    unset SSH_ORIGINAL_COMMAND
    mkdir -p "$HOME/.local/bin" "$t"/{a,b}/tmp/post "$t/session cwd"
    export PATH=$HOME/.local/bin:$PATH
    printf 'a local\nb fake-b\n' >"$t/a/tmp/post/machines"
    printf '# Other machine\nb local\na fake-a\n' >"$t/b/tmp/post/machines"
    echo '[]' >"$t/sessions.json"
    : >"$t/resumes"
    cat >"$HOME/.local/bin/ssh" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
[[ $# == 14 && $1 == -i && $2 == "$HOME/.ssh/post_ed25519" && $3 == -o && $4 == IdentitiesOnly=yes &&
    $5 == -o && $6 == BatchMode=yes && $7 == -o && $8 == ConnectTimeout=20 &&
    $9 == -o && ${10} == ControlMaster=no && ${11} == -o && ${12} == ControlPath=none ]]
case ${13} in
    fake-b) destination=b; from=a ;;
    fake-a) destination=a; from=b ;;
    *) exit 255 ;;
esac
printf 'try\n' >>"$FIXTURE/ssh-tries"
case ${FIXTURE_SSH_MODE:-} in
    refuse) exit 2 ;;
    timeout) exit 124 ;;
    fail) exit 255 ;;
    silent) exit 0 ;;
esac
code=0
PATH=/usr/bin:/bin DEV_ROOT=$FIXTURE/$destination SSH_ORIGINAL_COMMAND=${14} "$POST_TOOL" deliver --from "$from" >"$FIXTURE/ack" || code=$?
if [[ ${FIXTURE_SSH_MODE:-} == ack-lost && ! -f $FIXTURE/ack-lost ]]; then
    touch "$FIXTURE/ack-lost"
    exit 255
fi
cat "$FIXTURE/ack"
exit "$code"
STUB
    cat >"$HOME/.local/bin/record" <<'STUB'
#!/bin/sh
printf '%s\n' "$*" >>"$FIXTURE/record-calls"
printf '%s\n' "$RECORDS" >"$FIXTURE/record-root"
[ "$#" = 1 ] && [ "$1" = pull ] || exit 99
# post must suppress both streams and supply EOF, even after a failed pull.
if read -r line; then exit 99; fi
echo 'fixture record output'
echo 'fixture record error' >&2
exit "${FIXTURE_RECORD_EXIT:-0}"
STUB
    chmod 700 "$HOME/.local/bin/record"
    # Refuse a call that loses the exported function, keeping real Claude
    # unreachable even if post later launches it through another executable.
    cat >"$HOME/.local/bin/claude" <<'STUB'
#!/usr/bin/env bash
echo 'fixture: claude must be the exported function' >&2
exit 99
STUB
    # post invokes Claude directly: import the fake into its child shells
    # without starting a fresh Bash for each query, stop or resume.
    # shellcheck disable=SC2317
    claude() {
        jq -nc --arg cwd "$PWD" --args '{cwd:$cwd,args:$ARGS.positional}' -- "$@" >>"$FIXTURE/claude-calls" || return 1
        if [[ $* == 'agents --json --all' ]]; then
            cat "$FIXTURE/sessions.json" || return 1
            if [[ -f $FIXTURE/stopping ]]; then
                jq 'map(del(.pid))' "$FIXTURE/sessions.json" >"$FIXTURE/sessions.next" || return 1
                mv "$FIXTURE/sessions.next" "$FIXTURE/sessions.json" || return 1
                rm "$FIXTURE/stopping" || return 1
            fi
            if [[ -n ${FIXTURE_SESSION_NEXT_STATE:-}${FIXTURE_SESSION_NEXT_ID:-} ]]; then
                jq --arg state "${FIXTURE_SESSION_NEXT_STATE:-}" --arg id "${FIXTURE_SESSION_NEXT_ID:-}" \
                    'map(if $state != "" then .state=$state else . end |
                         if $id != "" then .sessionId=$id else . end)' \
                    "$FIXTURE/sessions.json" >"$FIXTURE/sessions.next" || return 1
                mv "$FIXTURE/sessions.next" "$FIXTURE/sessions.json" || return 1
            fi
        elif [[ $# == 2 && $1 == stop ]]; then
            printf '%s\n' "$2" >>"$FIXTURE/stops" || return 1
            [[ ${FIXTURE_STOP_FAIL:-0} == 0 ]] || return 1
            if [[ ${FIXTURE_STOP_PENDING:-0} == 1 ]]; then return 0; fi
            if [[ ${FIXTURE_STOP_DELAY:-0} == 1 ]]; then touch "$FIXTURE/stopping" || return 1; return 0; fi
            jq --arg id "$2" 'map(if .id == $id then del(.pid) else . end)' \
                "$FIXTURE/sessions.json" >"$FIXTURE/sessions.next" || return 1
            mv "$FIXTURE/sessions.next" "$FIXTURE/sessions.json" || return 1
        elif [[ $# == 4 && $1 == --bg && $2 == --resume ]]; then
            [[ ! -t 0 ]] || return 1
            pwd >"$FIXTURE/resume-cwd" || return 1
            printf '%s\n' "$3" "$4" >>"$FIXTURE/resumes" || return 1
            [[ ${FIXTURE_RESUME_FAIL:-0} == 0 ]] || return 1
            # A resume is unsafe until the old process has actually gone.
            jq -e --arg id "$3" 'all(.[]; (.sessionId // .id) != $id or .pid == null)' "$FIXTURE/sessions.json" >/dev/null || return 1
            if [[ -n ${FIXTURE_RESUME_BARRIER:-} ]]; then
                # Both messages must be delivered before the winning wake can finish.
                IFS= read -r -t "$HUNG_POST_S" _ <>"$FIXTURE_RESUME_BARRIER" || return 1
            fi
            jq --arg id "$3" --arg state "${FIXTURE_RESUME_STATE:-working}" \
                'map(if (.sessionId // .id) == $id then .pid=456 | .state=$state else . end)' \
                "$FIXTURE/sessions.json" >"$FIXTURE/sessions.next" || return 1
            if [[ ${FIXTURE_NEW_SESSION:-0} == 1 ]]; then
                jq '. + [.[0] | .id="new" | .sessionId="new-session" | .pid=789 | .state="done" | .startedAt="2028"]' \
                    "$FIXTURE/sessions.next" >"$FIXTURE/sessions.json" || return 1
            else
                mv "$FIXTURE/sessions.next" "$FIXTURE/sessions.json" || return 1
            fi
        else
            echo "unexpected claude arguments: $*" >&2
            return 1
        fi
    }
    export -f claude
    chmod 700 "$HOME/.local/bin/ssh" "$HOME/.local/bin/claude"
}
post() { "$POST_TOOL" "$@"; }
mission() {
    mkdir -p "$RECORDS/missions/$1"
    printf '%s\n' '---' "owner: $2" "state: $3" "started: ${4:-2026-10-24T12:00:00Z}" '---' >"$RECORDS/missions/$1/README.md"
}
session() {
    # Existing wake stories start with an eligible mission; wake_guard replaces it.
    mission "${1//\//+}" "$1@a" active
    jq -n --arg name "$1" --arg state "$2" --arg cwd "$t/session cwd" \
        '[{id:"short",sessionId:"full-session-id",name:$name,state:$state,pid:123,
           startedAt:"2026-10-24T12:00:00Z",cwd:$cwd,kind:"claude"}]' >"$t/sessions.json"
}
message() {
    printf 'Id: 20261024T213500Z-7f3a0000\nFrom: sender@%s\nTo: %s@b\nSubject: fixture\n\nbody\n' "$1" "$2"
}
count() (
    shopt -s nullglob dotglob
    local file n=0
    for file in "$1"/*.md; do
        [[ -f $file && ! -L $file ]] || continue
        n=$((n + 1))
    done
    printf '%s\n' "$n"
)
# Stage mail without delivery waking it first.
stage_wake_mail() {
    local name=$1 box=$t/a/tmp/post/${1//\//+}
    mkdir -p "$box"/{tmp,new,cur,sent}
    message a "$name" | sed 's/@b$/@a/' >"$box/new/20261024T213500Z-7f3a0000.md"
}

concurrent_delivered() { [[ $(count "$t/a/tmp/post/concurrent/new") == 2 ]]; }

local_and_remote() {
    post wait o/live --timeout "$HUNG_POST_S" >"$t/wait.out" &
    waiter=$!
    pids+=("$waiter")
    poll_until test -s "$t/a/tmp/post/o+live/waiter"
    # Paused, the fast-polling waiter cannot take the mail before send sees it alive.
    read -r live_pid _ <"$t/a/tmp/post/o+live/waiter"
    kill -STOP "$live_pid"
    out=$(capture post send o/live 'local subject' <<< 'local body')
    kill -CONT "$live_pid"
    expect 'local send reaches live waiter' "$out" 'status=0' 'waiting'
    id=$(sed -n '2s/ .*//p' <<<"$out")
    wait "$waiter"
    pids=()
    expect 'wait prints message' "$(cat "$t/wait.out")" "$id sender@a local subject"
    expect 'sent copy' "$(count "$t/a/tmp/post/sender/sent")" 1
    expect 'read prints whole message' "$(post read o/live)" "== $id" 'From: sender@a' 'To: o/live@a' 'local body'
    expect 'read moves new into cur' "new=$(count "$t/a/tmp/post/o+live/new") cur=$(count "$t/a/tmp/post/o+live/cur")" 'new=0 cur=1'
    expect 'read with no mail' "$(post read o/live)" 'no new post for o/live'
    expect 'private directories' "$(stat -c %a "$t/a/tmp/post/o+live/new")" 700
    expect 'private message' "$(stat -c %a "$t/a/tmp/post/o+live/cur/$id.md")" 600

    session remote working
    out=$(capture post send remote@b 'remote subject' <<< 'remote body')
    expect 'remote send queues at B' "$out" 'status=0' 'queued'
    expect 'remote file' "$(cat "$t/b/tmp/post/remote/new/"*.md)" 'From: sender@a' 'To: remote@b' 'remote body'
    expect 'forged sender rejected' "$(message forged forged | capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver forged' "$POST_TOOL" deliver --from a)" 'status=2' 'sender machine mismatch'
    expect 'forged sender leaves no message' "$(find "$t/b/tmp/post" -path '*/forged/new/*.md' | wc -l)" 0
    for command in 'deliver ../x' 'rm -rf' '' 'deliver remote extra' $'deliver remote\n'; do
        expect 'bad forced command rejected' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND="$command" "$POST_TOOL" deliver --from a </dev/null)" 'status=2' 'invalid SSH_ORIGINAL_COMMAND'
    done
}

wake() {
    session sleeping 'done'
    # An older stopped session must not hide the newest done session.
    jq '. + [.[0] | .id="older" | .sessionId="older-session" | del(.pid) | .startedAt="2026-10-23T12:00:00Z"]' "$t/sessions.json" >"$t/older.json"
    mv "$t/older.json" "$t/sessions.json"
    out=$(capture post send sleeping wake <<< body)
    expect 'done session wakes' "$out" 'status=0' 'woken'
    expect 'resume from session directory' "$(cat "$t/resume-cwd")" "$t/session cwd"
    expect 'resume full id and prompt' "$(cat "$t/resumes")" 'full-session-id' 'Post for sleeping: run post read sleeping and act on it, then start post wait sleeping in the background, and do the same each time it ends.'
    expect 'stop by short id' "$(cat "$t/stops")" short
    expect 'stop before exact unflagged resume in session cwd' "$(jq -sc --arg cwd "$t/session cwd" '
        [.[] | select(.args[0] != "agents")] |
        length == 2 and .[0].args == ["stop","short"] and
        .[1].args == ["--bg","--resume","full-session-id","Post for sleeping: run post read sleeping and act on it, then start post wait sleeping in the background, and do the same each time it ends."] and
        .[1].cwd == $cwd' "$t/claude-calls")" true
    expect 'resumed once' "$(wc -l <"$t/resumes")" 2
    expect 'wake keeps original id and only one live session' "$(jq -c '
        any(.[]; .sessionId == "full-session-id" and .state == "working" and .pid != null) and
        ([.[] | select(.pid != null)] | length == 1)' "$t/sessions.json")" true
    session deliberately-stopped 'done'
    jq 'map(del(.pid))' "$t/sessions.json" >"$t/stopped.json"
    mv "$t/stopped.json" "$t/sessions.json"
    : >"$t/claude-calls"
    expect 'done without pid is stopped' "$(capture post send deliberately-stopped unwoken <<< body)" 'status=3' 'nobody will wake it: stopped'
    expect 'stopped session neither stopped nor resumed' "$(jq -sc '[.[] | select(.args[0] != "agents")] | length' "$t/claude-calls")" 0
    for state in working blocked; do
        session "changed-$state" 'done'
        : >"$t/claude-calls"
        expect "session turns $state queues" "$(capture env FIXTURE_SESSION_NEXT_STATE="$state" "$POST_TOOL" send "changed-$state" busy <<< body)" 'status=0' 'queued'
        expect "session turns $state neither stopped nor resumed" "$(jq -sc '[.[] | select(.args[0] != "agents")] | length' "$t/claude-calls")" 0
    done
    session replaced-session 'done'
    : >"$t/claude-calls"
    expect 'changed full id refuses wake' "$(capture env FIXTURE_SESSION_NEXT_ID=other-id "$POST_TOOL" send replaced-session busy <<< body)" 'status=3' 'session changed'
    expect 'changed full id neither stopped nor resumed' "$(jq -sc '[.[] | select(.args[0] != "agents")] | length' "$t/claude-calls")" 0
    session stop-failed 'done'
    : >"$t/claude-calls"
    expect 'stop failure keeps mail' "$(capture env FIXTURE_STOP_FAIL=1 "$POST_TOOL" send stop-failed failure <<< body)" 'status=3' 'stop failed'
    expect 'stop failure never resumes' "$(jq -sc '[.[] | select(.args[0] != "agents") | .args] == [["stop","short"]]' "$t/claude-calls")" true
    expect 'stop failure retains mail' "$(count "$t/a/tmp/post/stop-failed/new")" 1
    session stop-pending 'done'
    : >"$t/claude-calls"
    expect 'stop timeout refuses wake' "$(capture env FIXTURE_STOP_PENDING=1 POST_STOP_WAIT=1 "$POST_TOOL" send stop-pending failure <<< body)" 'status=3' 'stop did not complete'
    expect 'stop timeout never resumes' "$(jq -sc '[.[] | select(.args[0] != "agents") | .args] == [["stop","short"]]' "$t/claude-calls")" true
    expect 'stop timeout polls again' "$(jq -sc '[.[] | select(.args[0] == "agents")] | length' "$t/claude-calls")" 4
    session working working
    expect 'working session queues' "$(capture post send working busy <<< body)" 'status=0' 'queued'
    expect 'working session not resumed' "$(wc -l <"$t/resumes")" 2
    session stop-delayed 'done'
    expect 'waits for stop before resume' "$(capture env FIXTURE_STOP_DELAY=1 POST_STOP_WAIT=1 "$POST_TOOL" send stop-delayed wake <<< body)" 'status=0' 'woken'
    session blocked blocked
    expect 'blocked session queues' "$(capture post send blocked busy <<< body)" 'status=0' 'queued'
    for cwd in missing absent; do
        session "cwd-$cwd" 'done'
        if [[ $cwd == missing ]]; then
            jq --arg cwd "$t/nonexistent" 'map(.cwd = $cwd)' "$t/sessions.json" >"$t/cwd.json"
        else
            jq 'map(del(.cwd))' "$t/sessions.json" >"$t/cwd.json"
        fi
        mv "$t/cwd.json" "$t/sessions.json"
        expect "$cwd cwd session wakes" "$(capture post send "cwd-$cwd" wake <<< body)" 'status=0' 'woken'
        expect "$cwd cwd resumes from workspace" "$(cat "$t/resume-cwd")" "$t/a"
    done
    for state in stopped failed absent; do
        if [[ $state == absent ]]; then echo '[]' >"$t/sessions.json"; reason='no session'; else session "$state" "$state"; reason=$state; fi
        expect "$state session cannot wake" "$(capture post send "$state" unwoken <<< body)" 'status=3' "queued, nobody will wake it: $reason"
        expect "$state retains mail" "$(count "$t/a/tmp/post/$state/new")" 1
    done
    stopped_message=$(find "$t/a/tmp/post/stopped/new" -type f -name '*.md')
    expect 'sent exit 3 copy survives' "$(cmp -s "$stopped_message" "$t/a/tmp/post/sender/sent/${stopped_message##*/}" && echo identical)" identical
    expect 'mail already waiting returns once' "$(capture post wait absent --timeout 0)" 'status=0' 'sender@a unwoken'
    session resume-failed 'done'
    expect 'resume failure keeps mail' "$(capture env FIXTURE_RESUME_FAIL=1 "$POST_TOOL" send resume-failed failure <<< body)" 'status=3' 'resume failed'
    session resume-idle 'done'
    expect 'resume state rechecked' "$(capture env FIXTURE_RESUME_STATE=done "$POST_TOOL" send resume-idle failure <<< body)" 'status=3' 'nobody will wake it: done'
}

wake_guard() {
    # Bash preserves the exported Claude fake through delivery's timeout.
    cat >"$HOME/.local/bin/timeout" <<'STUB'
#!/usr/bin/env bash
if [ "$*" = '-s INT 90 record pull' ]; then
    echo bounded >>"$FIXTURE/record-bounds"
fi
exec /usr/bin/timeout "$@"
STUB
    chmod 700 "$HOME/.local/bin/timeout"
    guard_prepare() {
        local name=$1
        session "$name" 'done'
        rm -rf "$RECORDS/missions" "$t/a/tmp/post/${name//\//+}"
        mkdir -p "$RECORDS/missions"
        : >"$t/record-calls"
        : >"$t/record-bounds"
        : >"$t/claude-calls"
        : >"$t/stops"
        : >"$t/resumes"
    }
    guard_check() {
        local story=$1 name=$2 code=$3 line=$4 path=${5:-wake} output result mutations
        if [[ $path == send ]]; then
            output=$(capture post send "$name" guard <<< body)
        else
            stage_wake_mail "$name"
            output=$(capture post wake "$name")
        fi
        expect "$story exit" "[${output%%$'\n'*}]" "[status=$code]"
        result=${output##*$'\n'}
        expect "$story line" "[${result#* }]" "[$line]"
        mutations=$(jq -sc '[.[] | select(.args[0] != "agents") | .args[0]]' "$t/claude-calls")
        if ((code == 0)); then
            expect "$story stops then resumes" "$mutations" '["stop","--bg"]'
        else
            expect "$story never stops or resumes" "$mutations" '[]'
        fi
        expect "$story mail stays new" "[$(count "$t/a/tmp/post/${name//\//+}/new")]" '[1]'
        expect "$story pulls once" "[$(cat "$t/record-calls")]" '[pull]'
        expect "$story pulls the inspected record" "[$(cat "$t/record-root")]" "[${RECORDS:-$t/a/records}]"
        expect "$story pull bounded" "[$(cat "$t/record-bounds")]" '[bounded]'
        expect "$story pull output suppressed" "$([[ $output != *'fixture record'* ]] && echo yes)" yes
    }
    guard_prepare o/x
    mission x o/x@a active
    guard_check active o/x 0 woken
    local state
    for state in paused ended ''; do
        guard_prepare o/x
        mission x o/x@a "$state"
        if [[ -z $state ]]; then
            # Omission as well as an empty value must become unknown.
            sed '/^state:/d' "$RECORDS/missions/x/README.md" >"$t/no-state"
            mv "$t/no-state" "$RECORDS/missions/x/README.md"
        fi
        guard_check "state ${state:-missing}" o/x 3 "queued, nobody will wake it: mission x is ${state:-unknown}"
    done
    guard_prepare o/x
    mission x1 o/x@a ended 2026-10-27T12:00:00Z
    mission x2 o/x@a active
    guard_check 'ended and active' o/x 0 woken
    guard_prepare o/x
    mission x o/x@b active
    guard_check elsewhere o/x 3 'queued, nobody will wake it: no active mission here'
    local name
    for name in director d/fix; do
        guard_prepare "$name"
        guard_check "unowned $name" "$name" 0 woken
    done
    guard_prepare d/fix
    mission x d/fix@a ended
    guard_check 'owned helper' d/fix 3 'queued, nobody will wake it: mission x is ended'
    guard_prepare director
    mission x director@b active
    guard_check 'director owned elsewhere' director 3 'queued, nobody will wake it: no active mission here'
    for name in o/x director d/fix; do
        guard_prepare "$name"
        rm -rf "$RECORDS/missions"
        if [[ $name == o/x ]]; then
            guard_check 'no record' "$name" 3 'queued, nobody will wake it: record unreadable'
        else
            guard_check "no record $name" "$name" 0 woken
        fi
    done
    guard_prepare o/x
    mission x o/x@a active
    FIXTURE_RECORD_EXIT=1 guard_check 'pull fails' o/x 0 woken
    guard_prepare o/x
    mission x o/x@a active
    mv "$RECORDS" "$t/a/records"
    # With RECORDS unset, both pull and inspection use the workspace records.
    unset RECORDS
    guard_check 'workspace record' o/x 0 woken
    export RECORDS=$t/records
    mv "$t/a/records" "$RECORDS"
    guard_prepare o/x
    mission old o/x@a paused 2026-10-20T12:00:00Z
    mission latest-a o/x@a abandoned 2026-10-27T12:00:00Z
    mission latest-z o/x@a ended 2026-10-27T12:00:00Z
    # Body fields and a later fence cannot grant eligibility.
    printf '%s\n' 'state: active' '---' 'owner: o/x@a' 'state: active' '---' >>"$RECORDS/missions/latest-z/README.md"
    guard_check 'latest start and name tie' o/x 3 'queued, nobody will wake it: mission latest-z is ended'
    guard_prepare o/x
    mission x o/x@a paused
    guard_check 'delivery refusal' o/x 3 'queued, nobody will wake it: mission x is paused' send

    guard_prepare o/x
    capture post wait o/x --timeout 0 --holder "$$" >/dev/null
    stage_wake_mail o/x
    expect 'guard live waiter' "[$(capture post wake o/x)]" $'[status=0\no/x waiting]'
    session o/working working
    stage_wake_mail o/working
    expect 'guard working session' "[$(capture post wake o/working)]" $'[status=0\no/working queued]'
    session o/stopped 'done'
    jq 'map(del(.pid))' "$t/sessions.json" >"$t/stopped.json"
    mv "$t/stopped.json" "$t/sessions.json"
    stage_wake_mail o/stopped
    expect 'guard stopped session' "[$(capture post wake o/stopped)]" $'[status=3\no/stopped queued, nobody will wake it: stopped]'
    expect 'non-resume paths never pull' "[$(cat "$t/record-calls")]" '[]'
    expect 'non-resume paths never stop or resume' "$(jq -sc '[.[] | select(.args[0] != "agents")] | length' "$t/claude-calls")" 0
}

wake_command() {
    expect 'wake missing mailbox' "[$(capture post wake o/missing)]" $'[status=0\no/missing no mail]'
    expect 'wake missing creates nothing' "$([[ ! -e $t/a/tmp/post/o+missing ]] && echo absent)" absent
    mkdir -p "$t/a/tmp/post/o+empty/new"
    expect 'wake empty mailbox' "[$(capture post wake o/empty)]" $'[status=0\no/empty no mail]'

    capture post wait o/live --timeout 0 --holder "$$" >/dev/null
    stage_wake_mail o/live
    expect 'wake live waiter' "[$(capture post wake o/live)]" $'[status=0\no/live waiting]'
    expect 'no mail and live waiter never stop or resume' "$([[ ! -e $t/stops && ! -s $t/resumes ]] && echo none)" none

    stage_wake_mail o/sleeping
    session o/sleeping 'done'
    expect 'wake done session' "[$(capture post wake o/sleeping)]" $'[status=0\no/sleeping woken]'
    expect 'wake stops and resumes once in session cwd' "$(jq -sc --arg cwd "$t/session cwd" '
        [.[] | select(.args[0] != "agents")] |
        length == 2 and .[0].args == ["stop","short"] and
        .[1].args == ["--bg","--resume","full-session-id","Post for o/sleeping: run post read o/sleeping and act on it, then start post wait o/sleeping in the background, and do the same each time it ends."] and
        .[1].cwd == $cwd' "$t/claude-calls")" true
    expect 'wake records one stop and resume' "stops=$(wc -l <"$t/stops") resumes=$(wc -l <"$t/resumes")" 'stops=1 resumes=2'
    expect 'wake leaves mail unread' "$(count "$t/a/tmp/post/o+sleeping/new")" 1
    stage_wake_mail o/working
    session o/working working
    expect 'wake working session' "[$(capture post wake o/working)]" $'[status=0\no/working queued]'
    stage_wake_mail o/stopped
    session o/stopped 'done'
    jq 'map(del(.pid))' "$t/sessions.json" >"$t/stopped.json"
    mv "$t/stopped.json" "$t/sessions.json"
    expect 'wake stopped session' "[$(capture post wake o/stopped)]" $'[status=3\no/stopped queued, nobody will wake it: stopped]'
    stage_wake_mail o/absent
    echo '[]' >"$t/sessions.json"
    expect 'wake absent session' "[$(capture post wake o/absent)]" $'[status=3\no/absent queued, nobody will wake it: no session]'
    stage_wake_mail o/codex
    echo codex >"$t/a/tmp/post/o+codex/kind"
    expect 'wake Codex without waiter' "[$(capture post wake o/codex)]" $'[status=3\no/codex queued, nobody will wake it: codex owner not running]'
    expect 'queued and unwoken names never stop or resume' "stops=$(wc -l <"$t/stops") resumes=$(wc -l <"$t/resumes")" 'stops=1 resumes=2'

    for name in o/old o/young o/heard user o/gone; do
        stage_wake_mail "$name"
        printf '2147483647 1 claude\n' >"$t/a/tmp/post/${name//\//+}/waiter"
    done
    capture post wait o/heard --timeout 0 --holder "$$" >/dev/null
    touch -d '20 minutes ago' "$t/a/tmp/post/o+old/new/"*.md
    touch -d '5 minutes ago' "$t/a/tmp/post/o+young/new/"*.md
    touch -d '30 minutes ago' "$t/a/tmp/post/o+heard/new/"*.md
    touch -d '2 hours ago' "$t/a/tmp/post/user/new/"*.md
    touch -d '40 minutes ago' "$t/a/tmp/post/o+gone/new/"*.md
    # The oldest mtime need not be the first id, and a name wakes only once.
    cp "$t/a/tmp/post/o+old/new/20261024T213500Z-7f3a0000.md" "$t/a/tmp/post/o+old/new/20261024T213500Z-00000001.md"
    touch -d '5 minutes ago' "$t/a/tmp/post/o+old/new/20261024T213500Z-00000001.md"
    session o/old 'done'
    : >"$t/claude-calls"
    : >"$t/stops"
    : >"$t/resumes"
    expect 'older wakes all eligible names in order despite failure' "[$(capture post wake --older 15)]" $'[status=3\no/gone queued, nobody will wake it: no session\no/old woken]'
    expect 'older stops and resumes old once' "stops=$(wc -l <"$t/stops") resumes=$(wc -l <"$t/resumes")" 'stops=1 resumes=2'
    expect 'older resumes old full id and prompt' "[$(cat "$t/resumes")]" $'[full-session-id\nPost for o/old: run post read o/old and act on it, then start post wait o/old in the background, and do the same each time it ends.]'
    expect 'older records stop before resume' "$(jq -sc '[.[] | select(.args[0] != "agents") | .args[0]] == ["stop","--bg"]' "$t/claude-calls")" true
    expect 'older with nothing old enough is silent' "[$(capture post wake --older 10000)]" '[status=0]'

    # A wake-lock failure keeps its error and exit 2, without stopping the batch.
    # shellcheck disable=SC2317
    flock() {
        if [[ $* == '-x 8' && $box == "$FIXTURE/a/tmp/post/o+gone" ]]; then return 1; fi
        command flock "$@"
    }
    export -f flock
    expect 'single wake lock failure' "[$(capture post wake o/gone)]" $'[status=2\npost: cannot lock wake]'
    stage_wake_mail o/z-gone
    touch -d '40 minutes ago' "$t/a/tmp/post/o+z-gone/new/"*.md
    session o/old 'done'
    : >"$t/stops"
    : >"$t/resumes"
    expect 'batch lock failure wins over later exit 3 and still resumes' "[$(capture post wake --older 15)]" $'[status=2\npost: cannot lock wake\no/old woken\no/z-gone queued, nobody will wake it: no session]'
    expect 'batch after lock failure resumes once' "stops=$(wc -l <"$t/stops") resumes=$(wc -l <"$t/resumes")" 'stops=1 resumes=2'
    unset -f flock

    # A mixed mailbox qualifies on any message inside the day's window.
    for name in o/fresh o/stale o/both; do
        stage_wake_mail "$name"
        printf '2147483647 1 claude\n' >"$t/a/tmp/post/${name//\//+}/waiter"
    done
    touch -d '20 minutes ago' "$t/a/tmp/post/o+fresh/new/"*.md
    touch -d '25 hours ago' "$t/a/tmp/post/o+stale/new/"*.md
    touch -d '26 hours ago' "$t/a/tmp/post/o+both/new/"*.md
    cp "$t/a/tmp/post/o+both/new/20261024T213500Z-7f3a0000.md" "$t/a/tmp/post/o+both/new/20261024T213500Z-ffffffff.md"
    touch -d '30 minutes ago' "$t/a/tmp/post/o+both/new/20261024T213500Z-ffffffff.md"
    # Retire earlier mail so this batch checks just the three window stories.
    for name in o/old o/gone o/z-gone; do
        touch -d '25 hours ago' "$t/a/tmp/post/${name//\//+}/new/"*.md
    done
    session o/stale 'done'
    mission fresh o/fresh@a active
    mission both o/both@a active
    jq '[.[0] as $session | ["o/fresh", "o/stale", "o/both"][] | $session + {name:.,id:.,sessionId:.}]' \
        "$t/sessions.json" >"$t/window-sessions.json"
    mv "$t/window-sessions.json" "$t/sessions.json"
    : >"$t/resumes"
    local output
    output=$(capture post wake --older 15)
    expect 'window wakes fresh mail' "$output" 'o/fresh woken'
    expect 'window wakes mixed-age mail' "$output" 'o/both woken'
    expect 'window skips expired mail silently' "[$output]" $'[status=0\no/both woken\no/fresh woken]'
    expect 'window resumes only two names' "$(wc -l <"$t/resumes")" 4
    expect 'named wake still wakes expired mail' "[$(capture post wake o/stale)]" $'[status=0\no/stale woken]'

    for args in 'wake' 'wake --older' 'wake --older x' 'wake Bad/Name' 'wake a b'; do
        read -r -a arguments <<<"$args"
        expect "usage: $args" "$(capture post "${arguments[@]}")" 'status=2' 'usage: post'
    done
}

