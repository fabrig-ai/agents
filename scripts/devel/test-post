waiter_holder() {
    local parent=$BASHPID pid kind id extra
    session o/x working
    jq --argjson pid "$parent" 'map(.pid=$pid)' "$t/sessions.json" >"$t/holder.json"
    mv "$t/holder.json" "$t/sessions.json"
    expect 'session waiter times out silently' "[$(capture post wait o/x --timeout 0)]" '[status=1]'
    read -r pid _ kind id extra <"$t/a/tmp/post/o+x/waiter"
    expect 'ancestor session recorded and retained after wait ends' "$id/$extra" 'full-session-id/'
    expect 'one session query per registration' "$(wc -l <"$t/claude-calls")" 1
    # The explicit holder path uses the same ancestry, and short ids are supported.
    jq 'map(del(.sessionId))' "$t/sessions.json" >"$t/holder.json"
    mv "$t/holder.json" "$t/sessions.json"
    capture post wait explicit --timeout 0 --holder "$parent" --kind codex >/dev/null
    read -r pid _ kind id <"$t/a/tmp/post/explicit/waiter"
    expect 'explicit holder and id fallback' "$pid/$kind/$id" "$parent/codex/short"
    echo '[]' >"$t/sessions.json"
    capture post wait outside --timeout 0 >/dev/null
    read -r pid _ kind id <"$t/a/tmp/post/outside/waiter"
    expect 'outside any session has no holder' "$id" '-'
    echo 'not JSON' >"$t/sessions.json"
    expect 'failed Claude query does not fail registration' "[$(capture post wait failed --timeout 0)]" '[status=1]'
    read -r pid _ kind id <"$t/a/tmp/post/failed/waiter"
    expect 'failed query records no holder' "$id" '-'
}

