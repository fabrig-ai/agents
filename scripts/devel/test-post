#!/usr/bin/env bash
# Test post in two isolated workspaces with fake SSH and Claude sessions.
set -Eeuo pipefail
umask 077
trap 'echo "test-post: failed at line $LINENO" >&2' ERR
started=$(date +%s.%N)
kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
root=$(mktemp -d)
failed=0 checks=0
pids=()
stop_children() {
    local pid
    for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
    for pid in "${pids[@]}"; do wait "$pid" 2>/dev/null || true; done
}
cleanup() {
    stop_children
    rm -rf "$root"
}
trap cleanup EXIT
expect() {
    local what=$1 output=$2 want
    shift 2
    checks=$((checks + 1))
    for want in "$@"; do
        if [[ $output != *"$want"* ]]; then
            echo "FAIL $what: no \"$want\" in:"
            printf '    %s\n' "${output//$'\n'/$'\n'    }"
            failed=1
        fi
    done
}
capture() {
    local code=0 output
    output=$("$@" 2>&1) || code=$?
    printf 'status=%s\n%s\n' "$code" "$output"
}
poll_until() {
    local attempt
    for ((attempt=0; attempt<100; attempt++)); do
        "$@" && return 0
        sleep 0.01
    done
    return 1
}
# Each part has its own workspaces, stubs and sessions under its own $t.
fixture() {
    t=$1
    export HOME=$t/home DEV_ROOT=$t/a POST_NAME=sender POST_RESUME_CHECK=0 POST_STOP_WAIT=0 POST_RETRY_DELAYS="0 0 0"
    # Waiters poll and stop checks retry quickly; post's defaults are 2 s and 1 s.
    export POST_POLL=0.02 POST_STOP_STEP=0.02
    export POST_TOOL=$kit/post FIXTURE=$t
    unset SSH_ORIGINAL_COMMAND
    mkdir -p "$HOME/.local/bin" "$t"/{a,b}/tmp/post "$t/session cwd"
    export PATH=$HOME/.local/bin:$PATH
    printf 'a local\nb fake-b\n' >"$t/a/tmp/post/machines"
    printf '# Other machine\nb local\na fake-a\n' >"$t/b/tmp/post/machines"
    echo '[]' >"$t/sessions.json"
    : >"$t/resumes"
    cat >"$HOME/.local/bin/ssh" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
[[ $# == 14 && $1 == -i && $2 == "$HOME/.ssh/post_ed25519" && $3 == -o && $4 == IdentitiesOnly=yes &&
    $5 == -o && $6 == BatchMode=yes && $7 == -o && $8 == ConnectTimeout=20 &&
    $9 == -o && ${10} == ControlMaster=no && ${11} == -o && ${12} == ControlPath=none ]]
case ${13} in
    fake-b) destination=b; from=a ;;
    fake-a) destination=a; from=b ;;
    *) exit 255 ;;
esac
printf 'try\n' >>"$FIXTURE/ssh-tries"
case ${FIXTURE_SSH_MODE:-} in
    refuse) exit 2 ;;
    timeout) exit 124 ;;
    fail) exit 255 ;;
    silent) exit 0 ;;
esac
code=0
PATH=/usr/bin:/bin DEV_ROOT=$FIXTURE/$destination SSH_ORIGINAL_COMMAND=${14} "$POST_TOOL" deliver --from "$from" >"$FIXTURE/ack" || code=$?
if [[ ${FIXTURE_SSH_MODE:-} == ack-lost && ! -f $FIXTURE/ack-lost ]]; then
    touch "$FIXTURE/ack-lost"
    exit 255
fi
cat "$FIXTURE/ack"
exit "$code"
STUB
    cat >"$HOME/.local/bin/claude" <<'STUB'
#!/usr/bin/env bash
set -euo pipefail
jq -nc --arg cwd "$PWD" --args '{cwd:$cwd,args:$ARGS.positional}' -- "$@" >>"$FIXTURE/claude-calls"
if [[ $* == 'agents --json --all' ]]; then
    cat "$FIXTURE/sessions.json"
    if [[ -f $FIXTURE/stopping ]]; then
        jq 'map(del(.pid))' "$FIXTURE/sessions.json" >"$FIXTURE/sessions.next"
        mv "$FIXTURE/sessions.next" "$FIXTURE/sessions.json"
        rm "$FIXTURE/stopping"
    fi
    if [[ -n ${FIXTURE_SESSION_NEXT_STATE:-}${FIXTURE_SESSION_NEXT_ID:-} ]]; then
        jq --arg state "${FIXTURE_SESSION_NEXT_STATE:-}" --arg id "${FIXTURE_SESSION_NEXT_ID:-}" \
            'map(if $state != "" then .state=$state else . end |
                 if $id != "" then .sessionId=$id else . end)' \
            "$FIXTURE/sessions.json" >"$FIXTURE/sessions.next"
        mv "$FIXTURE/sessions.next" "$FIXTURE/sessions.json"
    fi
elif [[ $# == 2 && $1 == stop ]]; then
    printf '%s\n' "$2" >>"$FIXTURE/stops"
    [[ ${FIXTURE_STOP_FAIL:-0} == 0 ]] || exit 1
    if [[ ${FIXTURE_STOP_PENDING:-0} == 1 ]]; then exit 0; fi
    if [[ ${FIXTURE_STOP_DELAY:-0} == 1 ]]; then touch "$FIXTURE/stopping"; exit 0; fi
    jq --arg id "$2" 'map(if .id == $id then del(.pid) else . end)' \
        "$FIXTURE/sessions.json" >"$FIXTURE/sessions.next"
    mv "$FIXTURE/sessions.next" "$FIXTURE/sessions.json"
elif [[ $# == 4 && $1 == --bg && $2 == --resume ]]; then
    [[ ! -t 0 ]]
    pwd >"$FIXTURE/resume-cwd"
    printf '%s\n' "$3" "$4" >>"$FIXTURE/resumes"
    [[ ${FIXTURE_RESUME_FAIL:-0} == 0 ]] || exit 1
    # A resume is unsafe until the old process has actually gone.
    jq -e --arg id "$3" 'all(.[]; (.sessionId // .id) != $id or .pid == null)' "$FIXTURE/sessions.json" >/dev/null
    sleep "${FIXTURE_RESUME_DELAY:-0}"
    jq --arg id "$3" --arg state "${FIXTURE_RESUME_STATE:-working}" \
        'map(if (.sessionId // .id) == $id then .pid=456 | .state=$state else . end)' \
        "$FIXTURE/sessions.json" >"$FIXTURE/sessions.next"
    if [[ ${FIXTURE_NEW_SESSION:-0} == 1 ]]; then
        jq '. + [.[0] | .id="new" | .sessionId="new-session" | .pid=789 | .state="done" | .startedAt="2028"]' \
            "$FIXTURE/sessions.next" >"$FIXTURE/sessions.json"
    else
        mv "$FIXTURE/sessions.next" "$FIXTURE/sessions.json"
    fi
else
    echo "unexpected claude arguments: $*" >&2
    exit 1
fi
STUB
    chmod 700 "$HOME/.local/bin/ssh" "$HOME/.local/bin/claude"
}
post() { "$POST_TOOL" "$@"; }
session() {
    jq -n --arg name "$1" --arg state "$2" --arg cwd "$t/session cwd" \
        '[{id:"short",sessionId:"full-session-id",name:$name,state:$state,pid:123,
           startedAt:"2026-10-24T12:00:00Z",cwd:$cwd,kind:"claude"}]' >"$t/sessions.json"
}
message() {
    printf 'Id: 20261024T213500Z-7f3a0000\nFrom: sender@%s\nTo: %s@b\nSubject: fixture\n\nbody\n' "$1" "$2"
}
count() { find "$1" -maxdepth 1 -type f -name '*.md' | wc -l; }

local_and_remote() {
    post wait o/live --timeout 5 >"$t/wait.out" &
    waiter=$!
    pids+=("$waiter")
    poll_until test -s "$t/a/tmp/post/o+live/waiter"
    # Paused, the fast-polling waiter cannot take the mail before send sees it alive.
    read -r live_pid _ <"$t/a/tmp/post/o+live/waiter"
    kill -STOP "$live_pid"
    out=$(capture post send o/live 'local subject' <<< 'local body')
    kill -CONT "$live_pid"
    expect 'local send reaches live waiter' "$out" 'status=0' 'waiting'
    id=$(sed -n '2s/ .*//p' <<<"$out")
    wait "$waiter"
    pids=()
    expect 'wait prints message' "$(cat "$t/wait.out")" "$id sender@a local subject"
    expect 'sent copy' "$(count "$t/a/tmp/post/sender/sent")" 1
    expect 'read prints whole message' "$(post read o/live)" "== $id" 'From: sender@a' 'To: o/live@a' 'local body'
    expect 'read moves new into cur' "new=$(count "$t/a/tmp/post/o+live/new") cur=$(count "$t/a/tmp/post/o+live/cur")" 'new=0 cur=1'
    expect 'read with no mail' "$(post read o/live)" 'no new post for o/live'
    expect 'private directories' "$(stat -c %a "$t/a/tmp/post/o+live/new")" 700
    expect 'private message' "$(stat -c %a "$t/a/tmp/post/o+live/cur/$id.md")" 600

    session remote working
    out=$(capture post send remote@b 'remote subject' <<< 'remote body')
    expect 'remote send queues at B' "$out" 'status=0' 'queued'
    expect 'remote file' "$(cat "$t/b/tmp/post/remote/new/"*.md)" 'From: sender@a' 'To: remote@b' 'remote body'
    expect 'forged sender rejected' "$(message forged forged | capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver forged' "$POST_TOOL" deliver --from a)" 'status=2' 'sender machine mismatch'
    expect 'forged sender leaves no message' "$(find "$t/b/tmp/post" -path '*/forged/new/*.md' | wc -l)" 0
    for command in 'deliver ../x' 'rm -rf' '' 'deliver remote extra' $'deliver remote\n'; do
        expect 'bad forced command rejected' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND="$command" "$POST_TOOL" deliver --from a </dev/null)" 'status=2' 'invalid SSH_ORIGINAL_COMMAND'
    done
}

wake() {
    session sleeping 'done'
    # An older stopped session must not hide the newest done session.
    jq '. + [.[0] | .id="older" | .sessionId="older-session" | del(.pid) | .startedAt="2026-10-23T12:00:00Z"]' "$t/sessions.json" >"$t/older.json"
    mv "$t/older.json" "$t/sessions.json"
    out=$(capture post send sleeping wake <<< body)
    expect 'done session wakes' "$out" 'status=0' 'woken'
    expect 'resume from session directory' "$(cat "$t/resume-cwd")" "$t/session cwd"
    expect 'resume full id and prompt' "$(cat "$t/resumes")" 'full-session-id' 'Post for sleeping: run post read sleeping and act on it, then start post wait sleeping in the background, and do the same each time it ends.'
    expect 'stop by short id' "$(cat "$t/stops")" short
    expect 'stop before exact unflagged resume in session cwd' "$(jq -sc --arg cwd "$t/session cwd" '
        [.[] | select(.args[0] != "agents")] |
        length == 2 and .[0].args == ["stop","short"] and
        .[1].args == ["--bg","--resume","full-session-id","Post for sleeping: run post read sleeping and act on it, then start post wait sleeping in the background, and do the same each time it ends."] and
        .[1].cwd == $cwd' "$t/claude-calls")" true
    expect 'resumed once' "$(wc -l <"$t/resumes")" 2
    expect 'wake keeps original id and only one live session' "$(jq -c '
        any(.[]; .sessionId == "full-session-id" and .state == "working" and .pid != null) and
        ([.[] | select(.pid != null)] | length == 1)' "$t/sessions.json")" true
    session deliberately-stopped 'done'
    jq 'map(del(.pid))' "$t/sessions.json" >"$t/stopped.json"
    mv "$t/stopped.json" "$t/sessions.json"
    : >"$t/claude-calls"
    expect 'done without pid is stopped' "$(capture post send deliberately-stopped unwoken <<< body)" 'status=3' 'nobody will wake it: stopped'
    expect 'stopped session neither stopped nor resumed' "$(jq -sc '[.[] | select(.args[0] != "agents")] | length' "$t/claude-calls")" 0
    for state in working blocked; do
        session "changed-$state" 'done'
        : >"$t/claude-calls"
        expect "session turns $state queues" "$(capture env FIXTURE_SESSION_NEXT_STATE="$state" "$POST_TOOL" send "changed-$state" busy <<< body)" 'status=0' 'queued'
        expect "session turns $state neither stopped nor resumed" "$(jq -sc '[.[] | select(.args[0] != "agents")] | length' "$t/claude-calls")" 0
    done
    session replaced-session 'done'
    : >"$t/claude-calls"
    expect 'changed full id refuses wake' "$(capture env FIXTURE_SESSION_NEXT_ID=other-id "$POST_TOOL" send replaced-session busy <<< body)" 'status=3' 'session changed'
    expect 'changed full id neither stopped nor resumed' "$(jq -sc '[.[] | select(.args[0] != "agents")] | length' "$t/claude-calls")" 0
    session stop-failed 'done'
    : >"$t/claude-calls"
    expect 'stop failure keeps mail' "$(capture env FIXTURE_STOP_FAIL=1 "$POST_TOOL" send stop-failed failure <<< body)" 'status=3' 'stop failed'
    expect 'stop failure never resumes' "$(jq -sc '[.[] | select(.args[0] != "agents") | .args] == [["stop","short"]]' "$t/claude-calls")" true
    expect 'stop failure retains mail' "$(count "$t/a/tmp/post/stop-failed/new")" 1
    session stop-pending 'done'
    : >"$t/claude-calls"
    expect 'stop timeout refuses wake' "$(capture env FIXTURE_STOP_PENDING=1 POST_STOP_WAIT=1 "$POST_TOOL" send stop-pending failure <<< body)" 'status=3' 'stop did not complete'
    expect 'stop timeout never resumes' "$(jq -sc '[.[] | select(.args[0] != "agents") | .args] == [["stop","short"]]' "$t/claude-calls")" true
    expect 'stop timeout polls again' "$(jq -sc '[.[] | select(.args[0] == "agents")] | length' "$t/claude-calls")" 4
    session working working
    expect 'working session queues' "$(capture post send working busy <<< body)" 'status=0' 'queued'
    expect 'working session not resumed' "$(wc -l <"$t/resumes")" 2
    session stop-delayed 'done'
    expect 'waits for stop before resume' "$(capture env FIXTURE_STOP_DELAY=1 POST_STOP_WAIT=1 "$POST_TOOL" send stop-delayed wake <<< body)" 'status=0' 'woken'
    session blocked blocked
    expect 'blocked session queues' "$(capture post send blocked busy <<< body)" 'status=0' 'queued'
    for cwd in missing absent; do
        session "cwd-$cwd" 'done'
        if [[ $cwd == missing ]]; then
            jq --arg cwd "$t/nonexistent" 'map(.cwd = $cwd)' "$t/sessions.json" >"$t/cwd.json"
        else
            jq 'map(del(.cwd))' "$t/sessions.json" >"$t/cwd.json"
        fi
        mv "$t/cwd.json" "$t/sessions.json"
        expect "$cwd cwd session wakes" "$(capture post send "cwd-$cwd" wake <<< body)" 'status=0' 'woken'
        expect "$cwd cwd resumes from workspace" "$(cat "$t/resume-cwd")" "$t/a"
    done
    for state in stopped failed absent; do
        if [[ $state == absent ]]; then echo '[]' >"$t/sessions.json"; reason='no session'; else session "$state" "$state"; reason=$state; fi
        expect "$state session cannot wake" "$(capture post send "$state" unwoken <<< body)" 'status=3' "queued, nobody will wake it: $reason"
        expect "$state retains mail" "$(count "$t/a/tmp/post/$state/new")" 1
    done
    stopped_message=$(find "$t/a/tmp/post/stopped/new" -type f -name '*.md')
    expect 'sent exit 3 copy survives' "$(cmp -s "$stopped_message" "$t/a/tmp/post/sender/sent/${stopped_message##*/}" && echo identical)" identical
    expect 'mail already waiting returns once' "$(capture post wait absent --timeout 0)" 'status=0' 'sender@a unwoken'
    session resume-failed 'done'
    expect 'resume failure keeps mail' "$(capture env FIXTURE_RESUME_FAIL=1 "$POST_TOOL" send resume-failed failure <<< body)" 'status=3' 'resume failed'
    session resume-idle 'done'
    expect 'resume state rechecked' "$(capture env FIXTURE_RESUME_STATE=done "$POST_TOOL" send resume-idle failure <<< body)" 'status=3' 'nobody will wake it: done'
}

waiters_and_limits() {
    # Register a Codex holder, then substitute a definitely dead PID.
    expect 'holder registration times out without mail' "$(capture post wait codex --timeout 0 --holder "$$" --kind codex)" 'status=1'
    expect 'holder pid registered' "$(cat "$t/a/tmp/post/codex/waiter")" "$$" 'codex'
    printf '2147483647 1 codex\n' >"$t/a/tmp/post/codex/waiter"
    expect 'dead Codex holder' "$(capture post send codex sleeping <<< body)" 'status=3' 'codex owner not running'
    rm "$t/a/tmp/post/codex/waiter"
    expect 'Codex kind without waiter' "$(capture post send codex sleeping <<< body)" 'status=3' 'codex owner not running'
    expect 'zero timeout is silent' "[$(capture post wait empty --timeout 0)]" '[status=1]'
    post wait replaced --timeout 5 >"$t/replaced.out" 2>&1 &
    first=$!
    pids+=("$first")
    poll_until test -s "$t/a/tmp/post/replaced/waiter"
    expect 'second waiter times out' "$(capture post wait replaced --timeout 0)" 'status=1'
    code=0
    wait "$first" || code=$?
    pids=()
    expect 'first waiter replaced' "status=$code $(cat "$t/replaced.out")" 'status=4' 'post: another waiter took replaced'

    for dead in dead-pid reused-pid; do
        capture post wait "$dead" --timeout 0 >/dev/null
        if [[ $dead == dead-pid ]]; then holder=2147483647; else holder=$$; fi
        printf '%s 0 claude\n' "$holder" >"$t/a/tmp/post/$dead/waiter"
        session "$dead" working
        expect "$dead counts as dead" "$(capture post send "$dead" dead <<< body)" 'status=0' 'queued'
    done
    expect 'list dead waiter' "$(post list --older 0)" 'dead-pid' 'waiter=dead dead'
    expect 'older filter' "count=$(post list --older 10000 | wc -l)" 'count=0'
    # Verify age filtering against a known mtime, without sleeping.
    touch -d '20 minutes ago' "$t/a/tmp/post/dead-pid/new/"*.md
    expect 'older message listed' "$(post list --older 15)" '20 dead-pid' 'waiter=dead dead'
    expect 'old filter excludes new mail' "$(post list --older 15 | wc -l)" 1

    head -c 65537 /dev/zero >"$t/big"
    expect 'oversize body rejected' "$(capture post send big oversized "$t/big")" 'status=2' '64 KiB'
    expect 'oversize deliver rejected' "$(capture env SSH_ORIGINAL_COMMAND='deliver big' "$POST_TOOL" deliver --from a <"$t/big")" 'status=2' '64 KiB'
    expect 'newline subject rejected' "$(capture post send bad $'two\nlines' </dev/null)" 'status=2' 'subject must be one line'
    long_subject=$(printf '%0201d' 0)
    expect 'long subject rejected' "$(capture post send bad "$long_subject" </dev/null)" 'status=2'
    expect 'control subject rejected' "$(capture post send bad $'tab\tsubject' </dev/null)" 'status=2'
    expect 'sender required' "$(capture env -u POST_NAME "$POST_TOOL" send bad missing </dev/null)" 'status=2' 'set POST_NAME or pass --as'
    expect 'bad name rejected' "$(capture post send ../bad bad </dev/null)" 'status=2'
    expect 'bad sender rejected' "$(capture post send --as 'a@b' remote bad </dev/null)" 'status=2'
    expect 'no route' "$(capture post send remote@missing bad </dev/null)" 'status=2' 'no route'
    expect 'SSH failure' "$(capture env FIXTURE_SSH_MODE=fail "$POST_TOOL" send remote@b failure </dev/null)" 'status=2' 'not delivered'
    expect 'missing SSH status' "$(capture env FIXTURE_SSH_MODE=silent "$POST_TOOL" send remote@b failure </dev/null)" 'status=2' 'not delivered'
    printf 'b fake-b\n' >"$t/a/tmp/post/machines"
    expect 'local machine required' "$(capture post send bad machine </dev/null)" 'status=2' 'no local machine'
    printf 'a local\nb fake-b\n' >"$t/a/tmp/post/machines"

    session file working
    printf 'file body\n' >"$t/body"
    out=$(capture post send --as codex-run --re 20261024T210100Z-11c20000 file 'file subject' "$t/body")
    expect 'codex-run sender and file body' "$out" 'status=0' 'queued'
    expect 'reply header and sender override' "$(cat "$t/a/tmp/post/file/new/"*.md)" 'Re: 20261024T210100Z-11c20000' 'From: codex-run@a' 'file body'
    message a wrong >"$t/message"
    expect 'To mismatch rejected' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver other' "$POST_TOOL" deliver --from a <"$t/message")" 'status=2' 'recipient name mismatch'
    printf 'not a message\n' >"$t/message"
    expect 'malformed header rejected' "$(capture env SSH_ORIGINAL_COMMAND='deliver malformed' "$POST_TOOL" deliver --from a <"$t/message")" 'status=2' 'invalid message header'
}

names_and_order() {
    session id-only 'done'
    jq 'map(del(.sessionId))' "$t/sessions.json" >"$t/id-only.json"
    mv "$t/id-only.json" "$t/sessions.json"
    expect 'id fallback resumes' "$(capture post send id-only fallback <<< body)" 'status=0' 'woken'
    expect 'fallback id passed' "$(tail -n2 "$t/resumes")" short

    session a/new/nested working
    expect 'nested name with new component' "$(capture post send a/new/nested nested <<< body)" 'status=0' 'queued'
    expect 'nested mailbox listed once' "$(post list --older 0 | grep -cF ' a/new/nested ')" 1
    post read a/new/nested >/dev/null
    session a/new/sender working
    expect 'nested sender sent folder' "$(capture post send --as a/new/sender a/new/sender nested <<< body)" 'status=0' 'queued'
    expect 'sent and cur excluded from nested list' "$(post list --older 0 | grep -cF ' a/new/')" 1

    session limit working
    printf 'Id: 20261024T213500Z-00010000\nFrom: sender@a\nTo: limit@b\nSubject: limit\n\n' >"$t/limit"
    remaining=$((65536 - $(stat -c %s "$t/limit")))
    head -c "$remaining" /dev/zero >>"$t/limit"
    expect '64 KiB accepted by deliver' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver limit' "$POST_TOOL" deliver --from a <"$t/limit")" 'status=0' 'queued'
    expect '64 KiB preserved' "$(stat -c %s "$t/b/tmp/post/limit/new/20261024T213500Z-00010000.md")" 65536
    expect 'identical duplicate is delivered' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver limit' "$POST_TOOL" deliver --from a <"$t/limit")" 'status=0' 'queued'
    printf 'Id: 20261024T213500Z-00020000\nFrom: sender@a\nTo: limit@b\nSubject: nu\0l\n\nbody' >"$t/nul"
    expect 'NUL in header rejected' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver limit' "$POST_TOOL" deliver --from a <"$t/nul")" 'status=2' 'invalid message header'

    echo '[]' >"$t/sessions.json"
    out=$(capture post send remote-dead@b unwoken <<< body)
    expect 'remote exit 3 returned' "$out" 'status=3' 'queued, nobody will wake it: no session'
    remote_id=$(sed -n '2s/ .*//p' <<<"$out")
    expect 'remote exit 3 keeps sent copy' "$(cmp -s "$t/b/tmp/post/remote-dead/new/$remote_id.md" "$t/a/tmp/post/sender/sent/$remote_id.md" && echo identical)" identical

    session ordered working
    message a ordered | sed 's/20261024T213500Z-7f3a0000/20261025T213500Z-00020000/' >"$t/newer"
    message a ordered | sed 's/20261024T213500Z-7f3a0000/20261024T213500Z-00010000/' >"$t/older"
    expect 'newer ordered message delivered' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver ordered' "$POST_TOOL" deliver --from a <"$t/newer")" 'status=0'
    expect 'older ordered message delivered' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver ordered' "$POST_TOOL" deliver --from a <"$t/older")" 'status=0'
    expect 'wait oldest first' "$(DEV_ROOT=$t/b post wait ordered --timeout 0 | awk '{printf "%s ", $1}')" '20261024T213500Z-00010000 20261025T213500Z-00020000'
    expect 'wait leaves mail unread' "$(count "$t/b/tmp/post/ordered/new")" 2
    expect 'read oldest first' "$(DEV_ROOT=$t/b post read ordered | awk '/^== / {printf "%s ", $2}')" '20261024T213500Z-00010000 20261025T213500Z-00020000'
    expect 'read moved both messages' "new=$(count "$t/b/tmp/post/ordered/new") cur=$(count "$t/b/tmp/post/ordered/cur")" 'new=0 cur=2'

    # Nested role names cannot create or replace the parent's control files.
    post wait director --timeout 0 --holder "$$" --kind codex || [[ $? == 1 ]]
    cp "$t/a/tmp/post/director/waiter" "$t/parent-waiter"
    for nested in waiter kind; do
        session "director/$nested" working
        expect 'flat child delivery' "$(capture post send "director/$nested" child <<< body)" 'status=0'
        expect 'flat child stored' "$(count "$t/a/tmp/post/director+$nested/new")" 1
    done
    expect 'parent waiter intact' "$(cmp -s "$t/parent-waiter" "$t/a/tmp/post/director/waiter" && echo intact)" intact
    expect 'parent kind intact' "$(cat "$t/a/tmp/post/director/kind")" codex
    expect 'flat names decoded in list' "$(post list)" 'director/waiter' 'director/kind'
    expect 'non-delivery errors are plain' "$(capture post wait ../bad)" 'post: invalid mailbox name'
}

ids_and_transport() {
    # Reserve before transport and regenerate forced collisions, including one recipient twice.
    cat >"$HOME/.local/bin/od" <<'STUB'
#!/usr/bin/env bash
[[ $* == '-An -N4 -tx1 /dev/urandom' ]]
n=0
[[ ! -f $FIXTURE/od-count ]] || n=$(<"$FIXTURE/od-count")
printf '%s\n' "$((n + 1))" >"$FIXTURE/od-count"
if ((n < 2)); then echo 'aa bb cc dd'; elif ((n == 3)); then echo '00000002'; else printf '%08x\n' "$n"; fi
STUB
    cat >"$HOME/.local/bin/date" <<'STUB'
#!/usr/bin/env bash
if [[ $* == '-u +%Y%m%dT%H%M%SZ' ]]; then echo 20261024T213500Z; else exec /usr/bin/date "$@"; fi
STUB
    chmod 700 "$HOME/.local/bin/od" "$HOME/.local/bin/date"
    session collision-one working
    expect 'first forced id' "$(capture post send --as collision-sender collision-one first <<< body)" 'status=0'
    session collision-two working
    expect 'collision regenerated for other recipient' "$(capture post send --as collision-sender collision-two second <<< body)" 'status=0'
    expect 'both sent copies kept' "$(count "$t/a/tmp/post/collision-sender/sent")" 2
    expect 'same recipient sent again' "$(capture post send --as collision-sender collision-two third <<< body)" 'status=0'
    expect 'three sent copies kept' "$(count "$t/a/tmp/post/collision-sender/sent")" 3
    rm "$HOME/.local/bin/od" "$HOME/.local/bin/date"

    session retry working
    : >"$t/ssh-tries"
    expect 'lost acknowledgement retried successfully' "$(capture env FIXTURE_SSH_MODE=ack-lost "$POST_TOOL" send retry@b retry <<< body)" 'status=0' 'queued'
    expect 'acknowledgement retry made two tries' "$(wc -l <"$t/ssh-tries")" 2
    expect 'acknowledgement retry delivered once' "$(count "$t/b/tmp/post/retry/new")" 1
    DEV_ROOT=$t/b post read retry >/dev/null
    retry_message=$(find "$t/b/tmp/post/retry/cur" -name '*.md')
    expect 'retry in cur also acknowledged' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver retry' "$POST_TOOL" deliver --from a <"$retry_message")" 'status=0'
    printf 'different body\n' >>"$retry_message"
    retry_id=${retry_message##*/}
    expect 'different content refused' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver retry' "$POST_TOOL" deliver --from a <"$t/a/tmp/post/sender/sent/$retry_id")" 'status=2' 'different content'
    : >"$t/ssh-tries"
    expect 'transport exhausted' "$(capture env FIXTURE_SSH_MODE=fail "$POST_TOOL" send --as uncertain retry@b retry <<< body)" 'status=2'
    expect 'three retries after first attempt' "$(wc -l <"$t/ssh-tries")" 4
    expect 'uncertain delivery keeps sent record' "$(count "$t/a/tmp/post/uncertain/sent")" 1
    expect 'refusal' "$(capture env FIXTURE_SSH_MODE=refuse "$POST_TOOL" send --as refused retry@b retry <<< body)" 'status=2'
    expect 'refusal removes sent record' "$(count "$t/a/tmp/post/refused/sent")" 0
    message a wrong-host | sed 's/@b$/@elsewhere/' >"$t/wrong-host"
    expect 'wrong destination machine' "$(capture env DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver wrong-host' "$POST_TOOL" deliver --from a <"$t/wrong-host")" 'status=2' 'recipient machine mismatch'

    # Input and transport deadlines are exercised without waiting for real deadlines.
    cat >"$HOME/.local/bin/timeout" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$1" >>"$FIXTURE/timeouts"
[[ ${FIXTURE_INPUT_TIMEOUT:-0} == 0 || $1 != 30 ]] || exit 124
exec /usr/bin/timeout "$@"
STUB
    chmod 700 "$HOME/.local/bin/timeout"
    expect 'stdin deadline refuses' "$(message a slow | capture env FIXTURE_INPUT_TIMEOUT=1 DEV_ROOT="$t/b" SSH_ORIGINAL_COMMAND='deliver slow' "$POST_TOOL" deliver --from a)" 'status=2' 'cannot read message'
    expect 'transport deadline retries' "$(capture env FIXTURE_SSH_MODE=timeout "$POST_TOOL" send retry@b timeout <<< body)" 'status=2'
    expect 'configured input and transport bounds' "$(sort -u "$t/timeouts")" 30 60
    rm "$HOME/.local/bin/timeout"
    mkdir -p "$t/a/tmp/post/no-sent"
    touch "$t/a/tmp/post/no-sent/sent"
    : >"$t/ssh-tries"
    expect 'sent store failure stops before delivery' "$(capture post send --as no-sent retry@b subject <<< body)" 'status=2' 'cannot create mailbox'
    expect 'sent store failure makes no transport call' "$(wc -l <"$t/ssh-tries")" 0

    session interactive working
    jq 'map(del(.state) | .status="idle")' "$t/sessions.json" >"$t/interactive"
    mv "$t/interactive" "$t/sessions.json"
    expect 'interactive session cannot wake' "$(capture post send interactive subject <<< body)" 'status=3' 'interactive session'
    session newest-name 'done'
    expect 'resume checks newest session of name' "$(capture env FIXTURE_NEW_SESSION=1 "$POST_TOOL" send newest-name subject <<< body)" 'status=3' 'nobody will wake it: done'
    session concurrent 'done'
    : >"$t/resumes"
    FIXTURE_RESUME_DELAY=0.05 post send concurrent first <<< body >"$t/concurrent-1" &
    one=$!
    pids+=("$one")
    FIXTURE_RESUME_DELAY=0.05 post send concurrent second <<< body >"$t/concurrent-2" &
    two=$!
    pids+=("$two")
    wait "$one" "$two"
    pids=()
    expect 'concurrent delivery resumes once' "$(wc -l <"$t/resumes")" 2
    expect 'both concurrent messages delivered' "$(count "$t/a/tmp/post/concurrent/new")" 2
}

# The parts share nothing, so they run at once; each reports its checks and failures.
parts=(local_and_remote wake waiters_and_limits names_and_order ids_and_transport)
for part in "${parts[@]}"; do
    (
        pids=()
        trap stop_children EXIT
        fixture "$root/$part"
        "$part"
        echo "$checks $failed" >"$root/$part.result"
    ) >"$root/$part.log" 2>&1 &
    pids+=("$!")
done
for index in "${!parts[@]}"; do
    part=${parts[index]}
    wait "${pids[index]}" || echo "test-post: part $part exited $?"
    cat "$root/$part.log"
    if [[ -f $root/$part.result ]] && read -r part_checks part_failed <"$root/$part.result"; then
        checks=$((checks + part_checks))
        ((part_failed == 0)) || failed=1
    else
        echo "test-post: part $part did not finish"
        failed=1
    fi
done
pids=()

elapsed=$(awk -v start="$started" -v end="$(date +%s.%N)" 'BEGIN {printf "%.3f", end-start}')
expect 'fixture under fifteen seconds' "$(awk -v elapsed="$elapsed" 'BEGIN {print elapsed < 15 ? "yes" : "no"}')" yes
((failed == 0)) || exit 1
echo "test-post: $checks checks passed in ${elapsed}s"
