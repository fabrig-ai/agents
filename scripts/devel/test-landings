def cleared_set(lab):
    landed_set(lab)
    lab.append(tier_record('verdict'),
               tier_record('verdict', tier='temper', commit='b' * 40,
                           flakes=['process temper::process tests::slow']))
    out = lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0').stdout
    assert out.splitlines() == [
        '10-26 05:00Z jig aaaaaaaaa cleared by run aaaaaaaaa',
        '10-26 05:00Z temper bbbbbbbbb cleared by run bbbbbbbbb; flakes: process temper::process tests::slow'], out
    # A newer red of the same landing wins, but unrelated tiers do not.
    lab.append(tier_record('verdict', tier='other', verdict='red', tests=['unrelated'], excerpt='x'),
               tier_record('verdict', minute=1, verdict='red', tests=['regression'], excerpt='failed'))
    assert 'red by run' in lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', status=1).stdout


def red_set(lab):
    landed_set(lab)
    lab.append(tier_record('verdict', tier='temper', commit='b' * 40),
               tier_record('verdict', verdict='red', tests=['browser jig::browser tests::sign_in'],
                           excerpt='first failure\nsecond failure'))
    out = lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', status=1).stdout
    assert 'jig aaaaaaaaa red by run aaaaaaaaa: browser jig::browser tests::sign_in; log fixture-host:/fixture/log' in out, out
    assert '    first failure\n    second failure\n' in out and 'temper bbbbbbbbb cleared' in out, out
    # Red decides immediately even if the other landing has no verdict.
    lab.feed.write_text('')
    landed_set(lab)
    lab.append(tier_record('verdict', verdict='red', tests=['*'], excerpt='crash'))
    lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', status=1)


