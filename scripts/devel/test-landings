def remote_command(lab):
    lab.append(record(event='done'))
    lab.ssh("sys.stdout.buffer.write(Path(os.environ['FIXTURE_FEED']).read_bytes())\n")
    env = dict(lab.env)
    del env['LANDINGS_FEED']
    assert lab.run(env=env).stdout.splitlines() == ['10-24 12:00Z fixture/m1 done fixture-host', 'in flight: none', 'tiers: none in the feed']
    tree = ast.parse(SCRIPT.with_name('land-set').read_text())
    ssh = next(ast.literal_eval(node.value) for node in tree.body
               if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == 'SSH'
                                                       for t in node.targets))
    assert json.loads(lab.trace.read_text()) == [*ssh[1:],
        'tail -n 5000 /home/free/.local/state/agents-land-set/feed.jsonl']


