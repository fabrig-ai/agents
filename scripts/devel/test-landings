def run_case(case):
    with tempfile.TemporaryDirectory(prefix='landings-fixture-') as directory:
        lab = Lab(Path(directory))
        case_start = time.monotonic()
        case(lab)
        if not case.__name__.startswith('remote_'):
            assert not lab.trace.exists(), 'local fixture attempted ssh'
        return time.monotonic() - case_start


def read_default(lab):
    # The fixtures shorten the first read; the tool itself must still default to 15 s.
    tree = ast.parse(SCRIPT.read_text())
    defaults = [ast.literal_eval(node.args[1]) for node in ast.walk(tree)
                if isinstance(node, ast.Call) and len(node.args) == 2
                and isinstance(node.args[0], ast.Constant) and node.args[0].value == 'LANDINGS_READ']
    assert defaults == ['15'], defaults


