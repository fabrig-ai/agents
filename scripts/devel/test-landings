def hung_fetch_ends_at_the_timeout(lab):
    lab.repository('temper')
    commit = lab.land('temper', 'older landing')
    main = lab.advance('temper', 'baseline')
    lab.append(*tier_run('temper', main, None, 10, [(main, [])], baseline=True))
    pid_file = lab.root / 'child.pid'
    parent_file = lab.root / 'parent.pid'
    child = (f'from pathlib import Path; import os, signal; '
             f'Path({str(pid_file)!r}).write_text(str(os.getpid())); signal.pause()')
    lab.standin_git("if sys.argv[3] == 'fetch':\n"
                    f'    Path({str(parent_file)!r}).write_text(str(os.getpid()))\n'
                    f'    subprocess.Popen([sys.executable, "-c", {child!r}])\n'
                    '    import signal; signal.pause()\n')
    timeout_file = lab.root / 'fetch-timeout'
    # Check the five-second floor where it bounds the Git read. Interpreter
    # startup and unrelated ancestry queries are honest work, not that bound.
    hook = f'''
import time
from pathlib import Path
original = tool['subprocess'].Popen
def spawn(argv, **kwargs):
    process = original(argv, **kwargs)
    if len(argv) > 3 and argv[3] == 'fetch':
        paths = [Path({str(pid_file)!r}), Path({str(parent_file)!r})]
        deadline = time.monotonic() + {HUNG_LANDINGS_S}
        while not all(path.exists() and path.read_text().isdigit() for path in paths):
            assert process.poll() is None and time.monotonic() < deadline, 'fetch fixture startup'
            time.sleep(.01)
        communicate = process.communicate
        def observed(*args, timeout=None, **kwargs):
            if timeout is not None:
                assert timeout == 5, timeout
                Path({str(timeout_file)!r}).write_text(str(timeout))
            return communicate(*args, timeout=timeout, **kwargs)
        process.communicate = observed
    return process
tool['subprocess'].Popen = spawn
'''
    try:
        result = lab.run('wait', '--cleared', commit[:9], '--timeout', '0', status=3, code=hook)
        assert float(timeout_file.read_text()) == 5
        assert result.stdout == '' and result.stderr == (
            f'landings: timed out waiting for {commit[:9]}\nlandings: no verdict for temper {commit}\n'), result
        for path in (pid_file, parent_file):
            pid = int(path.read_text())
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                continue
            raise AssertionError(f'stand-in process {pid} survived the timeout')
    finally:
        if parent_file.exists():
            try:
                os.killpg(int(parent_file.read_text()), 9)
            except ProcessLookupError:
                pass


