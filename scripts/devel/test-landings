def remote_first_read(lab):
    # A delayed stand-in exceeds tiny user deadlines but gets a full first read.
    lab.ssh("with Path(os.environ['FIXTURE_FEED']).with_suffix('.reads').open('a') as out:\n"
            "    out.write('read\\n')\n"
            "time.sleep(.08)\nsys.stdout.buffer.write(Path(os.environ['FIXTURE_FEED']).read_bytes())\n")
    # A first read far longer than the stand-in's delay, however slow its start-up under load.
    env = dict(lab.env, LANDINGS_READ=str(HUNG_LANDINGS_S))
    del env['LANDINGS_FEED']
    reads = 0
    for timeout_value in ('0', '.01'):
        for event, status in (('done', 0), ('stopped', 1), ('waiting', 3)):
            lab.feed.write_text('')
            lab.append(record(event='started'), record(event=event, status=7, reason='fixture'))
            result = lab.run('wait', 'fixture/m1', '--timeout', timeout_value, status=status, env=env)
            reads += 1
            assert lab.feed.with_suffix('.reads').read_text().splitlines() == ['read'] * reads
            if status == 1:
                assert 'status=7 reason=fixture' in result.stdout, result
            elif status == 3:
                assert 'timed out' in result.stderr, result


