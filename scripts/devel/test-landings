def record(label='fixture/m1', event='waiting', token='run1', minute=0, **extra):
    row = dict(time=f'2026-10-24T12:{minute:02d}:00+00:00', set=label,
               host='fixture-host', token=token)
    row.update(extra)
    if event is not None:
        row['event'] = event
    return row


def tier_record(event='tier', tier='jig', commit='a' * 40, minute=0, **extra):
    row = dict(time=f'2026-10-26T05:{minute:02d}:00+00:00', kind='tier', event=event,
               host='fixture-host', token='1a2b3c4d' * 4, tier=tier, commit=commit)
    fields = {
        'tier': dict(state='green', last_green=commit, reds=[], flakes=[], ran_s=1.5, log='/fixture/log'),
        'running': {'from': None},
        'verdict': dict(run=commit, verdict='cleared', tests=[], flakes=[], landing_set=None, log='/fixture/log'),
        'fault': dict(reason='lacks chromium', since=row['time']),
        'recovered': dict(since=row['time']),
    }
    row.update(fields.get(event, {}))
    row.update(extra)
    return row


def tier_run(tier, main, start, minute, landings, baseline=False):
    token = main[:32]
    rows = [tier_record('running', tier, main, minute, token=token, **{'from': start})]
    reds = []
    for commit, tests in landings:
        rows.append(tier_record('verdict', tier, commit, minute, token=token, run=main,
                                verdict='red' if tests else 'cleared', tests=tests,
                                excerpt='first failure\nsecond failure' if tests else '',
                                baseline=baseline))
        if tests:
            reds.append(dict(landing=commit, tests=tests))
    rows.append(tier_record('tier', tier, main, minute, token=token, baseline=baseline,
                            state='red' if reds else 'green', reds=reds))
    return rows


class Lab:
    def __init__(self, root):
        self.root = root
        self.feed = root / 'feed.jsonl'
        self.feed.touch()
        self.trace = root / 'ssh.json'
        self.bin = root / 'bin'
        self.bin.mkdir()
        self.workspace = root / 'workspace'
        self.workspace.mkdir()
        self.env = dict({key: value for key, value in os.environ.items()
                         if not key.startswith('GIT_') and key != 'LANDINGS_READ'},
                        DEV_ROOT=str(self.workspace),
                        GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL='/dev/null',
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@example.invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@example.invalid',
                        LANDINGS_FEED=str(self.feed), LANDINGS_POLL='.02',
                        LANDINGS_UNREACHABLE='.20', LANDINGS_FIXTURE_HOSTNAME='fixture-remote',
                        PATH=str(self.bin) + ':' + os.environ['PATH'],
                        FIXTURE_TRACE=str(self.trace), FIXTURE_FEED=str(self.feed))
        # Even an accidental remote read can only reach this rejecting stand-in.
        self.ssh("raise SystemExit('unexpected ssh in local fixture')\n")
        self.env['GIT_SSH_COMMAND'] = str(self.bin / 'ssh')

    def git(self, cwd, *args):
        result = subprocess.run(['git', '-C', str(cwd), *map(str, args)], env=self.env,
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True, timeout=HUNG_TOOL_S)
        assert result.returncode == 0, (args, result.stdout, result.stderr)
        return result.stdout.strip()

    def repository(self, name, tier=True):
        origins = self.root / 'origins'
        origins.mkdir(exist_ok=True)
        origin = origins / (name + '.git')
        work = self.workspace / name
        self.git(self.root, 'init', '--quiet', '--bare', '--initial-branch=main', origin)
        self.git(self.root, 'clone', '--quiet', origin, work)
        if tier:
            (work / 'scripts').mkdir()
            (work / 'scripts/after-landing.sh').write_text('#!/bin/sh\nexit 0\n')
        self.git(work, 'add', '.')
        self.git(work, 'commit', '--quiet', '--allow-empty', '-m', 'initial')
        self.git(work, 'push', '--quiet', 'origin', 'main')
        self.git(self.root, 'clone', '--quiet', origin, self.root / ('world-' + name))

    def commit(self, name, message, world=False, push=True):
        work = self.root / ('world-' + name) if world else self.workspace / name
        self.git(work, 'fetch', '--quiet', 'origin', 'main')
        self.git(work, 'checkout', '--quiet', '-B', 'main' if push else 'unlanded', 'origin/main')
        self.git(work, 'commit', '--quiet', '--allow-empty', '-m', message)
        commit = self.git(work, 'rev-parse', 'HEAD')
        if push:
            self.git(work, 'push', '--quiet', 'origin', 'main')
        return commit

    def land(self, name, message):
        return self.commit(name, message)

    def advance(self, name, message):
        return self.commit(name, message, world=True)

    def unlanded(self, name, message):
        return self.commit(name, message, push=False)

    def standin_git(self, body):
        real = shutil.which('git', path=self.env['PATH'])
        script = self.bin / 'git'
        script.write_text(f'#!{PYTHON}\nimport json, os, subprocess, sys, time\nfrom pathlib import Path\n'
                          f'with Path({str(self.root / "git.jsonl")!r}).open("a") as out:\n'
                          '    out.write(json.dumps(sys.argv[1:]) + "\\n")\n' + body +
                          f'os.execv({real!r}, [{real!r}, *sys.argv[1:]])\n')
        script.chmod(0o700)

    def ssh(self, body):
        script = self.bin / 'ssh'
        script.write_text(f'#!{PYTHON}\nimport json, os, sys, time\nfrom pathlib import Path\n'
                          "Path(os.environ['FIXTURE_TRACE']).write_text(json.dumps(sys.argv[1:]))\n"
                          + body)
        script.chmod(0o700)

    def append(self, *rows):
        with self.feed.open('a') as out:
            for row in rows:
                out.write(json.dumps(row) + '\n')

    def run(self, *args, status=0, env=None, code=None):
        command = [PYTHON, '-I', str(SCRIPT), *args]
        if code is not None:
            driver = ('import runpy, sys\n'
                      f'tool = runpy.run_path({str(SCRIPT)!r})\n' + code +
                      '\nraise SystemExit(tool["main"]())\n')
            command = [PYTHON, '-I', '-S', '-c', driver, *args]
        result = subprocess.run(command, cwd=self.root,
                                env=env or self.env, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=HUNG_LANDINGS_S)
        assert result.returncode == status, (result.returncode, result.stdout, result.stderr)
        return result

    def following(self, rows, status=0, before=None, cleared=False):
        # However late the append comes under load, an unreadable feed is not yet unreachable.
        env = dict(self.env, LANDINGS_UNREACHABLE=str(HUNG_LANDINGS_S))
        with subprocess.Popen([PYTHON, '-I', str(SCRIPT), 'wait', 'fixture/m1', '--timeout', str(HUNG_LANDINGS_S),
                               *(['--cleared'] if cleared else [])],
                              cwd=self.root, env=env, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True) as proc:
            try:
                time.sleep(.12)
                assert proc.poll() is None, 'wait returned before appended records'
                if before:
                    before()
                self.append(*rows)
                out, err = proc.communicate(timeout=HUNG_TOOL_S)
                assert proc.returncode == status, (proc.returncode, out, err)
                return out
            finally:
                if proc.poll() is None:
                    proc.kill()
                    proc.wait()


def status_view(lab):
    lab.append(record(event=None, token='legacy', repo='old-repo', commit='0123456789abcdef'),
               record('done', 'started', 'done-run', 1),
               record('done', 'landed', 'done-run', 2, repo='skein', commit='a' * 40),
               record('done', 'done', 'done-run', 3),
               record('stopped', 'stopped', 'stop-run', 4, status=7, repo='smith', reason='gate failed'),
               record('running', 'waiting', 'run', 5),
               record('running', 'started', 'run', 6),
               record('running', 'gated', 'run', 7, repo='jig', commit='b' * 40),
               record('waiting', 'waiting', 'wait', 8))
    output = lab.run().stdout
    lines = output.splitlines()
    assert lines.pop() == 'tiers: none in the feed', output
    assert lines[:5] == [
        '10-24 12:00Z fixture/m1 landed old-repo 012345678 fixture-host',
        '10-24 12:01Z done started fixture-host',
        '10-24 12:02Z done landed skein aaaaaaaaa fixture-host',
        '10-24 12:03Z done done fixture-host',
        '10-24 12:04Z stopped stopped smith status=7 reason=gate failed fixture-host'], output
    assert lines[-2:] == [
        '  running: running (holds set lock) since 2026-10-24T12:06:00+00:00 on fixture-host; last event 12:07Z; last gated jig bbbbbbbbb',
        '  waiting: waiting since 2026-10-24T12:08:00+00:00 on fixture-host; last event 12:08Z'], output
    assert 'in flight:' in lines and len(lines) == 12, output


