def tiers_shown(lab):
    lab.append(record(event='started'), record(event='done'))
    baseline = lab.run('report').stdout
    assert lab.run('--last', '0').stdout.endswith('tiers: none in the feed\n')
    lab.append(tier_record(tier='skein', commit='1a2b3c4d5' + '0' * 31, minute=12),
               tier_record(commit='4d5e6f7a8' + '0' * 31, minute=1),
               tier_record('running', commit='9f8e7d6c5' + '0' * 31, minute=20),
               tier_record(tier='temper', commit='7e8f9a0b1' + '0' * 31, minute=0),
               tier_record('verdict', tier='temper', commit='0a1b2c3d4' + '0' * 31, minute=29,
                           verdict='red', tests=['case one', 'case two'], excerpt='failed', landing_set='case-5/m3'),
               tier_record(tier='temper', commit='3c4d5e6f7' + '0' * 31, minute=31, state='red',
                           last_green='7e8f9a0b1' + '0' * 31,
                           reds=[dict(landing='0a1b2c3d4' + '0' * 31, tests=['case one', 'case two'])]),
               tier_record(tier='hearth', minute=1, state='red', last_green=None,
                           reds=[dict(landing=None, tests=['*'])]),
               tier_record('fault', tier='hearth', minute=2))
    assert lab.run('--last', '0').stdout.splitlines() == [
        'in flight: none', 'tiers:',
        '  skein: green at 1a2b3c4d5 (10-26 05:12Z)',
        '  hearth: fault since 05:02Z: lacks chromium; red at aaaaaaaaa (10-26 05:01Z): 1 tests',
        '  jig: running on 9f8e7d6c5 since 05:20Z; green at 4d5e6f7a8 (10-26 05:01Z)',
        '  temper: red at 3c4d5e6f7 (10-26 05:31Z): 2 tests, first red 0a1b2c3d4 (case-5/m3); green at 7e8f9a0b1 (10-26 05:00Z)']
    assert lab.run('report').stdout == baseline
    lab.append(tier_record('recovered', tier='hearth', minute=3))
    assert 'hearth: red at aaaaaaaaa' in lab.run('--last', '0').stdout
    assert 'hearth: fault' not in lab.run('--last', '0').stdout
    # Timestamps, then feed order, decide which state supersedes another.
    lab.append(tier_record('fault', minute=3), tier_record(minute=21))
    assert 'jig: green at aaaaaaaaa (10-26 05:21Z)' in lab.run('--last', '0').stdout
    lab.append(tier_record('running', tier='zebra', minute=1),
               tier_record('fault', tier='alpha', minute=1, commit=None))
    lines = lab.run('--last', '0').stdout.splitlines()
    assert lines[-2].startswith('  alpha: fault') and lines[-1].startswith('  zebra: running'), lines
    lab.append(tier_record(minute=22, state='red', last_green=None,
                           reds=[dict(landing=None, tests=['first'], tests_more=50)]))
    assert '51 tests' in lab.run('--last', '0').stdout
    # Verdict publication can be reversed; the landing timestamps decide oldest.
    lab.append(record(event='landed', repo='jig', commit='b' * 40, minute=1),
               record(event='landed', repo='jig', commit='c' * 40, minute=2),
               tier_record('verdict', commit='c' * 40, minute=23, landing_set='later/m1'),
               tier_record('verdict', commit='b' * 40, minute=24),
               tier_record('verdict', commit='b' * 40, minute=25, landing_set='earlier/m1'),
               tier_record(minute=26, state='red', last_green=None,
                           reds=[dict(landing='c' * 40, tests=['later']),
                                 dict(landing='b' * 40, tests=['earlier'])]))
    assert '2 tests, first red bbbbbbbbb (earlier/m1)' in lab.run('--last', '0').stdout


