# The first read's deadline, which remote_hang waits out.
READ = '1'


def record(label='fixture/m1', event='waiting', token='run1', minute=0, **extra):
    row = dict(time=f'2026-10-24T12:{minute:02d}:00+00:00', set=label,
               host='fixture-host', token=token, **extra)
    if event is not None:
        row['event'] = event
    return row


def tier_record(event='tier', tier='jig', commit='a' * 40, minute=0, **extra):
    row = dict(time=f'2026-10-26T05:{minute:02d}:00+00:00', kind='tier', event=event,
               host='fixture-host', token='1a2b3c4d' * 4, tier=tier, commit=commit)
    fields = {
        'tier': dict(state='green', last_green=commit, reds=[], flakes=[], ran_s=1.5, log='/fixture/log'),
        'running': {'from': None},
        'verdict': dict(run=commit, verdict='cleared', tests=[], flakes=[], landing_set=None, log='/fixture/log'),
        'fault': dict(reason='lacks chromium', since=row['time']),
        'recovered': dict(since=row['time']),
    }
    row.update(fields.get(event, {}))
    row.update(extra)
    return row


class Lab:
    def __init__(self, root):
        self.root = root
        self.feed = root / 'feed.jsonl'
        self.feed.touch()
        self.trace = root / 'ssh.json'
        self.bin = root / 'bin'
        self.bin.mkdir()
        self.env = dict(os.environ, LANDINGS_FEED=str(self.feed), LANDINGS_POLL='.02',
                        LANDINGS_UNREACHABLE='.20', LANDINGS_READ=READ, LANDINGS_FIXTURE_HOSTNAME='fixture-remote',
                        PATH=str(self.bin) + ':' + os.environ['PATH'],
                        FIXTURE_TRACE=str(self.trace), FIXTURE_FEED=str(self.feed))
        # Even an accidental remote read can only reach this rejecting stand-in.
        self.ssh("raise SystemExit('unexpected ssh in local fixture')\n")

    def ssh(self, body):
        script = self.bin / 'ssh'
        script.write_text(f'#!{PYTHON}\nimport json, os, sys, time\nfrom pathlib import Path\n'
                          "Path(os.environ['FIXTURE_TRACE']).write_text(json.dumps(sys.argv[1:]))\n"
                          + body)
        script.chmod(0o700)

    def append(self, *rows):
        with self.feed.open('a') as out:
            for row in rows:
                out.write(json.dumps(row) + '\n')

    def run(self, *args, status=0, env=None):
        result = subprocess.run([PYTHON, '-I', str(SCRIPT), *args], cwd=self.root,
                                env=env or self.env, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=20)
        assert result.returncode == status, (result.returncode, result.stdout, result.stderr)
        return result

    def following(self, rows, status=0, before=None):
        # However late the append comes under load, an unreadable feed is not yet unreachable.
        env = dict(self.env, LANDINGS_UNREACHABLE='30')
        with subprocess.Popen([PYTHON, '-I', str(SCRIPT), 'wait', 'fixture/m1', '--timeout', '20'],
                              cwd=self.root, env=env, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True) as proc:
            try:
                time.sleep(.12)
                assert proc.poll() is None, 'wait returned before appended records'
                if before:
                    before()
                self.append(*rows)
                out, err = proc.communicate(timeout=25)
                assert proc.returncode == status, (proc.returncode, out, err)
                return out
            finally:
                if proc.poll() is None:
                    proc.kill()
                    proc.wait()


def status_view(lab):
    lab.append(record(event=None, token='legacy', repo='old-repo', commit='0123456789abcdef'),
               record('done', 'started', 'done-run', 1),
               record('done', 'landed', 'done-run', 2, repo='skein', commit='a' * 40),
               record('done', 'done', 'done-run', 3),
               record('stopped', 'stopped', 'stop-run', 4, status=7, repo='smith', reason='gate failed'),
               record('running', 'waiting', 'run', 5),
               record('running', 'started', 'run', 6),
               record('running', 'gated', 'run', 7, repo='jig', commit='b' * 40),
               record('waiting', 'waiting', 'wait', 8))
