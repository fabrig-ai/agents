    tip = lab.land('temper', 'set landing')
    extra = ({'base': base} if field == 'base' else
             {'result': dict(base=base, commit=tip, pushed=True)} if field == 'result' else {})
    lab.append(record(event='started'),
               record(event='landed', repo='temper', commit=tip, **extra), record(event='done'),
               *tier_run('temper', tip, base, 10, [(resolver, list(resolver_tests)), (tip, list(tip_tests))]))
