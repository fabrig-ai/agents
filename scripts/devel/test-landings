def stopped_run_superseded(lab):
    # A new landing or proof supersedes a stop; a successful proof still waits for landing.
    for start in ('waiting', 'started', 'proving'):
        lab.feed.write_text('')
        lab.append(record(event='proving', mode='prove'),
                   record(event='stopped', mode='prove', status=4, repo='jig', reason='old stop'),
                   record(event=start, token='retry', minute=1))
        for flags in (['--cleared'], []):
            result = lab.run('wait', *flags, 'fixture/m1', '--timeout', '0', status=3)
            assert result.stdout == '', result
        if start == 'proving':
            lab.append(record(event='proved', token='retry', minute=2, mode='prove'))
            for flags in (['--cleared'], []):
                lab.run('wait', *flags, 'fixture/m1', '--timeout', '0', status=3)
        lab.append(record(event='waiting', token='land', minute=3),
                   record(event='done', token='land', minute=4))
        for flags in (['--cleared'], []):
            lab.run('wait', *flags, 'fixture/m1', '--timeout', '0')
    # A new proof also supersedes a stopped landing, despite its late terminal event.
    lab.feed.write_text('')
    lab.append(record(event='started', token='old'),
               record(event='proving', token='new', minute=1, mode='prove'),
               record(event='stopped', token='old', minute=2, status=4, reason='late stop'),
               record('other', 'proving', 'other', 3, mode='prove'),
               record('other', 'stopped', 'other', 4, mode='prove', reason='other stop'),
               record(event='stopped', token='truncated', minute=5, mode='prove', reason='lost start'))
    for flags in (['--cleared'], []):
        result = lab.run('wait', *flags, 'fixture/m1', '--timeout', '0', status=3)
        assert result.stdout == '', result


def waits_for_verdict(lab):
    landed_set(lab)
    lab.append(tier_record('verdict'))
    result = lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '.3', status=3)
    assert 'no verdict for temper ' + 'b' * 40 in result.stderr, result
    assert 'no verdict for jig' not in result.stderr, result
    with subprocess.Popen([PYTHON, '-I', '-B', str(SCRIPT), 'wait', '--cleared', 'fixture/m1', '--timeout', '10'],
                          cwd=lab.root, env=lab.env, stdin=subprocess.DEVNULL,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True) as proc:
        try:
            time.sleep(.12)
            assert proc.poll() is None, 'returned before missing verdict'
            lab.append(tier_record('verdict', tier='temper', commit='b' * 40))
            out, err = proc.communicate(timeout=HUNG_TOOL_S)
            assert proc.returncode == 0 and 'jig aaaaaaaaa cleared' in out and 'temper bbbbbbbbb cleared' in out, (out, err)
        finally:
            if proc.poll() is None:
                proc.kill()
                proc.wait()
    # The latest landing run is the only one waited on.
    lab.append(record(event='waiting', token='retry'))
    lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', status=3)
    lab.append(record(event='landed', token='retry', repo='skein', commit='c' * 40),
               record(event='done', token='retry'))
    assert 'no verdict for skein ' + 'c' * 40 in lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', status=3).stderr


