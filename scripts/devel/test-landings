    out = lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', status=1).stdout
    assert out == '10-24 12:00Z fixture/m1 stopped status=6 reason=fixture stopped fixture-host\n', out


def waits_for_verdict(lab):
    landed_set(lab)
    lab.append(tier_record('verdict'))
    result = lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '.3', status=3)
    assert 'no verdict for temper ' + 'b' * 40 in result.stderr, result
    assert 'no verdict for jig' not in result.stderr, result
    with subprocess.Popen([PYTHON, '-I', '-B', str(SCRIPT), 'wait', '--cleared', 'fixture/m1', '--timeout', '10'],
                          cwd=lab.root, env=lab.env, stdin=subprocess.DEVNULL,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True) as proc:
        try:
            time.sleep(.12)
            assert proc.poll() is None, 'returned before missing verdict'
            lab.append(tier_record('verdict', tier='temper', commit='b' * 40))
            out, err = proc.communicate(timeout=15)
            assert proc.returncode == 0 and 'jig aaaaaaaaa cleared' in out and 'temper bbbbbbbbb cleared' in out, (out, err)
        finally:
            if proc.poll() is None:
                proc.kill()
                proc.wait()
    # The latest landing run is the only one waited on.
    lab.append(record(event='waiting', token='retry'))
    lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', status=3)
    lab.append(record(event='landed', token='retry', repo='skein', commit='c' * 40),
               record(event='done', token='retry'))
    assert 'no verdict for skein ' + 'c' * 40 in lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', status=3).stderr


def commit_target(lab):
    lab.append(tier_record('verdict'),
               tier_record('verdict', tier='temper', commit='b' * 40, verdict='red', tests=['*'], excerpt='boom'))
    assert 'cleared by run' in lab.run('wait', '--cleared', 'a' * 9, '--timeout', '0').stdout
    assert 'red by run' in lab.run('wait', '--cleared', 'b' * 9, '--timeout', '0', status=1).stdout
    lab.run('wait', '--cleared', 'c' * 9, '--timeout', '0', status=3)
    # Every tier's verdict participates in a commit target.
    lab.append(tier_record('verdict', tier='skein', verdict='red', tests=['*'], excerpt='other tier'))
    lab.run('wait', '--cleared', 'A' * 9, '--timeout', '0', status=1)


def watch_record(lab):
    lab.append(record(event='started'), record(event='done'))
    baseline = lab.run('report').stdout
    lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', env=dict(lab.env, POST_NAME='owner-fixture'))
    rows = [json.loads(line) for line in lab.feed.read_text().splitlines()]
    watches = [r for r in rows if r.get('kind') == 'watch']
    assert len(watches) == 1, rows
    row = watches[0]
    assert row['event'] == 'watching' and row['target'] == 'fixture/m1' and row['name'] == 'owner-fixture', row
    assert re.fullmatch('[0-9a-f]{32}', row['token']) and row['time'] and row['host'], row
    assert lab.run('report').stdout == baseline
    lab.run('wait', 'fixture/m1', '--timeout', '0')
    assert len(lab.feed.read_text().splitlines()) == 3
    env = dict(lab.env)
    env.pop('POST_NAME', None)
    lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', env=env)
    newer = json.loads(lab.feed.read_text().splitlines()[-1])
    assert newer['name'] is None and newer['token'] != row['token'], newer
    # The writer's failed append warns; the wait still reads and decides.
    lab.bin.joinpath('python3').write_text('#!/bin/sh\nexit 9\n')
    lab.bin.joinpath('python3').chmod(0o700)
    result = lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0')
    assert 'warning: feed append failed' in result.stderr, result


def malformed_runner_records(lab):
    baseline = lab.run().stdout
    rows = [tier_record(), tier_record('running'), tier_record('verdict'), tier_record('fault'),
            dict(time='2026-10-26T05:00:00Z', kind='watch', event='watching', host='fixture',
                 token='a' * 32, target='fixture/m1', name=None)]
    for row in rows:
        for key in row:
            bad = dict(row)
            del bad[key]
            # Unknown/missing kind follows the original set reader, which still requires set.
            lab.append(bad)
            lab.append(dict(row, **{key: {} if isinstance(row[key], list) else []}))
    lab.append(tier_record(ran_s=True), tier_record(ran_s=-1), tier_record(ran_s=float('nan')),
               tier_record(reds=[dict(landing=[], tests=[])]), tier_record(flakes=[1]),
               tier_record(reds=[dict(landing=None, tests=[], tests_more='bad')]),
               tier_record('verdict', excerpt=[]),
               tier_record('verdict', tests=[1]), tier_record('verdict', verdict='unknown'),
               tier_record('verdict', verdict='red'), tier_record('running', **{'from': 1}),
               tier_record('fault', since='bad'), tier_record(time='2026-10-26T05:00:00'),
               tier_record(tests_more=True), tier_record(flakes_more=-1))
    output = lab.run().stdout
    assert output == baseline, output
    assert lab.run('report').stdout == 'no results\n\nno set runs\n'


def posted_wait(lab):
    post = lab.bin / 'post'
    post.write_text(f'#!{PYTHON}\n' + r'''import json, os, sys
from pathlib import Path
assert sys.argv[1:5] == ['send', '--as', 'landings', 'owner@fixture'], sys.argv
with Path(os.environ['FIXTURE_FEED']).with_suffix('.posts').open('a') as out:
    out.write(json.dumps(dict(subject=sys.argv[5], body=Path(sys.argv[6]).read_text())) + '\n')
sys.exit(int(os.environ.get('FIXTURE_POST_EXIT', '0')))
''')
    post.chmod(0o700)
    landed_set(lab)
    lab.append(tier_record('verdict'), tier_record('verdict', tier='temper', commit='b' * 40))
    scenarios = [('cleared', 0), ('red', 1), ('timed out', 3), ('stopped', 1), ('feed unreadable', 4)]
    for index, (outcome, status) in enumerate(scenarios):
        if outcome == 'red':
            lab.append(tier_record('verdict', minute=1, verdict='red', tests=['regression'], excerpt='failure detail'))
        elif outcome == 'timed out':
            lab.feed.write_text('')
        elif outcome == 'stopped':
            lab.append(record(event='started'), record(event='stopped', reason='fixture stop'))
        elif outcome == 'feed unreadable':
            lab.feed.unlink()
        timeout = '1' if outcome == 'feed unreadable' else '0'
        # Ordinary wait can fail to read without a watch recreating the absent file.
        cleared = [] if outcome == 'feed unreadable' else ['--cleared']
        result = lab.run('wait', *cleared, 'fixture/m1', '--timeout', timeout,
                         '--post', 'owner@fixture', status=status)
        posts = [json.loads(line) for line in lab.feed.with_suffix('.posts').read_text().splitlines()]
        assert len(posts) == index + 1, posts
        assert posts[-1] == dict(subject=f'landings: fixture/m1 {outcome}',
                                 body=result.stdout + result.stderr), (posts, result)
    # An undelivered post warns without changing the wait exit; queued exit 3 succeeds.
    lab.feed.touch()
    for code in ('2', '3'):
        result = lab.run('wait', 'absent', '--timeout', '0', '--post', 'owner@fixture', status=3,
                         env=dict(lab.env, FIXTURE_POST_EXIT=code))
        assert ('warning: post failed' in result.stderr) == (code == '2'), result
    post.unlink()
    # A missing executable is also a warning and leaves the wait's status intact.
    post.write_text('#!/missing/fixture-interpreter\n')
    post.chmod(0o700)
    result = lab.run('wait', 'absent', '--timeout', '0', '--post', 'owner@fixture', status=3)
    assert 'warning: post failed' in result.stderr, result


def remote_watch(lab):
    landed_set(lab)
    lab.append(tier_record('verdict'), tier_record('verdict', tier='temper', commit='b' * 40))
    lab.ssh("if sys.argv[-1].startswith('tail '):\n"
            "    sys.stdout.buffer.write(Path(os.environ['FIXTURE_FEED']).read_bytes())\n"
            "else:\n"
            "    with Path(os.environ['FIXTURE_FEED']).open('a') as out:\n"
            "        out.write(sys.stdin.read())\n"
            "    Path(os.environ['FIXTURE_FEED']).with_suffix('.writer').write_text(sys.argv[-1])\n")
    env = dict(lab.env)
    del env['LANDINGS_FEED']
    lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', env=env)
    argv = shlex.split(lab.feed.with_suffix('.writer').read_text())
    tree = ast.parse(SCRIPT.with_name('land-set').read_text())
    program = next(ast.literal_eval(n.value) for n in tree.body if isinstance(n, ast.Assign)
                   and any(isinstance(t, ast.Name) and t.id == 'FEED' for t in n.targets))
    assert argv == ['python3', '-I', '-c', program, '/home/free/.local/state/agents-land-set/feed.jsonl'], argv
    rows = [json.loads(line) for line in lab.feed.read_text().splitlines()]
    assert sum(r.get('kind') == 'watch' for r in rows) == 1, rows
    # A refused append does not mask a successful read.
    lab.ssh("if sys.argv[-1].startswith('tail '):\n"
            "    sys.stdout.buffer.write(Path(os.environ['FIXTURE_FEED']).read_bytes())\n"
            "else:\n"
            "    raise SystemExit('fixture append refused')\n")
    result = lab.run('wait', '--cleared', 'fixture/m1', '--timeout', '0', env=env)
    assert 'warning: feed append failed' in result.stderr, result
    lab.ssh("raise SystemExit('fixture transport failed')\n")
    result = lab.run('wait', '--cleared', 'fixture/m1', status=4, env=env)
    assert 'feed unreadable' in result.stderr and 'fixture transport failed' in result.stderr, result


def main():
    start = time.monotonic()
    cases = (status_view, last_two, already_done, retry_commits, latest_first_line,
             history_only, truncated_start, last_event, proving, report_proves, event_dates,
             appended_done, appended_stopped, absent_then_present, timeout,
             unreadable_status, unreadable_wait, unreadable_recovers,
             timeout_before_unreachable, malformed_lines, remote_command,
             remote_failure, remote_hang, remote_first_read, invalid_arguments, read_default,
             tiers_shown, landing_set_isolation, cleared_set, red_set, stopped_set, waits_for_verdict, commit_target,
             watch_record, malformed_runner_records, posted_wait, remote_watch)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--case', action='append', choices=[case.__name__ for case in cases])
    selected = parser.parse_args().case
    if selected:
        cases = tuple(case for case in cases if case.__name__ in selected)
    # The cases share nothing but the tool, so they run at once; results print in order.
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(cases)) as pool:
        futures = [pool.submit(run_case, case) for case in cases]
        for number, (case, future) in enumerate(zip(cases, futures), 1):
            print(f'ok {number}: {case.__name__} ({future.result():.2f}s)', flush=True)
    print(f'completed {len(cases)} cases in {time.monotonic() - start:.2f}s', flush=True)


if __name__ == '__main__':
    main()
