    assert len(watches) == 1, rows
    row = watches[0]
    assert row['event'] == 'watching' and row['target'] == 'fixture/m1' and row['name'] == 'owner-fixture', row
    assert re.fullmatch('[0-9a-f]{32}', row['token']) and row['time'] and row['host'], row
