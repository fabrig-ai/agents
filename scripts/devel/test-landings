def cleared_main_is_the_newest_all_cleared_run(lab):
    x, y, z = ('a' * 40, 'b' * 40, 'c' * 40)
    lab.append(tier_record('verdict', tier='temper', commit=x),
               tier_record(tier='temper', commit=x, minute=1),
               tier_record('verdict', tier='temper', commit=x, run=y, minute=2),
               tier_record('verdict', tier='temper', commit=y, minute=2,
                           verdict='red', tests=['regression'], excerpt='failed'),
               tier_record(tier='temper', commit=y, minute=3, state='red'))
    result = lab.run('cleared', 'temper')
    assert result.stdout == x + '\n' and result.stderr == '', result
    # Standing reds charged to an older run do not make Z's own verdicts red.
    lab.append(tier_record('verdict', tier='temper', commit=z, minute=4, baseline=True),
               tier_record('verdict', tier='temper', commit='d' * 40, run=z, minute=4),
               tier_record(tier='temper', commit=z, minute=5, state='red',
                           reds=[dict(landing=y, tests=['standing'])]),
               tier_record('verdict', commit='e' * 40, minute=6),
               tier_record(commit='e' * 40, minute=7))
    assert lab.run('cleared', 'temper').stdout == z + '\n'
    # Later feed positions cannot outrank newer timestamps, but break time ties.
    lab.append(tier_record(tier='temper', commit=x, minute=0))
    assert lab.run('cleared', 'temper').stdout == z + '\n'
    lab.append(tier_record(tier='temper', commit=x, minute=5))
    assert lab.run('cleared', 'temper').stdout == x + '\n'
    # A completed run without verdicts and a verdict without an end are ineligible.
    lab.append(tier_record(tier='temper', commit='f' * 40, minute=8),
               tier_record('verdict', tier='temper', commit='0' * 40, minute=9))
    assert lab.run('cleared', 'temper').stdout == x + '\n'


