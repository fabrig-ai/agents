def report_proves(lab):
    gate = lambda kind, run: dict(repo='jig', machine='fixture-host',
                                  prebuild=dict(wait_s=0, run_s=60, exit=0) if kind == 'ran' else None,
                                  gate=dict(kind=kind, wait_s=0, run_s=run, exit=0, steps={}))
    lab.append(record(event='proving', token='p', minute=0, mode='prove'),
               record(event='gated', token='p', minute=4, mode='prove', repo='jig', commit='a' * 40,
                      result=gate('ran', 30)),
               record(event='proved', token='p', minute=5, mode='prove'),
               record(event='waiting', token='l', minute=10),
               record(event='started', token='l', minute=11, proof='p'),
               record(event='gated', token='l', minute=11, repo='jig', commit='a' * 40,
                      result=gate('cached', 0)),
               record(event='landed', token='l', minute=12, repo='jig', commit='a' * 40),
               record(event='done', token='l', minute=12))
    lines = lab.run('report').stdout.splitlines()
    row = lambda first: next(line.split() for line in lines if line.split()[:1] == [first])
    assert row('jig')[1:4] == ['1', '1', '0'], lines  # ran, cached, failed
    sets = lines.index(next(line for line in lines if line.startswith('set runs')))
    proves = lines.index(next(line for line in lines if line.startswith('proves')))
    assert lines[sets + 2].split() == ['fixture/m1', '1', '1', '0', '1', '1:00', '1:00', '1:00', '1:00'], lines
    assert lines[proves + 2].split() == ['fixture/m1', '1', '1', '0', '5:00', '5:00'], lines


def verdict_rows(lab, *args):
    section = lab.run('report', *args).stdout.split("after landing's verdicts", 1)[1]
    return [line.split() for line in section.split('\n\n', 1)[0].splitlines()[2:]]


def verdicts_report_whole(lab):
    at = lambda minute: f'2026-10-26T05:{minute:02d}:00+00:00'
    lab.append(*(record(event='landed', repo='jig', commit=c * 40, time=at(m))
                 for c, m in (('a', 0), ('b', 2), ('c', 10))),
               # A plain land and a repeated set record must keep the earliest time.
               land_record(repo='jig', commit='a' * 40, time=at(1)),
               record(event='landed', repo='jig', commit='a' * 40, time=at(3)),
               tier_record('verdict', commit='a' * 40, minute=4, token='d' * 32, run='d' * 40),
               tier_record('verdict', commit='b' * 40, minute=8, token='d' * 32, run='d' * 40),
               tier_record(commit='d' * 40, minute=8, token='d' * 32, ran_s=120),
               tier_record('verdict', commit='c' * 40, minute=20, token='e' * 32, run='e' * 40),
               tier_record(commit='e' * 40, minute=20, token='e' * 32, ran_s=240))
    assert verdict_rows(lab) == [['jig', '3', '6:00', '10:00', '2', '1.5', '3:00', '4:00']]
    tsv = lab.run('report', '--tsv').stdout
    assert len(tsv.splitlines()) == 1 and tsv.startswith('time\tset\tevent\trepo\t'), tsv


def verdicts_report_parts(lab):
    at = lambda minute: f'2026-10-26T05:{minute:02d}:00+00:00'
    lab.append(record(event='landed', repo='temper', commit='a' * 40, time=at(0)),
               land_record(repo='temper', commit='b' * 40, time=at(10)))
    for tier, minutes, duration in (('temper.1of2', (5, 12), 120), ('temper.2of2', (9, 14), 180)):
        for commit, minute in zip(('a', 'b'), minutes):
            red = tier == 'temper.2of2' and commit == 'b'
            token = ('c' if tier == 'temper.1of2' else 'd') * 31 + commit
            lab.append(tier_record('verdict', tier, commit * 40, minute, token=token,
                                   verdict='red' if red else 'cleared', excerpt='bad' if red else ''),
                       tier_record(tier=tier, minute=minute, token=token, ran_s=duration))
    # Reissued verdicts cannot delay a part's first answer or first clearance.
    lab.append(tier_record('verdict', 'temper.1of2', 'a' * 40, 30, token='c' * 31 + 'a'))
    assert verdict_rows(lab) == [
        ['temper', '2', '6:30', '9:00'],
