    starts = [('long-m', iso(80), '3 d 6 h'), ('hours-m', iso(7.2), '5 h 12 min'),
              ('short-m', iso(2.7), '42 min'), ('unknown-m', 'unknown', '–'),
              ('later-m', iso(1), '–'), ('invalid-m', 'PRIVATE-NOT-A-TIME', '–'),
              ('missing-m', None, '–'), ('equal-m', iso(2), '0 min')]
    for name, started, _ in starts:
        write(lab.records / f'missions/{name}/README.md',
              f'---\nstate: ended\nended: {iso(2)}\ndescription: Ended {name}\n'
              + (f'started: {started}\n' if started is not None else '') + '---\n')
    answer = codex_answer()
    answer['limits']['rateLimitsByLimitId']['codex']['primary']['resetsAt'] = NOW + 42 * 60
    lab.codex(lab.alpha, answer)
    page, data = subscription_page(lab, STATUS_FEED=str(lab.root / 'feed.jsonl'))

    def section(start, end):
        return page[page.index(start):page.index(end)]

    def cells(part):
        return [re.findall(r'<td[^>]*>(.*?)</td>', row)
                for row in re.findall(r'<tr>.*?</tr>', part) if '<td' in row]

    ended = section('<h3>Ended this week</h3>', '<h3>Machines</h3>')
    assert re.findall(r'<th(?: [^>]*)?>(.*?)</th>', ended) == [
        'Mission', 'State', 'Ended', 'Duration', 'Description'], ended
