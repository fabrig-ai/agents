@contextmanager
def forgejo(answers):
    """One case's loopback API, with its requests kept only in this fixture."""
    requests = []

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def do_GET(self):
            url = urlsplit(self.path)
            requests.append((url.path, parse_qs(url.query), dict(self.headers)))
            index = len(requests) - 1
            status, payload, delay = answers[index] if index < len(answers) else (500, {}, 0)
            time.sleep(delay)
            if status == 0:
                self.wfile.write(payload)  # An intentionally malformed HTTP status line.
                return
            body = payload if isinstance(payload, bytes) else json.dumps(payload).encode()
            try:
                self.send_response(status)
                self.send_header('Content-Type', 'application/json')
                self.send_header('Content-Length', str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError):
                pass  # The timeout case has already left.

    server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        yield f'http://127.0.0.1:{server.server_port}', requests
    finally:
        server.shutdown()
        server.server_close()
        thread.join()


def page_user_issues(lab):
    token = 'fixture-token-0123456789'
    token_file = write(lab.alpha / 'git-fabrig/status-read.token', token + '\n', mode=0o600)
    label = (200, {'id': 1, 'name': 'waiting-on-user'}, 0)
    link = ('<a href="https://git.fabrig.ai/fabrig-ai/agents/issues?state=open&amp;labels=1">'
            'open issues on git.fabrig.ai</a>')

    def issue(index, wanted):
        return {'title': f'PRIVATE-TITLE-{index}', 'body': f'PRIVATE-BODY-{index}',
                'user': {'login': 'PRIVATE-AUTHOR'}, 'labels': [{'id': 1 if wanted else 2}]}

    def render(base, value, failure=None):
        out, snapshot = lab.root / 'page.html', lab.root / 'data.json'
        result = lab.run('--no-pull', '--out', str(out), '--json', str(snapshot),
                         STATUS_FORGEJO=base, STATUS_ISSUES_TIMEOUT='1')
        page = out.read_text()
        assert (f'<div class="label">Waiting on the user</div><div class="value">{value}</div>'
                f'<div class="sub">{link}</div>') in page
        assert '<h2>Waiting on the user' not in page
        assert '<div class="label">Missions</div><div class="value">–</div>' not in page
        assert '<div class="label">Missions</div>' in page
        footer = page[page.index('<footer>'):]
        if failure:
            assert failure in footer, footer
            if failure.startswith('user_issues:'):
                assert "no machine reached holds the issues&#x27; token" not in footer
        else:
            assert 'user_issues:' not in footer and 'no machine reached holds the issues' not in footer
        for output in (page, snapshot.read_text(), result.stdout, result.stderr,
                       *(path.read_text() for path in lab.trace.glob('ssh-*'))):
            assert token not in output
            private_absent(output)
        public_roles(page, lab)
        data = json.loads(snapshot.read_text())
        assert set(data['records']) == {'missions'}, data['records']
        assert data['fleet']['beta']['user_issues'] is None
        return data

    pages = [(200, [issue(i, i < 48) for i in range(50)], 0),
             (200, [issue(i, i < 52) for i in range(50, 53)], 0)]
    with forgejo([label, *pages]) as (base, requests):
        data = render(base, '50')
        assert data['fleet']['alpha']['user_issues'] == {'open': 50}
        prefix = '/api/v1/repos/fabrig-ai/agents/'
        assert [(path, query) for path, query, _ in requests] == [
            (prefix + 'labels/1', {}),
            *((prefix + 'issues', {'state': ['open'], 'type': ['issues'], 'labels': ['waiting-on-user'],
                                   'limit': ['50'], 'page': [str(page)]}) for page in (1, 2))], requests
        for _, _, headers in requests:
            assert headers['Authorization'] == 'token ' + token
            assert headers['Accept'] == 'application/json' and headers['User-Agent'] == 'status-page'

    for answers, failure in (([(404, {'message': 'PRIVATE-ERROR'}, 0)], 'HTTP 404'),
                             ([label, (401, {'message': 'PRIVATE-ERROR'}, 0)], 'HTTP 401'),
                             ([(200, label[1], 1.5)], 'timed out'),
                             ([label, (200, {'PRIVATE-WRONG-SHAPE': []}, 0)], 'issues answer')):
        with forgejo(answers) as (base, _):
            render(base, '–', 'user_issues: ' + ('ValueError: ' if failure == 'issues answer' else 'OSError: ') + failure)
    token_file.chmod(0o644)
    with forgejo([]) as (base, requests):
        render(base, '–', 'user_issues: PermissionError: token file readable by others')
        assert requests == []
    token_file.unlink()
    with forgejo([]) as (base, requests):
        render(base, '–', 'waiting on the user: no machine reached holds the issues&#x27; token')
        assert requests == []

    # Collector boundaries beyond the rendered failures: no invalid token is sent,
    # no malformed JSON escapes, and a full twentieth page requires refusal.
    from types import SimpleNamespace
    from unittest.mock import patch
    module = runpy.run_path(str(SCRIPT))
    read = module['part_user_issues']

    def refused(failure, answers):
        with forgejo(answers) as (base, requests), patch.dict(os.environ, STATUS_FORGEJO=base):
            try:
                read(lab.alpha, NOW)
            except (OSError, ValueError) as error:
                assert str(error) == failure, (type(error).__name__, str(error))
                assert token not in str(error)
                private_absent(str(error))
            else:
                raise AssertionError('accepted ' + failure)
            return requests

    for invalid in ('short', 'PRIVATE-invalid token', 'é' * 10):
        write(token_file, invalid, mode=0o600)
        assert refused('token file holds no token', []) == []
    write(token_file, token, mode=0o600)
    for bad_label in ({'id': True, 'name': 'waiting-on-user'}, {'id': 2, 'name': 'waiting-on-user'},
                      {'id': 1, 'name': ''}, [], {'id': 1, 'name': 4}):
        assert len(refused('label answer', [(200, bad_label, 0)])) == 1
    assert len(refused('issues answer', [label, (200, [None], 0)])) == 2
    assert len(refused('label answer', [(200, b'PRIVATE-invalid-json', 0)])) == 1
    assert len(refused('BadStatusLine', [(0, b'PRIVATE-HTTP-STATUS\r\n', 0)])) == 1
    assert len(refused('issues answer', [label, (200, b'PRIVATE-invalid-json', 0)])) == 2
    assert len(refused('more than 20 pages', [label, *([pages[0]] * 20)])) == 21
    # Names are quoted as a single query value, including separators and Unicode.
    with forgejo([(200, {'id': 1, 'name': 'wait & approve/é'}, 0), (200, [], 0)]) as (base, requests):
        with patch.dict(os.environ, STATUS_FORGEJO=base):
            assert read(lab.alpha, NOW) == {'open': 0}
        assert requests[1][1]['labels'] == ['wait & approve/é']

    # Time spent on the label consumes the shared budget before another request.
    with patch.object(module['time'], 'monotonic', side_effect=[0, 0, 31]):
        assert len(refused('timed out', [label])) == 1

    # Fleet order chooses one reading; zero is a count and bad types are missing.
    choose = module['user_issues']
    fleet = SimpleNamespace(names=['down', 'beta', 'alpha'], up={
        'alpha': {'user_issues': {'open': 50}}, 'beta': {'user_issues': {'open': 0}}})
    assert choose(fleet) == 0
    for wrong in (None, [], {'open': True}, {'open': '3'}, {'open': float('nan')}):
        fleet.up['beta']['user_issues'] = wrong
        assert choose(fleet) == 50


