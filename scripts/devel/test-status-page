                        FIXTURE_BETA=str(self.beta), XDG_CONFIG_HOME=str(root / 'config'))

    def claude(self, tmp, answer):
        write(tmp.parent / 'claude.json', json.dumps(answer))

    def codex(self, tmp, answer):
        write(tmp.parent / 'codex.json', json.dumps(answer))

    def run(self, *args, status=0, disk_unavailable=False, **env):
        command = [PYTHON, '-I', str(SCRIPT), *args]
        if disk_unavailable:
            # Leave a valid cwd for the CLIs, while keeping this case's
            # original unavailable-machine-source failure independent of them.
            code = ("import runpy, sys; from unittest.mock import patch; "
                    "mock = patch('shutil.disk_usage', side_effect=OSError('fixture disk unavailable')); "
                    "mock.start(); runpy.run_path(sys.argv.pop(1), run_name='__main__')")
            command = [PYTHON, '-I', '-c', code, str(SCRIPT), *args]
        result = subprocess.run(command, cwd=self.root, env=dict(self.env, **env),
                                stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
        assert result.returncode == status, (result.returncode, result.stdout, result.stderr)
        return result


def collect(lab):
    data = json.loads(lab.run('collect', STATUS_FEED=str(lab.root / 'feed.jsonl')).stdout)
    assert data['errors'] == [], data['errors']
    kinds = [(r[6], r[7], r[5], r[4]) for r in data['rows']]
    assert kinds == [('focused', '', 'alpha-m', '0'), ('clippy', '', 'alpha-m', '101'),
                     ('prebuild', 'skein', 'alpha-m', '0'), ('land', 'skein', 'alpha-m', '0'),
                     ('check', '', 'old-m', '0')], kinds
    tasks = sorted((t['state'], t['kind'], t['repo'], t['mission']) for t in data['heavy']['tasks'])
    assert tasks == [('active', 'workspace', '', 'alpha-m'), ('queued', 'land', 'temper', 'alpha-m')], tasks
    codex = data['codex']
    assert [(r['id'], r['alive'], r['mission']) for r in codex['running']] == [
        ('20261025T110000Z-aaaa', True, 'alpha-m')], codex['running']
    assert [r[2:] for r in codex['ended']] == [['0', 'gpt-x', 'high', [1000, 500, 20], 'alpha-m']], codex['ended']
    assert [(o['name'], o['alive']) for o in codex['owners']] == [('o/alpha-m', True)], codex['owners']
    assert [(m['name'], m['new']) for m in data['mail']] == [('o/alpha-m', 1)], data['mail']
    assert [t[1:] for t in data['turns']['done']] == [['temper', 200, 500], ['smith', 10, 50]], data['turns']
    assert [(t['repo'], t['event']) for t in data['turns']['open']] == [('jig', 'request')], data['turns']
    # An interactive session is someone's own: its name stays here.
    assert [(s['name'], s['kind']) for s in data['sessions']] == [
        ('o/alpha-m', 'background'), ('', 'interactive'), ('', 'claude')], data['sessions']
    assert len(data['feed']) == 13, data['feed']
    # Elsewhere than the coordinator there is no feed, and that is no error.
    assert json.loads(lab.run('collect').stdout)['feed'] is None


def collect_missing(lab):
    """A machine with none of the tools' files still answers, naming what it could not read."""
    (lab.root / 'empty').mkdir()
    data = json.loads(lab.run('collect', DEV_TMP=str(lab.root / 'empty'), disk_unavailable=True).stdout)
    failed = sorted(e.split(':')[0] for e in data['errors'])
    assert failed == ['heavy', 'machine', 'mail', 'rows'], data['errors']
    assert data['codex'] == {'running': [], 'ended': [], 'owners': []}, data['codex']
    assert data['claude_usage']['state'] == data['codex_usage']['state'] == 'signed-out'


def page(lab):
    out, snapshot = lab.root / 'www/index.html', lab.root / 'data.json'
    lab.run('--out', str(out), '--json', str(snapshot), STATUS_FEED=str(lab.root / 'feed.jsonl'))
    text = out.read_text()
    assert out.stat().st_mode & 0o777 == 0o644, oct(out.stat().st_mode)
    assert snapshot.stat().st_mode & 0o777 == 0o600, oct(snapshot.stat().st_mode)
    assert (lab.trace / 'record').read_text() == 'pull'
    # Of the records, only the missions' front matter is public.
    for secret in ('SECRET-STATUS-LINE', 'The brief.', 'PRIVATE-PROMPT-TITLE', 'PRIVATE-OLDER-TITLE', 'port 22'):
        assert secret not in text, secret
    assert '<meta name="robots" content="noindex">' in text
    assert '2 of 3 machines reached' in text and 'down: gamma' in text, text[text.find('<header>'):][:500]
    # Why, but not ssh's words, which name the target.
    assert 'gamma: OSError: connection refused' in text
    # In flight: each set's latest run, if heard from in 6 hours.
    now = text[text.index('<h3>Landing now</h3>'):text.index('<h3>Recent set runs</h3>')]
    assert 'alpha-m/m1' in now and 'done-m/m1' not in now and 'stale-m/m1' not in now, now
    assert '<div class="label">Sets landing now</div><div class="value">1</div>' in text
    for needle in ('alpha-m/m1', 'done-m/m1', 'beta-m', 'paused-m', 'land temper', 'landing turn jig',
                   'o/alpha-m · last turn', '1 unread', 'Codex run', 'session busy'):
        assert needle in text, needle
    # Ended in the record, with commands only: history, not in flight.
    assert '<strong>old-m</strong>' not in text
    # The feed's hosts go by their fleet names where a machine names itself so.
    data = json.loads(snapshot.read_text())
    assert set(data['fleet']) == {'alpha', 'beta', 'gamma'} and 'unreachable' in data['fleet']['gamma']
    sent = json.loads((lab.trace / 'ssh-free@beta').read_text())
    assert {'BatchMode=yes', 'StrictHostKeyChecking=yes'} <= set(sent) and sent[-2] == 'free@beta', sent
    assert 'fmt 0:04 · clippy 0:25' in text, 'step medians'


def page_degraded(lab):
    """A failing pull and an unreadable records tree still write the page."""
    out = lab.root / 'page.html'
    lab.run('--out', str(out), FIXTURE_RECORD_EXIT='1', RECORDS=str(lab.root / 'nowhere'))
    text = out.read_text()
    for needle in ('record pull exited 1', 'nowhere/missions: no such directory',
                   'landings feed: no reachable machine holds it'):
        assert needle in text, needle
    (lab.trace / 'record').unlink()
    lab.run('--no-pull', '--out', str(out))
    assert not (lab.trace / 'record').exists(), '--no-pull must not pull'
    write(lab.root / 'bad-machines', 'alpha local extra\n')
    result = lab.run('--no-pull', STATUS_MACHINES=str(lab.root / 'bad-machines'), status=2)
    assert 'invalid machines file line' in result.stderr, result.stderr


def install(lab):
    out = lab.root / 'www/index.html'
    lab.run('install', '--out', str(out))
    units = lab.root / 'config/systemd/user'
    service = (units / 'status-page.service').read_text()
    assert f'ExecStart=/bin/bash -lc \'exec "$$0" --out "$$1"\' {SCRIPT} {out}\n' in service, service
    assert 'OnCalendar=*:0/10' in (units / 'status-page.timer').read_text()
    calls = [json.loads(line) for line in (lab.trace / 'systemctl').read_text().splitlines()]
    assert calls[-2:] == [['--user', 'daemon-reload'], ['--user', 'enable', '--now', 'status-page.timer']], calls
    result = lab.run('install', '--out', str(lab.root / 'a b/index.html'), status=2)
    assert 'no spaces' in result.stderr, result.stderr


