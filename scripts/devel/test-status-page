def records_waits(lab):
    read = runpy.run_path(str(SCRIPT))['records']
    heading = '# Waiting on the user\n'
    item = '- unknown · director · Answer · 1\n'
    bad = [item.replace('unknown', '2026-02-30T20:00Z'),
           item.replace('unknown', '2026-10-24T20:00+00:00'),
           item.replace('director', 'Director'), item.replace('Answer', ''),
           item.replace('Answer', 'a/b'), item.replace('Answer', 'a · b'),
           item.replace('Answer', 'é' * 161), item.replace('1\n', 'R3-x\n'),
           '# Waiting on the user\n', item.replace('Answer', 'sk-' + 'A' * 20)]
    write(lab.records / 'director/waiting.md', heading + ''.join(bad) + item)
    data = read(lab.records)
    assert data['unread'] == list(range(2, 12)), data
    assert data['waiting'] == [dict(since=None, who='director', what='Answer', decision='1')]
    # A damaged UTF-8 line is omitted without losing missions or other waits.
    (lab.records / 'director/waiting.md').write_bytes(heading.encode() + b'\xff broken\n' + item.encode())
    data = read(lab.records)
    assert data['missions'] and len(data['waiting']) == 1 and data['unread'] == [2], data
    # 40 valid entries survive; a 41st is named by line, never printed.
    write(lab.records / 'director/waiting.md', heading + item * 40 + item.replace('Answer', 'OVERFLOW'))
    data = read(lab.records)
    assert len(data['waiting']) == 40 and data['unread'] == [42], data
    write(lab.records / 'director/waiting.md', 'PRIVATE-WRONG-HEADING\n' + item)
    data = read(lab.records)
    assert len(data['waiting']) == 1 and data['unread'] == [1], data
    write(lab.records / 'director/waiting.md', heading + item.replace('unknown', '1970-01-01T00:00Z'))
    page, data = subscription_page(lab)
    assert '<tr><td>–</td><td>director</td>' in page and '<div class="sub">oldest –</div>' in page
    assert data['records']['waiting'][0]['since'] == 0
    # Known-token text and undecodable bytes stay out of both outputs; the footer names only lines.
    token = 'sk-' + 'A' * 20
    (lab.records / 'director/waiting.md').write_bytes(
        heading.encode() + item.replace('Answer', token).encode() + b'\xff broken\n' + item.encode())
    page, data = subscription_page(lab)
    assert token not in page and token not in json.dumps(data)
    assert data['records']['missions'] and len(data['records']['waiting']) == 1
    assert data['records']['unread'] == [2, 3], data['records']
    assert 'waiting.md: line 2 not read' in page and 'waiting.md: line 3 not read' in page


