          f'to=o/stale-recipient\nstarted={iso(2)}\ntask={lab.alpha}/owners/alpha-m/t.md\n')
    meta = lab.beta / 'codex-run/20261025T110000Z-aaaa/meta'
    write(meta, meta.read_text().replace(f'task={lab.beta}/owners/beta-m/m1/tasks/t.md', 'task=/outside/t.md'))
    # Both heavy's ledger and ended runs carry raw milestone names too.
