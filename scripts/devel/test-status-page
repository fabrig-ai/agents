SCRIPT = Path(__file__).resolve().with_name('status-page')
PYTHON = sys.executable
NOW = datetime(2026, 10, 25, 12, 0, tzinfo=timezone.utc).timestamp()


def iso(hours_ago):
    return datetime.fromtimestamp(NOW - hours_ago * 3600, timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def write(path, text, mode=None, mtime=None):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    if mode:
        path.chmod(mode)
    if mtime:
        os.utime(path, (mtime, mtime))
    return path


def tool(bin_dir, name, body):
    write(bin_dir / name, f'#!{PYTHON}\nimport json, os, subprocess, sys, time\nfrom pathlib import Path\n' + body,
          mode=0o700)


