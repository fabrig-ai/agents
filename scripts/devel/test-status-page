def page_pace(lab):
    samples = lab.root / 'samples/usage.jsonl'
    out, snapshot = lab.root / 'page.html', lab.root / 'data.json'

    def render(*args, usage_samples_failure=False):
        result = lab.run('--no-pull', '--out', str(out), '--json', str(snapshot), *args,
                         usage_samples_failure=usage_samples_failure)
        if usage_samples_failure:
            assert 'Traceback (most recent call last):' in result.stderr, result.stderr
            assert 'RuntimeError: fixture' in result.stderr, result.stderr
        page = out.read_text()
        private_absent(page, snapshot.read_text(), result.stderr)
        public_roles(page, lab)
        section = page[page.index('<h2>Subscriptions'):page.index('<h2>In flight')]
        assert re.findall(r'<th(?: [^>]*)?>(.*?)</th>', section) == [
            'Subscription', 'Limit', 'Used', 'Resets', 'At this pace'], section
        assert ("At this pace: when a limit fills before its reset, or what it reaches by then, "
                "at its rise over the last hour to day of the page&#x27;s own samples.") in section
        assert ("and the subscriptions&#x27; use, which it samples itself for their pace") in page[page.index('<footer>'):]
        cells, identity = {}, None
        for row in re.findall(r'<tr>.*?</tr>', section):
            columns = re.findall(r'<td[^>]*>(.*?)</td>', row)
            if not columns:
                continue
            if columns[0]:
                identity = re.search(r'<code>(.*?)</code>', columns[0])[1]
            assert len(columns) == 5, columns
            cells[identity, columns[1]] = columns[-1]
        return page, json.loads(snapshot.read_text()), cells

    _, data, cells = render('--samples', str(samples))
    assert cells and set(cells.values()) == {'–'}, cells
    assert samples.stat().st_mode & 0o777 == 0o600
    assert samples.parent.stat().st_mode & 0o777 == 0o700
    stored = [json.loads(line) for line in samples.read_text().splitlines()]
    expected = {}
    for host in data['fleet'].values():
        for cli in ('claude', 'codex'):
            probe = host.get(cli + '_usage', {})
            if not probe.get('label'):
                continue
            for limit in probe['limits']:
                if limit['used'] is None or limit['resets'] is None:
                    continue
                key = cli, probe['label'], limit['name']
                previous = expected.get(key)
                if previous is None or (limit['resets'], limit['used']) > (previous['resets'], previous['used']):
                    expected[key] = dict(time=NOW, cli=cli, label=probe['label'], limit=limit['name'],
                                         used=limit['used'], resets=limit['resets'])
    assert len(stored) == len(expected) == len(cells), stored
    assert all(set(s) == {'time', 'cli', 'label', 'limit', 'used', 'resets'} for s in stored)
    assert {(s['cli'], s['label'], s['limit']): s for s in stored} == expected
    private_absent(samples.read_text())
    for name in data['machines']:
        assert name not in samples.read_text(), name
    claude = data['fleet']['alpha']['claude_usage']['label']
    codex = data['fleet']['alpha']['codex_usage']['label']
    other_codex = data['fleet']['beta']['codex_usage']['label']

    def sample(cli, label, limit, hours, used):
        return dict(expected[cli, label, limit], time=NOW - hours * 3600, used=used)

    older = sample('codex', codex, 'sol week', 25, 2)
    expired = dict(sample('codex', codex, 'sol week', 1, 3), resets=NOW - 1)
    history = [sample('claude', claude, 'week (all models)', 12, 60),
               sample('claude', claude, 'session', 6, 0),
               sample('claude', claude, 'week (Fable)', 7, 0),
               sample('codex', codex, '5 h', 3, 0),
               sample('codex', codex, '5 h', 50 / 60, 6),
               dict(sample('codex', codex, 'week', 5, 90), resets=NOW + 86400 + 7200),
               sample('codex', codex, 'week', 10 / 60, 20),
               sample('codex', codex, 'other week', 3, 0), older, expired]
    write(samples, ''.join(json.dumps(s) + '\n' for s in history) + 'not json\n{"time": "x"}\n')
    answer = codex_answer(2)
    answer['limits']['rateLimitsByLimitId']['codex']['primary']['usedPercent'] = 100
    lab.codex(lab.beta, answer)
    page, _, cells = render('--samples', str(samples))
    # (84 - 60) / 12 = 2%/h; (100 - 84) / 2 = 8 h to full.
    assert cells[claude, 'week (all models)'] == time_cell('2026-10-25T20:00:00Z', 'full in 8 h 0 min'), cells
    # 6 h >= 18.5/4 h; (1 - 0) / 6 = 1/6 %/h; floor(1 + 18.5/6) = 4%.
    assert cells[claude, 'session'] == 'lasts, 4% at reset', cells
    # 7 h >= 24/4 = 6 h; (0 - 0) / 7 = 0%/h; 0 + 0 * 127 = 0%.
    assert cells[claude, 'week (Fable)'] == 'lasts, 0% at reset', cells
    # The 3 h sample is outside the 1 h look-back; (16 - 6) / (50/60) = 12%/h; 16 + 12 = 28%.
    assert cells[codex, '5 h'] == 'lasts, 28% at reset', cells
    # The 5 h sample is another window; 10 min < the required 30 min.
    assert cells[codex, 'week'] == '–', cells
    # 3 h >= 30 min, but 3 h < 24/4 = 6 h: insufficient history for a week's pace.
    assert cells[codex, 'other week'] == '–', cells
    # Use >= 100 is full now, without needing a rate.
    assert cells[other_codex, '5 h'] == 'full', cells
    assert 'usage samples: 2 lines not read' in page[page.index('<footer>'):]
    stored = [json.loads(line) for line in samples.read_text().splitlines()]
    assert older not in stored and expired not in stored, stored

    # 6,000 old readings plus 11 current ones: keep the newest 5,000, in time order.
    history = [sample('codex', codex, 'sol week', i / 6000 * 24, 10) for i in range(1, 6001)]
    write(samples, ''.join(json.dumps(s) + '\n' for s in history))
    render('--samples', str(samples))
    stored = [json.loads(line) for line in samples.read_text().splitlines()]
    current = [s for s in stored if s['time'] == NOW]
    assert len(current) == len(expected)
    assert len(stored) == 5000, len(stored)
    assert stored == sorted(history + current, key=lambda s: s['time'])[-5000:]
    assert samples.stat().st_mode & 0o777 == 0o600

    # An existing directory's permissions stay as the caller chose them.
    samples.parent.chmod(0o750)
    render('--samples', str(samples))
    assert samples.parent.stat().st_mode & 0o777 == 0o750
    blocked = write(lab.root / 'regular-file', 'not a directory') / 'usage.jsonl'
    page, _, _ = render('--samples', str(blocked))
    assert 'usage samples:' in page[page.index('<footer>'):]
    # A directory in place of the file also exercises atomic replacement's cleanup.
    directory = lab.root / 'not-a-samples-file'
    directory.mkdir()
    page, _, _ = render('--samples', str(directory))
    assert 'usage samples:' in page[page.index('<footer>'):]
    assert not list(lab.root.glob('.not-a-samples-file.*'))
    # Wrong numeric shapes and oversized JSON numbers are dropped, without losing good readings.
    good = expected['codex', codex, 'sol week']
    bad = [dict(good, used=True), dict(good, used=float('inf')), dict(good, time=10 ** 400),
           dict(good, machine='PRIVATE-HOST'), dict(good, label='not-a-label')]
    write(samples, ''.join(json.dumps(s) + '\n' for s in [*bad, good]) + '[' * 2000 + '0' + ']' * 2000 + '\n')
    page, _, _ = render('--samples', str(samples))
    assert 'usage samples: 6 lines not read' in page[page.index('<footer>'):]
    private_absent(samples.read_text())
    # An unexpected sampler exception leaves a newly written page with no pace.
    out.unlink()
    page, _, cells = render('--samples', str(samples), usage_samples_failure=True)
    assert 'usage samples: not kept: RuntimeError: fixture' in page[page.index('<footer>'):]
    assert cells and set(cells.values()) == {'–'}, cells
    # Without --samples, even a full limit has no pace; no storage is created anywhere in the lab.
    before = set(lab.root.rglob('*'))
    _, _, cells = render()
    assert set(cells.values()) == {'–'}, cells
    assert set(lab.root.rglob('*')) == before


def subscriptions_signed_out(lab):
    lab.claude(lab.beta, {'auth': {'object': {'loggedIn': False}, 'exit': 1}})
    lab.codex(lab.beta, {'account': {'type': 'apiKey'}})
    alpha = claude_answer(); del alpha['auth']['object']['orgId']; lab.claude(lab.alpha, alpha)
    page, data = subscription_page(lab)
    for needle in ('Claude · max · unidentified', 'Claude: signed out on beta', 'Codex: no subscription on beta',
                   ' · signed out: beta'):
        assert needle in page, needle
    assert 'alpha, beta' not in page[page.index('<h2>Subscriptions'):page.index('<h2>In flight')]
    assert [c['argv'][0] for c in calls(lab.beta, 'claude')] == ['agents', 'auth']
    assert [c['method'] for c in calls(lab.beta, 'codex')] == ['initialize', 'initialized', 'account/read']
    assert 'claude_usage' not in page and 'codex_usage' not in page
    assert data['fleet']['beta']['claude_usage']['state'] == 'signed-out'
    # Both CLIs signed out on beta still name that machine only once;
    # alpha comes first even though its signed-out probe is visited last.
    lab.codex(lab.beta, {'account': None})
    lab.codex(lab.alpha, {'account': None})
    page, _ = subscription_page(lab)
    assert '<div class="sub">highest 24% · Claude week (all models) · signed out: alpha, beta</div>' in page
    assert 'signed out: alpha, beta, beta' not in page


def subscription_failures(lab):
    answer = claude_answer(); answer['usage']['object'].update(num_turns=1, total_cost_usd=.02)
    lab.claude(lab.alpha, answer)
    lab.codex(lab.beta, {'hang': 'initialize', 'ignore_term': True})
    start = time.monotonic()
    page, data = subscription_page(lab, STATUS_PROBE_TIMEOUT='1')
    assert time.monotonic() - start < 9
    for needle in ('/usage was answered by a model', 'beta: codex_usage:', 'land temper', '<h3>alpha '):
        assert needle in page, needle
    def gone(path):
        try:
            os.kill(int(path.read_text()), 0)
        except ProcessLookupError:
            return
        raise AssertionError('probe process survived: ' + path.name)

    gone(lab.beta.parent / 'codex.pid')
    gone(lab.beta.parent / 'codex.helper')
    answer = claude_answer(); answer['usage']['object']['result'] = 'No limits here'
    lab.claude(lab.alpha, answer); lab.codex(lab.alpha, {'non_object': []})
    result = lab.run('collect'); data = json.loads(result.stdout)
    assert [e.split(':')[0] for e in data['errors']] == ['claude_usage', 'codex_usage'], data['errors']
    assert 'no Current limit line' in data['errors'][0] and 'no JSON object' in data['errors'][1]
    assert 'sessions' in data and 'heavy' in data
    # RPC error details may contain account text; only a fixed description escapes.
    lab.codex(lab.alpha, {'error': 'account/read'})
    result = lab.run('collect'); private_absent(result.stdout, result.stderr)
    assert 'Codex account/read returned an error' in result.stdout
    lab.codex(lab.alpha, {'close_stdin': True})
    result = lab.run('collect', STATUS_PROBE_TIMEOUT='1')
    assert 'codex_usage: BrokenPipeError:' in result.stdout, result.stdout
    gone(lab.alpha.parent / 'codex.pid')


def claude_resets(lab):
    answer = claude_answer()
    forms = ['Jan 2, 7pm (UTC)', '9pm', '7:30pm', '6:30pm (UTC)', 'Oct 26, 5:30am', 'soon', '9pm (CET)']
    answer['usage']['object']['result'] = '\n'.join(f'Current limit {i}: {i}% used · resets {form}'
                                                           for i, form in enumerate(forms))
    lab.claude(lab.alpha, answer)
    now = datetime(2026, 12, 31, 20, tzinfo=timezone.utc).timestamp()
    data = json.loads(lab.run('collect', STATUS_NOW=str(now)).stdout)
    expected = [(2027, 1, 2, 19, 0), (2026, 12, 31, 21, 0), (2026, 12, 31, 19, 30),
                (2027, 1, 1, 18, 30), (2027, 10, 26, 5, 30)]
    assert data['errors'] == [], data['errors']
    assert [v['resets'] for v in data['claude_usage']['limits']] == [
        datetime(*parts, tzinfo=timezone.utc).timestamp() for parts in expected] + [None, None], data
    assert [v['used'] for v in data['claude_usage']['limits']] == list(range(7))


