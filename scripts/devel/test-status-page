def collect_subscriptions(lab):
    answer = claude_answer(); answer['auth']['exit'] = 1; lab.claude(lab.alpha, answer)
    result = lab.run('collect')
    data = json.loads(result.stdout)
    assert data['errors'] == [], data['errors']
    expected_label = lambda cli, identity, email: hashlib.sha256('\0'.join((cli, identity, email)).encode()).hexdigest()[:8]
    claude = data['claude_usage']
    assert (claude['state'], claude['plan'], claude['label']) == (
        'subscribed', 'max', expected_label('claude', 'PRIVATE-ORG-1', 'PRIVATE-EMAIL-1@x.y')), claude
    assert claude['limits'] == [
        {'name': 'session', 'used': 3, 'resets': datetime(2026, 10, 26, 5, 30, tzinfo=timezone.utc).timestamp()},
        {'name': 'week (all models)', 'used': 24, 'resets': datetime(2026, 10, 30, 19, tzinfo=timezone.utc).timestamp()},
        {'name': 'week (Fable)', 'used': 0, 'resets': datetime(2026, 10, 30, 19, tzinfo=timezone.utc).timestamp()}], claude
    codex = data['codex_usage']
    assert (codex['state'], codex['plan'], codex['label']) == (
        'subscribed', 'promax', expected_label('codex', 'PRIVATE-ACCOUNT-1', 'PRIVATE-EMAIL-2@x.y')), codex
    assert codex['limits'] == [{'name': '5 h', 'used': 16, 'resets': NOW + 3600},
                               {'name': 'week', 'used': 22, 'resets': NOW + 86400},
                               {'name': 'GPT-6.1-Sol week', 'used': 12, 'resets': NOW + 172800}], codex
    assert calls(lab.alpha, 'codex') == [
        {'id': 1, 'method': 'initialize', 'params': {'clientInfo': {'name': 'status-page', 'version': '1'}}},
        {'method': 'initialized'}, {'id': 2, 'method': 'account/read', 'params': {}},
        {'id': 3, 'method': 'account/rateLimits/read', 'params': {'excludeResetCreditDetails': True}}]
    trace = calls(lab.alpha, 'claude')
    assert [c['argv'] for c in trace] == [['agents', '--json', '--all'], ['auth', 'status', '--json'],
        ['-p', '/usage', '--output-format', 'json', '--no-session-persistence', '--strict-mcp-config',
         '--tools', '', '--model', 'haiku']], trace
    assert all(c['TZ'] == 'UTC' for c in trace[1:]), trace
    private_absent(result.stdout, result.stderr)


def subscription_page(lab, **env):
    out, snapshot = lab.root / 'page.html', lab.root / 'data.json'
    result = lab.run('--no-pull', '--out', str(out), '--json', str(snapshot), **env)
    private_absent(out.read_text(), snapshot.read_text(), result.stderr)
