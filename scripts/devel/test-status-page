    def run(self, *args, status=0, disk_unavailable=False, usage_samples_failure=False, **env):
        command = [PYTHON, '-I', str(SCRIPT), *args]
        if disk_unavailable:
            # Leave a valid cwd for the CLIs, while keeping this case's
            # original unavailable-machine-source failure independent of them.
            code = ("import runpy, sys; from unittest.mock import patch; "
                    "mock = patch('shutil.disk_usage', side_effect=OSError('fixture disk unavailable')); "
                    "mock.start(); runpy.run_path(sys.argv.pop(1), run_name='__main__')")
            command = [PYTHON, '-I', '-c', code, str(SCRIPT), *args]
        if usage_samples_failure:
            code = ("import runpy, sys\nfrom unittest.mock import Mock, patch\n"
                    "module = runpy.run_path(sys.argv.pop(1))\n"
                    "with patch.dict(module['main'].__globals__, "
                    "usage_samples=Mock(side_effect=RuntimeError('fixture'))):\n"
                    "    sys.exit(module['main']())\n")
            command = [PYTHON, '-I', '-c', code, str(SCRIPT), *args]
        result = subprocess.run(command, cwd=self.root, env=dict(self.env, **env),
                                stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
        assert result.returncode == status, (result.returncode, result.stdout, result.stderr)
        return result


def collect(lab):
    data = json.loads(lab.run('collect', STATUS_FEED=str(lab.root / 'feed.jsonl')).stdout)
    assert data['errors'] == [], data['errors']
    kinds = [(r[6], r[7], r[5], r[4]) for r in data['rows']]
    assert kinds == [('focused', '', 'alpha-m', '0'), ('clippy', '', 'alpha-m', '101'),
                     ('prebuild', 'skein', 'alpha-m', '0'), ('land', 'skein', 'alpha-m', '0'),
                     ('check', '', 'old-m', '0'), ('check', '', 'alpha-m2', '0'),
                     ('check', '', 'legacy-m3', '0')], kinds
    tasks = sorted((t['state'], t['kind'], t['repo'], t['mission']) for t in data['heavy']['tasks'])
    assert tasks == [('active', 'workspace', '', 'alpha-m'), ('queued', 'land', 'temper', 'alpha-m')], tasks
    codex = data['codex']
    assert [(r['id'], r['alive'], r['mission']) for r in codex['running']] == [
        ('20261025T110000Z-aaaa', True, 'alpha-m'),
        ('20261025T113000Z-dddd', True, 'alpha-m2')], codex['running']
    assert [r[2:] for r in codex['ended']] == [['0', 'gpt-x', 'high', [1000, 500, 20], 'alpha-m']], codex['ended']
    assert set(codex) == {'running', 'ended'}, codex
    units = [json.loads(line) for line in (lab.trace / 'systemctl').read_text().splitlines()]
    assert units[0][-1] == 'codex-run-*', units
    assert 'mail' not in data
    assert data['machine']['ips'] == ['62.238.103.124'], data['machine']
    assert [t[1:] for t in data['turns']['done']] == [['temper', 200, 500], ['smith', 10, 50]], data['turns']
    assert [(t['repo'], t['event']) for t in data['turns']['open']] == [('jig', 'request')], data['turns']
    # An interactive session is someone's own: its name stays here.
    assert [(s['name'], s['kind']) for s in data['sessions']] == [
        ('o/alpha-m', 'background'), ('o/paused-m', 'background'), ('', 'interactive')], data['sessions']
    assert len(data['feed']) == 13, data['feed']
    # Elsewhere than the coordinator there is no feed, and that is no error.
    assert json.loads(lab.run('collect').stdout)['feed'] is None


def collect_missing(lab):
    """A machine with none of the tools' files still answers, naming what it could not read."""
    (lab.root / 'empty').mkdir()
    data = json.loads(lab.run('collect', DEV_TMP=str(lab.root / 'empty'), disk_unavailable=True).stdout)
    failed = sorted(e.split(':')[0] for e in data['errors'])
    assert failed == ['heavy', 'machine', 'rows'], data['errors']
    assert data['codex'] == {'running': [], 'ended': []}, data['codex']
    assert data['claude_usage']['state'] == data['codex_usage']['state'] == 'signed-out'


def page(lab):
    out, snapshot = lab.root / 'www/index.html', lab.root / 'data.json'
    lab.run('--out', str(out), '--json', str(snapshot), STATUS_FEED=str(lab.root / 'feed.jsonl'))
    text = out.read_text()
    assert out.stat().st_mode & 0o777 == 0o644, oct(out.stat().st_mode)
    assert snapshot.stat().st_mode & 0o777 == 0o600, oct(snapshot.stat().st_mode)
    assert (lab.trace / 'record').read_text() == 'pull'
    # Of the records, only the missions' front matter is public.
    for secret in ('SECRET-STATUS-LINE', 'The brief.', 'PRIVATE-PROMPT-TITLE', 'PRIVATE-OLDER-TITLE', 'port 22'):
        assert secret not in text, secret
    assert '<meta name="robots" content="noindex">' in text
    assert '2 of 3 machines reached' in text and 'down: gamma' in text, text[text.find('<header>'):][:500]
    # Why, but not ssh's words, which name the target.
    assert 'gamma: OSError: connection refused' in text
    # In flight: each set's latest run, if heard from in 6 hours.
