def page_role_edges(lab):
    """Stale runs do not count as agents; ended records can still have live work."""
    for name, state, ended in (('ended-m', 'ended', iso(30)),
                               ('abandoned-m', 'abandoned', iso(1)),
                               ('invalid-ended', 'ended', 'not a time'),
                               ('future-ended', 'ended', iso(-1))):
        write(lab.records / f'missions/{name}/README.md',
              f'---\nstate: {state}\nended: {ended}\nowner: o/{name}@alpha\n---\n')
    answer = claude_answer()
    answer['agents'] = [dict(name='o/ended-m', kind='background', state='waiting', pid=1),
                        dict(name='design/legacy-m3', kind='background', state='working', pid=2),
                        dict(name='o/alpha-m2', kind='background', state='idle', pid=3)]
    lab.claude(lab.alpha, answer)
    # Two alive implementers for one mission, plus a recent stale one with no mission.
    write(lab.alpha / 'codex-run/20261025T113000Z-dddd/meta',
          f'to=o/alpha-m\nmodel=gpt-y\neffort=low\nstarted={iso(.5)}\n'
          f'task={lab.alpha}/owners/alpha-m/t.md\n')
