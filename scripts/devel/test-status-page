def page_times(lab):
    """Relative times carry UTC titles; ended missions reveal only a numeric start."""
    starts = [('long-m', iso(80), '3 d 6 h'), ('hours-m', iso(7.2), '5 h 12 min'),
              ('short-m', iso(2.7), '42 min'), ('unknown-m', 'unknown', '–'),
              ('later-m', iso(1), '–'), ('invalid-m', 'PRIVATE-NOT-A-TIME', '–'),
              ('missing-m', None, '–'), ('equal-m', iso(2), '0 min')]
    for name, started, _ in starts:
        write(lab.records / f'missions/{name}/README.md',
              f'---\nstate: ended\nended: {iso(2)}\ndescription: Ended {name}\n'
              + (f'started: {started}\n' if started is not None else '') + '---\n')
    answer = codex_answer()
    answer['limits']['rateLimitsByLimitId']['codex']['primary']['resetsAt'] = NOW + 42 * 60
    lab.codex(lab.alpha, answer)
    page, data = subscription_page(lab, STATUS_FEED=str(lab.root / 'feed.jsonl'))

    def section(start, end):
        return page[page.index(start):page.index(end)]

    def cells(part):
        return [re.findall(r'<td[^>]*>(.*?)</td>', row)
                for row in re.findall(r'<tr>.*?</tr>', part) if '<td' in row]

    ended = section('<h3>Ended this week</h3>', '<h3>Machines</h3>')
    assert re.findall(r'<th(?: [^>]*)?>(.*?)</th>', ended) == [
        'Mission', 'State', 'Ended', 'Duration', 'Description'], ended
    rows = {row[0]: row for row in cells(ended)}
    for name, _, duration in starts:
        assert rows[name][2] == time_cell(iso(2), '2 h 0 min ago'), rows[name]
        assert rows[name][3] == duration, rows[name]
        assert f'<td class=wrap>Ended {name}</td>' in ended, ended
    waiting = section('<h2>Waiting on the user</h2>', '<h2>Subscriptions')
    assert cells(waiting)[0][0] == time_cell('2026-10-24T20:00:00Z', '16 h 0 min ago'), waiting
    subscribed = section('<h2>Subscriptions', '<h2>In flight')
    assert any(row[3] == time_cell('2026-10-26T06:30:00Z', 'in 18 h 30 min')
               for row in cells(subscribed)), subscribed
    assert any(row[3] == time_cell('2026-10-25T12:42:00Z', 'in 42 min')
               for row in cells(subscribed)), subscribed
    recent = section('<h3>Recent set runs</h3>', '<h3>Missions</h3>')
    assert cells(recent)[0][3] == time_cell(iso(4.4), '4 h 24 min ago'), recent
    missions = section('<h3>Missions</h3>', '<h3>Ended this week</h3>')
    alpha = next(row for row in cells(missions) if row[0] == '<strong>alpha-m</strong>')
    assert alpha[4] == time_cell(iso(1 / 60), 'just now'), alpha
    landing = section('<h3>Landing now</h3>', '<h3>Recent set runs</h3>')
    assert cells(landing)[0][3] == time_cell(iso(.1), '6 min'), landing
    assert any(row[3] == time_cell(iso(1 / 60), '&lt;1 min') for row in cells(landing)), landing
    tiles = section('<div class="tiles">', '<h2>Waiting on the user</h2>')
    assert ('<div class="label">Sets landing now</div><div class="value">1</div>'
            f'<div class="sub">last landed {time_cell(iso(4.4), "4 h 24 min ago")} (done-m/m1)</div>') in tiles
    assert ('<div class="label">Waiting on the user</div><div class="value">3</div>'
            f'<div class="sub">oldest {time_cell("2026-10-22T12:00:01Z", "2 d ago")}</div>') in tiles
    card = section('<h3>alpha ', '<h3>beta ')
    assert f'last heavy command {time_cell(iso(.5), "30 min ago")}</p>' in card, card
    assert f' · {time_cell(iso(5 / 60), "5 min")}</li>' in card, card
    assert re.search(r'\dZ · |· \d\d-\d\d \d\d:\d\dZ', page) is None
    times = re.findall(r'<time\b[^>]*>', page)
    assert times and all(' datetime="' in tag and ' title="' in tag for tag in times), times
    recorded = {m['name']: m for m in data['records']['missions']}
    for name, started, _ in starts:
        expected = (datetime.fromisoformat(started.replace('Z', '+00:00')).timestamp()
                    if started and started.startswith('2026-') else None)
        assert recorded[name]['started'] == expected, recorded[name]
    public_roles(page, lab)
    private_absent(page, json.dumps(data))


