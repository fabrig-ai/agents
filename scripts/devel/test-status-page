    assert 'alpha, beta' not in page[page.index('<h2>Subscriptions'):page.index('<h2>In flight')]
    assert [c['argv'][0] for c in calls(lab.beta, 'claude')] == ['agents', 'auth']
    assert [c['method'] for c in calls(lab.beta, 'codex')] == ['initialize', 'initialized', 'account/read']
    assert 'claude_usage' not in page and 'codex_usage' not in page
    assert data['fleet']['beta']['claude_usage']['state'] == 'signed-out'


def subscription_failures(lab):
    answer = claude_answer(); answer['usage']['object'].update(num_turns=1, total_cost_usd=.02)
    lab.claude(lab.alpha, answer)
    lab.codex(lab.beta, {'hang': 'initialize', 'ignore_term': True})
    start = time.monotonic()
    page, data = subscription_page(lab, STATUS_PROBE_TIMEOUT='1')
    assert time.monotonic() - start < 9
    for needle in ('/usage was answered by a model', 'beta: codex_usage:', 'land temper', '<h3>alpha '):
        assert needle in page, needle
    def gone(path):
        try:
            os.kill(int(path.read_text()), 0)
        except ProcessLookupError:
            return
        raise AssertionError('probe process survived: ' + path.name)

    gone(lab.beta.parent / 'codex.pid')
    gone(lab.beta.parent / 'codex.helper')
    answer = claude_answer(); answer['usage']['object']['result'] = 'No limits here'
    lab.claude(lab.alpha, answer); lab.codex(lab.alpha, {'non_object': []})
    result = lab.run('collect'); data = json.loads(result.stdout)
    assert [e.split(':')[0] for e in data['errors']] == ['claude_usage', 'codex_usage'], data['errors']
    assert 'no Current limit line' in data['errors'][0] and 'no JSON object' in data['errors'][1]
    assert 'sessions' in data and 'heavy' in data
    # RPC error details may contain account text; only a fixed description escapes.
    lab.codex(lab.alpha, {'error': 'account/read'})
    result = lab.run('collect'); private_absent(result.stdout, result.stderr)
    assert 'Codex account/read returned an error' in result.stdout
    lab.codex(lab.alpha, {'close_stdin': True})
    result = lab.run('collect', STATUS_PROBE_TIMEOUT='1')
    assert 'codex_usage:' in result.stdout
    gone(lab.alpha.parent / 'codex.pid')


def claude_resets(lab):
    answer = claude_answer()
    forms = ['Jan 2, 7pm (UTC)', '9pm', '7:30pm', '6:30pm (UTC)', 'Oct 26, 5:30am', 'soon', '9pm (CET)']
    answer['usage']['object']['result'] = '\n'.join(f'Current limit {i}: {i}% used · resets {form}'
                                                           for i, form in enumerate(forms))
    lab.claude(lab.alpha, answer)
    now = datetime(2026, 12, 31, 20, tzinfo=timezone.utc).timestamp()
    data = json.loads(lab.run('collect', STATUS_NOW=str(now)).stdout)
    expected = [(2027, 1, 2, 19, 0), (2026, 12, 31, 21, 0), (2026, 12, 31, 19, 30),
                (2027, 1, 1, 18, 30), (2027, 10, 26, 5, 30)]
    assert data['errors'] == [], data['errors']
    assert [v['resets'] for v in data['claude_usage']['limits']] == [
        datetime(*parts, tzinfo=timezone.utc).timestamp() for parts in expected] + [None, None], data
    assert [v['used'] for v in data['claude_usage']['limits']] == list(range(7))


CASES = [collect_subscriptions, page_subscriptions, subscriptions_signed_out, subscription_failures, claude_resets, collect, collect_missing, page, page_degraded, bad_data, write_failure, install]


def main():
    selected = sys.argv[1:] or [case.__name__ for case in CASES]
    unknown = set(selected) - {case.__name__ for case in CASES}
    if unknown:
        print('Unknown cases: ' + ', '.join(sorted(unknown)), file=sys.stderr)
        return 2
    failed = 0
    for case in (case for case in CASES if case.__name__ in selected):
        with tempfile.TemporaryDirectory() as directory:
            try:
                case(Lab(Path(directory)))
                print(f'ok    {case.__name__}')
            except Exception as error:
                failed += 1
                print(f'FAIL  {case.__name__}: {type(error).__name__}: {error}')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
