#!/usr/bin/env bash
# A plan's run on this machine (development.md, sections 6, 7, 10, 14, 15).
#
#   plan check [--fix] [PLAN_DIR] is the machine ready (to run the plan)?
#   plan start PLAN_DIR           check, claim, start the supervisor and the coordinator
#   plan status                   render status.md from the ledger, with the roles
#   plan attach ROLE              open a role's session: coordinator, supervisor, designer
#   plan resume [CAUSE]           after a restart or a crash, start the roles again
#   plan claim PLAN_DIR           make it this machine's active run
#   plan release                  end the active run
#   plan worktree REPO NAME       a session's worktree, at origin/main
#   plan worktree --remove REPO NAME
#   plan landed STEP COMMIT       check a landing, then set its ledger state
#   plan set STEP KEY=VALUE...    add or change a step in the ledger
#   plan log REPO NN [FILE]       log an implementer's report (stdin, or FILE); print its file
#   plan idle REASON [--tasks ID…] the coordinator ends its turn; the doorbell starts the next
#   plan watch                    wait for something the supervisor must see
#   plan ring MESSAGE             ring the coordinator's doorbell
#   plan docs                     the supervisor's worktree of the plan's repository
#   plan ruling [--text FILE] TITLE SOURCE  land a ruling in decisions.md, once
#   plan ready STEP [NOTE]        a checked step may start: set it ready, ring
#   plan join ROLE                record this Claude Code session as the run's ROLE
#   plan wake ROLE MESSAGE        wake a Claude Code role: resumed, or fresh past its limits
#   plan unblocked                file the answered blocks and remove them
#   plan steered                  file the steer and remove it
#   plan handover REPO NN CONTEXT  log an implementer handover
#   plan handover supervisor      start the supervisor's successor, from this session
#   plan pulse                    the run's numbers since the last check
#   plan downstream               type-check each downstream repository against the plan's upstream mains
#   plan context [SESSION]        this Claude session's context and compactions
#   plan contexts                 each Codex thread's context, and the sessions past the limit
#   plan metrics [--out FILE] [PLAN_DIR]  the run's metrics, as TSV (the last run's, by default)
#   plan metrics --history        every plan's metrics, side by side
#   plan retro [PLAN_DIR]         start the run's retrospective (the last run's, by default)
#
# PLAN_DIR is the plan's directory in its repository's primary checkout,
# for example ~/src/rust/smith/docs/development/plans/reliability. The
# workspace is $DEV_ROOT, or the directory holding the skein checkout these
# tools come from. A run lives in $DEV_TMP/<repository>/<plan>/ (DEV_TMP is
# the workspace's tmp/ by default), and $DEV_TMP/active-plan names it; the
# commands after claim act on that run.
# shellcheck source-path=SCRIPTDIR
# shellcheck disable=SC2015 # in check, ok and warn always succeed
set -euo pipefail

kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# The workspace: DEV_ROOT, or the directory holding the skein checkout these
# tools come from (development.md, section 3.6), or ~/src/rust.
workspace() {
    local skein
    skein=$(cd "$kit/../.." && pwd)
    if [[ $(basename "$skein") == skein ]]; then dirname "$skein"; else echo "$HOME/src/rust"; fi
}
root=${DEV_ROOT:-$(workspace)}
tmp=${DEV_TMP:-$root/tmp}
# A run's own kit, if it has one (kit.sh).
if [[ -f $kit/kit.sh ]]; then
    # shellcheck source=kit.sh
    source "$kit/kit.sh"
    run_kit plan "$@"
fi
# The workspace's repositories, each after those it builds on (development.md,
# section 3.1), and what each builds on.
all_repos="skein smith jig hearth temper"
declare -A builds_on=([skein]="" [smith]="skein" [jig]="skein smith" [hearth]="skein" [temper]="skein smith jig")
repos=${DEV_REPOS:-$all_repos}
active=$tmp/active-plan
columns='step	repo	session	state	slot	thread	branch	commit	updated	title	note'

# The roles' programs, models and efforts (development.md, section 2). The
# coordinator's come from its Codex profile in the kit.
profile=$kit/workspace/coordinator.config.toml
profile_value() {
    local line pattern="^$1 *= *\"?([^\"]*)\"? *$"
    while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line =~ $pattern ]]; then printf '%s\n' "${BASH_REMATCH[1]}"; return; fi
    done <"$profile"
}
claude_model=${PLAN_CLAUDE_MODEL:-claude-opus-5-5}
claude_effort=${PLAN_CLAUDE_EFFORT:-xhigh}
codex_model=${PLAN_CODEX_MODEL:-$(profile_value model)}
codex_effort=${PLAN_CODEX_EFFORT:-$(profile_value model_reasoning_effort)}
codex_threads=${PLAN_CODEX_THREADS:-$(profile_value max_threads)}
codex_sandbox=${PLAN_CODEX_SANDBOX:-danger-full-access}
# Where the Claude Code roles start: the workspace, which Claude Code must trust.
claude_dir=${PLAN_CLAUDE_DIR:-$root}
# The long-lived Claude Code roles' limits (development.md, sections 10.4
# and 10.5): the supervisor and the designer compact their contexts in
# place, a little below the window given; the supervisor hands over after
# its limit of compactions; a wake starts a fresh designer after as many,
# or once its session has been idle longer than its cache lives.
claude_autocompact=${PLAN_CLAUDE_AUTOCOMPACT:-200000}
compaction_limit=${PLAN_COMPACTIONS:-2}
designer_idle=${PLAN_DESIGNER_IDLE:-3600}

die() { echo "plan: $*" >&2; exit 2; }

usage() {
    sed -n '3,/^# shellcheck/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//' >&2
    exit 2
}

now() { date -u +%FT%TZ; }

# This machine's name; some containers have no hostname command.
host() { hostname 2>/dev/null || uname -n; }

# The active run: its name (repository/plan), plan directory and path.
load() {
    [[ -f $active ]] || die "no active run on this machine"
    { IFS= read -r name || :; IFS= read -r plan_dir || :; } <"$active"
    run=$tmp/$name
    plan=${name#*/}
}

# A plan directory's repository and run name.
locate() {
    plan_dir=$(cd "${1:?plan directory}" && pwd)
    local top
    top=$(git -C "$plan_dir" rev-parse --show-toplevel)
    project=$(basename "$top")
    plan=$(basename "$plan_dir")
    name=$project/$plan
    run=$tmp/$name
    rel=${plan_dir#"$top"/}
    top_dir=$top
}

# A repository and those upstream of it: what a plan in it builds on. One the
# workspace does not know builds on all of them.
upstream() {
    if [[ -v builds_on[$1] ]]; then
        echo "${builds_on[$1]:+${builds_on[$1]} }$1"
    else
        echo "$all_repos"
    fi
}

# The last run on this machine: the active one, or the latest released.
last_run() {
    if [[ -f $active ]]; then
        load
        return
    fi
    local log
    log=$(ls -t "$tmp"/*/*/log.md 2>/dev/null | head -n1 || true)
    [[ -n $log ]] || die "no run on this machine"
    plan_dir=$(sed -nE 's/^The run of (.*) started on .*\.$/\1/p' "$log" | head -n1)
    [[ -n $plan_dir ]] || die "cannot find the plan of $(dirname "$log")"
    locate "$plan_dir"
}

claim() {
    locate "${1:?plan directory}"
    if [[ -f $active && $(sed -n 1p "$active") != "$name" ]]; then
        die "another run is active: $(sed -n 1p "$active")"
    fi
    mkdir -p "$run"/{logs,sessions,wt}
    if [[ ! -f $active ]]; then
        # The run takes its kit from its claim (development.md, section
        # 3.6): a worktree of the workspace's skein at its checkout's commit.
        git -C "$root/skein" worktree prune
        [[ ! -e $run/kit ]] ||
            die "$run/kit is left from an earlier claim: git -C $root/skein worktree remove --force $run/kit"
        git -C "$root/skein" worktree add --quiet --detach "$run/kit" HEAD ||
            die "cannot add the run's kit, a worktree of $root/skein, in $run/kit"
    fi
    [[ -f $run/ledger.tsv ]] || printf '%s\n' "$columns" >"$run/ledger.tsv"
    [[ -f $run/log.md ]] || printf '# %s on %s\n\n' "$name" "$(host)" >"$run/log.md"
    if [[ -f $active ]]; then
        echo "$run"
        return
    fi
    printf '%s\n%s\n%s\n%s\n' "$name" "$plan_dir" "$(host)" "$(now)" >"$active"
    printf '## Claimed, %s\n\nThe run of %s started on %s.\nIts kit is skein %s, in kit/.\n\n' \
        "$(now)" "$plan_dir" "$(host)" "$(git -C "$run/kit" rev-parse --short HEAD)" >>"$run/log.md"
    touch "$run/heartbeat"
    echo "$run"
}

release() {
    load
    if [[ -n $(ls -A "$run/wt" 2>/dev/null) ]]; then
        die "worktrees are left in $run/wt; remove them first"
    fi
    if [[ -d $run/docs ]]; then
        [[ -z $(git -C "$run/docs" status --porcelain) ]] ||
            die "the supervisor's worktree $run/docs has changes: land or discard them first"
        git -C "$root/${name%%/*}" worktree remove "$run/docs"
    fi
    # The run's kit is skein at a commit: nothing in it is the run's own.
    if [[ -d $run/kit ]]; then
        git -C "$root/skein" worktree remove --force "$run/kit" ||
            echo "plan: $run/kit is left: git -C $root/skein worktree remove --force $run/kit" >&2
    fi
    printf '## Released, %s\n\n' "$(now)" >>"$run/log.md"
    boot_unit disable
    rm -f "$active"
    echo "released $name"
}

worktree() {
    load
    local remove=0
    [[ ${1:-} == --remove ]] && { remove=1; shift; }
    local repo=${1:?repository} label=${2:?name}
    local dir=$root/$repo path=$run/wt/$repo-$label
    if ((remove)); then
        git -C "$dir" worktree remove "$path"
        echo "removed $path"
        return
    fi
    git -C "$dir" fetch --quiet origin main
    git -C "$dir" worktree add --quiet --detach "$path" origin/main
    echo "$path"
}

# A ledger written before the thread column gains it, empty.
ledger_upgrade() {
    local ledger=$run/ledger.tsv
    [[ -f $ledger ]] || return 0
    [[ $(head -n1 "$ledger") == "${columns//	thread/}" ]] || return 0
    awk -F'\t' -v OFS='\t' '{ $5 = $5 OFS (NR == 1 ? "thread" : ""); print }' "$ledger" >"$ledger.new"
    mv "$ledger.new" "$ledger"
}

set_step() {
    load
    ledger_upgrade
    local step=${1:?step}
    [[ $step != -* ]] || die "a step is not an option: $step"
    shift
    local pairs=() pair key
    for pair in "$@"; do
        key=${pair%%=*}
        case $key in
        repo | session | slot | thread | branch | commit | title | note) ;;
        state)
            case ${pair#*=} in
            waiting | check | ready | running | blocked | landed | dropped | split) ;;
            *) die "state is one of waiting, check, ready, running, blocked, landed, dropped, split" ;;
            esac
            ;;
        *) die "unknown key $key" ;;
        esac
        [[ $pair != *$'\t'* ]] || die "no tabs in values"
        pairs+=("$pair")
    done
    local ledger=$run/ledger.tsv
    exec 8>"$ledger.lock"
    flock 8
    STEP=$step AT=$(now) SETS=$(printf '%s\n' "${pairs[@]}") awk -F'\t' -v OFS='\t' '
        BEGIN {
            step = ENVIRON["STEP"]; at = ENVIRON["AT"]; sets = ENVIRON["SETS"]
            n = split("step repo session state slot thread branch commit updated title note", name, " ")
            for (i = 1; i <= n; i++) col[name[i]] = i
            m = split(sets, line, "\n")
            for (i = 1; i <= m; i++) if (line[i] != "") {
                k = substr(line[i], 1, index(line[i], "=") - 1)
                value[col[k]] = substr(line[i], index(line[i], "=") + 1)
                given[col[k]] = 1
            }
        }
        function apply(   i) {
            for (i = 1; i <= n; i++) if (i in given) $i = value[i]
            $col["updated"] = at
        }
        NR > 1 && $1 == step { apply(); found = 1 }
        { print }
        END {
            if (!found) {
                $0 = step; for (i = 2; i <= n; i++) $i = ""
                if (!("4" in given)) { value[4] = "waiting"; given[4] = 1 }
                apply(); print
            }
        }' "$ledger" >"$ledger.new"
    mv "$ledger.new" "$ledger"
    flock -u 8
}

# A landing changes the ledger only after development.md 7.3's checks pass.
landed() {
    load
    local step=${1:?step} commit=${2:?commit} repo session branch path dir failed=0
    IFS=$'\t' read -r repo session branch < <(awk -F'\t' -v step="$step" '
        $1 == step { print $2 "\t" $3 "\t" $7 }' "$run/ledger.tsv")
    [[ -n $repo && -n $session ]] || { echo "FAIL  $step has no repository and session"; return 1; }
    path=$run/wt/$repo-$session
    dir=$path
    [[ -d $path ]] || dir=$root/$repo
    if ! git -C "$dir" fetch --quiet origin; then
        echo "FAIL  cannot fetch origin in $dir"
        return 1
    fi
    if git -C "$dir" merge-base --is-ancestor "$commit" origin/main; then
        echo "ok    $commit is on origin/main"
    else
        echo "FAIL  $commit is not on origin/main"
        failed=1
    fi
    if [[ $(git -C "$dir" log -1 --format='%(trailers:key=Step,valueonly)' "$commit") == "$step" ]]; then
        echo "ok    $commit has Step: $step"
    else
        echo "FAIL  $commit does not have Step: $step"
        failed=1
    fi
    if [[ ! -d $path ]]; then
        echo "ok    worktree is gone; skipping cleanliness check"
    elif [[ $(git -C "$path" branch --show-current) != "$branch" ]]; then
        echo "ok    worktree is on another branch; skipping cleanliness check"
    elif [[ -z $(git -C "$path" status --porcelain) ]]; then
        echo "ok    worktree on $branch is clean"
    else
        echo "FAIL  worktree on $branch is dirty"
        failed=1
    fi
    ((failed == 0)) || return 1
    set_step "$step" state=landed commit="$commit"
    echo "landed $step $commit"
}

# An implementer's report, logged by the implementer itself (development.md,
# section 8.6), so that nobody types it again: kept as reports/<repository>-
# <NN>-<time>.md, and appended to log.md under its heading, with the time
# read from the clock. Prints the report's path.
log_report() {
    load
    local repo=${1:?repository} session=${2:?session} file=${3:-} at stamp out i=1
    at=$(now)
    stamp=$(date -u -d "$at" +%Y%m%dT%H%M%SZ)
    mkdir -p "$run/reports"
    out=$run/reports/$repo-$session-$stamp.md
    while [[ -e $out ]]; do
        i=$((i + 1))
        out=$run/reports/$repo-$session-$stamp-$i.md
    done
    if [[ -n $file ]]; then cat -- "$file" >"$out"; else cat >"$out"; fi
    if ! grep -q '[^[:space:]]' "$out"; then
        rm -f "$out"
        die "the report is empty"
    fi
    exec 7>"$run/log.md.lock"
    flock 7
    { printf '## %s %s, %s\n\n' "$repo" "$session" "$at"; cat "$out"; printf '\n'; } >>"$run/log.md"
    flock -u 7
    echo "$out"
}

# Append a kit entry under the same lock as implementers' reports.
log_entry() {
    local heading=$1 body=${2:-}
    exec 7>"$run/log.md.lock"
    flock 7
    { printf '## %s\n\n' "$heading"; [[ -z $body ]] || cat "$body"; printf '\n'; } >>"$run/log.md"
    flock -u 7
}

# File the answer whole, then remove only the block headings it names.
unblocked() {
    load
    [[ -f $run/unblock.md ]] || die "no unblock.md"
    local body
    body=$(mktemp "$run/.unblocked.XXXXXX")
    { [[ ! -f $run/blocked.md ]] || cat "$run/blocked.md"; cat "$run/unblock.md"; } >"$body"
    log_entry "Blocked and unblocked, $(now)" "$body"
    rm "$body"
    if [[ -f $run/blocked.md ]]; then
        awk '
            FILENAME == ARGV[1] { if (/^Answer to /) answer[++n] = $0; next }
            /^## / {
                drop = 0
                for (i = 1; i <= n; i++) if (index(answer[i], substr($0, 4))) {
                    drop = 1; matched[i] = 1
                }
            }
            !drop { print }
            END { for (i = 1; i <= n; i++) if (!matched[i]) print answer[i] > "/dev/stderr" }
        ' "$run/unblock.md" "$run/blocked.md" >"$run/blocked.new"
        mv "$run/blocked.new" "$run/blocked.md"
        grep -q '^## ' "$run/blocked.md" || rm "$run/blocked.md"
    else
        grep '^Answer to ' "$run/unblock.md" || true
    fi
    rm "$run/unblock.md"
}

steered() {
    load
    [[ -f $run/steer.md ]] || die "no steer.md"
    log_entry "Steered, $(now)" "$run/steer.md"
    rm "$run/steer.md"
}

status() {
    load
    ledger_upgrade
    local ledger=$run/ledger.tsv out=$run/status.md landed_git
    # Steps landed according to origin/main's trailers, in every repository.
    landed_git=$(for repo in $repos; do
        [[ -d $root/$repo/.git ]] || continue
        git -C "$root/$repo" log origin/main --since="$(sed -n 4p "$active")" \
            --format='%(trailers:key=Plan,valueonly,separator=)%x09%(trailers:key=Step,valueonly,separator=)' 2>/dev/null |
            awk -F'\t' -v plan="$plan" '$1 == plan { print $2 }' || true
    done)
    {
        printf '# %s on %s\n\nRendered %s from ledger.tsv.\n\n' "$name" "$(sed -n 3p "$active")" "$(now)"
        if [[ -s $run/alerts.md ]]; then
            printf '## Alerts\n\n'
            tail -n 10 "$run/alerts.md"
            printf '\n'
        fi
        awk -F'\t' -v git="$landed_git" '
            BEGIN { n = split(git, g, "\n"); for (i = 1; i <= n; i++) if (g[i] != "") ongit[g[i]] = 1 }
            NR == 1 || $4 == "split" { next }
            {
                key = $2 " " $3; if (!(key in seen)) { seen[key] = 1; order[++k] = key }
                count[key, $4]++; total[key]++; all[$4]++; steps++
                if ($4 == "running") running[++r] = $0
                if ($4 == "blocked") blocked[++b] = $0
                if ($4 == "landed" && !($1 in ongit)) missing[++x] = $1
                if ($4 != "landed" && ($1 in ongit)) extra[++y] = $1 " (" $4 ")"
            }
            END {
                printf "%d of %d steps landed; %d running, %d blocked, %d ready, %d to check, %d waiting.\n\n",
                    all["landed"], steps, all["running"], all["blocked"], all["ready"], all["check"], all["waiting"]
                print "| Repo | Session | Landed | Running | Blocked | Ready | Check | Waiting | Total |"
                print "|---|---|---|---|---|---|---|---|---|"
                for (i = 1; i <= k; i++) {
                    split(order[i], p, " ")
                    printf "| %s | %s | %d | %d | %d | %d | %d | %d | %d |\n", p[1], p[2],
                        count[order[i], "landed"], count[order[i], "running"],
                        count[order[i], "blocked"], count[order[i], "ready"],
                        count[order[i], "check"], count[order[i], "waiting"], total[order[i]]
                }
                if (r) {
                    print "\n## Running\n\n| Step | Slot | Branch | Since | Title |\n|---|---|---|---|---|"
                    for (i = 1; i <= r; i++) { split(running[i], f, "\t"); printf "| %s | %s | %s | %s | %s |\n", f[1], f[5], f[7], f[9], f[10] }
                }
                if (b) {
                    print "\n## Blocked\n\n| Step | Since | Note |\n|---|---|---|"
                    for (i = 1; i <= b; i++) { split(blocked[i], f, "\t"); printf "| %s | %s | %s |\n", f[1], f[9], f[11] }
                }
                if (x || y) {
                    print "\n## Ledger and origin/main disagree\n"
                    for (i = 1; i <= x; i++) printf "- %s: landed in the ledger, no commit on origin/main says so\n", missing[i]
                    for (i = 1; i <= y; i++) printf "- %s: on origin/main, not landed in the ledger\n", extra[i]
                }
            }' "$ledger"
        [[ ${PLAN_NO_ROLES:-} == 1 ]] || roles
    } >"$out.new"
    mv "$out.new" "$out"
    cat "$out"
}

# The supervisor's worktree of the plan's repository (development.md,
# section 10.3): created at origin/main, and moved to it whenever it is
# clean. Its plan edits land with plan ruling. Prints its path.
docs_worktree() {
    local project=${name%%/*} dir=$run/docs
    git -C "$root/$project" fetch --quiet origin main 2>/dev/null || true
    local base=origin/main
    git -C "$root/$project" rev-parse --verify --quiet "$base" >/dev/null || base=main
    if [[ ! -d $dir ]]; then
        git -C "$root/$project" worktree add --quiet -B "$plan/docs" "$dir" "$base"
    elif [[ -z $(git -C "$dir" status --porcelain) ]]; then
        git -C "$dir" switch --quiet -C "$plan/docs" "$base"
    fi
    echo "$dir"
}

docs() {
    load
    docs_worktree
}

# A ruling, written once (development.md, section 10.3): its text is the
# Decision of unblock.draft.md, or with --text a file's. It becomes the next
# numbered ruling in the plan's decisions.md, under "## Rulings"; it lands
# with the plan edits waiting in the supervisor's worktree, with land
# --docs; and "{ruling}" in the title and the draft becomes its number. For
# an unblock, the draft's Landed section names the commit, the draft becomes
# unblock.md, and the doorbell rings.
ruling() {
    load
    local text="" draft=$run/unblock.draft.md
    if [[ ${1:-} == --text ]]; then
        text=${2:?file}
        shift 2
    fi
    local title=${1:?title} source=${2:?source} dir rel file decision n entry project=${name%%/*} hash files
    if [[ -z $text ]]; then
        [[ -f $draft ]] || die "no $draft: write the unblock there first (supervisor.md, section 3)"
        decision=$(awk '/^## Decision/ { on = 1; next } /^## / { on = 0 } on' "$draft")
    else
        decision=$(cat -- "$text")
    fi
    # From the first line with text; command substitution drops the blank lines at the end.
    decision=$(sed '/[^[:space:]]/,$!d' <<<"$decision")
    [[ -n $decision ]] || die "the ruling has no text"
    dir=$(docs_worktree)
    rel=$(cd "$plan_dir" && git rev-parse --show-prefix)
    rel=${rel%/}
    file=$dir/$rel/decisions.md
    [[ -f $file ]] || die "no decisions.md in $dir/$rel"
    n=$(awk '/^[0-9]+\. \*\*/ { k = $1 + 0; if (k > m) m = k } END { print (m < 100 ? 101 : m + 1) }' "$file")
    title=${title//\{ruling\}/$n}
    decision=${decision//\{ruling\}/$n}
    entry=$(printf '%s. **%s** (%s).\n' "$n" "$title" "$source"; awk 'NF { $0 = "     " $0 } { print }' <<<"$decision")
    ENTRY=$entry awk '
        BEGIN { entry = ENVIRON["ENTRY"] }
        /^## Rulings/ { rulings = 1 }
        /^## For the user/ && !done { if (!rulings) print "## Rulings\n"; print entry "\n"; done = 1 }
        { print }
        END { if (!done) { if (!rulings) print "\n## Rulings"; print "\n" entry } }' "$file" >"$file.new"
    mv "$file.new" "$file"
    git -C "$dir" add -A
    git -C "$dir" commit --quiet -m "Ruling $n of $plan" -m "$title ($source)."
    local args=(--docs)
    git -C "$dir" remote get-url origin >/dev/null 2>&1 || args+=(--local)
    (cd "$dir" && "$kit/land" "${args[@]}") >&2 || die "ruling $n did not land: its commit waits in $dir"
    hash=$(git -C "$dir" rev-parse --short HEAD)
    files=$(git -C "$dir" show --format= --name-only HEAD | sed "s|^$rel/||" | paste -sd ',' - | sed 's/,/, /g')
    if [[ -z $text ]]; then
        sed -i "s/{ruling}/$n/g" "$draft"
        LANDED="$project \`$hash\`: ruling $n, in $files." awk '
            /^## Landed/ { print; print ""; print ENVIRON["LANDED"]; print ""; skip = 1; next }
            /^## / { skip = 0 }
            !skip { print }' "$draft" >"$draft.new"
        mv "$draft.new" "$draft"
        if [[ -f $run/unblock.md ]]; then
            sed '1{/^# Unblock/d}' "$draft" >>"$run/unblock.md"
            rm -f "$draft"
        else
            mv "$draft" "$run/unblock.md"
        fi
        echo "ruling $n landed as $project $hash; unblock.md is ready"
        (ring "unblock.md is ready") || echo "plan: the doorbell did not ring; the coordinator finds unblock.md at its next wake-up" >&2
    else
        echo "ruling $n landed as $project $hash"
    fi
}

# Steps the supervisor has checked against main (development.md, section
# 7.2): ready, with the check's note, and the doorbell rung for them.
ready() {
    load
    local step=${1:?step} note=${2:-no change}
    [[ $(awk -F'\t' -v s="$step" 'NR > 1 && $1 == s { print $4 }' "$run/ledger.tsv") == check ]] ||
        die "$step is not waiting for its check"
    set_step "$step" state=ready "note=checked $(now): $note"
    (ring "ready: $step") || echo "plan: the doorbell did not ring; the coordinator starts $step at its next wake-up" >&2
}

