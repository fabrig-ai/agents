#!/usr/bin/env bash
# A plan's run on this machine (development.md, sections 6, 7, 10, 14, 15).
#
#   plan check [--fix] [PLAN_DIR] is the machine ready (to run the plan)?
#   plan start PLAN_DIR           check, claim, start the supervisor and the coordinator
#   plan status                   render status.md from the ledger, with the roles
#   plan attach ROLE              open a role's session: coordinator, supervisor, designer
#   plan resume                   after a restart, start the roles again
#   plan claim PLAN_DIR           make it this machine's active run
#   plan release                  end the active run
#   plan worktree REPO NAME       a session's worktree, at origin/main
#   plan worktree --remove REPO NAME
#   plan set STEP KEY=VALUE...    add or change a step in the ledger
#   plan watch                    wait for something the supervisor must see
#   plan ring MESSAGE             ring the coordinator's doorbell
#   plan join ROLE                record this Claude Code session as the run's ROLE
#   plan wake ROLE MESSAGE        resume a Claude Code role's session with MESSAGE
#   plan pulse                    the run's numbers since the last check
#   plan downstream               type-check each downstream repository against the plan's upstream mains
#   plan contexts                 each Codex thread's context, and the sessions past the limit
#   plan metrics [--out FILE] [PLAN_DIR]  the run's metrics, as TSV (the last run's, by default)
#   plan metrics --history        every plan's metrics, side by side
#   plan retro [PLAN_DIR]         start the run's retrospective (the last run's, by default)
#
# PLAN_DIR is the plan's directory in its repository's primary checkout,
# for example ~/src/rust/smith/docs/development/plans/reliability. The
# workspace is $DEV_ROOT, or the directory holding the skein checkout these
# tools come from. A run lives in $DEV_TMP/<repository>/<plan>/ (DEV_TMP is
# the workspace's tmp/ by default), and $DEV_TMP/active-plan names it; the
# commands after claim act on that run.
# shellcheck disable=SC2015 # in check, ok and warn always succeed
set -euo pipefail

kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# The workspace: DEV_ROOT, or the directory holding the skein checkout these
# tools come from (development.md, section 3.6), or ~/src/rust.
workspace() {
    local skein
    skein=$(cd "$kit/../.." && pwd)
    if [[ $(basename "$skein") == skein ]]; then dirname "$skein"; else echo "$HOME/src/rust"; fi
}
root=${DEV_ROOT:-$(workspace)}
tmp=${DEV_TMP:-$root/tmp}
# The workspace's repositories, upstream first (development.md, section 3.1).
all_repos="skein smith jig temper"
repos=${DEV_REPOS:-$all_repos}
active=$tmp/active-plan
columns='step	repo	session	state	slot	thread	branch	commit	updated	title	note'

# The roles' programs, models and efforts (development.md, section 2). The
# coordinator's come from its Codex profile in the kit.
profile=$kit/workspace/coordinator.config.toml
profile_value() { sed -nE "s/^$1 *= *\"?([^\"]*)\"? *$/\1/p" "$profile" | head -n1; }
claude_model=${PLAN_CLAUDE_MODEL:-claude-opus-5-5}
claude_effort=${PLAN_CLAUDE_EFFORT:-xhigh}
codex_model=${PLAN_CODEX_MODEL:-$(profile_value model)}
codex_effort=${PLAN_CODEX_EFFORT:-$(profile_value model_reasoning_effort)}
codex_threads=${PLAN_CODEX_THREADS:-$(profile_value max_threads)}
codex_sandbox=${PLAN_CODEX_SANDBOX:-danger-full-access}
# Where the Claude Code roles start: the workspace, which Claude Code must trust.
claude_dir=${PLAN_CLAUDE_DIR:-$root}

die() { echo "plan: $*" >&2; exit 2; }

usage() {
    sed -n '3,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

now() { date -u +%FT%TZ; }

# This machine's name; some containers have no hostname command.
host() { hostname 2>/dev/null || uname -n; }

# The active run: its name (repository/plan), plan directory and path.
load() {
    [[ -f $active ]] || die "no active run on this machine"
    name=$(sed -n 1p "$active")
    plan_dir=$(sed -n 2p "$active")
    run=$tmp/$name
    plan=${name#*/}
}

# A plan directory's repository and run name.
locate() {
    plan_dir=$(cd "${1:?plan directory}" && pwd)
    local top
    top=$(git -C "$plan_dir" rev-parse --show-toplevel)
    project=$(basename "$top")
    plan=$(basename "$plan_dir")
    name=$project/$plan
    run=$tmp/$name
    rel=${plan_dir#"$top"/}
    top_dir=$top
}

# A repository and those upstream of it: what a plan in it builds on.
upstream() {
    local repo out=""
    for repo in $all_repos; do
        out+="$repo "
        [[ $repo == "$1" ]] && { echo "${out% }"; return; }
    done
    echo "$all_repos"
}

# The last run on this machine: the active one, or the latest released.
last_run() {
    if [[ -f $active ]]; then
        load
        return
    fi
    local log
    log=$(ls -t "$tmp"/*/*/log.md 2>/dev/null | head -n1 || true)
    [[ -n $log ]] || die "no run on this machine"
    plan_dir=$(sed -nE 's/^The run of (.*) started on .*\.$/\1/p' "$log" | head -n1)
    [[ -n $plan_dir ]] || die "cannot find the plan of $(dirname "$log")"
    locate "$plan_dir"
}

check() {
    local fix=0 failed=0
    [[ ${1:-} == --fix ]] && { fix=1; shift; }
    ok() { echo "ok    $*"; }
    warn() { echo "warn  $*"; }
    fail() { echo "FAIL  $*"; failed=1; }
    (($#)) && check_plan "$1"

    # Every primary checkout a plan builds on: on main, clean, equal to
    # origin's main, and origin takes a push. Without DEV_REPOS, the plan's
    # repository and those upstream of it; without a plan, all of them.
    local repo dir ahead behind checked=$repos
    [[ -n ${DEV_REPOS:-} || -z ${project:-} ]] || checked=$(upstream "$project")
    for repo in $checked; do
        dir=$root/$repo
        [[ -d $dir/.git ]] || { warn "$repo: no checkout at $dir"; continue; }
        if [[ $(git -C "$dir" symbolic-ref --quiet --short HEAD || true) != main ]]; then
            fail "$repo: primary checkout is not on main"
            continue
        fi
        [[ -z $(git -C "$dir" status --porcelain) ]] ||
            fail "$repo: primary checkout has changes"
        git -C "$dir" fetch --quiet origin || { fail "$repo: cannot fetch origin"; continue; }
        read -r behind ahead < <(git -C "$dir" rev-list --left-right --count origin/main...main)
        if ((ahead || behind)); then
            fail "$repo: main is $ahead ahead and $behind behind origin/main"
        else
            ok "$repo: main is origin/main"
        fi
        if GIT_TERMINAL_PROMPT=0 git -C "$dir" push --dry-run --quiet origin main >/dev/null 2>&1; then
            ok "$repo: origin takes a push"
        else
            fail "$repo: origin refuses a push from here: git -C $dir push --dry-run origin main"
        fi
    done

    # One run per machine.
    if [[ ! -f $active ]]; then
        ok "no run is active"
    elif [[ $(sed -n 1p "$active") == "${name:-}" ]]; then
        ok "this run is the active one"
    elif [[ -n ${name:-} ]]; then
        fail "another run is active: $(sed -n 1p "$active")"
    else
        warn "a run is active: $(sed -n 1p "$active")"
    fi

    check_machine
    [[ -z ${project:-} ]] || check_gate
    return "$failed"
}

# The queue and the plan's gate, run once on main (development.md, section
# 6): a machine that cannot run them blocks every session at its first
# landing. A gate that passed on main's tree is not run again.
check_gate() {
    [[ ${PLAN_NO_GATE:-} != 1 ]] || { warn "PLAN_NO_GATE: the queue and the gate are not checked"; return 0; }
    local out
    if out=$("$kit/heavy" --tail 0 true 2>&1); then
        ok "heavy runs a task through the queue"
    else
        fail "heavy cannot run a task: $(tail -n1 <<<"$out")"
        return 0
    fi
    local dir=$root/$project gate=scripts/check.sh tree key cache
    if [[ ! -x $dir/$gate ]]; then
        warn "$project has no $gate: its gate is not checked"
        return 0
    fi
    tree=$(git -C "$dir" rev-parse 'main^{tree}')
    key=$(printf '%s\n%s\n%s\n' "$tree" "$gate" "$(rustc -V 2>/dev/null || true)" | sha1sum | cut -c1-40)
    cache=$tmp/gates/$project/$key
    if [[ -f $cache ]]; then
        ok "$project's gate passed on main's tree: $(cat "$cache")"
    elif out=$(cd "$dir" && HEAVY_LABEL="$project gate" "$kit/heavy" --gate --tail 20 bash -c "$gate" 2>&1); then
        mkdir -p "$(dirname "$cache")"
        echo "plan check passed on main" >"$cache"
        ok "$project's gate passes on main"
    else
        fail "$project's gate fails on main: $(grep '^heavy: task ' <<<"$out" | tail -n1)"
    fi
}

# The plan: complete, committed, on origin, and ready in STATUS.md.
check_plan() {
    locate "$1"
    local file
    git -C "$top_dir" fetch --quiet origin || fail "$project: cannot fetch origin"
    for file in README.md code-organization.md; do
        [[ -f $plan_dir/$file ]] && ok "plan has $file" || fail "plan has no $file"
    done
    if [[ -n $(git -C "$top_dir" status --porcelain -- "$rel") ]]; then
        fail "plan has uncommitted changes"
    elif git -C "$top_dir" cat-file -e "origin/main:$rel/README.md" 2>/dev/null; then
        ok "plan is on origin/main"
    else
        fail "plan is not on origin/main"
    fi

    # The plan's row in its repository's STATUS.md: ready, or this
    # machine's run being resumed.
    local row state
    row=$(grep -E "^\| *$plan *\|" "$top_dir/docs/design/STATUS.md" 2>/dev/null | head -n1 || true)
    state=$(awk -F'|' '{ gsub(/^ +| +$/, "", $3); print $3 }' <<<"$row")
    case $state in
    "") warn "no row for $plan in $project's docs/design/STATUS.md" ;;
    ready | "active on $(host)"*) ok "STATUS.md says $state" ;;
    *) fail "STATUS.md says $state" ;;
    esac
}

# The tools, the workspace's files, the queue and room to work.
check_machine() {
    # Tools.
    local tool
    for tool in git jq pueue flock cargo; do
        command -v "$tool" >/dev/null && ok "has $tool" || fail "no $tool"
    done
    cargo nextest --version >/dev/null 2>&1 && ok "has cargo-nextest" || fail "no cargo-nextest"
    local bin=$HOME/.local/bin
    for tool in heavy land plan; do
        if [[ $(readlink -f "$bin/$tool" 2>/dev/null) == "$kit/$tool" ]]; then
            ok "$tool is on PATH"
        elif ((fix)); then
            mkdir -p "$bin" && ln -sfn "$kit/$tool" "$bin/$tool" && ok "linked $bin/$tool"
        else
            fail "$bin/$tool does not link to $kit/$tool (--fix links it)"
        fi
    done

    # The workspace's own files live in skein, beside the tools.
    local pair link target
    for pair in "$root/AGENTS.md=AGENTS.md" "$root/CLAUDE.md=CLAUDE.md" \
        "${CODEX_HOME:-$HOME/.codex}/coordinator.config.toml=coordinator.config.toml"; do
        link=${pair%%=*}
        target=$kit/workspace/${pair#*=}
        if [[ $(readlink -f "$link" 2>/dev/null) == "$target" ]]; then
            ok "$link is skein's"
        elif [[ -e $link && ! -L $link ]]; then
            fail "$link is a file of its own; replace it with a link to $target"
        elif ((fix)); then
            mkdir -p "$(dirname "$link")" && ln -sfn "$target" "$link" && ok "linked $link"
        else
            fail "$link does not link to $target (--fix links it)"
        fi
    done

    # Cargo reaches the workspace's repositories on GitHub.
    if grep -qs 'git\.ekanayaka\.io' "$root"/*/Cargo.toml; then
        git config --global --get-regexp '^url\..*\.insteadof$' 2>/dev/null |
            grep -q ' https://git\.ekanayaka\.io/ai/$' &&
            ok "git rewrites git.ekanayaka.io to GitHub" ||
            fail "Cargo.toml names git.ekanayaka.io: git config --global url.git@github.com:forgetic/.insteadOf https://git.ekanayaka.io/ai/"
    fi
    grep -qs 'git-fetch-with-cli *= *true' "$HOME/.cargo/config.toml" &&
        ok "cargo fetches with git" ||
        fail "cargo must fetch with git: [net] git-fetch-with-cli = true in ~/.cargo/config.toml"
    local bus=0
    systemctl --user show-environment >/dev/null 2>&1 && bus=1
    if grep -qs kache "$HOME/.cargo/config.toml"; then
        if ((bus)); then
            systemctl --user is-active --quiet kache && ok "kache is running" ||
                warn "kache is configured but not running"
        else
            ok "kache is configured"
        fi
    else
        warn "no kache rustc-wrapper in ~/.cargo/config.toml"
    fi

    # The queue: the daemon as a user service, and its two lanes. Without a
    # systemd user bus (some containers), pueued runs on its own, and `plan
    # resume` starts it again after a restart.
    local unit=$HOME/.config/systemd/user/pueued.service
    if ((!bus)); then
        if pueue status >/dev/null 2>&1; then
            ok "pueued is running (no systemd user bus: plan resume starts it after a restart)"
        elif ((fix)); then
            pueued --daemonize >/dev/null 2>&1 && sleep 1
            pueue status >/dev/null 2>&1 && ok "pueued started" || fail "pueued does not start"
        else
            fail "pueued is not running (--fix starts it)"
        fi
    elif systemctl --user is-active --quiet pueued; then
        ok "pueued is running as a user service"
        [[ $(systemctl --user show pueued -p UnitFileState --value) == enabled ]] ||
            warn "pueued's unit is not enabled: it will not start after a reboot (stop it when the queue is idle, then --fix)"
    elif ((fix)); then
        if ! systemctl --user cat pueued >/dev/null 2>&1; then
            mkdir -p "$(dirname "$unit")"
            printf '%s\n' '[Unit]' 'Description=pueue daemon' '' '[Service]' \
                "ExecStart=$(command -v pueued) --verbose" 'Restart=on-failure' '' \
                '[Install]' 'WantedBy=default.target' >"$unit"
            systemctl --user daemon-reload
            systemctl --user enable --quiet pueued
        fi
        systemctl --user restart pueued && sleep 1
        systemctl --user is-active --quiet pueued && ok "pueued started" ||
            fail "pueued does not start"
    else
        fail "pueued is not running as a user service (--fix starts it)"
    fi
    ((!bus)) || [[ $(loginctl show-user "$USER" -p Linger --value 2>/dev/null) == yes ]] ||
        warn "no lingering: user services stop when $USER logs out (loginctl enable-linger)"
    local group want have status
    for group in gate build; do
        want=1
        [[ $group == build ]] && want=${HEAVY_BUILD_SLOTS:-2}
        have=$(pueue group --json 2>/dev/null | jq -r --arg g "$group" '.[$g].parallel_tasks // empty')
        if [[ -z $have ]] && ((fix)); then
            pueue group add "$group" >/dev/null
            pueue parallel "$want" --group "$group" >/dev/null
            have=$want
        fi
        if [[ -z $have ]]; then
            fail "queue lane $group is missing (--fix adds it)"
            continue
        fi
        if [[ $have != "$want" ]] && ((fix)); then
            pueue parallel "$want" --group "$group" >/dev/null && have=$want
        fi
        [[ $have == "$want" ]] && ok "queue lane $group runs $want at once" ||
            warn "queue lane $group runs $have at once, not $want (--fix sets it)"
        status=$(pueue group --json | jq -r --arg g "$group" '.[$g].status')
        if [[ $status != Running ]] && ((fix)); then
            pueue start --group "$group" >/dev/null && status=Running
        fi
        [[ $status == Running ]] && ok "queue lane $group is running" ||
            fail "queue lane $group is $status (--fix starts it)"
    done

    # Room to work.
    local disk mem
    disk=$(df -BG --output=avail "$root" | tail -n1 | tr -dc 0-9)
    mem=$(awk '/MemAvailable/ { print int($2 / 1048576) }' /proc/meminfo)
    ((disk >= ${PLAN_MIN_DISK_GB:-40})) && ok "disk: ${disk} GB free" ||
        fail "disk: ${disk} GB free, want ${PLAN_MIN_DISK_GB:-40}"
    ((mem >= ${PLAN_MIN_MEM_GB:-6})) && ok "memory: ${mem} GB available" ||
        fail "memory: ${mem} GB available, want ${PLAN_MIN_MEM_GB:-6}"

    # The roles' programs: Claude Code trusts the workspace, where the
    # supervisor starts, and Codex's daemon answers.
    if command -v claude >/dev/null; then
        jq -e --arg d "$claude_dir" '.projects[$d].hasTrustDialogAccepted == true' "$HOME/.claude.json" >/dev/null 2>&1 &&
            ok "Claude Code trusts $claude_dir" ||
            fail "Claude Code does not trust $claude_dir: run claude there once, and accept"
    else
        fail "no claude"
    fi
    if command -v codex >/dev/null; then
        codex app-server daemon version >/dev/null 2>&1 || { ((fix)) && codex app-server daemon start >/dev/null 2>&1; } || true
        codex app-server daemon version 2>/dev/null | jq -e '.status == "running"' >/dev/null &&
            ok "Codex's app-server daemon is running" ||
            fail "Codex's app-server daemon is not running (--fix starts it)"
    else
        fail "no codex"
    fi

    # The coordinator's Codex profile.
    local profile=${CODEX_HOME:-$HOME/.codex}/coordinator.config.toml
    grep -qs max_threads "$profile" && ok "Codex profile coordinator sets max_threads" ||
        fail "no Codex profile at $profile setting [agents] max_threads"

}

claim() {
    locate "${1:?plan directory}"
    if [[ -f $active && $(sed -n 1p "$active") != "$name" ]]; then
        die "another run is active: $(sed -n 1p "$active")"
    fi
    mkdir -p "$run"/{logs,sessions,wt}
    [[ -f $run/ledger.tsv ]] || printf '%s\n' "$columns" >"$run/ledger.tsv"
    [[ -f $run/log.md ]] || printf '# %s on %s\n\n' "$name" "$(host)" >"$run/log.md"
    if [[ -f $active ]]; then
        echo "$run"
        return
    fi
    printf '%s\n%s\n%s\n%s\n' "$name" "$plan_dir" "$(host)" "$(now)" >"$active"
    printf '## Claimed, %s\n\nThe run of %s started on %s.\n\n' "$(now)" "$plan_dir" "$(host)" >>"$run/log.md"
    touch "$run/heartbeat"
    echo "$run"
}

release() {
    load
    if [[ -n $(ls -A "$run/wt" 2>/dev/null) ]]; then
        die "worktrees are left in $run/wt; remove them first"
    fi
    printf '## Released, %s\n\n' "$(now)" >>"$run/log.md"
    rm -f "$active"
    echo "released $name"
}

worktree() {
    load
    local remove=0
    [[ ${1:-} == --remove ]] && { remove=1; shift; }
    local repo=${1:?repository} label=${2:?name}
    local dir=$root/$repo path=$run/wt/$repo-$label
    if ((remove)); then
        git -C "$dir" worktree remove "$path"
        echo "removed $path"
        return
    fi
    git -C "$dir" fetch --quiet origin main
    git -C "$dir" worktree add --quiet --detach "$path" origin/main
    echo "$path"
}

# A ledger written before the thread column gains it, empty.
ledger_upgrade() {
    local ledger=$run/ledger.tsv
    [[ -f $ledger ]] || return 0
    [[ $(head -n1 "$ledger") == "${columns//	thread/}" ]] || return 0
    awk -F'\t' -v OFS='\t' '{ $5 = $5 OFS (NR == 1 ? "thread" : ""); print }' "$ledger" >"$ledger.new"
    mv "$ledger.new" "$ledger"
}

set_step() {
    load
    ledger_upgrade
    local step=${1:?step}
    shift
    local pairs=() pair key
    for pair in "$@"; do
        key=${pair%%=*}
        case $key in
        repo | session | slot | thread | branch | commit | title | note) ;;
        state)
            case ${pair#*=} in
            waiting | ready | running | blocked | landed | dropped) ;;
            *) die "state is one of waiting, ready, running, blocked, landed, dropped" ;;
            esac
            ;;
        *) die "unknown key $key" ;;
        esac
        [[ $pair != *$'\t'* ]] || die "no tabs in values"
        pairs+=("$pair")
    done
    local ledger=$run/ledger.tsv
    exec 8>"$ledger.lock"
    flock 8
    STEP=$step AT=$(now) SETS=$(printf '%s\n' "${pairs[@]}") awk -F'\t' -v OFS='\t' '
        BEGIN {
            step = ENVIRON["STEP"]; at = ENVIRON["AT"]; sets = ENVIRON["SETS"]
            n = split("step repo session state slot thread branch commit updated title note", name, " ")
            for (i = 1; i <= n; i++) col[name[i]] = i
            m = split(sets, line, "\n")
            for (i = 1; i <= m; i++) if (line[i] != "") {
                k = substr(line[i], 1, index(line[i], "=") - 1)
                value[col[k]] = substr(line[i], index(line[i], "=") + 1)
                given[col[k]] = 1
            }
        }
        function apply(   i) {
            for (i = 1; i <= n; i++) if (i in given) $i = value[i]
            $col["updated"] = at
        }
        NR > 1 && $1 == step { apply(); found = 1 }
        { print }
        END {
            if (!found) {
                $0 = step; for (i = 2; i <= n; i++) $i = ""
                if (!("4" in given)) { value[4] = "waiting"; given[4] = 1 }
                apply(); print
            }
        }' "$ledger" >"$ledger.new"
    mv "$ledger.new" "$ledger"
    flock -u 8
}

status() {
    load
    ledger_upgrade
    local ledger=$run/ledger.tsv out=$run/status.md landed_git
    # Steps landed according to origin/main's trailers, in every repository.
    landed_git=$(for repo in $repos; do
        [[ -d $root/$repo/.git ]] || continue
        git -C "$root/$repo" log origin/main --since="$(sed -n 4p "$active")" \
            --format='%(trailers:key=Plan,valueonly,separator=)%x09%(trailers:key=Step,valueonly,separator=)' 2>/dev/null |
            awk -F'\t' -v plan="$plan" '$1 == plan { print $2 }' || true
    done)
    {
        printf '# %s on %s\n\nRendered %s from ledger.tsv.\n\n' "$name" "$(sed -n 3p "$active")" "$(now)"
        awk -F'\t' -v git="$landed_git" '
            BEGIN { n = split(git, g, "\n"); for (i = 1; i <= n; i++) if (g[i] != "") ongit[g[i]] = 1 }
            NR == 1 { next }
            {
                key = $2 " " $3; if (!(key in seen)) { seen[key] = 1; order[++k] = key }
                count[key, $4]++; total[key]++; all[$4]++; steps++
                if ($4 == "running") running[++r] = $0
                if ($4 == "blocked") blocked[++b] = $0
                if ($4 == "landed" && !($1 in ongit)) missing[++x] = $1
                if ($4 != "landed" && ($1 in ongit)) extra[++y] = $1 " (" $4 ")"
            }
            END {
                printf "%d of %d steps landed; %d running, %d blocked, %d ready, %d waiting.\n\n",
                    all["landed"], steps, all["running"], all["blocked"], all["ready"], all["waiting"]
                print "| Repo | Session | Landed | Running | Blocked | Ready | Waiting | Total |"
                print "|---|---|---|---|---|---|---|---|"
                for (i = 1; i <= k; i++) {
                    split(order[i], p, " ")
                    printf "| %s | %s | %d | %d | %d | %d | %d | %d |\n", p[1], p[2],
                        count[order[i], "landed"], count[order[i], "running"],
                        count[order[i], "blocked"], count[order[i], "ready"],
                        count[order[i], "waiting"], total[order[i]]
                }
                if (r) {
                    print "\n## Running\n\n| Step | Slot | Branch | Since | Title |\n|---|---|---|---|---|"
                    for (i = 1; i <= r; i++) { split(running[i], f, "\t"); printf "| %s | %s | %s | %s | %s |\n", f[1], f[5], f[7], f[9], f[10] }
                }
                if (b) {
                    print "\n## Blocked\n\n| Step | Since | Note |\n|---|---|---|"
                    for (i = 1; i <= b; i++) { split(blocked[i], f, "\t"); printf "| %s | %s | %s |\n", f[1], f[9], f[11] }
                }
                if (x || y) {
                    print "\n## Ledger and origin/main disagree\n"
                    for (i = 1; i <= x; i++) printf "- %s: landed in the ledger, no commit on origin/main says so\n", missing[i]
                    for (i = 1; i <= y; i++) printf "- %s: on origin/main, not landed in the ledger\n", extra[i]
                }
            }' "$ledger"
        [[ ${PLAN_NO_ROLES:-} == 1 ]] || roles
    } >"$out.new"
    mv "$out.new" "$out"
    cat "$out"
}

# Wait until the supervisor has something to do (development.md, section
# 10.5): a new blocked report, the designer's answer, the coordinator gone
# quiet (once, and again after as long), a pause or the end. Prints what,
# and exits. The designer has no watch: plan wake resumes it.
watch() {
    load
    local seen=$run/.watch quiet=${PLAN_QUIET:-600} sig beat age
    touch "$seen"
    while :; do
        if [[ -f $run/done.md ]] && ! grep -qx "done" "$seen"; then
            echo "done" >>"$seen"
            echo "done: $run/done.md"
            return
        fi
        if [[ -f $run/paused.md ]]; then
            sig=paused:$(stat -c %Y "$run/paused.md")
            if ! grep -qxF "$sig" "$seen"; then
                echo "$sig" >>"$seen"
                echo "paused: $run/paused.md"
                return
            fi
        fi
        if [[ -f $run/blocked.md && ! -f $run/unblock.md ]]; then
            sig=blocked:$(grep '^## ' "$run/blocked.md" | sha1sum | cut -c1-12)
            if ! grep -qxF "$sig" "$seen"; then
                echo "$sig" >>"$seen"
                echo "blocked: $run/blocked.md"
                grep '^## ' "$run/blocked.md" || true
                return
            fi
        fi
        if [[ -f $run/answer.md ]]; then
            sig=answer:$(stat -c %Y "$run/answer.md")
            if ! grep -qxF "$sig" "$seen"; then
                echo "$sig" >>"$seen"
                echo "answer: $run/answer.md"
                return
            fi
        fi
        if [[ -f $run/heartbeat && ! -f $run/paused.md && ! -f $run/done.md ]]; then
            beat=$(stat -c %Y "$run/heartbeat")
            age=$(($(date +%s) - beat))
            for sig in quiet2:$beat quiet:$beat; do
                if [[ $sig == quiet2:* ]] && { ((age <= 2 * quiet)) || ! grep -qxF "quiet:$beat" "$seen"; }; then
                    continue
                fi
                if ((age > quiet)) && ! grep -qxF "$sig" "$seen"; then
                    echo "quiet:$beat" >>"$seen"
                    echo "$sig" >>"$seen"
                    if [[ $sig == quiet2:* ]]; then
                        echo "quiet again: no heartbeat from the coordinator since $(date -u -d "@$beat" +%TZ)"
                    else
                        echo "quiet: no heartbeat from the coordinator since $(date -u -d "@$beat" +%TZ)"
                    fi
                    return
                fi
            done
        fi
        sleep "${PLAN_POLL:-30}"
    done
}

# The run's roles (development.md, section 2): the coordinator's Codex
# thread, in the run's thread file, and the Claude Code sessions, one line
# each in claude.tsv: role, session id, time recorded.

# Every Claude Code session this machine knows, as JSON.
claude_sessions() { claude agents --json --all 2>/dev/null || echo '[]'; }

# The latest session id recorded for a role.
role_session() {
    [[ -f $run/claude.tsv ]] || return 0
    awk -F'\t' -v role="$1" '$1 == role { id = $2 } END { print id }' "$run/claude.tsv"
}

record_role() {
    printf '%s\t%s\t%s\n' "$1" "$2" "$(now)" >>"$run/claude.tsv"
}

# A Claude Code session's state: running, idle, or gone.
session_state() {
    claude_sessions | jq -r --arg s "$1" '
        [.[] | select(.sessionId == $s)] | last
        | if . == null then "gone" else (.status // .state // "running") end'
}

# Starts a background Claude Code session for a role, in the workspace's
# directory, and records it. With a session id, continues that session.
claude_role() {
    local role=$1 prompt=$2 resume=${3:-} out id session
    local args=(--bg -n "$plan $role" --model "$claude_model" --effort "$claude_effort"
        --dangerously-skip-permissions)
    [[ -n $resume ]] && args+=(--resume "$resume")
    out=$(cd "$claude_dir" && claude "${args[@]}" "$prompt" 2>&1) ||
        die "claude did not start the $role: $out"
    id=$(grep -oE '\b[0-9a-f]{8}\b' <<<"$out" | head -n1 || true)
    session=$(claude_sessions | jq -r --arg id "$id" --arg name "$plan $role" '
        [.[] | select((.id == $id and $id != "") or .name == $name)] | last | .sessionId // empty')
    [[ -n $session ]] || session=$resume
    [[ -n $session ]] || die "cannot find the $role's session: $out"
    record_role "$role" "$session"
    echo "$role: Claude Code session $session"
}

# The coordinator's thread on the Codex daemon: loaded, with its turn's state.
coordinator_state() {
    local thread
    thread=$(cat "$run/thread" 2>/dev/null || true)
    [[ -n $thread ]] || { echo "none"; return; }
    (
        # shellcheck source=codex.sh
        source "$kit/codex.sh"
        codex_open >/dev/null 2>&1 || { echo "unreachable"; exit; }
        codex_call thread/read "$(jq -cn --arg t "$thread" '{threadId: $t, includeTurns: true}')" 2>/dev/null |
            jq -r '[.thread.turns[]? | .status] | last // "idle" | if . == "inProgress" then "working" else "idle" end' ||
            echo "not loaded"
        codex_close
    )
}

ring() {
    load
    local message=${1:?message} thread turn
    thread=$(cat "$run/thread" 2>/dev/null) || die "no coordinator thread in $run/thread"
    # shellcheck source=codex.sh
    source "$kit/codex.sh"
    codex_open || exit 1
    turn=$(codex_call thread/read "$(jq -cn --arg t "$thread" '{threadId: $t, includeTurns: true}')" |
        jq -r '[.thread.turns[]? | select(.status == "inProgress")] | last | .id // empty') ||
        { echo "plan: the coordinator's thread is not loaded: plan resume" >&2; exit 3; }
    [[ -n $turn ]] || { echo "plan: the coordinator has no turn in progress: plan resume" >&2; exit 3; }
    codex_call turn/steer "$(jq -cn --arg t "$thread" --arg u "$turn" --arg m "$message" \
        '{threadId: $t, expectedTurnId: $u, input: [{type: "text", text: $m}]}')" >/dev/null
    codex_close
    echo "rang the coordinator: $message"
}

# The roles' prompts. Tests replace them through PLAN_*_PROMPT.
coordinator_prompt() {
    local text="Coordinate the run of $plan_dir, as skein's docs/foundation/development.md, section 7, says."
    echo "${PLAN_COORDINATOR_PROMPT:-$text}"
}

coordinator_resume_prompt() {
    local text="Resume the run of $plan_dir as skein's docs/foundation/development.md, section 7.6, says."
    echo "${PLAN_COORDINATOR_RESUME:-$text}"
}

start_coordinator() {
    local result thread
    # shellcheck source=codex.sh
    source "$kit/codex.sh"
    codex_open || die "the Codex daemon does not answer: codex app-server daemon start"
    result=$(codex_call thread/start "$(jq -cn --arg cwd "$root" --arg model "$codex_model" \
        --arg effort "$codex_effort" --argjson threads "${codex_threads:-8}" --arg sandbox "$codex_sandbox" \
        '{cwd: $cwd, model: $model, sandbox: $sandbox, approvalPolicy: "never",
          config: {model_reasoning_effort: $effort, agents: {max_threads: $threads}}}')") ||
        die "the Codex daemon did not start the coordinator's thread"
    thread=$(jq -r '.thread.id' <<<"$result")
    printf '%s\n' "$thread" >"$run/thread"
    printf '%s\t%s\n' "$thread" "$(now)" >>"$run/threads"
    codex_call thread/name/set "$(jq -cn --arg t "$thread" --arg n "$plan coordinator" \
        '{threadId: $t, name: $n}')" >/dev/null || true
    codex_call turn/start "$(jq -cn --arg t "$thread" --arg p "$(coordinator_prompt)" \
        '{threadId: $t, input: [{type: "text", text: $p}]}')" >/dev/null ||
        die "the Codex daemon did not start the coordinator's turn"
    codex_close
    echo "coordinator: Codex thread $thread"
}

supervisor_prompt() {
    local text="Supervise the run of $plan_dir as skein's docs/foundation/development.md, sections 2.5, 3.3, 4.5, 6, 7.6, 10 and 14, say. The run's directory is $run."
    echo "${PLAN_SUPERVISOR_PROMPT:-$text}"
}

supervisor_resume_prompt() {
    local text="Your session restarted. Start your watch and your hourly check again (development.md, section 6, step 4), read the end of supervision.md, and go on supervising the run of $plan_dir."
    echo "${PLAN_SUPERVISOR_RESUME:-$text}"
}

retro_prompt() {
    local text="Write the retrospective of the run of $plan_dir, as skein's docs/foundation/development.md, section 15, says. The run's directory is $run."
    echo "${PLAN_RETRO_PROMPT:-$text}"
}

start() {
    local dir=${1:?plan directory}
    if [[ ${PLAN_START_UNCHECKED:-} != 1 ]]; then
        check "$dir" || die "the machine is not ready: fix what check says (plan check --fix $dir), then start again"
    fi
    claim "$dir" >/dev/null
    load
    [[ ! -s $run/thread ]] || die "the run has a coordinator already: plan resume"
    claude_role supervisor "$(supervisor_prompt)"
    start_coordinator
    sleep "${PLAN_RING_DELAY:-5}"
    ring "Doorbell test: log it as development.md, section 7.4, says, and go on." ||
        echo "plan: the doorbell did not ring; steers wait for the coordinator's next wake-up" >&2
    echo "started $name: plan status, plan attach supervisor, plan attach coordinator"
}

attach() {
    load
    local role=${1:?role: coordinator, supervisor, designer or retrospective} session line
    if [[ $role == coordinator ]]; then
        line=(codex resume --remote unix:// "$(cat "$run/thread")")
    else
        session=$(role_session "$role")
        [[ -n $session ]] || die "no $role recorded in $run/claude.tsv"
        if [[ $(session_state "$session") == gone ]]; then
            line=(claude --resume "$session")
        else
            line=(claude attach "${session:0:8}")
        fi
    fi
    if [[ ${PLAN_DRY_RUN:-} == 1 ]]; then
        echo "${line[*]}"
        return
    fi
    exec "${line[@]}"
}

# After a restart, or a role's crash: start what is not running again.
resume() {
    load
    [[ ! -f $run/done.md ]] || die "the run is done"
    pueue status >/dev/null 2>&1 ||
        { systemctl --user start pueued 2>/dev/null || pueued --daemonize >/dev/null 2>&1 || true; }
    codex app-server daemon start >/dev/null 2>&1 || true

    local session state thread
    session=$(role_session supervisor)
    state=$(session_state "${session:-none}")
    if [[ -z $session ]]; then
        claude_role supervisor "$(supervisor_prompt)"
    elif [[ $state == gone || $state == exited || $state == stopped ]]; then
        claude_role supervisor "$(supervisor_resume_prompt)" "$session"
    else
        echo "supervisor: running ($state)"
    fi

    thread=$(cat "$run/thread" 2>/dev/null || true)
    if [[ -z $thread ]]; then
        start_coordinator
        return
    fi
    # shellcheck source=codex.sh
    source "$kit/codex.sh"
    codex_open || die "the Codex daemon does not answer: codex app-server daemon start"
    state=$(codex_call thread/read "$(jq -cn --arg t "$thread" '{threadId: $t, includeTurns: true}')" 2>/dev/null |
        jq -r '[.thread.turns[]? | .status] | last // "none"') || state="not loaded"
    if [[ $state == "not loaded" ]]; then
        codex_call thread/resume "$(jq -cn --arg t "$thread" --arg sandbox "$codex_sandbox" \
            '{threadId: $t, sandbox: $sandbox, approvalPolicy: "never"}')" >/dev/null ||
            die "the Codex daemon cannot load the coordinator's thread $thread"
    fi
    if [[ $state == inProgress ]]; then
        echo "coordinator: working"
    else
        codex_call turn/start "$(jq -cn --arg t "$thread" --arg p "$(coordinator_resume_prompt)" \
            '{threadId: $t, input: [{type: "text", text: $p}]}')" >/dev/null ||
            die "the Codex daemon did not start the coordinator's turn"
        echo "coordinator: resumed, Codex thread $thread"
    fi
    codex_close
}

join() {
    load
    local role=${1:?role}
    [[ -n ${CLAUDE_CODE_SESSION_ID:-} ]] || die "run plan join from the Claude Code session itself"
    record_role "$role" "$CLAUDE_CODE_SESSION_ID"
    echo "$role: Claude Code session $CLAUDE_CODE_SESSION_ID"
    [[ $role != designer ]] ||
        echo "End your turn now, and start no watch: plan wake brings you back with each question (development.md, section 10.4)."
}

# Resumes a role's Claude Code session in the background with a message. A
# session already running gets a copy, which Claude Code names.
wake() {
    load
    local role=${1:?role} message=${2:?message} session
    session=$(role_session "$role")
    [[ -n $session ]] || die "no $role recorded in $run/claude.tsv (plan join $role)"
    claude_role "$role" "$message" "$session"
}

retro() {
    if (($#)); then
        locate "$1"
    else
        last_run
    fi
    [[ -d $run ]] || die "no run directory at $run"
    claude_role retrospective "$(retro_prompt)"
}

roles() {
    local session thread
    echo
    echo "## Roles"
    echo
    thread=$(cat "$run/thread" 2>/dev/null || true)
    echo "- coordinator: ${thread:-not started}, $(coordinator_state); heartbeat $(($(date +%s) - $(stat -c %Y "$run/heartbeat" 2>/dev/null || date +%s))) s ago"
    local role
    for role in supervisor designer retrospective; do
        session=$(role_session "$role")
        [[ -n $session ]] && echo "- $role: $session, $(session_state "$session")"
    done
    local file
    for file in blocked unblock steer question answer paused "done"; do
        [[ -f $run/$file.md ]] && echo "- $file.md: $(grep -c '^## ' "$run/$file.md" || true) headings, since $(date -u -d "@$(stat -c %Y "$run/$file.md")" +%FT%TZ)"
    done
    if [[ -f $run/supervision.md ]]; then
        echo "- last check: $(grep '^## ' "$run/supervision.md" | tail -n1 | sed 's/^## //')"
    fi
    return 0
}

# shellcheck source=numbers.sh
source "$kit/numbers.sh"

# Each repository downstream of what the plan has landed, type-checked
# against those repositories' mains: its pins on them moved to their
# latest main in a worktree of its own, then `cargo check` through the
# build lane (development.md, sections 5.7 and 14.1). One line each, with
# the errors by the repository whose code they are in. Nothing is landed.
downstream() {
    load
    local changed repo up package dir out log errors update ok probed=0
    changed=$(plan_commits 0 | cut -f1 | sort -u)
    [[ -n $changed ]] || { echo "downstream: nothing has landed yet"; return 0; }
    for repo in $all_repos; do
        [[ -f $root/$repo/Cargo.lock ]] || continue
        update=""
        for up in $all_repos; do
            [[ $up != "$repo" ]] || break
            grep -qx "$up" <<<"$changed" || continue
            # One package of that repository: updating it moves its whole source.
            package=$(awk -v up="/$up.git#" '
                /^name = / { n = $3; gsub(/"/, "", n) }
                /^source = "git\+/ && index($0, up) { print n; exit }' "$root/$repo/Cargo.lock")
            [[ -z $package ]] || update+="cargo update --quiet -p $package && "
        done
        [[ -n $update ]] || continue
        probed=1
        dir=$run/wt/$repo-downstream
        git -C "$root/$repo" fetch --quiet origin main
        if [[ -d $dir ]]; then
            git -C "$dir" checkout --quiet --force --detach origin/main
        else
            git -C "$root/$repo" worktree add --quiet --detach "$dir" origin/main
        fi
        ok=0
        out=$(cd "$dir" && HEAVY_LABEL="$repo downstream" "$kit/heavy" --tail 0 \
            bash -c "${update}cargo check --workspace --all-targets --keep-going --message-format short" 2>&1) && ok=1
        log=$(sed -nE 's/^heavy: task .* log (.*)$/\1/p' <<<"$out" | tail -n1)
        if ((ok)); then
            echo "$repo against $(tr '\n' ' ' <<<"$changed" | sed 's/ $//') main: builds"
            continue
        fi
        errors=$(grep -E '^[^ ]+:[0-9]+:[0-9]+: error' "${log:-/dev/null}" 2>/dev/null |
            sed -E "s|^.*/git/checkouts/([a-z]+)-[0-9a-f]+/.*|\1|; t; s|.*|$repo|" |
            sort | uniq -c | awk '{ printf "%s%d in %s'"'"'s code", (NR > 1 ? ", " : ""), $1, $2 }')
        echo "$repo against $(tr '\n' ' ' <<<"$changed" | sed 's/ $//') main: fails, ${errors:-no compiler error}; log $log"
    done
    ((probed)) || echo "downstream: no repository pins $(tr '\n' ' ' <<<"$changed" | sed 's/ $//')"
}

# Each Codex thread's context, the input of its last request: the
# coordinator's, then each session's. A session past PLAN_CONTEXT_LIMIT
# (200,000 tokens) hands over after its next landing (development.md,
# section 7.3).
contexts() {
    load
    local limit=${PLAN_CONTEXT_LIMIT:-200000} kind slot thread last peak flag
    while IFS=$'\t' read -r kind slot thread last peak; do
        flag=""
        [[ $kind != session ]] || ((last <= limit)) || flag="  past $((limit / 1000))K: hand over"
        printf '%-14s %s  %dK, peak %dK%s\n' "$slot" "$thread" "$((last / 1000))" "$((peak / 1000))" "$flag"
    done < <(thread_contexts)
}

cmd=${1:-}
(($#)) && shift
case $cmd in
check) check "$@" ;;
start) start "$@" ;;
attach) attach "$@" ;;
resume) resume ;;
claim) claim "$@" ;;
release) release ;;
worktree) worktree "$@" ;;
set) set_step "$@" ;;
status) status ;;
watch) watch "$@" ;;
ring) ring "$@" ;;
join) join "$@" ;;
wake) wake "$@" ;;
pulse) pulse ;;
downstream) downstream ;;
contexts) contexts ;;
metrics) metrics "$@" ;;
retro) retro "$@" ;;
*) usage ;;
esac
