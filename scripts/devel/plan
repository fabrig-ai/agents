# Each repository downstream of what the plan has landed, type-checked
# against those repositories' mains: its pins on them moved to their
# latest main in a worktree of its own, then `cargo check` through the
# build lane (development.md, sections 5.7 and 14.1). One line each, with
# the errors by the repository whose code they are in. Nothing is landed.
made=()
# shellcheck disable=SC2317 # the EXIT trap runs after downstream returns
unmake() {
    local repo
    for repo in "${made[@]}"; do
        git -C "$root/$repo" worktree remove --force "$run/downstream/$repo" || true
    done
    rmdir "$run/downstream" 2>/dev/null || true
}
downstream() {
    load
    made=()
    trap unmake EXIT
    local changed repo up package dir out log errors update ok probed=0
    changed=$(plan_commits 0 | cut -f1 | sort -u)
    [[ -n $changed ]] || { echo "downstream: nothing has landed yet"; return 0; }
    for repo in $repos; do
        [[ -f $root/$repo/Cargo.lock ]] || continue
        update=""
        for up in $repos; do
            [[ $up != "$repo" ]] || break
            grep -qx "$up" <<<"$changed" || continue
            # One package of that repository: updating it moves its whole source.
            package=$(awk -v up="/$up.git#" '
                /^name = / { n = $3; gsub(/"/, "", n) }
                /^source = "git\+/ && index($0, up) { print n; exit }' "$root/$repo/Cargo.lock")
            [[ -z $package ]] || update+="cargo update --quiet -p $package && "
        done
        [[ -n $update ]] || continue
        probed=1
        dir=$run/downstream/$repo
        git -C "$root/$repo" fetch --quiet origin main
        git -C "$root/$repo" worktree add --quiet --detach "$dir" origin/main
        made+=("$repo")
        ok=0
        out=$(cd "$dir" && HEAVY_LABEL="$repo downstream" "$kit/heavy" --tail 0 \
            bash -c "${update}cargo check --workspace --all-targets --keep-going --message-format short" 2>&1) && ok=1
        log=$(sed -nE 's/^heavy: task .* log (.*)$/\1/p' <<<"$out" | tail -n1)
        if ((ok)); then
            echo "$repo against $(tr '\n' ' ' <<<"$changed" | sed 's/ $//') main: builds"
            continue
        fi
        errors=$({ grep -E '^[^ ]+:[0-9]+:[0-9]+: error' "${log:-/dev/null}" 2>/dev/null || true; } |
            sed -E "s|^.*/git/checkouts/([a-z]+)-[0-9a-f]+/.*|\1|; t; s|.*|$repo|" |
            sort | uniq -c | awk '{ printf "%s%d in %s'"'"'s code", (NR > 1 ? ", " : ""), $1, $2 }')
        echo "$repo against $(tr '\n' ' ' <<<"$changed" | sed 's/ $//') main: fails, ${errors:-no compiler error}; log $log"
    done
    ((probed)) || echo "downstream: no repository pins $(tr '\n' ' ' <<<"$changed" | sed 's/ $//')"
}

# Each Codex thread's context, the input of its last request, and the
# largest it reached: the coordinator's, then each session's. A session
# whose largest passed PLAN_CONTEXT_LIMIT (150,000 tokens) hands over after
# its next landing (development.md, section 7.3): a compaction lowers the
# last, and must not hide it.
contexts() {
    load
    local limit kind slot thread last peak flag
    limit=$(context_limit)
    while IFS=$'\t' read -r kind slot thread last peak; do
        flag=""
        [[ $kind != session ]] || ((peak <= limit)) || flag="  past $((limit / 1000))K: hand over"
        printf '%-14s %s  %dK, peak %dK%s\n' "$slot" "$thread" "$((last / 1000))" "$((peak / 1000))" "$flag"
    done < <(thread_contexts)
}

