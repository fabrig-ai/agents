        lab.case('HEAD-move' + phase, moves_head=True, extra=[phase, json.dumps([PYTHON, '-c',
            "import subprocess; subprocess.run(['git','commit','--allow-empty','-m','moved'],check=True)"])])
    for mode, expected in [('success', True), ('move-base', False), ('move-lock', False), ('reject', False)]:
        lab.case('land-' + mode, success=expected, extra=['--land'], land_mode=mode)
        assert git(lab.origin, lab.env, 'rev-parse', 'main') == (
            git(lab.primary, lab.env, 'rev-parse', 'case-' + str(lab.number)) if expected else lab.base)
    def original_hook(p, e):
        hooks = Path(git(p, e, 'rev-parse', '--path-format=absolute', '--git-path', 'hooks'))
        hooks.mkdir(exist_ok=True)
        (hooks / 'guard.config').write_text('existing hook helper\n')
        hook = hooks / 'pre-push'
        hook.write_text('#!' + PYTHON + '\nimport sys\nfrom pathlib import Path\n'
                        'Path(' + repr(str(evidence / 'original-hook-input')) + ').write_bytes(sys.stdin.buffer.read())\n')
        hook.chmod(0o700)
    lab.case('land-original-hook', setup=original_hook, success=True, extra=['--land'], land_mode='success')
    assert 'refs/heads/main' in (evidence / 'original-hook-input').read_text()
    hooks = Path(git(lab.primary, lab.env, 'rev-parse', '--path-format=absolute', '--git-path', 'hooks'))
    assert (hooks / 'guard.config').read_text() == 'existing hook helper\n'
    custom = lab.root / 'custom-hooks'
    def custom_hook(p, e):
        custom.mkdir()
        git(p, e, 'config', 'core.hooksPath', str(custom))
        original_hook(p, e)
    lab.case('land-custom-hooks', setup=custom_hook, success=True, extra=['--land'], land_mode='success')
    assert git(lab.primary, lab.env, 'config', 'core.hooksPath') == str(custom)
    def mutate_base(p, e, edit):
        lock = tomllib.loads((p / 'Cargo.lock').read_text())
        edit(lock)
        dump_lock(p / 'Cargo.lock', lock)
        lab.checkpoint(p, e)
    saved_base = lab.base
    def ambiguous(p, e):
        def edit(lock):
            record = next(p.copy() for p in lock['package'] if 'skein.git' in p.get('source', ''))
            identity, revision = record['source'].split('#')
            record['source'] = identity + '?branch=main#' + revision
            lock['package'].append(record)
        mutate_base(p, e, edit)
    lab.case('ambiguous-ref', setup=ambiguous, reason='absent or ambiguous source')
    lab.base = saved_base
    def manifest_rev(p, e):
        manifest = tomllib.loads((p / 'Cargo.toml').read_text())
        text = '[package]\n' + '\n'.join(k + '=' + json.dumps(v) for k, v in manifest['package'].items())
        text += '\n[dependencies]\n'
        for name, dependency in manifest['dependencies'].items():
            entries = dict(dependency)
            if name.startswith('skein-'):
                entries['rev'] = lab.old['skein']
            text += name + '={' + ','.join(k + '=' + json.dumps(v) for k, v in entries.items()) + '}\n'
        (p / 'Cargo.toml').write_text(text)
        execute(p, ['heavy', 'cargo', 'generate-lockfile'], e)
        lab.checkpoint(p, e)
    lab.case('manifest-rev', setup=manifest_rev, reason='manifest rev constraints')
    lab.base = saved_base
    lab.case('prefix-allowlist', extra=['--generated', 'out', 'out/file'])
    def hardlink(p, e):
        (p / 'generated.txt').unlink()
        os.link(p / 'other.txt', p / 'generated.txt')
    lab.case('hardlink', setup=hardlink, extra=['--generated', 'generated.txt'], reason='hardlink aliases')
    lab.base = saved_base
    lab.case('missing-check', checks=[], reason='--check')
    lab.case('malformed-command', extra=['--check', '"cargo check"'], reason='JSON argv arrays')
    lab.case('command-failure', extra=['--check', json.dumps([PYTHON, '-c', 'raise SystemExit(9)']), '--land'], reason='check failed')
    for phase in ('--regenerate', '--check'):
        lab.case('branch-move' + phase, extra=[phase, json.dumps([PYTHON, '-c',
            "import subprocess; subprocess.run(['git','checkout','-b','moved-" + phase[2:] + "'],check=True)"])], reason='branch or HEAD moved')
    lab.case('generated-symlink', extra=['--generated', 'generated.txt', '--regenerate', json.dumps(
        [PYTHON, '-c', "from pathlib import Path; p=Path('generated.txt'); p.unlink(); p.symlink_to('other.txt')"])], reason='symlink')
    lab.case('primary-refused', consumer=lab.primary, reason='linked worktree')
    for ref in ('refs/heads/main', 'refs/remotes/origin/main'):
        for phase in ('--regenerate', '--check'):
            lab.case(ref.replace('/', '-') + phase, extra=[phase, json.dumps([PYTHON, '-c',
                "import subprocess; subprocess.run(['git','update-ref'," + repr(ref) + ",'HEAD^'],check=True)"])], reason='base refs moved')
    def gitlink(p, e):
        (p / 'sub').mkdir()
        git(p, e, 'update-index', '--add', '--cacheinfo', '160000,' + lab.base + ',sub')
        git(p, e, 'commit', '-m', 'submodule base')
        lab.base = git(p, e, 'rev-parse', 'HEAD')
        git(p, e, 'update-ref', 'refs/heads/main', lab.base)
        git(p, e, 'update-ref', 'refs/remotes/origin/main', lab.base)
        git(p, e, 'push', 'origin', 'HEAD:refs/heads/submodule-base')
    lab.case('submodule', setup=gitlink, reason='submodules refused')
    lab.base = saved_base
    unusual = 'generated \n:(glob)*;$.txt'
    prepared, env = lab.case('literal-argv-path', success=True, extra=['--generated', unusual, '--regenerate', json.dumps(
        [PYTHON, '-c', 'from pathlib import Path; import sys; Path(sys.argv[1]).write_text(sys.argv[2])',
         unusual, 'literal ; $HOME $(false)'])])
    assert (prepared / unusual).read_text() == 'literal ; $HOME $(false)'
    def hidden_lock(p, e):
        git(p, e, 'update-index', '--assume-unchanged', 'Cargo.lock')
        with (p / 'Cargo.lock').open('a') as out:
            out.write('\n# hidden stale lock\n')
    lab.case('base-lock-bytes', setup=hidden_lock, reason='worktree lock differs from base bytes')
    for phase in ('--regenerate', '--check'):
        lab.case('lock-edit' + phase, extra=[phase, json.dumps([PYTHON, str(SCRIPT), '--mutate', 'wrong-sha'])])
    # Synthetic lock fixtures/stub Cargo preserve registry records for drift checks.
    cargo = lab.bin / 'cargo'
    cargo.unlink()
    cargo.write_text('#!' + PYTHON + '\nimport json, sys, tomllib\nfrom pathlib import Path\n'
        'import runpy\nsupport=runpy.run_path(' + repr(str(SCRIPT)) + ')\n'
        "lock=tomllib.loads(Path('Cargo.lock').read_text())\n"
        "args=sys.argv[1:]; identity=args[args.index('-p')+1].split('#')[0]\n"
        "for p in lock['package']:\n"
        "    if p.get('source','').split('#')[0] == identity:\n"
        "        p['source']=identity+'#'+args[args.index('--precise')+1]\n"
        "support['dump_lock'](Path('Cargo.lock'),lock)\n")
    cargo.chmod(0o700)
    for fault in (None, 'checksum', 'registry'):
        def registry_setup(p, e):
            mutate_base(p, e, lambda lock: lock['package'].append(sentinel))
        lab.case('registry-' + str(fault), setup=registry_setup, fault=fault,
                 pins=[('skein', lab.new['skein'])], success=fault is None,
                 reason='unrelated package records changed' if fault else 'prepared')
        lab.base = saved_base
    print('completed ' + str(lab.number) + ' cases', flush=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--evidence', type=Path, required=True)
    args = parser.parse_args()
    args.evidence.mkdir(mode=0o700)
    with tempfile.TemporaryDirectory(prefix='repin-fixture-', dir=args.evidence) as directory:
        fixtures(Path(directory), args.evidence.resolve())


if __name__ == '__main__':
    if len(sys.argv) == 3 and sys.argv[1] == '--mutate':
        mutate(sys.argv[2])
    else:
        main()
