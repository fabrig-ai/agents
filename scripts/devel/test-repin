class Lab:
    def __init__(self, root, evidence):
        self.root, self.evidence, self.number = root, evidence, 0
        self.bin = root / 'bin'
        self.bin.mkdir()
        self.env = dict(os.environ, PATH=str(self.bin) + ':/usr/bin:/bin',
                        CARGO_HOME=str(root / 'cargo'), GIT_CONFIG_GLOBAL='/dev/null',
                        GIT_CONFIG_NOSYSTEM='1', GIT_AUTHOR_NAME='Fixture',
                        GIT_AUTHOR_EMAIL='fixture@invalid', GIT_COMMITTER_NAME='Fixture',
                        GIT_COMMITTER_EMAIL='fixture@invalid', CARGO_NET_OFFLINE='false')
        self.env.pop('RUSTC_WRAPPER', None)
        self.env.pop('RUSTC_WORKSPACE_WRAPPER', None)
        for name in ('cargo', 'rustc'):
            (self.bin / name).symlink_to(shutil.which(name))
        cargo = self.bin / 'cargo'
        cargo.unlink()
        cargo.write_text('#!' + PYTHON + '\nimport os, sys\n'
            "assert os.environ.get('FIXTURE_INSIDE_HEAVY') == '1', 'raw cargo bypassed heavy'\n"
            "assert sys.argv[1] in ('generate-lockfile','update'), 'fixture cannot compile'\n"
            'os.execv(' + repr(shutil.which('cargo')) + ', sys.argv)\n')
        cargo.chmod(0o700)
        for name, body in [('heavy', HEAVY), ('land', LAND)]:
            path = self.bin / name
            path.write_text(body.format(python=PYTHON, script=str(SCRIPT)))
            path.chmod(0o700)
        self.old, self.new, self.urls = {}, {}, {}
        for name, crates in [('skein', ['skein-a', 'skein-b']), ('smith', ['smith-a'])]:
            repo = root / (name + '-source')
            repo.mkdir()
            git(repo, self.env, 'init', '-b', 'main')
            (repo / 'Cargo.toml').write_text('[workspace]\nresolver="2"\nmembers=' + json.dumps(crates))
            for crate in crates:
                directory = repo / crate
                (directory / 'src').mkdir(parents=True)
                (directory / 'Cargo.toml').write_text('[package]\nname=' + json.dumps(crate) + '\nversion="0.1.0"\nedition="2021"\n')
                (directory / 'src/lib.rs').write_text('pub fn value() -> u8 { 1 }\n')
            git(repo, self.env, 'add', '.')
            git(repo, self.env, 'commit', '-m', 'first')
            self.old[name] = git(repo, self.env, 'rev-parse', 'HEAD')
            (repo / crates[0] / 'src/lib.rs').write_text('pub fn value() -> u8 { 2 }\n')
            git(repo, self.env, 'commit', '-am', 'second')
            self.new[name] = git(repo, self.env, 'rev-parse', 'HEAD')
            bare = root / (name + '.git')
            execute(root, ['git', 'clone', '--bare', str(repo), str(bare)], self.env)
            git(bare, self.env, 'update-ref', 'refs/heads/next', self.new[name])
            # Start consumers at the first commit; precise updates fetch the second object.
            git(bare, self.env, 'update-ref', 'refs/heads/main', self.old[name])
            self.urls[name] = bare.as_uri()
        # A third source whose newer commit names a skein crate without a rev: updating it alone
        # moves skein's packages toward skein's branch, which then runs ahead of the pinned commit.
        skein = root / 'skein-source'
        (skein / 'skein-c/src').mkdir(parents=True)
        (skein / 'skein-c/Cargo.toml').write_text('[package]\nname="skein-c"\nversion="0.1.0"\nedition="2021"\n'
                                                  '[dependencies]\nskein-a={path="../skein-a"}\n')
        (skein / 'skein-c/src/lib.rs').write_text('pub fn value() -> u8 { 3 }\n')
        (skein / 'Cargo.toml').write_text('[workspace]\nresolver="2"\nmembers=["skein-a","skein-b","skein-c"]')
        git(skein, self.env, 'add', '.')
        git(skein, self.env, 'commit', '-m', 'third crate')
        self.with_c = git(skein, self.env, 'rev-parse', 'HEAD')
        (skein / 'skein-a/src/lib.rs').write_text('pub fn value() -> u8 { 4 }\n')
        git(skein, self.env, 'commit', '-am', 'ahead')
        self.ahead = git(skein, self.env, 'rev-parse', 'HEAD')
        git(skein, self.env, 'push', self.urls['skein'], self.with_c + ':refs/heads/with-c', self.ahead + ':refs/heads/ahead')
        jig = root / 'jig-source'
        (jig / 'jig-a/src').mkdir(parents=True)
        git(jig, self.env, 'init', '-b', 'main')
        (jig / 'Cargo.toml').write_text('[workspace]\nresolver="2"\nmembers=["jig-a"]')
        package = '[package]\nname="jig-a"\nversion="0.1.0"\nedition="2021"\n'
        (jig / 'jig-a/Cargo.toml').write_text(package)
        (jig / 'jig-a/src/lib.rs').write_text('')
        git(jig, self.env, 'add', '.')
        git(jig, self.env, 'commit', '-m', 'first')
        self.old['jig'] = git(jig, self.env, 'rev-parse', 'HEAD')
        (jig / 'jig-a/Cargo.toml').write_text(package + '[dependencies]\nskein-c={git=' + json.dumps(self.urls['skein']) + '}\n')
        git(jig, self.env, 'commit', '-am', 'second')
        self.new['jig'] = git(jig, self.env, 'rev-parse', 'HEAD')
        bare = root / 'jig.git'
        execute(root, ['git', 'clone', '--bare', str(jig), str(bare)], self.env)
        git(bare, self.env, 'update-ref', 'refs/heads/next', self.new['jig'])
        git(bare, self.env, 'update-ref', 'refs/heads/main', self.old['jig'])
        self.urls['jig'] = bare.as_uri()
        primary = self.primary = root / 'consumer'
        primary.mkdir()
        git(primary, self.env, 'init', '-b', 'main')
        (primary / 'src').mkdir()
        (primary / 'src/lib.rs').write_text('')
        manifest = '[package]\nname="consumer"\nversion="0.1.0"\nedition="2021"\n[dependencies]\n'
        for name, crates in [('skein', ['skein-a', 'skein-b']), ('smith', ['smith-a'])]:
            manifest += ''.join(crate + '={git=' + json.dumps(self.urls[name]) + '}\n' for crate in crates)
        manifest += 'jig-a={git=' + json.dumps(self.urls['jig']) + '}\n'
        (primary / 'Cargo.toml').write_text(manifest)
        (primary / 'generated.txt').write_text('base\n')
        (primary / 'other.txt').write_text('base\n')
        trace = evidence / 'initial-heavy.jsonl'
        self.env.update(FIXTURE_TRACE=str(trace), FIXTURE_LAND=str(evidence / 'unused-land.json'))
        execute(primary, ['heavy', 'cargo', 'generate-lockfile'], self.env)
        # Synthetic registry record tests semantic preservation without network access.
        lock = tomllib.loads((primary / 'Cargo.lock').read_text())
        lock['package'].append(dict(name='registry-sentinel', version='1.2.3',
            source='registry+https://github.com/rust-lang/crates.io-index', checksum='a' * 64))
        dump_lock(primary / 'Cargo.lock', lock)
        git(primary, self.env, 'add', '.')
        git(primary, self.env, 'commit', '-m', 'consumer base')
        self.base = git(primary, self.env, 'rev-parse', 'HEAD')
        origin = root / 'consumer.git'
        execute(root, ['git', 'init', '--bare', str(origin)], self.env)
        git(primary, self.env, 'remote', 'add', 'origin', str(origin))
        git(primary, self.env, 'push', '-u', 'origin', 'main')
        git(primary, self.env, 'checkout', '--detach')
        self.origin = origin

    def case(self, label, *, setup=None, extra=(), pins=None, fault=None, success=False,
             land_mode=None, base=None, moves_head=False, reason=None, checks=None, consumer=None):
        self.number += 1
        root = self.root / ('work-' + str(self.number))
        env = dict(self.env, FIXTURE_TRACE=str(self.evidence / (label + '.heavy.jsonl')),
                   FIXTURE_LAND=str(self.evidence / (label + '.land.json')))
        if fault:
            env['FIXTURE_FAULT'] = fault
        if land_mode:
            env['FIXTURE_LAND_MODE'] = land_mode
            env['LAND_PREBUILD'] = 'must be removed'
        git(self.primary, env, 'worktree', 'add', '-b', 'case-' + str(self.number), str(root), self.base)
        git(self.primary, env, 'update-ref', 'refs/heads/main', self.base)
        git(self.primary, env, 'update-ref', 'refs/remotes/origin/main', self.base)
        git(self.origin, env, 'update-ref', 'refs/heads/main', self.base)
        if setup:
            setup(root, env)
        before = git(root, env, 'rev-parse', 'HEAD')
        argv = [str(REPIN), '--consumer', str(consumer or root), '--base', base or self.base]
        for name, revision in pins or [('skein', self.new['skein'])]:
            argv += ['--pin', name + '=' + revision]
        for check in checks if checks is not None else [[PYTHON, '-c', 'pass']]:
            argv += ['--check', json.dumps(check)]
        argv += extra
        result = execute(root, argv, env, check=False)
        (self.evidence / (label + '.log')).write_text(result.stdout)
        assert (result.returncode == 0) == success, label + '\n' + result.stdout
        assert reason is None or reason in result.stdout, label + '\n' + result.stdout
        after = git(root, env, 'rev-parse', 'HEAD')
        if success:
            assert git(root, env, 'show', '-s', '--format=%P', after) == self.base
            lock = tomllib.loads((root / 'Cargo.lock').read_text())
            for name, revision in pins or [('skein', self.new['skein'])]:
                assert all(p['source'].endswith('#' + revision) for p in lock['package']
                           if '/' + name + '.git#' in p.get('source', ''))
        elif land_mode is None and not moves_head:
            assert before == after, label + ': committed on failure'
        if not success and land_mode is None:
            assert not Path(env['FIXTURE_LAND']).exists(), label + ': landed on failure'
        hook_record = Path(env['FIXTURE_LAND'] + '.hooks')
        if hook_record.exists():
            assert not Path(hook_record.read_text()).exists(), 'temporary hooks leaked'
        if Path(env['FIXTURE_TRACE']).exists():
            for line in Path(env['FIXTURE_TRACE']).read_text().splitlines():
                args = json.loads(line)
                assert args[0] in ('cargo', PYTHON)
                if args[0] == 'cargo':
                    assert args == ['cargo', 'generate-lockfile'] or (
                        args[:2] == ['cargo', 'update'] and '--precise' in args and '-p' in args)
        print('PASS ' + label, flush=True)
        return root, env

    def checkpoint(self, root, env):
        git(root, env, 'add', '.')
        git(root, env, 'commit', '-m', 'synthetic base')
        self.base = git(root, env, 'rev-parse', 'HEAD')
        git(root, env, 'update-ref', 'refs/heads/main', self.base)
        git(root, env, 'update-ref', 'refs/remotes/origin/main', self.base)
        git(root, env, 'push', 'origin', 'HEAD:refs/heads/baseline-' + str(self.number))


def fixtures(root, evidence):
