    # Registry sentinel would be pruned by real Cargo: retain it only in stub fault tests.
    sentinel = next(p for p in tomllib.loads((lab.primary / 'Cargo.lock').read_text())['package']
                    if p['name'] == 'registry-sentinel')
    lock = tomllib.loads((lab.primary / 'Cargo.lock').read_text())
    lock['package'] = [p for p in lock['package'] if p['name'] != sentinel['name']]
    dump_lock(lab.primary / 'Cargo.lock', lock)
    git(lab.primary, lab.env, 'add', 'Cargo.lock')
    git(lab.primary, lab.env, 'commit', '-m', 'real Cargo baseline')
    lab.base = git(lab.primary, lab.env, 'rev-parse', 'HEAD')
    git(lab.primary, lab.env, 'push', 'origin', 'HEAD:refs/heads/fixture-baseline')
    focused = ("from pathlib import Path; import tomllib; "
        "assert Path('generated.txt').read_text() == " + repr('generated\n') + "; "
        "packages=tomllib.loads(Path('Cargo.lock').read_text())['package']; "
        "assert {p['source'].split('#')[-1] for p in packages if p['name'].startswith('skein-')} == {"
        + repr(lab.new['skein']) + "}")
    prepared, env = lab.case('real-prepare', success=True, checks=[[PYTHON, '-c', focused]], extra=['--generated', 'generated.txt', '--regenerate',
        json.dumps([PYTHON, '-c', "from pathlib import Path; Path('generated.txt').write_text('generated\\n')"] )])
    assert git(prepared, env, 'show', 'HEAD:generated.txt') == 'generated'
    assert set(git(prepared, env, 'diff-tree', '--no-commit-id', '--name-only', '-r', 'HEAD').splitlines()) == {'Cargo.lock', 'generated.txt'}
    packages = tomllib.loads((prepared / 'Cargo.lock').read_text())['package']
    assert {p['name'] for p in packages if 'skein.git' in p.get('source', '')} == {'skein-a', 'skein-b'}
    assert next(p['source'] for p in packages if p['name'] == 'smith-a').endswith('#' + lab.old['smith'])
    assert len(Path(env['FIXTURE_TRACE']).read_text().splitlines()) == 3
    stale, stale_env = lab.case('stale-local-main', success=True, setup=lambda p, e:
        git(p, e, 'update-ref', 'refs/heads/main', lab.base + '^'))
    assert git(stale, stale_env, 'rev-parse', 'main') == git(stale, stale_env, 'rev-parse', lab.base + '^')
    lab.case('multiple-sources', success=True, pins=[('skein', lab.new['skein']), ('smith', lab.new['smith'])])
    skein_main = lab.root / 'skein.git'
    def ahead(p, e):
        git(skein_main, e, 'update-ref', 'refs/heads/main', lab.ahead)
    drifted, drifted_env = lab.case('dependency-runs-ahead', success=True, setup=ahead,
                                    pins=[('jig', lab.new['jig']), ('skein', lab.with_c)])
    packages = tomllib.loads((drifted / 'Cargo.lock').read_text())['package']
    assert {p['name'] for p in packages if 'skein.git' in p.get('source', '')} == {'skein-a', 'skein-b', 'skein-c'}
    lab.case('dependency-runs-ahead-last', setup=ahead, pins=[('skein', lab.with_c), ('jig', lab.new['jig'])],
             reason='multiple revisions')
    git(skein_main, lab.env, 'update-ref', 'refs/heads/main', lab.old['skein'])
    for label, pins in [('abbrev', [('skein', 'a' * 12)]), ('malformed', [('skein', 'z' * 40)]),
                        ('duplicate', [('skein', lab.new['skein'])] * 2),
                        ('absent', [('missing', 'a' * 40)]), ('no-change', [('skein', lab.old['skein'])]),
                        ('sha64-missing-object', [('skein', 'a' * 64)])]:
        lab.case(label, pins=pins)
    lab.case('wrong-base', base=lab.old['skein'])
    for label, setup in [
        ('dirty', lambda p, e: (p / 'other.txt').write_text('dirty')),
        ('staged', lambda p, e: ((p / 'other.txt').write_text('dirty'), git(p, e, 'add', 'other.txt'))),
        ('untracked', lambda p, e: (p / 'new.txt').write_text('new')),
        ('merge', lambda p, e: Path(git(p, e, 'rev-parse', '--git-path', 'MERGE_HEAD')).write_text(lab.base)),
        ('rebase', lambda p, e: Path(git(p, e, 'rev-parse', '--git-path', 'rebase-merge')).mkdir()),
        ('main', lambda p, e: git(p, e, 'checkout', 'main')),
        ('divergent', lambda p, e: git(p, e, 'commit', '--allow-empty', '-m', 'diverged')),
    ]:
        lab.case(label, setup=setup)
    for label, path in [('traversal', '../escape'), ('absolute', '/tmp/repin-escape'),
                        ('git-path', '.git/config'), ('manifest', 'Cargo.toml'),
                        ('nested-manifest', 'sub/Cargo.toml'), ('lock-alias', 'sub/Cargo.lock'),
                        ('directory', 'src')]:
        lab.case(label, extra=['--generated', path])
    saved_base = lab.base
