            lab.case(label + phase, extra=[phase, json.dumps([PYTHON, '-c',
                     'from pathlib import Path; import subprocess; ' + body])])
    for fault in ('other-git', 'wrong-sha', 'new-package', 'metadata'):
        lab.case('resolver-' + fault, fault=fault)
