        (p / 'generated.txt').symlink_to('other.txt')
        lab.checkpoint(p, e)
    lab.case('symlink', setup=symlink, extra=['--generated', 'generated.txt'], reason='symlink')
    lab.base = saved_base
    for label, body in [('unrelated-write', "Path('other.txt').write_text('bad')"),
                        ('untracked-write', "Path('surprise').write_text('bad')"),
                        ('staged-write', "Path('other.txt').write_text('bad'); subprocess.run(['git','add','other.txt'],check=True)"),
                        ('deleted-write', "Path('other.txt').unlink()"),
                        ('check-failure', 'raise SystemExit(7)')]:
