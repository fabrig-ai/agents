import tomllib

os.umask(0o077)
SCRIPT = Path(__file__).resolve()
REPIN = SCRIPT.with_name('repin')
PYTHON = sys.executable


def execute(root, argv, env, check=True):
    result = subprocess.run(argv, cwd=root, env=env, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if check and result.returncode:
        raise AssertionError(str(argv) + '\n' + result.stdout)
    return result


def git(root, env, *args):
    return execute(root, ['git', *args], env).stdout.strip()


def dump_lock(path, lock):
    lines = ['version = ' + str(lock['version'])]
    for record in lock['package']:
        lines.append('\n[[package]]')
        lines.extend(key + ' = ' + json.dumps(value) for key, value in record.items())
    path.write_text('\n'.join(lines) + '\n')


def mutate(kind):
    path = Path('Cargo.lock')
    lock = tomllib.loads(path.read_text())
    packages = lock['package']
    actions = {
        'checksum': lambda: next(p for p in packages if p.get('checksum')).update(checksum='e' * 64),
        'registry': lambda: next(p for p in packages if p.get('checksum')).update(version='9.0.0'),
        'other-git': lambda: next(p for p in packages if 'smith.git' in p.get('source', '')).update(
            source=next(p['source'] for p in packages if 'smith.git' in p.get('source', '')).split('#')[0] + '#' + 'e' * 40),
        'wrong-sha': lambda: next(p for p in packages if 'skein.git' in p.get('source', '')).update(
            source=next(p['source'] for p in packages if 'skein.git' in p.get('source', '')).split('#')[0] + '#' + 'e' * 40),
        'new-package': lambda: packages.append(dict(name='intruder', version='1.0.0')),
        'metadata': lambda: lock.update(version=3),
    }
    actions[kind]()
    dump_lock(path, lock)


