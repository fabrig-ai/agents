#!/usr/bin/env bash
# Queue builds and exclusive gates (build-infrastructure.md, 2-5).
# shellcheck source-path=SCRIPTDIR
set -euo pipefail
umask 077
kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# The workspace: DEV_ROOT, or the directory holding the agents checkout these
# tools come from, or ~/src/rust.
workspace() {
    local agents
    agents=$(cd "$kit/../.." && pwd)
    if [[ $(basename "$agents") == agents ]]; then dirname "$agents"; else echo "$HOME/src/rust"; fi
}
root=${DEV_ROOT:-$(workspace)}
tmp=${DEV_TMP:-$root/tmp}
# shellcheck source=kit.sh
source "$kit/kit.sh"
# Every task builds as wide as the machine, and builds take no slot but the
# machine's setting (0, the default: no limit). CPU weights, not a queue, order
# them (build-infrastructure.md, 2).
read -r build_jobs _ < <(machine_setting HEAVY_BUILD_JOBS "$(nproc)")
read -r build_slots _ < <(machine_setting HEAVY_BUILD_SLOTS 0)
export DEV_ROOT=$root DEV_TMP=$tmp HEAVY_BUILD_JOBS_EFFECTIVE=$build_jobs HEAVY_BUILD_SLOTS_EFFECTIVE=$build_slots
prepare_gate_policy() {
    local token=${1:-} expected=${SKEIN_GATE_POLICY_ID:-}
    if [[ -f $kit/gate-policy.sh ]]; then
        # shellcheck source=/dev/null
        source "$kit/gate-policy.sh"
        gate_policy_prepare || {
            HEAVY_LANE=gate python3 -B "$kit/heavy-recovery.py" --record-refusal policy "$token" || true
            return 2
        }
        if [[ -n $expected && $expected != "$SKEIN_GATE_POLICY_ID" ]]; then
            echo 'heavy: supplied gate policy differs from the validated policy' >&2
            HEAVY_LANE=gate python3 -B "$kit/heavy-recovery.py" --record-refusal policy "$token" || true
            return 2
        fi
    else
        echo 'heavy: gate policy helper is unavailable' >&2
        HEAVY_LANE=gate python3 -B "$kit/heavy-recovery.py" --record-refusal policy "$token" || true
        return 2
    fi
}
case ${1:-} in
    # The Python payload guard must precede every policy executable. These
    # skip the disk floor: --cancel above all must work below it.
    --payload|--task|--reconcile|--install-reconciler|--remove-reconciler|--maintenance-pause|--maintenance-resume|--installed|--check-recovery|--group-held|--record-refusal|--cancel) ;;
    *)
        pending_tail=0 gate_policy=0 valid_command=1 command=()
        for argument in "$@"; do
            if ((pending_tail)); then pending_tail=0; continue; fi
            if ((${#command[@]})); then command+=("$argument"); continue; fi
            case $argument in
                --gate | --land) gate_policy=1 ;;
                --tail) pending_tail=1 ;;
                --) command=(--) ;;
                -*) valid_command=0 ;;
                *) command=("$argument") ;;
            esac
        done
        [[ ${command[0]:-} != -- ]] || command=("${command[@]:1}")
        if ((${#command[@]} && valid_command && !pending_tail)); then
            installed_status=0
            python3 -B "$kit/heavy-recovery.py" --installed >/dev/null 2>&1 || installed_status=$?
        else
            exec python3 -B "$kit/heavy-recovery.py" "$@"
        fi
        if ((installed_status != 1)); then
            # Landing labels must agree with heavy-recovery.py's landing:
            # these tasks queue below the floor and wait for admission.
            if [[ ! ${HEAVY_LABEL:-} =~ ^land\ [^[:space:]]+(\ (prebuild|regenerate))?$ ]]; then
                disk_floor heavy || {
                    python3 -B "$kit/heavy-recovery.py" --record-refusal disk-floor || true
                    exit 2
                }
            fi
            # Preparation at submission preserves the policy helper selection in
            # the queue; contained entry validates it again before payload start.
            if ((gate_policy)); then prepare_gate_policy ""; fi
        fi
        # cargo fmt builds nothing: it runs at once, outside the queue.
        if [[ ${command[0]:-} == cargo && ${command[1]:-} == fmt ]]; then
            echo 'heavy: cargo fmt builds nothing; running it directly' >&2
            exec "${command[@]}"
        fi
        if ((installed_status == 1)); then
            echo 'heavy: not installed here; running it directly' >&2
            exec "${command[@]}"
        fi
        ;;
esac
exec python3 -B "$kit/heavy-recovery.py" "$@"
