printf 'alpha-01.1\talpha\t01\tready\t\t\t\t\tfirst\t\n' >>"$run/ledger.tsv"
"$plan" set alpha-01.1 state=landed thread=t-impl-1
"$plan" set alpha-01.2 repo=alpha session=01 state=landed title=second
"$plan" set alpha-01.s1 repo=alpha session=01 state=landed note="supplement: 2026-10-11T11:00:00Z"
"$plan" set alpha-01.3 repo=alpha session=01 state=running slot=w1 branch=b3
expect "ledger header" "$(head -n1 "$run/ledger.tsv")" $'slot\tthread\tbranch'
expect "ledger thread" "$(grep alpha-01.1 "$run/ledger.tsv")" $'\tt-impl-1\t'
