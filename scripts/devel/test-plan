run=$("$plan" claim "$dir")
expect claim "$run" "$DEV_TMP/alpha/demo"
expect "the claim's kit" "$(git -C "$run/kit" rev-parse HEAD)" "$(git -C "$DEV_ROOT/skein" rev-parse HEAD)"
expect "the kit hands over" "$(PLAN_TEST_KIT=1 "$plan" status 2>&1 >/dev/null)" "the run's kit"
expect "the kit's own runs" "$(PLAN_TEST_KIT=1 timeout 10 "$run/kit/scripts/dev/plan" status 2>&1 >/dev/null)" "the run's kit"
mkdir -p "$t/bin" && ln -s "$plan" "$t/bin/plan"
expect "the kit hands over from a link" "$(PLAN_TEST_KIT=1 "$t/bin/plan" status 2>&1 >/dev/null)" "the run's kit"
# A run claimed without kit/ runs the copy it is run from.
mv "$run/kit" "$run/kit.aside"
[[ -z $(PLAN_TEST_KIT=1 "$plan" status 2>&1 >/dev/null) ]] || { echo "FAIL a run without kit/ ran another copy"; failed=1; }
mv "$run/kit.aside" "$run/kit"
