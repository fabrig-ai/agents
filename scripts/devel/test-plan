#!/usr/bin/env bash
# Tests plan on a workspace of its own, in a temporary directory.
#
#   test-plan          the commands that need no agent: the ledger, status,
#                      watch, pulse, metrics, reports, rulings, the decisions
#                      check, attach, wake and handover (printed); about 40 s
#   test-plan --live   also start, ring, resume, wake and retro, with cheap
#                      models and prompts that end at once; it spends a few
#                      cents of each program's usage, and takes a few minutes
#
# It prints each failed expectation, and exits 1 if there was one.
set -Eeuo pipefail
trap 'echo "test-plan: failed at line $LINENO" >&2' ERR
kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
live=0
[[ ${1:-} == --live ]] && live=1

workspace=${DEV_ROOT:-$(dirname "$(dirname "$(git -C "$kit" rev-parse --path-format=absolute --git-common-dir)")")}
t=$(mktemp -d "$workspace/tmp/test-plan.XXXXXX")
if [[ ${PLAN_TEST_KEEP:-} == 1 ]]; then echo "test-plan: keeping $t"; else trap 'rm -rf "$t"' EXIT; fi
export DEV_ROOT=$t/src DEV_TMP=$t/src/tmp DEV_REPOS=alpha
export CODEX_HOME=$t/codex CLAUDE_CONFIG_DIR=$t/claude PLAN_NO_ROLES=1 PLAN_POLL=0.1
plan=$kit/plan
failed=0

expect() {
    local what=$1 output=$2 want
    shift 2
    for want in "$@"; do
        if ! grep -qF -- "$want" <<<"$output"; then
            echo "FAIL $what: no \"$want\" in:"
            printf '    %s\n' "${output//$'\n'/$'\n'    }"
            failed=1
        fi
    done
}

# A repository with a plan.
repo=$DEV_ROOT/alpha
dir=$repo/docs/development/plans/demo
mkdir -p "$dir/alpha" "$repo/src" "$repo/tests"
git -C "$repo" init -q -b main
git -C "$repo" config user.email test@example.com
git -C "$repo" config user.name test
cat >"$dir/README.md" <<'EOF'
# Demo

## Pulse

```
words: actual|exact
types: ^Owner[A-Z]
file-lines: 50
budgets: 15 60
```
EOF
echo "# Code organization" >"$dir/code-organization.md"
cat >"$dir/alpha/01-first.md" <<'EOF'
# Session 01: first

### 1.1 The first increment
Proof: world, the story `first`, in the suite.

### 01.2 The second increment
Proof: joint, the joint story `second`.
EOF
cat >"$dir/alpha/02-second.md" <<'EOF'
# Session 02: second

### 02.1 The third increment
Proof: unit; the unit tests.
EOF
cat >"$dir/decisions.md" <<'EOF'
# Decisions

## The plan's own

1. **One decision.** Its reason.

## For the user

Nothing.
EOF
planner=99999999-8888-7777-6666-555555555555
git -C "$repo" add -A
git -C "$repo" commit -q -m "Plan the demo" -m "Planner-Session: $planner"

# The workspace's skein, whose commit a claim takes as the run's kit
# (development.md, section 3.6): this kit as it stands, its plan marked so
# that a test sees which copy ran.
mkdir -p "$DEV_ROOT/skein/scripts"
cp -r "$kit" "$DEV_ROOT/skein/scripts/dev"
sed -i '2i [[ -z ${PLAN_TEST_KIT:-} ]] || echo "the run'\''s kit" >&2' "$DEV_ROOT/skein/scripts/dev/plan"
git -C "$DEV_ROOT/skein" init -q -b main
git -C "$DEV_ROOT/skein" add -A
git -C "$DEV_ROOT/skein" -c user.email=test@example.com -c user.name=test commit -q -m "The kit"

run=$("$plan" claim "$dir")
expect claim "$run" "$DEV_TMP/alpha/demo"
expect "the claim's kit" "$(git -C "$run/kit" rev-parse HEAD)" "$(git -C "$DEV_ROOT/skein" rev-parse HEAD)"
expect "the kit hands over" "$(PLAN_TEST_KIT=1 "$plan" status 2>&1 >/dev/null)" "the run's kit"
expect "the kit's own runs" "$(PLAN_TEST_KIT=1 timeout 10 "$run/kit/scripts/dev/plan" status 2>&1 >/dev/null)" "the run's kit"
mkdir -p "$t/bin" && ln -s "$plan" "$t/bin/plan"
expect "the kit hands over from a link" "$(PLAN_TEST_KIT=1 "$t/bin/plan" status 2>&1 >/dev/null)" "the run's kit"
# A run claimed without kit/ runs the copy it is run from.
mv "$run/kit" "$run/kit.aside"
[[ -z $(PLAN_TEST_KIT=1 "$plan" status 2>&1 >/dev/null) ]] || { echo "FAIL a run without kit/ ran another copy"; failed=1; }
mv "$run/kit.aside" "$run/kit"
# The pulse counts what happened after a check's second: the fixture's
# commits and queue statistics come a second after the claim.
sleep 1

# The ledger, with a ledger of the older shape upgraded on the way.
printf 'step\trepo\tsession\tstate\tslot\tbranch\tcommit\tupdated\ttitle\tnote\n' >"$run/ledger.tsv"
printf 'alpha-01.1\talpha\t01\tready\t\t\t\t\tfirst\t\n' >>"$run/ledger.tsv"
"$plan" set alpha-01.1 state=landed thread=t-impl-1
"$plan" set alpha-01.2 repo=alpha session=01 state=landed title=second
"$plan" set alpha-01.s1 repo=alpha session=01 state=landed note="supplement: 2026-10-11T11:00:00Z"
"$plan" set alpha-01.3 repo=alpha session=01 state=running slot=w1 branch=b3
expect "ledger header" "$(head -n1 "$run/ledger.tsv")" $'slot\tthread\tbranch'
expect "ledger thread" "$(grep alpha-01.1 "$run/ledger.tsv")" $'\tt-impl-1\t'
expect status "$("$plan" status)" "3 of 4 steps landed; 1 running" "| alpha-01.3 | w1 | b3 |"

# Commits with trailers, after the claim.
commit() {
    local step=$1 proof=$2 gate=$3 message
    git -C "$repo" add -A
    message="Step $step"$'\n\n'"Body."$'\n\n'
    [[ -z $proof ]] || message+="Proof: $proof"$'\n'
    message+="Plan: demo"$'\n'"Step: $step"$'\n'"Gate-Result: $gate"
    git -C "$repo" commit -q -m "$message"
}
seq 1 60 | sed 's/^/\/\/ line /' >"$repo/src/big.rs"
echo "pub struct OwnerThing; // the actual one" >>"$repo/src/big.rs"
for i in 1 2 3 4; do echo "fn text() {}" >"$repo/tests/t$i.rs"; done
commit alpha-01.1 "world; the story first, passed" "scripts/check.sh passed: 10 tests / 1.0 s; 2 tests / 50.0 s; 60 s in all"
echo "fn text() {} // exact" >"$repo/tests/t5.rs"
echo "#[expect(clippy::too_many_lines)]" >>"$repo/src/big.rs"
commit alpha-01.2 "unit, the unit tests, passed" "scripts/check.sh passed: 12 tests / 1.1 s; 2 tests / 20.0 s; 30 s in all"
echo "fn more() {}" >"$repo/src/more.rs"
commit alpha-01.s1 "" "scripts/check.sh passed: 13 tests / 1.1 s; 2 tests / 20.0 s; 30 s in all"

# The run's log, the queue's statistics and gate logs.
{
    printf '## alpha 01, 2026-10-11T10:05:00Z\n\nline\nline\nline\n\n'
    printf '## Blocked and unblocked, 2026-10-11T10:30:00Z\n\n# Blocked\n\n## alpha 01.2: a gap, 2026-10-11T10:00:00Z\n\n'
    printf -- '- Kind: design gap\n- Since: 2026-10-11T10:00:00Z. Still running: none.\n\n# Unblock\n\nReverses: nothing\n\n'
    # The gap stays open, listed again beside a second escalation: each counts once.
    printf '## Blocked and unblocked, 2026-10-11T12:00:00Z\n\n# Blocked\n\n## alpha 01.2: a gap, 2026-10-11T10:00:00Z\n\n'
    printf -- '- Kind: design gap\n- Since: 2026-10-11T10:00:00Z. Still running: none.\n\n'
    printf '## alpha 01.4: another, 2026-10-11T11:00:00Z\n\n- Kind: plan defect\n- Since: 2026-10-11T11:00:00Z. Still running: none.\n\nReverses: 2026-10-11T10:30:00Z\n\n'
    printf '## Steered, 2026-10-11T11:30:00Z\n\nSteer 2026-10-11T11:30:00Z, point 1: cannot, no room.\n\n'
    printf '## Coordinator resumed, 2026-10-11T12:00:00Z: reboot\n\n'
    printf '## alpha 01, 2026-10-11T12:05:00Z\n\nline\n\n'
} >>"$run/log.md"
mkdir -p "$run/logs/alpha-01"
printf 'SLOW [ 1.2s] a\nSLOW [ 2.0s] b\n' >"$run/logs/gate-1.log"
stamp=$(date -u +%FT%TZ)
printf '1\tgate\t%s\t10\t100\t0\t5.0\t/x\t%s\tcheck\tland alpha\n2\tbuild\t%s\t5\t20\t0\t5.0\t/x\t/dev/null\tcargo\tland alpha prebuild\n3\tgate\t%s\t5\t80\t0\t5.0\t/x\t/dev/null\tcheck\tmeasure\n' \
    "$stamp" "$run/logs/gate-1.log" "$stamp" "$stamp" >"$run/logs/heavy.tsv"
echo "#!/bin/sh" >"$run/logs/alpha-01/proof.sh"

# The agents' traces: the coordinator, one session under it, one Claude
# Code session with a sub-agent.
coordinator="t-coord-1"
printf '%s\n' "$coordinator" >"$run/thread"
mkdir -p "$CODEX_HOME/sessions/2026/10/11"
base=$(date -u -d '-3 hours' +%s)
{
    printf '{"timestamp":"%s","type":"session_meta","payload":{"id":"%s"}}\n' "$(date -u -d "@$base" +%FT%TZ)" "$coordinator"
    for offset in 600 1200 1800 5400; do
        printf '{"timestamp":"%s","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":%d,"output_tokens":%d}}}}\n' \
            "$(date -u -d "@$((base + offset))" +%FT%TZ)" "$((offset * 10))" "$offset"
    done
    printf '{"timestamp":"%s","type":"response_item","payload":{"type":"function_call_output","output":"{\\"message\\":\\"Wait timed out.\\",\\"timed_out\\":true}"}}\n' "$(date -u -d "@$((base + 5400))" +%FT%TZ)"
    printf '{"timestamp":"%s","type":"compacted","payload":{"message":""}}\n' "$(date -u -d "@$((base + 5400))" +%FT%TZ)"
} >"$CODEX_HOME/sessions/2026/10/11/rollout-x-$coordinator.jsonl"
{
    printf '{"timestamp":"%s","type":"session_meta","payload":{"id":"t-impl-1","source":{"subagent":{"thread_spawn":{"parent_thread_id":"%s"}}}}}\n' "$(date -u -d "@$base" +%FT%TZ)" "$coordinator"
    printf '{"timestamp":"%s","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":700,"output_tokens":70},"last_token_usage":{"input_tokens":260000}}}}\n' "$(date -u -d "@$base" +%FT%TZ)"
    printf '{"timestamp":"%s","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":700,"output_tokens":70},"last_token_usage":{"input_tokens":250000}}}}\n' "$(date -u -d "@$base" +%FT%TZ)"
} >"$CODEX_HOME/sessions/2026/10/11/rollout-x-t-impl-1.jsonl"
session=11111111-2222-3333-4444-555555555555
mkdir -p "$CLAUDE_CONFIG_DIR/projects/p/$session/subagents"
assistant() { printf '{"type":"assistant","message":{"id":"%s","usage":{"input_tokens":%d,"cache_creation_input_tokens":%d,"cache_read_input_tokens":%d,"output_tokens":%d}}}\n' "$@"; }
{
    assistant m1 1 10 100 5; assistant m1 1 10 100 5; assistant m2 2 0 0 7
    # Planning, before the claim: counted apart (development.md, section 15.2).
    printf '{"type":"assistant","timestamp":"2020-01-01T00:00:00.000Z","message":{"id":"m0","usage":{"input_tokens":1000,"output_tokens":1}}}\n'
} >"$CLAUDE_CONFIG_DIR/projects/p/$session.jsonl"
# The supervisor's context was compacted twice (development.md, section 10.5).
boundary() { printf '{"type":"system","subtype":"compact_boundary","uuid":"%s","timestamp":"2026-10-17T09:00:00.000Z"}\n' "$1"; }
{ boundary u1; boundary u2; } >>"$CLAUDE_CONFIG_DIR/projects/p/$session.jsonl"
assistant s1 3 0 0 3 >"$CLAUDE_CONFIG_DIR/projects/p/$session/subagents/agent-1.jsonl"
# A forked session copies m1, which counts once, and adds m3.
fork=22222222-3333-4444-5555-666666666666
{ assistant m1 1 10 100 5; assistant m3 4 0 0 2; } >"$CLAUDE_CONFIG_DIR/projects/p/$fork.jsonl"
# The planner's session, named by the plan's Planner-Session trailer: before the claim.
printf '{"type":"assistant","timestamp":"2020-01-01T00:00:00.000Z","message":{"id":"m9","usage":{"input_tokens":500,"output_tokens":2}}}\n' >"$CLAUDE_CONFIG_DIR/projects/p/$planner.jsonl"
printf 'supervisor\t%s\t%s\ndesigner\t%s\t%s\n' "$session" "$stamp" "$fork" "$stamp" >"$run/claude.tsv"

# The pulse.
pulse=$("$plan" pulse)
expect pulse "$pulse" \
    "- Progress: 2 planned and 1 added steps landed since; in all 2 of 3 planned landed, 1 added (0 to go)" \
    "- Running: alpha-01.3 (w1)" \
    "below plan: alpha-01.2 (unit, planned joint)" \
    "no Proof line: alpha-01.s1" \
    "reports 1 lines median, 3 p90" "1 land gates for 3 landings, 1 other gate-lane tasks" "queue 20 s waiting, 200 s running" \
    "last gate: scripts/check.sh passed: 13 tests / 1.1 s; 2 tests / 20.0 s; 30 s in all; within four fifths of the budgets" \
    "SLOW lines in gate logs: 2" \
    "over 50 lines: src/big.rs (62)" "new lint exceptions: 1" "forbidden words: actual 1, exact 1" \
    "types like a parallel one: OwnerThing" "test helpers in more than three files: text (5 files)" \
    "tokens in/out: coordinator 54000/5400, sessions 700/70, Claude Code 120/17" \
    "Claude Code at list prices, since the planning: \$0: planner \$0, supervisor \$0, designer \$0" \
    "1 steers in all, 1 points refused" \
    "- Rising words: line 0 to 60" "- Pins behind upstream main, in commits: none." \
    "- Contexts: t-impl-1 250K (past 200K: t-impl-1); Claude Code: supervisor 1K, designer 0K."
expect "pulse mark" "$(cat "$run/.pulse")" " "
sleep 1
expect "pulse again" "$("$plan" pulse)" "- Progress: 0 planned and 0 added steps landed since" "no gate since"

# The metrics.
metrics=$(PLAN_CLAUDE_PRICES="1000000 1000000 1000000 1000000 1000000" "$plan" metrics)
expect metrics "$metrics" \
    $'running_h\t0.5\th' $'steps_planned\t2\t' $'steps_added\t1\t' \
    $'escalations\tdesign gap 1, plan defect 1\t' $'escalation_wait_min\t60.0\t' $'blocked_h\t2.0\th' \
    $'answers_reversed\t1\t' $'steers\t1 sent, 1 points refused' $'restarts\treboot 1\t' \
    $'tokens_coordinator\t54000 in (0% cached), 5400 out' $'tokens_implementers\t700 in (0% cached), 70 out' $'tokens_claude\t1620 in (6% cached), 20 out; in: 1500 before the claim, 120 in the run, 0 after' \
    $'cost_claude\t$1640: planner $502, supervisor $1132, designer $6; cache reads $100, cache writes $10, fresh input $1510, output $20\t' \
    $'supervisor\t1 sessions, 0.0 h, 0.0M weighted tokens per hour, 100% in their first 40 requests, 2 compactions' \
    $'coordinator_requests\t4, 1 after a wait ran out' $'compactions\t1\t' \
    $'gates_per_step\t0.3\t' $'gate_lane_other\t1\t' $'queue_wait_ratio\t0.10\t' \
    $'suites\talpha first: scripts/check.sh passed: 10 tests / 1.0 s; 2 tests / 50.0 s; 60 s in all; last: scripts/check.sh passed: 13 tests' \
    $'proofs\tunit 1, world 1, none 1, 1 below plan' $'report_lines\t1 median, 3 p90' \
    $'pin_lag\tnone\t' $'contexts\t260K median, 260K p90 of the sessions\' peaks; 0 handovers'
"$plan" metrics --out "$dir/metrics.tsv" >/dev/null
expect history "$("$plan" metrics --history)" "| Metric | demo |" "| steps_planned | 2 |"

expect contexts "$("$plan" contexts)" "  250K, peak 260K  past 200K: hand over"

# Nothing in the workspace pins alpha.
expect downstream "$("$plan" downstream)" "downstream: no repository pins alpha"

# The watch, each of its events.
watch() { timeout 10 "$plan" watch "$@" || echo "watch exited $?"; }
echo "# Blocked" >"$run/blocked.md"; echo "## alpha 01.3: a question, $stamp" >>"$run/blocked.md"
expect "watch blocked" "$(watch)" "blocked: $run/blocked.md" "## alpha 01.3: a question"
echo "# Answer" >"$run/answer.md"
expect "watch answer" "$(watch)" "answer: $run/answer.md"
rm "$run/blocked.md" "$run/answer.md"
touch -d '-5 seconds' "$run/heartbeat"
expect "watch quiet" "$(PLAN_QUIET=2 watch)" "quiet: no heartbeat"
expect "watch quiet again" "$(PLAN_QUIET=2 watch)" "quiet again: no heartbeat"
touch "$run/heartbeat"
echo "# Paused" >"$run/paused.md"
expect "watch paused" "$(PLAN_COMPACTIONS=3 watch)" "paused: $run/paused.md" "context: the supervisor's is 1K (compactions: 2)"
rm "$run/paused.md"
"$plan" set alpha-02.1 repo=alpha session=02 state=check title=third
expect "status check" "$("$plan" status)" "1 to check"
expect "watch check" "$(watch)" "check: alpha-02.1, $dir/alpha/02-second.md" "(compactions: 2): hand over now"
expect "ready" "$(PLAN_DRY_RUN=1 "$plan" ready alpha-02.1)" "would ring the coordinator: ready: alpha-02.1"
expect "ready in the ledger" "$(grep alpha-02.1 "$run/ledger.tsv")" $'\tready\t' "checked "
expect "ready twice" "$(PLAN_DRY_RUN=1 "$plan" ready alpha-02.1 2>&1 || true)" "is not waiting for its check"
# An idle coordinator's silence is no event.
expect idle "$("$plan" idle "waiting for the user")" "end your turn now"
touch -d '-5 seconds' "$run/heartbeat"
expect "watch idle" "$(PLAN_QUIET=2 timeout 3 "$plan" watch || echo "watch exited $?")" "watch exited 124"
rm "$run/idle.md"
touch "$run/heartbeat"

# A report, logged by its implementer.
report=$(printf 'Session: alpha 01\nStep: alpha-01.3, landed\n' | "$plan" log alpha 01)
expect "log" "$report" "$run/reports/alpha-01-"
expect "logged" "$(tail -n 5 "$run/log.md")" "## alpha 01, " "Step: alpha-01.3, landed"

# A ruling, written once in the draft unblock, then landed in decisions.md
# with the plan edit waiting in the supervisor's worktree.
printf '# Unblock\n\nAnswer to the blocked report of 2026-10-11T10:00:00Z.\nReverses: nothing.\n\n## Decision\n\nDo the thing, as ruling {ruling} says.\n\n## Landed\n\n## Instructions\n\n1. Go on.\n' >"$run/unblock.draft.md"
docs=$("$plan" docs)
echo "Amended." >>"$docs/docs/development/plans/demo/alpha/01-first.md"
ruled=$(PLAN_DRY_RUN=1 "$plan" ruling "The thing, ruling {ruling}" "plan defect, alpha 01's block of 2026-10-11T10:00:00Z" 2>&1)
expect ruling "$ruled" "ruling 101 landed as alpha " "would ring the coordinator: unblock.md is ready"
expect "ruling in decisions.md" "$(git -C "$repo" show main:docs/development/plans/demo/decisions.md)" \
    "101. **The thing, ruling 101** (plan defect, alpha 01's block of 2026-10-11T10:00:00Z)." "     Do the thing, as ruling 101 says." $'\n\n## For the user'
expect "ruling's plan edit" "$(git -C "$repo" show main:docs/development/plans/demo/alpha/01-first.md)" "Amended."
expect "unblock from the draft" "$(cat "$run/unblock.md")" "## Landed" "ruling 101, in alpha/01-first.md, decisions.md." "1. Go on."
printf 'The second.\n' >"$t/ruling.txt"
expect "ruling from a file" "$("$plan" ruling --text "$t/ruling.txt" "Second" "ready check of alpha-02.1" 2>/dev/null)" "ruling 102 landed as alpha "
rm "$run/unblock.md"

# The user's decisions on the last retrospective's proposals.
older=$repo/docs/development/plans/older
mkdir -p "$older"
printf '# Retrospective\n\n## 8. Proposals\n\n1. **One.** Why.\n\n2. **Two.** Why.\n   1. A sub-item.\n\n## 10. Decisions\n\n| Proposal | Decision | Where |\n|---|---|---|\n| 1 | adopted | here |\n| 2 | open | |\n' >"$older/retrospective.md"
git -C "$repo" add -A
git -C "$repo" commit -q -m "An older retrospective"
expect "decisions open" "$(PLAN_NO_GATE=1 "$plan" check "$dir" 2>&1 || true)" "FAIL  the last retrospective, alpha's older, has proposals not yet decided: 2"
sed -i 's/^| 2 | open | |$/| 2 | rejected: not now | |/' "$older/retrospective.md"
git -C "$repo" commit -q -am "Decide the older retrospective's proposals"
expect "decisions made" "$(PLAN_NO_GATE=1 "$plan" check "$dir" 2>&1 || true)" "ok    the last retrospective's proposals are decided (alpha's older)"

# The roles, offline.
expect "attach coordinator" "$(PLAN_DRY_RUN=1 "$plan" attach coordinator)" "codex resume --remote unix:// $coordinator"
expect "attach supervisor" "$(PLAN_DRY_RUN=1 "$plan" attach supervisor)" "claude --resume $session"
expect "join outside a session" "$(CLAUDE_CODE_SESSION_ID='' "$plan" join designer 2>&1 || true)" "run plan join from the Claude Code session itself"
expect "join" "$(CLAUDE_CODE_SESSION_ID=fake-designer "$plan" join designer)" "designer: Claude Code session fake-designer" "End your turn now"
expect "roles" "$(PLAN_NO_ROLES='' "$plan" status)" "## Roles" "- coordinator: $coordinator" "- supervisor: $session, gone"
expect "wake resumes" "$(PLAN_DRY_RUN=1 "$plan" wake designer "question.md")" "designer: would resume fake-designer: question.md"
# A designer compacted twice starts fresh.
big=33333333-4444-5555-6666-777777777777
{
    printf '{"type":"assistant","timestamp":"%s","message":{"id":"b1","usage":{"input_tokens":1,"cache_read_input_tokens":150000,"output_tokens":1}}}\n' "$(date -u +%FT%T.000Z)"
    boundary b2; boundary b3
} >"$CLAUDE_CONFIG_DIR/projects/p/$big.jsonl"
printf 'designer\t%s\t%s\n' "$big" "$stamp" >>"$run/claude.tsv"
expect "wake fresh" "$(PLAN_DRY_RUN=1 "$plan" wake designer "question.md")" "designer: compactions 2, idle 0 min: a fresh session" "designer: would start a fresh session: You are the designer"
# The supervisor hands over; the old session's watch then shows nothing.
expect handover "$(CLAUDE_CODE_SESSION_ID=$session PLAN_DRY_RUN=1 "$plan" handover supervisor)" "supervisor: would start a fresh session: Take over" "supervises no more"
expect "handover by another" "$(CLAUDE_CODE_SESSION_ID=someone "$plan" handover supervisor 2>&1 || true)" "this session is not the run's supervisor"
printf 'supervisor\tnew-supervisor\t%s\n' "$stamp" >>"$run/claude.tsv"
expect "handed over" "$(CLAUDE_CODE_SESSION_ID=$session "$plan" watch || echo "watch exited $?")" "handed over: session new-supervisor" "watch exited 4"

# After the run's release, metrics and retro find it as the last run.
"$plan" release >/dev/null
[[ ! -e $run/kit ]] || { echo "FAIL release: $run/kit is left"; failed=1; }
# The successor's 41 requests over an hour, after a copy of the first's
# compaction and of its message m2, which count once.
{
    boundary u1; boundary u3; assistant m2 2 0 0 7
    for i in $(seq 0 39); do
        printf '{"type":"assistant","timestamp":"2026-10-17T10:%02d:00.000Z","message":{"id":"n%d","usage":{"input_tokens":100000,"output_tokens":0}}}\n' "$i" "$i"
    done
    printf '{"type":"assistant","timestamp":"2026-10-17T11:00:00.000Z","message":{"id":"n40","usage":{"input_tokens":100000,"output_tokens":0}}}\n'
} >"$CLAUDE_CONFIG_DIR/projects/p/new-supervisor.jsonl"
expect "metrics after release" "$("$plan" metrics)" $'steps_planned\t2\t' \
    $'supervisor\t2 sessions, 1.0 h, 4.1M weighted tokens per hour, 97% in their first 40 requests, 3 compactions'

if ((live)); then
    # Real agents, on cheap settings, with the real Codex and Claude Code homes.
    unset CODEX_HOME CLAUDE_CONFIG_DIR
    export PLAN_START_UNCHECKED=1 PLAN_CLAUDE_MODEL=${PLAN_TEST_CLAUDE_MODEL:-claude-haiku-5-5} PLAN_CLAUDE_EFFORT=low
    export PLAN_CODEX_EFFORT=low PLAN_CODEX_SANDBOX=read-only
    export PLAN_SUPERVISOR_PROMPT="This is a test of plan start. Reply OK and end your turn."
    export PLAN_COORDINATOR_PROMPT="This is a test of plan start. Run the shell command \`sleep 40\`. Then reply with one line: every message you received after this one, quoted word for word, or none. End your turn."
    export PLAN_COORDINATOR_RESUME="This is a test of plan resume. Reply RESUMED and end your turn."
    export PLAN_RETRO_PROMPT="This is a test of plan retro. Reply OK and end your turn."
    rm -f "$run/thread" "$run/claude.tsv"
    started=$("$plan" start "$dir" 2>&1 || true)
    expect start "$started" "supervisor: Claude Code session" "coordinator: Codex thread" "rang the coordinator: Doorbell test"
    thread=$(cat "$run/thread" || true)
    supervisor=$(awk -F'\t' '$1 == "supervisor" { print $2 }' "$run/claude.tsv" || true)
    expect "attach running supervisor" "$(PLAN_DRY_RUN=1 "$plan" attach supervisor || true)" "claude attach ${supervisor:0:8}"
    for _ in $(seq 120); do
        [[ $(PLAN_NO_ROLES='' "$plan" status || true) == *"- coordinator: $thread, idle"* ]] && break
        sleep 2
    done
    file=$(find "$HOME/.codex/sessions" "$HOME/.codex/archived_sessions" -name "rollout-*-$thread.jsonl" | head -n1 || true)
    expect "the coordinator heard the doorbell" "$(jq -r 'select(.type == "response_item" and .payload.type == "message" and .payload.role == "assistant") | .payload.content[]?.text // empty' "$file" || true)" "Doorbell test"
    expect resume "$("$plan" resume || true)" "coordinator: resumed"
    for _ in $(seq 60); do
        [[ $(PLAN_NO_ROLES='' "$plan" status || true) == *"- coordinator: $thread, idle"* ]] && break
        sleep 2
    done
    expect "the coordinator resumed" "$(jq -r 'select(.type == "response_item" and .payload.type == "message" and .payload.role == "assistant") | .payload.content[]?.text // empty' "$file" || true)" "RESUMED"
    expect wake "$("$plan" wake supervisor "This is a test of plan wake. Reply WOKEN and end your turn." || true)" "supervisor: Claude Code session"
    expect retro "$("$plan" retro "$dir" || true)" "retrospective: Claude Code session"
    # Clean up: the coordinator's thread archived, the Claude Code sessions removed.
    (
        source "$kit/codex.sh"
        codex_open && codex_call thread/archive "$(jq -cn --arg t "$thread" '{threadId: $t}' || true)" >/dev/null && codex_close
    ) || echo "could not archive thread $thread"
    cut -f2 "$run/claude.tsv" | sort -u | while read -r session; do
        claude stop "${session:0:8}" >/dev/null 2>&1 || true
        claude rm "${session:0:8}" >/dev/null 2>&1 || true
    done
fi

if ((failed)); then
    echo "test-plan: failed"
    exit 1
fi
echo "test-plan: passed"
