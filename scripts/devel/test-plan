#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Tests plan on a workspace of its own, in a temporary directory.
#
#   test-plan          the commands that need no agent: the ledger, status,
#                      watch, pulse, metrics, reports, rulings, the decisions
#                      check, attach, wake and handover (printed); its
#                      budget is 40 s, and it fails past 45 s
#   test-plan --live   also start, ring, resume, wake and retro, with cheap
#                      models and prompts that end at once; it spends a few
#                      cents of each program's usage, and takes a few minutes
#
# It prints each failed expectation, and exits 1 if there was one.
set -Eeuo pipefail
trap 'echo "test-plan: failed at line $LINENO" >&2' ERR
kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
live=0
[[ ${1:-} == --live ]] && live=1
# The process layer's budget, and its margin for the lanes' noise
# (development.md, section 3.6).
budget=40 budget_margin=5
machine_home=$HOME
# shellcheck disable=SC2034 # test-plan-live.sh restores the machine's runtime directory
machine_runtime_dir=${XDG_RUNTIME_DIR-}
# shellcheck disable=SC2034 # test-plan-live.sh restores the machine's bus address
machine_bus_address=${DBUS_SESSION_BUS_ADDRESS-}
machine_plan_link=$(readlink "$machine_home/.local/bin/plan" || true)

workspace=${DEV_ROOT:-$(dirname "$(dirname "$(git -C "$kit" rev-parse --path-format=absolute --git-common-dir)")")}
t=$(mktemp -d "$workspace/tmp/test-plan.XXXXXX")
cleanup() {
    pueue shutdown >/dev/null 2>&1 || true
    if [[ ${PLAN_TEST_KEEP:-} != 1 ]]; then rm -rf "$t"; fi
}
[[ ${PLAN_TEST_KEEP:-} != 1 ]] || echo "test-plan: keeping $t"
# Captures label their exit status, including successful commands.
capture() {
    local name=$1 code=0 output
    shift
    output=$("$@" 2>&1) || code=$?
    printf '%s=%s\n%s\n' "$name" "$code" "$output"
}
# Every poll has the same tenth-second interval and a bounded attempt count.
poll_until() {
    local attempts=$1 attempt
    shift
    for ((attempt=0; attempt<attempts; attempt++)); do
        "$@" && return 0
        sleep 0.1
    done
    return 1
}
queue_up() { pueue status >/dev/null 2>&1; }
export PUEUE_CONFIG_PATH=$t/pueue/pueue.yml
mkdir -p "$t/pueue"
cat >"$PUEUE_CONFIG_PATH" <<EOF
shared:
  pueue_directory: $t/pueue
  runtime_directory: $t/pueue
  use_unix_socket: true
  unix_socket_path: $t/pueue/pueue.socket
EOF
trap cleanup EXIT
pueued -d
poll_until 100 queue_up
pueue group add build >/dev/null
pueue group add gate >/dev/null
export DEV_ROOT=$t/src DEV_TMP=$t/src/tmp DEV_REPOS=alpha
export CODEX_HOME=$t/codex CLAUDE_CONFIG_DIR=$t/claude PLAN_NO_ROLES=1 PLAN_POLL=0.1
export HOME=$t/home
unset XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS
mkdir -p "$HOME"
plan=$kit/plan
failed=0

expect() {
    local what=$1 output=$2 want
    shift 2
    for want in "$@"; do
        if ! grep -qF -- "$want" <<<"$output"; then
            echo "FAIL $what: no \"$want\" in:"
            printf '    %s\n' "${output//$'\n'/$'\n'    }"
            failed=1
        fi
    done
}

# A repository with a plan.
repo=$DEV_ROOT/alpha
dir=$repo/docs/development/plans/demo
