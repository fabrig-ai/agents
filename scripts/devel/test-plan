    printf '{"timestamp":"%s","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":700,"output_tokens":70},"last_token_usage":{"input_tokens":250000}}}}\n' "$(date -u -d "@$base" +%FT%TZ)"
    printf '{"timestamp":"%s","type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":700,"output_tokens":70},"last_token_usage":{"input_tokens":100000}}}}\n' "$(date -u -d "@$base" +%FT%TZ)"
} >"$CODEX_HOME/sessions/2026/10/11/rollout-x-t-impl-1.jsonl"
session=11111111-2222-3333-4444-555555555555
