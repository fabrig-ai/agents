    printf '{"type":"assistant","timestamp":"2020-01-01T00:00:00.000Z","message":{"id":"m0","usage":{"input_tokens":1000,"output_tokens":1}}}\n'
} >"$CLAUDE_CONFIG_DIR/projects/p/$session.jsonl"
printf '{"type":"assistant","message":{"id":"t","usage":{"input_tok\n' >>"$CLAUDE_CONFIG_DIR/projects/p/$session.jsonl"
# The supervisor's context was compacted twice (development.md, section 10.5).
boundary() { printf '{"type":"system","subtype":"compact_boundary","uuid":"%s","timestamp":"2026-10-17T09:00:00.000Z"}\n' "$1"; }
{ boundary u1; boundary u2; } >>"$CLAUDE_CONFIG_DIR/projects/p/$session.jsonl"
assistant s1 3 0 0 3 >"$CLAUDE_CONFIG_DIR/projects/p/$session/subagents/agent-1.jsonl"
