echo 'let exact = 1;' >"$t/clone/w.rs"
git -C "$t/clone" add w.rs
git -C "$t/clone" commit -qm $'Add the word\n\nPlan: demo'
mkdir -p "$t/land-tmp"
printf 'alpha/demo\n%s\n' "$dir" >"$t/land-tmp/active-plan"
flock "$t/clone/.git/land-turn.lock" sh -c 'touch "$1"; sleep 0.3' sh "$t/turn-held" &
turn_pid=$!
poll_until 50 test -f "$t/turn-held"
out=$(capture status land_run --gate true)
wait "$turn_pid"
expect "land refuses a Pulse word" "$out" 'status=2' 'land:' "the plan's Pulse forbids these words (actual|exact)" 'w.rs: let exact = 1;'
expect "land waits for another landing's turn" "$out" 'land: another landing in clone has its turn; waiting for it'
before=$(cat "$run/ledger.tsv")
out=$(capture status "$plan" set --help state=ready)
expect "plan set refuses an option" "$out" 'status=2' 'plan:' 'a step is not an option: --help'
expect "an option leaves the ledger unchanged" "$(if [[ $(cat "$run/ledger.tsv") == "$before" ]]; then echo unchanged; fi)" unchanged

# These commands share one queue and one row file; clients wait together.
heavy_run() (cd "$repo"; HEAVY_TASK='' DEV_TMP=$t/heavy-tmp "$kit/heavy" "$@")
heavy_capture() {
    local label=$1
    shift
    capture status heavy_run "$@" >"$t/$label.out"
    head -n1 "$t/$label.out" >"$t/$label.status"
}
heavy_row() {
    awk -F'\t' -v command="$1" '$10 == command { n++; lane=$2; status=$6 }
        END { printf "rows=%d lane=%s status=%s", n, lane, status }' "$t/heavy-tmp/logs/heavy.tsv"
}
heavy_capture failure sh -c 'exit 3' &
failure_pid=$!
HEAVY_TASK='' DEV_TMP=$t/heavy-tmp "$kit/heavy" sleep 0.5 >"$t/client.log" 2>&1 &
client_pid=$!
running_client() {
    pueue status --json | jq -er '.tasks[] | select((.status | has("Running")) and (.command | contains("sleep 0.5"))) | .id'
}
task_id=$(poll_until 50 running_client)
kill "$client_pid"
wait "$client_pid" 2>/dev/null || true
heavy_capture gate --gate true &
gate_pid=$!
wait "$failure_pid" "$gate_pid"
expect "heavy passes the failed command's status" "$(cat "$t/failure.status")" 'status=3'
expect "heavy writes one failure row" "$(heavy_row 'sh -c exit 3')" 'rows=1 lane=build status=3'
expect "a killed client loses no row" "$(heavy_row 'sleep 0.5')" 'rows=1 lane=build status=0'
expect "the gate lane passes the status too" "$(cat "$t/gate.status")" 'status=0'
expect "the gate lane writes its row too" "$(heavy_row true)" 'rows=1 lane=gate status=0'

# Commits with trailers, after the claim.
commit() {
    local step=$1 proof=$2 gate=$3 message
    git -C "$repo" add -A
    message="Step $step"$'\n\n'"Body."$'\n\n'
    [[ -z $proof ]] || message+="Proof: $proof"$'\n'
    message+="Plan: demo"$'\n'"Step: $step"$'\n'"Gate-Result: $gate"
    git -C "$repo" commit -q "${@:4}" -m "$message"
}
seq 1 60 | sed 's/^/\/\/ line /' >"$repo/src/big.rs"
echo "pub struct OwnerThing; // the actual one" >>"$repo/src/big.rs"
for i in 1 2 3 4; do echo "fn text() {}" >"$repo/tests/t$i.rs"; done
