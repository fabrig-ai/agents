git -C "$repo" add docs/design/thing.md
git -C "$repo" commit -q -m "This design" -m "Designer-Session: $designer"$'\n''Designer-Session: agent-a1'
echo other >"$repo/docs/design/other.md"
git -C "$repo" add docs/design/other.md
git -C "$repo" commit -q -m "Another design" -m "Designer-Session: $other"
git -C "$repo" add -A
git -C "$repo" commit -q -m "Plan the demo" -m "Planner-Session: $planner"

# The workspace's skein, whose commit a claim takes as the run's kit
# (development.md, section 3.6): this kit as it stands, its plan marked so
# that a test sees which copy ran.
mkdir -p "$DEV_ROOT/skein/scripts"
cp -r "$kit" "$DEV_ROOT/skein/scripts/dev"
sed -i '2i [[ -z ${PLAN_TEST_KIT:-} ]] || echo "the run'\''s kit" >&2' "$DEV_ROOT/skein/scripts/dev/plan"
git -C "$DEV_ROOT/skein" init -q -b main
