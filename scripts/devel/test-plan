#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# Tests plan on a workspace of its own, in a temporary directory.
#
#   test-plan          the commands that need no agent: the ledger, status,
#                      watch, pulse, metrics, reports, rulings, the decisions
#                      check, attach, wake and handover (printed); its
#                      budget is 40 s, and it fails past 45 s
#   test-plan --live   also start, ring, resume, wake and retro, with cheap
#                      models and prompts that end at once; it spends a few
#                      cents of each program's usage, and takes a few minutes
#
# Its checks run in three parts at once, each on a workspace of its own:
# test-plan --part numbers, watch or roles runs one. It prints each failed
# expectation, and exits 1 if there was one.
set -Eeuo pipefail
trap 'echo "test-plan${part:+ --part $part}: failed at line $LINENO" >&2' ERR
started=$(date +%s.%N)
kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
live=0 part='' args=("$@")
while (($#)); do
    case $1 in
        --live) live=1 ;;
        --part) part=$2; shift ;;
    esac
    shift
done
[[ -z $part || $part =~ ^(numbers|watch|roles)$ ]] || { echo "test-plan: no part $part" >&2; exit 2; }
# The process layer's budget, and its margin for the lanes' noise
# (development.md, section 3.6).
budget=40 budget_margin=5
machine_home=$HOME
# shellcheck disable=SC2034 # test-plan-live.sh restores the machine's runtime directory
machine_runtime_dir=${XDG_RUNTIME_DIR-}
# shellcheck disable=SC2034 # test-plan-live.sh restores the machine's bus address
machine_bus_address=${DBUS_SESSION_BUS_ADDRESS-}
machine_plan_link=$(readlink "$machine_home/.local/bin/plan" || true)

workspace=${DEV_ROOT:-$(dirname "$(dirname "$(git -C "$kit" rev-parse --path-format=absolute --git-common-dir)")")}
failed=0

expect() {
    local what=$1 output=$2 want
    shift 2
    for want in "$@"; do
        if ! grep -qF -- "$want" <<<"$output"; then
            echo "FAIL $what: no \"$want\" in:"
            printf '    %s\n' "${output//$'\n'/$'\n'    }"
            failed=1
        fi
    done
}

# The parts run at once; the budget times them together, from this start to
# the last part's end before the live checks.
if [[ -z $part ]]; then
    results=$(mktemp -d "$workspace/tmp/test-plan.XXXXXX")
    names=(numbers watch roles) pids=()
    trap 'kill "${pids[@]}" 2>/dev/null || true; [[ ${PLAN_TEST_KEEP:-} == 1 ]] || rm -rf "$results"' EXIT
    trap 'exit 1' INT TERM
    for name in "${names[@]}"; do
        PLAN_TEST_RESULTS=$results "$kit/test-plan" --part "$name" "${args[@]}" >"$results/$name.out" 2>&1 &
        pids+=("$!")
    done
    for i in "${!names[@]}"; do
        wait "${pids[i]}" || failed=1
        cat "$results/${names[i]}.out"
    done
    pids=()

    # The process layer fails past its budget and margin, and passes at them.
    over_budget() {
        if (($1 > $2 + $3)); then echo "$1 s, past $2 s and its $3 s margin"; fi
    }
    while IFS='|' read -r elapsed want; do
        expect "budget, ${elapsed} s" "<$(over_budget "$elapsed" 40 5)>" "<$want>"
    done <<'BUDGET'
45|
46|46 s, past 40 s and its 5 s margin
BUDGET
    elapsed=$(cat "$results"/*.end 2>/dev/null | awk -v start="$started" '$1 - start > e { e = $1 - start } END { printf "%d", e }')
    over=$(over_budget "$elapsed" "$budget" "$budget_margin")
    [[ -z $over ]] || { echo "FAIL the process layer ran $over (development.md, section 3.6)"; failed=1; }
    if ((failed)); then
        echo "test-plan: failed"
        exit 1
    fi
    echo "test-plan: passed"
    exit 0
fi

t=$(mktemp -d "$workspace/tmp/test-plan.XXXXXX")
cleanup() {
    pueue shutdown >/dev/null 2>&1 || true
    if [[ ${PLAN_TEST_KEEP:-} != 1 ]]; then rm -rf "$t"; fi
}
[[ ${PLAN_TEST_KEEP:-} != 1 ]] || echo "test-plan: keeping $t"
# Captures label their exit status, including successful commands.
capture() {
    local name=$1 code=0 output
    shift
    output=$("$@" 2>&1) || code=$?
    printf '%s=%s\n%s\n' "$name" "$code" "$output"
}
# Every poll has the same tenth-second interval and a bounded attempt count.
poll_until() {
    local attempts=$1 attempt
    shift
    for ((attempt=0; attempt<attempts; attempt++)); do
        "$@" && return 0
        sleep 0.1
    done
    return 1
}
queue_up() { pueue status >/dev/null 2>&1; }
export PUEUE_CONFIG_PATH=$t/pueue/pueue.yml
mkdir -p "$t/pueue"
cat >"$PUEUE_CONFIG_PATH" <<EOF
shared:
