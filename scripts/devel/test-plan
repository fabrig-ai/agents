fork=22222222-3333-4444-5555-666666666666
{ assistant m1 1 10 100 5; assistant m3 4 0 0 2; } >"$CLAUDE_CONFIG_DIR/projects/p/$fork.jsonl"
# The planner's session, named by the plan's Planner-Session trailer: before the claim.
printf '{"type":"assistant","timestamp":"2020-01-01T00:00:00.000Z","message":{"id":"m9","usage":{"input_tokens":500,"output_tokens":2}}}\n' >"$CLAUDE_CONFIG_DIR/projects/p/$planner.jsonl"
printf 'supervisor\t%s\t%s\ndesigner\t%s\t%s\n' "$session" "$stamp" "$fork" "$stamp" >"$run/claude.tsv"

# The designer's agent has one child beside it; an unrelated sibling is excluded.
