#!/usr/bin/env bash
# Durable mailboxes for agents, with local or restricted-SSH delivery.
#   post send [--as NAME] [--re ID] TO SUBJECT [FILE]
#   post deliver --from MACHINE
#   post wait NAME [--timeout SECONDS] [--holder PID --kind KIND]
#   post read NAME
#   post list [--older MINUTES]
#   post waiters
#   post wake NAME | --older MINUTES
# See docs/design/post.md for the addresses, delivery and waking rules.
set -euo pipefail
umask 077
export PATH=$HOME/.local/bin:$PATH

kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
workspace() {
    local agents
    agents=$(cd "$kit/../.." && pwd)
    if [[ $(basename "$agents") == agents ]]; then dirname "$agents"; else echo "$HOME/src/rust"; fi
}
root=${DEV_ROOT:-$(workspace)}
# wait changes directory before registering; keep relative DEV_ROOT usable.
root=$(realpath -m "$root")
post=$root/tmp/post
name_pattern='^[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$'
machine_pattern='^[a-z][a-z0-9-]*$'
id_pattern='^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$'
# post.md 3: automatic wakes consider only unread mail under a day old.
wake_window_minutes=1440
scratch=
trap '[[ -z $scratch ]] || rm -f -- "$scratch"' EXIT

fail() { echo "post: ${error_prefix:-}$*" >&2; exit 2; }
usage() { fail 'usage: post {send|deliver|wait|read|list|waiters|wake} (see docs/design/post.md)'; }
valid_name() { [[ $1 =~ $name_pattern ]]; }
valid_machine() { [[ $1 =~ $machine_pattern ]]; }
valid_subject() { [[ ${#1} -le 200 && ! $1 =~ [[:cntrl:]] ]]; }
valid_address() {
    [[ $1 == *@* ]] && valid_name "${1%@*}" && valid_machine "${1##*@}"
}
mailbox() {
    local name=${1//\//+}
    mkdir -p -- "$post/$name"/{tmp,new,cur,sent} || fail 'cannot create mailbox'
    box=$post/$name
}
receive() {
    timeout 30 head -c 65537 >"$scratch" || fail 'cannot read message'
    (($(stat -c %s "$scratch") <= 65536)) || fail 'message exceeds 64 KiB'
}

parse_message() {
    local line re='' lines=5
    {
        IFS= read -r line && [[ $line == 'Id: '* ]] || return 1
        msg_id=${line#Id: }
        [[ $msg_id =~ $id_pattern ]] || return 1
        IFS= read -r line && [[ $line == 'From: '* ]] || return 1
        msg_from=${line#From: }
        valid_address "$msg_from" || return 1
        IFS= read -r line && [[ $line == 'To: '* ]] || return 1
        msg_to=${line#To: }
        valid_address "$msg_to" || return 1
        IFS= read -r line || return 1
        if [[ $line == 'Re: '* ]]; then
            re=${line#Re: }
            [[ $re =~ $id_pattern ]] || return 1
            lines=6
            IFS= read -r line || return 1
        fi
        [[ $line == 'Subject: '* ]] || return 1
        msg_subject=${line#Subject: }
        valid_subject "$msg_subject" || return 1
        IFS= read -r line && [[ -z $line ]] || return 1
    } <"$1"
    # read discards NUL bytes; require the original header to match too.
    cmp -s <(header "$msg_id" "$msg_from" "$msg_to" "$re" "$msg_subject") <(head -n "$lines" "$1")
}
header() {
    printf 'Id: %s\nFrom: %s\nTo: %s\n' "$1" "$2" "$3"
    [[ -z $4 ]] || printf 'Re: %s\n' "$4"
    printf 'Subject: %s\n\n' "$5"
}
starttime() {
    local stat rest
    [[ $1 =~ ^[1-9][0-9]*$ ]] || return 1
    IFS= read -r stat 2>/dev/null <"/proc/$1/stat" || return 1
    # comm may contain spaces or parentheses; the fields follow its last ).
    rest=${stat##*) }
    awk '{print $20}' <<<"$rest"
}
waiter_alive() {
    local current
    [[ ${wait_pid:-} =~ ^[1-9][0-9]*$ && ${wait_start:-} =~ ^[0-9]+$ ]] || return 1
    current=$(starttime "$wait_pid") || return 1
    [[ $current == "$wait_start" ]]
}
load_waiter() {
    wait_pid='' wait_start='' wait_kind='' wait_session='-'
    if [[ -f $box/waiter ]]; then
        read -r wait_pid wait_start wait_kind wait_session <"$box/waiter" || true
    fi
    wait_session=${wait_session:--}
}
holder_session() {
    local pid=$1 stat rest parents='' step
    local -A seen=()
    for ((step=0; step<64; step++)); do
        [[ $pid =~ ^[1-9][0-9]*$ && $pid != 1 && ! -v seen[$pid] ]] || break
        seen[$pid]=1
        parents+="${parents:+ }$pid"
        IFS= read -r stat 2>/dev/null <"/proc/$pid/stat" || break
        rest=${stat##*) }
        read -r _ pid _ <<<"$rest"
    done
    claude agents --json --all 2>/dev/null | jq -er --arg parents "$parents" '
        . as $sessions | first($parents | split(" ")[] as $pid |
            $sessions[] | select(.pid != null and (.pid | tostring) == $pid) |
            (.sessionId // .id // empty)) |
        select(type == "string" and test("^[^[:space:][:cntrl:]]+$"))' 2>/dev/null
}
session() {
    claude agents --json --all | jq -cer --arg value "$1" --arg field "${2:-name}" '
        [.[] | select((if $field == "id" then (.sessionId // .id) else .name end) == $value)] |
        sort_by(.startedAt) | last // empty'
}
unwoken() { echo "queued, nobody will wake it: $*"; return 3; }
# Only a resume consults the record; a failed pull leaves the clone usable.
active_owner() {
    local name=$1 records=${RECORDS:-$root/records} file
    local -a missions=()
    RECORDS="$records" timeout -s INT 90 record pull </dev/null >/dev/null 2>&1 || true
    if [[ ! -d $records/missions ]]; then
        [[ $name == director || $name == d/* ]] && return 0
        echo 'record unreadable'; return 1
    fi
    for file in "$records"/missions/*/README.md; do
        [[ -f $file && -r $file ]] || continue
        missions+=("$file")
    done
    # /dev/null also makes an empty missions directory an empty readable record.
    awk -v name="$name" -v machine="$local_machine" '
        FNR == 1 {front=0; owner=""; state=""; started=""}
        /^---$/ {
            if (front == 0) {front=1; next}
            if (front != 1) next
            front=2
            if (substr(owner, 1, length(name)+1) == name "@") owned=1
            if (owner != name "@" machine) next
            if (state == "active") active=1
            n=split(FILENAME, path, "/"); mission=path[n-1]
            if (!here || started > latest || (started == latest && mission > last)) {
                latest=started; last=mission; last_state=state
            }
            here=1
            next
        }
        front == 1 && /^(owner|state|started):/ {
            key=$0; sub(/:.*/, "", key)
            value=$0; sub(/^[^:]*:[[:space:]]*/, "", value); sub(/[[:space:]]+$/, "", value)
            if (key == "owner") owner=value
            if (key == "state") state=value
            if (key == "started") started=value
        }
        END {
            if (active || ((name == "director" || substr(name,1,2) == "d/") && !owned)) exit 0
            if (here) print "mission " last " is " (last_state == "" ? "unknown" : last_state)
            else print "no active mission here"
            exit 1
        }
    ' /dev/null "${missions[@]}"
}
wake() (
    local name=$1 info state full_id short_id cwd stop_info attempt reason lookup=$1 field=name kind='' alive=0
    exec 8>"$box/.wake.lock"
    flock -x 8 || fail 'cannot lock wake'
    {
        flock -s 9 || fail 'cannot lock waiter'
        load_waiter
        if waiter_alive; then alive=1; fi
        [[ ! -f $box/kind ]] || IFS= read -r kind <"$box/kind" || true
    } 9>"$box/.lock"
    if ((alive)); then echo waiting; return 0; fi
    if [[ $wait_kind == codex || $kind == codex ]]; then
        unwoken 'codex owner not running'; return $?
    fi
    if ! info=$(session "$lookup" "$field"); then
        [[ $wait_session != - ]] || { unwoken 'no session'; return $?; }
        lookup=$wait_session field=id
        if ! info=$(session "$lookup" "$field"); then unwoken 'no session'; return $?; fi
    fi
    state=$(jq -r '.state // "interactive session"' <<<"$info")
    case $state in
        working|blocked) echo queued ;;
        done)
            if jq -e '.pid == null' <<<"$info" >/dev/null; then unwoken stopped; return $?; fi
            full_id=$(jq -r '.sessionId // .id // empty' <<<"$info")
            [[ -n $full_id ]] || { unwoken 'session has no id'; return $?; }
            if ! info=$(session "$lookup" "$field"); then unwoken 'no session'; return $?; fi
            state=$(jq -r '.state // "interactive session"' <<<"$info")
            case $state in
                working|blocked) echo queued; return 0 ;;
                done)
                    if jq -e '.pid == null' <<<"$info" >/dev/null; then unwoken stopped; return $?; fi ;;
                *) unwoken "$state"; return $? ;;
            esac
            if [[ $(jq -r '.sessionId // .id // empty' <<<"$info") != "$full_id" ]]; then
                unwoken 'session changed'; return $?
            fi
            machines
            if ! reason=$(active_owner "$name"); then unwoken "$reason"; return $?; fi
            short_id=$(jq -r '.id // empty' <<<"$info")
            if [[ -z $short_id ]] || ! claude stop "$short_id" </dev/null >/dev/null 2>&1; then
                unwoken 'stop failed'; return $?
            fi
            for ((attempt=0; ; attempt++)); do
                if stop_info=$(session "$full_id" id) && jq -e '.pid == null' <<<"$stop_info" >/dev/null; then break; fi
                if ((attempt >= ${POST_STOP_WAIT:-10})); then
                    unwoken 'stop did not complete'; return $?
                fi
                sleep "${POST_STOP_STEP:-1}"
            done
            cwd=$(jq -r '.cwd // empty' <<<"$info")
            [[ -d $cwd ]] || cwd=$root
            if ! (cd -- "$cwd" && claude --bg --resume "$full_id" \
                "Post for $name: run post read $name and act on it, then start post wait $name in the background, and do the same each time it ends.") </dev/null >/dev/null 2>&1; then
                unwoken 'resume failed'; return $?
            fi
            sleep "${POST_RESUME_CHECK:-10}"
            if info=$(session "$lookup" "$field"); then state=$(jq -r '.state // "interactive session"' <<<"$info"); else state='no session'; fi
            case $state in
                working|blocked) echo woken ;;
                *) unwoken "$state" ;;
            esac ;;
        *) unwoken "$state" ;;
    esac
)
deliver_message() {
    local name=$1 from=$2 destination
    parse_message "$scratch" || fail 'invalid message header'
    [[ ${msg_to%@*} == "$name" ]] || fail 'recipient name mismatch'
    [[ ${msg_from##*@} == "$from" ]] || fail 'sender machine mismatch'
    machines
    [[ ${msg_to##*@} == "$local_machine" ]] || fail 'recipient machine mismatch'
    mailbox "$name"
    destination=$box
    (
        flock -x 9 || fail 'cannot lock mailbox'
        local existing
        for existing in "$destination/new/$msg_id.md" "$destination/cur/$msg_id.md"; do
            if [[ -e $existing ]]; then
                cmp -s -- "$scratch" "$existing" || fail 'message id already delivered with different content'
                exit 0
            fi
        done
        local staged
        staged=$(mktemp "$destination/tmp/message.XXXXXX") || fail 'cannot stage message'
        if ! cat -- "$scratch" >"$staged" || ! mv -- "$staged" "$destination/new/$msg_id.md"; then
            rm -f -- "$staged"
            fail 'cannot store message'
        fi
    ) 9>"$box/.lock" || return $?
    wake "$name"
}
machines() {
    local line machine target extra
    local_machine='' route=''
    [[ -r $post/machines ]] || fail "no machines file at $post/machines"
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%%#*}
        read -r machine target extra <<<"$line"
        [[ -n $machine ]] || continue
        # shellcheck disable=SC2015 # fail exits
        valid_machine "$machine" && [[ -n $target && -z $extra && $target != -* ]] || fail 'invalid machines file'
        if [[ $target == local ]]; then
            [[ -z $local_machine ]] || fail 'multiple local machines'
            local_machine=$machine
        fi
        [[ $machine != "${to_machine:-}" ]] || route=$target
    done <"$post/machines"
    [[ -n $local_machine ]] || fail 'machines file has no local machine'
}
send() {
    local sender=${POST_NAME:-} re='' to subject to_name to_machine='' id status code=0 file='' sent attempt=0
    local -a delays
    read -r -a delays <<<"${POST_RETRY_DELAYS:-5 20 60}"
    while (($#)); do
        case $1 in
            --as|--re)
                (($# >= 2)) || usage
                if [[ $1 == --as ]]; then sender=$2; else re=$2; fi
                shift 2 ;;
            --) shift; break ;;
            -*) usage ;;
            *) break ;;
        esac
    done
    (($# == 2 || $# == 3)) || usage
    [[ -n $sender ]] || fail 'set POST_NAME or pass --as'
    valid_name "$sender" || fail 'invalid sender name'
    [[ -z $re || $re =~ $id_pattern ]] || fail 'invalid reply id'
    to=$1 subject=$2 file=${3:-}
    valid_subject "$subject" || fail 'subject must be one line, at most 200 characters, without control characters'
    if [[ $to == *@* ]]; then
        valid_address "$to" || fail 'invalid recipient address'
        to_name=${to%@*} to_machine=${to##*@}
    else
        valid_name "$to" || fail 'invalid recipient name'
        to_name=$to
    fi
    machines
    to_machine=${to_machine:-$local_machine}
    [[ $to_machine == "$local_machine" || -n $route ]] || fail "no route to $to_machine"
    scratch=$(mktemp) || fail 'cannot stage message'
    if (($# == 3)); then
        [[ -r $file ]] || fail "cannot read body: $file"
        head -c 65537 -- "$file" >"$scratch" || fail 'cannot read body'
    else
        head -c 65537 >"$scratch" || fail 'cannot read body'
    fi
    (($(stat -c %s "$scratch") <= 65536)) || fail 'message exceeds 64 KiB'
    mailbox "$sender"
    {
        flock -x 7 || fail 'cannot lock sent mailbox'
        while :; do
            id=$(date -u +%Y%m%dT%H%M%SZ)-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
            sent=$box/sent/$id.md
            [[ ! -e $sent && ! -L $sent ]] || continue
            if ! (set -o noclobber
                { header "$id" "$sender@$local_machine" "$to_name@$to_machine" "$re" "$subject"; cat -- "$scratch"; } >"$sent"
            ); then
                rm -f -- "$sent"
                fail 'cannot save sent message'
            fi
            break
        done
    } 7>"$box/.lock"
    if (($(stat -c %s "$sent") > 65536)); then
        rm -f -- "$sent"
        fail 'message exceeds 64 KiB'
    fi
    cp -- "$sent" "$scratch" || fail 'cannot stage sent message'
    while :; do
        code=0 status=''
        if [[ $to_machine == "$local_machine" ]]; then
            status=$(SSH_ORIGINAL_COMMAND="deliver $to_name" timeout 60 "$kit/post" deliver --from "$local_machine" <"$scratch") || code=$?
        else
            status=$(timeout 60 ssh -i "$HOME/.ssh/post_ed25519" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=20 \
                -o ControlMaster=no -o ControlPath=none \
                "$route" "deliver $to_name" <"$scratch") || code=$?
        fi
        if [[ ( $code == 0 || $code == 3 ) && -n $status && $status != *$'\n'* ]]; then break; fi
        if [[ $code == 2 ]]; then
            rm -f -- "$sent"
            fail 'delivery refused'
        fi
        if [[ $code != 255 && $code != 124 && -n $status ]] || ((attempt >= 3 || attempt >= ${#delays[@]})); then
            fail 'delivery failed or no status line'
        fi
        sleep "${delays[attempt]}"
        attempt=$((attempt + 1))
    done
    printf '%s %s\n' "$id" "$status"
    return "$code"
}
deliver() {
    [[ $# == 2 && $1 == --from ]] || usage
    valid_machine "$2" || fail 'invalid sender machine'
    local name=${SSH_ORIGINAL_COMMAND:-}
    [[ $name == 'deliver '* ]] || fail 'invalid SSH_ORIGINAL_COMMAND'
    name=${name#deliver }
    valid_name "$name" || fail 'invalid SSH_ORIGINAL_COMMAND'
    scratch=$(mktemp) || fail 'cannot stage message'
    receive
    deliver_message "$name" "$2"
}
wait_mail() {
    (($#)) || usage
    local name=$1 timeout='' holder=$$ kind=claude started=$SECONDS holder_start holder_id line delay whole
    shift
    valid_name "$name" || fail 'invalid mailbox name'
    while (($#)); do
        (($# >= 2)) || usage
        case $1 in
            --timeout) timeout=$2; [[ $timeout =~ ^[0-9]+$ ]] || usage; timeout=$((10#$timeout)) ;;
            --holder) holder=$2 ;;
            --kind) kind=$2; [[ $kind == claude || $kind == codex ]] || usage ;;
            *) usage ;;
        esac
        shift 2
    done
    holder_start=$(starttime "$holder") || fail 'holder is not running'
    cd /
    mailbox "$name"
    (
        flock -x 9 || fail 'cannot lock waiter'
        printf '%s %s %s -\n' "$holder" "$holder_start" "$kind" >"$box/waiter"
        printf '%s\n' "$kind" >"$box/kind"
    ) 9>"$box/.lock"
    holder_id=$(holder_session "$holder") || holder_id=-
    (
        flock -x 9 || fail 'cannot lock waiter'
        load_waiter
        # A newer waiter may have registered while Claude answered.
        if [[ $wait_pid == "$holder" && $wait_start == "$holder_start" ]]; then
            printf '%s %s %s %s\n' "$holder" "$holder_start" "$kind" "$holder_id" >"$box/waiter"
        fi
    ) 9>"$box/.lock"
    while :; do
        line=$(
            {
                flock -x 9 || exit 2
                load_waiter
                if [[ $wait_pid != "$holder" || $wait_start != "$holder_start" ]]; then
                    echo "post: another waiter took $name"; exit 4
                fi
                local message
                for message in "$box/new/"*.md; do
                    [[ -f $message ]] || continue
                    parse_message "$message" || exit 2
                    printf '%s %s %s\n' "$msg_id" "$msg_from" "$msg_subject"
                done
            } 9>"$box/.lock"
        ) || { local code=$?; [[ -z $line ]] || echo "$line"; return "$code"; }
        if [[ -n $line ]]; then echo "$line"; return 0; fi
        [[ -z $timeout ]] || ((SECONDS - started < timeout)) || return 1
        # POST_POLL may be fractional; its whole part bounds it by the time left.
        delay=${POST_POLL:-2}; whole=${delay%.*}
        if [[ -n $timeout ]] && ((timeout - SECONDS + started < ${whole:-0})); then delay=$((timeout - SECONDS + started)); fi
        sleep "$delay"
    done
}
read_mail() {
    [[ $# == 1 ]] || usage
    valid_name "$1" || usage
    local name=$1 message found=0
    mailbox "$name"
    (
        flock -x 9 || fail 'cannot lock mailbox'
        for message in "$box/new/"*.md; do
            [[ -f $message ]] || continue
            found=1
            printf '== %s\n' "$(basename "$message" .md)"
            cat -- "$message"
            mv -- "$message" "$box/cur/"
        done
        ((found)) || echo "no new post for $name"
    ) 9>"$box/.lock"
}
list_mail() {
    local older=0 message name age now box alive
    if (($#)); then
        [[ $# == 2 && $1 == --older && $2 =~ ^[0-9]+$ ]] || usage
        older=$((10#$2))
    fi
    [[ -d $post ]] || return 0
    now=$(date +%s)
    while IFS= read -r -d '' message; do
        [[ ${message%/*} == */new ]] || continue
        box=${message%/new/*}
        name=${box#"$post/"}
        name=${name//+/\/}
        valid_name "$name" || continue
        (
            flock -x 9 || exit 2
            [[ -f $message ]] || exit 0
            age=$(((now - $(stat -c %Y "$message")) / 60))
            ((age >= older)) || exit 0
            parse_message "$message" || exit 2
            load_waiter
            alive=dead
            if waiter_alive; then alive=alive; fi
            printf '%s %s %s %s waiter=%s %s\n' "$age" "$name" "$msg_id" "$msg_from" "$alive" "$msg_subject"
        ) 9>"$box/.lock"
    done < <(find "$post" -type f -path '*/new/*.md' -print0 | sort -z)
}

list_waiters() {
    (($# == 0)) || usage
    [[ -d $post ]] || return 0
    local box name alive code=0
    {
        for box in "$post"/*; do
            [[ -d $box ]] || continue
            name=${box##*/}
            name=${name//+/\/}
            valid_name "$name" || continue
            (
                flock -x 9 || exit 2
                [[ -f $box/waiter ]] || exit 0
                load_waiter
                if [[ ! $wait_pid =~ ^[1-9][0-9]*$ || ! $wait_start =~ ^[0-9]+$ ||
                      ! $wait_kind =~ ^(claude|codex)$ || $wait_session == *[[:space:][:cntrl:]]* ]]; then
                    echo "post: invalid waiter for $name" >&2; exit 2
                fi
                alive=dead
                if waiter_alive; then alive=alive; fi
                printf '%s %s %s %s\n' "$name" "$wait_pid" "$alive" "$wait_session"
            ) 9>"$box/.lock" || code=2
        done
        return "$code"
    } | LC_ALL=C sort
}

# Select under the mailbox lock, then let wake take its own locks and recheck.
wake_existing() (
    local name=$1 older=${2:-} now=${3:-} message age found=0 status code=0
    local box=$post/${name//\//+}
    if [[ ! -d $box/new ]]; then
        [[ -n $older ]] || echo "$name no mail"
        return 0
    fi
    {
        flock -x 9 || fail 'cannot lock mailbox'
        for message in "$box/new/"*.md; do
            [[ -f $message ]] || continue
            if [[ -n $older ]]; then
                age=$(((now - $(stat -c %Y "$message")) / 60))
                ((age >= older && age < wake_window_minutes)) || continue
            fi
            found=1
            break
        done
        if (( ! found )); then
            [[ -n $older ]] || echo "$name no mail"
            return 0
        fi
        if [[ -n $older ]]; then
            load_waiter
            if waiter_alive; then return 0; fi
        fi
    } 9>"$box/.lock" || fail 'cannot lock mailbox'
    status=$(wake "$name") || code=$?
    [[ -z $status ]] || printf '%s %s\n' "$name" "$status"
    return "$code"
)
wake_mail() {
    local older name now code=0 result=0
    if [[ $# == 1 && $1 != --older ]]; then
        valid_name "$1" || usage
        wake_existing "$1"
        return $?
    fi
    [[ $# == 2 && $1 == --older && $2 =~ ^[0-9]+$ ]] || usage
    older=$((10#$2))
    [[ -d $post ]] || return 0
    now=$(date +%s)
    while IFS= read -r -d '' name; do
        valid_name "$name" || continue
        [[ $name != user ]] || continue
        code=0
        wake_existing "$name" "$older" "$now" || code=$?
        case $code in
            2) result=2 ;;
            3) ((result == 2)) || result=3 ;;
        esac
    done < <(find "$post" -mindepth 1 -maxdepth 1 -type d -printf '%f\0' | tr '+' '/' | sort -z)
    return "$result"
}

(($#)) || usage
command=$1
shift
error_prefix=''
case $command in send|deliver) error_prefix='not delivered: ' ;; esac
case $command in
    send) send "$@" ;;
    deliver) deliver "$@" ;;
    wait) wait_mail "$@" ;;
    read) read_mail "$@" ;;
    list) list_mail "$@" ;;
    waiters) list_waiters "$@" ;;
    wake) wake_mail "$@" ;;
    *) usage ;;
esac
