#!/usr/bin/env python3
"""Prove legacy fast-forward inertness and stable release isolation in disposable clones."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess

os.umask(0o077)
KIT = Path(__file__).resolve().parent
TOP = KIT.parents[2]


def run(args, cwd, env, check=True):
    result = subprocess.run([str(x) for x in args], cwd=cwd, env=env,
                            stdin=subprocess.DEVNULL, capture_output=True, text=True)
    if check and result.returncode:
        raise AssertionError((args, result.stdout, result.stderr))
    return result


def hashes(root):
    return {str(path.relative_to(root)): hashlib.sha256(path.read_bytes()).hexdigest()
            for path in sorted(root.rglob('*')) if path.is_file()}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--evidence', type=Path, required=True)
    root = parser.parse_args().evidence.resolve()
    root.mkdir(parents=True, exist_ok=False)
    home = root / 'home'
    home.mkdir()
    env = dict(os.environ, HOME=str(home), GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM='1')
    env.pop('SKEIN_GATE_POLICY_HELPER', None)
    primary = root / 'agents'
    primary.mkdir()
    # Snapshot the moved primary kit, without real repository state/config.
    # The pre-extraction baseline commit is not in agents' filtered history.
    shutil.copytree(TOP / 'scripts/devel', primary / 'scripts/devel',
                    ignore=shutil.ignore_patterns('recovery-v1', '__pycache__'))
    shutil.copytree(TOP / 'scripts/infra', primary / 'scripts/infra')
    shutil.copy2(TOP / 'scripts/check.sh', primary / 'scripts/check.sh')
    run(['git', 'init', '-qb', 'main'], primary, env)
    run(['git', 'config', 'user.name', 'fixture'], primary, env)
    run(['git', 'config', 'user.email', 'fixture@localhost'], primary, env)
    run(['git', 'add', '.'], primary, env)
    run(['git', 'commit', '-qm', 'primary kit snapshot'], primary, env)
    baseline = run(['git', 'rev-parse', 'HEAD'], primary, env).stdout.strip()
    old = hashes(primary / 'scripts')
    bin = home / '.local/bin'
    bin.mkdir(parents=True)
    primary_links = {name: primary / 'scripts' / ('infra' if name == 'setup' else 'devel') / name
                     for name in ('heavy', 'land', 'setup')}
    for name, target in primary_links.items():
        (bin / name).symlink_to(target)
    linked_before = {name: hashlib.sha256((bin / name).read_bytes()).hexdigest()
                     for name in ('heavy', 'land', 'setup')}
    behavior_before = run([bin / 'setup', '--invalid'], primary, env, check=False)
    assert behavior_before.returncode == 2
    # A separate disposable clone supplies the candidate fast-forward.
    candidate = root / 'candidate'
    run(['git', 'clone', '-q', '--no-local', primary, candidate], root, env)
    run(['git', 'config', 'user.name', 'fixture'], candidate, env)
    run(['git', 'config', 'user.email', 'fixture@localhost'], candidate, env)
    shutil.copytree(KIT, candidate / 'scripts/devel/recovery-v1',
                    ignore=shutil.ignore_patterns('__pycache__'))
    run(['git', 'add', '.'], candidate, env)
    run(['git', 'commit', '-qm', 'inert recovery kit'], candidate, env)
    commit = run(['git', 'rev-parse', 'HEAD'], candidate, env).stdout.strip()
    run(['git', 'fetch', '-q', candidate, 'main'], primary, env)
    run(['git', 'merge', '-q', '--ff-only', 'FETCH_HEAD'], primary, env)
    assert all(hashlib.sha256((primary / 'scripts' / name).read_bytes()).hexdigest() == digest
               for name, digest in old.items()), 'primary tools/companions changed on fast-forward'
    linked_after = {name: hashlib.sha256((bin / name).read_bytes()).hexdigest()
                    for name in linked_before}
    assert linked_before == linked_after
    behavior_after = run([bin / 'setup', '--invalid'], primary, env, check=False)
    assert (behavior_before.returncode, behavior_before.stdout, behavior_before.stderr) == (
        behavior_after.returncode, behavior_after.stdout, behavior_after.stderr)
    mutable = primary / 'scripts/devel/recovery-v1'
    refusal = run([mutable / 'setup', '--fix'], primary, env, check=False)
    assert refusal.returncode == 2 and 'refusing mutable/unverified' in refusal.stderr
    assert all((bin / name).resolve() == primary_links[name] for name in linked_before)
    release = Path(run([mutable / 'install-release'], primary, env).stdout.strip())
    installed_before = hashes(release)
    repeated = run([mutable / 'install-release'], primary, env, check=False)
    assert repeated.returncode == 2 and hashes(release) == installed_before
    run(['python3', '-I', '-B', release / 'stable-release.py'], primary, env)
    # Run only the copied setup, with isolated home/state and inert command stubs.
    stubs = root / 'stubs'
    stubs.mkdir()
    groups = json.dumps({'build': {'parallel_tasks': 2, 'status': 'Running'},
                         'gate': {'parallel_tasks': 1, 'status': 'Running'}})
    for name, body in {
        'pueue': '#!/bin/sh\necho \'' + groups + "'\n",
        'systemctl': '#!/bin/sh\nexit 1\n',
        'cargo': '#!/bin/sh\nexit 0\n',
        'claude': '#!/bin/sh\nexit 0\n',
        'apt-config': '#!/bin/sh\nexit 0\n',
    }.items():
        path = stubs / name
        path.write_text(body)
        path.chmod(0o700)
    environment = dict(env, PATH=str(stubs) + ':' + os.defpath,
                       DEV_ROOT=str(root), DEV_TMP=str(root / 'tmp'), DEV_REPOS='absent-fixture-repo')
    instructions = {root / name: mutable / 'workspace' / name
                    for name in ('AGENTS.md', 'CLAUDE.md')}
    settings = root / '.claude/settings.json'
    settings.parent.mkdir()
    workspace_links = {**instructions, settings: release / 'workspace/claude-settings.json'}
    # The previous release linked all three files to its own copies.
    for link in workspace_links:
        link.symlink_to(release / 'workspace' / (
            'claude-settings.json' if link == settings else link.name))
    checked = run([release / 'setup'], primary, environment, check=False)
    (root / 'old-workspace-links.txt').write_text(checked.stdout + checked.stderr)
    for link, target in instructions.items():
        expected = f'FAIL  {link} does not link to {target} (--fix links it)'
        assert expected in checked.stdout, checked.stdout + checked.stderr
    assert f"ok    {settings} is agents'" in checked.stdout, checked.stdout + checked.stderr
    fixed = run([release / 'setup', '--fix'], primary, environment, check=False)
    (root / 'stable-setup.txt').write_text(fixed.stdout + fixed.stderr)
    assert all((bin / name).resolve() == release / name for name in linked_before), fixed.stdout + fixed.stderr
    assert all(link.readlink() == target for link, target in workspace_links.items()), fixed.stdout + fixed.stderr
    checked = run([release / 'setup'], primary, environment, check=False)
    (root / 'checkout-workspace-links.txt').write_text(checked.stdout + checked.stderr)
    assert all(f"ok    {link} is agents'" in checked.stdout for link in workspace_links), checked.stdout + checked.stderr
    # Settings must reject the checkout copy and return to the read-only kit.
    settings.unlink()
    settings.symlink_to(mutable / 'workspace/claude-settings.json')
    checked = run([release / 'setup'], primary, environment, check=False)
    assert f'FAIL  {settings} does not link to {workspace_links[settings]}' in checked.stdout, checked.stdout + checked.stderr
    run([release / 'setup', '--fix'], primary, environment, check=False)
    assert settings.readlink() == workspace_links[settings]
    # A missing checkout file fails in both modes: with no link, an old kit
    # link, or a dangling checkout link. Every existing link is preserved.
    for link, target in instructions.items():
        saved = target.with_suffix('.saved')
        target.rename(saved)
        for args in ([], ['--fix']):
            for existing in (None, release / 'workspace' / link.name, target):
                if link.is_symlink():
                    link.unlink()
                if existing is not None:
                    link.symlink_to(existing)
                missing = run([release / 'setup', *args], primary, environment, check=False)
                assert missing.returncode == 1 and f'FAIL  missing workspace file: {target}' in missing.stdout, missing.stdout + missing.stderr
                assert (link.readlink() if link.is_symlink() else None) == existing
                assert not link.exists() if existing is None else link.is_symlink()
        saved.rename(target)
        link.unlink()
        link.symlink_to(target)
    stable_links = {name: str((bin / name).resolve()) for name in linked_before}
    # Future primary updates may change every new runtime/helper; stable links stay fixed.
    for path in mutable.rglob('*'):
        if path.is_file() and '__pycache__' not in path.parts:
            path.write_bytes(path.read_bytes() + b'\n# disposable later release\n')
    run(['git', 'add', '.'], primary, env)
    run(['git', 'commit', '-qm', 'advance disposable primary'], primary, env)
    assert hashes(release) == installed_before
    refused_after = run([mutable / 'setup', '--fix'], primary, environment, check=False)
    assert refused_after.returncode == 2 and 'refusing mutable/unverified' in refused_after.stderr
    run([release / 'setup', '--fix'], primary, environment, check=False)
    assert hashes(release) == installed_before
    assert all(str((bin / name).resolve()) == target for name, target in stable_links.items())
    assert all(hashlib.sha256((bin / name).read_bytes()).hexdigest() == installed_before[name]
               for name in stable_links)
    assert all(link.readlink() == target for link, target in workspace_links.items())
    proof = {'baseline_source': 'working-tree primary kit', 'fixture_baseline': baseline, 'fixture_candidate': commit,
             'legacy_exact_hashes': old, 'legacy_symlink_before': linked_before,
             'legacy_symlink_after_ff': linked_after, 'legacy_setup_behavior_identical': True,
             'mutable_setup_refused_before_link_changes': True, 'stable_release': str(release),
             'stable_hashes': installed_before, 'stable_links': stable_links,
             'existing_release_overwrite_refused': True, 'stable_setup_tools_link_only_to_release': True,
             'workspace_links': {str(link): str(target) for link, target in workspace_links.items()},
             'workspace_instructions_follow_checkout': True, 'settings_stay_in_read_only_kit': True,
             'missing_checkout_files_refused_without_link_changes': True,
             'advancing_primary_changes_no_installed_bytes': True,
             'no_global_setup_or_install': True}
    (root / 'proof.json').write_text(json.dumps(proof, indent=2) + '\n')
    print('PASS legacy hash/fast-forward behavior and immutable stable kit; ' + str(root / 'proof.json'))


if __name__ == '__main__':
    main()
