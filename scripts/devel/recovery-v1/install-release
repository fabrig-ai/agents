#!/usr/bin/env python3
"""Copy a committed recovery kit to a new stable release; never switch links."""
import hashlib
import io
import json
import os
from pathlib import Path
import subprocess
import sys
import tarfile

os.umask(0o077)
source = Path(__file__).resolve().parent
prefix = 'scripts/dev/recovery-v1/'


def main():
    if len(sys.argv) != 1:
        raise ValueError('usage: install-release (copies HEAD; does not install links or services)')
    top = subprocess.check_output(['git', '-C', str(source), 'rev-parse', '--show-toplevel'], text=True).strip()
    if source != Path(top) / prefix.rstrip('/'):
        raise ValueError('run the committed source kit installer from its checkout')
    if subprocess.check_output(['git', '-C', top, 'status', '--porcelain', '--', prefix]):
        raise ValueError('commit the kit before copying its release')
    commit = subprocess.check_output(['git', '-C', top, 'rev-parse', 'HEAD'], text=True).strip()
    destination = Path.home() / '.local/share/skein-kits' / ('recovery-v1-' + commit)
    # Refuse any destination below a Git checkout, including a linked worktree.
    for parent in [destination, *destination.parents]:
        if (parent / '.git').exists():
            raise ValueError('the stable release must be outside checkouts and worktrees')
    archive = subprocess.check_output(['git', '-C', top, 'archive', commit, prefix])
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.parent.resolve() != destination.parent:
        raise ValueError('the stable release parent must not resolve through symlinks')
    destination.mkdir(mode=0o700)  # An existing release is never overwritten.
    manifest = {}
    with tarfile.open(fileobj=io.BytesIO(archive)) as files:
        for member in files:
            if not member.isfile():
                if member.isdir():
                    continue
                raise ValueError('release assets must be regular files')
            relative = Path(member.name).relative_to(prefix)
            if '..' in relative.parts:
                raise ValueError('invalid release asset path')
            data = files.extractfile(member).read()
            target = destination / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            with target.open('xb') as output:
                output.write(data)
            target.chmod(0o500 if member.mode & 0o111 else 0o400)
            manifest[str(relative)] = hashlib.sha256(data).hexdigest()
    marker = destination / 'release.json'
    marker.write_text(json.dumps({'schema': 'skein-recovery-release-v1', 'commit': commit,
                                  'files': manifest}, sort_keys=True) + '\n')
    marker.chmod(0o400)
    for directory in sorted(destination.rglob('*'), reverse=True):
        if directory.is_dir():
            directory.chmod(0o500)
    destination.chmod(0o500)
    print(destination)


try:
    main()
except (OSError, ValueError, subprocess.SubprocessError) as error:
    print('install-release: ' + str(error), file=sys.stderr)
    sys.exit(2)
