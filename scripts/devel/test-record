def closing_clean(lab):
    paths = ending(lab, committed=True)
    worktree = mission_worktree(lab)
    # Fetch must discover this published branch, absent from a's refs.
    (worktree / 'STATUS.md').write_text('published\n')
    lab.git(worktree, 'commit', '-am', 'published mission work')
    lab.git(worktree, 'push', 'origin', 'HEAD:mission-published')
    (worktree / '.gitignore').write_text('/target/\n')
    lab.git(worktree, 'add', '.gitignore')
    lab.git(worktree, 'commit', '-m', 'ignore build output')
    lab.git(worktree, 'push', 'origin', 'HEAD:mission-published')
    (worktree / 'target').mkdir()
    (worktree / 'target/build').touch()
    calls = lab.root / 'tidy.args'
    stub = lab.root / 'tidy stub'
    stub.write_text('#!/bin/sh\nprintf "%s\\n" "$@" > ' + shlex.quote(str(calls)) + '\n')
    stub.chmod(0o700)
    lab.run('commit', *paths, extra=dict(RECORD_TIDY=shlex.quote(str(stub))))
    deadline = time.monotonic() + 5
    while not calls.exists() or not calls.read_text().endswith('demo\n'):
        assert time.monotonic() < deadline, 'tidy never started'
        time.sleep(.01)
    assert calls.read_text() == '--mission\ndemo\n'
    assert lab.git(lab.a, 'show', 'HEAD:missions/demo/closing.md').startswith('# Closing')


def closing_abandoned(lab):
    paths = ending(lab, state='abandoned')
    output = lab.run('commit', *paths, extra=dict(RECORD_TIDY='/missing-fixture-tidy'))
    assert 'warning: cannot start tidy' not in output, output
    assert 'pushed' in output, output
    log = lab.tmp / 'logs/tidy.log'
    deadline = time.monotonic() + 5
    while not log.exists() or 'No such file or directory' not in log.read_text():
        assert time.monotonic() < deadline, 'missing override did not log its failure'
        time.sleep(.01)
    assert '/missing-fixture-tidy' in log.read_text()


def closing_active(lab):
    paths = ending(lab, committed=True, state='active')
    # The unselected working README must not end the committed mission.
    lab.put('missions/demo/README.md', front().replace('state: unknown', 'state: ended'))
    worktree = mission_worktree(lab)
    (worktree / 'untracked').touch()
    lab.run('commit', *paths, extra=dict(RECORD_TIDY='/missing-fixture-tidy'))


def writer(lab):
    lab.put('missions/first/README.md', front())
    assert 'pushed' in lab.run('commit', '-m', 'brief', 'missions/first/README.md')
    assert lab.git(lab.origin, 'log', '-1', '--format=%s') == 'o/fixture: brief'
    lab.run('commit', 'missions/first/README.md')
    # Optional description: exactly 65 characters commits, including Unicode.
    described = front().replace('state: unknown', 'state: active\ndescription: ' + 'é' * 65)
    lab.put('missions/described/README.md', described)
    assert 'pushed' in lab.run('commit', 'missions/described/README.md')
    assert lab.git(lab.origin, 'show', 'main:missions/described/README.md') == described.strip()
    assert 'description:' not in lab.git(lab.origin, 'show', 'main:missions/first/README.md')
    # Public waits accept minute/second UTC, unknown, Unicode and both decisions.
    waits = ('# Waiting on the user\n\n'
             '- 2026-10-24T20:00Z · director · Read <b>the proposal · 1099\n'
             '- unknown · web-look_6 · ' + 'é' * 160 + ' · R3-12\n')
    lab.put('director/waiting.md', waits)
    assert 'pushed' in lab.run('commit', 'director/waiting.md')
    assert lab.git(lab.origin, 'show', 'main:director/waiting.md') == waits.strip()
    waits = '# Waiting on the user\n' + '- 2026-10-24T20:00:01Z · m · Answer · 1\n' * 40
    lab.put('director/waiting.md', waits)
    assert 'pushed' in lab.run('commit', 'director/waiting.md')
    assert lab.git(lab.origin, 'show', 'main:director/waiting.md') == waits.strip()
    # An unrelated staged version and its later unstaged edit both survive.
    lab.put('director/backlog.md', 'staged\n')
    lab.git(lab.a, 'add', 'director/backlog.md')
    lab.put('director/backlog.md', 'unstaged\n')
    lab.put('STATUS.md', 'first\n')
    lab.run('commit', 'STATUS.md')
    assert lab.git(lab.a, 'show', ':director/backlog.md') == 'staged'
    assert (lab.a / 'director/backlog.md').read_text() == 'unstaged\n'
    assert lab.git(lab.origin, 'show', 'main:director/backlog.md') == 'base backlog'
    lab.run('pull', machine=lab.b)
    lab.put('director/backlog.md', 'remote\n', lab.b)
    lab.put('director/direction.md', 'remote direction\n', lab.b)
    lab.run('commit', 'director/backlog.md', 'director/direction.md', machine=lab.b)
    lab.run('pull')
    assert lab.git(lab.a, 'show', ':director/backlog.md') == 'staged'
    assert (lab.a / 'director/backlog.md').read_text() == 'unstaged\n'
    assert (lab.a / 'director/direction.md').read_text() == 'remote direction\n'
    # USER is used when POST_NAME is absent.
    lab.put('STATUS.md', 'user fallback\n')
    lab.run('commit', 'STATUS.md', extra={'POST_NAME': ''})
    assert lab.git(lab.origin, 'log', '-1', '--format=%s').startswith('fixture:')
    # A message that already names its writer is not prefixed twice.
    lab.put('STATUS.md', 'named writer\n')
    lab.run('commit', '-m', 'o/fixture: did y', 'STATUS.md')
    assert lab.git(lab.origin, 'log', '-1', '--format=%s') == 'o/fixture: did y'
    lab.put('STATUS.md', 'other writer\n')
    lab.run('commit', '-m', 'o/other: did z', 'STATUS.md')
    assert lab.git(lab.origin, 'log', '-1', '--format=%s') == 'o/fixture: o/other: did z'


def mission_progress(lab):
    # Missions since 10-26 need no department; older briefs remain valid.
    name = 'missions/current/README.md'
    lab.put(name, front().replace('department: unknown\n', ''))
    assert 'pushed' in lab.run('commit', name)
    assert 'department:' not in lab.git(lab.origin, 'show', 'main:' + name)
    # The new file has the same 16 KiB cap as the older mission notes.
    name = 'missions/current/progress.md'
    content = 'x' * (16 * 1024)
    lab.put(name, content)
    assert 'pushed' in lab.run('commit', name)
    assert lab.git(lab.origin, 'show', 'main:' + name) == content
    old = lab.git(lab.a, 'rev-parse', 'HEAD')
    lab.put(name, content + 'x')
    assert name + ': cap exceeded' in lab.run('commit', name, status=2)
    assert lab.git(lab.a, 'rev-parse', 'HEAD') == old
    assert lab.git(lab.origin, 'show', 'main:' + name) == content


def refusals(lab):
    cases = [('elsewhere.md', 'wrong', 'place'),
             ('director/decisions/0001Xmd', 'wrong', 'place'),
             ('missions/x/README.md', 'no front matter', 'front matter'),
             ('STATUS.md', 'x' * 16385, 'cap'),
             ('missions/x/README.md', front().replace('state: unknown',
              'state: active\ndescription: ' + 'x' * 66), 'front matter description exceeds 65 characters'),
             ('missions/x/README.md', front() + ' '.join(['word'] * 61), 'summary'),
             ('director/decisions/0001.md', '\n'.join(f'## {i}. call' for i in range(101)), '100 decisions'),
             ('missions/x/README.md', front().replace('started: unknown', 'started: yesterday'), 'UTC')]
    heading = '# Waiting on the user\n\n'
    item = '- unknown · director · Answer · 1099\n'
    waits = [('', 'heading missing'),
             ('\n' + heading, 'heading missing'),
             (heading + 'PRIVATE-NOT-AN-ITEM\n', 'line 3 is not an item'),
             (heading + item.replace('Answer', 'é' * 161), 'line 3: what exceeds 160 characters'),
             (heading + item.replace('unknown', '2026-02-30T20:00Z'), 'line 3: since is not a time'),
             (heading + item.replace('unknown', 'yesterday'), 'line 3: since is not a time'),
             (heading + item * 41, 'more than 40 items'),
             (heading + '\n' * 8192, 'cap exceeded')]
    for old, new in [('director', 'Director'), ('1099', 'R3-x'), ('Answer', ''),
                     ('Answer', 'a/b'), ('Answer', 'a · b'), (' · ', ' | ')]:
        waits.append((heading + item.replace(old, new), 'line 3 is not an item'))
    waits.append((heading + item.replace('Answer', 'sk-' + 'A' * 20), 'secret refused'))
    cases += [('director/waiting.md', content, 'director/waiting.md: ' + reason)
              for content, reason in waits]
    cases.append(('director/other.md', 'wrong', 'place'))
    secrets = ['-----BEGIN RSA PRIVATE KEY-----', *[prefix + 'A' * 20 for prefix in ('ghp_', 'gho_', 'ghu_', 'ghs_', 'ghr_', 'github_pat_')], 'sk-' + 'A' * 20, 'xoxb-fake', 'xoxa-fake', 'xoxp-fake', 'xoxr-fake', 'AKIA' + 'A' * 16]
    cases += [('STATUS.md', secret, 'secret') for secret in secrets]
    for name, content, reason in cases:
        path = lab.put(name, content)
        old = lab.git(lab.a, 'rev-parse', 'HEAD')
        assert reason in lab.run('commit', name, status=2)
        assert lab.git(lab.a, 'rev-parse', 'HEAD') == old
        path.unlink()
    # Path traversal, symlinks and deletions are refused.
    assert 'place' in lab.run('commit', '../escape.md', status=2)
    outside = lab.root / 'outside'
    outside.write_text('outside')
    (lab.a / 'STATUS.md').symlink_to(outside)
    assert 'symlink' in lab.run('commit', 'STATUS.md', status=2)
    (lab.a / 'STATUS.md').unlink()
    assert 'missing' in lab.run('commit', 'STATUS.md', status=2)
    lab.put('STATUS.md', 'tmp/github-conformance/ is a valid reference\n')
    lab.run('commit', 'STATUS.md')
    validate = runpy.run_path(str(SCRIPT))['validate']
    for prefix in ('sk-', 'ghp_', 'gho_', 'ghu_', 'ghs_', 'ghr_', 'github_pat_'):
        for before in ('task-fake-llm-port-', 'word', '9', '_', '-', 'é'):
            validate('STATUS.md', (before + prefix + 'A' * 30).encode())
        lab.put('STATUS.md', '(' + prefix + 'A' * 20)
        assert 'secret' in lab.run('commit', 'STATUS.md', status=2)
    lab.put('director/decisions/0001.md', '## 1067 task-fake-llm-port-sk-' + 'a' * 25 + '\n')
    lab.run('commit', 'director/decisions/0001.md')
    for prefix in ('ghp_', 'gho_', 'ghu_', 'ghs_', 'ghr_', 'github_pat_', 'sk-'):
        validate('STATUS.md', (prefix + 'A' * 19).encode())
    # Mission total and Runs section caps.
    paths = []
    for number in range(17):
        name = f'missions/large/m{number + 1}.md'
        lab.put(name, front(True) + 'x' * 7900)
        paths.append(name)
    assert 'mission total' in lab.run('commit', *paths, status=2)
    lab.put('missions/x/m1.md', front(True) + '\n## Runs\n' + 'a' * 4097)
    assert 'Runs table' in lab.run('commit', 'missions/x/m1.md', status=2)
    for prefix in ('1067', 'R3-12', '12.'):
        lab.put('missions/x/decisions.md', ('## ' + prefix + ' decision\n') * 101)
        assert '100 decisions' in lab.run('commit', 'missions/x/decisions.md', status=2)


def different_files(lab):
    lab.put('director/direction.md', 'other machine\n', lab.b)
    lab.put('STATUS.md', 'this machine\n')
    pause = lab.root / 'pause'
    with (lab.root / 'log').open('w') as output:
        process = subprocess.Popen([sys.executable, '-I', str(SCRIPT), 'commit', 'STATUS.md'],
                                   env=dict(lab.env, RECORDS=str(lab.a), PAUSE_PUSH=str(pause),
                                            PATH=str(lab.pause_bin) + ':' + lab.env['PATH']),
                                   stdout=output, stderr=output)
        try:
            until = time.monotonic() + 15
            while not pause.exists():
                assert process.poll() is None and time.monotonic() < until
                time.sleep(.02)
            lab.run('commit', 'director/direction.md', machine=lab.b)
            pause.with_suffix('.release').touch()
            assert process.wait(timeout=20) == 0, (lab.root / 'log').read_text()
        finally:
            pause.with_suffix('.release').touch()
            if process.poll() is None:
                process.kill()
                process.wait()
    assert lab.git(lab.origin, 'show', 'main:STATUS.md') == 'this machine'
    assert (lab.a / 'director/direction.md').read_text() == 'other machine\n'


def name_race(lab):
    old = lab.git(lab.a, 'rev-parse', 'HEAD')
    assert 'name taken' in lab.race('missions/same/README.md', front() + '\nFirst.', front() + '\nSecond.', status=2)
