    shutil.rmtree(lab.tmp / 'heavy/receipts')
    assert '\tunknown\t' in lab.run('runs', '--all')
    # Modern mission's own sessions go in its README.
    lab.put('missions/demo/README.md', front())
    jl(lab.home / '.codex/sessions/date/rollout-owner.jsonl', rollout(str(lab.tmp / 'owners/demo/codex'), 'owner'))
    lab.run('runs', 'demo')
    assert '| Codex | model-as-run | high | 1 |' in (lab.a / 'missions/demo/README.md').read_text()

    # Arbitrary tilde text in a first prompt must not invoke user lookup.
    jl(lab.home / '.claude/projects/fake/unrelated.jsonl', [dict(type='user', message=dict(content='~not-a-user/path'))])
    # The mission may start with m2; mission-level work still stays in README.
    (lab.tmp / 'owners/second/m2').mkdir(parents=True)
    jl(lab.home / '.codex/sessions/date/rollout-second.jsonl', rollout(str(lab.tmp / 'owners/second/codex'), 'second'))
    append_heavy(str(lab.tmp / 'owners/second/codex'))
    assert 'second\t\t' in lab.run('runs', '--all')
    # More rows than fit: keep the largest and report an omission count.
    for i in range(60):
        extra_cwd = str(lab.tmp / f'owners/demo/m1/extra-{i}')
        fake = rollout(extra_cwd, f'extra-{i}')
        append_heavy(extra_cwd)
        jl(lab.home / f'.codex/sessions/date/rollout-extra-{i}.jsonl', fake)
    lab.run('runs', 'demo', '1')
    text = (lab.a / 'missions/demo/m1.md').read_text()
    assert 'rows left out' in text
    assert len(text.split('## Runs\n', 1)[1].split('## End', 1)[0].encode()) <= 4096
    assert 'Implementers: 61 runs, 72 commands' in text
    assert '| Codex | model-as-run | high | 61 |' in text
    assert '| m1/wt/task | 12 |' in text
    assert 'wall s' not in text and cwd not in text
    # New receipts distinguish inputs and commits, also for bundled commands.
    bundled = 'cargo fmt && cargo clippy && cargo nextest run --workspace'
    commands = [bundled, bundled, bundled, bundled, 'cargo clippy', 'cargo clippy', 'cargo clippy']
    # Different input trees under the same HEAD; same inputs across different HEADs.
    inputs = ['a', 'a', 'b', 'a', 'b', 'b', 'b']
    heads = ['h1', 'h1', 'h1', 'h2', 'h2', 'h3', 'h3']
    rows = []
    for i, (command, tree, head) in enumerate(zip(commands, inputs, heads)):
        log = str(lab.tmp / f'logs/new-{i}.log')
        rows.append([i, 'build', f'2026-10-24T01:{i:02}:00Z', 10, 20, 0, 8, cwd, log, command, 'label'])
        jl(lab.tmp / f'heavy/receipts/new-{i}.json', [dict(log=log, inputs=tree, head=head, tree='misleading-head-tree')])
    with path.open('w') as source:
        csv.writer(source, delimiter='\t').writerows(rows)
    output = lab.run('runs', '--all')
    assert 'clippy=3/60/30,workspace=4/80/40' in output, output
    assert '\t4\tclippy without commit ×4; fmt through heavy ×4' in output, output
    lab.run('runs', 'demo', '1')
    text = (lab.a / 'missions/demo/m1.md').read_text()
    assert '| m1/wt/task | 7 | 2.3 | 1.2 |  |  | 4 / 1.3 | 3 / 1.0 |  |  | 4 |' in text
    assert 'workspace 4' in text and 'fmt 4 (' not in text
    assert 'repeats 4 (0.0 h)' in text
    # Mixed legacy build receipts leave the repeat total unknown, but keep facts.
    jl(lab.tmp / 'heavy/receipts/new-0.json', [dict(log=rows[0][8], tree='a')])
    output = lab.run('runs', '--all')
    assert '\tunknown\t' in output and 'clippy without commit ×3' in output
    # A missing heavy source retains unknowns, rather than claiming no work.
    path.unlink()
    assert '\tunknown\tunknown\tunknown\t' in lab.run('runs', '--all')
    # A heading at EOF is replaced, rather than duplicated.
    lab.put('missions/demo/m2.md', front(True) + '\n## Runs')
    lab.run('runs', 'demo', '2')
    assert (lab.a / 'missions/demo/m2.md').read_text().count('## Runs') == 1


def main():
    # The cases share nothing (each has its own Lab, and every subprocess its
    # own env), so they run at once on threads; results print in case order.
    cases = (writer, refusals, different_files, name_race, conflict, offline, merged_validation, installation_failures, setup, telemetry)
    with tempfile.TemporaryDirectory(prefix='record-fixture-') as directory:
        def run(number, case):
            root = Path(directory) / str(number)
            root.mkdir()
            case(Lab(root))
        with ThreadPoolExecutor(max_workers=len(cases)) as pool:
            futures = [pool.submit(run, number, case) for number, case in enumerate(cases)]
            failed = 0
            for number, (case, future) in enumerate(zip(cases, futures)):
                error = future.exception()
                if error is None:
                    print(f'ok {number + 1}: {case.__name__}', flush=True)
                else:
                    failed += 1
                    print(f'FAIL {number + 1}: {case.__name__}', flush=True)
                    traceback.print_exception(error)
    if failed:
        sys.exit(f'{failed} of {len(cases)} isolated cases failed')
    print(f'completed {len(cases)} isolated cases')


if __name__ == '__main__':
    main()
