def offline(lab):
    hidden = lab.origin.with_name('hidden.git')
    lab.origin.rename(hidden)
    assert 'nothing to commit' in lab.run('commit', 'STATUS.md')
    lab.put('STATUS.md', 'offline\n')
    lab.run('commit', 'STATUS.md', status=3)
    assert lab.git(lab.a, 'show', 'HEAD:STATUS.md') == 'offline'
    hidden.rename(lab.origin)
    lab.put('director/direction.md', 'back online\n')
    lab.run('commit', 'director/direction.md')
    assert lab.git(lab.origin, 'show', 'main:STATUS.md') == 'offline'
    # Failed push, successful fetch: pending commit is retained and retried later.
    hook = lab.origin / 'hooks/pre-receive'
    hook.write_text('#!/bin/sh\nexit 1\n')
    hook.chmod(0o700)
    lab.put('STATUS.md', 'push unavailable\n')
    lab.run('commit', 'STATUS.md', status=3)
    hook.unlink()
    lab.run('commit', 'STATUS.md')
    assert lab.git(lab.origin, 'show', 'main:STATUS.md') == 'push unavailable'


def merged_validation(lab):
    base = 'start\n' + 'middle\n' * 10 + 'end\n'
    lab.put('STATUS.md', base)
    lab.run('commit', 'STATUS.md')
    lab.run('pull', machine=lab.b)
    old = lab.git(lab.a, 'rev-parse', 'HEAD')
    # Both sides fit, but their clean merge exceeds the cap.
    lab.put('STATUS.md', 'a' * 9000 + '\n' + base)
    lab.put('STATUS.md', base + 'b' * 9000 + '\n', lab.b)
    lab.run('commit', 'STATUS.md', machine=lab.b)
    remote = lab.git(lab.origin, 'rev-parse', 'main')
    assert 'cap' in lab.run('commit', 'STATUS.md', status=2)
    assert lab.git(lab.a, 'rev-parse', 'HEAD') == old
    assert lab.git(lab.origin, 'rev-parse', 'main') == remote
    # A valid clean merge also brings the selected working file up to date.
    lab.put('STATUS.md', 'first\n' + base)
    lab.run('commit', 'STATUS.md')
    assert (lab.a / 'STATUS.md').read_text() == 'first\n' + base + 'b' * 9000 + '\n'
    assert not lab.git(lab.a, 'status', '--porcelain')


def installation_failures(lab):
    lab.put('STATUS.md', 'named\n')
    old = lab.git(lab.origin, 'rev-parse', 'main')
    oid = lab.git(lab.a, 'rev-parse', 'HEAD:director/backlog.md')
    # Unmerged unrelated files are refused before any push.
    subprocess.run([REAL_GIT, '-C', str(lab.a), 'update-index', '--index-info'],
                   env=lab.env, input=f'0 {"0" * 40}\tdirector/backlog.md\n100644 {oid} 1\tdirector/backlog.md\n100644 {oid} 2\tdirector/backlog.md\n',
                   text=True, check=True)
    assert 'unmerged index' in lab.run('commit', 'STATUS.md', status=2)
    assert lab.git(lab.origin, 'rev-parse', 'main') == old
    assert not (lab.a / '.git/index.lock').exists()
    lab.git(lab.a, 'read-tree', 'HEAD')
    # Failure after acquiring index.lock cleans it and keeps the checkout intact.
    invalid = lab.a / '.git/refs/heads/main.lock'
    invalid.touch()
    lab.run('commit', 'STATUS.md', status=2)
    assert not (lab.a / '.git/index.lock').exists()
    assert lab.git(lab.a, 'rev-parse', 'HEAD') == old
    invalid.unlink()
    lab.run('commit', 'STATUS.md')
    # Local symlinks and untracked collisions survive a pull, including remote updates.
    lab.run('pull', machine=lab.b)
    lab.put('director/direction.md', 'remote\n', lab.b)
    lab.run('commit', 'director/direction.md', machine=lab.b)
    elsewhere = lab.root / 'elsewhere'
    elsewhere.write_text('local\n')
    (lab.a / 'director/direction.md').symlink_to(elsewhere)
    lab.run('pull')
    assert (lab.a / 'director/direction.md').is_symlink()
    assert elsewhere.read_text() == 'local\n'


def setup(lab):
    # Exercise only setup's records check; never its machine/queue checks.
    source = SCRIPT.parent.parent / 'infra/setup'
    kit = lab.root / 'kit/scripts'
    (kit / 'infra').mkdir(parents=True)
    (kit / 'devel').mkdir()
    shutil.copyfile(SCRIPT.with_name('kit.sh'), kit / 'devel/kit.sh')
    text = source.read_text()
    assert 'for tool in heavy land land-set landings after-landing repin record setup post codex-run; do' in text
    check = kit / 'infra/setup'
    check.write_text(text.replace('check "$@"', 'fix=${FIX:-0}; failed=0\nok() { :; }; fail() { echo "$*"; failed=1; }\ncheck_records\nexit "$failed"'))
    wrapper = lab.bin / 'git'
    wrapper.write_text('#!/bin/sh\n'
                       'for arg; do shift\n'
                       ' [ "$arg" = git@github.com:fabrig-ai/records.git ] && arg=$FIXTURE_ORIGIN\n'
                       ' set -- "$@" "$arg"\n'
                       'done\n'
                       'exec ' + shlex.quote(REAL_GIT) + ' "$@"\n')
    wrapper.chmod(0o700)
    env = dict(lab.env, DEV_ROOT=str(lab.root / 'workspace'), FIXTURE_ORIGIN=str(lab.origin))
    (lab.root / 'workspace').mkdir()
    result = subprocess.run(['bash', str(check)], env=env, capture_output=True, text=True)
    assert result.returncode == 1 and '--fix clones' in result.stdout
    assert not (lab.root / 'workspace/records').exists()
    result = subprocess.run(['bash', str(check)], env=dict(env, FIX='1'), capture_output=True, text=True)
    assert result.returncode == 0, result.stderr
    records = lab.root / 'workspace/records'
    assert lab.git(records, 'rev-parse', '--abbrev-ref', 'HEAD') == 'main'
    (records / 'uncommitted').write_text('keep')
    result = subprocess.run(['bash', str(check)], env=env, capture_output=True, text=True)
    assert result.returncode == 0 and (records / 'uncommitted').read_text() == 'keep'


