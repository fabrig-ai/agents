    assert '| codex-run | fallback-model | low | 1 | 0:01 | 0.00 | 25 | 0.00 |' in text
    assert 'turn wait' not in text and '999' not in text

    for value in ('model-as-run', 'claude-as-run', '| 0.00 | 30 | 0.05 |', '| 0.00 | 20 | 0.00 |',
                  'filter without', 'no test selected', 'two at once', 'fmt through heavy',
                  'check.sh through heavy ×1', '| 2 |', '## End\nKept.'):
