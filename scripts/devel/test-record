    landings = text.split('### Landings', 1)[1]
    assert len([line for line in landings.splitlines() if line.startswith('| m4/')]) == 5, landings


def main():
    # The cases share nothing (each has its own Lab, and every subprocess its
    # own env), so they run at once on threads; results print in case order.
    cases = (closing_unpublished, closing_dirty, closing_deleted_remote, closing_fetch_failure, closing_unreadable, closing_nested,
             closing_cached_output, closing_cached_worktree, closing_clean, closing_abandoned, closing_active,
             writer, mission_progress, refusals, different_files, name_race, conflict, offline, merged_validation, installation_failures, setup, mission_runs, telemetry, milestone)
    if len(sys.argv) > 1:
        cases = tuple(case for case in cases if case.__name__ in sys.argv[1:])
        assert cases, 'no cases selected'
    with tempfile.TemporaryDirectory(prefix='record-fixture-') as directory:
        built = Path(directory) / 'baseline'
        built.mkdir()
        Lab(built)
        def run(number, case):
            root = Path(directory) / str(number)
            root.mkdir()
            case(Lab(root, built=built))
        with ThreadPoolExecutor(max_workers=min(len(cases), len(os.sched_getaffinity(0)))) as pool:
            slow = (refusals, writer, offline, installation_failures, merged_validation)
            futures = {case: pool.submit(run, number, case)
                       for number, case in sorted(enumerate(cases), key=lambda item: item[1] not in slow)}
            failed = 0
            for number, case in enumerate(cases):
                error = futures[case].exception()
                if error is None:
                    print(f'ok {number + 1}: {case.__name__}', flush=True)
                else:
                    failed += 1
                    print(f'FAIL {number + 1}: {case.__name__}', flush=True)
                    traceback.print_exception(error)
    if failed:
        sys.exit(f'{failed} of {len(cases)} isolated cases failed')
    print(f'completed {len(cases)} isolated cases')


if __name__ == '__main__':
    main()
