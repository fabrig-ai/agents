def closing_unreadable(lab):
    paths = ending(lab)
    worktree = mission_worktree(lab)
    directory = worktree.parent
    directory.chmod(0)
    try:
        output = lab.run('commit', *paths, status=2)
        assert str(directory) in output and 'cannot inspect mission worktrees' in output, output
    finally:
        directory.chmod(0o700)


def closing_nested(lab):
    paths = ending(lab)
    outer = mission_worktree(lab)
    exclude = Path(lab.git(outer, 'rev-parse', '--git-path', 'info/exclude'))
    with exclude.open('a') as stream:
        stream.write('\n/nested/\n')
    nested = outer / 'nested'
    lab.git(lab.b, 'worktree', 'add', '-b', 'nested-work', str(nested))
    (nested / 'STATUS.md').write_text('unpublished nested work\n')
    lab.git(nested, 'commit', '-am', 'nested work')
    output = lab.run('commit', *paths, status=2)
    assert str(nested) in output and 'commits on no origin branch' in output, output


def closing_cached_output(lab):
    paths = ending(lab)
    worktree = mission_worktree(lab)
    exclude = Path(lab.git(worktree, 'rev-parse', '--git-path', 'info/exclude'))
    with exclude.open('a') as stream:
        stream.write('\n/target/\n')
    caches = (worktree / 'target', lab.tmp / 'owners/demo/other-cargo-output')
    unreadable = []
    try:
        for cache in caches:
            deep = cache / 'debug/build/crate/out/deep'
            deep.mkdir(parents=True)
            (cache / 'CACHEDIR.TAG').write_text('Signature: 8a477f597d28d172789f06886806bc55\n')
            deep.chmod(0)
            unreadable.append(deep)
        lab.run('commit', *paths)
        assert lab.git(lab.a, 'show', 'HEAD:missions/demo/closing.md').startswith('# Closing')
    finally:
        for deep in unreadable:
            deep.chmod(0o700)


def closing_cached_worktree(lab):
    paths = ending(lab)
