# Loading record as a module must leave no __pycache__ in the checkout.
sys.dont_write_bytecode = True

SCRIPT = Path(__file__).resolve().with_name('record')
REAL_GIT = shutil.which('git')


def front(milestone=False):
    keys = ('driver model effort started cap ended' if milestone else
            'roadmap feature department parent owner machine model effort started ended state end').split()
    return '---\n' + ''.join(f'{key}: unknown\n' for key in keys) + '---\n\nSummary.\n'


class Lab:
    def __init__(self, root, built=None):
        if built is not None:
            # Native copying avoids contention between Python copy loops.
            # Mutable refs, indexes and objects are copied, never hardlinked.
            subprocess.run(['cp', '-R', '--preserve=mode,timestamps', '--reflink=auto',
                            '--', str(built) + '/.', str(root)], check=True)
            for name in ('a/.git/config', 'b/.git/config', 'origin.git/config'):
                config = root / name
                config.write_text(config.read_text().replace(str(built), str(root)))
        self.root = root
        self.home = root / 'home'
        self.tmp = root / 'tmp'
        self.bin = root / 'bin'
        for path in (self.home, self.tmp, self.bin):
            path.mkdir(exist_ok=True)
        self.env = dict(PATH=str(self.bin) + ':' + os.environ['PATH'], HOME=str(self.home),
                        DEV_TMP=str(self.tmp), USER='fixture', POST_NAME='o/fixture',
                        RECORD_TIDY='',
                        GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@invalid',
                        GIT_ALLOW_PROTOCOL='file', LC_ALL='C.UTF-8')
        # Preserve command-scope settings while appending fixture-only policy.
        self.env.update({key: value for key, value in os.environ.items()
                         if key == 'GIT_CONFIG_COUNT' or key.startswith(('GIT_CONFIG_KEY_', 'GIT_CONFIG_VALUE_'))})
        count = int(self.env.get('GIT_CONFIG_COUNT', '0'))
        settings = (('maintenance.auto', 'false'), ('gc.auto', '0'),
                    ('fetch.autoMaintenance', 'false'), ('receive.autogc', 'false'))
        for offset, (key, value) in enumerate(settings):
            self.env[f'GIT_CONFIG_KEY_{count + offset}'] = key
            self.env[f'GIT_CONFIG_VALUE_{count + offset}'] = value
        self.env['GIT_CONFIG_COUNT'] = str(count + len(settings))
        # Only racing commands need a wrapper; ordinary Git goes straight through.
        self.pause_bin = root / 'pause-bin'
        self.pause_bin.mkdir(exist_ok=True)
        # Pause one machine immediately before push; the other can win the race.
        wrapper = self.pause_bin / 'git'
        # A shell wrapper: a Python one costs an interpreter start-up per git
        # call. PAUSE_PUSH names a suffixless file; its release is PAUSE_PUSH.release.
        wrapper.write_text('#!/bin/sh\n'
                           'if [ -n "$PAUSE_PUSH" ]; then\n'
                           ' for arg; do [ "$arg" = push ] || continue\n'
                           '  if [ ! -e "$PAUSE_PUSH" ]; then\n'
                           '   : >"$PAUSE_PUSH"; until=$(($(date +%s) + 15))\n'
                           '   while [ ! -e "$PAUSE_PUSH.release" ]; do\n'
                           '    [ "$(date +%s)" -lt "$until" ] || exit 1; sleep .02\n'
                           '   done\n'
                           '  fi; break\n'
                           ' done\n'
                           'fi\n'
                           'exec ' + shlex.quote(REAL_GIT) + ' "$@"\n')
        wrapper.chmod(0o700)
        self.a, self.b, self.origin = (root / name for name in ('a', 'b', 'origin.git'))
        if built is not None:
            return
        self.a.mkdir()
        self.git(self.a, 'init', '-b', 'main')
        self.put('STATUS.md', 'base\n')
        self.put('director/backlog.md', 'base backlog\n')
        self.git(self.a, 'add', '.')
        self.git(self.a, 'commit', '-m', 'baseline')
        self.git(root, 'clone', '--bare', str(self.a), str(self.origin))
        self.git(self.a, 'remote', 'add', 'origin', str(self.origin))
        self.git(self.a, 'fetch', 'origin')
        self.git(root, 'clone', str(self.origin), str(self.b))

    def git(self, root, *args):
        p = subprocess.run([REAL_GIT, '-C', str(root), *args], env=self.env, text=True,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        assert p.returncode == 0, p.stderr
        return p.stdout.strip()

    def put(self, name, text, machine=None):
        path = (machine or self.a) / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)
        return path

    def run(self, *args, machine=None, status=0, extra=None):
        env = dict(self.env, RECORDS=str(machine or self.a), **(extra or {}))
        p = subprocess.run([sys.executable, '-I', str(SCRIPT), *args], env=env, text=True,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=30)
        assert p.returncode == status, (args, p.returncode, p.stdout, p.stderr)
        return p.stdout + p.stderr

    def race(self, name, first, second, status=0):
        self.put(name, first)
        self.put(name, second, self.b)
        pause = self.root / 'pause'
        env = dict(self.env, RECORDS=str(self.a), PAUSE_PUSH=str(pause),
                   PATH=str(self.pause_bin) + ':' + self.env['PATH'])
        process = subprocess.Popen([sys.executable, '-I', str(SCRIPT), 'commit', name], env=env,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        try:
            until = time.monotonic() + 15
            while not pause.exists():
                assert process.poll() is None and time.monotonic() < until
                time.sleep(.02)
            self.run('commit', name, machine=self.b)
            pause.with_suffix('.release').touch()
            stdout, stderr = process.communicate(timeout=20)
            assert process.returncode == status, (stdout, stderr)
            return stdout + stderr
        finally:
            pause.with_suffix('.release').touch()
            if process.poll() is None:
                process.kill()
                process.wait()


def ending(lab, committed=False, state='ended'):
    name = 'missions/demo/README.md'
    lab.put(name, front().replace('state: unknown', 'state: ' + state))
    if committed:
        lab.run('commit', name)
    closing = 'missions/demo/closing.md'
    lab.put(closing, '# Closing\n\n## What is left\n\nNothing.\n')
    return [closing] if committed else [name, closing]


def mission_worktree(lab, suffix=''):
    worktree = lab.tmp / ('owners/demo' + suffix) / 'm1/work'
    worktree.parent.mkdir(parents=True)
    lab.git(lab.b, 'worktree', 'add', '-b', 'mission' + suffix, str(worktree))
    return worktree


def closing_unpublished(lab):
    paths = ending(lab)
    worktree = mission_worktree(lab, '-m2')
    (worktree / 'STATUS.md').write_text('unpublished\n')
    lab.git(worktree, 'commit', '-am', 'unpublished mission work')
    old = lab.git(lab.a, 'rev-parse', 'HEAD')
    output = lab.run('commit', *paths, status=2)
    assert str(worktree) in output and 'commits on no origin branch' in output, output
    assert 'push it and name it in the closing note\'s "what is left", or delete it' in output
    assert lab.git(lab.a, 'rev-parse', 'HEAD') == old


