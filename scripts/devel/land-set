class Failure(Exception):
    def __init__(self, status, reason, result=None):
        super().__init__(reason)
        self.status = status
        self.result = result


def require(condition, reason, status=2):
    if not condition:
        raise Failure(status, reason)


class Runner:
    def __init__(self):
        self.lock = self.child = self.results = None
        self.cancelling = False
        # Reap orphaned grandchildren too when a shell exits before its publisher.
        require(ctypes.CDLL(None).prctl(36, 1, 0, 0, 0) == 0,
                'cannot become child subreaper', 1)  # PR_SET_CHILD_SUBREAPER (Linux)

    def cancel(self, child, signum):
        self.cancelling = True
        try:
            os.killpg(child.pid, signum)
        except ProcessLookupError:
            pass
        deadline = time.monotonic() + 1
        while True:
            child.poll()
            try:
                while os.waitpid(-child.pid, os.WNOHANG)[0]:
                    pass
            except ChildProcessError:
                pass
            try:
                os.killpg(child.pid, 0)
            except ProcessLookupError:
                break
            if time.monotonic() >= deadline:
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            time.sleep(.01)
        child.wait()
        self.cancelling = False

    def run(self, root, argv, *, check=True, quiet=False, discard_stdout=False, data=None, diagnostic=False,
            env=None, merge_stderr=False):
        child = subprocess.Popen(argv, cwd=root, stdin=subprocess.PIPE if data else subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL if discard_stdout else subprocess.PIPE if quiet else None,
                                 stderr=subprocess.STDOUT if merge_stderr else subprocess.PIPE if quiet else None,
                                 env=dict(os.environ, GIT_EDITOR='true', LAND_TURN_ACTIVE='1', **(env or {})),
                                 close_fds=True, start_new_session=True)
        self.child = child
        try:
            while True:
                try:
                    out, err = child.communicate(input=data, timeout=.1)
                    break
                except subprocess.TimeoutExpired:
                    data = None
                    if self.lock:
                        self.lock.tick()
        except BaseException as error:
            signum = error.status - 128 if isinstance(error, Failure) else 0
            self.cancel(child, signum if signum in (signal.SIGINT, signal.SIGTERM) else signal.SIGTERM)
            raise
        finally:
            self.child = None
            for stream in (child.stdin, child.stdout, child.stderr):
                if stream:
                    stream.close()
        if check and child.returncode:
            raise Failure(1, f'command failed ({child.returncode}): {shlex.join(argv)}'
                          + (': ' + err.decode(errors='replace').strip() if err else ''))
        return child.returncode, ((err if diagnostic else out) or b'').decode().strip()

    def git(self, root, *args):
        return self.run(root, ['git', *args], quiet=True)[1]


class SetLock:
    def __init__(self, tmp, fixture, token, host):
        self.transport = None
        self.lost = False
        self.next_pulse = 0
        self.who = dict(token=token, repository='set', holder=host)
        self.heartbeat = not fixture and socket.gethostname() != COORDINATOR
        if fixture:
            argv = [sys.executable, '-I', '-B', str(Path(__file__).resolve().with_name('land-turn.py')),
                    'holder', str(fixture), token, 'set', host, str(fixture)]
        else:
            land = shutil.which('land')
            require(land, 'land is not on PATH', 5)
            holder = Path(land).resolve().with_name('land-turn.py')
            require(re.fullmatch(HOLDER, str(holder)), 'invalid holder path', 5)
            mode = 'ssh' if self.heartbeat else 'local'
            argv = ['python3', '-I', '-B', str(holder), 'connection-holder', token, 'set', host, mode]
            if self.heartbeat:
                argv = [*SSH, shlex.join(argv)]
        self.argv = argv

    def acquire(self):
        print('land-set: waiting for the set lock', flush=True)
        try:
            self.transport = subprocess.Popen(self.argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                              stderr=subprocess.DEVNULL, close_fds=True, start_new_session=True)
            os.set_blocking(self.transport.stdin.fileno(), False)
            pending = bytearray()
            while True:
                self.pulse()
                if not select.select([self.transport.stdout], [], [], .05)[0]:
                    continue
                chunk = os.read(self.transport.stdout.fileno(), 513)
                require(chunk, 'set lock transport closed before grant', 5)
                pending.extend(chunk)
                require(len(pending) <= 512, 'invalid set lock grant', 5)
                if b'\n' in pending:
                    grant = json.loads(pending)
                    wait = grant.pop('wait_s')
                    require(grant == self.who and type(wait) in (int, float)
                            and math.isfinite(wait) and wait >= 0, 'invalid set lock grant', 5)
                    self.tick()
                    require(not self.lost, 'set lock lost before work started', 5)
                    return
        except (OSError, ValueError, KeyError, TypeError, AttributeError, OverflowError) as error:
            raise Failure(5, 'set lock transport or protocol unavailable') from error

    def pulse(self):
        if self.heartbeat and time.monotonic() >= self.next_pulse:
            os.write(self.transport.stdin.fileno(), b'\0')
            self.next_pulse = time.monotonic() + 5

    def tick(self):
        if self.lost:
            return
        try:
            self.pulse()
            if select.select([self.transport.stdout], [], [], 0)[0]:
                os.read(self.transport.stdout.fileno(), 513)
                self.lost = True
            if self.transport.poll() is not None:
                self.lost = True
        except OSError:
            self.lost = True

    def boundary(self):
        self.tick()
        require(not self.lost, 'set lock lost; stopped between repositories', 5)

    def close(self):
        if self.transport is None:
            return
        self.transport.stdin.close()
        self.transport.stdout.close()
        try:
            status = self.transport.wait(timeout=1)
            self.lost |= status != 0
        except subprocess.TimeoutExpired:
            self.transport.kill()
            self.transport.wait()
            self.lost = True


class NoLock:
    """A prove holds no lock: it moves no main."""
    lost = False

    def tick(self):
        pass

    def boundary(self):
        pass

    def close(self):
        pass


def repo_name(url):
    return url.rstrip('/').rsplit('/', 1)[-1].rsplit(':', 1)[-1].removesuffix('.git')


def fetch(runner, path):
    # Proves share the primaries' refs with landing runs, so a ref lock may
    # be busy for a moment: try again, as land's fetch does.
    for wait in (1, 2, 4):
        if runner.run(path, ['git', 'fetch', 'origin'], check=False, quiet=True)[0] == 0:
            return
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            if runner.lock:
                runner.lock.tick()
            time.sleep(.1)
    runner.git(path, 'fetch', 'origin')


def validate(runner, path, name, branch=True):
    require(path.is_absolute() and path.is_dir(), f'{name}: expected absolute worktree path')
    path = path.resolve()
    require(runner.git(path, 'rev-parse', '--show-toplevel') == str(path), f'{name}: expected worktree root')
    runner.git(path, 'rev-parse', '--verify', 'HEAD^{commit}')
    require(repo_name(runner.git(path, 'remote', 'get-url', 'origin')) == name, f'{name}: wrong origin')
    if branch:
        # No optional index lock: this runs before the set's own flock, and
        # may meet another run of the set committing in the same worktree.
        require(not runner.run(path, ['git', 'status', '--porcelain=v1', '--untracked-files=all',
                                      '--ignore-submodules=none'], quiet=True,
                               env=dict(GIT_OPTIONAL_LOCKS='0'))[1], f'{name}: worktree must be clean')
        status, ref = runner.run(path, ['git', 'symbolic-ref', '--quiet', 'HEAD'], check=False, quiet=True)
        require(status == 0 and ref != 'refs/heads/main', f'{name}: expected named branch other than main')
        for state in ('rebase-merge', 'rebase-apply', 'MERGE_HEAD'):
            state_path = Path(runner.git(path, 'rev-parse', '--path-format=absolute', '--git-path', state))
            require(not state_path.exists(), f'{name}: rebase or merge in progress')
    return path


def load(runner, filename, root):
    try:
        spec = json.loads(Path(filename).read_text())
        require(isinstance(spec, dict) and set(spec) == {'set', 'repos'}, 'expected set and repos')
        require(isinstance(spec['set'], str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_./-]{0,79}',
                                                          spec['set']), 'invalid set name')
        repos = spec['repos']
        require(isinstance(repos, dict) and repos and set(repos) <= set(ORDER), 'invalid repository names')
        missing = {down for up in repos for down in ORDER if up in UPSTREAM[down]} - repos.keys()
        require(not missing, 'missing downstream repositories: ' + ', '.join(sorted(missing)))
        paths = {}
        for name, value in repos.items():
            require(isinstance(value, str), f'{name}: invalid worktree')
            paths[name] = validate(runner, root / name if value == 'pin-only' else Path(value),
                                   name, branch=value != 'pin-only')
        return spec, paths
    except (OSError, ValueError, TypeError, Failure) as error:
        raise Failure(2, str(error)) from error


def rebase(runner, path, base):
    status, _ = runner.run(path, ['git', 'rebase', base], check=False)
    while status:
        conflicts = runner.git(path, 'diff', '--name-only', '--diff-filter=U').splitlines()
        require(conflicts, 'rebase failed without conflicted paths', 1)
        if 'Cargo.lock' in conflicts:
            runner.git(path, 'checkout', '--ours', '--', 'Cargo.lock')
            runner.git(path, 'add', '--', 'Cargo.lock')
            conflicts.remove('Cargo.lock')
        if conflicts:
            code, lines = runner.run(path, [sys.executable, '-I', '-B',
                str(Path(__file__).resolve().with_name('land-resolve.py')), str(path)],
                check=False, quiet=True, merge_stderr=True)
            name = repo_name(runner.git(path, 'remote', 'get-url', 'origin'))
            for line in lines.splitlines():
                print(f'land-set: {name}: {line}', flush=True)
            if code:
                remaining = [line.removeprefix('stops ').split(': ', 1)[0]
                             for line in lines.splitlines() if line.startswith('stops ')]
                runner.run(path, ['git', 'rebase', '--abort'], check=False)
                raise Failure(3, 'rebase conflict outside Cargo.lock: ' + ', '.join(remaining or conflicts))
        status, _ = runner.run(path, ['git', 'rebase', '--continue'], check=False)


def repin(runner, path, name, label, landed, candidates, root, mains):
    pins = {}
    for up in reversed(UPSTREAM[name]):
        commit = candidates.get(up) or landed.get(up)
        if not commit:
            if up not in mains:
                remote = runner.git(root / up, 'ls-remote', 'origin', 'refs/heads/main').split()
                require(len(remote) == 2 and remote[1] == 'refs/heads/main'
                        and re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', remote[0]),
                        f'{name}: cannot determine {up} main', 1)
                mains[up] = remote[0]
            commit = mains[up]
        pins[up] = commit
    selected = {}

    def packages():
        return tomllib.loads((path / 'Cargo.lock').read_text())['package']

    def sources():
        found = {}
        for p in packages():
            source = p.get('source', '')
            if source.startswith('git+'):
                identity, mark, revision = source.rpartition('#')
                require(mark and identity and re.fullmatch(r'(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})', revision),
                        f'{name}: invalid git source {source}', 1)
                found.setdefault(identity, set()).add(revision.lower())
        for identity, revisions in found.items():
            require(len(revisions) == 1,
                    f'{name}: multiple revisions for source {identity}: ' + ', '.join(sorted(revisions)), 1)
        return {identity: next(iter(revisions)) for identity, revisions in found.items()}

    sources()
    # Sources whose packages depend on other upstream sources go first.
    targets = pins
    for up, commit in targets.items():
        records = [p for p in packages() if p.get('source', '').startswith('git+')
                   and repo_name(urlsplit(p['source'][4:].split('#')[0]).path) == up]
        identities = {p['source'].rsplit('#', 1)[0] for p in records}
        require(len(identities) == 1, f'{name}: absent or ambiguous source {up}', 1)
        identity = next(iter(identities))
        selected[identity] = commit
        require('rev' not in parse_qs(urlsplit(identity[4:]).query), f'{name}: rev constraint on {up}', 1)
        selector = identity + '#' + records[0]['name'] + '@' + records[0]['version']
        status, _ = runner.run(path, ['cargo', 'update', '--precise', commit, '-p', selector], check=False)
        require(status == 0, f'{name}: repin failed ({status})', 1)

    def verify():
        found = sources()
        for identity, revision in found.items():
            up = repo_name(urlsplit(identity[4:]).path)
            require(up not in targets or revision == targets[up], f'{name}: wrong pin for {up}', 1)
        require(selected.keys() <= found.keys(), f'{name}: pinned source disappeared', 1)
    verify()
    status, _ = runner.run(path, ['cargo', 'metadata', '--format-version', '1'],
                           check=False, discard_stdout=True)
    require(status == 0, f'{name}: metadata failed ({status})', 1)
    verify()
    if runner.git(path, 'diff', 'HEAD', '--', 'Cargo.lock'):
        runner.git(path, 'add', '--', 'Cargo.lock')
        message = f'land-set: {label}: pin {name}'
        if pins:
            message += ' to ' + ', '.join(up + ' ' + commit[:12]
                                         for up, commit in reversed(list(pins.items())))
        runner.git(path, 'commit', '-m', message)


def land(runner, path, *args, **options):
    """Run land; return its status, its output and the land-result-v1 object it wrote, or None."""
    target = runner.results / secrets.token_hex(8)
    code, output = runner.run(path, ['land', *args], check=False,
                             env=dict(LAND_RESULT=str(target), LAND_TIDY=''), **options)
    try:
        result = json.loads(target.read_text())
        target.unlink()
    except (OSError, ValueError):
        result = None
    return code, output, result if isinstance(result, dict) and result.get('schema') == 'land-result-v1' else None


def feed(runner, fixture, record):
    # The fixture marker without a fixture directory never reaches the real feed.
    if not fixture and os.environ.get('HEAVY_RECOVERY_FIXTURE') == '1':
        return
    path = str(fixture / 'feed.jsonl') if fixture else '/home/free/.local/state/agents-land-set/feed.jsonl'
    argv = ['python3', '-I', '-S', '-c', FEED, path]
    if not fixture and socket.gethostname() != COORDINATOR:
        argv = [*SSH, shlex.join(argv)]
    try:
        runner.run(None, argv, quiet=True, data=(json.dumps(record) + '\n').encode())
    except (OSError, Failure) as error:
        if isinstance(error, Failure) and error.status in (128 + signal.SIGINT, 128 + signal.SIGTERM):
            raise
        print('land-set: warning: feed append failed', file=sys.stderr, flush=True)


def read_state(path, label, repos):
    try:
        state = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    require(isinstance(state, dict) and set(state) == {'set', 'landed'}
            and state['set'] == label, f'{label}: invalid set state', 1)
    landed = state['landed']
    require(isinstance(landed, dict) and landed.keys() <= repos.keys()
            and all(isinstance(commit, str) and re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', commit)
                    for commit in landed.values()), f'{label}: invalid landed records', 1)
    return landed


def write_state(path, label, landed):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    pending = path.with_suffix('.tmp')
    with pending.open('w') as out:
        json.dump(dict(set=label, landed=landed), out)
        out.write('\n')
        out.flush()
        os.fsync(out.fileno())
    pending.replace(path)


def read_proof(path, label, host):
    """The pin-only commits a prove on this machine made, by repository."""
    try:
        proof = json.loads(path.read_text())
        repos = proof['repos']
        if (proof['schema'] != 'land-set-proof-v1' or proof['set'] != label or proof['machine'] != host
                or not re.fullmatch('[0-9a-f]{32}', proof['token'])):
            return None, {}
        return proof['token'], {name: entry['commit'] for name, entry in repos.items()
                                if entry['pin_only'] and re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}',
                                                                      entry['commit'])}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return None, {}


def write_proof(runner, path, label, host, token, spec, paths, candidates, bases):
    repos = {name: dict(base=bases[name], commit=commit,
                        tree=runner.git(paths[name], 'rev-parse', commit + '^{tree}'),
                        pin_only=spec['repos'][name] == 'pin-only')
             for name, commit in candidates.items()}
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    pending = path.with_suffix('.tmp')
    with pending.open('w') as out:
        json.dump(dict(schema='land-set-proof-v1', set=label, machine=host, token=token,
                       time=datetime.now(timezone.utc).isoformat(), repos=repos), out)
        out.write('\n')
        out.flush()
        os.fsync(out.fileno())
    pending.replace(path)


def reuse(runner, path, proved):
    """Take the proved commit for this repin's when they have the same parent and tree.

    A pin-only repin commits afresh each run, and a new commit would make
    every downstream pin it, and gate again. The proved commit differs
    from it only in its dates and the gate's trailers.
    """
    status, _ = runner.run(path, ['git', 'cat-file', '-e', proved + '^{commit}'], check=False, quiet=True)
    if status or runner.git(path, 'rev-parse', 'HEAD') == proved:
        return
    tree, parent, head_tree, head_parent = runner.git(
        path, 'rev-parse', proved + '^{tree}', proved + '^', 'HEAD^{tree}', 'HEAD^').splitlines()
    if (tree, parent) == (head_tree, head_parent):
        runner.git(path, 'reset', '--soft', proved)


def gate_step(runner, path, name, label, landed, candidates, root, mains, proved=None):
    fetch(runner, path)
    base = runner.git(path, 'rev-parse', 'origin/main')
    rebase(runner, path, base)
    repin(runner, path, name, label, landed, candidates, root, mains)
    if proved and runner.git(path, 'rev-parse', 'HEAD') != base:
        reuse(runner, path, proved)
    if runner.git(path, 'rev-parse', 'HEAD') == base:
        require(not any(up in landed or up in candidates for up in UPSTREAM[name]),
                f'{name}: no change after an upstream landed or gated; set is incomplete', 1)
        return None
    code, _, result = land(runner, path, '--no-push')
    if code:
        raise Failure(code if code > 0 else 128 - code, f'{name}: land --no-push failed ({code})', result)
    return (runner.git(path, 'rev-parse', 'HEAD'), base, result)


def push_step(runner, path, name, candidate):
    code, _, result = land(runner, path)
    commit = runner.git(path, 'rev-parse', 'HEAD')
    # land's own push is the evidence: a fetch from another URL than the
    # push's may not see it yet (configuring-3, 10-25). It holds only for a
    # push URL that names this repository, as validate checks the fetch's.
    if (result and result.get('pushed') is True and result.get('commit') == commit
            and repo_name(runner.git(path, 'remote', 'get-url', '--push', 'origin')) == name):
        return commit, code, result
    try:
        fetch(runner, path)
        for published in dict.fromkeys((commit, candidate)):
            found, _ = runner.run(path, ['git', 'merge-base', '--is-ancestor', published, 'origin/main'],
                                  check=False, quiet=True)
            if found == 0:
                return published, code, result
    except (Failure, OSError) as error:
        if isinstance(error, Failure) and error.status in (128 + signal.SIGINT, 128 + signal.SIGTERM):
            raise
        if not code:
            raise
        print(f'land-set: warning: {name}: cannot reconcile failed land', file=sys.stderr, flush=True)
    require(code != 0, f'{name}: HEAD is not on origin/main', 1)
    return None, code, result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--prove', action='store_true',
                        help='gate the set without the set lock, and push no main')
    parser.add_argument('setfile')
    args = parser.parse_args()
    prove = args.prove
    runner = Runner()
    root = Path(os.environ.get('DEV_ROOT', str(Path.home() / 'src/rust')))
    tmp = Path(os.environ.get('DEV_TMP', str(root / 'tmp'))).resolve()
    lock, spec, summary, current = None, None, {}, None
    fixture, paths, staging, failed = None, {}, {}, None
    candidates, bases, made, proved, warnings = {}, {}, set(), {}, []
    pushed = []
    announced = cleaning = terminal = False
    token = secrets.token_hex(16)
    host = re.sub('[^A-Za-z0-9_.-]', '-', socket.gethostname()).lstrip('._-')[:64] or 'local'

    def event(kind, **fields):
        if prove:
            fields['mode'] = 'prove'
        feed(runner, fixture, dict(time=datetime.now(timezone.utc).isoformat(), set=spec['set'],
                                   event=kind, host=host, token=token, **fields))

    def interrupted(signum, frame):
        nonlocal status, reason
        if runner.cancelling:
            return
        if cleaning:
            if status == 0 and not terminal:
                status, reason = 128 + signum, 'land-set: interrupted'
                print(reason, file=sys.stderr, flush=True)
            return
        raise Failure(128 + signum, 'interrupted')

    def remove_pin_only(name):
        if name in made:
            runner.git(root / name, 'worktree', 'remove', '--force', str(paths[name]))
            runner.git(root / name, 'branch', '-D', f'land-set/{token}/{name}')
            made.remove(name)

    def invalidate(start):
        for name in names[start:]:
            commit = candidates.pop(name, None)
            if commit:
                summary[name] = 'invalidated ' + commit + ' (not pushed)'
            bases.pop(name, None)

    def gates(start):
        nonlocal current
        # Three gate/check rounds, including the first, bound a moving main.
        for attempt in range(3):
            invalidate(start)
            mains, moved = {}, []
            for name in names[start:]:
                lock.boundary()
                current = name
                if name in landed:
                    path = paths[name]
                    fetch(runner, path)
                    commit = landed[name]
                    code, _ = runner.run(path, ['git', 'merge-base', '--is-ancestor', commit, 'origin/main'],
                                         check=False, quiet=True)
                    require(code == 0, f'{name}: recorded commit {commit} is not on origin/main', 1)
                    summary[name] = 'recorded landed ' + commit
                    current = None
                    continue
                if spec['repos'][name] == 'pin-only' and name not in made:
                    primary = root / name
                    # One path per set, not per run: the gate policy names
                    # the gate's absolute path, so a proof's cached gates hold
                    # only in the same worktree. The set's flock keeps it this
                    # run's alone; a failed or killed run's leftover goes
                    # first, with its branch.
                    path = tmp / 'land-set' / 'worktrees' / quote(spec['set'], safe='') / name
                    leftover = ''
                    if path.exists():
                        _, leftover = runner.run(path, ['git', 'symbolic-ref', '--quiet', 'HEAD'],
                                                 check=False, quiet=True)
                        runner.run(primary, ['git', 'worktree', 'remove', '--force', str(path)],
                                   check=False, quiet=True)
                        shutil.rmtree(path, ignore_errors=True)
                    runner.git(primary, 'worktree', 'prune')
                    if leftover.startswith('refs/heads/land-set/'):
                        runner.run(primary, ['git', 'branch', '-D', leftover.removeprefix('refs/heads/')],
                                   check=False, quiet=True)
                    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                    fetch(runner, primary)
                    runner.git(primary, 'worktree', 'add', '-b', f'land-set/{token}/{name}',
                               str(path), 'origin/main')
                    paths[name] = path
                    made.add(name)
                path = paths[name]
                result = gate_step(runner, path, name, spec['set'], landed, candidates, root, mains,
                                   proved.get(name) if spec['repos'][name] == 'pin-only' else None)
                if result is None:
                    summary[name] = 'skipped'
                    remove_pin_only(name)
                else:
                    commit, base, outcome = result
                    # land may itself have fetched and rebased after our repin.
                    if runner.git(path, 'merge-base', commit, 'origin/main') != base:
                        summary[name] = 'invalidated ' + commit + ' (not pushed)'
                        moved.append(names.index(name))
                        break
                    candidates[name], bases[name] = commit, base
                    summary[name] = 'gated ' + commit + ' (not pushed)'
                    event('gated', repo=name, commit=commit, **(dict(result=outcome) if outcome else {}))
                    if any(name in UPSTREAM[down] for down in names[names.index(name) + 1:]):
                        ref = f'refs/heads/land-set/{token}/{name}'
                        previous = staging.get(name, (None, ''))[1]
                        # Register before the push so even an interrupted push is cleaned up.
                        staging[name] = (path, commit, runner.git(path, 'remote', 'get-url', 'origin'))
                        runner.git(path, 'push', '--force-with-lease=' + ref + ':' + previous,
                                   'origin', commit + ':' + ref)
                current = None
            for index, name in enumerate(names):
                if name not in candidates:
                    continue
                lock.boundary()
                current = name
                fetch(runner, paths[name])
                if runner.git(paths[name], 'rev-parse', 'origin/main') != bases[name]:
                    moved.append(index)
                current = None
            if not moved:
                return
            start = min(moved)
            current = names[start]
            invalidate(start)
            require(attempt < 2, f'{current}: main kept moving after three gate rounds', 6)
            print(f'land-set: {current}: main moved; gating again', flush=True)

    for signum in (signal.SIGINT, signal.SIGTERM):
        signal.signal(signum, interrupted)
    status, reason = 0, None
    try:
        spec, paths = load(runner, args.setfile, root)
        names = [name for name in ORDER if name in paths]
        summary = {name: 'not reached' for name in names}
        runner.results = Path(tempfile.mkdtemp(prefix='land-set-'))
        try:
            code, output, _ = land(runner, None, '--no-push', '--docs', quiet=True, diagnostic=True)
        except OSError as error:
            raise Failure(2, 'land with --no-push is required on PATH') from error
        # The incompatible-flags diagnostic happens before any Git or build work.
        require(code == 2 and '--no-push cannot be combined' in output,
                'land on PATH must support --no-push')
        fixture = os.environ.get('LAND_SET_FIXTURE_DIR')
        if fixture is not None:
            fixture = Path(fixture).resolve()
            require(os.environ.get('HEAVY_RECOVERY_FIXTURE') == '1' and fixture != tmp
                    and fixture.is_relative_to(tmp), 'invalid fixture directory', 5)
        state = tmp / 'land-set' / 'state' / (quote(spec['set'], safe='') + '.json')
        proof = tmp / 'land-set' / 'proofs' / (quote(spec['set'], safe='') + '.json')
        # One run of a set at a time on this machine, for its worktrees: a
        # prove takes no set lock. The lock file is retained.
        state.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        own = open(state.with_suffix('.lock'), 'a')
        try:
            fcntl.flock(own, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Failure(2, 'another land-set run of this set is active on this machine') from None
        announced = True
        if prove:
            lock = NoLock()
            runner.lock = lock
            proof.unlink(missing_ok=True)
            event('proving')
        else:
            proof_token, proved = read_proof(proof, spec['set'], host)
            event('waiting')
            lock = SetLock(tmp, fixture, token, host)
            runner.lock = lock
            lock.acquire()
            event('started', **(dict(proof=proof_token) if proof_token else {}))
        landed = read_state(state, spec['set'], paths)
        gates(0)
        if prove:
            write_proof(runner, proof, spec['set'], host, token, spec, paths, candidates, bases)
            for name in list(made):
                remove_pin_only(name)
            for name, commit in candidates.items():
                summary[name] = 'proved ' + commit + ' (not pushed)'
        for index, name in enumerate(names):
            if prove or name not in candidates:
                continue
            lock.boundary()
            current = name
            candidate = candidates[name]
            commit, code, outcome = push_step(runner, paths[name], name, candidate)
            if commit:
                pushed.append(name)
                if spec['repos'][name] != 'pin-only':
                    try:
                        branch = runner.git(paths[name], 'symbolic-ref', '--short', 'HEAD')
                        runner.git(paths[name], 'config', f'branch.{branch}.landed', commit)
                    except (Failure, OSError) as error:
                        if isinstance(error, Failure) and error.status in (128 + signal.SIGINT, 128 + signal.SIGTERM):
                            raise
                        print(f'land-set: warning: cannot mark {name} landed: {error}', file=sys.stderr)
                HOOKS['clear_target']('land-set', paths[name])
                landed[name] = commit
                candidates.pop(name)
                write_state(state, spec['set'], landed)
                summary[name] = 'landed ' + commit
                event('landed', repo=name, commit=commit, **(dict(result=outcome) if outcome else {}))
                if code:
                    print(f'land-set: {name}: landed {commit} despite land failing ({code})', flush=True)
            # 5 after a push: the commit landed, and only this machine's main
            # did not follow it.
            if code == 5 and commit:
                summary[name] += '; the local main did not follow (5)'
                warnings.append(f'{name}: the local main did not follow (5)')
            elif code:
                raise Failure(code if code > 0 else 128 - code, f'{name}: land failed ({code})', outcome)
            remove_pin_only(name)
            current = None
            if commit != candidate:
                gates(index + 1)
        lock.boundary()
        if not prove:
            state.unlink(missing_ok=True)
            proof.unlink(missing_ok=True)
    except (Failure, OSError, ValueError, KeyError, TypeError) as error:
        status = error.status if isinstance(error, Failure) else 1
        failed = error.result if isinstance(error, Failure) else None
        reason = 'land-set: ' + str(error)
        print(reason, file=sys.stderr, flush=True)
        if current:
            prefix = summary[current] + '; ' if summary[current].startswith('landed ') else ''
            summary[current] = prefix + f'failed ({status}) {paths[current]}'
    finally:
        # Finish cleanup under the lock, even if a signal arrives during it.
        cleaning = True
        for name, (path, commit, origin) in staging.items():
            # A landed pin-only worktree has already been removed.
            path = path if path.exists() else root / name
            try:
                runner.git(path, 'push', 'origin', f':refs/heads/land-set/{token}/{name}')
            except (Failure, OSError):
                print(f'land-set: warning: staging branch deletion failed: {origin} '
                      f'refs/heads/land-set/{token}/{name} {commit}', file=sys.stderr, flush=True)
        if lock:
            lock.tick()
            if lock.lost and status == 0:
                status = 5
                reason = 'land-set: set lock lost before terminal event'
                print(reason, file=sys.stderr, flush=True)
        if status:
            for name in list(made - {current}):
                try:
                    remove_pin_only(name)
                except (Failure, OSError):
                    print(f'land-set: warning: cannot remove pin-only worktree {paths[name]}',
                          file=sys.stderr, flush=True)
        # The terminal append commits the outcome; signals after this point
        # cannot change done into a failure, and the lock still covers the append.
        terminal = True
        if announced:
            if status:
                fields = dict(status=status, reason=reason.splitlines()[0][:200])
                if current:
                    fields['repo'] = current
                if failed:
                    fields['result'] = failed
                event('stopped', **fields)
            else:
                event('proved' if prove else 'done', **(dict(warnings=warnings) if warnings else {}))
        if lock:
            lock.close()
        runner.lock = None
        if runner.results:
            shutil.rmtree(runner.results, ignore_errors=True)
        for name, result in summary.items():
            print(f'land-set: {name}: {result}', flush=True)
        if prove and not status:
            print(f'land-set: proved; land it on {host} with land-set {args.setfile}', flush=True)
        if pushed:
            HOOKS['start_tidy']('land-set', 'LAND_TIDY', tmp, pushed)
    return status


if __name__ == '__main__':
    sys.exit(main())
