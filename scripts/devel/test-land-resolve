def generated_refused(directory):
    # Writer refusal and writer failure after writing both undo.
    for mode in ('refuse', 'fail'):
        sub = directory / mode
        sub.mkdir()
        lab = generated(sub, extra=True)
        code, output = lab.resolve(env=dict(REGENERATE_MODE=mode))
        assert code == 1 and 'undid the rebase' in output, (mode, code, output)
        verb, status = ('refused', 3) if mode == 'refuse' else ('failed', 1)
        reason = f'scripts/regenerate.sh {verb} (exit {status})'
        if mode == 'refuse':
            reason += (': regenerate: refused change outside figures: docs/examples/owned.json; '
                       'engine.memory_bytes: 850000000000000 -> 900000000000000')
        reason += f' (log {lab.calls}.log)'
        stops = [line for line in output.splitlines() if line.startswith('stops ')]
        assert stops == [f'stops {FIGURE}, figures/b.txt: {reason}'], output
        assert output.splitlines()[-2] == stops[0], output
        if mode == 'refuse':
            assert output.index('scripts/regenerate.sh: ') < output.index('heavy: queued '), output
        lab.undone()


