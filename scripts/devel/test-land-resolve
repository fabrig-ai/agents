def generated_no_change(directory):
    lab = generated(directory, no_change=True)
    code, output = lab.resolve()
    assert code == 0 and 'regenerated ' not in output, (code, output)
    assert lab.git('show', '-s', '--format=%s').stdout.strip() == 'branch rows'
    assert (lab.root / FIGURE).read_text() == 'main\n'
    assert len(lab.calls.read_text().splitlines()) == 1
    assert not lab.git('status', '--porcelain').stdout


def generated_refused(directory):
    # Writer refusal, writer failure after writing, and queue refusal all undo.
    for mode in ('refuse', 'fail', 'heavy'):
        sub = directory / mode
        sub.mkdir()
        lab = generated(sub)
        code, output = lab.resolve(env=dict(REGENERATE_MODE=mode))
        assert code == 1 and 'undid the rebase' in output, (mode, code, output)
        if mode == 'refuse':
            assert 'declared limit would move' in output, output
        if mode == 'heavy':
            assert 'fixture heavy refused' in output, output
        lab.undone()


def generated_touches_declaration(directory):
    for mode in ('declaration', 'broken_writer'):
        sub = directory / mode
        sub.mkdir()
        lab = generated(sub)
        code, output = lab.resolve(env=dict(REGENERATE_MODE=mode))
        assert code == 1 and 'stops declared.json:' in output, (code, output)
        if mode == 'broken_writer':
            assert 'Exec format error' in output, output
        assert not (lab.root / 'untracked').exists()
        lab.undone()


def second_stop(lab):
    lab.write({'src/lib.rs': 'branch\n'})
    lab.git('commit', '-m', 'second code conflict')
    lab.branch = lab.git('rev-parse', 'HEAD').stdout.strip()
    result = lab.git('rebase', 'main', check=False)
    assert result.returncode and lab.git('ls-files', '-u').stdout


def generated_then_stop(directory):
    lab = generated(directory, stop=False)
    second_stop(lab)
    code, output = lab.resolve()
    assert code == 1 and 'stops src/lib.rs: no rule for it' in output, (code, output)
    assert 'undid the rebase' in output
    assert not lab.calls.read_text()
    lab.undone()


def rows_then_stop(directory):
    lab = Stopped(directory, {PATH: STATUS, 'src/lib.rs': 'base\n'},
                  {PATH: changed('a', 'main'), 'src/lib.rs': 'main\n'},
                  {PATH: changed('b', 'branch')}, stop=False)
    second_stop(lab)
    code, output = lab.resolve()
    assert code == 1 and 'stops src/lib.rs: no rule for it' in output, (code, output)
    assert 'undid the rebase' not in output and lab.rebasing()
