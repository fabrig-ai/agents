def land_rows(directory):
    lab = Stopped(directory, {PATH: STATUS}, {PATH: changed('b', 'main')},
                  {PATH: changed('a', 'branch')}, stop=False)
    text = changed('a', 'branch').replace('| `c.md` | no | all |', '| `c.md` | branch second | left |')
    lab.write({PATH: text})
    lab.git('commit', '-m', 'second branch rows')
    result = lab.run([str(lab.kit / 'land'), '--docs', '--local'], check=False)
    assert result.returncode == 0, (result.stdout, result.stderr)
    assert result.stderr.count(f'land: resolved {PATH} in ') == 2, result.stderr
    commits = lab.git('rev-list', 'main', '^main~2').stdout.splitlines()
    assert len(commits) == 2
    for commit, key in zip(commits, ('c', 'a')):
        message = lab.git('show', '-s', '--format=%B', commit).stdout
        assert f'Rebase-Resolved: {PATH}: table rows: main changed `b.md`; this commit changed `{key}.md`' in message, message
    text = lab.git('show', f'main:{PATH}').stdout
    assert all(value in text for value in ('| `a.md` | branch |', '| `b.md` | main |', '| `c.md` | branch second |'))
    assert not lab.git('status', '--porcelain').stdout


def land_same_row(directory):
    lab = Stopped(directory, {PATH: STATUS}, {PATH: changed('b', 'main')},
                  {PATH: changed('b', 'branch')}, stop=False)
    result = lab.run([str(lab.kit / 'land'), '--docs', '--local'], check=False)
    assert result.returncode == 3 and '`b.md` changed on both sides' in result.stderr, result.stderr
    assert lab.git('ls-files', '-u').stdout
    assert lab.git('rev-parse', 'REBASE_HEAD').stdout.strip() == lab.branch


def generated(directory, *, rows=False, no_change=False, script=True, stop=True):
    base = {FIGURE: 'base\n', 'figures.src': 'a base\n\nb base\n',
            'declared.json': '{}\n', 'src/lib.rs': 'base\n', 'restored.txt': 'branch original\n'}
    if script:
        base['scripts/regenerate.sh'] = REGENERATE
    main = {FIGURE: 'main\n', 'figures.src': 'a base\n\nb main\n', 'src/lib.rs': 'main\n', 'restored.txt': None}
    branch = {FIGURE: 'branch\n', 'figures.src': 'a branch\n\nb base\n'}
    if no_change:
        main['figures.src'] = 'a main\n\nb base\n'
        branch['figures.src'] = 'a base\n\nb branch\n'
    if rows:
        base[PATH], main[PATH], branch[PATH] = STATUS, changed('a', 'main'), changed('b', 'branch')
    return Stopped(directory, base, main, branch, stop=stop)


def regenerated(lab):
    assert (lab.root / FIGURE).read_text() == 'branch\n'
    assert not lab.rebasing() and not lab.git('status', '--porcelain').stdout
    message = lab.git('show', '-s', '--format=%B').stdout
    assert message.startswith('regenerate.sh: rewrite 1 files after the rebase on '), message
    assert f'Rebase-Resolved: scripts/regenerate.sh rewrote {FIGURE}' in message, message
    for field in ('%an', '%ae'):
        assert lab.git('show', '-s', f'--format={field}').stdout.strip() == ('Fixture' if field == '%an' else 'fixture@invalid')
    assert lab.calls.read_text().count('scripts/regenerate.sh') == 1
    assert 'land repo regenerate: --tail 60 scripts/regenerate.sh ' + FIGURE in lab.calls.read_text()


def generated_kept(directory):
    lab = generated(directory)
    code, output = lab.resolve()
    assert code == 0 and f'regenerated {FIGURE} in ' in output, (code, output)
    assert 'heavy: queued task 1 in the build lane token fixture-token' in output, output
    message = lab.git('show', '-s', '--format=%B', 'HEAD^').stdout
    assert f"Rebase-Resolved: {FIGURE}: main's side, for scripts/regenerate.sh" in message, message
    regenerated(lab)


def generated_and_rows(directory):
