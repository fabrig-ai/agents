    assert code == 0, output
    message = lab.git('show', '-s', '--format=%B', 'HEAD^').stdout
    assert f"Rebase-Resolved: {FIGURE}: main's side, for scripts/regenerate.sh" in message, message
    assert f'Rebase-Resolved: {PATH}: table rows:' in message, message
    text = (lab.root / PATH).read_text()
    assert '| `a.md` | main |' in text and '| `b.md` | branch |' in text
