def cargo_lock(directory):
    lab = Stopped(directory, {'Cargo.lock': 'base\n'}, {'Cargo.lock': 'main\n'}, {'Cargo.lock': 'branch\n'})
    before = lab.state()
    code, output = lab.resolve()
    assert code == 1 and 'stops Cargo.lock: no rule for it' in output, (code, output)
    assert lab.state() == before
    code, output = lab.resolve('--cargo-lock')
    assert code == 0 and "Cargo.lock" in output, (code, output)
    assert not lab.rebasing()
    assert (lab.root / 'Cargo.lock').read_text() == 'main\n'
    assert "Rebase-Resolved: Cargo.lock: main's side, for the repin" in lab.git('show', '-s', '--format=%B').stdout


def later(directory):
    lab = generated(directory)
    code, output = lab.resolve('--later')
    assert code == 0 and output.count(f'regenerate {FIGURE}\n') == 1, (code, output)
    assert not lab.calls.read_text() and not lab.rebasing()
    assert (lab.root / FIGURE).read_text() == 'main\n'
    result = lab.run([sys.executable, '-I', '-B', str(lab.kit / 'land-resolve.py'),
                      '--regenerate', str(lab.root), lab.branch, FIGURE])
    assert f'regenerated {FIGURE} in ' in result.stdout, result.stdout
    regenerated(lab)


def regenerate_refused(directory):
    lab = generated(directory)
    code, output = lab.resolve('--later')
    assert code == 0, output
    # The post-repin call must undo the repin too.
    lab.write({'pin.txt': 'new upstream\n'})
    lab.git('commit', '-m', 'repin')
    result = lab.run([sys.executable, '-I', '-B', str(lab.kit / 'land-resolve.py'),
                      '--regenerate', str(lab.root), lab.branch, FIGURE],
                     check=False, env=dict(REGENERATE_MODE='refuse'))
    assert result.returncode == 1 and 'declared limit would move' in result.stdout, result
    lab.undone()


def land_undone(directory):
    lab = generated(directory, stop=False)
    lab.write({'src/lib.rs': 'branch\n'})
    lab.git('commit', '-m', 'second code conflict')
    lab.branch = lab.git('rev-parse', 'HEAD').stdout.strip()
    result = lab.run([str(lab.kit / 'land'), '--docs', '--local'], check=False)
    assert result.returncode == 3 and 'was undone' in result.stderr, result.stderr
    assert 'stops src/lib.rs: no rule for it' in result.stderr, result.stderr
    lab.undone()


CASES = (rows_kept, row_added, added_in_one_place, same_row, deleted_and_changed, added_on_both, malformed_row,
         outside_rows, code_file, all_or_nothing, not_stopped, land_rows, land_same_row,
         generated_kept, generated_and_rows, generated_no_change, generated_refused,
         generated_touches_declaration, generated_then_stop, rows_then_stop, no_script,
         cargo_lock, later, regenerate_refused, land_undone)


def run(case, directory, built):
    case(directory)


if __name__ == '__main__':
    sys.exit(case_runner.main(__file__, CASES, run, prefix='land-resolve-fixture-'))
