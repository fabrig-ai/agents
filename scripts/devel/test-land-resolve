def feed_lab(directory, message):
    lab = Stopped(directory, {'base.md': 'base\n'}, {'main.md': 'main\n'},
                  {'branch.md': 'first\n'}, stop=False)
    lab.git('commit', '--amend', '-m', message)
    origin = directory / 'origin.git'
    lab.git('init', '--bare', '--initial-branch=main', str(origin))
    lab.git('remote', 'add', 'origin', origin.as_uri())
    lab.git('push', '--quiet', 'origin', 'main')
    return lab


def land_feed(directory):
    lab = feed_lab(directory, 'first change\n\nTaught: first')
    values = ['second ' + str(n) for n in range(1, 12)]
    values[3] = 'x' * 250
    lab.write({'branch.md': 'second\n'})
    lab.git('commit', '-m', 'second change\n\n' + '\n'.join('Taught: ' + line for line in values))
    before = lab.git('rev-parse', 'main').stdout.strip()
    feed = directory / 'feed.jsonl'
    result = lab.run([str(lab.kit / 'land'), '--docs'], env=dict(LAND_FEED=str(feed)))
    assert 'land: warning' not in result.stderr, result
    rows = feed.read_text().splitlines()
    assert len(rows) == 1, rows
    row = json.loads(rows[0])
    assert list(row) == ['time', 'kind', 'event', 'host', 'token', 'repo', 'branch',
                         'base', 'commit', 'taught', 'taught_more'], row
    assert datetime.fromisoformat(row['time']).utcoffset().total_seconds() == 0, row
    assert re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{0,63}', row['host']), row
    assert re.fullmatch('[0-9a-f]{32}', row['token']), row
    assert (row['kind'], row['event'], row['repo'], row['branch']) == ('land', 'landed', 'origin', 'branch'), row
    after = lab.git('rev-parse', 'origin/main').stdout.strip()
    assert row['base'] == before and row['commit'] == after and before != after, row
    expected = ['first'] + values[:9]
    expected[4] = 'x' * 199 + '…'
    assert row['taught'] == expected and row['taught_more'] == 2, row
    assert feed.stat().st_mode & 0o777 == 0o600
    assert feed.parent.stat().st_mode & 0o777 == 0o700
    # A follow failure still leaves exactly one record of the successful push.
    main_work = directory / 'main-work'
    lab.git('worktree', 'add', str(main_work), 'main')
    (main_work / 'main.md').write_text('dirty main\n')
    lab.git('checkout', '-b', 'follow-fails', 'origin/main')
    lab.write({'branch.md': 'third\n'})
    lab.git('commit', '-m', 'follow failure')
    result = lab.run([str(lab.kit / 'land'), '--docs'], check=False, env=dict(LAND_FEED=str(feed)))
    assert result.returncode == 5, result
    rows = [json.loads(line) for line in feed.read_text().splitlines()]
    assert len(rows) == 2 and rows[-1]['branch'] == 'follow-fails', rows
    assert rows[-1]['commit'] == lab.git('rev-parse', 'origin/main').stdout.strip(), rows


def land_feed_origin(directory):
    lab = feed_lab(directory, 'seed')
    lab.env['LAND_TURN_ACTIVE'] = '1'  # No live set lock in this fixture.
    origin = directory / 'temper.git'
    (directory / 'origin.git').rename(origin)
    clone = directory / 'clone-temper'
    lab.git('clone', '--quiet', origin.as_uri(), str(clone))
    lab.root = clone
    lab.git('checkout', '-b', 'owner-branch')
    feed = directory / 'feed.jsonl'
    for name in ('clone-temper', 'owner-worktree'):
        if name == 'owner-worktree':
            linked = directory / name
            lab.git('worktree', 'add', '-b', 'linked-branch', str(linked), 'origin/main')
            lab.root = linked
        lab.write({'branch.md': name + '\n'})
        lab.git('commit', '-m', 'land from ' + name)
        result = lab.run([str(lab.kit / 'land'), '--docs'], env=dict(LAND_FEED=str(feed)))
        row = json.loads(feed.read_text().splitlines()[-1])
        assert row['repo'] == 'temper', row
        assert row['commit'] == lab.git('rev-parse', 'origin/main').stdout.strip(), row
        outcome = json.loads(next(line.removeprefix('land: result ') for line in result.stdout.splitlines()
                                  if line.startswith('land: result ')))
        assert outcome['repo'] == row['repo'] and outcome['pushed'], outcome
    assert len(feed.read_text().splitlines()) == 2


def land_feed_starved(directory):
    lab = feed_lab(directory, 'starved gate\n\nTaught: passing still records starvation')
    feed = directory / 'feed.jsonl'
    log = directory / 'gate log with spaces.log'
    log.write_text('gate-starved real bin z\ngate-starved fuzzy bin a\n'
                   'gate-starved real bin z\n')
    # Run land's own feed call with a known gate log, without a real gate.
    source = (lab.kit / 'land').read_text()
    function = 'land_feed() {' + source.split('land_feed() {', 1)[1].split('\n}', 1)[0] + '\n}'
    log_assignment = next(line.strip() for line in source.splitlines()
                          if line.strip().startswith('gate_log=$(sed '))
    shell = ('kit=$1 repo=repo branch=branch base=$2 gate_log=$4 gate_heard=$5\n'
             + 'if test -n "$gate_heard"; then\n' + log_assignment + '\nfi\n'
             + function + '\nland_feed "$3"')
    base = lab.git('rev-parse', 'main').stdout.strip()
    tip = lab.git('rev-parse', 'HEAD').stdout.strip()

    def append(path, heard=''):
        result = lab.run(['bash', '-c', shell, 'fixture', str(lab.kit), base, tip, str(path), heard],
                         env=dict(LAND_FEED=str(feed)))
        assert not result.stderr, result
        return json.loads(feed.read_text().splitlines()[-1])

    heard = (f'heavy: task 1 (gate) exit 0, waited 2s, ran 12s, log {log}\n'
             'heavy: receipt fixture token ' + 'a' * 32)
    row = append('', heard)
    assert row['taught'] == ['passing still records starvation'], row
    assert row['starved'] == ['real bin z', 'fuzzy bin a'], row
    assert 'starved_more' not in row, row
    names = [f'test {n}' for n in range(55)]
    log.write_text(''.join(f'gate-starved {name}\n' for name in names + names))
    row = append(log)
    assert row['starved'] == names[:50] and row['starved_more'] == 5, row
    log.write_text('gate-step fmt 1.000 0\n')
    row = append(log)
    assert 'starved' not in row and 'starved_more' not in row, row
    row = append(directory / 'missing.log')
    assert 'starved' not in row and 'starved_more' not in row, row
    # A cached or skipped gate supplies no log even when an old one exists.
    log.write_text('gate-starved stale\n')
    row = append('')
    assert 'starved' not in row and 'starved_more' not in row, row


def land_feed_none(directory):
    hosted = runpy.run_path(str(SCRIPT.with_name('land-feed.py')))['hosted']
    for url in ('git@github.com:fabrig-ai/agents.git', 'ssh://git@host/repo.git',
                'https://host/repo.git', 'https::https://host/repo.git',
                'git@[::1]:repo.git', 'ssh://git@[::1]/repo.git'):
        assert hosted(url), url
    for url in ('/scratch/origin.git', 'file:///scratch/origin.git', './origin.git',
                'ext::git-receive-pack /scratch/origin.git',
                'https::file:///scratch/origin.git', 'custom_helper::/scratch/origin.git',
                'ext::ssh host git-receive-pack repo.git',
                'ext::git-receive-pack /scratch/\norigin.git'):
        assert not hosted(url), url
    lab = feed_lab(directory, 'no teaching')
    feed = directory / 'feed.jsonl'
    result = lab.run([str(lab.kit / 'land'), '--docs'], env=dict(LAND_FEED=str(feed)))
    assert 'land: warning' not in result.stderr, result
    row = json.loads(feed.read_text())
    assert 'taught' not in row and 'taught_more' not in row, row
    assert 'starved' not in row and 'starved_more' not in row, row
    bin_dir = directory / 'bin'
    bin_dir.mkdir()
    marker = directory / 'ssh-called'
    ssh = bin_dir / 'ssh'
    ssh.write_text('#!/bin/sh\ntouch ' + str(marker) + '\nexit 99\n')
    ssh.chmod(0o700)
    lab.env['PATH'] = str(bin_dir) + ':' + lab.env['PATH']
    lab.env.pop('HEAVY_RECOVERY_FIXTURE', None)
    for branch in ('feed-empty', 'feed-unset'):
        lab.git('checkout', '-b', branch, 'origin/main')
        lab.write({'branch.md': branch + '\n'})
        lab.git('commit', '-m', branch)
        if branch == 'feed-unset':
            del lab.env['LAND_FEED']
        result = lab.run([str(lab.kit / 'land'), '--docs'])
        assert 'land: warning' not in result.stderr, result
        assert len(feed.read_text().splitlines()) == 1 and not marker.exists()
    # Append errors warn without changing a push's successful status.
    lab.git('checkout', '-b', 'feed-refused', 'origin/main')
    lab.write({'branch.md': 'feed refused\n'})
    lab.git('commit', '-m', 'feed refused')
    link = directory / 'feed-link'
    link.symlink_to(feed)
    result = lab.run([str(lab.kit / 'land'), '--docs'], env=dict(LAND_FEED=str(link)))
    assert 'land: warning: the landing feed was not written' in result.stderr, result
    assert len(feed.read_text().splitlines()) == 1 and not marker.exists()


