    result = lab.run([sys.executable, '-I', '-B', str(lab.kit / 'land-resolve.py'),
                      '--regenerate', str(lab.root), lab.branch, FIGURE],
                     check=False, env=dict(REGENERATE_MODE='refuse'))
    reason = ('scripts/regenerate.sh refused (exit 3): regenerate: refused change outside figures: '
              'docs/examples/owned.json; engine.memory_bytes: 850000000000000 -> 900000000000000 '
              f'(log {lab.calls}.log)')
    assert result.returncode == 1 and f'stops {FIGURE}: {reason}\n' in result.stdout, result
    lab.undone()


def land_undone(directory):
    lab = generated(directory, stop=False)
    lab.write({'src/lib.rs': 'branch\n'})
    lab.git('commit', '-m', 'second code conflict')
    lab.branch = lab.git('rev-parse', 'HEAD').stdout.strip()
