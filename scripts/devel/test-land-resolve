def generated(directory, *, rows=False, no_change=False, script=True, stop=True, extra=False):
    base = {FIGURE: 'base\n', 'figures.src': 'a base\n\nb base\n',
            'declared.json': '{}\n', 'src/lib.rs': 'base\n', 'restored.txt': 'branch original\n'}
    if script:
        base['scripts/regenerate.sh'] = REGENERATE
    main = {FIGURE: 'main\n', 'figures.src': 'a base\n\nb main\n', 'src/lib.rs': 'main\n', 'restored.txt': None}
    branch = {FIGURE: 'branch\n', 'figures.src': 'a branch\n\nb base\n'}
    if extra:
        base['figures/b.txt'], main['figures/b.txt'], branch['figures/b.txt'] = 'base\n', 'main\n', 'branch\n'
    if no_change:
        main['figures.src'] = 'a main\n\nb base\n'
        branch['figures.src'] = 'a base\n\nb branch\n'
    if rows:
        base[PATH], main[PATH], branch[PATH] = STATUS, changed('a', 'main'), changed('b', 'branch')
    return Stopped(directory, base, main, branch, stop=stop)


def regenerated(lab):
    assert (lab.root / FIGURE).read_text() == 'branch\n'
    assert not lab.rebasing() and not lab.git('status', '--porcelain').stdout
    message = lab.git('show', '-s', '--format=%B').stdout
    assert message.startswith('regenerate.sh: rewrite 1 files after the rebase on '), message
    assert f'Rebase-Resolved: scripts/regenerate.sh rewrote {FIGURE}' in message, message
    for field in ('%an', '%ae'):
        assert lab.git('show', '-s', f'--format={field}').stdout.strip() == ('Fixture' if field == '%an' else 'fixture@invalid')
    assert lab.calls.read_text().count('scripts/regenerate.sh') == 1
    assert 'land repo regenerate: --tail 60 scripts/regenerate.sh ' + FIGURE in lab.calls.read_text()


