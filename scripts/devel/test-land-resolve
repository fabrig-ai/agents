#!/usr/bin/env python3
"""Disposable stopped-rebase fixtures for land-resolve and land."""
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys

import case_runner

SCRIPT = Path(__file__).resolve().with_name('land-resolve.py')
PATH = 'docs/design/STATUS.md'
STATUS = '''# Status

Updated 2026-10-26. How far the tools are from their design.

| Document | Built | Left |
|---|---|---|
| `a.md` | yes | — |
| `b.md` | partly | 3 |
| `c.md` | no | all |
'''
AUTHOR = dict(GIT_AUTHOR_NAME='Branch Author', GIT_AUTHOR_EMAIL='branch@invalid',
              GIT_AUTHOR_DATE='2020-02-03T04:05:06+02:00')
MESSAGE = 'branch rows\n\nKeep the branch body.\n\nReviewed-by: Fixture <fixture@invalid>\n'

FIGURE = 'figures/a.txt'
REGENERATE = r'''#!/usr/bin/env python3
import os
from pathlib import Path
import sys
args = sys.argv[1:]
if args[:1] == ['--owns']:
    sys.exit(0 if all(len(Path(p).parts) == 2 and p.startswith('figures/') and p.endswith('.txt')
                     for p in args[1:]) else 1)
mode = os.environ.get('REGENERATE_MODE', '')
if mode == 'refuse':
    print('declared limit would move', file=sys.stderr)
    sys.exit(3)
values = dict(line.split() for line in Path('figures.src').read_text().splitlines() if line)
for arg in args:
    Path(arg).write_text(values[Path(arg).stem] + '\n')
if mode in ('declaration', 'broken_writer'):
    Path('declared.json').write_text('changed declaration\n')
    Path('restored.txt').write_text('writer recreated a path main deleted\n')
    Path('untracked/deep').mkdir(parents=True)
    Path('untracked/deep/extra.txt').write_text('left by the writer\n')
if mode == 'broken_writer':
    Path('scripts/regenerate.sh').write_text('broken executable\n')
if mode == 'fail':
    sys.exit(1)
'''
HEAVY = r'''#!/usr/bin/env python3
import os
from pathlib import Path
import subprocess
import sys
args = sys.argv[1:]
assert '--land' not in args and '--gate' not in args, args
assert os.environ['HEAVY_LABEL'] == 'land repo regenerate', os.environ['HEAVY_LABEL']
print('heavy: queued task 1 in the build lane token fixture-token', file=sys.stderr)
with Path(os.environ['HEAVY_CALLS']).open('a') as out:
    out.write(os.environ['HEAVY_LABEL'] + ': ' + ' '.join(args) + '\n')
while args:
    if args[0] == '--':
        args = args[1:]
        break
    if args[0] == '--tail':
        args = args[2:]
    elif args[0].startswith('-'):
        args = args[1:]
    else:
        break
if os.environ.get('REGENERATE_MODE') == 'heavy':
    print('fixture heavy refused', file=sys.stderr)
    sys.exit(9)
sys.exit(subprocess.run(args, stderr=subprocess.STDOUT).returncode)
'''


def changed(key, text):
    return STATUS.replace(next(line for line in STATUS.splitlines() if line.startswith(f'| `{key}.md`')),
                          f'| `{key}.md` | {text} | remaining |')


class Stopped:
    """A private repository, normally stopped in git rebase main."""
    def __init__(self, directory, base, main, branch, *, stop=True):
        self.directory = directory
        self.root = directory / 'repo'
        self.root.mkdir()
        config = directory / 'gitconfig'
        config.write_text('')
        self.env = {key: value for key, value in os.environ.items() if not key.startswith('GIT_')}
        self.kit = directory / 'kit'
        self.kit.mkdir()
        for name in ('land-resolve.py', 'land', 'tidy-hooks.py', 'gate-policy.sh', 'kit.sh',
                     'land-capture.py', 'recovery_message.py', 'receipt_inputs.py'):
            shutil.copy(SCRIPT.with_name(name), self.kit / name)
        (self.kit / 'heavy').write_text(HEAVY)
        (self.kit / 'heavy').chmod(0o700)
        self.calls = directory / 'heavy.calls'
        self.calls.touch()
        self.env.update(HEAVY_CALLS=str(self.calls))
        self.env.update(GIT_CONFIG_GLOBAL=str(config), GIT_CONFIG_SYSTEM=str(config),
                        GIT_AUTHOR_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@invalid',
                        GIT_COMMITTER_NAME='Fixture', GIT_COMMITTER_EMAIL='fixture@invalid',
                        GIT_EDITOR='true', DEV_TMP=str(directory / 'tmp'), LAND_TIDY='')
        self.git('init', '-b', 'main')
        self.git('config', 'core.hooksPath', '/dev/null')
        self.git('config', 'commit.gpgSign', 'false')
        self.git('config', 'maintenance.auto', 'false')
        self.git('config', 'gc.auto', '0')
        self.write(base)
        self.git('commit', '-m', 'base')
        self.base = self.git('rev-parse', 'HEAD').stdout.strip()
        self.write(main)
        self.git('commit', '-m', 'main rows')
        self.git('checkout', '-b', 'branch', self.base)
        self.write(branch)
        self.git('commit', '-F', '-', data=MESSAGE, env=AUTHOR)
        self.branch = self.git('rev-parse', 'HEAD').stdout.strip()
        if stop:
            result = self.git('rebase', 'main', check=False)
            assert result.returncode and self.git('ls-files', '-u').stdout, result

    def run(self, argv, *, check=True, data=None, env=None):
        result = subprocess.run(argv, cwd=self.root, env=dict(self.env, **(env or {})),
                                input=data, text=True, capture_output=True)
        assert not check or result.returncode == 0, (argv, result.stdout, result.stderr)
        return result

    def git(self, *args, **kwargs):
        return self.run(['git', *args], **kwargs)

    def write(self, files):
        for name, text in files.items():
            target = self.root / name
            if text is None:
                target.unlink()
            else:
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_text(text)
                if name == 'scripts/regenerate.sh':
                    target.chmod(0o700)
        self.git('add', '-A')

    def resolve(self, *options, env=None):
        result = self.run([sys.executable, '-I', '-B', str(self.kit / 'land-resolve.py'),
                           *options, str(self.root)], check=False, env=env)
        assert not result.stderr or result.returncode == 2, result.stderr
        return result.returncode, result.stdout

    def state(self):
        return ({str(p.relative_to(self.root)): p.read_bytes()
                 for p in self.root.rglob('*') if p.is_file() and '.git' not in p.relative_to(self.root).parts},
                *(self.git(*args).stdout for args in (('status', '--porcelain=v2'), ('ls-files', '-u'),
                                                     ('rev-parse', 'REBASE_HEAD'))))

    def rebasing(self):
        return any(Path(self.git('rev-parse', '--path-format=absolute', '--git-path', state).stdout.strip()).is_dir()
                   for state in ('rebase-merge', 'rebase-apply'))

    def undone(self):
        assert self.git('rev-parse', 'HEAD').stdout.strip() == self.branch
        assert self.git('rev-parse', 'HEAD^{tree}').stdout == self.git('rev-parse', self.branch + '^{tree}').stdout
        assert not self.git('status', '--porcelain', '--untracked-files=all').stdout
        assert not self.rebasing()


def stopped(directory, main, branch, base=STATUS):
    return Stopped(directory, {PATH: base}, {PATH: main}, {PATH: branch})


def refuses(lab, reason):
    before = lab.state()
    code, output = lab.resolve()
    assert code == 1 and f'stops {PATH}: ' in output and reason in output, (code, output)
    assert lab.state() == before


def rows_kept(directory):
    lab = stopped(directory, changed('a', 'main'), changed('b', 'branch'))
    # Worktree markers are not an input, and commit hooks must not run.
    (lab.root / PATH).write_text('markers deliberately replaced\n')
    hooks = directory / 'hooks'
    hooks.mkdir()
    (hooks / 'pre-commit').write_text('#!/bin/sh\nexit 77\n')
    (hooks / 'pre-commit').chmod(0o700)
    lab.git('config', 'core.hooksPath', str(hooks))
    lab.git('config', 'trailer.where', 'start')
    code, output = lab.resolve()
    assert code == 0 and f'resolved {PATH} in ' in output, (code, output)
    text = (lab.root / PATH).read_text()
    assert '| `a.md` | main | remaining |' in text and '| `b.md` | branch | remaining |' in text
    for field in ('%an', '%ae', '%aI', '%s'):
        assert lab.git('show', '-s', f'--format={field}', 'HEAD').stdout == lab.git('show', '-s', f'--format={field}', lab.branch).stdout
    message = lab.git('show', '-s', '--format=%B').stdout
    assert message.startswith(MESSAGE)
    assert 'Reviewed-by: Fixture <fixture@invalid>\nRebase-Resolved: ' in message
    assert f'{PATH}: table rows: main changed `a.md`; this commit changed `b.md`' in message
    assert not lab.rebasing()
    assert not lab.git('status', '--porcelain').stdout


def row_added(directory):
    lab = stopped(directory, STATUS + '| `d.md` | main | added |\n', changed('c', 'branch'))
    code, output = lab.resolve()
    assert code == 0, output
    text = (lab.root / PATH).read_text()
    assert text.endswith('| `c.md` | branch | remaining |\n| `d.md` | main | added |\n')
    assert 'main added `d.md`; this commit changed `c.md`' in output
    # A branch addition follows the nearest predecessor kept after a deletion.
    module = runpy.run_path(str(SCRIPT))
    rule = module['table_rows']
    main = ''.join(line for line in STATUS.splitlines(keepends=True) if not line.startswith('| `b.md`'))
    branch = STATUS.replace('| `c.md`', '| `d.md` | branch | added |\n| `c.md`')
    merged, how = rule(STATUS, main, branch)
    assert merged == main.replace('| `c.md`', '| `d.md` | branch | added |\n| `c.md`'), merged
    assert how == 'table rows: main deleted `b.md`; this commit added `d.md`', how
    base_rows = STATUS.splitlines(keepends=True)[6:]
    main_rows = main.splitlines(keepends=True)[6:]
    branch_rows = branch.splitlines(keepends=True)[6:]
    merged_rows, _ = module['merge_rows'](base_rows, main_rows, branch_rows, 3)
    assert ''.join(merged_rows) == ''.join(merged.splitlines(keepends=True)[6:])


def added_in_one_place(directory):
    lab = stopped(directory, STATUS + '| `d.md` | main | added |\n',
                  STATUS + '| `e.md` | branch | added |\n')
    code, output = lab.resolve()
    assert code == 0, output
    text = (lab.root / PATH).read_text()
    assert text.endswith('| `c.md` | no | all |\n| `d.md` | main | added |\n'
                         '| `e.md` | branch | added |\n'), text
    message = lab.git('show', '-s', '--format=%B').stdout
    assert (f'Rebase-Resolved: {PATH}: table rows: main added `d.md`; '
            'this commit added `e.md`') in message, message


