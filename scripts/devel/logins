#!/usr/bin/env -S python3 -S
"""A login is a private file or a program's configuration directory.

logins add NAME PATH
logins take NAME --as HOLDER [--note TEXT] [--wait SECONDS | --now]
logins take POOL --any --as HOLDER [--note TEXT] [--wait SECONDS | --now]
logins give NAME --as HOLDER
logins list [NAME]
"""
import argparse
from contextlib import ExitStack, contextmanager
from datetime import datetime, timezone
import errno
import fcntl
import json
import math
import os
from pathlib import Path
import re
import stat
import sys
import tempfile
import time

os.umask(0o077)
NAME = r'[a-z][a-z0-9-]*'
HOLDER = r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*'
STALE_SECONDS = 900
STATE_FILES = ('login', 'holder.json', 'waiting.json', 'log.tsv', 'lock')


class Problem(Exception):
    def __init__(self, why, code=2):
        super().__init__(why)
        self.code = code


def need(ok, why, code=2):
    if not ok:
        raise Problem(why, code)


def timestamp():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def utc(value):
    need(isinstance(value, str) and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ', value),
         f'invalid UTC time: {value}', 4)
    return datetime.fromisoformat(value.replace('Z', '+00:00'))


def replace(path, data, mode=0o600):
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=f'.{path.name}-', delete=False) as target:
        temporary = Path(target.name)
        try:
            target.write(data)
            target.flush()
            os.chmod(temporary, mode)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def login_check(path):
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return 'missing'
    if stat.S_ISLNK(info.st_mode):
        return 'a link'
    directory = stat.S_ISDIR(info.st_mode)
    if not stat.S_ISREG(info.st_mode) and not directory:
        return 'not a regular file or directory'
    descriptor = None
    if directory:
        try:
            descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except FileNotFoundError:
            return 'missing'
        except OSError as error:
            if error.errno in (errno.ELOOP, errno.ENOTDIR):
                return 'a link' if os.path.islink(path) else 'not a regular file or directory'
            raise
    try:
        if directory:
            info = os.fstat(descriptor)
            if not stat.S_ISDIR(info.st_mode):
                return 'not a regular file or directory'
        if info.st_uid != os.geteuid():
            return 'not ours'
        if stat.S_IMODE(info.st_mode) != (0o700 if directory else 0o600):
            return 'not private'
        if directory:
            with os.scandir(descriptor) as entries:
                if next(entries, None) is None:
                    return 'empty'
        elif info.st_size == 0:
            return 'empty'
        return None
    finally:
        if descriptor is not None:
            os.close(descriptor)


def note_ok(value):
    return isinstance(value, str) and len(value) <= 120 and not any(c in value for c in '\t\n\r')


def duration(seconds):
    minutes = max(0, int(seconds)) // 60
    return f'{minutes // 60}:{minutes % 60:02}'


def elapsed(now, since):
    return max(0, int((now - utc(since)).total_seconds()))


def pool_of(name):
    stem = re.sub(r'-[0-9]+$', '', name)
    return None if re.search(r'-[0-9]+$', stem) else stem


def matches(row, name):
    return row['request'] == (pool_of(name) if row['pool'] else name)


def order(row):
    return row['since'], row['holder']


class Workspace:
    def __init__(self):
        self.kit = Path(__file__).resolve().parent
        agents = self.kit.parent.parent
        self.root = Path(os.environ.get('DEV_ROOT', agents.parent if agents.name == 'agents'
                                        else Path.home() / 'src/rust')).expanduser().absolute()
        self.tmp = Path(os.environ.get('DEV_TMP', self.root / 'tmp')).expanduser().absolute()
        self.logins = self.tmp / 'logins'
        self.safe(self.tmp)
        self.safe(self.logins)

    @staticmethod
    def safe(path):
        need(not path.is_symlink(), f'{path}: symlink refused', 4)
        return path

    def directory(self, name):
        self.safe(self.logins)
        path = self.safe(self.logins / name)
        if path.exists():
            need(path.is_dir() and stat.S_IMODE(path.stat().st_mode) == 0o700,
                 f'{path}: expected a private directory (0700)', 4)
        for filename in STATE_FILES:
            target = self.safe(path / filename)
            if filename != 'login' and target.exists():
                info = target.stat()
                need(stat.S_ISREG(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o600,
                     f'{target}: expected a private regular file (0600)', 4)
        return path

    def private(self, filename):
        path = self.safe(self.logins / filename)
        if path.exists():
            info = path.stat()
            need(stat.S_ISREG(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o600 and info.st_nlink == 1,
                 f'{path}: expected a private regular file (0600) with one link', 4)
        return path

    @contextmanager
    def locked(self, create=None, readonly=False, queue_readonly=False):
        self.safe(self.tmp)
        self.safe(self.logins)
        self.logins.mkdir(mode=0o700, parents=True, exist_ok=True)
        need(self.logins.is_dir() and stat.S_IMODE(self.logins.stat().st_mode) == 0o700,
             f'{self.logins}: expected a private directory (0700)', 4)
        path = self.private('lock')
        with path.open('a') as lock:
            fcntl.flock(lock, fcntl.LOCK_SH if readonly else fcntl.LOCK_EX)
            self.private('lock')
            self.private('waiting.json')
            if create is not None:
                self.directory(create).mkdir(mode=0o700, exist_ok=True)
            # A killed queue write can leave its private temporary file behind.
            names = sorted(path.name for path in self.logins.iterdir()
                           if path.name not in ('lock', 'waiting.json')
                           and not path.name.startswith('.waiting.json-'))
            with ExitStack() as stack:
                self.logins_by_name = {}
                for name in names:
                    need(re.fullmatch(NAME, name), f'invalid login name: {name}', 4)
                    directory = self.directory(name)
                    need(directory.is_dir(), f'{directory}: not a directory', 4)
                    # Old processes know only this lock; always take it after the tool's lock.
                    old_lock = stack.enter_context((directory / 'lock').open('a'))
                    fcntl.flock(old_lock, fcntl.LOCK_EX)
                    self.directory(name)
                    self.logins_by_name[name] = Login(name, directory)
                self.waiting = self.read_waiting()
                previous = [dict(row) for row in self.waiting]
                legacy = []
                now = utc(timestamp())
                for name, login in self.logins_by_name.items():
                    old = login.directory / 'waiting.json'
                    if not old.exists():
                        continue
                    for row in login.read('waiting.json', []):
                        if not readonly and elapsed(now, row['seen']) > STALE_SECONDS:
                            continue
                        entry = next((entry for entry in self.waiting
                                      if (entry['holder'], entry['request'], entry['pool'])
                                      == (row['holder'], name, False)), None)
                        if entry is None:
                            self.waiting.append(dict(row, request=name, pool=False))
                        else:
                            entry['since'] = min(entry['since'], row['since'])
                            entry['seen'] = max(entry['seen'], row['seen'])
                    legacy.append(old)
                if not readonly:
                    self.waiting = [row for row in self.waiting
                                    if elapsed(now, row['seen']) <= STALE_SECONDS and not self.served(row)]
                    # Persist the merged queue before deleting any old copy: retries are safe.
                    if not queue_readonly and (legacy or self.waiting != previous):
                        self.write_waiting()
                    for old in legacy if not queue_readonly else []:
                        old.unlink()
                yield self

    def served(self, row):
        # An old process grants by name outside this queue: its row then waits for nothing.
        login = None if row['pool'] else self.logins_by_name.get(row['request'])
        current = login.read('holder.json', None) if login else None
        return bool(current) and current['holder'] == row['holder']

    def read_waiting(self):
        path = self.private('waiting.json')
        if not path.exists():
            return []
        rows = json.loads(path.read_text())
        need(isinstance(rows, list), f'{path}: invalid state', 4)
        keys = {'holder', 'request', 'pool', 'note', 'since', 'seen'}
        for row in rows:
            need(isinstance(row, dict) and set(row) == keys, f'{path}: invalid state', 4)
            need(isinstance(row['holder'], str) and re.fullmatch(HOLDER, row['holder'])
                 and note_ok(row['note']), f'{path}: invalid holder or note', 4)
            need(isinstance(row['request'], str) and re.fullmatch(NAME, row['request'])
                 and type(row['pool']) is bool
                 and (not row['pool'] or pool_of(row['request']) == row['request']),
                 f'{path}: invalid request or pool', 4)
            utc(row['since'])
            utc(row['seen'])
        need(len({(row['holder'], row['request'], row['pool']) for row in rows}) == len(rows),
             f'{path}: duplicate request', 4)
        return rows

    def write_waiting(self):
        replace(self.private('waiting.json'), (json.dumps(self.waiting) + '\n').encode())

    def login(self, name):
        need(name in self.logins_by_name, f'unknown login: {name}')
        return self.logins_by_name[name]

    def members(self, pool):
        return sorted((name for name in self.logins_by_name if pool_of(name) == pool),
                      key=lambda name: (name != pool, int(name[len(pool) + 1:] or '0')
                                        if name != pool else 0, name))

    def take(self, request, pool, holder, note, now_only=False):
        if pool:
            need(pool_of(request) == request, f'not a pool: {request}')
            need(self.members(request), f'unknown pool: {request}')
        else:
            login = self.login(request)
            current = login.read('holder.json', None)
            if not now_only and current and current['holder'] == holder:
                need(login_check(login.path) is None,
                     f'{request} is held by {holder} and not at rest', 1)
                print(login.path)
                return None
        stamp = timestamp()
        now = utc(stamp)
        entry = None if now_only else next((row for row in self.waiting
                      if (row['holder'], row['request'], row['pool']) == (holder, request, pool)), None)
        if entry is None:
            entry = dict(holder=holder, request=request, pool=pool, note=note, since=stamp, seen=stamp)
            if not now_only:
                self.waiting.append(entry)
        entry['seen'] = stamp
        free = {name for name, login in self.logins_by_name.items()
                if login.read('holder.json', None) is None and login_check(login.path) is None}
        reserved = {}
        for row in [*sorted(self.waiting, key=order), entry] if now_only else sorted(self.waiting, key=order):
            choices = self.members(row['request']) if row['pool'] else [row['request']]
            available = next((name for name in choices if name in free and name not in reserved), None)
            if row is entry:
                if available is not None:
                    login = self.logins_by_name[available]
                    event = login.event_text(stamp, 'take', holder, elapsed(now, entry['since']), entry['note'])
                    # Custody is saved before removing the request and printing the grant.
                    login.write('holder.json', dict(holder=holder, note=entry['note'], since=stamp))
                    if not now_only:
                        self.waiting.remove(entry)
                        self.write_waiting()
                    replace(login.directory / 'log.tsv', event)
                    print(f'{available} {login.path}' if pool else login.path)
                    return None
                break
            if available is not None:
                reserved[available] = row['holder']
        if not now_only:
            self.write_waiting()
        if pool:
            return f'{request} has no free login available' + ('' if now_only else '; waiting')
        current = login.read('holder.json', None)
        if current:
            return f'{request} held by {current["holder"]} since {current["since"]}'
        if login_check(login.path) is not None:
            return f'{request} is not at rest and held by nobody'
        return f'{request} waits for {reserved[request]} first'


class Login:
    def __init__(self, name, directory):
        self.name, self.directory = name, directory
        self.path = directory / 'login'

    def read(self, filename, default):
        path = self.directory / filename
        if not path.exists():
            return default
        value = json.loads(path.read_text())
        rows = value if filename == 'waiting.json' else [value]
        need(isinstance(rows, list), f'{path}: invalid state', 4)
        keys = {'holder', 'note', 'since'} | ({'seen'} if filename == 'waiting.json' else set())
        for row in rows:
            need(isinstance(row, dict) and set(row) == keys, f'{path}: invalid state', 4)
            need(isinstance(row['holder'], str) and re.fullmatch(HOLDER, row['holder'])
                 and note_ok(row['note']), f'{path}: invalid holder or note', 4)
            utc(row['since'])
            if 'seen' in row:
                utc(row['seen'])
        need(len({row['holder'] for row in rows}) == len(rows), f'{path}: duplicate holder', 4)
        return value

    def write(self, filename, value):
        replace(self.directory / filename, (json.dumps(value) + '\n').encode())

    def event_text(self, stamp, event, holder='', seconds=0, note=''):
        path = self.directory / 'log.tsv'
        previous = path.read_text() if path.exists() else ''
        return (previous + f'{stamp}\t{event}\t{holder}\t{seconds}\t{note}\n').encode()

    def add(self, source):
        need(not self.path.exists() and self.read('holder.json', None) is None,
             f'{self.name} already has a login or holder', 1)
        reason = login_check(source)
        need(reason is None, f'{source}: {reason}', 1)
        event = self.event_text(timestamp(), 'add')
        try:
            os.rename(source, self.path)
        except OSError as error:
            if error.errno == errno.EXDEV:
                raise Problem('move it on the same filesystem', 1) from None
            raise
        replace(self.directory / 'log.tsv', event)
        print(f'added: {self.name} at {self.path}')

    def give(self, holder):
        current = self.read('holder.json', None)
        if current is not None:
            need(current['holder'] == holder, f'{self.name} is held by {current["holder"]}')
        reason = login_check(self.path)
        need(reason is None, f'{self.name} is not back at {self.path}: {reason}', 1)
        # qa-flow.md 10: retry a give whose caller died before saving its result.
        if current is None:
            print(f'already free: {self.name}')
            return
        stamp = timestamp()
        seconds = elapsed(utc(stamp), current['since'])
        event = self.event_text(stamp, 'give', holder, seconds, current['note'])
        # qa-flow.md 10: a lost login keeps its holder until it is really back.
        (self.directory / 'holder.json').unlink()
        replace(self.directory / 'log.tsv', event)
        print(f'given: {self.name} by {holder} after {duration(seconds)}')

    def show(self, waiting):
        current = self.read('holder.json', None)
        now = utc(timestamp())
        at_rest = login_check(self.path) is None
        state = 'at rest' if at_rest else 'missing'
        held = elapsed(now, current['since']) if current else 0
        if current:
            note = f' ({current["note"]})' if current['note'] else ''
            state = (f'held by {current["holder"]}{note} since {current["since"]}, '
                     f'{duration(held)}, ' + ('at rest' if at_rest else 'not at rest'))
        takes, longest = 0, 0
        path = self.directory / 'log.tsv'
        for line in path.read_text().splitlines() if path.exists() else []:
            fields = line.split('\t')
            need(len(fields) == 5, f'{path}: invalid event', 4)
            stamp, event, holder, seconds, note = fields
            need(event in ('add', 'take', 'give') and seconds.isdecimal()
                 and (not holder or re.fullmatch(HOLDER, holder)) and note_ok(note),
                 f'{path}: invalid event', 4)
            age = (now - utc(stamp)).total_seconds()
            if 0 <= age <= 86400:
                if event == 'give':
                    held += int(seconds)
                elif event == 'take':
                    takes += 1
                    longest = max(longest, int(seconds))
        print(f'{self.name}: {state}')
        for row in sorted(waiting, key=order):
            if matches(row, self.name):
                pool = f' (any of {row["request"]})' if row['pool'] else ''
                print(f'  waiting: {row["holder"]} since {row["since"]}{pool}')
        print(f'  last 24 hours: held {duration(held)}, {takes} takes, longest wait {duration(longest)}')


def seconds(value):
    result = float(value)
    if not math.isfinite(result) or result < 0:
        raise argparse.ArgumentTypeError('seconds must be finite and nonnegative')
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    add = sub.add_parser('add')
    add.add_argument('name')
    add.add_argument('path', type=Path, help="private file or program's configuration directory")
    take = sub.add_parser('take')
    take.add_argument('name')
    take.add_argument('--any', action='store_true', dest='pool')
    take.add_argument('--as', dest='holder', required=True)
    take.add_argument('--note', default='')
    timing = take.add_mutually_exclusive_group()
    timing.add_argument('--wait', type=seconds)
    timing.add_argument('--now', action='store_true')
    give = sub.add_parser('give')
    give.add_argument('name')
    give.add_argument('--as', dest='holder', required=True)
    sub.add_parser('list').add_argument('name', nargs='?')
    args = parser.parse_args()
    try:
        if args.name is not None:
            need(re.fullmatch(NAME, args.name), 'invalid login name')
        if hasattr(args, 'holder'):
            need(re.fullmatch(HOLDER, args.holder), 'invalid holder name')
        if args.command == 'take':
            need(note_ok(args.note), '--note needs at most 120 characters and no newline or tab')
        workspace = Workspace()
        if args.command == 'list':
            with workspace.locked(readonly=True):
                names = [args.name] if args.name else workspace.logins_by_name
                for name in names:
                    workspace.login(name).show(workspace.waiting)
        elif args.command == 'add':
            reason = login_check(args.path)
            need(reason is None, f'{args.path}: {reason}', 1)
            with workspace.locked(create=args.name):
                workspace.login(args.name).add(args.path)
        elif args.command == 'give':
            with workspace.locked():
                workspace.login(args.name).give(args.holder)
        else:
            poll = float(os.environ.get('LOGINS_POLL_SECONDS', '5'))
            need(math.isfinite(poll) and poll > 0, 'LOGINS_POLL_SECONDS must be finite and positive')
            deadline = time.monotonic() + (args.wait or 0)
            while True:
                with workspace.locked(queue_readonly=args.now):
                    reason = workspace.take(args.name, args.pool, args.holder, args.note, args.now)
                if reason is None:
                    break
                remaining = deadline - time.monotonic()
                need(args.wait is not None and remaining > 0, reason, 1)
                time.sleep(min(poll, remaining))
        return 0
    except Problem as error:
        print(f'logins: {error}', file=sys.stderr)
        return error.code
    except (OSError, ValueError, UnicodeError) as error:
        print(f'logins: {error}', file=sys.stderr)
        return 4


if __name__ == '__main__':
    sys.exit(main())
