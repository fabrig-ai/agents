"""


def write(path, content, mode):
    """Replace path whole: a reader sees the old file or the new one."""
    import tempfile

    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    out = tempfile.NamedTemporaryFile('w', encoding='utf-8', dir=path.parent, prefix='.' + path.name + '.',
                                      delete=False)
    try:
        with out:
            out.write(content)
            out.flush()
            os.fsync(out.fileno())
        os.chmod(out.name, mode)
        os.replace(out.name, path)
    except BaseException:
        Path(out.name).unlink(missing_ok=True)
        raise

# Only these public fields may become text. Every other input is projected to
# numbers, fixed enums or opaque join keys before rendering. Never echo errors.
def safe_plan(value):
    return value if value in ('max', 'pro', 'plus', 'team', 'enterprise', 'free', 'business', 'max_5x', 'max_20x') else ''


def safe_limit(value):
    # Neither backend display names nor arbitrary Claude text is public.
    return value if isinstance(value, str) and re.fullmatch(
        r'(?:other )?(?:limit|session|week|\d+ (?:h|d|min)|[0-9]+ (?:hours?|days?))'
        r'(?: \(all models\)| \(Sonnet only\))?', value) else 'limit'


STEPS = ('fmt', 'clippy', 'wasm', 'build', 'focused', 'fuzzy', 'bundle', 'browser',
         'precheck', 'rebase', 'test', 'push', 'select', 'merge')
STATES = ('queued', 'active', 'paused', 'done')
OUTCOMES = ('green', 'red', 'conflict', 'failed', 'cancelled', 'skipped')
PRIVATE = re.compile(r'lead/|\bs/[a-z]|coord-next|sessionId|@|(?:/|~)[\w./-]+|'
                     r'\b(?:token|password|secret|subject|session)\b', re.I)


def public(value, identifier=False):
    """Draft ids and source headings are declared public by the producer.

    Reject obvious private syntax even in those fields. This cannot decide
    whether arbitrary prose names a person: producers must keep headings public.
    """
    if not isinstance(value, str) or not value.strip() or len(value) > 300 or PRIVATE.search(value):
        return 'unknown'
    if identifier and not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,79}', value):
        return 'unknown'
    return value.strip()


def failure(error):
    if isinstance(error, (TimeoutError, subprocess.TimeoutExpired)):
        return 'timed out'
    if isinstance(error, FileNotFoundError):
        return 'not found'
    if isinstance(error, PermissionError):
        return 'permission denied'
    if isinstance(error, (ValueError, TypeError, KeyError)):
        return 'invalid data'
    return 'probe failed'


def tmp_dir():
    return Path(os.environ.get('DEV_TMP', Path.home() / 'src/rust/tmp')).expanduser().absolute()


def collect():
    tmp, now = tmp_dir(), clock()
    result = {'time': now, 'errors': {}}
    probes = [('machine', part_machine), ('claude_usage', part_claude_usage),
              ('codex_usage', part_codex_usage)]
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
        futures = [(key, pool.submit(probe, tmp, now)) for key, probe in probes]
        for key, future in futures:
            try:
                result[key] = future.result()
            except Exception as error:
                result['errors'][key] = failure(error)
    return result


def read_toml(path):
    with path.open('rb') as stream:
        return tomllib.load(stream)


def timestamp(value):
    if isinstance(value, datetime):
        return value.timestamp() if value.tzinfo else None
    return number(value) if number(value) is not None else stamp(value)


def events(root, source):
    """No files is a successful empty source. Malformed files fail that source."""
    result, seen = [], set()
    for path in sorted((root / 'events' / source).glob('*/*.jsonl')):
        for line in path.read_text().splitlines():
            row = json.loads(line)
            if not isinstance(row, dict) or row.get('source') != source or timestamp(row.get('time')) is None:
                raise ValueError('invalid event')
            identity = row.get('id')
            if not isinstance(identity, str) or not isinstance(row.get('kind'), str):
                raise ValueError('invalid event')
            key = (row.get('host'), identity)
            if key not in seen:
                result.append(row)
                seen.add(key)
    return sorted(result, key=lambda row: timestamp(row['time']))


def drafts(root, fabrig):
    priorities = root / 'director/priorities.toml'
    order = {}
    if priorities.exists():
        for i, entry in enumerate(read_toml(priorities)['draft']):
            order[entry['name']] = i
    result = []
    for path in sorted((root / 'drafts').glob('*/draft.toml')):
        row = read_toml(path)
        name = path.parent.name
        state = row.get('state') if row.get('state') in STATES else 'unknown'
        description, error = 'unknown', None
        try:
            source = (fabrig / row['source']).resolve()
            if not source.is_relative_to(fabrig.resolve()):
                raise ValueError('source outside fabrig')
            # ATX or setext: read only the first Markdown heading, never body text.
            lines = source.read_text().splitlines()
            for i, line in enumerate(lines):
                heading = re.match(r'^ {0,3}#{1,6}\s+(.+?)(?:\s+#+)?\s*$', line)
                if heading:
                    description = public(heading[1])
                    break
                if i + 1 < len(lines) and line.strip() and re.fullmatch(r' {0,3}(?:=+|-+)\s*', lines[i+1]):
                    description = public(line)
                    break
            if description == 'unknown':
                error = 'invalid data'
        except Exception as exc:
            error = failure(exc)
        priority = row.get('priority')
        result.append(dict(key=name, name=public(name, True), state=state,
                           description=description, error=error,
                           rank=(order.get(name, len(order)), priority if type(priority) is int else 999999, name)))
    return sorted(result, key=lambda row: row['rank'])


def questions(root):
    asked = []
    for path in sorted((root / 'director/questions').glob('*.toml')):
        row = read_toml(path)
        if row.get('answer') or row.get('answered'):
            continue
        at = timestamp(row.get('asked'))
        if at is None:
            raise ValueError('missing question timestamp')
        asked.append(at)
    return len(asked), min(asked, default=None)


def slots():
    result = subprocess.run(['claim', 'list'], capture_output=True, text=True,
                            stdin=subprocess.DEVNULL, timeout=30)
    if result.returncode:
        raise OSError('claim failed')
    held, total = 0, 0
    for line in result.stdout.splitlines():
        # claim's public CLI: host slot [reservation]: free | holder details.
        match = re.fullmatch(r'\S+\s+\d+\s+\[[^\]\n]+\]:\s*(.+)', line)
        if not match:
            raise ValueError('invalid claim response')
        total += 1
        held += match[1].strip() != 'free'
    if not total:
        raise ValueError('no slots returned')
    return held, total


def session_role(name):
    """Classify the collector's pipeline names; never return the name."""
    name = text(name).split('@', 1)[0]
    parts = name.split('/')
    if parts[0] == 'lead' and len(parts) >= 2:
        return 'leads'
    if ((parts[0] == 'coordinator' and len(parts) >= 2)
            or (parts[0] == 's' and len(parts) == 2)
            or name in ('coord-next', 'coordinator-next', 'coordinator')):
        return 'coordinators'
    return None


def live_count(rows, source):
    """Replay record-collect's lifecycle, rename and current context events."""
    live = {}
    for row in rows:
        kind = row['kind']
        key = (row.get('host'), row.get('run' if source == 'runs' else 'session'))
        if source == 'runs':
            if kind == 'run-start':
                live[key] = row
            elif kind == 'run-end':
                live.pop(key, None)
        elif kind in ('session-start', 'session-name', 'context'):
            live[key] = row
        elif kind == 'session-end':
            live.pop(key, None)
    count = {'runs': len(live) if source == 'runs' else 0, 'leads': 0, 'coordinators': 0}
    if source == 'sessions':
        for row in live.values():
            role = session_role(row.get('name'))
            if role:
                count[role] += 1
    return count


def queue_data(rows, now):
    """Queue attempts count branch landings; batch records supply gate timing."""
    batches = {}
    for row in rows:
        if row['kind'] == 'batch':
            start, end = timestamp(row.get('start')), timestamp(row.get('end'))
            duration = end - start if start is not None and end is not None and end >= start else None
            batches[(row.get('host'), row.get('start'))] = dict(
                time=timestamp(row['time']), duration=duration, dry=row.get('dry') is True,
                outcome=row.get('outcome') if row.get('outcome') in OUTCOMES else 'unknown')
    landings, rejects = [], {}
    for row in rows:
        if row['kind'] != 'attempt':
            continue
        batch = batches.get((row.get('host'), row.get('batch_start')))
        # Without its batch we cannot know whether this attempt was a dry run.
        if batch is None or batch['dry']:
            continue
        if row.get('outcome') == 'green':
            landings.append((timestamp(row['time']), row.get('draft')))
        elif row.get('outcome') in ('red', 'conflict'):
            step = row.get('rejected_step')
            step = step if step in STEPS else 'other'
            rejects[step] = rejects.get(step, 0) + 1
    buckets = [(now - (6-i)*HOUR, now - (5-i)*HOUR) for i in range(6)]
    return dict(landings=landings, batches=sorted(batches.values(), key=lambda r:r['time'], reverse=True),
                rejects=rejects,
                hours=[(a, b, sum(a <= t < b or (b == now and t == now) for t, _ in landings)) for a,b in buckets])


EFFORTS = ('minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra')
COST_FIELDS = ('minutes', 'tokens_in', 'tokens_cached', 'tokens_out')


def draft_group(row):
    name = public(row.get('draft'), True)
    return name if name != 'unknown' else 'unattributed'


def add_cost(group, key, fields):
    """A missing measurement makes its aggregate unknown, rather than zero."""
    total = group.setdefault(key, {field: 0 for field in fields})
    for field, value in fields.items():
        if value is None or total[field] is None:
            total[field] = None
        else:
            total[field] += value


def nonnegative(value):
    value = number(value)
    return value if value is not None and value >= 0 else None


def cost_data(sources, now, window):
    result = {'runs': {}, 'heavy': {}, 'queue': {}}
    kinds = {'runs': 'run-end', 'heavy': 'command', 'queue': 'batch'}
    for source, groups in result.items():
        rows = sources.get(source)
        if rows is None:
            result[source] = None
            continue
        for row in rows:
            at = timestamp(row['time'])
            if row['kind'] != kinds[source] or not now-window <= at <= now:
                continue
            draft = draft_group(row)
            if source == 'runs':
                effort = row.get('effort') if row.get('effort') in EFFORTS else 'other'
                fields = {key: nonnegative(row.get(key)) for key in COST_FIELDS}
                for key in ((None, None), (None, effort), (draft, None), (draft, effort)):
                    add_cost(groups, key, fields)
            elif source == 'heavy':
                lane = row.get('lane') if row.get('lane') in ('build', 'test') else 'other'
                fields = {key: 0 for key in ('build', 'build_wait', 'test', 'test_wait', 'other', 'other_wait')}
                run, wait = nonnegative(row.get('run_s')), nonnegative(row.get('wait_s'))
                fields[lane] = run / 60 if run is not None else None
                fields[lane + '_wait'] = wait / 60 if wait is not None else None
                for key in (None, draft):
                    add_cost(groups, key, fields)
            else:
                # Top-level gates already include suites; summing both doubles cost.
                steps = row.get('steps')
                gate = 0 if isinstance(steps, list) else None
                for step in steps if isinstance(steps, list) else []:
                    duration = nonnegative(shaped(step, {}).get('duration'))
                    gate = gate + duration / 60 if gate is not None and duration is not None else None
                for key in (None, draft):
                    add_cost(groups, key, {'gate': gate})
    return result


def cost_cell(value, tokens=False):
    return 'unknown' if value is None else f'{value:,.0f}' if tokens else f'{value:,.2f}'


def costs(sources, now, errors):
    out = []
    for window, title in ((DAY, 'Last 24 hours'), (HOUR, 'Last hour')):
        out.append('<h3>' + title + '</h3>')
        data = cost_data(sources, now, window)
        for source, label_, heads in (
                ('runs', 'Codex runs', ['Draft', 'Effort', 'Run min', 'Input tokens', 'Cached tokens', 'Output tokens']),
                ('heavy', 'Heavy commands', ['Draft', 'Build min', 'Build wait min', 'Test min', 'Test wait min', 'Other min', 'Other wait min']),
                ('queue', 'Queue gates', ['Draft', 'Gate min'])):
            out.append('<h4>' + label_ + '</h4>')
            groups = data[source]
            if groups is None:
                out.append(unknown(errors.get(source, 'source unavailable')))
            elif not groups:
                out.append('<p class="empty">' + ('no events yet' if not sources.get(source) else 'No completed events in this window.') + '</p>')
            else:
                rows = []
                if source == 'runs':
                    for (draft, effort), fields in sorted(groups.items(), key=lambda item: (item[0][0] is not None, item[0][0] or '', item[0][1] is not None, item[0][1] or '')):
                        rows.append([E(draft or 'Total'), E(effort or 'all')] + [cost_cell(fields[key], key != 'minutes') for key in COST_FIELDS])
                else:
                    keys = ('build', 'build_wait', 'test', 'test_wait', 'other', 'other_wait') if source == 'heavy' else ('gate',)
                    for draft, fields in sorted(groups.items(), key=lambda item: (item[0] is not None, item[0] or '')):
                        rows.append([E(draft or 'Total')] + [cost_cell(fields[key]) for key in keys])
                out.append(table(heads, rows, numeric_from=2 if source == 'runs' else 1))
    return ''.join(out)


def gather_page(root, fabrig, machines_file, pulling, source):
    data = {'time': clock(), 'errors': {}, 'sources': {}, 'fleet': {}, 'machines': []}

    def read(key, operation):
        try:
            data['sources'][key] = operation()
        except Exception as error:
            data['sources'][key] = None
            data['errors'][key] = failure(error)

    if pulling:
        read('pull', lambda: pull())
        if data['sources'].get('pull'):
            data['errors']['pull'] = data['sources']['pull']
    if not root.is_dir():
        for key in ('drafts', 'questions', 'queue', 'runs', 'heavy', 'claims', 'sessions'):
            data['sources'][key] = None
            data['errors'][key] = 'not found'
    else:
        read('drafts', lambda: drafts(root, fabrig))
        read('questions', lambda: questions(root))
        for key in ('queue', 'runs', 'heavy', 'claims', 'sessions'):
            read(key, lambda key=key: events(root, key))
    read('slots', slots)
    try:
        pairs = machines(machines_file)
    except Exception as error:
        data['errors']['machines'] = failure(error)
        pairs = []
    data['machines'] = [name for name, _ in pairs]
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, len(pairs))) as pool:
        futures = [(name, pool.submit(gather, target, source)) for name, target in pairs]
        for name, future in futures:
            try:
                data['fleet'][name] = future.result()
            except Exception as error:
                data['fleet'][name] = {'errors': {'machine': failure(error)}}
    return data


def unknown(reason):
    return f'<p class="empty">unknown · {E(reason)}</p>'


def render(data, samples=None, site=None):
    now, sources, errors = data['time'], data['sources'], dict(data['errors'])
    body = []

    def section(title, key, build):
        body.append(f'<h2>{E(title)}</h2><div class="panel">')
        try:
            if sources.get(key) is None:
                body.append(unknown(errors.get(key, 'source unavailable')))
            else:
                body.append(build(sources[key]))
        except Exception as error:
            errors[key] = failure(error)
            body.append(unknown(errors[key]))
        body.append('</div>')

    try:
        queue = queue_data(sources['queue'], now) if sources.get('queue') is not None else None
    except Exception as error:
        queue = None
        sources = dict(sources, queue=None)
        errors['queue'] = failure(error)
    def count_running():
        try:
            return str(live_count(sources['runs'], 'runs')['runs']) if sources.get('runs') else 'no events yet' if sources.get('runs') == [] else 'unknown'
        except Exception:
            return 'unknown'
    projected_usage = [(public(name, True), cli, subscription_data(shaped(machine, {}).get(cli + '_usage')))
                       for name, machine in data['fleet'].items() for cli in ('claude', 'codex')]
    subscribed, _ = merged_subscriptions(SimpleNamespace(usage=projected_usage))
    tiles = [('Drafts', str(len(sources['drafts'])) if sources.get('drafts') is not None else 'unknown'),
             ('Landings per hour', f'{sum(now-6*HOUR <= at <= now for at,_ in queue["landings"])/6:.1f}' if queue is not None else 'unknown'),
             ('Runs running', count_running()), ('Subscriptions', str(len(subscribed))),
             ('Waiting on the user', str(sources['questions'][0]) if sources.get('questions') is not None else 'unknown')]
    body.append('<div class="tiles">' + ''.join('<div class="tile"><div class="label">' + E(label_) + '</div><div class="value">' + E(value) + '</div></div>' for label_,value in tiles) + '</div>')

    def draft_table(rows):
        result = []
        for row in rows:
            last = max((at for at, draft in queue['landings'] if draft == row['key']), default=None) if queue else None
            if last is not None:
                landing = when(last, now)
            elif queue is None:
                landing = 'unknown'
            elif any(draft is None for _, draft in queue['landings']):
                landing = 'unknown · queue draft joins not collected'
            else:
                landing = 'no events yet' if not sources.get('queue') else 'no landing recorded'
            desc = E(row['description']) + (f' · {E(row["error"])}' if row['error'] else '')
            result.append([E(row['name']), desc, badge('info' if row['state']=='active' else 'neutral', row['state']), landing])
        return table(['Draft', 'Description', 'State', 'Last landing'], result, numeric_from=3, wrap=(1,), empty='No drafts yet.')

    section('Drafts', 'drafts', draft_table)

    def queue_section(rows):
        if not rows:
            return '<p class="empty">no events yet</p>'
        out = '<h3>Landings per hour · last 6 h</h3>'
        out += table(['Hour (UTC)', 'Landings'], [[E(utc(a, '%H:%M')+'–'+utc(b, '%H:%M')), str(n)] for a,b,n in queue['hours']])
        out += '<h3>Batches</h3>' + table(['Finished', 'Outcome', 'Duration'],
            [[when(r['time'],now), E(r['outcome']), E(length(r['duration'])) if r['duration'] is not None else 'unknown'] for r in queue['batches'][:20]], empty='No batches yet.')
        out += '<h3>Rejections by step</h3>' + table(['Step', 'Rejections'], [[E(k), str(v)] for k,v in sorted(queue['rejects'].items())], empty='No rejections yet.')
        out += '<p>Ready to landing: unknown · ready timestamps not collected</p>'
        return out

    section('Landings and the queue', 'queue', queue_section)
    body.append('<h2>Work in flight</h2><div class="panel">')
    for key, label_, field in [('runs', 'Runs running', 'runs'), ('sessions', 'Leads live', 'leads'),
                                ('sessions', 'Coordinators live', 'coordinators')]:
        rows = sources.get(key)
        try:
            value = 'unknown · ' + errors[key] if rows is None else str(live_count(rows, key)[field]) if rows else 'no events yet'
        except Exception as error:
            value = 'unknown · ' + failure(error)
        body.append(f'<p>{label_}: {E(value)}</p>')
    held = sources.get('slots')
    body.append('<p>Slots held / total: ' + (f'{held[0]} / {held[1]}' if held is not None else 'unknown · ' + E(errors['slots'])) + '</p>')
    claims = sources.get('claims')
    body.append('<p>Claim events: ' + ('unknown · ' + E(errors['claims']) if claims is None else str(len(claims)) if claims else 'no events yet') + '</p></div>')
    section('Waiting on the user', 'questions', lambda q: f'<p>{q[0]} open questions · oldest {when(q[1], now) if q[1] is not None else "–"}</p>')

    body.append('<h2>Costs</h2><div class="panel">' + costs(sources, now, errors) + '</div>')

    usage_rows = []
    body.append('<h2>Machines and capacity</h2><div class="cards">')
    for name in data['machines']:
        machine = shaped(data['fleet'].get(name), {})
        body.append('<div class="card"><h3>' + E(public(name, True)) + '</h3>')
        capacity = machine.get('machine')
        if not isinstance(capacity, dict):
            body.append(unknown(failure_text(machine, 'machine')))
        else:
            ips = []
            for raw in shaped(capacity.get('ips'), []):
                try:
                    address = ipaddress.ip_address(raw)
                    if address.version == 4 and address.is_global:
                        ips.append(str(address))
                except ValueError:
                    pass
            load = [number(x) for x in shaped(capacity.get('load'), [])]
            load_text = ', '.join(f'{x:.1f}' for x in load if x is not None) or 'unknown'
            cpus = number(capacity.get('cpus'))
            body.append(f'<p>{E(", ".join(ips))}</p><p>Load {load_text} · {cpus if cpus is not None else "unknown"} CPUs</p>')
            body.append(f'<p>Memory available {size(number(capacity.get("mem_available")))} / {size(number(capacity.get("mem_total")))}</p>')
            body.append(f'<p>Disk free {size(number(capacity.get("disk_free")))} / {size(number(capacity.get("disk_total")))}</p>')
        for cli in ('claude', 'codex'):
            probe = machine.get(cli + '_usage')
            if probe is None:
                errors[public(name, True) + ' ' + cli] = failure_text(machine, cli + '_usage')
                continue
            probe = subscription_data(probe)
            usage_rows.append((public(name, True), cli, probe))
        body.append('</div>')
    body.append('</div><h2>Subscriptions</h2><div class="panel">')
    fleet = SimpleNamespace(now=now, usage=usage_rows, samples=samples)
    body.append(subscriptions(fleet)[1])
    for key, reason in errors.items():
        if key.endswith((' claude', ' codex')):
            body.append(unknown(key + ': ' + reason))
    body.append('</div>')
    links = '<a href="v0.1.0.html">v0.1.0 progress</a>' if site is not None and (site / 'v0.1.0.html').is_file() else ''
    body.append('<h2>Links</h2><div class="panel">' + (links or '<p class="empty">No release page yet.</p>') + '</div>')
    notes = ''.join('<p>' + E(key + ': unknown · ' + reason) + '</p>' for key,reason in sorted(errors.items()))
    return ('<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width">'
            '<meta name="robots" content="noindex"><meta http-equiv="refresh" content="300"><title>Fabrig status</title>'
            '<style>' + STYLE + '</style></head><body><main><header><h1>Fabrig status</h1><span class="meta">Updated '
            + E(utc(now, '%Y-%m-%d %H:%M UTC')) + '</span></header>' + ''.join(body) + '<footer>' + notes + '</footer></main></body></html>')


def failure_text(machine, key):
    value = shaped(machine.get('errors'), {}).get(key)
    return value if value in ('timed out', 'not found', 'permission denied', 'invalid data', 'probe failed') else 'source unavailable'


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', nargs='?', choices=['collect'])
    parser.add_argument('--out', type=Path)
    parser.add_argument('--samples', type=Path)
    parser.add_argument('--no-pull', action='store_true')
    parser.add_argument('--machines', type=Path, default=Path.home() / 'src/rust/tmp/post/machines')
    args = parser.parse_args()
    if args.command == 'collect':
        print(json.dumps(collect()))
        return
    root = Path(os.environ.get('RECORDS_REPO', Path.home() / 'src/fabrig/records')).expanduser()
    fabrig = Path(os.environ.get('FABRIG_REPO', Path.home() / 'src/fabrig/main')).expanduser()
    data = gather_page(root, fabrig, args.machines, not args.no_pull, Path(__file__).read_bytes())
    samples = None
    if args.samples:
        try:
            samples, dropped = read_samples(args.samples)
            if dropped:
                data['errors']['samples'] = 'invalid data'
            # Get only projected subscriptions for sampling, as for rendering.
            usage_rows = [(name, cli, subscription_data(machine.get(cli + '_usage')))
                          for name, machine in data['fleet'].items() for cli in ('claude', 'codex')]
            samples = kept_samples(samples + usage_samples(SimpleNamespace(now=data['time'], usage=usage_rows)), data['time'])
            write(args.samples, ''.join(json.dumps(row) + '\n' for row in samples), 0o600)
        except Exception as error:
            data['errors']['samples'] = failure(error)
    content = render(data, samples, args.out.parent if args.out else None)
    if args.out:
        write(args.out, content, 0o644)
    else:
        print(content)


if __name__ == '__main__':
    main()
