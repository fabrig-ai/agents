def clock():
    # Fixtures fix the time; the page is otherwise about now.
    return float(os.environ.get('STATUS_NOW') or time.time())


def stamp(value):
    try:
        moment = datetime.fromisoformat(str(value).replace('Z', '+00:00'))
    except ValueError:
        return None
    return moment.timestamp() if moment.tzinfo else None


def number(value):
    ok = isinstance(value, (int, float)) and not isinstance(value, bool)
    return value if ok and math.isfinite(value) else None


def text(value):
    return value if isinstance(value, str) else ''


def part(record, name):
    value = record.get(name)
    return value if isinstance(value, dict) else {}


def part_machine(tmp, now):
    import ipaddress

    usage = shutil.disk_usage(tmp)
    memory = {}
    for line in Path('/proc/meminfo').read_text().splitlines():
        key, _, value = line.partition(':')
        if value.split():
            memory[key] = int(value.split()[0]) * 1024
    ips = []
    try:
        result = subprocess.run(['ip', '-j', '-4', 'addr', 'show', 'scope', 'global'],
                                stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=10)
        if result.returncode == 0:
            for interface in shaped(json.loads(result.stdout), []):
                for address in shaped(shaped(interface, {}).get('addr_info'), []):
                    try:
                        ip = ipaddress.ip_address(text(shaped(address, {}).get('local')))
                    except ValueError:
                        continue
                    if ip.version == 4 and ip.is_global:
                        ips.append(str(ip))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass  # The optional IP probe must not hide load, memory or disk.
    return {'ips': ips, 'load': list(os.getloadavg()), 'cpus': os.cpu_count(), 'disk_free': usage.free,
            'disk_total': usage.total, 'mem_available': memory.get('MemAvailable'),
            'mem_total': memory.get('MemTotal')}


def probe_timeout():
    return float(os.environ.get('STATUS_PROBE_TIMEOUT') or 30)


def label(cli, account, email):
    """No account text leaves the machine, even in an error."""
    import hashlib

    if not isinstance(account, str) or not isinstance(email, str):
        return ''
    return hashlib.sha256('\0'.join((cli, account, email)).encode()).hexdigest()[:8]


def plan(value):
    return value if re.fullmatch(r'[a-z0-9_]{1,40}', text(value)) else ''


def usage(state, plan_word='', identity='', limits=None):
    return {'state': state, 'plan': plan(plan_word), 'label': identity, 'limits': limits or []}


def claude_cli():
    found = shutil.which('claude')
    fallback = Path.home() / '.local/bin/claude'
    return found or (str(fallback) if fallback.is_file() and os.access(fallback, os.X_OK) else None)


def claude_reset(value, now):
    # Month words are English regardless of the machine's locale.
    match = re.fullmatch(r'(?:(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) ([0-9]{1,2}), )?'
                         r'([0-9]{1,2})(?::([0-9]{2}))?(am|pm)(?: \(UTC\))?', value)
    if not match:
        return None
    month, day, hour, minute, half = match.groups()
    hour, minute = int(hour), int(minute or 0)
    if not 1 <= hour <= 12 or minute > 59:
        return None
    hour = hour % 12 + (12 if half == 'pm' else 0)
    today = datetime.fromtimestamp(now, timezone.utc)
    threshold = now - HOUR
    if month:
        month = 'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'.split().index(month) + 1
        for year in range(today.year, today.year + 9):
            try:
                candidate = datetime(year, month, int(day), hour, minute, tzinfo=timezone.utc).timestamp()
            except ValueError:
                continue
            if candidate >= threshold:
                return candidate
        return None
    candidate = today.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if candidate.timestamp() < threshold:
        candidate += timedelta(days=1)
    return candidate.timestamp()


def part_claude_usage(tmp, now):
    """What Claude Code is signed in to here, and each limit's use."""
    cli = claude_cli()
    if not cli:
        return usage('absent')

    def ask(args):
        result = subprocess.run([cli, *args], stdin=subprocess.DEVNULL, cwd=tmp,
                                capture_output=True, text=True, timeout=probe_timeout(),
                                env=dict(os.environ, TZ='UTC'))
        try:
            answer = json.loads(result.stdout)
        except ValueError:
            raise ValueError('Claude answered invalid JSON') from None
        if not isinstance(answer, dict):
            raise ValueError('Claude answered no JSON object')
        return result.returncode, answer

    code, auth = ask(['auth', 'status', '--json'])
    if not isinstance(auth.get('loggedIn'), bool):
        raise ValueError('Claude auth lacks loggedIn')
    if not auth['loggedIn']:
        return usage('signed-out')
    if not isinstance(auth.get('subscriptionType'), str):
        return usage('no-subscription')
    code, answer = ask(['-p', '/usage', '--output-format', 'json', '--no-session-persistence',
                        '--strict-mcp-config', '--tools', '', '--model', 'haiku',
                        '--settings', '{"disableAllHooks": true}'])
    if (answer.get('local_command') != 'usage' or number(answer.get('num_turns')) != 0
            or number(answer.get('total_cost_usd')) != 0):
        raise ValueError('/usage was answered by a model')
    if code or answer.get('is_error'):
        raise ValueError('Claude /usage failed')
    limits = []
    for line in text(answer.get('result')).splitlines():
        match = re.fullmatch(r'Current ([A-Za-z0-9 ()\[\]]{1,40}): ([0-9]+(?:\.[0-9]+)?)% used'
                             r'(?: · resets (.*))?', line)
        if match:
            name, used, reset = match.groups()
            limits.append({'name': name,
                           'used': number(float(used)), 'resets': claude_reset(reset, now) if reset else None})
    if not limits:
        raise ValueError('Claude /usage has no Current limit line')
    return usage('subscribed', auth['subscriptionType'], label('claude', auth.get('orgId'), auth.get('email')), limits)


def codex_limits(answer):
    buckets = part(answer, 'rateLimitsByLimitId')
    buckets = [buckets[k] for k in sorted(buckets)] if buckets else [part(answer, 'rateLimits')]
    limits = []
    for bucket in buckets:
        if not isinstance(bucket, dict):
            continue
        prefix = ''
        if bucket.get('limitId') != 'codex':
            # Backend display names are free text and may identify an account.
            prefix = 'other '
        for field in ('primary', 'secondary'):
            window = bucket.get(field)
            if not isinstance(window, dict):
                continue
            minutes = number(window.get('windowDurationMins'))
            name = '?'
            if minutes is not None and minutes > 0 and minutes == int(minutes):
                minutes = int(minutes)
                name = ('week' if minutes == 10080 else f'{minutes // 1440} d' if minutes % 1440 == 0
                        else f'{minutes // 60} h' if minutes % 60 == 0 else f'{minutes} min')
            limits.append({'name': prefix + name, 'used': number(window.get('usedPercent')),
                           'resets': number(window.get('resetsAt'))})
    return limits


def end_probe(process):
    # The server can exit before its helpers: always address the whole group.
    try:
        process.stdin.close()
    except OSError:
        pass  # A closed reader must not prevent reaping the process group.
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + 5
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    while time.monotonic() < deadline:
        try:
            os.killpg(process.pid, 0)
        except ProcessLookupError:
            break
        time.sleep(.02)
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()
    process.stdout.close()


def part_codex_usage(tmp, now):
    """One read-only RPC exchange, with a deadline covering all answers."""
    cli = shutil.which('codex')
    if not cli:
        return usage('absent')
    deadline = time.monotonic() + probe_timeout()
    process = subprocess.Popen([cli, 'app-server'], cwd=tmp, start_new_session=True,
                               stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    buffer = b''
    try:
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)

            def send(message):
                process.stdin.write((json.dumps(message) + '\n').encode())
                process.stdin.flush()

            def ask(identity, method, params):
                nonlocal buffer
                send({'id': identity, 'method': method, 'params': params})
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise TimeoutError('Codex app-server timed out')
                    if b'\n' not in buffer:
                        if not selector.select(remaining):
                            raise TimeoutError('Codex app-server timed out')
                        chunk = os.read(process.stdout.fileno(), 65536)
                        if not chunk:
                            raise ValueError('Codex app-server closed before answering')
                        buffer += chunk
                        continue
                    line, buffer = buffer.split(b'\n', 1)
                    try:
                        answer = json.loads(line)
                    except ValueError:
                        raise ValueError('Codex app-server answered invalid JSON') from None
                    if not isinstance(answer, dict):
                        raise ValueError('Codex app-server answered no JSON object')
                    if 'id' not in answer:
                        continue
                    if answer['id'] != identity:
                        raise ValueError('Codex app-server answered an unexpected id')
                    if 'error' in answer:
                        raise ValueError(f'Codex {method} returned an error')
                    if not isinstance(answer.get('result'), dict):
                        raise ValueError(f'Codex {method} answered no result object')
                    return answer['result']

            ask(1, 'initialize', {'clientInfo': {'name': 'status-page', 'version': '1'}})
            send({'method': 'initialized'})
            account = ask(2, 'account/read', {}).get('account')
            if account is None:
                return usage('signed-out')
            if not isinstance(account, dict):
                raise ValueError('Codex account is no object')
            if account.get('type') != 'chatgpt':
                return usage('no-subscription')
            answer = ask(3, 'account/rateLimits/read', {'excludeResetCreditDetails': True})
            return usage('subscribed', account.get('planType'),
                         label('codex', answer.get('accountId'), account.get('email')), codex_limits(answer))
    finally:
        end_probe(process)


def machines(path):
    result = []
    for line in path.read_text().splitlines():
        # As post reads it: what follows a # is a comment.
        fields = line.split('#', 1)[0].split()
        if not fields:
            continue
        if len(fields) != 2 or not re.fullmatch(r'[a-z][a-z0-9-]*', fields[0]) or fields[1].startswith('-'):
            raise ValueError(f'invalid machines file line: {line!r}')
        result.append(tuple(fields))
    if not result:
        raise ValueError('machines file names no machine')
    return result


UNREACHED = [('Connection timed out', 'connection timed out'), ('Connection refused', 'connection refused'),
             ('Permission denied', 'key refused'), ('Host key verification failed', 'host key not accepted'),
             ('Could not resolve', 'name not resolved'), ('No route to host', 'no route'),
             ('Network is unreachable', 'no route')]


def gather(target, source):
    if target == 'local':
        return collect()
    # The collector is this very script, so no machine needs it installed.
    try:
        result = subprocess.run([*SSH, target, REMOTE], input=source, capture_output=True, timeout=120)
    except subprocess.TimeoutExpired:
        raise OSError('no answer in 120 s') from None
    if result.returncode:
        reason = result.stderr.decode(errors='replace').strip()
        print(f'status-page: {target}: exited {result.returncode}', *reason.splitlines(), sep='\n  ',
              file=sys.stderr)
        if result.returncode != 255:
            raise OSError(f'the collector exited {result.returncode}')
        raise OSError(next((why for words, why in UNREACHED if words in reason), 'ssh exited 255'))
    data = json.loads(result.stdout)
    if not isinstance(data, dict):
        raise ValueError('the collector answered no JSON object')
    return data


def pull():
    """record pull, stopped with an interrupt on timeout, so that its own
    rollback runs and leaves the checkout whole."""
    process = subprocess.Popen(['record', 'pull'], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, text=True)
    try:
        _, err = process.communicate(timeout=90)
    except subprocess.TimeoutExpired:
        process.send_signal(signal.SIGINT)
        try:
            process.communicate(timeout=15)
        except subprocess.TimeoutExpired:
            process.kill()
            process.communicate()
        return 'record pull timed out'
    if process.returncode:
        print(f'status-page: record pull exited {process.returncode}:\n{err}', file=sys.stderr)
        return f'record pull exited {process.returncode}'
    return None




def median(values):
    import statistics

    values = [v for v in values if v is not None]
    return statistics.median(values) if values else None






def ago(moment, now):
    if not moment:
        return '–'
    return age(now - moment)


def length(seconds):
    """A span as the page reads one: '42 min', '5 h 12 min', '3 d 6 h'."""
    seconds = max(0, seconds)
    if seconds >= DAY:
        return f'{int(seconds // DAY)} d {int(seconds % DAY // HOUR)} h'
    if seconds >= HOUR:
        return f'{int(seconds // HOUR)} h {int(seconds % HOUR // 60)} min'
    return f'{int(seconds // 60)} min'


def when(moment, now, text=None):
    """A moment relative to now, with its exact UTC time on hover."""
    if not moment:
        return '–'
    return (f'<time datetime="{utc(moment, "%Y-%m-%dT%H:%M:%SZ")}" '
            f'title="{utc(moment, "%Y-%m-%d %H:%M UTC")}">'
            f'{E(ago(moment, now) if text is None else text)}</time>')


def age(seconds):
    seconds = max(0, seconds)
    if seconds < 90:
        return 'just now'
    if seconds < HOUR:
        return f'{round(seconds / 60)} min ago'
    if seconds < 2 * DAY:
        return f'{int(seconds // HOUR)} h {int(seconds % HOUR // 60)} min ago'
    return f'{int(seconds // DAY)} d ago'




def utc(moment, form='%m-%d %H:%MZ'):
    return datetime.fromtimestamp(moment, timezone.utc).strftime(form) if moment is not None else '–'


def resets(moment, now):
    if moment is None:
        return '–'
    return 'in ' + length(moment - now)


def size(value):
    return '–' if value is None else f'{value / 1024 ** 3:.0f} GB'




def badge(tone, text):
    return f'<span class="badge {tone}"><i aria-hidden="true"></i>{E(text)}</span>'


def table(head, rows, numeric_from=1, empty='Nothing here.', wrap=()):
    """Cells keep to one line, but those of the columns in wrap."""
    if not rows:
        return f'<p class="empty">{E(empty)}</p>'
    kind = lambda i: ' class=wrap' if i in wrap else ' class=num' if i >= numeric_from else ''
    cells = ''.join(f'<th{kind(i)}>{E(h)}</th>' for i, h in enumerate(head))
    body = ''.join('<tr>' + ''.join(f'<td{kind(i)}>{c}</td>' for i, c in enumerate(row)) + '</tr>'
                   for row in rows)
    return f'<div class="scroll"><table><thead><tr>{cells}</tr></thead><tbody>{body}</tbody></table></div>'


def shaped(value, like):
    return value if isinstance(value, type(like)) else like


def subscription_data(raw):
    raw = shaped(raw, {})
    limits = []
    for limit in shaped(raw.get('limits'), []):
        if isinstance(limit, dict) and text(limit.get('name')):
            limits.append({'name': safe_limit(limit['name']), 'used': number(limit.get('used')),
                           'resets': number(limit.get('resets'))})
    identity = text(raw.get('label'))
    return {'state': text(raw.get('state')), 'plan': safe_plan(raw.get('plan')),
            'label': identity if re.fullmatch('[0-9a-f]{8}', identity) else '', 'limits': limits}


def merged_subscriptions(fleet):
    """Each distinct subscription as 2.1 merges it, and the machines with none."""
    merged, notes = {}, {}
    for host, cli, probe in fleet.usage:
        if probe['state'] in ('signed-out', 'no-subscription'):
            notes.setdefault((cli, probe['state']), []).append(host)
        if probe['state'] != 'subscribed':
            continue
        identity = probe['label']
        group = merged.setdefault((cli, identity, '' if identity else host),
                                  {'machines': [], 'plans': set(), 'limits': {}})
        group['machines'].append(host)
        if probe['plan']:
            group['plans'].add(probe['plan'])
        for limit in probe['limits']:
            previous = group['limits'].get(limit['name'])
            rank = lambda v: (v['resets'] if v['resets'] is not None else -math.inf,
                              v['used'] if v['used'] is not None else -math.inf)
            if previous is None or rank(limit) > rank(previous):
                group['limits'][limit['name']] = limit
    return merged, notes


def usage_samples(fleet):
    """One sample per limit with a use and reset, of each labelled subscription."""
    merged, _ = merged_subscriptions(fleet)
    return [dict(time=fleet.now, cli=cli, label=label, limit=limit['name'],
                 used=limit['used'], resets=limit['resets'])
            for (cli, label, _), group in merged.items() if label
            for limit in group['limits'].values() if limit['used'] is not None and limit['resets'] is not None]


def read_samples(path):
    """The file's samples and how many lines held none; a missing file has none."""
    samples, dropped = [], 0
    try:
        source = Path(path).open(encoding='utf-8')
    except FileNotFoundError:
        return samples, dropped
    with source:
        for line in source:
            try:
                sample = json.loads(line)
                valid = (isinstance(sample, dict)
                         and set(sample) == {'time', 'cli', 'label', 'limit', 'used', 'resets'}
                         and all(number(sample[k]) is not None for k in ('time', 'used', 'resets'))
                         and sample['cli'] in ('claude', 'codex')
                         and re.fullmatch('[0-9a-f]{8}', text(sample['label']))
                         and sample['limit'] == safe_limit(sample['limit']))
            except (ValueError, OverflowError, RecursionError):
                valid = False
            if valid:
                samples.append(sample)
            else:
                dropped += 1
    return samples, dropped


def kept_samples(samples, now):
    """Unexpired samples at most a day old, newest SAMPLES_KEPT, oldest first."""
    return sorted((s for s in samples if s['resets'] >= now and s['time'] >= now - DAY),
                  key=lambda s: s['time'])[-SAMPLES_KEPT:]


def rise(samples, limit, cli, label, now, lookback):
    """A limit's readings over the look-back (2.2): rate and since, or needs and has."""
    earlier = min((s for s in samples if s['cli'] == cli and s['label'] == label
                   and s['limit'] == limit['name'] and abs(s['resets'] - limit['resets']) <= 600
                   and now - lookback <= s['time'] <= now), key=lambda s: s['time'], default=None)
    needs = max(1800, lookback / 4)
    has = now - earlier['time'] if earlier is not None else 0
    if has < needs:
        return {'needs': needs, 'has': has}
    return {'rate': (limit['used'] - earlier['used']) / has, 'since': earlier['time']}


def pace(samples, limit, cli, label, now):
    """A limit's full time, projected use at reset, or wait for a pace (2.2)."""
    used, reset = limit['used'], limit['resets']
    if used is None or reset is None:
        return '–'
    if used >= 100:
        return 'full'
    reading = rise(samples, limit, cli, label, now, min(DAY, max(HOUR, reset - now)))
    if 'needs' in reading:
        needs, has = reading['needs'], reading['has']
        title = f'needs {length(needs)} of samples, has {length(has)}'
        return f'<span title="{E(title)}">{E("pace in " + length(needs - has))}</span>'
    rate = reading['rate']
    if rate > 0:
        full_at = now + (100 - used) / rate
        if full_at < reset:
            return when(full_at, now, 'full in ' + length(full_at - now))
    return f'lasts, {int(used + max(rate, 0) * (reset - now))}% at reset'


def rate(samples, limit, cli, label, now):
    """A limit's rate per hour, with its readings' span on hover (2.2)."""
    if limit['used'] is None or limit['resets'] is None:
        return '–'
    reading = rise(samples, limit, cli, label, now, HOUR)
    if 'rate' not in reading:
        return '–'
    title = (f'over {length(now - reading["since"])}, '
             f'since {utc(reading["since"], "%Y-%m-%d %H:%M UTC")}')
    return f'<span title="{E(title)}">{max(0, reading["rate"] * 3600):.1f}%/h</span>'


def subscriptions(fleet):
    """Each distinct subscription's limits, then machines with none."""
    merged, notes = merged_subscriptions(fleet)
    rows, highest = [], None
    cli_name = {'claude': 'Claude', 'codex': 'Codex'}
    order = lambda key: (key[0] != 'claude', not bool(key[1]), key[1], key[2])
    for key in sorted(merged, key=order):
        cli, identity, _ = key
        group = merged[key]
        title = E(cli_name[cli])
        if group['plans']:
            title += ' · ' + E(', '.join(sorted(group['plans'])))
        title += f' · <code>{E(identity)}</code>' if identity else ' · unidentified'
        for i, limit in enumerate(list(group['limits'].values()) or [dict(name='–', used=None, resets=None)]):
            used = limit['used']
            meter = '–'
            if used is not None:
                tone = 'critical' if used >= 95 else 'warning' if used >= 80 else 'info'
                meter = (f'<span class="meter {tone}" role="img" aria-label="{used:g}% used">'
                         f'<i style="width:{max(0, min(100, used)):g}%"></i></span> {used:g}%')
                if highest is None or used > highest[0]:
                    highest = (used, f'{cli_name[cli]} {limit["name"]}')
            rows.append([title if i == 0 else '', E(limit['name']), meter,
                         when(limit['resets'], fleet.now, resets(limit['resets'], fleet.now)),
                         rate(fleet.samples, limit, cli, identity, fleet.now)
                         if identity and fleet.samples is not None else '–',
                         pace(fleet.samples, limit, cli, identity, fleet.now)
                         if identity and fleet.samples is not None else '–'])
    out = table(['Subscription', 'Limit', 'Used', 'Resets', 'Rate', 'At this pace'], rows, numeric_from=2,
                empty='No subscriptions found.')
    for cli in ('claude', 'codex'):
        for state, word in (('signed-out', 'signed out'), ('no-subscription', 'no subscription')):
            hosts = notes.get((cli, state), [])
            if hosts:
                out += f'<p class="muted">{cli_name[cli]}: {word} on {E(", ".join(sorted(hosts)))}</p>'
    sub = f'highest {highest[0]:g}% · {highest[1]}' if highest else 'no limits reported'
    signed_out = {host for (_, state), hosts in notes.items() if state == 'signed-out' for host in hosts}
    if signed_out:
        sub += ' · signed out: ' + ', '.join(sorted(signed_out))
    return {'count': len(merged), 'sub': sub}, out


