EVENT_SOURCES = ('queue', 'heavy', 'sessions', 'post', 'post-sent')

JOIN = 'coordinator draft area part task branch run session'.split()
RULES = ('deaf', 'gone', 'report unread', 'run hung', 'idle claim', 'unqueued',
         'lease stall', 'handover late', 'question due', 'delivery failed', 'waiter orphan', 'waiter dead')
DEAD = {'stopped', 'completed', 'ended', 'dead', 'done', 'failed'}


def stamp(value):
    if isinstance(value, (int, float)):
        return float(value)
    if isinstance(value, datetime):
        result = value
    else:
        result = datetime.fromisoformat(value.replace('Z', '+00:00'))
    if result.utcoffset() is None:
        raise ValueError('timestamp lacks offset')
    return result.timestamp()


def iso(now):
    return datetime.fromtimestamp(now, timezone.utc).isoformat().replace('+00:00', 'Z')


def command(argv, data=None, env=None, timeout=30, cwd=None):
    return subprocess.run(argv, input=data, text=True, capture_output=True,
                          timeout=timeout, env=env, cwd=cwd)


def checked(argv, **kwargs):
    result = command(argv, **kwargs)
    if result.returncode:
        # Producer output can contain private data. Report status, never output.
        raise ValueError(f'{argv[0]} exited {result.returncode}')
    return result.stdout


def json_rows(text):
    rows = json.loads(text)
    if not isinstance(rows, list) or any(not isinstance(r, dict) for r in rows):
        raise ValueError('expected an array of objects')
    return rows


def agent_rows(text):
    rows = json_rows(text)
    for row in rows:
        if row.get('name') is not None and not isinstance(row['name'], str):
            raise ValueError('invalid agent name')
        if not isinstance(row.get('status', row.get('state')), str):
            raise ValueError('agent lacks status')
    return rows


def lease_rows(text):
    rows = json_rows(text)
    for row in rows:
        if not isinstance(row['subject'], str) or not isinstance(row['waiters'], list):
            raise ValueError('invalid lease')
        if row.get('owner'):
            stamp(row['since'])
        for waiter in row['waiters']:
            stamp(waiter['since'])
            if not isinstance(waiter['owner'], str):
                raise ValueError('invalid lease waiter')
    return rows


def atomic(path, value):
    fd, name = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as out:
            os.fchmod(out.fileno(), 0o600)
            json.dump(value, out, sort_keys=True)
            out.write('\n')
            out.flush()
            os.fsync(out.fileno())
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def task_keys(path):
    if not path or not Path(path).is_file():
        return {}
    with Path(path).open() as stream:
        first = stream.readline()
        if first.strip() != '+++':
            return {}
        header = []
        for line in stream:
            if line.strip() == '+++':
                values = tomllib.loads(''.join(header))
                return {k: values[k] for k in JOIN if k != 'run' and isinstance(values.get(k), str)}
            header.append(line)
            if sum(map(len, header)) > 16384:
                break
    raise ValueError('invalid task header')


def probe():
    """Read only bounded producer paths. This same source runs on builders."""
    root = Path.home() / 'src/rust/tmp'
    result = {'runs': [], 'heavy': [], 'errors': []}
    try:
        runs = root / 'codex-run'
        if not runs.is_dir():
            raise ValueError('codex-run absent')
        ends = {}
        ledger = runs / 'runs.tsv'
        if ledger.exists():
            for line in ledger.read_text().splitlines():
                columns = line.split('\t')
                if len(columns) != 13:
                    raise ValueError('invalid runs.tsv')
                ends[columns[0]] = columns
        for path in sorted(runs.glob('*/meta')):
            meta = dict(line.split('=', 1) for line in path.read_text().splitlines() if '=' in line)
            run = path.parent.name
            row = dict(run=run, owner=meta['to'].split('@')[0], started=stamp(meta['started']),
                       effort=meta.get('effort', ''), cwd=meta.get('dir', ''), **task_keys(meta.get('task')))
            output = path.parent / 'events.jsonl'
            row['changed'] = output.stat().st_mtime if output.exists() else row['started']
            end = ends.get(run)
            row['ended'] = bool(end or (path.parent / 'ended').exists())
            if end:
                row.update(end=stamp(end[3]), post_status=int(end[12]))
            elif row['ended']:
                row['end'] = (path.parent / 'ended').stat().st_mtime
            row['told'] = (path.parent / 'told').exists()
            result['runs'].append(row)
    except (OSError, ValueError, KeyError) as error:
        result['errors'].append('runs:' + type(error).__name__)
    try:
        path = root / 'heavy/state.json'
        if not path.exists():
            # Older heavy has no live snapshot: do not infer an idle slot.
            raise ValueError('heavy state absent')
        tasks = json.loads(path.read_text())['tasks']
        for task in tasks.values():
            if task['state'] not in DEAD | {'released', 'done', 'failed', 'cancelled'}:
                cwd = task.get('cwd') or task.get('repo')
                if not isinstance(cwd, str):
                    raise ValueError('heavy task lacks cwd')
                result['heavy'].append({'cwd': cwd, 'state': task['state']})
    except (OSError, ValueError, KeyError, TypeError) as error:
        result['errors'].append('heavy:' + type(error).__name__)
    result['spools'] = {}
    for source in EVENT_SOURCES:
        try:
            result['spools'][source] = event_spool.read(event_spool.root(), source, time.time())
        except (OSError, ValueError, KeyError, TypeError) as error:
            result['errors'].append('spool/' + source + ':' + type(error).__name__)
    return result


def mailboxes():
    root = Path.home() / 'src/rust/tmp/post'
    if not root.is_dir():
        raise ValueError('post absent')
    rows = []
    for box in sorted(root.iterdir()):
        new = box / 'new'
        if not new.is_dir():
            continue
        for path in sorted(new.glob('*.md')):
            # Unbuffered header-only reads; never read or quote a mail body.
            header = {}
            with path.open('rb', buffering=0) as stream:
                size = 0
                while True:
                    line = stream.readline(4097)
                    size += len(line)
                    if line == b'\n':
                        break
                    if not line or size > 4096:
                        raise ValueError('invalid mail header')
                    key, sep, value = line.decode().rstrip('\n').partition(': ')
                    if not sep or key not in ('Id', 'From', 'To', 'Re', 'Subject') or key in header:
                        raise ValueError('invalid mail header')
                    header[key] = value
                rows.append(dict(owner=box.name.replace('+', '/'), message_id=header['Id'],
                                 sender=header['From'], subject=header['Subject'],
                                 delivered=os.fstat(stream.fileno()).st_mtime))
    return rows


def waiters(text):
    result = {}
    for line in text.splitlines():
        fields = line.split()
        if len(fields) != 4 or fields[2] not in ('alive', 'dead'):
            raise ValueError('invalid waiter row')
        pid = int(fields[1])
        if pid <= 1:
            raise ValueError('invalid waiter pid')
        row = dict(alive=fields[2] == 'alive', session=fields[3], pid=pid)
        box = result.setdefault(fields[0], dict(alive=False, session=fields[3], records=[]))
        box['records'].append(row)
        if row['alive']:
            box.update(alive=True, session=fields[3])
    return result


def claims(text):
    result = []
    for line in text.splitlines():
        if re.fullmatch(r'\S+ \d+ \[[^\]]+\]: free', line):
            continue
        match = re.fullmatch(r'(\S+) (\d+) \[[^\]]+\]: ([^:]+): .* \(since ([^)]+)\); held .+', line)
        if not match:
            raise ValueError('invalid claim row')
        host, number, owner, since = match.groups()
        result.append(dict(subject=host + '-' + number, host=host, number=number,
                           owner=owner, created=stamp(since)))
    return result


def identities(text):
    """Consume session-start names --json's array without inventing identities."""
    result = {}
    for row in json_rows(text):
        name = row.get('mailbox')
        if not isinstance(name, str) or not name or any(c.isspace() for c in name):
            raise ValueError('invalid mailbox')
        if name in result:
            raise ValueError('duplicate mailbox')
        if 'supervisor' not in row:
            raise ValueError('names lacks supervisor')
        supervisor = row['supervisor']
        if supervisor is None and row.get('role') == 'director':
            supervisor = ''
        if not isinstance(supervisor, str):
            raise ValueError('names lacks supervisor')
        if not isinstance(row.get('aliases', []), list) or any(not isinstance(v, str) for v in row.get('aliases', [])):
            raise ValueError('invalid aliases')
        if 'name_prefix' in row and not isinstance(row['name_prefix'], str):
            raise ValueError('invalid name prefix')
        if 'paused' in row and type(row['paused']) is not bool:
            raise ValueError('invalid pause state')
        if row.get('role') == 'lead':
            if row.get('kind', 'claude') not in ('claude', 'codex'):
                raise ValueError('invalid lead kind')
            if row.get('kind') == 'codex' and (not isinstance(row.get('unit'), str) or not row['unit'].startswith('codex-owner-')):
                raise ValueError('Codex lead lacks unit')
        result[name] = dict(row, name=name, supervisor=supervisor)
    return result


def idle(agent):
    # Lifecycle state is distinct from process activity. blocked alone is NOT idle.
    return agent.get('status', agent.get('state')) == 'idle' and agent.get('state') in (None, 'idle', 'done')


def live_agent(agent):
    status, state = agent.get('status'), agent.get('state')
    return (state not in DEAD and status not in DEAD) or (state == 'done' and status in ('busy', 'waiting', 'idle'))


def saved_options(agent):
    sid = agent.get('sessionId', '')
    if not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', sid):
        return {}
    try:
        row = json.loads((Path(os.environ.get('CLAUDE_CONFIG_DIR', Path.home() / '.claude')) / 'jobs' / sid[:8] / 'state.json').read_text())
        flags = row.get('respawnFlags', [])
        if row.get('sessionId') != sid or not isinstance(flags, list) or any(not isinstance(f, str) for f in flags):
            return {}
        if any(flag == '--permission-mode' and (i+1 == len(flags) or flags[i+1].startswith('--')) for i, flag in enumerate(flags)):
            return {}
        bypass = '--dangerously-skip-permissions' in flags or any(
            flag == '--permission-mode=bypassPermissions' or
            (flag == '--permission-mode' and flags[i+1:i+2] == ['bypassPermissions'])
            for i, flag in enumerate(flags))
        modes = [flags[i+1] for i, flag in enumerate(flags[:-1]) if flag == '--permission-mode']
        modes += [flag.split('=', 1)[1] for flag in flags if isinstance(flag, str) and flag.startswith('--permission-mode=')]
        bypass = bypass and all(mode == 'bypassPermissions' for mode in modes) and '--restricted' not in flags
        return dict(bypass=bypass, cwd=row.get('cwd'))
    except (OSError, ValueError, TypeError):
        return {}


def owner_turn(identity, name):
    directory = Path(identity.get('owner_state', Path.home() / 'src/rust/tmp/owners' / name.split('/')[-1] / 'codex'))
    # Read event types/times only, never prompts or model output.
    started, session = None, None
    path = directory / 'events.jsonl'
    if path.exists():
        with path.open() as stream:
            for line in stream:
                row = json.loads(line)
                if row.get('type') == 'thread.started':
                    session = row.get('thread_id')
                if row.get('type') == 'turn.started':
                    started = stamp(row.get('ts', row.get('timestamp'))) if row.get('ts', row.get('timestamp')) else None
                if row.get('type') in ('turn.completed', 'turn.failed'):
                    started = None
    ledger = directory / 'turns.tsv'
    if started is not None and ledger.exists():
        lines = ledger.read_text().splitlines()
        if lines:
            fields = lines[-1].split('\t')
            if len(fields) != 4:
                raise ValueError('invalid owner turns.tsv')
            # A completed row at/after this start proves it is no longer running.
            if stamp(fields[1]) >= started:
                started = None
    return dict(started=started, thread=session)


def waiter_process(pid):
    try:
        stat = (Path('/proc') / str(pid) / 'stat').read_text().rsplit(')', 1)[1].split()
        argv = (Path('/proc') / str(pid) / 'cmdline').read_bytes().split(b'\0')
        return dict(alive=stat[0] != 'Z', ppid=int(stat[1]), start=stat[19], argv=[os.fsdecode(a) for a in argv if a],
                    verified=any(Path(os.fsdecode(a)).name == 'post' for a in argv[:3]) and b'wait' in argv)
    except FileNotFoundError:
        return dict(alive=False)
    except (OSError, ValueError, IndexError):
        return {}


def launch_role(identity):
    if identity.get('kind') == 'codex' or identity.get('paused') or identity.get('retired'):
        return None
    role = identity.get('role')
    if role == 'director':
        return dict(kind='launch', argv=['director'])
    if role in ('coordinator', 'lead') and identity.get('handle'):
        argv = [role, identity['handle']]
        if role == 'lead':
            argv.append(identity['area'])
        return dict(kind='launch', argv=argv)
    return None


def repair(plan, settings, launcher):
    """Only called with actions enabled. Return bounded, non-private result facts."""
    try:
        if plan['kind'] == 'kill':
            current = waiter_process(plan['pid'])
            if not current.get('verified') or current.get('start') != plan['start'] or plan['owner'] not in current.get('argv', []):
                return dict(success=False, result='waiter changed; refused')
            agents = agent_rows(checked(['claude', 'agents', '--json']))
            boxes = waiters(checked(['post', 'waiters']))
            records = boxes.get(plan['owner'], {}).get('records', [])
            identity = plan['identity']
            aliases = [plan['owner'], *identity.get('aliases', [])]
            prefix = identity.get('name_prefix')
            live_ids = {r.get('sessionId') for r in agents if live_agent(r)}
            mailbox_live = any(live_agent(r) and (r.get('name') in aliases or
                (prefix and (r.get('name') or '').startswith(prefix)) or
                any(w['session'] in (r.get('sessionId'), r.get('id')) for w in records)) for r in agents)
            if plan.get('unit'):
                sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'session'))
                from session_lib import unit_active
                mailbox_live |= unit_active(plan['unit'])
            another = any(w['pid'] != plan['pid'] and w['alive'] and w['session'] in live_ids
                          and waiter_process(w['pid']).get('alive') for w in records)
            if mailbox_live and not another:
                return dict(attempted=False, result='waiter now sole live reader; refused')
            os.kill(plan['pid'], signal.SIGTERM)
            return dict(success=True, result='orphan signalled')
        if plan['kind'] == 'launch':
            argv = [launcher, *plan['argv']]
            checked([*argv, '--dry-run'])
            checked(argv)
            return dict(success=True, result='launched from files')
        sid, cwd = plan['session'], plan['cwd']
        # Recheck activity/options immediately before stopping a process.
        rows = agent_rows(checked(['claude', 'agents', '--json']))
        agent = next((r for r in rows if r.get('sessionId') == sid), None)
        if agent is None:
            rows = agent_rows(checked(['claude', 'agents', '--json', '--all']))
            agent = next((r for r in rows if r.get('sessionId') == sid and r.get('state') == 'stopped'), None)
        if (not agent or (not idle(agent) and agent.get('state') != 'stopped')
                or saved_options(agent) != dict(bypass=True, cwd=cwd)):
            return dict(attempted=False, result='activity or saved bypass changed; refused')
        if agent.get('state') != 'stopped':
            checked(['claude', 'stop', sid], cwd=cwd)
        deadline = time.monotonic() + min(60, settings.get('stop_timeout_seconds', 60))
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return dict(success=False, result='stop timed out; resume withheld')
            rows = agent_rows(checked(['claude', 'agents', '--json', '--all'], timeout=remaining))
            stopped = any(r.get('sessionId') == sid and r.get('state', r.get('status')) == 'stopped' for r in rows)
            if stopped:
                break
            time.sleep(min(settings.get('stop_poll_seconds', 1), max(0, deadline-time.monotonic())))
        sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'session'))
        from session_lib import session_id
        prompt = f'Restart your post wait {plan["owner"]} in the background, post read {plan["owner"]}, and carry on.'
        output = checked(['claude', '--bg', '--resume', sid, prompt], cwd=cwd)
        resumed = session_id(output)
        if resumed != sid:
            if resumed:
                checked(['claude', 'stop', resumed], cwd=cwd)
            return dict(success=False, result='resume id mismatch; copy stopped' if resumed else 'resume id missing',
                        copy_session=resumed)
        return dict(success=True, result='resumed same session', session=sid)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        return dict(success=False, result='remedy failed: ' + type(error).__name__)


class Inputs:
    def __init__(self, dry, settings=None, state_dir=None):
        self.dry, self.data, self.errors = dry, {}, {}
        self.settings = settings or tomllib.loads(Path(__file__).with_suffix('.toml').read_text())['watch']
        self.state_dir = state_dir or Path.home() / '.local/state/watch'
        self.git_env = dict(os.environ, GIT_SSH_COMMAND='ssh -o ControlMaster=auto -o ControlPersist=600 -o ControlPath=' +
                            shlex.quote(str(self.state_dir / 'ssh-%C')))

        directory = Path(__file__).resolve().parent.parent
        self.executables = {
            name: shutil.which(name) or str(directory / sibling)
            for name, sibling in (('session-start', 'session/start'), ('lease', 'lease'))
        }

    def read(self, name, operation):
        try:
            self.data[name] = operation()
        except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
            self.errors[name] = type(error).__name__ + ': ' + str(error)[:160]

    def records(self, root):
        remote = os.environ.get('RECORDS_ORIGIN') or self.settings.get('records_remote')
        if not remote:
            remote = checked(['git', '-C', str(root), 'remote', 'get-url', 'origin']).strip()
        tip = checked(['git', 'ls-remote', remote, 'refs/heads/main'], env=self.git_env).split()
        if len(tip) != 2 or not re.fullmatch('[0-9a-f]{40,64}', tip[0]) or tip[1] != 'refs/heads/main':
            raise ValueError('invalid records main ref')
        local = command(['git', '-C', str(root), 'rev-parse', 'refs/remotes/origin/main'])
        if local.returncode or local.stdout.strip() != tip[0]:
            checked([str(Path(__file__).with_name('record')), 'pull'],
                    env=dict(self.git_env, RECORDS_REPO=str(root), RECORDS_ORIGIN=remote))
        def questions():
            rows = [dict(tomllib.loads(p.read_text()), subject=p.stem)
                    for p in sorted((root / 'director/questions').glob('*.toml'))]
            for row in rows:
                stamp(row['deadline'])
            return rows
        self.read('questions', questions)
        def drafts():
            rows = []
            for path in sorted((root / 'drafts').glob('*/draft.toml')):
                row = dict(tomllib.loads(path.read_text()), draft=path.parent.name, unfinished_parts=[])
                for brief in sorted((path.parent / 'parts').glob('*/brief.md')):
                    closing = brief.with_name('closing.toml')
                    if not closing.exists():
                        row['unfinished_parts'].append(brief.parent.name)
                    else:
                        values = tomllib.loads(closing.read_text())
                        if values.get('open') or values.get('outcome') == 'handed-over':
                            row['unfinished_parts'].append(brief.parent.name)
                rows.append(row)
            return rows
        self.read('drafts', drafts)

    def collect(self, records):
        self.read('records', lambda: self.records(records))
        self.read('names', lambda: identities(checked([self.executables['session-start'], 'names', '--json'])))
        self.data.setdefault('names', {})
        sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'session'))
        from session_lib import unit_active
        for name, identity in self.data['names'].items():
            if identity.get('kind') == 'codex' and identity.get('role') == 'lead':
                self.read('unit/' + name, lambda identity=identity: unit_active(identity['unit']))
        if 'ops' in self.data['names']:
            self.read('unit/ops', lambda: unit_active('codex-owner-ops'))
        self.read('agents', lambda: agent_rows(checked(['claude', 'agents', '--json'])))
        self.read('waiters', lambda: waiters(checked(['post', 'waiters'])))
        for box in self.data.get('waiters', {}).values():
            for row in box.get('records', []):
                row.update(process=waiter_process(row['pid']))
                if not row['process']:
                    self.errors['waiters'] = 'waiter process unavailable'
        self.data['saved'] = {r.get('sessionId'): saved_options(r) for r in self.data.get('agents', [])}
        for name, identity in self.data['names'].items():
            if identity.get('kind') == 'codex' or name == 'ops':
                self.read('turn/' + name, lambda identity=identity, name=name: owner_turn(identity, name))
        self.read('mail', mailboxes)
        self.read('claims', lambda: claims(checked(['claim', 'list'])))
        self.read('leases', lambda: lease_rows(checked([self.executables['lease'], 'list', '--json'])))
        def refs():
            rows = {}
            for line in checked(['git', 'ls-remote', self.settings['fabrig_remote'],
                                 'refs/heads/ready/*'], env=self.git_env).splitlines():
                tip, ref = line.split()
                if not re.fullmatch('[0-9a-f]{40,64}', tip) or not ref.startswith('refs/heads/ready/'):
                    raise ValueError('invalid ready ref')
                rows[ref.removeprefix('refs/heads/')] = tip
            return rows
        self.read('refs', refs)
        def machines():
            result = {}
            for line in (Path.home() / 'src/rust/tmp/post/machines').read_text().splitlines():
                fields = line.split('#', 1)[0].split()
                if fields:
                    name, address = fields
                    result[name] = address
            return result
        self.read('machines', machines)
        pairs = dict(self.data.get('machines', {}))
        if 'local' not in pairs.values():
            pairs['hel8'] = 'local'
        probe_code = event_spool.probe_source(__file__)
        def read_host(pair):
            host, address = pair
            try:
                if address == 'local':
                    result = probe()
                else:
                    result = json.loads(checked(
                        ['ssh', '-T', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes',
                         '-o', 'ConnectTimeout=5', '-o', 'UpdateHostKeys=no', address,
                         "bash -lc 'exec python3 -I -B - --probe'"], data=probe_code, timeout=45))
                for kind in ('runs', 'heavy'):
                    errors = [e for e in result['errors'] if e.startswith(kind + ':')]
                    if errors:
                        self.errors[kind + '/' + host] = ', '.join(errors)
                    else:
                        rows = result[kind]
                        if not isinstance(rows, list):
                            raise ValueError('invalid probe rows')
                        for row in rows:
                            if not isinstance(row.get('cwd'), str):
                                raise ValueError('probe row lacks cwd')
                            if kind == 'runs':
                                for key in ('owner', 'run', 'effort'):
                                    if not isinstance(row[key], str):
                                        raise ValueError('invalid run identity')
                                for key in ('started', 'changed'):
                                    stamp(row[key])
                                if type(row['ended']) is not bool:
                                    raise ValueError('invalid run completion')
                        self.data[kind + '/' + host] = rows
                for source in EVENT_SOURCES:
                    key = 'spool/' + source
                    try:
                        if any(e.startswith(key + ':') for e in result['errors']):
                            raise ValueError('source unavailable')
                        rows = result['spools'][source]
                        if not isinstance(rows, list):
                            raise ValueError('invalid spool rows')
                        for row in rows:
                            event_spool.validate(row, source)
                        self.data[key + '/' + host] = rows
                    except (OSError, ValueError, KeyError, TypeError) as error:
                        self.errors[key + '/' + host] = type(error).__name__
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
                for kind in ('runs', 'heavy', *('spool/' + s for s in EVENT_SOURCES)):
                    self.errors[kind + '/' + host] = type(error).__name__
        with ThreadPoolExecutor(max_workers=8) as pool:
            list(pool.map(read_host, pairs.items()))
        for source in EVENT_SOURCES:
            key = 'spool/' + source
            failed = [host for host in pairs if key + '/' + host in self.errors]
            if failed:
                self.errors[key] = 'unavailable hosts: ' + ', '.join(sorted(failed))
            else:
                rows, seen = [], set()
                now = time.time()
                for host in pairs:
                    for row in self.data.get(key + '/' + host, []):
                        identity = (row['host'], row['id'])
                        if now - 7200 <= stamp(row['time']) <= now and identity not in seen:
                            rows.append(row)
                            seen.add(identity)
                self.data[key] = sorted(rows, key=lambda row: stamp(row['time']))
        self.data['owned'] = {}
        for name, identity in self.data['names'].items():
            if identity.get('always_watched'):
                self.data['owned'][name] = True
                continue
            try:
                result = command([self.executables['session-start'], 'owns', name], env=dict(os.environ, RECORDS_REPO=str(records)))
                if result.returncode not in (0, 1):
                    raise ValueError('owns exited ' + str(result.returncode))
                self.data['owned'][name] = result.returncode == 0
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                self.errors['owns/' + name] = type(error).__name__
        return self


def evaluate(data, state, config, now):
    """Produce candidates and availability dependencies; no IO or side effects."""
    candidates = {}
    names = data.get('names', {})
    owned = data.get('owned', {})
    def allowed(owner):
        identity = names.get(owner, {})
        return not identity.get('paused', False) and (identity.get('always_watched', False) or owned.get(owner, False))
    def add(rule, subject, owner, evidence, deps, **joins):
        waiter_rule = rule.startswith('waiter ')
        if not config[rule]['enabled'] or (not waiter_rule and not allowed(owner)):
            return
        identity = names.get(owner, dict(always_watched=True))
        # Joins are carried from the launcher's identity and the actual producer.
        keys = {k: identity[k] for k in JOIN if isinstance(identity.get(k), str)}
        keys.update({k: v for k, v in joins.items() if k in JOIN and isinstance(v, str)})
        dependencies = list(deps) + ['names']
        if not identity.get('always_watched', False):
            dependencies.append('owns/' + owner)
        candidates[rule + '\t' + subject] = dict(rule=rule, subject=subject, owner=owner,
            supervisor=identity.get('supervisor', ''),
            escalate_to=identity.get('supervisor', ''),
            evidence=evidence[:6], deps=dependencies, director_escalation=(identity.get('role') == 'coordinator' or owner in ('ops', 's/deploy', 's/multi-coord')), **keys)
    def older(when, minutes):
        return now - stamp(when) > minutes * 60
    live = {}
    for name, identity in names.items():
        if identity.get('kind') == 'codex' or name == 'ops':
            if data.get('unit/' + name) is True:
                live[name] = []
            continue
        aliases = identity.get('aliases', []) + [name]
        prefix = identity.get('name_prefix')
        holders = data.get('waiters', {}).get(name, {}).get('session')
        matches = [r for r in data.get('agents', []) if live_agent(r) and
                   (r.get('name') in aliases or (prefix and (r.get('name') or '').startswith(prefix)) or
                    (holders and holders != '-' and holders in (r.get('sessionId'), r.get('id'))))]
        if matches:
            live[name] = matches
    # An orphan from a stopped session does not make its successor hear mail.
    if 'agents' in data:
        ids = {r.get('sessionId') for r in data['agents'] if live_agent(r)}
        for box in data.get('waiters', {}).values():
            if 'records' in box:
                box['alive'] = any(r['alive'] and r.get('process', {}).get('alive')
                                   and (r['session'] == '-' or r['session'] in ids) for r in box['records'])
    deaf = set()
    for name in live:
        if names[name].get('kind') == 'codex' or name == 'ops':
            continue
        mail = [m for m in data.get('mail', []) if m['owner'] == name and older(m['delivered'], config['deaf']['minutes'])]
        if mail and not data.get('waiters', {}).get(name, {}).get('alive'):
            if config['deaf']['enabled']:
                deaf.add(name)
            all_mail = [m for m in data.get('mail', []) if m['owner'] == name]
            oldest = min(m['delivered'] for m in all_mail)
            agent = live[name][0]
            sid = agent.get('sessionId', '')
            saved = data.get('saved', {}).get(sid, {})
            safe = (len(live[name]) == 1 and idle(agent) and saved.get('bypass')
                    and isinstance(agent.get('cwd'), str) and Path(agent['cwd']).is_absolute()
                    and saved.get('cwd') == agent['cwd'])
            add('deaf', name, name, [f'unread={len(all_mail)}; oldest={iso(oldest)}; oldest_age_s={now-oldest:.0f}',
                'no live mailbox waiter', f'state={agent.get("state")}; status={agent.get("status")}; bypass={bool(saved.get("bypass"))}'],
                ['agents', 'waiters', 'mail'], session=sid)
            candidate = candidates.get('deaf\t' + name)
            if candidate is not None:
                candidate.update(remedy=dict(kind='resume', session=sid, cwd=agent['cwd'], owner=name) if safe else None,
                                 remedy_reason='idle with saved bypass' if safe else 'busy, ambiguous session, or saved bypass/cwd unknown')
    for name, identity in names.items():
        if (identity.get('kind') != 'codex' and name != 'ops') or data.get('unit/' + name) is not False:
            continue
        mail = [m for m in data.get('mail', []) if m['owner'] == name and older(m['delivered'], config['deaf']['minutes'])]
        if mail:
            if config['deaf']['enabled']:
                deaf.add(name)
            oldest = min(m['delivered'] for m in mail)
            add('deaf', name, name, [f'unread={len(mail)}; oldest={iso(oldest)}', 'Codex owner unit inactive', 'current_turn_s=' + (str(round(now-data['turn/' + name]['started'])) if data.get('turn/' + name, {}).get('started') else 'unknown')],
                ['unit/' + name, 'mail'])
            candidate = candidates.get('deaf\t' + name)
            if candidate is not None:
                candidate.update(remedy=None, remedy_reason='Codex owner belongs to ops')
    for previous in state.get('episodes', {}).values():
        name = previous['owner']
        if (previous['rule'] == 'deaf' and previous.get('remedy_attempts', 0) >= 1
                and not previous.get('remedy_success') and name not in live
                and previous.get('remedy') and allowed(name)
                and any(m['owner'] == name and older(m['delivered'], config['deaf']['minutes']) for m in data.get('mail', []))):
            candidates.setdefault('deaf\t' + name, dict(previous, clear=0))
            deaf.add(name)
    active = {d['mailbox']: d for d in data.get('drafts', []) if d.get('state') == 'active'}
    for name, identity in names.items():
        registered = name in active or identity.get('role') == 'director'
        if identity.get('role') == 'lead':
            draft = active.get(identity.get('coordinator_mailbox'), {})
            unfinished = identity.get('unfinished', False) or any(
                part.startswith(identity.get('area', name.rsplit('/', 1)[-1]) + '-')
                for part in draft.get('unfinished_parts', []))
            registered = bool(draft) and unfinished
        codex = identity.get('kind') == 'codex' or name == 'ops'
        absent = data.get('unit/' + name) is False if codex else name not in live
        if registered and absent and name not in deaf and not identity.get('retired'):
            draft = active.get(name) or active.get(identity.get('coordinator_mailbox')) or {}
            joins = {k: v for k, v in identity.items() if k in JOIN}
            if draft:
                joins.update(draft=draft.get('draft', ''), coordinator=draft['mailbox'])
            evidence = 'registered unfinished role has inactive Codex owner unit' if codex else 'registered unfinished role absent from claude agents'
            add('gone', name, name, [evidence],
                ['unit/' + name if codex else 'agents', 'drafts'], **joins)
            candidate = candidates.get('gone\t' + name)
            if candidate is not None:
                launch = launch_role(identity)
                candidate.update(remedy=launch, remedy_reason='launcher from role files' if launch else 'no safe launcher for role')
    runs = [(key.split('/', 1)[1], row) for key, rows in data.items() if key.startswith('runs/') for row in rows]
    medians = {}
    for _, row in runs:
        if row.get('end'):
            medians.setdefault(row['effort'], []).append(row['end'] - row['started'])
    for host, row in runs:
        owner, run = row['owner'], row['run']
        joins = {k: row[k] for k in JOIN if k in row}
        deps = ['runs/' + host]
        subject = host + '/' + run
        if not row['ended']:
            elapsed = now - row['started']
            samples = medians.get(row['effort'], [])
            rule = config['run hung']
            median = statistics.median(samples) if len(samples) >= rule['median_min_samples'] else None
            quiet = older(row['changed'], config['run hung']['minutes'])
            limit = median * rule['median_multiplier'] if median is not None else rule['fallback_minutes'] * 60
            if quiet and elapsed > limit:
                add('run hung', subject, owner, [f'output unchanged since {iso(row["changed"])}',
                    f'elapsed_s={elapsed:.0f}; effort={row["effort"]}; median_s={median}; samples={len(samples)}; limit_s={limit}'], deps, **joins)
        if row['ended']:
            if row.get('post_status') == 2 and not row.get('told'):
                add('delivery failed', subject, owner, ['sender=codex-run; post send exited 2; no told marker'],
                    deps, **joins)
    for owner in names:
        completed = {r['run'] for _, r in runs if r['owner'] == owner and r['ended']}
        mail = [m for m in data.get('mail', []) if m['owner'] == owner]
        reports = [m for m in mail if m['sender'].split('@')[0] == 'codex-run'
                   and any(run in m['subject'] for run in completed)
                   and older(m['delivered'], config['report unread']['minutes'])]
        if reports and owner not in deaf:
            oldest = min(m['delivered'] for m in mail)
            turn = data.get('turn/' + owner, {})
            evidence = [f'unread={len(mail)}; oldest={iso(oldest)}; oldest_age_s={now-oldest:.0f}',
                        f'unread completion reports={len(reports)}',
                        'current_turn_s=' + (str(round(now-turn['started'])) if turn.get('started') else 'unknown')]
            add('report unread', owner, owner, evidence, ['mail', 'agents', 'waiters'] +
                [key for key in data if key.startswith('runs/')])
            candidate = candidates.get('report unread\t' + owner)
            if candidate is not None:
                candidate.update(remedy=None, remedy_reason='reader must finish its current turn')
    live_ids = {r.get('sessionId') for r in data.get('agents', []) if live_agent(r)}
    for owner, box in data.get('waiters', {}).items():
        for row in box.get('records', []):
            process = row.get('process', {})
            dead = process.get('alive') is False or not row['alive']
            ended = row['session'] != '-' and row['session'] not in live_ids
            mailbox_live = owner in live or (row['session'] != '-' and row['session'] in live_ids)
            orphan = not dead and (ended or (process.get('ppid') == 1 and not mailbox_live))
            if not dead and not orphan:
                continue
            rule = 'waiter dead' if dead else 'waiter orphan'
            add(rule, owner + '/' + str(row['pid']), owner,
                [f'waiter pid={row["pid"]}; session={row["session"]}; ppid={process.get("ppid")}',
                 'dead record; post state is never edited' if dead else 'orphan waiter process'], ['agents', 'waiters'])
            candidate = candidates.get(rule + '\t' + owner + '/' + str(row['pid']))
            if candidate is not None:
                other = any(r['pid'] != row['pid'] and r['alive'] and r.get('process', {}).get('alive')
                            and r['session'] in live_ids for r in box.get('records', []))
                safe = orphan and process.get('verified') and (other or not mailbox_live)
                candidate.update(remedy=dict(kind='kill', pid=row['pid'], owner=owner,
                    start=process['start'], identity=names.get(owner, {}),
                    unit=names.get(owner, {}).get('unit', 'codex-owner-ops' if owner == 'ops' else None)) if safe else None, remedy_reason='safe orphan cleanup' if safe else 'report only')
    for claim in data.get('claims', []):
        host, number = claim['host'], claim['number']
        deps = ['claims', 'runs/' + host, 'heavy/' + host, 'spool/heavy', 'spool/queue']
        if any(dep not in data for dep in deps):
            continue
        def in_slot(cwd):
            return bool(re.search(r'/slots/(?:' + re.escape(host) + r'/)?' + number + r'(?:/|$)', cwd or ''))
        busy = any(not r['ended'] and in_slot(r.get('cwd')) for h, r in runs if h == host)
        busy |= any(in_slot(r.get('cwd')) for r in data['heavy/' + host])
        activity = [claim['created']]
        activity += [r['end'] for h, r in runs if h == host and r.get('end') and in_slot(r.get('cwd'))]
        activity += [stamp(r['time']) for r in data['spool/heavy'] if r.get('host') == host and in_slot(r.get('cwd'))]
        for batch in data['spool/queue']:
            if batch.get('kind') != 'batch':
                continue
            for step in batch.get('steps', []):
                if any(in_slot(s.get('cwd')) for s in [step] + step.get('suites', [])):
                    activity.append(stamp(batch['time']))
        observation = state.setdefault('claims', {}).get(claim['subject'])
        signature = [claim['owner'], claim['created']]
        if observation is None or observation['signature'] != signature:
            observation = {'signature': signature, 'busy': False, 'idle_since': claim['created']}
            state['claims'][claim['subject']] = observation
        if busy:
            observation.update(busy=True, idle_since=now)
        elif observation['busy']:
            observation.update(busy=False, idle_since=now)
        observation['last_activity'] = max(activity + [observation.get('last_activity', claim['created'])])
        activity.extend((observation['idle_since'], observation['last_activity']))
        if not busy and older(max(activity), config['idle claim']['minutes']):
            add('idle claim', claim['subject'], claim['owner'],
                [f'claim since={iso(claim["created"])}; last activity={iso(max(activity))}', 'no live run, heavy command or recent precheck'],
                deps)
    refs = data.get('refs', {})
    seen = state.setdefault('refs', {})
    if 'refs' in data:
        for branch in list(seen):
            if branch not in refs:
                del seen[branch]
    for branch, tip in refs.items():
        if seen.get(branch, {}).get('tip') != tip:
            seen[branch] = dict(tip=tip, since=now, attempted=False)
        attempted = any(r.get('kind') == 'attempt' and r.get('branch') == branch and r.get('tip') == tip
                        for r in data.get('spool/queue', []))
        seen[branch]['attempted'] = attempted or seen[branch].get('attempted', False)
        if not seen[branch]['attempted'] and older(seen[branch]['since'], config['unqueued']['minutes']):
            add('unqueued', branch, 'ops', [f'tip={tip}', f'ready tip first observed={iso(seen[branch]["since"])}; no attempt'],
                ['refs', 'spool/queue'], branch=branch)
    if refs:
        batches = [stamp(r['time']) for r in data.get('spool/queue', []) if r.get('kind') == 'batch' and not r.get('dry')]
        if batches:
            state['last_batch'] = max(batches + [state.get('last_batch', 0)])
        last = state.get('last_batch', min(r['since'] for r in seen.values()))
        if older(last, config['unqueued']['batch_minutes']):
            add('unqueued', 'queue', 'ops', [f'ready refs={len(refs)}; last batch/first observation={iso(last)}'],
                ['refs', 'spool/queue'])
    lease_activity = state.setdefault('lease_activity', {})
    if 'leases' in data:
        subjects = {row['subject'] for row in data['leases']}
        for subject in list(lease_activity):
            if subject not in subjects:
                del lease_activity[subject]
    for row in data.get('leases', []):
        waiting = row.get('waiters', [])
        if not row.get('owner'):
            continue
        owner, subject = row['owner'], row['subject']
        events = [e for key in ('spool/heavy', 'spool/queue', 'spool/sessions') for e in data.get(key, [])]
        # Package activity must explicitly name the package/subject; never infer
        # activity from an unrelated event by the same coordinator.
        activity = [stamp(row['since'])] + [stamp(e['time']) for e in events if e.get('subject') == subject or
                    subject in e.get('subjects', []) or subject.removeprefix('pkg:') in e.get('packages', []) or
                    (e.get('branch') and e.get('branch') in row.get('lends', []))]
        signature = [owner, stamp(row['since'])]
        prior = lease_activity.get(subject, {})
        if prior.get('signature') == signature:
            activity.append(prior['time'])
        lease_activity[subject] = dict(signature=signature, time=max(activity))
        if not waiting:
            continue
        oldest = min(stamp(w['since']) for w in waiting)
        wait_past = older(oldest, config['lease stall']['waiter_minutes'])
        activity_deps = ['spool/heavy', 'spool/queue', 'spool/sessions']
        stalled = all(dep in data for dep in activity_deps) and older(max(activity), config['lease stall']['minutes'])
        if wait_past or stalled:
            add('lease stall', subject, owner, [f'waiters={len(waiting)}; oldest waiter={iso(oldest)}',
                f'last package event/lease start={iso(max(activity))}'],
                ['leases'] + ([] if wait_past else activity_deps))
    session_events = [dict(e, time=e['first_fired']) if e.get('kind') == 'handover-needed' and e.get('first_fired') else e
                      for e in data.get('spool/sessions', [])]
    for name, identity in names.items():
        aliases = identity.get('aliases', []) + [name]
        prefix = identity.get('name_prefix')
        def belongs(event):
            return (event.get('name') in aliases or event.get('owner') == name or
                    (prefix and (event.get('name') or '').startswith(prefix)))
        events = [e for e in session_events if belongs(e)]
        # Acknowledgements are metadata, never mail bodies. Read or unread both
        # prove the lead posted files current, so use collected post events.
        events += [dict(e, kind='files-current') for e in data.get('spool/post', [])
                   if e.get('kind') == 'mail' and e.get('from', '').split('@')[0] in aliases
                   and identity.get('role') == 'lead'
                   and e.get('subject', '').strip().casefold().startswith('files current')]
        facts = state.setdefault('handovers', {}).setdefault(name, {})
        hooks = facts.setdefault('hooks', {})
        if 'hook' in facts:  # Previous single-mailbox handover schema.
            old = facts.pop('hook')
            hooks.setdefault(old.get('session', name), old)
        events.extend(facts.get('acks', []))
        events.extend(facts.pop(key) for key in ('ack', 'start') if key in facts)
        acks = []
        for event in sorted(events, key=lambda e: stamp(e['time'])):
            projection = {key: event[key] for key in ['kind', 'time', 'session_kind', *JOIN] if key in event}
            kind = event.get('kind')
            if kind in ('context-hook', 'handover-needed'):
                sid = event.get('session', name)
                if sid not in hooks or stamp(event['time']) < stamp(hooks[sid]['time']):
                    hooks[sid] = projection
            elif kind in ('files-current', 'successor', 'handover', 'session-start'):
                if projection not in acks:
                    acks.append(projection)
        facts['acks'] = [ack for ack in acks if stamp(ack['time']) >= now-7200]
        for sid, hook in list(hooks.items()):
            fired = stamp(hook['time'])
            def acknowledges(ack):
                kind, when = ack['kind'], stamp(ack['time'])
                if kind in ('successor', 'handover', 'session-start'):
                    return when >= fired and (kind != 'session-start' or ack.get('session') != sid)
                if ack.get('session') and ack['session'] != sid:
                    return False
                # Mail headers have no session id: exclude a predecessor's ack
                # when a known session start separates it from this firing.
                starts = [stamp(e['time']) for e in acks if e['kind'] == 'session-start' and e.get('session') == sid]
                return when >= fired-1800 and (not starts or when >= max(starts))
            cleared = any(acknowledges(ack) for ack in acks)
            ended = False
            if hook.get('session'):
                if identity.get('kind') == 'codex' or hook.get('session_kind') == 'codex-owner':
                    current = data.get('turn/' + name, {}).get('owner_session')
                    successors = [r for r in data.get('agents', []) if r.get('name') in aliases
                                  and live_agent(r) and r.get('sessionId') != sid]
                    ended = bool(successors) or data.get('unit/' + name) is False or (current is not None and current != sid)
                    cleared |= ended
                else:
                    current_ids = {r.get('sessionId', r.get('id')) for r in live.get(name, [])}
                    ended = 'agents' in data and sid not in current_ids
                    cleared |= ended
            if cleared:
                # A tombstone prevents retained/repeated fired events reopening.
                hook['acknowledged'] = True
            if hook.get('acknowledged'):
                if ended and fired < now-7200:
                    del hooks[sid]
                continue
            if older(hook['time'], config['handover late']['minutes']):
                subject = name + '/' + sid if hook.get('session') else name
                add('handover late', subject, name, [f'context hook={hook["time"]}; no successor or files current'],
                    ['spool/sessions', 'spool/post', 'unit/' + name if identity.get('kind') == 'codex' else 'agents'],
                    **{k: hook[k] for k in JOIN if k in hook})
    for row in data.get('questions', []):
        if not row.get('answer') and now > stamp(row['deadline']):
            add('question due', row['subject'], 'director', [f'question={row["subject"]}; deadline={iso(stamp(row["deadline"]))}'],
                ['questions'])
    deliveries = {}
    stored = state.setdefault('deliveries', {})
    for message, saved in list(stored.items()):
        if saved['row']['exit'] != 2 and stamp(saved['row']['time']) < now - 7200:
            del stored[message]
        else:
            deliveries[message] = (saved['row'], saved['source'])
    for source in ('spool/post', 'spool/post-sent'):
        for row in data.get(source, []):
            if row.get('kind') in ('send', 'delivery', 'delivery-failed') and 'exit' in row:
                message = row.get('message_id', row['id'])
                if message not in deliveries or stamp(row['time']) >= stamp(deliveries[message][0]['time']):
                    # Retain only facts needed to resolve this message, not the
                    # source payload or mail subject. Success tombstones expire.
                    fact = {k: row[k] for k in ['id', 'time', 'exit', 'from', *JOIN] if k in row}
                    deliveries[message] = (fact, source)
                    stored[message] = dict(row=fact, source=source)
    for message, (row, source) in deliveries.items():
        if row.get('exit') == 2:
            add('delivery failed', message, row['from'].split('@')[0], ['post send exited 2; message_id=' + message],
                [source], **{k: row[k] for k in JOIN if k in row})
    return candidates


def reconcile(state, candidates, errors, config, now, action, post=True):
    """Episodes survive missing inputs. Only two successful clear runs close one."""
    episodes = state.setdefault('episodes', {})
    for key, episode in list(episodes.items()):
        if episode['rule'] == 'handover late' and episode.get('session') and episode['subject'] == episode['owner']:
            subject = episode['owner'] + '/' + episode['session']
            episode['subject'] = subject
            episodes.setdefault('handover late\t' + subject, episode)
            del episodes[key]
        if episode['rule'] == 'report unread' and episode['subject'] != episode['owner']:
            new_key = 'report unread\t' + episode['owner']
            episode['subject'] = episode['owner']
            previous = episodes.get(new_key)
            if previous:
                previous['opened'] = min(previous['opened'], episode['opened'])
                previous['escalated'] = previous['escalated'] or episode['escalated']
                previous['notified'] = previous['notified'] or episode['notified']
            else:
                episodes[new_key] = episode
            del episodes[key]
    events = []
    # Older state treated suppressed sends as delivered and has no mode marker.
    if 'posts_enabled' not in state:
        for episode in episodes.values():
            episode.setdefault('silent_since', episode['opened'])
    state['posts_enabled'] = post
    def emit(kind, episode):
        fields = {k: v for k, v in episode.items() if k in JOIN + ['rule', 'subject', 'owner', 'supervisor', 'wake', 'episode', 'evidence', 'remedy_result', 'remedy_attempts', 'remedy_reason']}
        identity = [kind, episode['rule'], episode['subject'], episode['opened'], episode.get('episode', 0), episode.get('remedy_attempts', 0) if kind == 'remedy' else 0]
        events.append(dict(fields, id='watch:' + hashlib.sha256(json.dumps(identity).encode()).hexdigest(),
                           time=iso(now), source='watch', host='hel8', kind=kind))
    for key, candidate in sorted(candidates.items()):
        if any(dep in errors for dep in candidate['deps']):
            if key in episodes:
                episodes[key]['clear'] = 0
            continue
        episode = episodes.get(key)
        created = episode is None
        if created:
            state['next_episode'] = state.get('next_episode', 0) + 1
            episode = dict(candidate, episode=state['next_episode'], opened=now, clear=0, escalated=False, notified=False)
            if not post:
                episode['silent_since'] = now
            if candidate['rule'] in ('deaf', 'gone', 'report unread', 'waiter orphan', 'waiter dead'):
                pass
            else:
                episode['notified'] = action('send', candidate['owner'], candidate) in (0, 3)
            episodes[key] = episode
            emit('alert-open', episode)
        else:
            episode['clear'] = 0
            episode.update(candidate)
        if candidate['rule'] in ('deaf', 'gone', 'report unread', 'waiter orphan', 'waiter dead'):
            rule = config[candidate['rule']]
            plan = candidate.get('remedy') if rule.get('remedy', False) else None
            attempts = episode.get('remedy_attempts', 0)
            retry_due = now - episode.get('remedy_at', 0) >= rule.get('retry_seconds', 120)
            if plan and attempts < min(2, rule.get('max_attempts', 2)) and (attempts == 0 or (not episode.get('remedy_success') and retry_due)):
                result = action('remedy', candidate['owner'], candidate)
                if result.get('attempted', True):
                    episode['remedy_attempts'] = attempts + 1
                    episode['remedy_at'] = now
                    episode['remedy_success'] = result.get('success', False)
                    episode['remedy_result'] = result
                    emit('remedy', episode)
                episode['notified'] = True
            elif not plan and not candidate['rule'].startswith('waiter ') and ('silent_since' in episode and post or not episode['notified']):
                notice = dict(candidate)
                target = candidate['owner']
                if 'silent_since' in episode and post:
                    notice['was_silent_since'] = iso(episode['silent_since'])
                    if (now - episode['opened'] > rule['escalate_minutes'] * 60 and episode['escalate_to']
                            and (episode['escalate_to'] != 'director' or candidate.get('director_escalation'))):
                        target = episode['escalate_to']
                delivered = action('send', target, notice) in (0, 3)
                episode['notified'] = delivered and post
                if not delivered and post and 'silent_since' in episode:
                    continue
                if delivered and post:
                    episode.pop('silent_since', None)
                    if target != candidate['owner'] and not episode['escalated']:
                        episode['escalated'] = True
                        emit('alert-escalate', episode)
            # Suppressed actions never consume attempts or deliver escalations.
            if not post:
                continue
            if 'silent_since' in episode and episode['notified']:
                episode.pop('silent_since')
            attempted = episode.get('remedy_attempts', 0)
            failed_twice = attempted >= 2 and not episode.get('remedy_success')
            elapsed = now - episode.get('remedy_at', episode['opened'])
            due = failed_twice or elapsed > rule['escalate_minutes'] * 60
            if candidate['rule'].startswith('waiter '):
                due = False
            if due and episode['escalate_to'] and not episode['escalated']:
                # Fixed infrastructure roles and coordinators may reach director.
                target = episode['escalate_to']
                director_ok = candidate.get('director_escalation', False)
                if target != 'director' or director_ok:
                    if action('send', target, candidate) in (0, 3):
                        episode['escalated'] = True
                        emit('alert-escalate', episode)
            continue
        interval = config[candidate['rule']]['escalate_minutes'] * 60
        due = bool(episode['escalate_to']) and now - episode['opened'] >= interval
        if post and 'silent_since' in episode:
            # Re-evaluation above proves it is still active. Send one catch-up,
            # directly to the supervisor if escalation is already due.
            notice = dict(candidate, was_silent_since=iso(episode['silent_since']))
            to = episode['escalate_to'] if due else candidate['owner']
            if action('send', to, notice) in (0, 3):
                episode.pop('silent_since')
                episode['notified'] = True
                if due and not episode['escalated']:
                    episode['escalated'] = True
                    emit('alert-escalate', episode)
            continue
        if not created and not episode['notified']:
            episode['notified'] = action('send', candidate['owner'], candidate) in (0, 3)
        if episode['escalate_to'] and not episode['escalated'] and now - episode['opened'] >= interval:
            if action('send', episode['escalate_to'], candidate) in (0, 3):
                episode['escalated'] = True
                emit('alert-escalate', episode)
    for key, episode in list(episodes.items()):
        if any(dep in errors for dep in episode['deps']):
            episode['clear'] = 0
            continue
        if key in candidates:
            continue
        episode['clear'] += 1
        if episode['clear'] >= 2:
            emit('alert-close', episode)
            del episodes[key]
    return events


@contextmanager
def state_file(dry):
    path = Path.home() / '.local/state/watch/state.json'
    if dry:
        yield path, json.loads(path.read_text()) if path.exists() else {}
        return
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (path.parent / 'watch.lock').open('a') as lock:
        os.chmod(lock.name, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield path, json.loads(path.read_text()) if path.exists() else {}


def heartbeat_due(state, events, errors, now, seconds):
    previous = state.get('heartbeat', {})
    return (bool(events) or sorted(errors) != previous.get('failed_inputs') or
            now - previous.get('time', now) >= seconds)


def run(dry, config, post, heartbeat_seconds, settings=None, remedies=True):
    now = time.time()
    with state_file(dry) as (path, state), tempfile.TemporaryDirectory(prefix='watch-records-') as temp:
        # Even record pull creates locks and may fast-forward. In a preview its
        # dedicated disposable clone protects the real records clone and state.
        records = Path(temp) / 'records' if dry else Path(os.environ.get('RECORDS_REPO', '~/src/fabrig/records')).expanduser()
        for episode in state.get('episodes', {}).values():
            episode['deps'] = [dep.replace('records/', 'spool/', 1) if dep.startswith('records/') else dep
                               for dep in episode['deps']]
        inputs = Inputs(dry, settings, Path(temp) if dry else path.parent).collect(records)
        data, errors = inputs.data, inputs.errors
        # Missing dependencies must not be interpreted as a quiet input.
        for source in ('drafts', 'questions', 'spool/queue', 'spool/heavy', 'spool/sessions', 'spool/post', 'spool/post-sent'):
            if source not in data:
                errors.setdefault(source, 'unavailable')
        for episode in state.get('episodes', {}).values():
            for dependency in episode['deps']:
                if not dependency.startswith('owns/') and dependency not in data:
                    errors.setdefault(dependency, 'unavailable')
        def action(kind, to, candidate):
            if kind == 'remedy':
                plan = candidate['remedy']
                if dry or not post or not remedies:
                    print('would remedy ' + json.dumps(plan, sort_keys=True))
                    return dict(attempted=False, result='dry-run' if dry else 'suppressed')
                return repair(plan, config[candidate['rule']], inputs.executables['session-start'])
            argv = [
                'post', 'send', '--as', 'watch', to, 'watch: ' + candidate['rule'] + ' ' + candidate['subject']]
            lines = candidate['evidence'][:6]
            if 'was_silent_since' in candidate:
                lines = ['(was silent since ' + candidate['was_silent_since'] + ')'] + lines
            body = '\n'.join(lines) + '\n'
            if dry or not post:
                print('would ' + shlex.join(argv))
                print(body, end='')
                return 0
            try:
                result = command(argv, data=body)
                if result.returncode not in (0, 3):
                    errors['post/send'] = 'exit ' + str(result.returncode)
                return result.returncode
            except (OSError, subprocess.SubprocessError) as error:
                errors['post/' + kind] = type(error).__name__
                return 2
        candidates = evaluate(data, state, config, now)
        if dry:
            for candidate in candidates.values():
                if candidate['rule'] in ('deaf', 'gone', 'report unread'):
                    print('condition ' + json.dumps(candidate, sort_keys=True))
        events = reconcile(state, candidates, errors, config, now, action, post=post)
        # A failed ownership lookup freezes the corresponding episodes as well.
        dependencies = {
            'deaf': ['agents', 'waiters', 'mail'], 'gone': ['names', 'agents', 'drafts'],
            'report unread': ['agents', 'waiters', 'mail'], 'run hung': [],
            'idle claim': ['claims', 'spool/heavy', 'spool/queue'],
            'unqueued': ['refs', 'spool/queue'],
            'lease stall': ['names', 'leases'],
            'handover late': ['names', 'agents', 'spool/sessions', 'spool/post'],
            'waiter orphan': ['names', 'agents', 'waiters'], 'waiter dead': ['names', 'agents', 'waiters'],
            'question due': ['names', 'questions'], 'delivery failed': [],
        }
        skipped = {rule: [dep for dep in dependencies[rule] if dep in errors]
                   for rule in RULES if config[rule]['enabled']}
        skipped = {rule: missing for rule, missing in skipped.items() if missing}
        if heartbeat_due(state, events, errors, now, heartbeat_seconds):
            events.append(dict(id='watch:heartbeat:' + str(time.time_ns()), time=iso(now), source='watch', host='hel8',
                               kind='heartbeat', rules_evaluated=[r for r in RULES if config[r]['enabled'] and r not in skipped],
                               rules_skipped=skipped,
                               alerts_open=len(state['episodes']),
                               inputs=dict(inputs.executables), inputs_failed=errors))
            state['heartbeat'] = dict(time=now, failed_inputs=sorted(errors))
        pending = state.setdefault('pending', [])
        pending.extend(events)
        payload = ''.join(json.dumps(e, sort_keys=True) + '\n' for e in pending)
        if dry:
            if pending:
                print('would spool watch hel8')
                print(payload, end='')
        else:
            # Persist evaluations and the outbox even when no publication is due.
            atomic(path, state)
            try:
                event_spool.append('watch', pending, now)
            except (OSError, ValueError, KeyError, TypeError) as error:
                print(f'watch: spool failed; events retained: {error}', file=sys.stderr)
                return 2
            state['pending'] = []
            state.pop('deferrals', None)
            state.pop('publication_reason', None)
            atomic(path, state)
            print(f'watch: spooled {len(pending)} events')
        print(f'watch: {len(candidates)} conditions; {len(state["episodes"])} open; {len(errors)} failed inputs')
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--once', action='store_true')
    parser.add_argument('--no-post', action='store_true')
    parser.add_argument('--no-remedy', action='store_true')
    parser.add_argument('--config', type=Path, default=Path(__file__).with_name('watch.toml'))
    parser.add_argument('--probe', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.probe:
        print(json.dumps(probe()))
        return 0
    try:
        with args.config.open('rb') as stream:
            config = tomllib.load(stream)
        post = config['alerts']['post']
        if type(post) is not bool:
            raise ValueError('alerts.post must be boolean')
        heartbeat_seconds = config['watch']['heartbeat_seconds']
        if type(heartbeat_seconds) is not int or heartbeat_seconds <= 0:
            raise ValueError('watch.heartbeat_seconds must be a positive integer')
        for rule in RULES:
            row = config['rules'][rule]
            if 'remedy' in row and type(row['remedy']) is not bool:
                raise ValueError('remedy must be boolean')
            if type(row['enabled']) is not bool or any(type(v) not in (int, float) or v < 0 for k, v in row.items() if k not in ('enabled', 'remedy')):
                raise ValueError('invalid rule configuration')
            if 'stop_timeout_seconds' in row and not 0 < row['stop_timeout_seconds'] <= 60:
                raise ValueError('stop timeout must be in (0, 60]')
            if 'stop_poll_seconds' in row and row['stop_poll_seconds'] <= 0:
                raise ValueError('stop poll must be positive')
        while True:
            status = run(args.dry_run, config['rules'], post and not args.no_post, heartbeat_seconds, config['watch'], not args.no_remedy)
            if args.once or args.dry_run or status:
                return status
            time.sleep(config['watch']['interval_seconds'])
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(f'watch: {type(error).__name__}: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
