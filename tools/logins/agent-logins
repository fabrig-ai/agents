#!/usr/bin/env -S python3 -I -B
"""Private Claude and Codex login shelf; see agent-logins.md."""
import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import json
import os
from pathlib import Path
import re
import secrets
import shlex
import stat
import subprocess
import sys
import tempfile
import tomllib

os.umask(0o077)
FILES = {'claude': '.credentials.json', 'codex': 'auth.json'}
ID = r'[a-z0-9-]+'
HASH = r'[0-9a-f]{64}'

# Runs locally and over ssh. O_PATH pins an inode without opening it for
# reading. Only cat/sha256sum read credentials, through that inherited inode.
# Never forward a child's diagnostic: even a failed service is not a log sink.
SOURCE = r'''
import os, stat, sys
operation, path = sys.argv[1:]
path = os.path.abspath(os.path.expanduser(path))
fds = []
try:
    fd = os.open('/', os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC)
    fds.append(fd)
    parts = path.split('/')[1:]
    for part in parts[:-1]:
        fd = os.open(part, os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
        fds.append(fd)
    info = os.fstat(fd)
    if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
        sys.exit(4)
    fd = os.open(parts[-1], os.O_PATH | os.O_NOFOLLOW, dir_fd=fd)
    fds.append(fd)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1 or info.st_size == 0):
        sys.exit(4)
    os.set_inheritable(fd, True)
    for parent in fds[:-1]:
        os.close(parent)
except FileNotFoundError:
    sys.exit(3)
except OSError:
    sys.exit(4)
try:
    os.execvp(operation, [operation, '--', '/proc/self/fd/' + str(fd)])
except OSError:
    sys.exit(4)
'''

# Mutations run at the credential's host. Python only handles O_PATH or
# write-only descriptors; cat handles stdin and sha256sum handles reads.
MUTATE = r'''
import os, re, stat, subprocess, sys
os.umask(0o077)
operation, path, token, digest = sys.argv[1:]
if not re.fullmatch(r'[0-9a-f]{32}', token):
    sys.exit(4)
path = os.path.abspath(os.path.expanduser(path))
parts = path.split('/')[1:]
stage = '.agent-logins-' + token
fds = []
def private(name):
    try:
        fd = os.open(name, os.O_PATH | os.O_NOFOLLOW, dir_fd=parent)
    except FileNotFoundError:
        sys.exit(3)
    fds.append(fd)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1 or info.st_size == 0):
        sys.exit(4)
    return fd, info
def verify(fd, info):
    result = subprocess.run(['sha256sum', '--', '/proc/self/fd/' + str(fd)],
                            pass_fds=(fd,), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            stdin=subprocess.DEVNULL, timeout=120)
    if (result.returncode != 0 or result.stdout != (digest + '  /proc/self/fd/' + str(fd) + '\n').encode('ascii')):
        sys.exit(7)
    current = os.fstat(fd)
    if (current.st_size, current.st_mtime_ns, current.st_ctime_ns) != (info.st_size, info.st_mtime_ns, info.st_ctime_ns):
        sys.exit(7)
try:
    parent = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    fds.append(parent)
    for index, part in enumerate(parts[:-1]):
        if operation == 'stage' and index == len(parts) - 2:
            try:
                os.mkdir(part, 0o700, dir_fd=parent)
            except FileExistsError:
                pass
        try:
            parent = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=parent)
        except FileNotFoundError:
            sys.exit(3 if operation in ('probe', 'remove', 'discard') else 4)
        fds.append(parent)
    info = os.fstat(parent)
    if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
        sys.exit(4)
    filename = parts[-1]
    if operation == 'probe':
        try:
            os.stat(filename, dir_fd=parent, follow_symlinks=False)
        except FileNotFoundError:
            sys.exit(3)
        sys.exit(5)
    if operation == 'stage':
        try:
            os.stat(filename, dir_fd=parent, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            sys.exit(5)
        fd = os.open(stage, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=parent)
        fds.append(fd)
        result = subprocess.run(['cat'], stdin=0, stdout=fd, stderr=subprocess.DEVNULL, timeout=120)
        if result.returncode != 0:
            sys.exit(4)
        os.fsync(fd)
    elif operation == 'install':
        fd, info = private(stage)
        verify(fd, info)
        try:
            # link/unlink publishes without overwriting a raced-in credential.
            os.link(stage, filename, src_dir_fd=parent, dst_dir_fd=parent, follow_symlinks=False)
        except FileExistsError:
            sys.exit(5)
        os.unlink(stage, dir_fd=parent)
    elif operation == 'remove':
        fd, info = private(filename)
        verify(fd, info)
        current = os.stat(filename, dir_fd=parent, follow_symlinks=False)
        if (current.st_dev, current.st_ino, current.st_size, current.st_mtime_ns, current.st_ctime_ns) != (
                info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns):
            sys.exit(7)
        os.unlink(filename, dir_fd=parent)
    elif operation == 'discard':
        info = os.stat(stage, dir_fd=parent, follow_symlinks=False)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):
            sys.exit(4)
        os.unlink(stage, dir_fd=parent)
    else:
        sys.exit(4)
    os.fsync(parent)
except FileNotFoundError:
    # A missing executable or a pathname lost during mutation is not proof
    # that the active credential was absent before the operation.
    sys.exit(4)
except (OSError, ValueError, subprocess.SubprocessError):
    sys.exit(4)
'''


class Problem(Exception):
    pass


def need(condition, message):
    if not condition:
        raise Problem(message)


def now():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def check(info, directory, path):
    kind = stat.S_ISDIR if directory else stat.S_ISREG
    mode = 0o700 if directory else 0o600
    need(kind(info.st_mode) and info.st_uid == os.geteuid()
         and stat.S_IMODE(info.st_mode) == mode
         and (directory or info.st_nlink == 1),
         f'{path}: expected owned {mode:04o} {"directory" if directory else "single-link regular file"}')


@contextmanager
def directory(path, create=False, private=False):
    """Walk each component without following links; pin the final directory."""
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for part in path.parts[1:]:
            if create:
                try:
                    os.mkdir(part, mode=0o700, dir_fd=fd)
                except FileExistsError:
                    pass
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                            dir_fd=fd)
            os.close(fd)
            fd = child
        if private:
            check(os.fstat(fd), True, path)
        yield fd
    finally:
        os.close(fd)


def private_file(parent, name, flags):
    # lstat before open avoids opening FIFOs/devices. O_NOFOLLOW and fstat
    # cover replacement between the two; O_NONBLOCK prevents a FIFO race hang.
    try:
        check(os.stat(name, dir_fd=parent, follow_symlinks=False), False, name)
    except FileNotFoundError:
        need(flags & os.O_CREAT, f'{name}: absent')
    fd = os.open(name, flags | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, 0o600, dir_fd=parent)
    try:
        check(os.fstat(fd), False, name)
    except BaseException:
        os.close(fd)
        raise
    return fd


def command(helper, *args, target=None):
    result = ['python3', '-I', '-B', '-c', helper, *map(str, args)]
    if target is not None:
        result = ['ssh', '-T', '-o', 'BatchMode=yes', '--', target, shlex.join(result)]
    return result


def mutate(operation, path, target=None, token=None, digest='', stdin=None):
    return subprocess.run(command(MUTATE, operation, path, token or secrets.token_hex(16), digest, target=target),
                          stdin=stdin if stdin is not None else subprocess.DEVNULL,
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120).returncode


def stream_to_host(source, path, target, token):
    producer = subprocess.Popen(command(SOURCE, 'cat', source), stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        code = mutate('stage', path, target, token, stdin=producer.stdout)
        producer.stdout.close()
        need(producer.wait(timeout=120) == 0 and code == 0, f'{path}: credential streaming failed')
    finally:
        producer.stdout.close()
        if producer.poll() is None:
            producer.kill()
            producer.wait()


def transfer(operation, path, target=None, output=None):
    need(operation in ('cat', 'sha256sum') and (operation != 'cat' or output is not None),
         'cat requires a file descriptor sink')
    result = subprocess.run(command(SOURCE, operation, path, target=target), stdin=subprocess.DEVNULL,
                            stdout=output if output is not None else subprocess.PIPE,
                            stderr=subprocess.DEVNULL, timeout=120)
    if result.returncode == 3:
        return None
    need(result.returncode == 0, f'{path}: unsafe source or {operation} failed')
    if output is not None:
        return True
    # Only the hash helper may produce captured output. Never capture cat.
    match = re.fullmatch(rb'([0-9a-f]{64})  /proc/self/fd/[0-9]+\n', result.stdout)
    need(match is not None, f'{path}: invalid sha256sum response')
    return match[1].decode('ascii')


class Shelf:
    def __init__(self):
        self.home = Path.home()
        self.root = self.home / 'src/fabrig/logins/pool'

    @contextmanager
    def locked(self):
        # Intermediate shared source directories need not be 0700, but none
        # may be a link; the shelf parent and everything within it are private.
        with directory(self.root.parent, create=True, private=True):
            with directory(self.root, create=True, private=True) as root:
                self.fd = root
                lock = private_file(root, 'lock', os.O_RDWR | os.O_CREAT)
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX)
                    info = os.stat('lock', dir_fd=root, follow_symlinks=False)
                    need((info.st_dev, info.st_ino) == (os.fstat(lock).st_dev, os.fstat(lock).st_ino),
                         'lock: replaced while waiting')
                    self.load()
                    self.validate_layout()
                    yield
                finally:
                    os.close(lock)

    def validate_layout(self):
        # Prepared and orphaned entries are not custody records, but their
        # directories and any expected credential still obey shelf safety.
        for provider, filename in FILES.items():
            try:
                os.stat(provider, dir_fd=self.fd, follow_symlinks=False)
            except FileNotFoundError:
                continue
            with directory(self.root / provider, private=True) as parent:
                for name in os.listdir(parent):
                    if name.startswith('.capture-'):
                        check(os.stat(name, dir_fd=parent, follow_symlinks=False), False, name)
                        continue
                    need(re.fullmatch(ID, name), 'shelf: invalid entry name')
                    path = self.root / provider / name
                    with directory(path, private=True) as entry:
                        try:
                            info = os.stat(filename, dir_fd=entry, follow_symlinks=False)
                        except FileNotFoundError:
                            continue
                        check(info, False, path / filename)

    def load(self):
        try:
            os.stat('state.json', dir_fd=self.fd, follow_symlinks=False)
        except FileNotFoundError:
            self.entries = []
            self.pending = None
            return
        fd = private_file(self.fd, 'state.json', os.O_RDONLY)
        try:
            with os.fdopen(fd) as stream:
                data = json.load(stream)
        except (ValueError, UnicodeError):
            raise Problem('state.json: invalid metadata') from None
        need(isinstance(data, dict) and {'version', 'entries'} <= set(data) <= {'version', 'entries', 'pending'}
             and data['version'] == 1
             and isinstance(data['entries'], list), 'state.json: invalid schema')
        self.pending = data.get('pending')
        need(self.pending is None, 'unfinished custody transfer: operator recovery required; do not use either copy')
        self.entries = data['entries']
        seen = set()
        for row in self.entries:
            need(isinstance(row, dict) and set(row) == {
                'provider', 'id', 'status', 'origin', 'sha256', 'kind', 'created_at', 'updated_at', 'moves'
            }, 'state.json: invalid entry')
            provider, identity = row['provider'], row['id']
            need(isinstance(provider, str) and provider in FILES and isinstance(identity, str)
                 and re.fullmatch(ID, identity), 'state.json: invalid entry name')
            key = provider, identity
            need(key not in seen, 'state.json: duplicate entry')
            seen.add(key)
            need(isinstance(row['sha256'], str) and re.fullmatch(HASH, row['sha256']),
                 'state.json: invalid hash')
            need(row['kind'] in ('snapshot', 'own') and isinstance(row['status'], str),
                 'state.json: invalid custody')
            if row['kind'] == 'own':
                need(row['origin'] == 'signed-in', 'state.json: invalid own login')
                initial = 'free'
            else:
                origin = row['origin']
                need(isinstance(origin, dict) and set(origin) == {'host', 'path'}
                     and isinstance(origin['host'], str) and re.fullmatch(ID, origin['host'])
                     and origin['path'] == '~/' + ('.claude/.credentials.json' if provider == 'claude' else '.codex/auth.json'),
                     'state.json: invalid snapshot')
                initial = 'bound:' + origin['host']
            for field in ('created_at', 'updated_at'):
                need(isinstance(row[field], str) and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ', row[field]),
                     'state.json: invalid time')
            need(isinstance(row['moves'], list) and len(row['moves']) >= 1
                 and row['moves'][0] == {'at': row['created_at'], 'event': 'capture' if row['kind'] == 'snapshot' else 'register',
                                         'to': initial}, 'state.json: invalid moves')
            status = initial
            for move in row['moves'][1:]:
                need(isinstance(move, dict) and set(move) == {'at', 'event', 'to', 'sha256'}
                     and isinstance(move['at'], str) and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ', move['at'])
                     and isinstance(move['sha256'], str) and re.fullmatch(HASH, move['sha256']),
                     'state.json: invalid move')
                need((move['event'] == 'release' and status.startswith(('bound:', 'lent:')) and move['to'] == 'free')
                     or (move['event'] == 'lend' and status == 'free' and isinstance(move['to'], str)
                         and re.fullmatch('lent:' + ID, move['to'])), 'state.json: invalid custody transition')
                status = move['to']
            need(status == row['status'] and row['moves'][-1]['at'] == row['updated_at'],
                 'state.json: inconsistent custody history')
            if len(row['moves']) > 1:
                need(row['moves'][-1]['sha256'] == row['sha256'], 'state.json: inconsistent hash history')
            self.check_entry(provider, identity)

    def check_entry(self, provider, identity):
        path = self.root / provider / identity
        with directory(self.root / provider, private=True):
            with directory(path, private=True) as fd:
                info = os.stat(FILES[provider], dir_fd=fd, follow_symlinks=False)
                check(info, False, path / FILES[provider])
                need(info.st_size > 0, f'{path / FILES[provider]}: empty credential')

    def save(self):
        fd, name = tempfile.mkstemp(prefix='.state-', dir=self.root)
        try:
            with os.fdopen(fd, 'w') as stream:
                data = {'version': 1, 'entries': self.entries}
                if self.pending is not None:
                    data['pending'] = self.pending
                json.dump(data, stream, indent=2)
                stream.write('\n')
                stream.flush()
                os.fsync(stream.fileno())
            # Refuse a state path replaced by an unsafe object since load.
            try:
                check(os.stat('state.json', dir_fd=self.fd, follow_symlinks=False), False, 'state.json')
            except FileNotFoundError:
                pass
            os.replace(name, self.root / 'state.json')
            os.fsync(self.fd)
        finally:
            Path(name).unlink(missing_ok=True)

    def add(self, provider, identity, digest, host=None):
        time = now()
        status = 'bound:' + host if host else 'free'
        self.entries.append(dict(provider=provider, id=identity, status=status,
                                 origin={'host': host, 'path': '~/' + ('.claude/.credentials.json' if provider == 'claude'
                                                                   else '.codex/auth.json')} if host else 'signed-in',
                                 sha256=digest, kind='snapshot' if host else 'own', created_at=time, updated_at=time,
                                 moves=[{'at': time, 'event': 'capture' if host else 'register', 'to': status}]))
        self.save()

    def prepare(self, provider, identity):
        path = self.root / provider / identity
        with directory(path.parent, create=True, private=True) as parent:
            os.mkdir(identity, mode=0o700, dir_fd=parent)
        variable, command = ('CODEX_HOME', 'codex login --device-auth') if provider == 'codex' else (
            'CLAUDE_CONFIG_DIR', 'claude auth login')
        print(f'{variable}={shlex.quote(str(path))} {command}')

    def register(self, provider, identity):
        self.check_entry(provider, identity)
        path = self.root / provider / identity / FILES[provider]
        existing = next((row for row in self.entries if (row['provider'], row['id']) == (provider, identity)), None)
        need(existing is None or (existing['kind'] == 'own' and existing['status'] == 'free'),
             f'{path}: held login or snapshot cannot be registered')
        digest = transfer('sha256sum', path)
        need(digest is not None, f'{path}: absent')
        if existing is not None:
            need(existing['sha256'] == digest, f'{path}: registered login changed')
        else:
            self.add(provider, identity, digest)
        print(f'{path}: {digest}')

    def host(self, host, provider):
        need(re.fullmatch(ID, host), 'invalid host')
        # The current release is intentionally a symlink. No checkout fallback.
        hosts = self.home / 'src/fabrig/current/fleet/hosts.toml'
        try:
            with hosts.open('rb') as stream:
                fleet = tomllib.load(stream)['hosts']
            target = fleet[host]['ssh']
        except (KeyError, ValueError):
            raise Problem('fleet/hosts.toml: unknown host or invalid roster') from None
        need(isinstance(target, str) and re.fullmatch(r'[A-Za-z0-9_.@:-]+', target)
             and not target.startswith('-'), 'fleet/hosts.toml: invalid ssh target')
        relative = Path('.claude' if provider == 'claude' else '.codex') / FILES[provider]
        return (self.home / relative, None) if host == 'hel8' else (Path('~') / relative, target)

    def capture(self, host, dry_run):
        for provider, filename in FILES.items():
            source, remote = self.host(host, provider)
            need(not any(row['provider'] == provider and row['status'] == 'lent:' + host for row in self.entries),
                 f'{host}:{source}: lent login; use release first')
            if dry_run:
                print(f'{host}:{source} -> {self.root / provider} (dry-run)')
                continue
            with directory(self.root / provider, create=True, private=True):
                fd, name = tempfile.mkstemp(prefix='.capture-', dir=self.root / provider)
                temporary = Path(name)
                destination = None
                try:
                    with os.fdopen(fd, 'wb') as stream:
                        present = transfer('cat', source, remote, stream)
                        stream.flush()
                        os.fsync(stream.fileno())
                    if present is None:
                        print(f'{host}:{source}: absent')
                        continue
                    digest = transfer('sha256sum', temporary)
                    expected = transfer('sha256sum', source, remote)
                    need(expected is not None and digest == expected, f'{host}:{source}: sha256 mismatch')
                    need(not any(row['provider'] == provider and row['sha256'] == digest and row['status'] == 'free'
                                 for row in self.entries), f'{host}:{source}: hash already free on shelf; custody conflict')
                    if any(row['provider'] == provider and row['kind'] == 'snapshot'
                           and row['origin']['host'] == host and row['status'] == 'bound:' + host
                           and row['sha256'] == digest for row in self.entries):
                        print(f'{host}:{source}: {digest} unchanged')
                        continue
                    # Full hashes avoid collisions; suffixes protect prepared/unregistered entries.
                    base = f'{host}-{digest}'
                    identity = base
                    suffix = 0
                    while (self.root / provider / identity).exists() or (self.root / provider / identity).is_symlink():
                        suffix += 1
                        identity = f'{base}-{suffix}'
                    destination = self.root / provider / identity
                    destination.mkdir(mode=0o700)
                    os.replace(temporary, destination / filename)
                    # The credential rename precedes the atomic metadata commit.
                    # A crash can leave a private unregistered entry, never a free snapshot.
                    self.add(provider, identity, digest, host)
                    print(f'{destination / filename}: {digest}')
                    destination = None
                finally:
                    temporary.unlink(missing_ok=True)
                    if destination is not None:
                        # Retain an orphan after a metadata failure for operator recovery.
                        if not (destination / filename).exists():
                            destination.rmdir()

    def entry(self, identity, provider=None):
        need(isinstance(identity, str) and re.fullmatch(ID, identity), 'invalid login id')
        matches = [row for row in self.entries if row['id'] == identity
                   and (provider is None or row['provider'] == provider)]
        need(len(matches) == 1, 'unknown or ambiguous login id (lend IDs must identify one provider)')
        return matches[0]

    def begin(self, event, row, host, digest, **paths):
        self.pending = dict(event=event, provider=row['provider'], id=row['id'], host=host, sha256=digest, **paths)
        self.save()

    def cancel(self):
        self.pending = None
        self.save()

    def moved(self, row, event, status, digest):
        time = now()
        row.update(status=status, sha256=digest, updated_at=time)
        row['moves'].append(dict(at=time, event=event, to=status, sha256=digest))
        self.pending = None
        self.save()

    def release(self, host, provider, dry_run=False):
        source, remote = self.host(host, provider)
        lent = [row for row in self.entries if row['provider'] == provider and row['status'] == 'lent:' + host]
        bound = [row for row in self.entries if row['provider'] == provider and row['status'] == 'bound:' + host]
        need(len(lent) <= 1, 'multiple lent entries for host; operator review required')
        matches = lent or bound
        need(matches, f'{host}:{source}: no bound or lent entry')
        # Previous capture versions remain unavailable historical placeholders.
        row = matches[-1]
        path = self.root / provider / row['id'] / FILES[provider]
        if dry_run:
            print(f'{host}:{source} -> {path}; remove {host}:{source} (dry-run)')
            return
        fd, name = tempfile.mkstemp(prefix='.release-new-', dir=path.parent)
        temporary = Path(name)
        backup = path.parent / ('.release-old-' + secrets.token_hex(16))
        try:
            with os.fdopen(fd, 'wb') as stream:
                need(transfer('cat', source, remote, stream) is not None, f'{host}:{source}: absent; release refused')
                stream.flush()
                os.fsync(stream.fileno())
            digest = transfer('sha256sum', temporary)
            need(digest is not None and digest == transfer('sha256sum', source, remote),
                 f'{host}:{source}: sha256 mismatch; both copies unchanged')
            self.begin('release', row, host, digest, backup=str(backup), temporary=str(temporary))
            try:
                os.rename(path, backup)
                os.replace(temporary, path)
                with directory(path.parent, private=True) as parent:
                    os.fsync(parent)
                need(transfer('sha256sum', path) == digest, f'{path}: installed shelf sha256 mismatch')
            except Exception:
                if backup.exists():
                    os.replace(backup, path)
                self.cancel()
                raise
            # A lost SSH response may follow a successful unlink. Keep the new
            # shelf copy plus journal/backup until an operator reconciles it.
            code = mutate('remove', source, remote, digest=digest)
            if code == 7:
                os.replace(backup, path)
                self.cancel()
                raise Problem(f'{host}:{source}: source changed; release refused; shelf restored')
            need(code == 0, f'{host}:{source}: release incomplete; custody blocked for operator recovery')
            self.moved(row, 'release', 'free', digest)
            backup.unlink()
            with directory(path.parent, private=True) as parent:
                os.fsync(parent)
            print(f'{path}: free {digest}; removed {host}:{source}')
        finally:
            temporary.unlink(missing_ok=True)

    def lend(self, identity, host, dry_run=False, provider=None):
        row = self.entry(identity, provider)
        provider = row['provider']
        destination, remote = self.host(host, provider)
        path = self.root / provider / identity / FILES[provider]
        need(row['status'] == 'free', f'{path}: only free entries can be lent')
        need(not any(other['provider'] == provider and other['status'] == 'lent:' + host for other in self.entries),
             f'{host}:{destination}: release first')
        if dry_run:
            print(f'{path} -> {host}:{destination} (dry-run; destination absence not checked)')
            return
        probe = mutate('probe', destination, remote)
        need(probe != 5, f'{host}:{destination}: release first')
        need(probe == 3, f'{host}:{destination}: unsafe or unavailable destination')
        digest = transfer('sha256sum', path)
        need(digest == row['sha256'], f'{path}: free shelf credential changed; lend refused')
        token = secrets.token_hex(16)
        staged = destination.parent / ('.agent-logins-' + token)
        staged_exists = True
        try:
            stream_to_host(path, destination, remote, token)
            need(transfer('sha256sum', staged, remote) == digest and transfer('sha256sum', path) == digest,
                 f'{host}:{destination}: sha256 mismatch; both ends unchanged')
            self.begin('lend', row, host, digest, temporary=str(staged))
            code = mutate('install', destination, remote, token, digest)
            if code in (5, 7):
                self.cancel()
                raise Problem(f'{host}:{destination}: release first or staged sha256 changed; lend refused')
            need(code == 0, f'{host}:{destination}: lend incomplete; custody blocked for operator recovery')
            staged_exists = False
            try:
                need(transfer('sha256sum', destination, remote) == digest,
                     f'{host}:{destination}: installed sha256 mismatch')
            except Exception:
                code = mutate('remove', destination, remote, digest=digest)
                if code in (0, 3):
                    self.cancel()
                    raise Problem(f'{host}:{destination}: verification failed; installed copy removed; shelf remains free') from None
                raise Problem(f'{host}:{destination}: verification failed; custody blocked for operator recovery') from None
            self.moved(row, 'lend', 'lent:' + host, digest)
            print(f'{path} -> {host}:{destination}: lent:{host} {digest}')
        finally:
            if staged_exists:
                try:
                    mutate('discard', destination, remote, token)
                except (OSError, subprocess.SubprocessError):
                    pass  # An unused private temporary may need manual cleanup.

    def swap(self, host, provider, identity):
        self.release(host, provider)
        try:
            self.lend(identity, host, provider=provider)
        except (Problem, OSError, subprocess.SubprocessError, ValueError, TypeError):
            if self.pending is not None:
                raise Problem(f'SWAP FAILED AFTER RELEASE: previous login is free on shelf; {host} custody is uncertain; '
                              'do not use either copy until operator recovery') from None
            raise Problem(f'SWAP FAILED AFTER RELEASE: previous login is free on shelf; {host} has no {provider} credential') from None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    capture = commands.add_parser('capture')
    capture.add_argument('host')
    capture.add_argument('--dry-run', action='store_true')
    release = commands.add_parser('release')
    release.add_argument('host')
    release.add_argument('provider', choices=FILES)
    release.add_argument('--dry-run', action='store_true')
    lend = commands.add_parser('lend')
    lend.add_argument('id')
    lend.add_argument('host')
    lend.add_argument('--dry-run', action='store_true')
    swap = commands.add_parser('swap')
    swap.add_argument('host')
    swap.add_argument('provider', choices=FILES)
    swap.add_argument('id')
    for name in ('prepare', 'register'):
        command = commands.add_parser(name)
        command.add_argument('provider', choices=FILES)
        command.add_argument('id')
    listing = commands.add_parser('list')
    listing.add_argument('--json', action='store_true')
    args = parser.parse_args()
    try:
        if hasattr(args, 'id'):
            need(re.fullmatch(ID, args.id), 'invalid login id')
        shelf = Shelf()
        with shelf.locked():
            if args.command == 'list':
                entries = sorted(shelf.entries, key=lambda row: (row['provider'], row['id']))
                if args.json:
                    print(json.dumps(entries))
                else:
                    for row in entries:
                        print(f'{shelf.root / row["provider"] / row["id"]}: {row["status"]} {row["sha256"]}')
            elif args.command == 'capture':
                shelf.capture(args.host, args.dry_run)
            elif args.command == 'release':
                shelf.release(args.host, args.provider, args.dry_run)
            elif args.command == 'lend':
                shelf.lend(args.id, args.host, args.dry_run)
            elif args.command == 'swap':
                shelf.swap(args.host, args.provider, args.id)
            else:
                getattr(shelf, args.command)(args.provider, args.id)
        return 0
    except Problem as error:
        print(f'agent-logins: {error}', file=sys.stderr)
        return 4
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        # Never include arbitrary metadata or child diagnostics in errors.
        print('agent-logins: operation refused (unsafe, absent, invalid or unavailable path/state/source)', file=sys.stderr)
        return 4


if __name__ == '__main__':
    sys.exit(main())
