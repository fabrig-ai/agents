#!/usr/bin/env python3
"""Best-effort, bounded session lifecycle records; never emit hook output."""
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys

sys.dont_write_bytecode = True


def cached_name(identity, fallback):
    directory = Path(os.environ.get("SESSION_CONTEXT_STATE", Path.home() / ".local/state/session-context"))
    cache = json.loads((directory / "names.json").read_text())
    if not isinstance(cache, dict):
        return fallback
    matches = {name for key, name in cache.items() if isinstance(name, str)
               and (key == identity or (len(key) >= 8 and (identity.startswith(key) or key.startswith(identity))))}
    return matches.pop() if len(matches) == 1 else fallback


def call(argv):
    subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=0.4, check=False)


def main():
    if shutil.which("reap") is None:
        return
    event = json.load(sys.stdin)
    identity = event.get("session_id")
    if not isinstance(identity, str) or not re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){0,3}(?:-[0-9a-fA-F]{12})?", identity):
        return
    kind = event.get("hook_event_name")
    if kind == "SessionStart":
        fallback = sys.argv[1] if len(sys.argv) == 2 else "claude-session"
        try:
            owner = cached_name(identity, fallback)
        except (OSError, ValueError, TypeError):
            owner = fallback
        call(["reap", "record", "start", "--kind", "claude-session", "--owner", owner,
              "--id", identity, "--path", str(Path.home() / ".claude/jobs" / identity[:8])])
    elif kind == "SessionEnd":
        try:
            call(["reap", "record", "end", "--kind", "claude-session", "--id", identity])
        finally:
            call(["systemctl", "--user", "start", "--no-block", "reap.service"])


def expired(signum, frame):
    raise TimeoutError("hook budget exhausted")


if __name__ == "__main__":
    try:
        signal.signal(signal.SIGALRM, expired)
        signal.setitimer(signal.ITIMER_REAL, 1.5)
        main()
    except Exception:
        pass
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
    sys.exit(0)
