#!/usr/bin/env python3
"""session-context: how full a session's context window is (agents/operations.md, 7).

Claude Code sessions: reads the session's own transcript
(~/.claude/projects/<cwd>/<session>.jsonl) and counts its latest model call:
input, cache read, cache creation and output tokens, against --window.
Codex threads: reads the thread's rollout (~/.codex/sessions/**/rollout-*-<thread>.jsonl)
and its latest token count, against the window the rollout records.

  session-context                  CLAUDE_CODE_SESSION_ID, or the sole recent Claude session
  session-context SESSION_ID       a Claude session by (a prefix of) its id
  session-context --name lead/jig  a running background Claude session by its name
  session-context --codex THREAD   a Codex thread by its id
  session-context --owner ops      a codex-run owner's thread
  session-context --hook           as a Claude Code Stop hook: reads the hook's JSON on
                                   stdin; at the threshold, asks the session to hand over
  session-context --capabilities   print supported integration capabilities
  session-context --fired [--json] list recorded handover firings (read only)
Hook options: --role lead|coordinator|director, repeatable --name NAME / --name-prefix PREFIX,
--coordinator MAILBOX, --handover PATH, --handle H. Stop also acts after a compaction;
SessionStart source=compact adds the role's handover message. Name lookups are cached
under SESSION_CONTEXT_STATE (default ~/.local/state/session-context), with a 10s timeout.
Repeatable --watch ABSOLUTE_PATH adds notices when role sections change, with a
silent first baseline. Notices use UserPromptSubmit, SessionStart resume/compact,
or inactive Stop. Seen copies expire after seven idle days, checked once a day.
Options: --window N (Claude; default 1000000), --threshold F (default 0.85).
Without an id or CLAUDE_CODE_SESSION_ID, exactly one session must have written
to this directory's project folder in the last 30 minutes; otherwise pass an id.
Exit 2 for ambiguous or absent recent sessions; 0 below the threshold, 3 at or
past it (a hook exits 0 and says so in JSON).
"""
import glob, json, os, subprocess, sys, tempfile
import fcntl, hashlib, re, shutil, time
from contextlib import contextmanager
from datetime import datetime, UTC

TAIL = 4 << 20  # the latest call is near the end: find it in the tail first


def project_dir(cwd):
    return os.path.expanduser('~/.claude/projects/') + cwd.replace('/', '-').replace('.', '-')


def by_name(name):
    out = subprocess.run(['claude', 'agents', '--json'], capture_output=True, text=True,
                         timeout=30).stdout
    for a in json.loads(out or '[]'):
        if a.get('name') == name and a.get('sessionId'):
            return a['sessionId'], a.get('cwd')
    sys.exit(f'session-context: no running session named {name}')


def claude_transcript(session, cwd):
    d = project_dir(cwd)
    if session:
        for root in ([d] if os.path.isdir(d) else []) + [os.path.expanduser('~/.claude/projects/')]:
            for dirpath, _, files in os.walk(root):
                for f in files:
                    if f.startswith(session) and f.endswith('.jsonl'):
                        return os.path.join(dirpath, f)
        sys.exit(f'session-context: no transcript for {session}')
    files = [os.path.join(d, f) for f in os.listdir(d) if f.endswith('.jsonl')] if os.path.isdir(d) else []
    if not files:
        sys.exit(f'session-context: no transcript under {d}')
    recent = sorted((os.path.getmtime(path), path) for path in files
                    if os.path.getmtime(path) >= time.time() - 30 * 60)
    if len(recent) != 1:
        print('session-context: expected one session written in the last 30 minutes; '
              'pass a session id', file=sys.stderr)
        for mtime, path in recent:
            stamp = datetime.fromtimestamp(mtime, UTC).isoformat(timespec='seconds')
            print(f'  {os.path.basename(path)[:8]} mtime {stamp}', file=sys.stderr)
        sys.exit(2)
    return recent[0][1]


def records(path, tail=False):
    if not tail:
        with open(path, 'rb') as f:
            for line in f:
                try:
                    yield json.loads(line)
                except ValueError:
                    continue
        return
    with open(path, 'rb') as f:
        size = f.seek(0, 2)
        start = max(0, size - TAIL) if tail else 0
        f.seek(start)
        data = f.read()
    if start:
        data = data.split(b'\n', 1)[-1]
    for line in data.split(b'\n'):
        try:
            yield json.loads(line)
        except ValueError:
            continue


def claude_call(d):
    m = d.get('message')
    return m.get('usage') if isinstance(m, dict) else None


def claude_usage(path, window, counts=True, tail_only=False):
    last = None
    for tail in ((True,) if tail_only else (True, False)):
        for d in records(path, tail):
            u = claude_call(d)
            if u:
                last = (d.get('timestamp', ''), u)
        if last:
            break
    if not last:
        sys.exit(f'session-context: no model call yet in {path}')
    extra = ''
    if counts:
        calls = compactions = 0
        for d in records(path):
            if d.get('type') == 'system' and d.get('subtype') == 'compact_boundary':
                compactions += 1
            if claude_call(d):
                calls += 1
        extra = f'; {calls} calls; {compactions} compaction(s)'
    ts, u = last
    used = (u.get('input_tokens', 0) + u.get('cache_read_input_tokens', 0)
            + u.get('cache_creation_input_tokens', 0) + u.get('output_tokens', 0))
    return os.path.basename(path)[:8], used, window, ts, extra


def owner_thread(name):
    root = os.path.realpath(os.environ.get('DEV_ROOT', os.path.expanduser('~/src/rust')))
    events = os.path.join(root, 'tmp/owners', name.split('/')[-1], 'codex/events.jsonl')
    thread = None
    for d in records(events) if os.path.exists(events) else ():
        if d.get('type') == 'thread.started' and d.get('thread_id'):
            thread = d['thread_id']
    if thread:
        return thread
    sys.exit(f'session-context: no Codex thread for owner {name}')


def codex_usage(thread):
    found = glob.glob(os.path.expanduser(f'~/.codex/sessions/**/rollout-*-{thread}.jsonl'),
                      recursive=True)
    if not found:
        sys.exit(f'session-context: no Codex rollout for {thread}')
    path = max(found, key=os.path.getmtime)
    last = None; compactions = 0
    for d in records(path):
        if d.get('type') == 'compacted':
            compactions += 1
        p = d.get('payload')
        if isinstance(p, dict) and p.get('type') == 'token_count' and p.get('info'):
            last = (d.get('timestamp', ''), p['info'])
    if not last:
        sys.exit(f'session-context: no token count yet in {path}')
    ts, info = last
    used = (info.get('last_token_usage') or {}).get('total_tokens', 0)
    window = info.get('model_context_window') or 1
    return thread[:8], used, window, ts, f'; {compactions} compaction(s)'


def report(name, used, window, ts, extra, threshold):
    share = used / window
    line = (f'{name}: {used:,} of {window:,} tokens ({share:.0%}) at {ts[:19]}Z{extra}; '
            f'threshold {threshold:.0%}' + (' REACHED: hand over now' if share >= threshold else ''))
    return share >= threshold, line


def hook_name(session):
    """Resolve once per session; failed lookups never populate the cache."""
    if not isinstance(session, str) or not session:
        return None
    directory = os.environ.get('SESSION_CONTEXT_STATE', os.path.expanduser('~/.local/state/session-context'))
    path = os.path.join(directory, 'names.json')
    try:
        with open(path) as stream:
            cache = json.load(stream)
        if not isinstance(cache, dict):
            cache = {}
    except (OSError, ValueError):
        cache = {}
    if isinstance(cache.get(session), str):
        return cache[session]
    try:
        result = subprocess.run(['claude', 'agents', '--json'], capture_output=True,
                                text=True, timeout=10, check=True)
        for agent in json.loads(result.stdout):
            identity = agent.get('sessionId')
            name = agent.get('name')
            if isinstance(identity, str) and identity.startswith(session) and isinstance(name, str):
                cache[session] = name
                temporary = None
                try:
                    os.makedirs(directory, mode=0o700, exist_ok=True)
                    with tempfile.NamedTemporaryFile(mode='w', dir=directory, prefix='.names.', delete=False) as stream:
                        temporary = stream.name  # NamedTemporaryFile creates mode 0600.
                        json.dump(cache, stream)
                        stream.write('\n')
                    os.replace(temporary, path)
                except OSError:
                    pass  # A read-only cache must not prevent a resolved hook from acting.
                finally:
                    if temporary and os.path.exists(temporary):
                        os.unlink(temporary)
                return name
    except (OSError, ValueError, AttributeError, TypeError, subprocess.SubprocessError):
        pass
    return None


def has_compaction(path):
    return any(d.get('type') == 'system' and d.get('subtype') == 'compact_boundary'
               for d in records(path))


def state_directory():
    return os.environ.get('SESSION_CONTEXT_STATE', os.path.expanduser('~/.local/state/session-context'))


def atomic_write(path, data):
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=os.path.dirname(path), prefix='.' + os.path.basename(path) + '.', delete=False) as stream:
            temporary = stream.name  # mode 0600
            stream.write(data)
        os.replace(temporary, path)
    finally:
        if temporary and os.path.exists(temporary):
            os.unlink(temporary)


@contextmanager
def directory_lock(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def cleanup_seen(state, seen, current):
    """Serialize the daily sweep; keep active sessions and refreshable baselines."""
    marker = os.path.join(state, 'seen-cleanup.json')
    with directory_lock(seen):
        try:
            with open(marker) as stream:
                last = float(json.load(stream))
        except (OSError, ValueError, TypeError):
            last = 0
        now = time.time()
        if now - last < 86400:
            return
        with os.scandir(seen) as entries:
            for entry in entries:
                if entry.path == current or not entry.is_dir(follow_symlinks=False):
                    continue
                if entry.stat().st_mtime < now - 7 * 86400:
                    shutil.rmtree(entry.path)
        atomic_write(marker, json.dumps(now).encode())


def markdown_sections(text):
    """Split level-2/3 ATX sections, ignoring heading-shaped code-fence contents."""
    sections, occurrences = {}, {}
    current = fence = None
    for line in text.splitlines(keepends=True):
        marker = re.match(r'^ {0,3}(`{3,}|~{3,})', line)
        if fence:
            if re.fullmatch(r' {0,3}' + re.escape(fence[0]) + '{' + str(len(fence)) + r',}\s*', line):
                fence = None
        elif marker:
            fence = marker.group(1)
        else:
            heading = re.match(r'^ {0,3}(#{2,3})(?:[ \t]+(.*?))?[ \t]*\r?\n?$', line)
            if heading:
                title = re.sub(r'[ \t]+#+[ \t]*$', '', heading.group(2) or '')
                identity = (len(heading.group(1)), title)
                occurrences[identity] = occurrences.get(identity, 0) + 1
                current = (*identity, occurrences[identity])
                sections[current] = []
                continue
        if current is not None:
            sections[current].append(line)
    return {key: ''.join(body) for key, body in sections.items()}


def changed_sections(before, after):
    old, new = markdown_sections(before), markdown_sections(after)
    keys = [key for key in old if key not in new or old[key] != new[key]]
    keys += [key for key in new if key not in old]
    labels = [key[1] for key in keys]
    if not labels:
        return 'none (text before the first heading)'
    return ', '.join(labels[:8]) + (f' and {len(labels) - 8} more' if len(labels) > 8 else '')


def snapshot_path(directory, path, digest):
    key = hashlib.sha256(path.encode()).hexdigest()
    return os.path.join(directory, key + '-' + digest + '.md')


def role_drift(session, watches, deliver):
    if not watches or not isinstance(session, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', session):
        return []
    state = state_directory()
    seen = os.path.join(state, 'seen')
    directory = os.path.join(seen, session)
    for path in (state, seen, directory):
        os.makedirs(path, mode=0o700, exist_ok=True)
        os.chmod(path, 0o700)
    # Retention is based on activity, so an old but still running session is kept.
    os.utime(directory, None)
    cleanup_seen(state, seen, directory)
    with directory_lock(directory):
        index_path = os.path.join(directory, 'index.json')
        try:
            with open(index_path) as stream:
                index = json.load(stream)
            if not isinstance(index, dict):
                index = {}
        except (OSError, ValueError):
            index = {}
        notices, updates, obsolete = [], {}, []
        for path in dict.fromkeys(watches):
            try:
                with open(path, 'rb') as stream:
                    data = stream.read()
            except OSError:
                continue  # Missing files are never a deletion notice.
            digest = hashlib.sha256(data).hexdigest()
            previous = index.get(path)
            if previous == digest:
                continue
            known = isinstance(previous, str) and re.fullmatch(r'[0-9a-f]{64}', previous)
            if known:
                if not deliver:
                    continue  # Do not consume a change that this event cannot deliver.
                old_path = snapshot_path(directory, path, previous)
                with open(old_path, 'rb') as stream:
                    old = stream.read()
                sections = changed_sections(old.decode('utf-8', errors='replace'), data.decode('utf-8', errors='replace'))
                notices.append(f'{path} changed since you last read it ({previous[:8]} -> {digest[:8]}): '
                               f'sections {sections}. Re-read those sections before acting.')
                obsolete.append(old_path)
            atomic_write(snapshot_path(directory, path, digest), data)
            updates[path] = digest
        if updates or not os.path.exists(index_path):
            index.update(updates)
            atomic_write(index_path, (json.dumps(index) + '\n').encode())
            for path in obsolete:
                try:
                    os.unlink(path)
                except OSError:
                    pass  # Retiring an old snapshot must not hide a committed notice.
        return notices


def handover_message(event, threshold, window, role, coordinator, handover, handle):
    kind = event.get('hook_event_name')
    if not (kind == 'Stop' or (kind == 'SessionStart' and event.get('source') == 'compact')):
        return ''
    path = event.get('transcript_path')
    exists = bool(path and os.path.isfile(path))
    if kind == 'Stop' and not exists:
        return ''
    try:
        reached, line = report(*claude_usage(path, window, counts=False, tail_only=True), threshold)
    except (OSError, SystemExit, TypeError):
        reached, line = False, 'Session usage unavailable'
    # A reached threshold already requires handover; avoid scanning a large transcript twice.
    compacted = kind == 'SessionStart' or (not reached and exists and has_compaction(path))
    if kind == 'Stop' and not (reached or compacted):
        return ''
    if compacted:
        line += '; compaction detected: hand over now'
    if role == 'director':
        return (f"{line}. Hand over now: bring ~/src/rust/tmp/supervise/director/handover.md and state.md current, "
                "start your successor with `tools/session/start director --next`, then warm-up and takeover. "
                "If your handover is already under way, carry on with it.")
    if role == 'lead':
        return (f"{line}. End now, as agents/lead.md 4 says: bring state.md and common.md current, "
                f"send your coordinator what the design should say, stop your waiter, post `files current` "
                f"to {coordinator}, then read no mail and change no file.")
    if role == 'coordinator':
        return (f"{line}. Hand over now, as agents/operations.md 7 says: bring {handover} current "
                f"(its 'For my successor' section), start your successor with "
                f"`tools/session/start coordinator {handle} --next`, then warm-up and takeover. "
                "If your handover is already under way, carry on with it.")
    return (f'{line}. Start your handover now, as your role says (agents/operations.md 7; '
            'a lead ends as agents/lead.md 4 says).')


def record_fired(session, name, role, reason):
    """Best effort: failure here must never change an already-due hook response."""
    if not isinstance(session, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', session):
        return
    try:
        state = state_directory()
        directory = os.path.join(state, 'fired')
        for path in (state, directory):
            os.makedirs(path, mode=0o700, exist_ok=True)
        path = os.path.join(directory, session + '.json')
        with directory_lock(directory):
            try:
                with open(path) as stream:
                    previous = json.load(stream)
                if not isinstance(previous, dict):
                    previous = {}
            except (OSError, ValueError):
                previous = {}
            now = datetime.now(UTC).isoformat(timespec='microseconds').replace('+00:00', 'Z')
            marker = {'session_id': session, 'name': name if name is not None else previous.get('name'),
                      'role': role if role is not None else previous.get('role'), 'reason': reason,
                      'first_fired': previous.get('first_fired', now), 'last_fired': now}
            atomic_write(path, (json.dumps(marker) + '\n').encode())
    except Exception:
        pass


def fired_markers():
    directory = os.path.join(state_directory(), 'fired')
    try:
        with os.scandir(directory) as entries:
            paths = [entry.path for entry in entries if entry.name.endswith('.json') and entry.is_file(follow_symlinks=False)]
    except FileNotFoundError:
        return []
    markers = []
    for path in sorted(paths):
        try:
            with open(path) as stream:
                marker = json.load(stream)
            if (isinstance(marker, dict) and isinstance(marker.get('session_id'), str)
                    and {'name', 'role', 'reason', 'first_fired', 'last_fired'} <= marker.keys()):
                markers.append(marker)
        except (OSError, ValueError):
            continue
    return markers


def hook(threshold, window, role=None, names=(), prefixes=(), coordinator=None, handover=None, handle=None, watches=()):
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return 0
    kind = event.get('hook_event_name')
    if not watches and not (kind == 'Stop' or (kind == 'SessionStart' and event.get('source') == 'compact')):
        return 0
    active_stop = kind == 'Stop' and event.get('stop_hook_active')
    if active_stop and not watches:
        return 0  # the session is already continuing because of this hook: never loop
    # A quiet Stop must not create a name cache just to decide its gate.
    # Watches retain their independent baseline and delivery behaviour.
    message = None
    if kind == 'Stop' and not watches:
        message = handover_message(event, threshold, window, role, coordinator, handover, handle)
        if not message:
            return 0
    name = None
    if names or prefixes:
        name = hook_name(event.get('session_id'))
        if name is None or not (name in names or any(name.startswith(prefix) for prefix in prefixes)):
            return 0
    deliver = not active_stop and (kind in ('UserPromptSubmit', 'Stop') or
                                  (kind == 'SessionStart' and event.get('source') in ('resume', 'compact')))
    if message is None:
        message = '' if active_stop else handover_message(event, threshold, window, role, coordinator, handover, handle)
    identity = event.get('session_id')
    if message and isinstance(identity, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]*', identity):
        if name is None:
            name = hook_name(identity)
        record_fired(identity, name, role, message)
    try:
        notices = role_drift(event.get('session_id'), watches, deliver)
    except (OSError, ValueError, TypeError):
        notices = []  # An unavailable drift store must not suppress a due handover.
    message = '\n\n'.join(text for text in [message, *notices] if text)
    if not message:
        return 0
    if kind == 'Stop':
        print(json.dumps({'decision': 'block', 'reason': message}))
    else:
        print(json.dumps({'hookSpecificOutput': {'hookEventName': kind, 'additionalContext': message}}))
    return 0


def main(argv):
    # Hooks never interfere with Claude on malformed input or an unavailable transcript.
    if '--hook' in argv:
        try:
            return dispatch(argv)
        except (Exception, SystemExit):
            return 0
    return dispatch(argv)


def dispatch(argv):
    if argv == ['--capabilities']:
        print('hook-gating')
        print('role-drift')
        print('fired-markers')
        return 0
    if argv in (['--fired'], ['--fired', '--json'], ['--json', '--fired']):
        markers = fired_markers()
        if '--json' in argv:
            print(json.dumps(markers))
        else:
            for marker in markers:
                print(f"{marker['session_id']} name={marker['name']} role={marker['role']} "
                      f"first_fired={marker['first_fired']} last_fired={marker['last_fired']}: {marker['reason']}")
        return 0
    window, threshold, session, cwd, codex, as_hook = 1_000_000, 0.85, None, os.getcwd(), None, False
    as_hook = '--hook' in argv
    role = coordinator = handover = handle = None
    names, prefixes, watches = [], [], []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == '--window': window = int(argv[i + 1]); i += 2
        elif a == '--threshold': threshold = float(argv[i + 1]); i += 2
        elif a == '--name':
            if as_hook: names.append(argv[i + 1])
            else: session, cwd = by_name(argv[i + 1])
            i += 2
        elif as_hook and a == '--name-prefix': prefixes.append(argv[i + 1]); i += 2
        elif as_hook and a == '--role':
            role = argv[i + 1]; i += 2
            if role not in ('lead', 'coordinator', 'director'): raise ValueError('unknown role')
        elif as_hook and a == '--coordinator': coordinator = argv[i + 1]; i += 2
        elif as_hook and a == '--handover': handover = argv[i + 1]; i += 2
        elif as_hook and a == '--handle': handle = argv[i + 1]; i += 2
        elif as_hook and a == '--watch':
            path = argv[i + 1]; i += 2
            if not os.path.isabs(path): raise ValueError('--watch requires an absolute path')
            watches.append(path)
        elif a == '--codex': codex = argv[i + 1]; i += 2
        elif a == '--owner': codex = owner_thread(argv[i + 1]); i += 2
        elif a == '--hook': as_hook = True; i += 1
        elif a in ('-h', '--help'): print(__doc__); return 0
        else: session = a; i += 1
    if as_hook:
        return hook(threshold, window, role, names, prefixes, coordinator, handover, handle, watches)
    session = session or os.environ.get('CLAUDE_CODE_SESSION_ID')
    usage = codex_usage(codex) if codex else claude_usage(claude_transcript(session, cwd), window)
    reached, line = report(*usage, threshold)
    print(line)
    return 3 if reached else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
