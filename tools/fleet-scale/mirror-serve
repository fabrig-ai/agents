#!/usr/bin/env python3
"""Serve only the two fleet mirrors; docs/design/fleet-scale.md §5."""
import os
from pathlib import Path
import shlex
import sys


def main():
    try:
        command = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
        if len(command) != 2 or command[0] != "git-upload-pack":
            raise ValueError("command")
        raw = command[1]
        if ".." in Path(raw).parts:
            raise ValueError("parent traversal")
        home = Path.home()
        path = home / raw[2:] if raw.startswith("~/") else Path(raw)
        if not path.is_absolute():
            path = home / path
        for component in (path, *path.parents):
            if component.is_symlink():
                raise ValueError("symlink")
        allowed = [home / "src/fabrig/mirror" / (name + ".git") for name in ("agents", "fabrig")]
        resolved = path.resolve(strict=True)
        if resolved not in allowed or not resolved.is_dir():
            raise ValueError("path")
        os.execvp("git-upload-pack", ["git-upload-pack", str(resolved)])
    except (OSError, ValueError):
        print("mirror-serve: request refused", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
