#!/usr/bin/env python3
"""Trim idle test executables (tools/slots/design.md, 2). Standalone for ssh stdin."""

import argparse
import os
from pathlib import Path
import shutil
import stat
import sys
import time


GB = 1_000_000_000
EXCLUDED = (".so", ".rlib", ".rmeta", ".d")


def open_files(proc=Path("/proc"), uid=None):
    """Read only fd metadata of this user's processes, never their contents."""
    uid = os.getuid() if uid is None else uid
    held = set()
    skipped = 0
    for process in proc.iterdir():
        if not process.name.isdecimal():
            continue
        unavailable = False
        try:
            if process.stat().st_uid != uid:
                continue
            for fd in (process / "fd").iterdir():
                try:
                    info = fd.stat()
                    held.add((info.st_dev, info.st_ino))
                except (PermissionError, FileNotFoundError, ProcessLookupError):
                    unavailable = True
        except (PermissionError, FileNotFoundError, ProcessLookupError):
            unavailable = True
        skipped += int(unavailable)
    return held, skipped


def eligible(path, info, cutoff):
    return (stat.S_ISREG(info.st_mode) and bool(info.st_mode & stat.S_IXUSR)
            and not path.name.endswith(EXCLUDED) and info.st_mtime_ns < cutoff)


def identity(info):
    return (info.st_dev, info.st_ino, info.st_mode, info.st_size, info.st_mtime_ns, info.st_ctime_ns)


def trim(slot, cutoff, *, held_files=open_files, dry_run=False):
    deps = slot / "target/debug/deps"
    # Do not traverse a symlink in the supplied slot or its target path.
    if any(path.is_symlink() for path in (deps, *deps.parents)):
        raise RuntimeError(f"symlink in deps path: {deps}")
    if not slot.is_dir():
        raise RuntimeError(f"not a slot directory: {slot}")
    if not deps.exists():
        return 0, 0, 0
    candidates = []
    for path in deps.iterdir():
        try:
            info = path.lstat()
        except FileNotFoundError:
            continue
        if eligible(path, info, cutoff):
            candidates.append((path, info))
    held, skipped = held_files() if candidates else (set(), 0)
    count, size = 0, 0
    for path, before in candidates:
        if (before.st_dev, before.st_ino) in held:
            continue
        try:
            current = path.lstat()
            if identity(current) != identity(before) or not eligible(path, current, cutoff):
                continue
            if not dry_run:
                path.unlink()
        except FileNotFoundError:
            continue
        count += 1
        size += current.st_size
    return count, size, skipped


def minutes(value):
    number = float(value)
    if not 0 <= number < float("inf"):
        raise argparse.ArgumentTypeError("must be a finite nonnegative number")
    return number


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--older", type=minutes, default=120)
    parser.add_argument("slots", nargs="*", type=Path)
    args = parser.parse_args()
    slots = args.slots or sorted((Path.home() / "src/fabrig/slots").glob("*"))
    cutoff = time.time_ns() - int(args.older * 60 * 1_000_000_000)
    failed = False
    for slot in slots:
        slot = slot.expanduser().absolute()
        try:
            count, size, skipped = trim(slot, cutoff)
            free = shutil.disk_usage(slot).free / GB
            print(f"{slot}: {count} executables, {size / GB:.3f} GB freed; "
                  f"{free:.3f} GB free; {skipped} processes skipped")
        except (OSError, RuntimeError) as error:
            print(f"trim: {slot}: {error}", file=sys.stderr)
            failed = True
    return int(failed)


if __name__ == "__main__":
    sys.exit(main())
