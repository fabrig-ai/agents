#!/usr/bin/env python3
"""Check, rebase, check if changed, and fast-forward origin/main."""

import os
from pathlib import Path
import subprocess
import sys


def run(*args):
    return subprocess.check_output(args, text=True).strip()


def main():
    if len(sys.argv) != 1:
        sys.exit("usage: tools/land")
    if not os.environ.get("AGENTS_GATE_HELD"):
        # Hold the host's gate lock across both checks, the rebase and the push.
        lock = os.environ.get("AGENTS_GATE_LOCK", str(Path.home() / ".local/state/agents-gate.lock"))
        Path(lock).parent.mkdir(parents=True, exist_ok=True)
        if subprocess.run(["flock", "-n", "-o", lock, "true"]).returncode:
            print(f"land: waiting for another agents gate on this host ({lock})", file=sys.stderr, flush=True)
        os.environ["AGENTS_GATE_HELD"] = "1"
        os.execvp("flock", ["flock", "-o", lock, sys.executable, *sys.argv])
    root = Path(run("git", "rev-parse", "--show-toplevel"))
    if run("git", "status", "--porcelain", "--untracked-files=all"):
        sys.exit("land: refusing a dirty tree")
    branch = run("git", "branch", "--show-current")
    if not branch or branch == "main":
        sys.exit("land: use a named branch other than main")
    subprocess.run([str(root / "tools/check.sh")], check=True)
    before = run("git", "rev-parse", "HEAD")
    subprocess.run(["git", "fetch", "origin"], check=True)
    subprocess.run(["git", "rebase", "origin/main"], check=True)
    if run("git", "rev-parse", "HEAD") != before:
        subprocess.run([str(root / "tools/check.sh")], check=True)
    subprocess.run(["git", "push", "origin", "HEAD:main"], check=True)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
