#!/usr/bin/env python3
"""Usage: tools/land [--host NAME] [--local] [--dry-run] [--keep-branch]
       tools/land --reconcile [CLAIM] [--kill]

Rebase, test a bundle on a claimed builder, then fast-forward main. --dry-run
executes the real claim/bundle/check/release flow and stops before pushing.
--local is an explicit fallback with the same budgets and selection.
Unseen completion keeps the claim; --reconcile inspects before acting.
--kill explicitly permits reconciliation to terminate this run. --keep-branch
retains the local branch after main is pushed; remote cleanup still applies.
"""
import argparse
import fcntl
import importlib.util
import json
import os
import re
from pathlib import Path
import shlex
import signal
import subprocess
import sys
import tempfile
import time
import tomllib
import uuid

OWNER = 's/deploy-gate'
ALIASES = {'h3': 'hetzner3', 'h7': 'hetzner7', 'h6': 'hetzner6'}


def run(*args, **kwargs):
    return subprocess.check_output(args, text=True, **kwargs).strip()


def ssh(target, *command, **kwargs):
    if not isinstance(target, str) or not re.fullmatch('[A-Za-z0-9_.@:-]+', target) or target.startswith('-'):
        raise ValueError('invalid SSH target')
    return run('ssh', '-oBatchMode=yes', '-oConnectTimeout=5', target,
               shlex.join(str(a) for a in command), **kwargs)


def load_gate(root):
    spec = importlib.util.spec_from_file_location('agents_gate', root / 'tools/gate.py')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def pools(path):
    result = set()
    seen = set()
    for line in path.read_text().splitlines():
        fields = line.split('#', 1)[0].split()
        if not fields:
            continue
        for field in fields[1:]:
            number, separator, share = field.partition('=')
            pair = (fields[0], number)
            if not separator or not number.isdecimal() or not share or pair in seen:
                raise ValueError(f'invalid slot inventory: {line}')
            seen.add(pair)
            if share == 'pool':
                result.add(pair)
    return result


def interrupted(signum, frame):
    raise KeyboardInterrupt(f'signal {signum}')


def record_root():
    return Path.home() / '.local/state/agents-gate/unreconciled'


def save_record(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, prefix='.' + path.name,
                                     delete=False) as stream:
        json.dump(value, stream, indent=2)
        stream.flush()
        os.fsync(stream.fileno())
        sibling = Path(stream.name)
    sibling.replace(path)
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


class Builder:
    def __init__(self, hosts, inventory, requested, sha, saved=None):
        self.hosts = hosts
        self.inventory = inventory
        self.requested = ALIASES.get(requested, requested)
        token = uuid.uuid4().hex
        if saved is not None and (not isinstance(saved, dict) or saved.get('version') != 1 or
                                  not {'id','owner','what','sha','host','slot','target','hel8','phase',
                                       'prepare_uncertain','launch_requested','exit_seen','restored'} <= saved.keys()):
            raise ValueError('invalid saved claim record')
        self.data = saved or dict(version=1, id=token, owner=OWNER, what=f'agents-gate {sha} {token}',
                    sha=sha, host=None, slot=None, target=None, hel8=hosts['hel8']['ssh'],
                    remote_dir=None, pgid=None, remote_pgid=None, phase='claiming',
                    prepare_uncertain=False, launch_requested=False, exit_seen=False, restored=False)
        if not re.fullmatch('[0-9a-f]{32}', self.data['id']) or self.data['owner'] != OWNER:
            raise ValueError('invalid saved claim')
        self.path = record_root() / (self.data['id'] + '.json')
        self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.lock = self.path.with_suffix('.lock').open('a')
        fcntl.flock(self.lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        self.source = Path(__file__).with_name('land_remote.py').read_text()

    @property
    def slot(self):
        return (self.data['host'], self.data['slot']) if self.data['slot'] is not None else None

    @property
    def what(self):
        return self.data['what']

    def save(self):
        save_record(self.path, self.data)

    def remote(self, action, *args):
        target = self.data['target']
        if not isinstance(target, str) or not re.fullmatch('[A-Za-z0-9_.@:-]+', target) or target.startswith('-'):
            raise ValueError('invalid saved SSH target')
        reply = ssh(target, 'python3', '-I', '-B', '-c', self.source, action,
                    json.dumps(self.data), *args, timeout=float(args[0]) + 10 if action == 'wait' else 10)
        return json.loads(reply)

    def observe(self, value):
        # Retain the observed process identity locally before further SSH calls.
        run = value.get('run') or value
        for key in ('pgid', 'boot', 'start_ticks', 'supervisor_pid', 'supervisor_start_ticks'):
            if run.get(key) is not None:
                self.data[key] = run[key]
        self.data['remote_pgid'] = self.data.get('pgid')
        if value.get('upload'):
            self.data['upload'] = value['upload']
        if value.get('remote_dir'):
            self.data['remote_dir'] = value['remote_dir']
        self.save()

    def keep(self, reason):
        self.data['reason'] = reason
        self.save()
        print(f'land: KEEP CLAIM {self.slot}: {self.what}; {reason}', file=sys.stderr, flush=True)
        print(f'land: record {self.path}; reconcile: tools/land --reconcile {self.data["id"]}',
              file=sys.stderr, flush=True)

    def claim(self):
        available = pools(self.inventory)
        free = {tuple(line.split()) for line in
                ssh(self.data['hel8'], 'claim', 'list', '--free', OWNER, timeout=10).splitlines()}
        choices = [self.requested] if self.requested else ['hetzner3', 'hetzner7', 'hetzner6']
        if not self.requested:
            admitted = []
            for host in choices:
                if host not in self.hosts or not any(h == host for h, _ in available & free):
                    continue
                info = self.hosts[host]
                minimum = max(85, info.get('machine_env', {}).get('PLAN_MIN_DISK_GB', 0)) * 1024**3
                try:
                    reply = ssh(info['ssh'], 'sh', '-c', 'df -B1 --output=avail "$HOME"', timeout=10)
                    space = int(reply.splitlines()[-1].strip())
                except (ValueError, OSError, subprocess.SubprocessError):
                    print(f'land: skip {host}: HOME disk availability unknown', flush=True)
                    continue
                if space < minimum:
                    print(f'land: skip {host}: HOME available {space} bytes < {minimum} bytes', flush=True)
                    continue
                admitted.append((host, space))
            choices = [host for host, _ in sorted(admitted, key=lambda item: -item[1])]
        for host in choices:
            if host not in self.hosts or 'builder' not in self.hosts[host]['roles']:
                raise ValueError(f'not a builder: {host}')
            for h, n in sorted(available & free, key=lambda pair: (pair[0], int(pair[1]))):
                if h != host:
                    continue
                self.data.update(host=h, slot=n, target=self.hosts[h]['ssh'], phase='claiming')
                self.save()  # Durable intent precedes an operation whose reply may be lost.
                try:
                    reply = ssh(self.data['hel8'], 'claim', 'claim', h, n, OWNER, self.what, timeout=10)
                except subprocess.CalledProcessError as error:
                    if error.returncode == 1:
                        self.data['slot'] = None
                        self.path.unlink()
                        continue
                    self.data['phase'] = 'claim_unknown'
                    self.save()
                    raise
                except BaseException:
                    self.data['phase'] = 'claim_unknown'
                    self.save()
                    raise
                self.data['phase'] = 'claimed'
                self.save()
                print(f'land: claimed {h} slot {n}: {reply}', flush=True)
                return
        raise ValueError('no free builder pool slot; use --local explicitly if necessary')

    def restore(self):
        self.data['restoration_pending'] = True
        self.save()
        observation = self.remote('inspect')
        self.observe(observation)
        if observation['processes'] or observation['supervisors']:
            raise ValueError(f'remote processes still alive: {observation["processes"] + observation["supervisors"]}')
        if observation['heavy']:
            raise ValueError('BUG: gate submitted heavy work; claim retained for ops')
        proof = self.remote('cleanup')
        if proof['exists'] or proof['processes'] or proof['supervisors'] or proof['heavy']:
            raise ValueError('remote restoration is unknown')
        print(f'land: restored {self.data["host"]}: removed {self.data["remote_dir"]}; no processes or heavy tasks', flush=True)
        self.data.update(restored=True, restoration_pending=False, phase='restored')
        self.save()

    def release(self):
        if self.slot is None:
            return
        blocked = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT, signal.SIGTERM, signal.SIGHUP})
        try:
            if not self.data['restored']:
                # Never turn unseen remote completion into permission to clean up.
                if (self.data.get('restoration_pending') or self.data['phase'] == 'claim_unknown' or
                        self.data['prepare_uncertain'] or
                        self.data.get('upload_requested') and not self.data.get('upload_seen') or
                        self.data['launch_requested'] and not self.data['exit_seen']):
                    self.keep('remote end is unknown')
                    return
                try:
                    self.restore()
                except (ValueError, OSError, subprocess.SubprocessError) as error:
                    self.keep('restoration unproved: ' + type(error).__name__)
                    return
            host, number = self.slot
            try:
                reply = ssh(self.data['hel8'], 'claim', 'release', host, number, OWNER,
                            '--what', self.what, timeout=10)
            except (OSError, subprocess.SubprocessError):
                self.keep('central release reply unknown')
                raise
            print(f'land: released {host} slot {number}: {reply}', flush=True)
            self.path.unlink()
            self.data['slot'] = None
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, blocked)

    def check(self, root, base, limit, gate, require_green=True, sha=None):
        for key in ('boot', 'supervisor_pid', 'supervisor_start_ticks', 'start_ticks', 'upload'):
            self.data.pop(key, None)
        self.data.update(sha=sha or run('git', 'rev-parse', 'HEAD'), remote_dir=None, pgid=None, remote_pgid=None, phase='allocating',
                         prepare_uncertain=True, upload_requested=False, upload_seen=False, launch_requested=False, exit_seen=False, restored=False, restoration_pending=False)
        self.save()
        prepared = self.remote('prepare')
        candidate = prepared['remote_dir']
        if not re.fullmatch(r'/tmp/agents-gate\.' + self.data['id'] + r'\.[A-Za-z0-9_]+', candidate):
            raise ValueError('invalid builder temporary path')
        self.data.update(remote_dir=candidate, prepare_uncertain=False, phase='prepared')
        self.save()
        with tempfile.TemporaryDirectory(prefix='agents-land-') as directory:
            bundle = Path(directory) / 'candidate.bundle'
            bundle_ref = 'refs/heads/agents-land-' + self.data['id']
            subprocess.run(['git', 'update-ref', bundle_ref, self.data['sha']], cwd=root, check=True)
            try:
                subprocess.run(['git', 'bundle', 'create', str(bundle), bundle_ref], cwd=root, check=True)
            finally:
                subprocess.run(['git', 'update-ref', '-d', bundle_ref], cwd=root, check=True)
            self.data.update(upload_requested=True, upload_seen=False, phase='uploading')
            self.save()  # Durable unknown-end intent precedes upload dispatch.
            with bundle.open('rb') as stream:
                receipt = json.loads(ssh(self.data['target'], 'python3', '-I', '-B', '-c',
                                         self.source, 'upload', json.dumps(self.data),
                                         stdin=stream, timeout=15))
            if receipt.get('sha') != self.data['sha'] or receipt.get('phase') != 'finished' or receipt.get('exit_code') != 0:
                raise ValueError('upload receipt unavailable or mismatched')
            self.data.update(upload_seen=True, upload=receipt, phase='uploaded')
            self.save()
            print(f'land: shipped HEAD bundle ({self.data["sha"]}) to {self.slot[0]}:{candidate}', flush=True)
            script = (f'git clone -q {shlex.quote(candidate)}/candidate.bundle {shlex.quote(candidate)}/repo && '
                      f'cd {shlex.quote(candidate)}/repo && git checkout -q --detach {self.data["sha"]} && mkdir {shlex.quote(candidate)}/tmp && '
                      f'TMPDIR={shlex.quote(candidate)}/tmp HEAVY_LABEL={shlex.quote(self.what)} '
                      f'nice -n 19 ionice -c3 tools/check.sh --tier gate '
                      f'{("--changed " + shlex.quote(base) + " ") if base else ""}'
                      f'--json {shlex.quote(candidate)}/result.json > {shlex.quote(candidate)}/table 2>&1')
            self.data.update(launch_requested=True, phase='launching')
            self.save()
            self.observe(self.remote('start', script, str(limit + 5), self.source))
            self.data['phase'] = 'running'
            self.save()
            observation = self.remote('wait', str(limit + 5))
            value = observation.get('run') or {}
            if value.get('sha') != self.data['sha']:
                raise ValueError('remote receipt SHA mismatch')
            if value.get('phase') != 'finished' or type(value.get('exit_code')) is not int:
                raise ValueError('remote exit status unavailable')
            self.observe(observation)
            self.data.update(exit_seen=True, exit_code=value['exit_code'], phase='exited')
            self.save()
            try:
                print(ssh(self.data['target'], 'cat', candidate + '/table', timeout=10), flush=True)
                result = json.loads(ssh(self.data['target'], 'cat', candidate + '/result.json', timeout=10))
            finally:
                # Only a received exit can authorize normal restoration. Drops,
                # timeouts and interrupts before it go directly to a kept claim.
                self.restore()
            if require_green and (value['exit_code'] or result['code'] or result['starved']):
                raise ValueError(f'builder gate incomplete or red (exit {value["exit_code"]}, starved {result["starved"]})')
            return result


def reconcile(root, claim, kill):
    directory = record_root()
    if claim != '*':
        token = claim.removesuffix('.json')
        if not re.fullmatch('[0-9a-f]{32}', token):
            raise ValueError('CLAIM must be an unreconciled claim id')
        paths = [directory / (token + '.json')]
    else:
        paths = sorted(directory.glob('*.json'))
    failed = False
    for path in paths:
        builder = None
        try:
            saved = json.loads(path.read_text())
            if not isinstance(saved, dict) or path.stem != saved.get('id') or 'sha' not in saved:
                raise ValueError('claim record identity mismatch')
            builder = Builder({}, None, None, saved['sha'], saved=saved)
            observation = builder.remote('inspect')  # Always read-only first.
            builder.observe(observation)
            if observation['heavy']:
                raise ValueError('BUG: gate submitted heavy work; resolve with ops')
            alive = observation['processes'] + observation['supervisors']
            if alive and not kill:
                raise ValueError(f'remote processes alive: {alive}; --kill is required to terminate them')
            if alive:
                builder.observe(builder.remote('kill'))
            builder.restore()
            try:
                builder.release()
            except subprocess.CalledProcessError as error:
                if error.returncode != 1:
                    raise
                free = {tuple(line.split()) for line in ssh(builder.data['hel8'], 'claim', 'list',
                        '--free', OWNER, timeout=10).splitlines()}
                if builder.slot not in free:
                    raise
                print(f'land: old claim {builder.data["id"]} is already free; clearing its record')
                builder.path.unlink()
                builder.data['slot'] = None
        except KeyboardInterrupt:
            if builder:
                builder.keep('reconciliation interrupted')
            raise
        except (ValueError, OSError, subprocess.SubprocessError) as error:
            failed = True
            if builder:
                builder.keep(str(error) if isinstance(error, ValueError) else type(error).__name__)
            else:
                print(f'land: cannot reconcile {path.name}: {type(error).__name__}; '
                      f'retry {shlex.join(["tools/land", "--reconcile", path.stem])}', file=sys.stderr)
        finally:
            if builder:
                builder.lock.close()
    if not paths:
        print('land: no unreconciled claims')
    return int(failed)


def delete_landed_branch(branch, before, landed, keep_local):
    refs = run('git', 'ls-remote', '--heads', 'origin', 'refs/heads/' + branch)
    tip = refs.split()[0] if refs else None
    if tip in (before, landed):
        # Validate the server-advertised deletion OID as well as ls-remote's
        # observation. Git's ordinary old-OID check then closes the final race.
        original = Path(run('git', 'rev-parse', '--git-path', 'hooks/pre-push')).resolve()
        with tempfile.TemporaryDirectory(prefix='agents-delete-hook-') as directory:
            hook = Path(directory) / 'pre-push'
            source = ("#!/usr/bin/env python3\nimport os,subprocess,sys\n" +
                      "data=sys.stdin.buffer.read()\n" +
                      "allowed=" + repr((before, landed)) + "\n" +
                      "expected=" + repr('refs/heads/' + branch) + "\n" +
                      "for line in data.decode().splitlines():\n" +
                      " local_ref,local_oid,remote_ref,remote_oid=line.split()\n" +
                      " if remote_ref!=expected or set(local_oid)!={'0'} or remote_oid not in allowed:\n" +
                      "  sys.exit('land: remote branch moved; refusing deletion')\n" +
                      "original=" + repr(str(original)) + "\n" +
                      "if os.path.isfile(original) and os.access(original,os.X_OK):\n" +
                      " sys.exit(subprocess.run([original,*sys.argv[1:]],input=data).returncode)\n")
            sibling = hook.with_suffix('.new')
            sibling.write_text(source)
            sibling.chmod(0o700)
            sibling.replace(hook)
            deleted = subprocess.run(['git', '-c', 'core.hooksPath=' + directory,
                                      'push', 'origin', '--delete', branch], timeout=15)
            if deleted.returncode:
                print(f'land: WARNING could not safely delete origin/{branch}; keeping it', file=sys.stderr)
    elif tip is not None:
        print(f'land: WARNING origin/{branch} moved; keeping remote branch', file=sys.stderr)
    if not keep_local:
        subprocess.run(['git', 'switch', '--detach', landed], check=True)
        if run('git', 'for-each-ref', '--format=%(upstream)', 'refs/heads/' + branch):
            subprocess.run(['git', 'branch', '--unset-upstream', branch], check=True)
        subprocess.run(['git', 'branch', '-d', branch], check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--host')
    parser.add_argument('--local', action='store_true')
    parser.add_argument('--dry-run', action='store_true')
    parser.add_argument('--keep-branch', action='store_true')
    parser.add_argument('--reconcile', nargs='?', const='*')
    parser.add_argument('--kill', action='store_true')
    parser.add_argument('--inventory', type=Path,
                        default=Path('/home/free/src/fabrig/main/tools/slots/hosts'))
    args = parser.parse_args()
    if args.kill and args.reconcile is None:
        parser.error('--kill requires --reconcile')
    if args.reconcile is not None and (args.local or args.host or args.dry_run or args.keep_branch):
        parser.error('--reconcile cannot be combined with landing options')
    if args.local and args.host:
        parser.error('--host and --local are mutually exclusive')
    started = time.monotonic()
    root = Path(run('git', 'rev-parse', '--show-toplevel'))
    os.chdir(root)
    gate = load_gate(root)
    budget = gate.configuration(root)['budget']
    print(gate.budget_mode(budget), flush=True)
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, interrupted)
    if args.reconcile is not None:
        code = reconcile(root, args.reconcile, args.kill)
        print(f'land: reconcile exit {code}; {gate.budget_mode(budget)}', flush=True)
        return code
    checkout_lock = Path(run('git', 'rev-parse', '--git-path', 'agents-land.lock')).open('a')
    try:
        fcntl.flock(checkout_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise ValueError('another land holds .git/agents-land.lock')
    if run('git', 'status', '--porcelain', '--untracked-files=all'):
        raise ValueError('refusing a dirty tree')
    branch = run('git', 'branch', '--show-current')
    if branch in ('', 'main'):
        raise ValueError('use a named branch other than main')
    # Local mode retains the host lock across rebase, checks and push. A
    # remote check acquires its builder's check.sh lock instead.
    if args.local and not os.environ.get('AGENTS_GATE_HELD'):
        lock = os.environ.get('AGENTS_GATE_LOCK', str(Path.home() / '.local/state/agents-gate.lock'))
        Path(lock).parent.mkdir(parents=True, exist_ok=True)
        host_lock = Path(lock).open('a')
        try:
            fcntl.flock(host_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(f'land: waiting for another agents gate on this host ({lock})', flush=True)
            fcntl.flock(host_lock, fcntl.LOCK_EX)
        # Keep both file descriptors in this process through push. Re-execing
        # under flock would drop the checkout lock while waiting for this one.
        os.environ['AGENTS_GATE_HELD'] = '1'
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, interrupted)
    before_rebase = run('git', 'rev-parse', 'HEAD')
    subprocess.run(['git', 'fetch', 'origin'], check=True, timeout=15)
    subprocess.run(['git', 'rebase', 'origin/main'], check=True, timeout=15)
    gate = load_gate(root)
    config = gate.configuration(root)
    budget = config['budget']
    candidate_sha = run('git', 'rev-parse', 'HEAD')
    base = run('git', 'rev-parse', 'origin/main')
    own_paths = gate.changed_paths(root, base)
    own_selection = set(gate.select(root, config, own_paths, include_smoke=False))
    builder = None
    completed_at = None
    try:
        if args.local:
            print('LAND: LOCAL FALLBACK — no builder claim; running on this host', flush=True)
        else:
            hosts = tomllib.loads((root / 'fleet/hosts.toml').read_text())['hosts']
            builder = Builder(hosts, args.inventory, args.host, candidate_sha)
            builder.claim()
        def unchanged():
            if run('git', 'rev-parse', 'HEAD') != candidate_sha:
                raise ValueError('HEAD moved during land; refusing push')
        def check(current_base):
            unchanged()
            if builder:
                return builder.check(root, current_base, gate.hard_wall(budget), gate, sha=candidate_sha)
            with tempfile.TemporaryDirectory(prefix='land-local-') as directory:
                result_file = Path(directory) / 'result.json'
                subprocess.run([str(root / 'tools/check.sh'), '--tier', 'gate', '--changed', current_base,
                                '--json', str(result_file)], check=True, timeout=gate.hard_wall(budget) + 5)
                result = json.loads(result_file.read_text())
                if result['starved']:
                    raise ValueError('local gate has unobserved tests; rerun')
                return result
        check(base)
        unchanged()
        subprocess.run(['git', 'fetch', 'origin'], check=True, timeout=15)
        latest = run('git', 'rev-parse', 'origin/main')
        if latest != base:
            # Upstream selection excludes the common, always-run smoke set;
            # a docs-only upstream change cannot conflict through smoke alone.
            upstream = gate.changed_paths(root, base, latest)
            overlap = own_selection & set(gate.select(root, config, upstream, include_smoke=False))
            unchanged()
            subprocess.run(['git', 'rebase', 'origin/main'], check=True, timeout=15)
            prior_sha = candidate_sha
            candidate_sha = run('git', 'rev-parse', 'HEAD')
            if overlap:
                print('land: upstream overlaps selected tests; checking once more', flush=True)
                check(latest)
            else:
                if builder:
                    builder.data['rebase'] = dict(checked_sha=prior_sha, permitted_sha=candidate_sha, base=latest)
                    builder.save()
                print(f'land: no-overlap rebase: checked {prior_sha}; permitted {candidate_sha} on {latest}', flush=True)
            subprocess.run(['git', 'fetch', 'origin'], check=True, timeout=15)
            if run('git', 'rev-parse', 'origin/main') != latest:
                raise ValueError('second upstream race; rerun tools/land')
        unchanged()
        elapsed = time.monotonic() - started
        if budget['enforce'] and elapsed > budget['merge_wall_s']:
            raise ValueError(f'merge wall budget: {elapsed:.3f}s > {budget["merge_wall_s"]}s')
        if args.dry_run:
            print('land: DRY RUN green; stopping before push', flush=True)
        else:
            subprocess.run(['git', 'push', 'origin', candidate_sha + ':refs/heads/main'], check=True, timeout=15)
        completed_at = time.monotonic()
        if not args.dry_run:
            try:
                delete_landed_branch(branch, before_rebase, candidate_sha, args.keep_branch)
            except (OSError, subprocess.SubprocessError) as error:
                print(f'land: main pushed; WARNING branch cleanup failed: {type(error).__name__}', file=sys.stderr)
    finally:
        try:
            if builder:
                builder.release()
        finally:
            elapsed = (completed_at or time.monotonic()) - started
            print(f'land: merge wall {elapsed:.3f}s / {budget["merge_wall_s"]}s; '
                  f'{gate.budget_mode(budget)}{gate.wall_status(elapsed, budget)}', flush=True)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit('land: interrupted; rerun')
    except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as error:
        detail = f'{error.cmd[0]} exited {error.returncode}' if isinstance(error, subprocess.CalledProcessError) else str(error)
        sys.exit(f'land: {detail}')
