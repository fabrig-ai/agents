class Problem(Exception):
    def __init__(self, why, code=2):
        super().__init__(why)
        self.code = code


class Deferred(Problem):
    """Valid admission waiting for a resource or dependency."""


def defer(ok, why):
    if not ok:
        raise Deferred(why, 1)


def need(ok, why, code=2):
    if not ok:
        raise Problem(why, code)


def command(argv, cwd=None, timeout=None, pass_fds=(), data=None, env=None):
    argv = [str(a) for a in argv]
    binary = isinstance(data, bytes)
    with subprocess.Popen(argv, cwd=cwd, stdin=subprocess.PIPE if data is not None else subprocess.DEVNULL,
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=not binary,
                          env=dict(os.environ, GIT_TERMINAL_PROMPT='0', **(env or {})),
                          start_new_session=timeout is not None, pass_fds=pass_fds) as child:
        try:
            stdout, stderr = child.communicate(input=data, timeout=timeout)
            if binary:
                stdout, stderr = stdout.decode(errors='replace'), stderr.decode(errors='replace')
            return subprocess.CompletedProcess(argv, child.returncode, stdout, stderr)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                stdout, stderr = child.communicate(timeout=5)
            except subprocess.TimeoutExpired as error:
                stdout, stderr = error.output or b'', error.stderr or b''
                child.stdout.close()
                child.stderr.close()
            if isinstance(stdout, bytes):
                stdout = stdout.decode(errors='replace')
            if isinstance(stderr, bytes):
                stderr = stderr.decode(errors='replace')
            return subprocess.CompletedProcess(argv, 124, stdout, stderr + 'command timed out\n')


def git(root, *args, check=True, timeout=300):
    result = command(['git', '-C', root, *args], timeout=timeout)
    if check:
        need(result.returncode == 0, result.stderr.strip() or 'git failed', 4)
    return result.stdout.strip() if check else result


def timestamp():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def utc(value):
    if value == 'unknown':
        return datetime.min.replace(tzinfo=timezone.utc)
    need(re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d(?::\d\d)?Z', value),
         f'invalid UTC time: {value}', 4)
    return datetime.fromisoformat(value.replace('Z', '+00:00'))


def check_file(source, path, code=4):
    """Validate the descriptor before reading even one byte from metadata."""
    info = os.fstat(source.fileno())
    need(stat.S_ISREG(info.st_mode), f'{path}: not a regular file', code)
    need(info.st_nlink == 1, f'{path}: hard-linked file refused', code)
    need(info.st_uid == os.getuid(), f'{path}: file is not owned by this user', code)
    return info


@contextmanager
def reading(path, mode='rb'):
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        raise
    except OSError as error:
        raise Problem(f'{path}: cannot open safely ({error.strerror})', 4) from None
    with os.fdopen(descriptor, mode) as source:
        check_file(source, path)
        yield source


def read_bytes(path, limit=-1):
    with reading(path) as source:
        return source.read(limit)


def read_text(path, errors='strict'):
    return read_bytes(path).decode('utf-8', errors=errors)


class Workspace:
    def __init__(self):
        self.root = Path(os.environ.get('DEV_ROOT', Path.home() / 'src/rust')).expanduser().absolute()
        self.tmp = Path(os.environ.get('DEV_TMP', self.root / 'tmp')).expanduser().absolute()
        fixture = os.environ.get('QA_FIXTURE')
        self.fixture = Path(fixture).absolute() if fixture else None
        need(fixture is None or (fixture and self.fixture.is_dir()), 'QA_FIXTURE must be a directory')

    def machine(self):
        try:
            lines = read_text(self.root / 'tmp/post/machines').splitlines()
        except OSError:
            lines = []
        for line in lines:
            fields = line.partition('#')[0].split()
            if len(fields) >= 2 and fields[1] == 'local':
                return fields[0]
        return socket.gethostname()

    def tool(self, name):
        # Dependencies are installed independently; resolve their programs on PATH.
        default = Path(name)
        return Path(os.environ.get('QA_' + name.upper().replace('-', '_'), default)) if self.fixture else default

    def origin(self, repo):
        need(repo in REPOSITORIES, f'unknown repository: {repo}')
        return str(self.fixture / 'origins' / (repo + '.git')) if self.fixture else f'git@github.com:fabrig-ai/{repo}.git'



def no_links(anchor, path):
    parts = path.relative_to(anchor).parts
    current = anchor
    for part in ('', *parts):
        if part:
            current /= part
        try:
            mode = os.lstat(current).st_mode
        except FileNotFoundError:
            break
        need(not stat.S_ISLNK(mode), f'{current}: symlink refused', 4)


class Repositories:
    def __init__(self, workspace):
        self.workspace = workspace

    def checkout(self, root, main):
        git(root, 'switch', '--detach', main)
        return root

    def fetch(self, repo, slot):
        root = Path.home() / 'src/fabrig/slots' / str(slot)
        no_links(Path.home(), root)
        need(root.is_dir(), f'{root}: slot checkout is missing', 4)
        need(git(root, 'rev-parse', '--show-toplevel') == str(root)
             and git(root, 'config', '--get', 'remote.origin.url') == self.workspace.origin(repo),
             f'{root}: unexpected origin or checkout', 4)
        status = git(root, 'status', '--porcelain=v1', '-z', '--untracked-files=all', '--ignored', check=False)
        need(status.returncode == 0, f'{root}: cannot check checkout cleanliness', 4)
        entries = status.stdout.split('\0')
        need(all(not entry or entry[:3] in ('?? ', '!! ') and entry[3:].startswith('target/')
                 for entry in entries), f'{root}: dirty slot checkout', 4)
        result = git(root, 'fetch', '--quiet', '--prune', 'origin',
                     '+refs/heads/*:refs/remotes/origin/*', check=False)
        need(result.returncode == 0, f'cannot fetch {repo}: {result.stderr.strip()}', 4)
        return root

    def protect_head(self, root, previous):
        head = git(root, 'rev-parse', '--verify', 'HEAD')
        published = git(root, 'for-each-ref', '--contains=' + head,
                        '--format=%(refname)', 'refs/remotes/origin/')
        need(published or head == previous,
             f'{root}: unpublished HEAD {head} is not the last saved walk checkout; refusing to switch', 4)

    def build(self, root, ref):
        why = f'build {ref}: no branch origin/{ref} and no commit; try origin/<branch> or a commit'
        branch = ref[7:] if ref.startswith('origin/') else ref
        remote = None
        if git(root, 'check-ref-format', 'refs/heads/' + branch, check=False).returncode == 0:
            # The exact ref alone: rev-parse would fall back to a tag or a local branch of that spelling.
            shown = git(root, 'show-ref', '--verify', '--hash', 'refs/remotes/origin/' + branch, check=False)
            sha = shown.stdout.strip() if shown.returncode == 0 else ''
            if re.fullmatch(SHA, sha) and git(root, 'cat-file', '-t', sha, check=False).stdout.strip() == 'commit':
                remote = sha
        if ref.startswith('origin/') or ref == 'main':
            need(remote, why)
            return remote
        if re.fullmatch(r'[0-9a-fA-F]{4,40}', ref):
            resolved = git(root, 'rev-parse', '--disambiguate=' + ref.lower(), check=False)
            objects = resolved.stdout.splitlines()
            need(resolved.returncode == 0 and len(objects) == 1 and re.fullmatch(SHA, objects[0])
                 and git(root, 'cat-file', '-t', objects[0]) == 'commit', why)
            need(not remote, f'build {ref}: ambiguous branch and commit; try origin/{ref} for the branch '
                 f'or the full commit {objects[0]}')
            return objects[0]
        need(not re.fullmatch(r'[0-9a-fA-F]+', ref) and remote, why)
        return remote


def replace(path, data, mode=0o600, durable=False):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as target:
        temporary = Path(target.name)
        try:
            target.write(data)
            target.flush()
            os.chmod(temporary, mode)
            if durable:
                os.fsync(target.fileno())
            os.replace(temporary, path)
            if durable:
                descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    os.fsync(descriptor)
                finally:
                    os.close(descriptor)
        finally:
            temporary.unlink(missing_ok=True)


def pool_of(name):
    stem = re.sub(r'-[0-9]+$', '', name)
    return None if re.search(r'-[0-9]+$', stem) else stem


LISTED = re.compile(r'(' + LOGIN + r'): (?:at rest|missing|held by (\S+)(?: \([^\n]*\))? since \S+, [0-9]+:[0-9]{2}, (?:at rest|not at rest))')


def login_inventory(text):
    """Read the physical logins-list rows strictly; return holders or None."""
    holders, names = {}, set()
    for line in text.split('\n'):
        if not line or line.startswith('  '):
            continue
        match = LISTED.fullmatch(line)
        if not match or match[1] in names:
            return None
        names.add(match[1])
        if match[2]:
            holders[match[1]] = match[2]
    return holders


