def settings(workspace, cleanup=False):
    # Same precedence and valid machine.env lines as kit.sh's machine_setting.
    values = dict(QA_INTERVAL_SECONDS='300', QA_GIVE_BACK_SECONDS='90', QA_STOP_SECONDS='50',
                  QA_WALK_KINDS='forgejo=2:chatgpt claude=2:claude',
                  QA_WALK_SCRATCH_BYTES='2000000000', QA_SCRATCH_BUDGET_BYTES='48000000000',
                  QA_EVIDENCE_KIB='2048', QA_EVIDENCE_SECONDS='120', QA_EVIDENCE_REMOTE='', QA_EVIDENCE_BRANCH='',
                  QA_STUCK_TO='', QA_WALK_SLOTS='', QA_SLOT_HOST='hetzner6', QA_CLAIM_OWNER='s/qa', QA_CLAIM_SSH='free@204.168.210.29')
    path = workspace.tmp / 'machine.env'
    try:
        text = read_text(path, errors='replace')
    except OSError:
        text = ''  # An absent machine file supplies no settings.
    for line in text.split('\n'):
        match = re.fullmatch(r'(QA_INTERVAL_SECONDS|QA_GIVE_BACK_SECONDS|QA_STOP_SECONDS|QA_WALK_SCRATCH_BYTES|QA_SCRATCH_BUDGET_BYTES|QA_EVIDENCE_KIB|QA_EVIDENCE_SECONDS)=([0-9]+)', line)
        if match:
            values[match[1]] = match[2]
        key, sep, value = line.partition('=')
        if sep and key in ('QA_WALK_KINDS', 'QA_WALK_SLOTS', 'QA_SLOT_HOST', 'QA_CLAIM_OWNER', 'QA_CLAIM_SSH', 'QA_STUCK_TO', 'QA_EVIDENCE_REMOTE', 'QA_EVIDENCE_BRANCH'):
            values[key] = value
    kinds = os.environ.get('QA_WALK_KINDS', values.pop('QA_WALK_KINDS'))
    text_values = {key: os.environ.get(key, values.pop(key)) for key in
                   ('QA_WALK_SLOTS', 'QA_SLOT_HOST', 'QA_CLAIM_OWNER', 'QA_CLAIM_SSH', 'QA_STUCK_TO', 'QA_EVIDENCE_REMOTE', 'QA_EVIDENCE_BRANCH')}
    errors = []
    preservation_keys = ('QA_WALK_SCRATCH_BYTES', 'QA_SCRATCH_BUDGET_BYTES', 'QA_EVIDENCE_KIB', 'QA_EVIDENCE_SECONDS')
    def configured(ok, why):
        if not ok and cleanup:
            errors.append(why)
        else:
            need(ok, why)
    for key in values:
        value = os.environ.get(key, values[key])
        valid = bool(re.fullmatch(r'[0-9]+', value))
        if key in preservation_keys:
            configured(valid and int(value) > 0, f'{key} must be a positive integer')
            values[key] = int(value) if valid and int(value) > 0 else int(values[key])
        else:
            need(valid, f'{key} must be a nonnegative integer')
            values[key] = int(value)
    need(0 < values['QA_STOP_SECONDS'] < 60, 'QA_STOP_SECONDS must be positive and below 60')
    configured(values['QA_EVIDENCE_KIB'] <= 2048, 'QA_EVIDENCE_KIB must be at most 2048')
    remote = text_values['QA_EVIDENCE_REMOTE']
    configured(not remote or remote == 'git@github.com:fabrig-ai/qa.git' or workspace.fixture
         and Path(remote).is_absolute() and str(Path(remote)).startswith(str(workspace.fixture) + '/'),
         'invalid QA_EVIDENCE_REMOTE')
    configured(not text_values['QA_EVIDENCE_BRANCH'] or
               re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9/_-]*', text_values['QA_EVIDENCE_BRANCH'])
               and all(text_values['QA_EVIDENCE_BRANCH'].split('/')), 'invalid QA_EVIDENCE_BRANCH')
    if errors:
        values['QA_PRESERVATION_ERROR'] = '; '.join(errors)
    parsed = {}
    need(kinds.strip() and not any(ord(c) < 32 or 0x7f <= ord(c) < 0xa0 for c in kinds),
         'QA_WALK_KINDS needs KIND=SLOTS:POOL[,POOL...]')
    for position, word in enumerate(filter(None, re.split(r' +|,(?=[a-z][a-z0-9]*=)', kinds)), 1):
        match = re.fullmatch(r'([a-z][a-z0-9]*)=([0-9]+):(.+)', word)
        need(match, f'invalid QA_WALK_KINDS entry {position}')
        kind, slots, pools = match[1], int(match[2]), re.split(r'[,+]', match[3])
        need(kind not in parsed and slots > 0 and len(set(pools)) == len(pools)
             and all(re.fullmatch(LOGIN, pool) and pool_of(pool) == pool for pool in pools),
             f'invalid QA_WALK_KINDS entry {position}')
        parsed[kind] = dict(slots=slots, pools=pools)
    named, used = {}, set()
    for word in re.split(r' +|,(?=[a-z][a-z0-9]*=)', text_values['QA_WALK_SLOTS']):
        if not word:
            continue
        match = re.fullmatch(r'([a-z][a-z0-9]*)=([1-9][0-9]*(?:[+,][1-9][0-9]*)*)', word)
        need(match and match[1] not in named, 'invalid QA_WALK_SLOTS entry: ' + word)
        numbers = [int(number) for number in re.split(r'[+,]', match[2])]
        need(len(set(numbers)) == len(numbers) and not used.intersection(numbers),
             'duplicate QA_WALK_SLOTS slot: ' + word)
        named[match[1]] = numbers
        used.update(numbers)
    need(re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9-]*', text_values['QA_SLOT_HOST']), 'invalid QA_SLOT_HOST')
    need(re.fullmatch(r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*', text_values['QA_CLAIM_OWNER']),
         'invalid QA_CLAIM_OWNER')
    need(not text_values['QA_CLAIM_SSH'] or re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_.@-]*',
                                                     text_values['QA_CLAIM_SSH']), 'invalid QA_CLAIM_SSH')
    address = text_values['QA_STUCK_TO']
    need(not address or len(address) <= 120 and re.fullmatch(ADDRESS, address), 'invalid QA_STUCK_TO address')
    for kind, config in parsed.items():
        config.update(numbers=named.get(kind, []), slots=len(named.get(kind, [])))
    values.update(text_values)
    values['QA_WALK_KINDS'] = parsed
    return values


def walk_count(holders, pool, kind):
    # Old walk grants stay occupied until the pre-kind runs have drained.
    return sum(pool_of(name) == pool and (holder.startswith('walk/' + kind + '/')
               or holder.startswith('walk/rung-')) for name, holder in holders.items())


def stop_path(path):
    need(not any(c in str(path) for c in '$%"\\ \t\n'), f'{path}: unsafe path in a stop command')
    return path


def deploy(args, workspace):
    directory = Path(args.directory)
    need(directory.is_absolute() and directory.is_dir() and not directory.is_symlink(),
         'DIRECTORY must be an absolute directory, not a link')
    need(re.fullmatch(NAME, directory.name), 'DIRECTORY must have a walk name')
    stop_path(directory)
    script = stop_path(Path(__file__).resolve())
    need(re.fullmatch(r'[a-z][a-z0-9-]*', args.name), 'NAME must be a lowercase slug')
    need(args.argv, 'deploy needs COMMAND')
    executable = shutil.which(args.argv[0])
    need(executable, f'COMMAND not found: {args.argv[0]}')
    executable = str(Path(executable).absolute())
    seconds = settings(workspace)['QA_STOP_SECONDS']
    unit = f'qa-{directory.name}-{args.name}'
    service = Watch(workspace, '')
    saved = service.directory / 'walks' / (directory.name + '.json')
    walking = saved.exists() or saved.is_symlink()
    with service.walks_locked() if walking else nullcontext():
        if walking:
            match = next(((path, state) for path, state in service.local_walks() if state['walk'] == directory.name), None)
            need(match and match[0] == directory and match[1]['stage'] == 'running', 'walk is not running here')
            state = match[1]
            deployments = state.setdefault('deployments', [])
            previous_deployments = list(deployments)
            if any(d['name'] == args.name for d in deployments):
                need(service.unit_status(unit, directory) == 'stopped', 'deployment is still up or unknown', 4)
            deployments[:] = [deployment for deployment in deployments if deployment['name'] != args.name]
            deployments.append(dict(name=args.name, unit=unit, argv=[executable, *args.argv[1:]]))
        try:
            try:
                descriptor = os.open(directory / 'deployments', os.O_RDWR | os.O_CREAT | os.O_APPEND
                                     | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
            except OSError:
                raise Problem(f'{directory / "deployments"}: cannot open safely') from None
            with os.fdopen(descriptor, 'r') as recorded:
                check_file(recorded, directory / 'deployments', code=2)
                fcntl.flock(recorded, fcntl.LOCK_EX)
                text = recorded.read()
                if unit not in text.splitlines():
                    line = (('' if not text or text.endswith('\n') else '\n') + unit + '\n').encode()
                    need(os.write(recorded.fileno(), line) == len(line), 'cannot record deployment', 4)
            stop = ' '.join('"' + str(word) + '"' for word in (script, '_give-back', directory, seconds))
            if walking:
                service.save(directory, state)
            result = command([workspace.tool('systemd-run'), '--user', '--collect', '--quiet', '--unit', unit,
                              '--service-type=exec', '--expand-environment=no', f'--working-directory={directory}', '--setenv=PATH',
                              '--property=KillMode=control-group',
                              f'--property=StandardOutput=append:{directory}/{args.name}.log',
                              f'--property=StandardError=append:{directory}/{args.name}.log',
                              '--property=ExecStop=-' + stop, f'--property=TimeoutStopSec={seconds + 60}',
                              '--', executable, *args.argv[1:]])
            need(result.returncode == 0, result.stderr.strip() or 'systemd-run failed', 4)
        except (Problem, OSError):
            if walking:
                state['deployments'] = previous_deployments
                service.save(directory, state)
            raise
        print(unit)


def give_back(args):
    # Stop commands cannot fail their unit, even if their scratch has gone away.
    output = None
    started = time.monotonic()
    try:
        directory = Path(args[0])
        try:
            descriptor = os.open(directory / 'give-back.log', os.O_WRONLY | os.O_APPEND | os.O_CREAT
                                 | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
            info = os.fstat(descriptor)
            if stat.S_ISREG(info.st_mode) and info.st_nlink == 1:
                output = os.fdopen(descriptor, 'a')
            else:
                os.close(descriptor)
        except OSError:
            pass
        if output is None:
            # Returning the login matters even when the walk's log is unsafe.
            output = open(os.devnull, 'w')
        need(len(args) == 2, 'expected DIRECTORY SECONDS')
        seconds = int(args[1])
        need(seconds > 0, 'SECONDS must be positive')
        deadline = started + seconds
        with os.fdopen(os.open(directory / 'give-back.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW
                               | os.O_NONBLOCK, 0o600), 'r+') as lock:
            need(stat.S_ISREG(os.fstat(lock.fileno()).st_mode), 'give-back.lock must be a regular file')
            while True:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        output.write(f'{timestamp()} lock busy past {seconds} s\n')
                        return 0
                    time.sleep(min(0.05, remaining))
            path = directory / 'give-back'
            try:
                regular = stat.S_ISREG(path.lstat().st_mode) and os.access(path, os.X_OK)
            except FileNotFoundError:
                regular = False
            status = 'absent'
            if regular:
                with subprocess.Popen([str(path)], cwd=directory, stdin=subprocess.DEVNULL,
                                      stdout=output, stderr=output, start_new_session=True) as child:
                    try:
                        code = child.wait(timeout=max(0, deadline - time.monotonic()))
                        status = f'exit {code}'
                    except subprocess.TimeoutExpired:
                        os.killpg(child.pid, signal.SIGKILL)
                        child.wait()
                        status = f'killed past {seconds} s'
                    finally:
                        # A successful exporter must not leave background work outside the lock.
                        try:
                            os.killpg(child.pid, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
            output.write(f'{timestamp()} {status}\n')
    except BaseException as error:
        try:
            if output:
                output.write(f'{timestamp()} error: {error}\n')
        except BaseException:
            pass
    finally:
        if output:
            try:
                output.close()
            except BaseException:
                pass
    return 0


class Watch:
    def __init__(self, workspace, director):
        self.workspace, self.director = workspace, director
        self.directory = workspace.tmp / 'qa'
        self.runs = workspace.root / 'tmp/codex-run'
        self.repositories = Repositories(workspace)
        self.giving = True
        self.conflicts = set()
        self.states = {}
        self.classes = {}
        self.walk_lock = self.watch_lock = None
        self.holders = {}
        self.inventory_names = set()
        self.legacy_claims = set()
        self.attention_attempted = set()
        self.release_attempted = set()


    def call(self, tool, *args):
        seconds = dict(systemctl=30, logins=60, post=60, **{'codex-run': 120})
        if tool == 'post' and args[:1] == ('wait',):
            seconds['post'] = int(args[args.index('--timeout') + 1]) + POST_WAIT_MARGIN_SECONDS
        options = {}
        if tool == 'codex-run' and args[:1] == ('task',):
            need(self.walk_lock is not None, 'task launch needs its admission lock', 4)
            options['pass_fds'] = (self.walk_lock,)
        if tool == 'logins' and args[:1] == ('take',):
            lock = self.watch_lock if self.watch_lock is not None else self.walk_lock
            need(lock is not None, 'login take needs its admission lock', 4)
            options['pass_fds'] = (lock,)
        return command([self.workspace.tool(tool), *args], timeout=seconds[tool], **options)

    def take_login(self, pool, holder, note=None, run=None):
        options = ['--note', note] if note is not None else []
        if run:
            options += ['--run', run]
        return self.call('logins', 'take', pool, '--any', '--now', '--as', holder, *options)

    def record_run(self, directory, state):
        if not state.get('run'):
            return
        recorded = state.setdefault('run_recorded', [])
        for login in self.outstanding(state):
            if login in recorded:
                continue
            try:
                result = self.call('logins', 'set-run', login, '--as', state['holder'], '--run', state['run'])
                if result.returncode == 0:
                    recorded.append(login)
                    self.save(directory, state)
                else:
                    log(f'{state["walk"]}: run metadata for {login} pending; trying next check')
            except (OSError, Problem, UnicodeError):
                log(f'{state["walk"]}: cannot record run for {login}; trying next check')

    def slot_call(self, claim, *args):
        words = [str(self.workspace.tool('claim')), *map(str, args)]
        if claim['ssh']:
            # ssh joins its remote arguments into shell text: quote both shell levels.
            quote = lambda word: "'" + word.replace("'", "'\"'\"'") + "'"
            remote = ' '.join(quote(word) for word in words)
            words = [self.workspace.tool('ssh'), '-o', 'BatchMode=yes', claim['ssh'],
                     'bash -lc ' + quote(remote)]
        return command(words, timeout=60)

    def notify_once(self, key, subject, body):
        # One logical notice, delivered at least once across checks/restarts.
        parent = self.directory / 'attention'
        path = parent / (hashlib.sha256(key.encode()).hexdigest() + '.json')
        no_links(self.workspace.tmp, path)
        try:
            receipt = self.read_state(path)
            need(isinstance(receipt, dict) and receipt.get('key') == key
                 and receipt.get('attempted') is True
                 and isinstance(receipt.get('subject'), str) and isinstance(receipt.get('body'), str)
                 and isinstance(receipt.get('recipient', self.director), str)
                 and re.fullmatch(ADDRESS, receipt.get('recipient', self.director))
                 and ('delivered' not in receipt or type(receipt['delivered']) is bool),
                 f'{path}: invalid alert receipt', 4)
        except FileNotFoundError:
            receipt = dict(key=key, attempted=True, subject=subject, body=body,
                           recipient=self.director, time=timestamp(), delivered=False)
            replace(path, (json.dumps(receipt) + '\n').encode(), durable=True)
        if receipt.get('delivered', receipt.get('result') in ('exit 0', 'exit 3')):
            return
        if key in self.attention_attempted:
            return
        self.attention_attempted.add(key)
        message = parent / (path.stem + '.body')
        replace(message, receipt['body'].encode())
        try:
            sent = self.call('post', 'send', '--as', 'qa-watch',
                             receipt.get('recipient', self.director), receipt['subject'], message)
            receipt['result'] = f'exit {sent.returncode}'
            receipt['delivered'] = sent.returncode in (0, 3)
        except (OSError, Problem, UnicodeError) as error:
            receipt['result'] = type(error).__name__
            receipt['delivered'] = False
        replace(path, (json.dumps(receipt) + '\n').encode(), durable=True)

    def retry_notices(self):
        parent = self.directory / 'attention'
        try:
            no_links(self.workspace.tmp, parent)
        except Exception as error:
            log(f'cannot retry notices: {error}; cleanup continues')
            return
        for path in sorted(parent.glob('*.json')):
            try:
                receipt = self.read_state(path)
                need(isinstance(receipt.get('key'), str)
                     and path.stem == hashlib.sha256(receipt['key'].encode()).hexdigest(),
                     'invalid notice identity', 4)
                self.notify_once(receipt['key'], receipt['subject'], receipt['body'])
            except Exception:
                log(f'{path}: cannot retry notice; receipt kept')

    def claim_notice(self, state):
        if not self.director:
            return  # A failed start has no director; the watcher sends this notice.
        claim = state['slot_claim']
        # Tokenized claims each have their own lifetime; reasons have separate receipts.
        key = ('slot release ' + claim['what'] if ' claim ' in claim['what']
               else f'slot release {state["walk"]} attempt {state.get("attempt", 1)}')
        reason = re.sub(r' \(since [^()\n]+\); held [^\n]+', '', claim['release_result'])
        key += ' reason ' + reason
        self.notify_once(key,
                         f'qa: slot release unconfirmed for {state["walk"]}',
                         f'Walk {state["walk"]}, attempt {state.get("attempt", 1)}: release unconfirmed.\n'
                         f'Claim: {claim["host"]} {claim.get("slot", state["slot"])} {claim["owner"]}; '
                         f'WHAT: {claim["what"]}; SSH: {claim["ssh"] or "local"}.\n'
                         f'Result: {claim["release_result"]}. Retrying at each check.\n')

    def release_slot(self, directory, state):
        need(self.walk_lock is not None, 'slot release requires the walks lock', 4)
        claim = state.get('slot_claim')
        if not state.get('released') or self.outstanding(state) or not claim or claim['released']:
            return
        key = (claim['host'], state['slot'], claim['owner'], claim['what'])
        if key in self.release_attempted:
            return
        self.release_attempted.add(key)
        # A take can have succeeded without a readable grant reply. Confirm
        # that even those unsaved grants are back before reserving release.
        listing = self.call('logins', 'list')
        inventory = login_inventory(listing.stdout) if listing.returncode == 0 else None
        holders = {a.get('holder', state['holder']) for a in [state, *state.get('attempts', [])]}
        if inventory is None or any(holder in holders for holder in inventory.values()):
            return
        pending = claim.get('release_status') == 'release unconfirmed'
        claim.update(slot=state['slot'], release_status='release unconfirmed',
                     release_result='interrupted before a confirmed result; release may have run')
        # An interrupted release retries only after observing exact custody again.
        self.save(directory, state)
        try:
            listed = self.slot_call(claim, 'list')
            prefix = f"{claim['host']} {claim['slot']} ["
            rows = [row for row in listed.stdout.splitlines() if row.startswith(prefix)]
            need(listed.returncode == 0,
                 f'claim list exit {listed.returncode}: {listed.stderr.strip() or "unavailable"}', 4)
            need(len(rows) == 1,
                 f'claim list expected one row for {claim["host"]}-{claim["slot"]}; observed {len(rows)}', 4)
            if pending and re.fullmatch(re.escape(prefix) + r'[^]\r\n]+\]: free', rows[0]):
                claim.update(released=True, release_status='released', release_result='claim list confirms free')
                self.save(directory, state)
                return
            pattern = (re.escape(prefix) + r'[^]\r\n]+\]: '
                       + re.escape(claim['owner'] + ': ' + claim['what'])
                       + r' \(since [^()\r\n]+\); held .+')
            need(re.fullmatch(pattern, rows[0]), f'claim list does not match saved owner and WHAT: {rows[0]}', 4)
            result = self.slot_call(claim, 'release', claim['host'], claim['slot'], claim['owner'],
                                    '--what', claim['what'])
            claim['release_result'] = f'exit {result.returncode}: {result.stderr.strip() or result.stdout.strip()}'
            expected = f"{claim['host']}-{claim['slot']} released by {claim['owner']}"
            need(result.returncode == 0 and result.stdout.strip() == expected,
                 'release unconfirmed: ' + claim['release_result'], 4)
            claim.update(released=True, release_status='released')
        except (OSError, Problem, UnicodeError, AttributeError, TypeError) as error:
            claim['release_result'] = str(error) if isinstance(error, Problem) else type(error).__name__ + ': ' + str(error)
            log(f'{state["walk"]}: release unconfirmed; trying next check')
        self.save(directory, state)
        if not claim['released']:
            self.claim_notice(state)

    def orphan_live(self, name, walks):
        if any(s['walk'] == name for s in self.legacy_walks):
            return 'legacy walk custody'
        state = next((s for _, s in walks if s['walk'] == name), None)
        if state and (state['stage'] in ('starting', 'running')
                      or not state.get('released') or self.outstanding(state)):
            return 'saved walk still holds custody'
        if not self.giving:
            return 'login inventory unknown'
        if any(holder.startswith('walk/') and holder.rsplit('/', 1)[-1] == name
               for holder in self.holders.values()):
            return 'login custody still held'
        directory = self.workspace.tmp / 'qa-focused' / name
        no_links(self.workspace.tmp, directory)
        units = self.deployments(directory, {'walk': name})
        if units is None or any(status != 'stopped' for status in units.values()):
            return 'deployment units live or unknown'
        task = directory / 'task.md'
        if self.task_launcher_alive(task) is not False:
            return 'launcher live or unknown'
        for path in self.runs.glob('*/meta'):
            fields = dict(line.split('=', 1) for line in read_text(path).splitlines() if '=' in line)
            need(fields.get('task') and Path(fields['task']).is_absolute(), 'run task metadata unknown', 4)
            if fields.get('task') == str(task):
                need(re.fullmatch(r'[a-zA-Z0-9_-]+', path.parent.name), 'invalid run identity', 4)
                if self.unit_status('codex-run-' + path.parent.name) != 'stopped':
                    return 'codex-run unit live or unknown'
        return None

    def orphan_notice(self, observation):
        name, number, what = observation['name'], observation['slot'], observation['what']
        self.notify_once(observation['key'] + ' released', f'qa: orphan slot released for {name}',
                         f'Released orphan claim: {observation["host"]} {number}; WHAT: {what}.\n')

    def orphan_receipts(self, claim, rows):
        parent = self.directory / 'orphans'
        no_links(self.workspace.tmp, parent)
        for path in parent.glob('*.json'):
            try:
                observation = self.read_state(path)
                need(isinstance(observation, dict) and isinstance(observation.get('key'), str)
                     and isinstance(observation.get('name'), str)
                     and re.fullmatch(r'rung-[a-z0-9][a-z0-9-]*-[1-9][0-9]*', observation['name'])
                     and isinstance(observation.get('what'), str) and re.fullmatch(CLAIM_WHAT, observation['what'])
                     and type(observation.get('slot')) is int and observation['slot'] > 0
                     and observation.get('host') == claim['host'], 'invalid orphan receipt', 4)
                if observation.get('release_pending') and not observation.get('released'):
                    prefix = f'{claim["host"]} {observation["slot"]} ['
                    slot_rows = [r for r in rows if r.startswith(prefix)]
                    if len(slot_rows) == 1 and re.fullmatch(re.escape(prefix) + r'[^]\r\n]+\]: free', slot_rows[0]):
                        observation['released'] = True
                        replace(path, (json.dumps(observation) + '\n').encode(), durable=True)
                if observation.get('released'):
                    self.orphan_notice(observation)
                elif not observation.get('release_pending') and not any(observation['what'] in r for r in rows):
                    path.unlink()  # A missing observation cannot contribute to idle grace.
            except (OSError, Problem, ValueError, KeyError, TypeError, RecursionError):
                log(f'{path}: orphan receipt uncertain; kept')

    def repair_slot_claims(self, walks):
        if not self.walks_valid:
            return
        config = self.options
        claim = dict(host=config['QA_SLOT_HOST'], owner=config['QA_CLAIM_OWNER'], ssh=config['QA_CLAIM_SSH'])
        numbers = {n for kind in config['QA_WALK_KINDS'].values() for n in kind['numbers']}
        if not numbers:
            return
        try:
            listed = self.slot_call(claim, 'list')
            need(listed.returncode == 0, 'cannot list slot claims', 4)
            pattern = (re.escape(claim['host']) + r' ([1-9][0-9]*) \[[^]\r\n]+\]: '
                       + re.escape(claim['owner']) + ': (' + CLAIM_WHAT + ')'
                       + r' \(since ([^()\r\n]+)\); held .+')
            rows = listed.stdout.splitlines()
            self.orphan_receipts(claim, rows)
            for row in rows:
                try:
                    match = re.fullmatch(pattern, row)
                    if not match or int(match[1]) not in numbers:
                        continue
                    number, what, name = int(match[1]), match[2], match[3]
                    # Saved claim lifetimes are retried by release_slot, with their
                    # unit/login guards. The orphan sweep must not bypass those.
                    if any(a.get('slot_claim', {}).get('what') == what
                           and a.get('slot') == number for _, s in walks
                           for a in [s, *s.get('attempts', [])]):
                        continue
                    key = f'orphan slot {claim["host"]} {number} {claim["owner"]} {what}'
                    path = self.directory / 'orphans' / (hashlib.sha256(key.encode()).hexdigest() + '.json')
                    no_links(self.workspace.tmp, path)
                    try:
                        reason = self.orphan_live(name, walks)
                        need(sum(r.startswith(f'{claim["host"]} {number} [') for r in rows) == 1,
                             'ambiguous inventory rows', 4)
                        since = datetime.fromisoformat(match[5].replace('Z', '+00:00'))
                        need(since.tzinfo is not None, 'claim age lacks timezone', 4)
                    except (OSError, Problem, ValueError, UnicodeError) as error:
                        reason = f'cannot establish idle claim: {error}'
                    if reason:
                        path.unlink(missing_ok=True)
                        log(f'{name}: orphan claim kept: {reason}')
                        continue
                    try:
                        observation = self.read_state(path)
                        need(observation['key'] == key, 'invalid orphan observation', 4)
                        first = utc(observation['since'])
                    except FileNotFoundError:
                        observation = dict(key=key, since=timestamp(), released=False,
                                           name=name, slot=number, what=what, host=claim['host'])
                        first = utc(observation['since'])
                        replace(path, (json.dumps(observation) + '\n').encode(), durable=True)
                    if observation.get('released'):
                        continue
                    now = utc(timestamp())
                    if (now - first).total_seconds() < 600 or (now - since).total_seconds() < 600:
                        log(f'{name}: orphan claim kept: ten-minute idle grace')
                        continue
                    # Reobserve immediately before the atomic compare-and-release.
                    again = self.slot_call(claim, 'list')
                    need(again.returncode == 0 and sum(r.split('; held ', 1)[0] == row.split('; held ', 1)[0]
                                 for r in again.stdout.splitlines()) == 1
                         and sum(r.startswith(f'{claim["host"]} {number} [')
                                 for r in again.stdout.splitlines()) == 1,
                         'orphan inventory changed; keeping claim', 4)
                    try:
                        reason = self.orphan_live(name, walks)
                    except (OSError, Problem, ValueError, UnicodeError) as error:
                        reason = f'cannot establish idle claim: {error}'
                    if reason:
                        path.unlink(missing_ok=True)
                        log(f'{name}: orphan claim kept: {reason}')
                        continue
                    observation['release_pending'] = True
                    replace(path, (json.dumps(observation) + '\n').encode(), durable=True)
                    result = self.slot_call(claim, 'release', claim['host'], number, claim['owner'], '--what', what)
                    expected = f'{claim["host"]}-{number} released by {claim["owner"]}'
                    if result.returncode == 0 and result.stdout.strip() == expected:
                        observation['released'] = True
                        replace(path, (json.dumps(observation) + '\n').encode(), durable=True)
                        self.orphan_notice(observation)
                    else:
                        reason = f'exit {result.returncode}: {result.stderr.strip() or result.stdout.strip()}'
                        log(f'{name}: orphan release failed: {reason}; trying next check')
                        self.notify_once(key + ' reason ' + reason, f'qa: orphan release pending for {name}',
                                         f'Claim {claim["host"]} {number}; WHAT: {what}. {reason}. Retrying.\n')
                except (OSError, Problem, ValueError, UnicodeError, KeyError, TypeError, RecursionError) as error:
                    log(f'orphan claim observation failed ({error}); claim left held')
        except (OSError, Problem, ValueError, UnicodeError, KeyError, TypeError):
            log('slot claim observation failed; claims left held')

    def save(self, directory, state):
        need(state['repo'] in REPOSITORIES, 'cannot save an unmanaged walk', 4)
        state.setdefault('attempt', 1)
        attempts = state.setdefault('attempts', [])
        snapshot = json.loads(json.dumps({key: state[key] for key in ATTEMPT_KEYS if key in state}))
        if len(attempts) == state['attempt'] - 1:
            attempts.append(snapshot)
        else:
            need(len(attempts) == state['attempt'], 'invalid walk attempt history', 4)
            attempts[-1] = snapshot
        path = self.directory / 'walks' / (state['walk'] + '.json')
        replace(path, (json.dumps(state, indent=2) + '\n').encode(),
                durable=bool(state.get('queue_id')) or 'pinned' in state or 'scratch_bytes' in state or 'scratch_identity' in state
                or state.get('slot_claim', {}).get('release_status') == 'release unconfirmed')
        self.states[('walk', state['walk'])] = state


    def read_state(self, path):
        no_links(self.workspace.tmp, path)
        data = read_bytes(path, 1024 * 1024 + 1)
        need(len(data) <= 1024 * 1024, f'{path}: state exceeds 1 MiB', 4)
        return json.loads(data)

    def claims(self, states):
        for directory, state in states:
            try:
                kind = self.classes[directory]
                name = state[kind]
                need(isinstance(name, str) and re.fullmatch(NAME, name), 'invalid state identity', 4)
                self.states[(kind, name)] = state
            except (Problem, KeyError, TypeError, ValueError, RecursionError):
                log(f'{directory.name}: invalid state claims; keeping custody')
        claimed = {}
        for (_, owner), state in self.states.items():
            try:
                names = list(self.outstanding(state))
                for name in names:
                    claimed.setdefault(name, []).append(owner)
            except (KeyError, TypeError, ValueError, RecursionError, AttributeError):
                log(f'{owner}: invalid state claims; keeping custody')
        for holder, name in self.current_legacy_claims():
            claimed.setdefault(name, []).append(holder)
        self.conflicts = {name for name, owners in claimed.items() if len(owners) > 1}
        for name in sorted(self.conflicts):
            log(f'{name}: conflicting custody claims by {", ".join(claimed[name])}; keeping custody')

    def current_legacy_claims(self):
        # Missing inventory or an unknown holder cannot retire a legacy claim.
        return {(holder, name) for holder, name in self.legacy_claims
                if (name not in self.inventory_names and name not in self.holders
                    or self.holders.get(name) == holder)}

    def legacy_holders(self):
        return {attempt.get('holder', state['holder']) for state in self.legacy_walks
                for attempt in [state, *state.get('attempts', [])]}

    def outstanding(self, state):
        return {name: path for name, path in state.get('logins', {}).items() if name not in state.get('given', [])}

    def give(self, directory, state, kind=None):
        self.claims([(directory, state)])
        if not self.giving:
            return
        foreign = self.legacy_holders()
        for name in self.outstanding(state):
            if self.holders.get(name) in foreign:
                log(f'{name}: held by a legacy walk; keeping custody')
                continue
            if name in self.conflicts:
                continue
            if kind and state.get('kinds', {}).get(name, 'moved') != kind:
                continue
            result = self.call('logins', 'give', name, '--as', state['holder'])
            if result.returncode == 0:
                self.released_login(name)
                state.setdefault('given', []).append(name)
                self.save(directory, state)
                log(f'{state["walk"]}: gave {name} back')
            else:
                log(f'{state["walk"]}: cannot give {name} back: {result.stderr.strip()}')
                if result.returncode == 1 and kind == 'moved':
                    alerts = state.setdefault('alerts', {})
                    if name not in alerts:
                        alerts[name] = dict.fromkeys(self.stuck, False)
                        self.save(directory, state)

    def stuck_addresses(self):
        configured = getattr(self, 'options', {}).get('QA_STUCK_TO', '')
        if configured:
            return list(dict.fromkeys((configured, self.director)))
        addresses = []
        path = Path.home() / '.config/agents-qa/stuck'
        try:
            data = read_bytes(path, 16 * 1024 + 1)
            need(len(data) <= 16 * 1024, 'exceeds 16 KiB', 4)
        except FileNotFoundError:
            return [self.director]
        except (OSError, Problem) as error:
            why = str(error) if isinstance(error, Problem) else type(error).__name__
            log(f'{path}: cannot read stuck addresses ({why}); using director alone')
            return [self.director]
        for number, line in enumerate(data.decode(errors='replace').splitlines(), 1):
            if len(line) > 200:
                log(f'{path}:{number}: invalid stuck address; skipped')
                continue
            address = line.split('#', 1)[0].strip()
            if not address:
                continue
            if len(address) <= 120 and re.fullmatch(ADDRESS, address):
                if address not in addresses and len(addresses) < 16:
                    addresses.append(address)
            else:
                log(f'{path}:{number}: invalid stuck address; skipped')
        if self.director not in addresses:
            addresses.append(self.director)
        return addresses

    def alert(self, directory, state, units):
        kind = self.classes[directory]
        name = state[kind]
        for login, receipts in state.get('alerts', {}).items():
            if all(receipts.values()):
                continue
            body = (f'Login {login} was stuck in {kind} {name}: not back at {state["logins"][login]}.\n'
                    f'Its deployment is in {directory}; qa watch gives it back once it is.\n')
            walk_kind = state.get('kind', next(iter(self.options['QA_WALK_KINDS'])))
            body += (f'Holder: {state["holder"]}. Pool: {pool_of(login)}.\n'
                     f'It counts against kind {walk_kind}\'s cap until it is back.\n')
            body += ''.join(f'Unit {unit} is still up or of unknown state.\n'
                            for unit, status in (units or {}).items() if status != 'stopped')
            if units is None:
                body += 'Deployment units are unknown.\n'
            body += f'Scratch: {directory}. The service tries again at each check.\n'
            message = directory / 'alert-body'
            replace(message, body.encode())
            for address, sent in receipts.items():
                key = (name, login, address)
                if sent or key in self.alert_attempted:
                    continue
                self.alert_attempted.add(key)
                try:
                    need(len(address) <= 120, 'invalid stuck address', 4)
                    result = self.call('post', 'send', '--as', 'qa-watch', address,
                                       f'qa: login {login} stuck in {kind} {name}', message)
                except (OSError, Problem) as error:
                    log(f'{name}: alert for {login} failed ({type(error).__name__}); trying next check')
                    continue
                if result.returncode in (0, 3):
                    receipts[address] = True
                    try:
                        self.save(directory, state)
                    except BaseException:
                        receipts[address] = False
                        raise
                else:
                    log(f'{name}: alert for {login} to {address} failed; trying next check')
        return all(all(receipts.values()) for receipts in state.get('alerts', {}).values())

    def released_login(self, name):
        self.holders.pop(name, None)


    def give_strays(self, walks, sweep_walks=True):
        # A take can survive the caller before its grant is saved.
        listing = self.call('logins', 'list')
        inventory = login_inventory(listing.stdout) if listing.returncode == 0 else None
        self.giving = inventory is not None
        self.holders = inventory if inventory is not None else {}
        self.inventory_names = {m[1] for line in listing.stdout.splitlines()
                                if (m := LISTED.fullmatch(line))} if inventory is not None else set()
        self.claims(walks)
        if inventory is None:
            log('cannot list stray logins: ' + (listing.stderr.strip() if listing.returncode
                                                else 'the listing is not in its form'))
            return
        held = {(state['holder'], name) for _, state in walks for name in self.outstanding(state)}
        held |= self.current_legacy_claims()
        managed = {attempt.get('holder', state['holder']) for _, state in walks
                   for attempt in [state, *state.get('attempts', [])]}
        foreign = self.legacy_holders()
        if not sweep_walks:
            return
        pending = {state['holder'] for _, state in walks
                   if state['stage'] == 'starting' and not state['run']}
        unknown = {}
        for name, holder in sorted(self.holders.copy().items()):
            if not holder.startswith('walk/') or holder in foreign or holder in pending:
                continue
            if holder not in managed:
                unknown.setdefault(holder, []).append(name)
                continue
            if name in self.conflicts or (holder, name) in held:
                continue
            result = self.call('logins', 'give', name, '--as', holder)
            if result.returncode == 0:
                self.released_login(name)
                log(f'gave back {name}: held without a saved grant')
            elif result.returncode not in (1, 2):
                log(f'{name}: cannot give stray login back: {result.stderr.strip()}')
        for holder, names in unknown.items():
            try:
                self.notify_once('stray holder ' + holder, 'qa: unsaved walk login holder',
                                 f'Holder {holder} has no saved fabrig walk state.\n'
                                 f'Logins: {", ".join(names)}. Left held; reconcile with the holder.\n')
            except (OSError, Problem, ValueError, UnicodeError):
                log(f'{holder}: cannot record stray alert; logins left held')


    def unit_status(self, unit, directory=None, launch_checked=False):
        properties = ['--property=LoadState', '--property=ActiveState', '--property=Job']
        if directory is not None:
            properties.append('--property=WorkingDirectory')
        result = self.call('systemctl', '--user', 'show', *properties, '--', unit)
        rows = [line.partition('=') for line in result.stdout.splitlines()]
        keys = {prop.removeprefix('--property=') for prop in properties}
        if (result.returncode == 0 and len(rows) == len(keys)
                and all(sep for _, sep, _ in rows) and {key for key, _, _ in rows} == keys):
            fields = {key: value for key, _, value in rows}
            load, active = fields['LoadState'], fields['ActiveState']
            if directory is not None and load == 'loaded' and fields['WorkingDirectory'] != str(directory):
                log(f'{unit}: WorkingDirectory is not the walk directory; keeping logins held')
                return 'unknown'
            # ActiveState alone cannot exclude a queued or running start job.
            # systemd reports no job as an empty value; accept zero too.
            job = fields['Job']
            if job and not re.fullmatch(r'[0-9]+', job):
                log(f'{unit}: cannot establish pending job; keeping custody')
                return 'unknown'
            if job and int(job) != 0:
                log(f'{unit}: pending job; keeping custody and slot')
                return 'launching'
            stopped = (load == 'loaded' and active in ('inactive', 'failed')
                       or load == 'not-found' and active == 'inactive')
            if stopped:
                if not launch_checked and unit.startswith('codex-run-'):
                    run = self.runs / unit.removeprefix('codex-run-')
                    try:
                        meta = (run / 'meta').stat()
                    except FileNotFoundError:
                        log(f'{unit}: cannot establish launcher task; keeping custody')
                        return 'unknown'
                    if (load == 'not-found' and not (run / 'ended').exists()
                            and utc(timestamp()).timestamp() - meta.st_mtime < 600
                            or self.launcher_alive(run / 'meta') is not False):
                        log(f'{unit}: launch may still start; keeping custody and slot')
                        return 'launching'
                    # The unit or its job may change while the launcher exits.
                    return self.unit_status(unit, directory, launch_checked=True)
                return 'stopped'
            if load == 'loaded' and active in ('activating', 'active', 'reloading', 'deactivating'):
                return 'busy'
        log(f'{unit}: cannot establish unit state; keeping logins held')
        return 'unknown'

    def launcher_alive(self, meta):
        fields = dict(line.split('=', 1) for line in read_text(meta).splitlines() if '=' in line)
        return self.task_launcher_alive(fields.get('task', ''))

    def task_launcher_alive(self, task):
        need(task and Path(task).is_absolute(), 'cannot establish launcher task; keeping custody', 4)
        expected = os.fsencode(task)
        unknown = False
        processes = self.workspace.fixture / 'proc' if self.workspace.fixture else Path('/proc')
        for process in processes.iterdir():
            if not process.name.isdecimal():
                continue
            try:
                # Other users' launchers cannot own our user-manager task.
                if process.stat().st_uid != os.getuid():
                    continue
                path = process / 'cmdline'
                try:
                    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                except FileNotFoundError:
                    raise
                except OSError as error:
                    raise Problem(f'{path}: cannot open safely ({error.strerror})', 4) from None
                with os.fdopen(descriptor, 'rb') as source:
                    info = os.fstat(source.fileno())
                    # Non-dumpable processes can have our UID on /proc/PID but
                    # root-owned cmdline files. Our codex-run launchers are
                    # ordinary dumpable processes, so these cannot be ours.
                    # Preserve all other descriptor refusals before skipping.
                    if (stat.S_ISREG(info.st_mode) and info.st_nlink == 1
                            and info.st_uid != os.getuid()):
                        continue
                    check_file(source, path)
                    data = source.read(1024 * 1024 + 1)
            except (FileNotFoundError, ProcessLookupError):
                continue
            except OSError:
                unknown = True
                continue
            if len(data) > 1024 * 1024:
                unknown = True
                continue
            words = data.rstrip(b'\0').split(b'\0')
            if any(Path(os.fsdecode(word)).name == 'codex-run' and words[index + 1:index + 2] == [b'task']
                   and expected in words[index + 2:] for index, word in enumerate(words)):
                return True
        return None if unknown else False

    def unit_stopped(self, unit, seconds, directory=None):
        # ended precedes the session's on-stop; deactivating still runs give-back.
        deadline = time.monotonic() + seconds
        while True:
            status = self.unit_status(unit, directory)
            if status == 'stopped':
                return True
            if status in ('unknown', 'launching'):
                return False
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                log(f'{unit}: waiting for unit to stop before giving logins back')
                return False
            time.sleep(min(UNIT_POLL_SECONDS, remaining))

    def deployments(self, directory, state):
        result = self.call('systemctl', '--user', 'list-units', '--all', '--plain', '--no-legend',
                           '--full', 'qa-' + state['walk'] + '-*')
        if result.returncode:
            log(f'{state["walk"]}: deployment listing failed; units unknown')
            return None
        units = {}
        pattern = re.escape('qa-' + state['walk'] + '-') + r'[a-z][a-z0-9-]*'
        for line in result.stdout.splitlines():
            fields = line.split(maxsplit=4)
            if (len(fields) < 4 or not fields[0].startswith('qa-' + state['walk'] + '-')
                    or fields[1] != 'loaded'
                    or fields[2] not in ('active', 'inactive', 'activating', 'deactivating', 'failed', 'reloading')
                    or not re.fullmatch(r'[a-z][a-z0-9-]*', fields[3])):
                log(f'{state["walk"]}: malformed deployment listing; units unknown')
                return None
            # list-units prints canonical service names, unlike --unit's input.
            unit = fields[0].removesuffix('.service')
            if not re.fullmatch(pattern, unit):
                continue
            if unit in units:
                log(f'{state["walk"]}: duplicate deployment listing; units unknown')
                return None
            units[unit] = self.unit_status(unit, directory)
        return units

    def end(self, directory, state):
        if (state['run'] and not (self.runs / state['run'] / 'ended').exists()
                and self.unit_status('codex-run-' + state['run']) != 'stopped'):
            self.alert(directory, state, None)
            return False
        self.give(directory, state, 'moved')
        units = self.deployments(directory, state)
        alerted = self.alert(directory, state, units)
        moved = [name for name in self.outstanding(state)
                 if state.get('kinds', {}).get(name, 'moved') == 'moved']
        if not moved and units is not None:
            for unit, status in units.items():
                if status != 'busy':
                    continue
                stopped = self.call('systemctl', '--user', 'stop', '--no-block', '--', unit)
                if stopped.returncode:
                    log(f'{state["walk"]}: stop {unit} failed')
                units[unit] = ('stopped' if self.unit_stopped(unit, self.options['QA_GIVE_BACK_SECONDS'], directory)
                               else 'unknown')
        remaining = [unit for unit, status in (units or {}).items() if status != 'stopped']
        complete = units is not None and not remaining
        if complete:
            self.give(directory, state, 'in-place')
        if (complete and not state.get('released') and (not state['run']
                or self.unit_status('codex-run-' + state['run']) == 'stopped')):
            state['released'] = True
            self.save(directory, state)
        self.release_slot(directory, state)
        return complete and alerted


    def facts(self, run):
        exit_code = 'unknown'
        rows = self.runs / 'runs.tsv'
        if run and rows.exists():
            for line in read_text(rows).splitlines():
                row = line.split('\t')
                if len(row) >= 13 and row[0] == run:
                    exit_code = row[4]
        return {'exit': exit_code}

    def recover_run(self, directory, state):
        # codex-run writes meta before launching its unit. Recover an acknowledged
        # launch even if this service died before saving the returned id.
        matches = []
        for path in self.runs.glob('*/meta'):
            fields = dict(line.split('=', 1) for line in read_text(path).splitlines() if '=' in line)
            earlier = {a.get('run') for a in state.get('attempts', [])[:-1]}
            if (path.parent.name not in earlier
                    and fields.get('task') == str(directory / 'task.md')
                    and fields.get('report') == str(directory / 'report.md')):
                need(re.fullmatch(r'[a-zA-Z0-9_-]+', path.parent.name), 'invalid recovered run', 4)
                matches.append(path.parent.name)
        need(len(matches) <= 1, f'{state["walk"]}: multiple runs for one brief', 4)
        if matches:
            state['run'] = matches[0]
            state['stage'] = 'running'
            self.save(directory, state)
            self.record_run(directory, state)
            log(f'{state["walk"]}: recovered run {state["run"]}')

    @contextmanager
    def walks_locked(self, wait=True):
        no_links(self.workspace.tmp, self.directory)
        self.directory.mkdir(parents=True, exist_ok=True)
        path = self.directory / 'walks.lock'
        no_links(self.workspace.tmp, path)
        with path.open('a') as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
            except BlockingIOError:
                yield False
                return
            try:
                no_links(self.workspace.tmp, self.directory / 'walks')
                (self.directory / 'walks').mkdir(mode=0o700, exist_ok=True)
            except (Problem, OSError):
                if wait:
                    raise
                log('cannot read walks directory; keeping walk custody')
                yield False
                return
            previous = self.walk_lock
            self.walk_lock = lock.fileno()
            try:
                yield True
            finally:
                self.walk_lock = previous

    def local_walks(self, strict=True):
        result = []
        self.walks_valid = True
        self.legacy_claims = set()
        self.legacy_walks = []
        parent = self.directory / 'walks'
        for path in sorted(parent.glob('*.json')):
            try:
                state = self.read_state(path)
                name = state['walk']
                if state['repo'] not in REPOSITORIES:
                    # Opaque foreign state is never managed or rewritten. Collect
                    # all claims; current inventory decides which still hold custody.
                    need(name == path.stem and isinstance(name, str)
                         and re.fullmatch(r'rung-[a-z0-9][a-z0-9-]*-[1-9][0-9]*', name),
                         'invalid legacy walk identity', 4)
                    need(isinstance(state.get('rung'), str) and isinstance(state.get('holder'), str),
                         'invalid legacy walk metadata', 4)
                    self.legacy_walks.append(state)
                    for attempt in [state, *state.get('attempts', [])]:
                        for login in attempt.get('logins', {}):
                            self.legacy_claims.add((attempt.get('holder', state['holder']), login))
                    continue
                need(name == path.stem and re.fullmatch(r'rung-[a-z0-9][a-z0-9-]*-[1-9][0-9]*', name)
                     and state['repo'] in REPOSITORIES and name == 'rung-' + state['rung'] + '-' + state.get('clock_walk', name.rsplit('-', 1)[-1])
                     and (state['holder'] == 'walk/' + name or isinstance(state.get('kind'), str)
                          and re.fullmatch(r'[a-z][a-z0-9]*', state['kind'])
                          and state['holder'] == 'walk/' + state['kind'] + '/' + name), f'{path}: invalid walk', 4)
                need('kind' not in state or isinstance(state['kind'], str)
                     and re.fullmatch(r'[a-z][a-z0-9]*', state['kind']), 'invalid saved walk kind', 4)
                need('pinned' not in state or type(state['pinned']) is bool, 'invalid pin', 4)
                need('scratch_bytes' not in state or type(state['scratch_bytes']) is int
                     and state['scratch_bytes'] > 0, 'invalid scratch reservation', 4)
                identity = state.get('scratch_identity')
                need(identity is None or isinstance(identity, dict) and set(identity) == {'device', 'inode'}
                     and type(identity['device']) is int and identity['device'] >= 0
                     and type(identity['inode']) is int and identity['inode'] > 0, 'invalid scratch identity', 4)
                walk_attempt(state)
                if 'attempts' in state or 'attempt' in state:
                    need(type(state['attempt']) is int and state['attempt'] >= 1
                         and isinstance(state['attempts'], list) and len(state['attempts']) == state['attempt'],
                         'invalid walk attempt history', 4)
                    for number, attempt in enumerate(state['attempts'], 1):
                        walk_attempt(attempt)
                        need(attempt['attempt'] == number, 'invalid attempt number', 4)
                deployments = state.get('deployments', [])
                need(isinstance(deployments, list), 'invalid saved deployments', 4)
                for deployment in deployments:
                    need(isinstance(deployment, dict) and set(deployment) == {'name', 'unit', 'argv'}
                         and isinstance(deployment['name'], str) and re.fullmatch(r'[a-z][a-z0-9-]*', deployment['name'])
                         and deployment['unit'] == f'qa-{name}-{deployment["name"]}'
                         and isinstance(deployment['argv'], list) and deployment['argv']
                         and all(isinstance(word, str) for word in deployment['argv'])
                         and Path(deployment['argv'][0]).is_absolute(), 'invalid saved deployment', 4)
                need(len({d['name'] for d in deployments}) == len(deployments), 'duplicate saved deployment', 4)
                need(isinstance(state['starter'], str) and state['starter'], f'{path}: invalid starter', 4)
                directory = self.workspace.tmp / 'qa-focused' / name
                no_links(self.workspace.tmp, directory)
                self.classes[directory] = 'walk'
                result.append((directory, state))
            except (Problem, OSError, ValueError, RecursionError, KeyError, TypeError, AttributeError):
                if strict:
                    raise Problem(f'{path}: invalid walk state; keeping custody', 4) from None
                self.walks_valid = False
                log(f'{path}: invalid walk state; keeping custody')
        return result

    def walk_event(self, directory, state, event, note):
        parent = directory.parent / state['rung']
        path = parent / 'loop.tsv'
        no_links(self.workspace.tmp, path)
        parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        descriptor = os.open(path, os.O_RDWR | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
        with os.fdopen(descriptor, 'r+') as out:
            check_file(out, path)
            fcntl.flock(out, fcntl.LOCK_EX)
            text = out.read()
            # The append can survive a crash before the state's progress save.
            attempt = state.get('attempt', 1)
            prefix = f'kind {state["kind"]} attempt {attempt}: ' if 'kind' in state else f'attempt {attempt}: '
            clock = state.get('clock_walk', state['walk'].rsplit('-', 1)[-1])
            if not any(row.split('\t')[2:4] in ([clock, event], [state['walk'], event])
                       and (row.split('\t')[-1].startswith(prefix)
                            or 'kind' not in state and attempt == 1)
                       for row in text.splitlines()):
                if not text:
                    out.write('time\trung\twalk\tevent\tnote\n')
                out.write(f'{timestamp()}\t{state["rung"]}\t{clock}\t{event}\t{prefix}{note}\n')
                out.flush()
                os.fsync(out.fileno())
        state['start_logged' if event in ('walk-start', 'walk-resume') else 'end_logged'] = True
        self.save(directory, state)

    def last_checkout(self, state):
        records = []
        for saved in self.states.values():
            for attempt in [saved, *saved.get('attempts', [])]:
                if (attempt.get('slot') != state['slot']
                        or attempt.get('slot_claim', {}).get('host') != state['slot_claim']['host']):
                    continue
                checkout = attempt.get('checkout')
                if checkout:
                    records.append(((checkout['sequence'], ''), checkout['main']))
                elif attempt.get('start_logged') and re.fullmatch(SHA, attempt.get('main', '')):
                    # Older states saved the start event only after checkout.
                    records.append(((0, attempt['started']), attempt['main']))
        if not records:
            return None, 0
        latest = max(order for order, _ in records)
        commits = {commit for order, commit in records if order == latest}
        return (next(iter(commits)) if len(commits) == 1 else None), latest[0]

    def walk_room(self, pools, kind):
        listing = self.call('logins', 'list')
        inventory = login_inventory(listing.stdout) if listing.returncode == 0 else None
        need(inventory is not None, 'cannot read login inventory for walk admission', 1)
        holders = inventory
        self.holders = holders
        self.inventory_names = {m[1] for line in listing.stdout.splitlines() if (m := LISTED.fullmatch(line))}
        slots = self.options['QA_WALK_KINDS'][kind]['slots']
        for pool in pools:
            held = walk_count(holders, pool, kind)
            defer(held < slots, f'kind {kind} holds {held} of its {slots} logins of pool {pool}')
        return holders

    def free_slot(self, walks, kind, preferred=None):
        numbers = self.options['QA_WALK_KINDS'][kind]['numbers']
        need(preferred is None or preferred in numbers, f'saved slot {preferred} is no longer configured for kind {kind}')
        held = {s['slot'] for _, s in walks if not s.get('released')
                or s.get('slot_claim') and not s['slot_claim']['released']}
        candidates = [n for n in ([preferred] if preferred is not None else numbers) if n not in held]
        defer(candidates, f'no free walk slot for kind {kind}' + (f' (saved slot {preferred})' if preferred else ''))
        claim = dict(host=self.options['QA_SLOT_HOST'], owner=self.options['QA_CLAIM_OWNER'],
                     ssh=self.options['QA_CLAIM_SSH'])
        try:
            listed = self.slot_call(claim, 'list')
            need(listed.returncode == 0,
                 f'claim list exit {listed.returncode}: {listed.stderr.strip() or "unavailable"}', 1)
            rows = listed.stdout.splitlines()
        except (UnicodeError, AttributeError, TypeError) as error:
            raise Problem(f'cannot read slot inventory: {type(error).__name__}', 4) from None
        free = []
        for number in candidates:
            prefix = f'{claim["host"]} {number} ['
            observed = [row for row in rows if row.startswith(prefix)]
            pattern = (re.escape(prefix) + r'[^]\r\n]+\]: (free|[a-z][a-z0-9/-]*: '
                       + r'[^\r\n]+ \(since [^()\r\n]+\); held [^\r\n]+)')
            match = re.fullmatch(pattern, observed[0]) if len(observed) == 1 else None
            need(match, f'cannot read slot inventory for {claim["host"]} {number}: missing, malformed or duplicate row', 4)
            if match[1] == 'free':
                free.append(number)
        defer(free, f'walk slots for kind {kind} are busy' + (f' (saved slot {preferred})' if preferred else ''))
        return free[0]

    def dependencies(self, root, commits):
        for commit in commits:
            objects = git(root, 'rev-parse', '--disambiguate=' + commit.lower()).splitlines()
            ready = (len(objects) == 1 and re.fullmatch(SHA, objects[0])
                     and git(root, 'cat-file', '-t', objects[0], check=False).stdout.strip() == 'commit'
                     and git(root, 'merge-base', '--is-ancestor', objects[0],
                             'refs/remotes/origin/main', check=False).returncode == 0)
            defer(ready, f'after {commit} is not on origin/main')

    def queue_entries(self):
        parent = self.directory / 'queue'
        no_links(self.workspace.tmp, parent)
        result = []
        for path in sorted(parent.glob('*.json')):
            entry = self.read_state(path)
            need(isinstance(entry, dict) and entry.get('id') == path.stem
                 and re.fullmatch(r'[0-9a-f]{32}', path.stem)
                 and {'repo', 'rung', 'kind', 'starter', 'after', 'login', 'cap', 'resume', 'build', 'reason', 'since', 'order'} <= set(entry)
                 and entry.get('repo') in REPOSITORIES
                 and isinstance(entry.get('rung'), str) and re.fullmatch(r'[a-z0-9][a-z0-9-]*', entry['rung'])
                 and isinstance(entry.get('kind'), str) and re.fullmatch(r'[a-z][a-z0-9]*', entry['kind'])
                 and isinstance(entry.get('starter'), str) and re.fullmatch(ADDRESS, entry['starter'])
                 and isinstance(entry.get('after'), list)
                 and all(isinstance(c, str) and re.fullmatch(r'[0-9a-fA-F]{4,40}', c) for c in entry['after'])
                 and isinstance(entry.get('login'), list)
                 and all(isinstance(pool, str) and re.fullmatch(LOGIN, pool) and pool_of(pool) == pool
                         for pool in entry['login'])
                 and (entry.get('cap') is None or type(entry['cap']) is int and entry['cap'] >= 1)
                 and (entry.get('resume') is None or isinstance(entry['resume'], str)
                      and re.fullmatch(r'rung-[a-z0-9][a-z0-9-]*-[1-9][0-9]*', entry['resume']))
                 and (entry.get('build') is None or isinstance(entry['build'], str))
                 and isinstance(entry.get('reason'), str) and isinstance(entry.get('since'), str)
                 and type(entry.get('order')) is int and entry['order'] > 0, f'{path}: invalid queued walk', 4)
            utc(entry['since'])
            result.append(entry)
        return sorted(result, key=lambda e: (e['order'], e['id']))

    def save_queue(self, entry):
        path = self.directory / 'queue' / (entry['id'] + '.json')
        no_links(self.workspace.tmp, path)
        replace(path, (json.dumps(entry, indent=2) + '\n').encode(), durable=True)

    def drop_queue(self, identity):
        path = self.directory / 'queue' / (identity + '.json')
        no_links(self.workspace.tmp, path)
        path.unlink()
        descriptor = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)

    def enqueue(self, args, reason):
        # A repeated resume request updates neither its place nor its inputs.
        entries = self.queue_entries()
        entry = next((e for e in entries if args.resume and e['resume'] == args.resume), None)
        if entry is None:
            entry = dict(id=secrets.token_hex(16), repo=args.repo, rung=args.rung,
                         kind=args.queue_kind, login=args.queue_login, cap=args.cap,
                         build=args.build, resume=args.resume, after=args.after,
                         starter=args.queue_starter, since=timestamp(), reason=str(reason),
                         order=max((e['order'] for e in entries), default=0) + 1)
            self.save_queue(entry)
        print('queued ' + (entry['resume'] or entry['id']))
        return 0

    def check_queue(self):
        if not self.walks_valid:
            return
        try:
            entries = self.queue_entries()
        except Exception as error:
            log(f'cannot read walk queue: {error}; cleanup continues')
            return
        attempted = set()
        for entry in entries:
            try:
                walks = self.local_walks()
                saved = [a for _, s in walks for a in [s, *s.get('attempts', [])]
                         if a.get('queue_id') == entry['id']]
                if any(a.get('run') for a in saved):
                    self.drop_queue(entry['id'])
                    continue
                if entry['resume']:
                    state = next((s for _, s in walks if s['walk'] == entry['resume']), None)
                    if state is None or (state['stage'] != 'paused'
                                         and not any(a['stage'] == 'starting' for a in saved)):
                        self.notify_once('queue dropped ' + entry['id'], 'qa: queued resume dropped',
                                         f'Queue {entry["id"]}: {entry["resume"]} is no longer paused.\n')
                        self.drop_queue(entry['id'])
                        continue
                if entry['kind'] in attempted:
                    continue
                args = argparse.Namespace(**{key: entry[key] for key in
                                          ('repo', 'rung', 'cap', 'build', 'resume', 'after')},
                                          kind=None if entry['resume'] else entry['kind'],
                                          login=[] if entry['resume'] else entry['login'])
                status = start_walk(args, self.workspace, self, entry)
                attempted.add(entry['kind'])
                if status == 0:
                    self.drop_queue(entry['id'])
                else:
                    entry['reason'] = 'launch outcome is still unknown; admission waits for the watcher'
                    self.save_queue(entry)
            except Deferred as error:
                try:
                    if entry['reason'] != str(error):
                        entry['reason'] = str(error)
                        self.save_queue(entry)
                except Exception:
                    log(f'queue {entry["id"]}: cannot save deferred reason; entry kept')
            except Exception as error:
                attempted.add(entry['kind'])
                try:
                    entry['reason'] = str(error)
                    self.save_queue(entry)
                    self.notify_once('queue ' + entry['id'] + ' reason ' + str(error),
                                     'qa: queued walk refused', f'Queue {entry["id"]}: {error}. Kept queued.\n')
                except Exception:
                    log(f'queue {entry["id"]}: cannot save refusal notice; entry kept')

    def admission_ready(self, walks):
        for _, state in walks:
            need(state['stage'] != 'starting' or state['run'],
                 f'{state["walk"]}: launch outcome is still unknown; admission waits for the watcher', 1)

    def overdue_launch_notice(self, state, observation):
        if state['stage'] != 'starting' or state['run']:
            return
        seconds = (utc(timestamp()) - utc(state['started'])).total_seconds()
        if seconds < 600:
            return
        attempt = state.get('attempt', 1)
        self.notify_once(f'overdue launch {state["walk"]} attempt {attempt} started {state["started"]}',
                         f'qa: overdue launch for {state["walk"]}',
                         f'Walk {state["walk"]}, attempt {attempt}: overdue launch.\n'
                         f'Waiting {int(seconds)} seconds since {state["started"]} (grace 600 seconds).\n'
                         f'Observed: {observation}.\n'
                         'Launch is not proven complete or cancelled; custody and admission stay held.\n')

    def launch_cancelled(self, directory, state):
        # An acknowledged command exit may be checked immediately. Otherwise
        # absence means nothing until the existing ten-minute launch grace ends.
        if (not state.get('launch_complete')
                and (utc(timestamp()) - utc(state['started'])).total_seconds() < 600):
            log(f'{state["walk"]}: awaiting launch metadata within grace; keeping custody')
            return False
        try:
            launcher = self.task_launcher_alive(directory / 'task.md')
        except (Problem, OSError, ValueError, UnicodeError):
            launcher = None
        if launcher is not False:
            self.overdue_launch_notice(state, 'launcher live' if launcher is True else 'launcher unknown')
            log(f'{state["walk"]}: launcher live or unknown; keeping custody')
            return False
        # A launcher can publish metadata and exit during the process scan.
        self.recover_run(directory, state)
        return not state['run']

    def cancel_walk(self, directory, state, drop=True):
        if state['stage'] == 'starting':
            self.recover_run(directory, state)
            if state['run'] or not self.launch_cancelled(directory, state):
                return
        state['stage'] = 'cancelled'
        self.save(directory, state)
        # A take may have left a waiter or a grant without a reply.
        for pool in state['requests'] if drop else []:
            dropped = self.call('logins', 'drop', pool, '--any', '--as', state['holder'])
            need(dropped.returncode == 0, f'cannot drop walk request for {pool}', 4)
        self.give(directory, state)
        if not self.outstanding(state):
            state.update(stage='ended', released=True)
            if state.get('attempt', 1) > 1:
                state.update(stage='paused', decision='walk-pause', end_logged=True, posted=True)
                replace(directory / 'paused', (state['pause_line'] + '\n').encode())
            self.save(directory, state)
        self.release_slot(directory, state)

    def check_walk(self, directory, state):
        self.record_run(directory, state)
        if state.get('stage') == 'cancelled':
            self.cancel_walk(directory, state)
            return
        if not state['run']:
            self.recover_run(directory, state)
        if not state['run']:
            self.cancel_walk(directory, state)
            return
        unit = 'codex-run-' + state['run']
        ended = self.runs / state['run'] / 'ended'
        if state['stage'] != 'ending':
            status = self.unit_status(unit)
            if not ended.exists() and status != 'stopped':
                if status == 'busy' and (state.get('capped') or
                        (utc(timestamp()) - utc(state['started'])).total_seconds() >= state['cap'] * 60):
                    stopped = self.call('systemctl', '--user', 'stop', unit)
                    if stopped.returncode:
                        log(f'{state["walk"]}: stop failed: {stopped.stderr.strip()}')
                        return
                    state['capped'] = True
                    self.save(directory, state)
                else:
                    return
            if not self.unit_stopped(unit, self.options['QA_GIVE_BACK_SECONDS']):
                return
            state['stage'] = 'ending'
            self.save(directory, state)
        # Confirm the session's stop even when recovering an interrupted end.
        if not self.unit_stopped(unit, self.options['QA_GIVE_BACK_SECONDS']):
            self.alert(directory, state, None)
            return
        if ('decision' not in state and (state.get('end_logged') or state.get('posted')
                                        or pause_line(directory) is None)):
            state['decision'] = 'walk-end'
            self.save(directory, state)
        self.end(directory, state)
        missing = self.outstanding(state)
        units = self.deployments(directory, state)
        remaining = [unit for unit, status in (units or {}).items() if status != 'stopped']
        if 'decision' not in state:
            line = pause_line(directory)
            state['decision'] = ('walk-pause' if not state.get('end_logged') and not state.get('posted')
                                 and line is not None and not missing
                                 and units is not None and not remaining and state.get('released') else 'walk-end')
            if state['decision'] == 'walk-pause':
                state['pause_line'] = line
            self.save(directory, state)
        paused = state['decision'] == 'walk-pause'
        facts = self.facts(state['run'])
        note = f'exit {facts["exit"]}; out: ' + (', '.join(missing) or 'none')
        if remaining or units is None:
            note += '; units: ' + (', '.join(remaining) if units is not None else 'unknown')
        if not state.get('end_logged'):
            self.walk_event(directory, state, state['decision'], state['pause_line'] if paused else note)

    def finish_walk(self, directory, state, kept):
        """Commit completion against fresh custody after the scan, never scan here."""
        with self.walks_locked(wait=False) as locked:
            if not locked:
                return state
            fresh = next((s for _, s in self.local_walks(strict=False) if s['walk'] == state['walk']), None)
            if (not fresh or fresh['stage'] != 'ending' or not fresh.get('end_logged')
                    or not fresh.get('decision')):
                return fresh or state
            state = fresh
            paused = state['decision'] == 'walk-pause'
            facts = self.facts(state['run'])
            missing = self.outstanding(state)
            units = self.deployments(directory, state)
            remaining = [unit for unit, status in (units or {}).items() if status != 'stopped']
            if not state.get('posted'):
                outcome = 'paused' if paused else 'ended'
                body = (f'Walk {state["walk"]} {outcome}; exit {facts["exit"]}.\n'
                        f'Report: {directory}/report.md\n')
                if kept:
                    body += 'Evidence: ' + self.evidence_status(kept) + '\n'
                if paused:
                    body += f'Paused at: {state["pause_line"]}\n'
                body += ''.join(f'Login {name} is not back at {path}.\n' for name, path in missing.items())
                body += ''.join(f'Unit {unit} is still up or of unknown state.\n' for unit in remaining)
                if units is None:
                    body += 'Deployment units are unknown.\n'
                if missing or remaining or units is None:
                    body += 'The service tries again at each check.\n'
                message = directory / 'post-body'
                replace(message, body.encode())
                sent = self.call('post', 'send', '--as', 'qa-watch', state['starter'],
                                 f'qa: walk {state["walk"]} {outcome}', message)
                if sent.returncode in (0, 3):
                    state['posted'] = True
                    self.save(directory, state)
                    if kept:
                        kept['announced'] = self.evidence_identity(kept)
                        self.save_preservation(state, kept)
            if (state.get('released') and state.get('end_logged') and state.get('posted') and not missing
                    and all(all(receipts.values()) for receipts in state.get('alerts', {}).values())):
                state['stage'] = 'paused' if paused else 'ended'
                self.save(directory, state)

        return state

    def evidence_end(self, state, saved):
        ended, started = saved.get('ended'), state.get('started')
        need(isinstance(ended, str) and ended != 'unknown' and isinstance(started, str)
             and started != 'unknown', 'concrete evidence end/start time required', 4)
        end, start = utc(ended), utc(started)
        need(start <= end <= utc(timestamp()), 'evidence end time inconsistent with walk start', 4)
        return end

    def preservation_path(self, state):
        return self.directory / 'preservation' / (state['walk'] + '.json')

    def preservation(self, state):
        path = self.preservation_path(state)
        try:
            saved = self.read_state(path)
        except FileNotFoundError:
            return dict(walk=state['walk'], status='waiting')
        need(saved.get('walk') == state['walk'] and saved.get('status') in
             ('waiting', 'refused', 'kept-locally', 'kept'), 'invalid preservation state', 4)
        if 'ended' in saved or saved['status'] != 'waiting':
            self.evidence_end(state, saved)
        for key in ('digest', 'refusal_digest'):
            need(key not in saved or isinstance(saved[key], str) and re.fullmatch(r'[0-9a-f]{64}', saved[key]),
                 'invalid evidence digest', 4)
        need(saved['status'] != 'refused' or isinstance(saved.get('refusal'), str)
             and bool(saved.get('refusal_digest')), 'invalid evidence refusal', 4)
        need(saved['status'] not in ('kept', 'kept-locally') or bool(saved.get('digest')),
             'missing kept evidence identity', 4)
        if saved.get('digest'):
            remote = saved.get('remote')
            need(isinstance(remote, str) and (not remote or remote == 'git@github.com:fabrig-ai/qa.git'
                 or self.workspace.fixture and Path(remote).is_absolute()
                 and str(Path(remote)).startswith(str(self.workspace.fixture) + '/')), 'invalid saved evidence remote', 4)
            expected = 'walks/' + state.get('attempts', [state])[0]['started'][:10] + '-' + state['walk']
            need(saved.get('destination') == expected and isinstance(saved.get('branch'), str)
                 and (not saved['branch'] and not remote or
                      re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9/_-]*', saved['branch'])
                      and all(saved['branch'].split('/'))), 'invalid saved evidence destination', 4)
        need(saved['status'] != 'kept' or isinstance(saved.get('commit'), str)
             and re.fullmatch(SHA, saved['commit']), 'invalid evidence commit', 4)
        quarantine = saved.get('quarantine')
        need(quarantine is None or isinstance(quarantine, str) and re.fullmatch(
             r'\.qa-prune-' + re.escape(state['walk']) + r'-[0-9a-f]{32}', quarantine),
             'invalid scratch quarantine', 4)
        return saved

    def save_preservation(self, state, saved):
        path = self.preservation_path(state)
        no_links(self.workspace.tmp, path)
        replace(path, (json.dumps(saved, sort_keys=True) + '\n').encode(), durable=True)

    def evidence_snapshot(self, state):
        root = self.directory / 'evidence' / state['walk']
        try:
            return evidence['read_snapshot'](root)
        except evidence['Refusal'] as error:
            raise Problem(str(error), 1) from None

    def prepare_evidence(self, directory, state):
        """Local bounded work only. Never put a publisher before custody returns."""
        need(not self.options.get('QA_PRESERVATION_ERROR'), 'evidence configuration pending', 1)
        saved = self.preservation(state)
        if saved.get('pruned'):
            return saved
        if saved.get('digest'):
            need(evidence['tree_digest'](self.evidence_snapshot(state)) == saved['digest'],
                 'saved evidence snapshot changed', 1)
            return saved
        if state.get('decision') == 'walk-pause' or state['stage'] == 'paused':
            return saved
        saved.setdefault('ended', timestamp())
        self.evidence_end(state, saved)
        root = self.directory / 'evidence' / state['walk']
        no_links(self.workspace.tmp, root)
        try:
            if root.exists():
                files = self.evidence_snapshot(state)  # Recover rename before receipt save.
            else:
                metadata = dict(kind='walk', name=state['walk'], host=self.workspace.machine(), source=str(directory),
                                runs=[a['run'] for a in state.get('attempts', [state]) if a.get('run')], record=None)
                files, _ = evidence['snapshot'](directory, metadata, self.options['QA_EVIDENCE_KIB'] * 1024)
                root.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                temporary = Path(tempfile.mkdtemp(prefix=root.name + '.', dir=root.parent))
                try:
                    for name, data in files.items():
                        replace(temporary / name, data, durable=True)
                    os.rename(temporary, root)
                    descriptor = os.open(root.parent, os.O_RDONLY | os.O_DIRECTORY)
                    try:
                        os.fsync(descriptor)
                    finally:
                        os.close(descriptor)
                finally:
                    if temporary.exists():
                        shutil.rmtree(temporary)
            remote = self.options['QA_EVIDENCE_REMOTE'] if self.options['QA_EVIDENCE_BRANCH'] else ''
            saved.update(digest=evidence['tree_digest'](files), local=str(root),
                         remote=remote, branch=self.options['QA_EVIDENCE_BRANCH'],
                         destination='walks/' + state.get('attempts', [state])[0]['started'][:10] + '-' + state['walk'],
                         status='waiting' if remote else 'kept-locally')
            saved.pop('refusal', None)
            saved.pop('refusal_digest', None)
        except evidence['Refusal'] as error:
            saved.update(status='refused', refusal=str(error), refusal_digest=error.digest)
        self.save_preservation(state, saved)
        return saved

    @contextmanager
    def evidence_locked(self):
        path = self.directory / 'evidence.lock'
        no_links(self.workspace.tmp, path)
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open('a') as lock:
            # An ongoing CLI keep does not hold up the watcher's next custody check.
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise Problem('evidence publisher busy; retry next check', 1) from None
            yield lock.fileno()

    def publish_evidence(self, state, saved, descriptor):
        need(self.options['QA_EVIDENCE_REMOTE'] and self.options['QA_EVIDENCE_BRANCH'],
             'both evidence repository and branch must be explicitly set', 1)
        root = self.directory / 'evidence.git'
        no_links(self.workspace.tmp, root)
        deadline = time.monotonic() + self.options['QA_EVIDENCE_SECONDS']
        def run(*args, data=None, check=True, author=False, repository=None):
            remaining = deadline - time.monotonic()
            need(remaining > 0, 'evidence publication timed out; retry next check', 1)
            env = dict(GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1')
            if author:
                env.update(GIT_AUTHOR_NAME='QA', GIT_AUTHOR_EMAIL='qa@localhost',
                           GIT_COMMITTER_NAME='QA', GIT_COMMITTER_EMAIL='qa@localhost',
                           GIT_AUTHOR_DATE=saved['ended'], GIT_COMMITTER_DATE=saved['ended'])
            result = command(['git', '-c', 'credential.helper=', '-c', 'core.hooksPath=/dev/null',
                              '-c', 'commit.gpgsign=false', '-C', repository or root, *args],
                             timeout=remaining, data=data, env=env, pass_fds=(descriptor,))
            # Remote output can contain external text. Keep diagnostics service-written.
            need(not check or result.returncode == 0, 'evidence git operation failed; retry next check', 1)
            return result.stdout.strip() if check else result
        if not root.exists():
            temporary = Path(tempfile.mkdtemp(prefix='evidence.git.', dir=root.parent))
            try:
                run('init', '--bare', '--quiet', repository=temporary)
                run('remote', 'add', 'origin', saved['remote'], repository=temporary)
                os.rename(temporary, root)
                descriptor_parent = os.open(root.parent, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    os.fsync(descriptor_parent)
                finally:
                    os.close(descriptor_parent)
            finally:
                if temporary.exists():
                    shutil.rmtree(temporary)
        need(run('rev-parse', '--is-bare-repository') == 'true'
             and run('config', '--get', 'remote.origin.url') == saved['remote'], 'unexpected evidence origin', 1)
        pushes = run('config', '--get-all', 'remote.origin.pushurl', check=False)
        rewrites = run('config', '--get-regexp', r'url\..*\.(insteadof|pushinsteadof)', check=False)
        need(pushes.returncode == 1 and rewrites.returncode == 1, 'evidence push target or URL rewriting refused', 1)
        files = self.evidence_snapshot(state)
        need(evidence['tree_digest'](files) == saved['digest'], 'saved evidence snapshot changed', 1)
        def tree(entries):
            return run('mktree', '-z', data=b''.join(
                f'{mode} {kind} {oid}\t{name}'.encode() + b'\0'
                for name, (mode, kind, oid) in sorted(entries.items())))
        def contents(oid):
            if not oid:
                return {}
            result = run('ls-tree', '-z', oid, check=False)
            need(result.returncode == 0, 'cannot read evidence tree', 1)
            entries = {}
            for entry in result.stdout.split('\0'):
                if entry:
                    fields, name = entry.split('\t', 1)
                    entries[name] = tuple(fields.split())
            return entries
        nested = {}
        for path, data in files.items():
            node = nested
            parts = path.split('/')
            for part in parts[:-1]:
                node = node.setdefault(part, {})
            node[parts[-1]] = run('hash-object', '-w', '--stdin', data=data)
        def build(node):
            return tree({name: ('040000', 'tree', build(value)) if isinstance(value, dict)
                         else ('100644', 'blob', value) for name, value in node.items()})
        snapshot_tree = build(nested)
        ref = 'refs/heads/' + saved['branch']
        tracking = 'refs/remotes/origin/' + saved['branch']
        def fetch():
            listed = run('ls-remote', '--exit-code', '--heads', 'origin', ref, check=False)
            if listed.returncode == 2:
                return ''
            need(listed.returncode == 0, 'evidence remote unavailable; retry next check', 1)
            run('fetch', '--quiet', '--no-tags', 'origin', '+' + ref + ':' + tracking)
            return run('rev-parse', tracking)
        def occupied(base):
            if not base:
                return ''
            result = run('rev-parse', '--verify', base + ':' + saved['destination'], check=False)
            return result.stdout.strip() if result.returncode == 0 else ''
        for _ in range(5):
            base = fetch()
            if saved.get('commit'):
                need(base and run('merge-base', '--is-ancestor', saved['commit'], base, check=False).returncode == 0,
                     'evidence history no longer contains saved commit', 1)
            existing = occupied(base)
            if existing:
                need(existing == snapshot_tree, 'evidence name occupied by different bytes', 1)
                return run('log', '--reverse', '--format=%H', base, '--', saved['destination']).splitlines()[0]
            entries = contents(base)
            walks = contents(entries['walks'][2]) if 'walks' in entries else {}
            name = saved['destination'].split('/', 1)[1]
            walks[name] = ('040000', 'tree', snapshot_tree)
            entries['walks'] = ('040000', 'tree', tree(walks))
            new_tree = tree(entries)
            candidate = run('commit-tree', new_tree, *(['-p', base] if base else []),
                            data=('Keep ' + saved['destination'] + '\n').encode(), author=True)
            saved.update(tree=snapshot_tree, candidate=candidate)
            self.save_preservation(state, saved)  # Exact identity precedes any push.
            run('push', '--quiet', 'origin', candidate + ':' + ref, check=False)
            confirmed = fetch()
            if confirmed and occupied(confirmed) == snapshot_tree:
                contained = run('merge-base', '--is-ancestor', candidate, confirmed, check=False)
                if contained.returncode == 0:
                    return candidate
        raise Problem('evidence push unconfirmed after five tries; retry next check', 1)

    def evidence_identity(self, saved):
        return saved['status'] + ':' + saved.get('digest', saved.get('refusal_digest', ''))

    def evidence_status(self, saved):
        status = saved['status']
        if status == 'refused':
            return 'refused (' + saved['refusal'] + ')'
        if status == 'kept':
            return 'kept ' + saved['commit'] + ' ' + saved['destination']
        if status == 'kept-locally':
            return 'kept-locally ' + saved['local']
        return 'waiting for evidence publication'

    def preserve_walk(self, directory, state, descriptor, saved=None):
        saved = saved if saved is not None else self.prepare_evidence(directory, state)
        due = saved.get('ended') and (utc(timestamp()) - utc(saved['ended'])).total_seconds() >= 7 * 86400
        if saved.get('digest') and (saved['status'] == 'waiting' or saved['status'] == 'kept' and due and not saved.get('pruned')):
            try:
                saved['commit'] = self.publish_evidence(state, saved, descriptor)
                saved['status'] = 'kept'
                self.save_preservation(state, saved)
            except (Problem, OSError, ValueError, UnicodeError) as error:
                log(f'{state["walk"]}: evidence pending ({type(error).__name__}); custody cleanup continues')
                return saved
        if saved['status'] == 'refused':
            self.notify_once('evidence refused ' + state['walk'] + ' ' + saved['refusal_digest'],
                             'qa: evidence refused', f'Walk {state["walk"]}: {saved["refusal"]}. Scratch retained.\n')
        identity = self.evidence_identity(saved)
        if state.get('posted') and saved['status'] != 'waiting' and saved.get('announced') != identity:
            message = self.directory / 'preservation' / (state['walk'] + '.body')
            replace(message, f'Walk {state["walk"]} evidence: {self.evidence_status(saved)}.\n'.encode())
            sent = self.call('post', 'send', '--as', 'qa-watch', state['starter'],
                             f'qa: walk {state["walk"]} evidence', message)
            if sent.returncode in (0, 3):
                saved['announced'] = identity
                self.save_preservation(state, saved)
        self.prune_walk(directory, state, saved)
        return saved

    def prune_walk(self, directory, state, saved):
        if saved.get('pruned'):
            self.notify_once('pruned ' + state['walk'], 'qa: walk scratch pruned',
                             f'Walk {state["walk"]}: scratch pruned after seven days; evidence {saved["status"]}.\n')
            return
        try:
            end = self.evidence_end(state, saved)
        except (Problem, ValueError, TypeError):
            return
        if (saved['status'] not in ('kept', 'kept-locally', 'refused') or not saved.get('ended')
                or (utc(timestamp()) - end).total_seconds() < 7 * 86400
                or saved.get('announced') != self.evidence_identity(saved)):
            return
        if saved['status'] == 'refused':
            key = 'evidence refused ' + state['walk'] + ' ' + saved['refusal_digest']
            notice = self.directory / 'attention' / (hashlib.sha256(key.encode()).hexdigest() + '.json')
            if not self.read_state(notice).get('delivered'):
                return
        with self.walks_locked(wait=False) as locked:
            if not locked:
                return
            walks = self.local_walks()
            fresh = next((s for _, s in walks if s['walk'] == state['walk']), None)
            if (not fresh or fresh.get('pinned') or fresh['stage'] != 'ended' or not fresh.get('released')
                    or not fresh.get('posted') or not fresh.get('end_logged') or self.outstanding(fresh)
                    or fresh.get('slot_claim') and not fresh['slot_claim']['released']
                    or not all(all(r.values()) for r in fresh.get('alerts', {}).values())):
                return
            holders = {a.get('holder', fresh['holder']) for a in [fresh, *fresh.get('attempts', [])]}
            listing = self.call('logins', 'list')
            inventory = login_inventory(listing.stdout) if listing.returncode == 0 else None
            if inventory is None or any(h in holders for h in inventory.values()):
                return
            # Reconfirm live claims and processes, even after saved release receipts.
            claim = fresh.get('slot_claim')
            if claim:
                listed = self.slot_call(claim, 'list')
                prefix = f'{claim["host"]} {fresh["slot"]} ['
                rows = [r for r in listed.stdout.splitlines() if r.startswith(prefix)]
                valid = len(rows) == 1 and re.fullmatch(re.escape(prefix) +
                        r'[^]\r\n]+\]: (?:free|[^\r\n]+ \(since [^()\r\n]+\); held .+)', rows[0])
                if listed.returncode or not valid or claim['what'] in rows[0]:
                    return
            if fresh['run'] and self.unit_status('codex-run-' + fresh['run']) != 'stopped':
                return
            units = self.deployments(directory, fresh)
            if units is None or any(status != 'stopped' for status in units.values()):
                return
            anchor = self.workspace.tmp / 'qa-focused'
            need(directory == anchor / fresh['walk'] and directory.parent == anchor,
                 'prune outside focused scratch refused', 4)
            no_links(self.workspace.tmp, directory)
            identity = fresh.get('scratch_identity')
            if not identity:
                self.notify_once('prune missing identity ' + fresh['walk'], 'qa: scratch identity missing',
                                 f'Walk {fresh["walk"]}: no saved scratch identity; scratch retained.\n')
                return
            with evidence['opened_directory'](anchor) as parent:
                if not self.quarantine_scratch(parent, fresh, saved, identity):
                    return
            saved['pruned'] = timestamp()
            self.save_preservation(fresh, saved)
        self.notify_once('pruned ' + state['walk'], 'qa: walk scratch pruned',
                         f'Walk {state["walk"]}: scratch pruned after seven days; evidence {saved["status"]}.\n')

    def quarantine_scratch(self, parent, state, saved, identity):
        """Only the saved inode may be recursively removed, via its open descriptor."""
        name = state['walk']
        quarantine = saved.get('quarantine')
        if quarantine is None:
            quarantine = '.qa-prune-' + name + '-' + secrets.token_hex(16)
            saved.update(quarantine=quarantine, pruning=True)
            self.save_preservation(state, saved)
        need(re.fullmatch(r'\.qa-prune-' + re.escape(name) + r'-[0-9a-f]{32}', quarantine),
             'invalid scratch quarantine', 4)
        def stat_at(path):
            try:
                return os.stat(path, dir_fd=parent, follow_symlinks=False)
            except FileNotFoundError:
                return None
        if stat_at(quarantine) is None:
            candidate = stat_at(name)
            if candidate is None:
                return bool(saved.get('pruning'))
            need(candidate.st_uid == os.getuid() and stat.S_ISDIR(candidate.st_mode), 'unsafe prune source', 4)
            os.rename(name, quarantine, src_dir_fd=parent, dst_dir_fd=parent)
            os.fsync(parent)
        descriptor = os.open(quarantine, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
        try:
            info = os.fstat(descriptor)
            if (dict(device=info.st_dev, inode=info.st_ino) != identity or info.st_uid != os.getuid()):
                # Never overwrite a replacement that appeared at the original name.
                if stat_at(name) is None:
                    os.rename(quarantine, name, src_dir_fd=parent, dst_dir_fd=parent)
                    os.fsync(parent)
                    saved.pop('quarantine', None)
                    saved.pop('pruning', None)
                    self.save_preservation(state, saved)
                self.notify_once('prune identity mismatch ' + name, 'qa: scratch identity mismatch',
                                 f'Walk {name}: candidate identity changed; scratch retained.\n')
                return False
            need(shutil.rmtree.avoids_symlink_attacks, 'safe tree removal unavailable', 4)
            # Enumerate/remove through the verified root descriptor: swapping the
            # quarantine pathname cannot redirect recursion to another directory.
            for entry in os.listdir(descriptor):
                child = os.stat(entry, dir_fd=descriptor, follow_symlinks=False)
                if stat.S_ISDIR(child.st_mode):
                    shutil.rmtree(entry, dir_fd=descriptor)
                else:
                    os.unlink(entry, dir_fd=descriptor)
            current = stat_at(quarantine)
            if current and (current.st_dev, current.st_ino) == (info.st_dev, info.st_ino):
                os.rmdir(quarantine, dir_fd=parent)
                os.fsync(parent)
            elif current:
                return False
        finally:
            os.close(descriptor)
        return True

    def scratch_measurement(self, directory, state):
        """One ten-second metadata budget and one reservation floor per walk."""
        reservation = state.get('scratch_bytes', self.options['QA_WALK_SCRATCH_BYTES'])
        deadline = time.monotonic() + evidence['SCRATCH_SECONDS']
        counted, failures = 0, []

        def measure(path):
            nonlocal counted
            try:
                result = evidence['directory_bytes'](path, deadline=deadline)
                need(isinstance(result, dict) and type(result.get('bytes')) is int
                     and result['bytes'] >= 0 and type(result.get('complete')) is bool
                     and type(result.get('missing')) is bool, 'invalid scratch measurement', 4)
                counted += result['bytes']
                return result
            except Exception as error:
                return dict(bytes=0, complete=False, missing=False, reason=type(error).__name__)

        normal = measure(directory)
        saved, quarantine = {}, None
        try:
            try:
                saved = self.read_state(self.preservation_path(state))
            except FileNotFoundError:
                pass
            quarantine = saved.get('quarantine')
            need(quarantine is None or isinstance(quarantine, str) and re.fullmatch(
                 r'\.qa-prune-' + re.escape(state['walk']) + r'-[0-9a-f]{32}', quarantine),
                 'invalid scratch quarantine', 4)
        except Exception as error:
            failures.append(type(error).__name__)
            saved, quarantine = {}, None
        pending = measure(directory.parent / quarantine) if quarantine else None
        for result, alternate in ((normal, pending), (pending, normal)):
            if result is None or result['complete']:
                continue
            # A missing name is expected after a confirmed prune, or while the
            # other validated name still exists across the quarantine rename.
            if result['missing'] and (saved.get('pruned') or alternate is not None and not alternate['missing']):
                continue
            failures.append(result.get('reason') or 'incomplete')
        if not failures:
            return counted
        charge = max(reservation, counted)
        key = 'scratch measurement incomplete ' + state['walk']
        subject = 'qa: scratch size incomplete'
        body = (f'Walk {state["walk"]}: metadata size measurement incomplete (limit 10 seconds).\n'
                f'Counted {counted} bytes; charging {charge} bytes, at least the saved reservation.\n'
                'The watcher retries measurement on the next admission pass.\n')
        try:
            if self.director:
                self.notify_once(key, subject, body)
            else:
                # Manual admission has no director. Reserve the same receipt for
                # the watcher, whose retry uses its configured director address.
                path = self.directory / 'attention' / (hashlib.sha256(key.encode()).hexdigest() + '.json')
                no_links(self.workspace.tmp, path)
                try:
                    self.read_state(path)
                except FileNotFoundError:
                    receipt = dict(key=key, attempted=True, subject=subject, body=body,
                                   time=timestamp(), delivered=False)
                    replace(path, (json.dumps(receipt) + '\n').encode(), durable=True)
        except Exception as error:
            log(f'{state["walk"]}: scratch size notice pending ({type(error).__name__})')
        return charge

    def scratch_room(self, walks, resume=None):
        total = 0
        for directory, state in walks:
            active = state['stage'] not in ('ended', 'paused') or not state.get('released')
            if active:
                total += state.get('scratch_bytes', self.options['QA_WALK_SCRATCH_BYTES'])
            if (not active or state.get('pinned')) and (state['walk'] != resume or state.get('pinned')):
                total += self.scratch_measurement(directory, state)
        reserve = self.options['QA_WALK_SCRATCH_BYTES']
        defer(total + reserve <= self.options['QA_SCRATCH_BUDGET_BYTES'],
              f'scratch budget: {total} bytes used + {reserve} reserved exceeds '
              f'{self.options["QA_SCRATCH_BUDGET_BYTES"]} bytes')

    def check(self, options):
        log('checking')
        self.options = options
        self.stuck = self.stuck_addresses()
        self.alert_attempted = set()
        self.release_attempted = set()
        self.attention_attempted = set()
        try:
            self.retry_notices()
        except Exception:
            log('notice retries pending; cleanup continues')
        with self.walks_locked(wait=False) as walking:
            if not walking:
                # An orphan launcher can hold admission indefinitely. Read atomic
                # snapshots for alerts only: never save state or change custody.
                no_links(self.workspace.tmp, self.directory / 'walks')
                for directory, state in self.local_walks(strict=False):
                    try:
                        self.overdue_launch_notice(state, 'admission descriptor held (walks lock busy)')
                    except Exception as error:
                        why = str(error) if isinstance(error, Problem) else type(error).__name__
                        log(f'{state["walk"]}: overdue launch notice failed ({why}); keeping custody')
                return
            self.states.clear()
            self.classes.clear()
            walks = self.local_walks(strict=False)
            self.give_strays(walks, sweep_walks=self.walks_valid)
            for directory, state in walks:
                try:
                    # Saved alert receipts retry even if the run becomes unknown.
                    if state.get('stage') not in ('ended', 'paused'):
                        self.alert(directory, state, None)
                        self.check_walk(directory, state)
                    else:
                        self.release_slot(directory, state)
                except Exception as error:
                    why = str(error) if isinstance(error, Problem) else type(error).__name__
                    log(f'{state["walk"]}: cleanup failed ({why}); keeping logins and scratch')
            try:
                self.repair_slot_claims(walks)
            except Exception:
                log('slot claim repairs pending; preservation continues')
            try:
                self.check_queue()
            except Exception:
                log('queued admission pending; preservation continues')
        # Every walk gets custody cleanup before any bounded scan or publisher.
        for directory, state in walks:
            if not state.get('end_logged') or not state.get('decision'):
                continue
            try:
                with self.evidence_locked() as descriptor:
                    saved = None
                    paused = state['decision'] == 'walk-pause'
                    if not paused:
                        try:
                            saved = self.prepare_evidence(directory, state)
                        except Exception:
                            log(f'{state["walk"]}: evidence preparation pending; cleanup complete')
                    state = self.finish_walk(directory, state, saved)
                    if saved is not None and not paused:
                        self.preserve_walk(directory, state, descriptor, saved)
            except Exception:
                log(f'{state["walk"]}: preservation pending; scratch retained')



def check_alerts(state):
    alerts = state.get('alerts', {})
    need(isinstance(alerts, dict) and all(login in state.get('logins', {}) and isinstance(receipts, dict)
         and all(isinstance(address, str) and re.fullmatch(ADDRESS, address)
                 and type(sent) is bool for address, sent in receipts.items())
         for login, receipts in alerts.items()), 'invalid alerts', 4)


def walk_attempt(state):
    need(isinstance(state, dict), 'invalid walk attempt', 4)
    need('holder' not in state or isinstance(state['holder'], str)
         and re.fullmatch(r'walk/[a-z0-9][a-z0-9/_-]*', state['holder']), 'invalid attempt holder', 4)
    need(not state['run'] or re.fullmatch(r'[a-zA-Z0-9_-]+', state['run']), f'attempt: invalid run', 4)
    need(state['stage'] in ('reserving', 'starting', 'running', 'ending', 'cancelled', 'ended', 'paused')
         and type(state['cap']) is int and state['cap'] >= 1
         and (state['slot'] is None or type(state['slot']) is int and state['slot'] >= 1),
         f'attempt: invalid progress', 4)
    need(all(isinstance(state[key], dict) for key in ('logins', 'kinds', 'pools'))
         and isinstance(state['given'], list) and isinstance(state['requests'], list)
         and all(isinstance(login, str) and re.fullmatch(LOGIN, login)
                 and isinstance(path, str) and Path(path).is_absolute()
                 for login, path in state['logins'].items())
         and set(state['kinds']) == set(state['logins'])
         and all(kind in ('moved', 'in-place') for kind in state['kinds'].values())
         and all(isinstance(login, str) and login in state['logins'] for login in state['given'])
         and all(isinstance(pool, str) and re.fullmatch(LOGIN, pool) and pool_of(pool) == pool
                 for pool in state['requests'])
         and all(pool in state['requests'] and isinstance(login, str) and login in state['logins']
                 and pool_of(login) == pool for pool, login in state['pools'].items())
         and set(state['pools'].values()) == set(state['logins']), f'attempt: invalid custody', 4)
    need(all(type(state[key]) is bool for key in ('released', 'start_logged', 'end_logged', 'posted')),
         'invalid attempt progress', 4)
    claim = state.get('slot_claim')
    if claim is not None:
        need(isinstance(claim, dict) and {'host', 'owner', 'ssh', 'what', 'released'} <= set(claim)
             and set(claim) <= {'host', 'slot', 'owner', 'ssh', 'what', 'released', 'release_status', 'release_result'}
             and isinstance(claim['host'], str) and re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9-]*', claim['host'])
             and isinstance(claim['owner'], str) and re.fullmatch(r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*', claim['owner'])
             and isinstance(claim['ssh'], str) and (not claim['ssh'] or re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_.@-]*', claim['ssh']))
             and isinstance(claim['what'], str) and re.fullmatch(CLAIM_WHAT, claim['what'])
             and type(claim['released']) is bool and state['slot'] is not None,
             'invalid saved slot claim', 4)
        need('slot' not in claim or type(claim['slot']) is int and claim['slot'] == state['slot'],
             'invalid saved claim slot', 4)
        need(claim.get('release_status') in (None, 'held', 'released', 'release unconfirmed')
             and ('release_result' not in claim or isinstance(claim['release_result'], str))
             and (claim.get('release_status') is None or (claim['release_status'] == 'released') == claim['released'])
             and (claim.get('release_status') != 'release unconfirmed' or not claim['released']
                  and 'release_result' in claim), 'invalid saved release result', 4)
    if 'checkout' in state:
        checkout = state['checkout']
        need(isinstance(checkout, dict) and set(checkout) == {'main', 'sequence'}
             and isinstance(checkout['main'], str) and re.fullmatch(SHA, checkout['main'])
             and checkout['main'] == state['main'] and state['slot'] is not None
             and type(checkout['sequence']) is int and checkout['sequence'] >= 1,
             'invalid saved checkout', 4)
    need('launch_complete' not in state or type(state['launch_complete']) is bool,
         'invalid saved launch completion', 4)
    check_alerts(state)
    recorded = state.get('run_recorded', [])
    need(isinstance(recorded, list) and all(isinstance(name, str) and name in state['logins'] for name in recorded)
         and len(recorded) == len(set(recorded)), 'invalid run binding progress', 4)
    need('queue_id' not in state or isinstance(state['queue_id'], str)
         and re.fullmatch(r'[0-9a-f]{32}', state['queue_id']), 'invalid admission ID', 4)
    if 'report_attempt' in state:
        need(type(state['report_attempt']) is int and 1 <= state['report_attempt'] <= state.get('attempt', 1),
             'invalid report attempt', 4)
    if 'resume_run' in state:
        need(isinstance(state['resume_run'], str) and re.fullmatch(r'[a-zA-Z0-9_-]+', state['resume_run']),
             'invalid earlier run', 4)
    need(state.get('decision') in (None, 'walk-pause', 'walk-end'), 'invalid end decision', 4)
    if state.get('decision') == 'walk-pause' or state.get('attempt', 1) > 1:
        need(isinstance(state['pause_line'], str) and 0 < len(state['pause_line']) <= 200
             and not any(ord(c) < 32 or 0x7f <= ord(c) < 0xa0 or c in '\u2028\u2029' for c in state['pause_line']),
             'invalid paused line', 4)
    utc(state['started'])


def pause_line(directory):
    path = directory / 'paused'
    try:
        with reading(path, 'r') as source:
            line = source.readline(202).removesuffix('\n')
            if not line or len(line) > 200 or any(
                    ord(c) < 32 or 0x7f <= ord(c) < 0xa0 or c in '\u2028\u2029' for c in line):
                return None
            return line
    except FileNotFoundError:
        return None
    except (OSError, UnicodeError, Problem) as error:
        log(f'{path}: cannot read pause marker ({error})')
        return None


def take(args, workspace):
    options = settings(workspace)
    kinds = options['QA_WALK_KINDS']
    need(args.kind in kinds, 'unknown walk kind: ' + args.kind)
    need(re.fullmatch('walk/' + args.kind + r'/[a-z0-9][a-z0-9-]*', args.holder),
         'holder must be walk/' + args.kind + '/WHAT')
    pool = args.login if args.login is not None else kinds[args.kind]['pools'][0]
    need(pool in kinds[args.kind]['pools'], 'login is not a pool of kind ' + args.kind)
    service = Watch(workspace, '')
    service.options = options
    with service.walks_locked():
        name = args.holder.rsplit('/', 1)[-1]
        service.admission_ready(service.local_walks())
        saved = service.directory / 'walks' / (name + '.json')
        need(not saved.exists() and not saved.is_symlink(), 'holder name already belongs to a saved walk: ' + name, 1)
        service.walk_room([pool], args.kind)
        result = service.take_login(pool, args.holder, args.note)
        need(result.returncode == 0, 'the caps are broken: ' + (result.stderr.strip() or result.stdout.strip()
             or f'cannot take {pool}'), 1)
        sys.stdout.write(result.stdout)
    return 0


def give(args, workspace):
    need(re.fullmatch(LOGIN, args.name), 'invalid login name')
    need(re.fullmatch(r'walk/[a-z][a-z0-9]*/[a-z0-9][a-z0-9-]*', args.holder),
         'holder must be walk/KIND/WHAT')
    service = Watch(workspace, '')
    # Share admission's lock through the give: a concurrent start cannot claim
    # a hand holder or name between the custody check and the release.
    try:
        with service.walks_locked():
            walks = service.local_walks()
            for state in [*(state for _, state in walks), *service.legacy_walks]:
                holders = {state['holder']}
                if state.get('kind'):
                    holders.add('walk/' + state['kind'] + '/' + state['walk'])
                claimed = set()
                for attempt in [state, *state.get('attempts', [])]:
                    if attempt.get('holder'):
                        holders.add(attempt['holder'])
                    claimed.update(attempt.get('logins', {}))
                need(args.holder not in holders and args.name not in claimed,
                     'saved walk custody is released only by service cleanup')
            result = service.call('logins', 'give', args.name, '--as', args.holder)
    except (Problem, OSError, ValueError, RecursionError, KeyError, TypeError, AttributeError) as error:
        raise Problem(f'{error}; keeping custody') from None
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    return result.returncode


def queue(args, workspace):
    service = Watch(workspace, '')
    with service.walks_locked():
        entries = service.queue_entries()
        if args.queue_action == 'cancel':
            need(any(e['id'] == args.id for e in entries), 'unknown queue ID: ' + args.id)
            service.drop_queue(args.id)
            print('cancelled ' + args.id)
        elif args.json_output:
            print(json.dumps([{key: entry[key] or None if key == 'reason' else entry[key]
                               for key in ('id', 'kind', 'rung', 'resume', 'after', 'since', 'reason')}
                              for entry in entries]))
        else:
            print('id\tkind\trung\tresume\tafter\tsince\tlast reason')
            for entry in entries:
                print('\t'.join(str(entry[key] or '-') if key != 'after' else ','.join(entry[key]) or '-'
                                for key in ('id', 'kind', 'rung', 'resume', 'after', 'since', 'reason')))
    return 0


def walk(args, workspace):
    args.after = getattr(args, 'after', [])
    service = Watch(workspace, '')
    try:
        return start_walk(args, workspace, service)
    except Deferred as error:
        with service.walks_locked():
            return service.enqueue(args, error)


def start_walk(args, workspace, service=None, entry=None):
    starter = entry['starter'].rsplit('@', 1)[0] if entry else os.environ.get('POST_NAME', '')
    need(re.fullmatch(r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*', starter),
         'POST_NAME must be set to a valid starter name')
    need(re.fullmatch(r'[a-z0-9][a-z0-9-]*', args.rung), 'invalid rung name')
    need(args.cap is None or args.cap >= 1, '--cap must be at least 1')
    need(args.resume is None or re.fullmatch(r'rung-[a-z0-9][a-z0-9-]*-[1-9][0-9]*', args.resume)
         and (args.build is not None or args.after) and not args.login and args.kind is None,
         '--resume needs a walk NAME and --build or --after, without --login or --kind')
    need(all(re.fullmatch(LOGIN, pool) and pool_of(pool) == pool for pool in args.login), 'invalid login pool')
    need(len(set(args.login)) == len(args.login), 'repeated login pool')
    need(all(re.fullmatch(r'[0-9a-fA-F]{4,40}', c) for c in args.after), 'invalid --after commit')
    workspace.origin(args.repo)
    options = settings(workspace)
    service = service or Watch(workspace, '')
    service.options = options
    ref = args.build if args.build is not None else 'main'
    main = ''
    with nullcontext() if service.walk_lock is not None else service.walks_locked():
        focused = workspace.tmp / 'qa-focused'
        no_links(workspace.tmp, focused)
        focused.mkdir(mode=0o700, parents=True, exist_ok=True)
        walks = service.local_walks()
        service.queue_entries()
        service.admission_ready(walks)
        kinds = options['QA_WALK_KINDS']
        need(not any('kind' not in state and not state.get('released') for _, state in walks),
             'pre-kind walks still hold slots; drain them before starting a kind', 1)
        if args.resume is not None:
            name = args.resume
            match = next(((path, state) for path, state in walks if state['walk'] == name), None)
            need(match and match[1]['repo'] == args.repo and match[1]['rung'] == args.rung,
                 'resume needs a saved walk of this repository and rung')
            directory, state = match
            need(state['stage'] == 'paused' and state.get('released') and state.get('end_logged')
                 and state.get('posted') and not service.outstanding(state), 'walk pause is not complete')
            kind = state.get('kind', next(iter(kinds)))
            need(not entry or (kind == entry['kind'] and state['requests'] == entry['login']),
                 'queued resume kind or pools changed')
            need(kind in kinds and set(state['requests']) <= set(kinds[kind]['pools']),
                 'saved walk kind or pools are no longer configured')
            args.queue_kind, args.queue_login = kind, state['requests']
            args.queue_starter = entry['starter'] if entry else starter + '@' + workspace.machine()
            defer(not state.get('slot_claim') or state['slot_claim']['released'], 'slot claim release is still pending')
            state['kind'] = kind
            need(kinds[kind]['numbers'], f'no walk slots configured for kind {kind}', 1)
            service.scratch_room(walks, name)
            service.walk_room(state['requests'], kind)
            service.claims(walks)
            saved_slot = next((a['slot'] for a in [state, *reversed(state.get('attempts', []))]
                               if type(a.get('slot')) is int), None)
            need(saved_slot is not None, 'paused walk has no saved slot')
            number = service.free_slot(walks, kind, preferred=saved_slot)
            if args.after:
                service.dependencies(service.repositories.fetch(args.repo, number), args.after)
            service.save(directory, state)
            previous_run = next((a['run'] for a in reversed(state['attempts']) if a.get('run')), '')
            need(previous_run, 'paused walk has no earlier run')
            state.update(attempt=state['attempt'] + 1, ref=ref, main=main, cap=args.cap or state['cap'],
                         started=timestamp(), slot=None, logins={}, kinds={}, pools={}, given=[],
                         requests=state['requests'], run='', holder='walk/' + kind + '/' + name,
                         stage='reserving', released=False, start_logged=False, end_logged=False,
                         posted=False, capped=False, resume_run=previous_run, alerts={}, run_recorded=[])
            state.pop('decision', None)
            state.pop('slot_claim', None)
            state.pop('checkout', None)
            state.pop('launch_complete', None)
        else:
            kind = args.kind if args.kind is not None else next(iter(kinds))
            need(kind in kinds, 'unknown walk kind: ' + kind)
            requests = sorted(args.login or kinds[kind]['pools'])
            need(set(requests) <= set(kinds[kind]['pools']), 'login is not a pool of kind ' + kind)
            need(kinds[kind]['numbers'], f'no walk slots configured for kind {kind}', 1)
            args.queue_kind, args.queue_login = kind, requests
            args.queue_starter = entry['starter'] if entry else starter + '@' + workspace.machine()
            service.scratch_room(walks)
            holders = service.walk_room(requests, kind)
            service.claims(walks)
            slot_number = service.free_slot(walks, kind)
            if args.after:
                service.dependencies(service.repositories.fetch(args.repo, slot_number), args.after)
            prefix = 'rung-' + args.rung + '-' + ('' if kind == next(iter(kinds)) else kind + '-')
            numbering = [state for _, state in walks] + service.legacy_walks
            known = {state['walk'] for state in numbering}
            names = [state['walk'].rsplit('-', 1)[-1] for state in numbering
                     if state['rung'] == args.rung and state.get('kind', next(iter(kinds))) == kind]
            prefixes = {prefix, f'rung-{args.rung}-{kind}-', f'rung-{args.rung}-'}
            names += [path.name[len(candidate):] for path in focused.iterdir()
                      for candidate in prefixes if path.name not in known and path.name.startswith(candidate)]
            numbers = [int(number) for number in names if re.fullmatch(r'[1-9][0-9]*', number)]
            number = max(numbers, default=0) + 1
            while ((focused / (prefix + str(number))).exists()
                   or (service.directory / 'walks' / (prefix + str(number) + '.json')).exists()
                   or 'walk/' + kind + '/' + prefix + str(number) in holders.values()):
                number += 1
            name = prefix + str(number)
            directory = focused / name
            directory.mkdir(mode=0o700)
            with evidence['opened_directory'](directory) as descriptor:
                identity = os.fstat(descriptor)
            state = dict(scratch_identity=dict(device=identity.st_dev, inode=identity.st_ino), walk=name, repo=args.repo, rung=args.rung, kind=kind,
                         clock_walk=name[len('rung-' + args.rung + '-'):], ref=ref, main=main,
                         starter=args.queue_starter, cap=args.cap or 180, started=timestamp(),
                         slot=None, holder='walk/' + kind + '/' + name, logins={}, kinds={}, pools={}, run='',
                         stage='reserving', requests=requests, given=[], released=False, run_recorded=[],
                         start_logged=False, end_logged=False, posted=False, report_attempt=1)
        state['scratch_bytes'] = options['QA_WALK_SCRATCH_BYTES']
        if entry:
            state['queue_id'] = entry['id']
        else:
            state.pop('queue_id', None)
        service.classes[directory] = 'walk'
        service.save(directory, state)
        taking = False
        try:
            claim = dict(host=options['QA_SLOT_HOST'], owner=options['QA_CLAIM_OWNER'],
                         ssh=options['QA_CLAIM_SSH'],
                         what=f'qa walk {name} attempt {state.get("attempt", 1)} claim {secrets.token_hex(16)}',
                         released=False)
            number = number if args.resume else slot_number
            try:
                claimed = service.slot_call(claim, 'claim', claim['host'], number, claim['owner'], claim['what'])
                expected = f"{claim['host']}-{number} claimed by {claim['owner']}: {claim['what']}"
                if claimed.returncode == 1:
                    listing = service.slot_call(claim, 'list')
                    rows = [r for r in listing.stdout.splitlines()
                            if r.startswith(f'{claim["host"]} {number} [')]
                    if (listing.returncode == 0 and len(rows) == 1
                            and not any(claim['what'] in row for row in rows)
                            and re.fullmatch(re.escape(f'{claim["host"]} {number} [')
                                             + r'[^]\r\n]+\]: [^\r\n]+ \(since [^()]+\); held .+', rows[0])):
                        raise Deferred(f'walk slot {claim["host"]} {number} is busy', 1)
                need(claimed.returncode == 0 and claimed.stdout.strip() == expected,
                     f'claim claim {claim["host"]} {number}: exit {claimed.returncode}: '
                     + (claimed.stderr.strip() or claimed.stdout.strip() or 'unreadable or empty result'), 1)
            except (OSError, UnicodeError, AttributeError, TypeError) as error:
                raise Problem(f'claim claim {claim["host"]} {number}: {type(error).__name__}: {error}', 4) from None
            claim.update(slot=number, release_status='held')
            state.update(slot=number, slot_claim=claim)
            service.save(directory, state)
            checkout = service.repositories.fetch(args.repo, state['slot'])
            previous, sequence = service.last_checkout(state)
            service.repositories.protect_head(checkout, previous)
            service.dependencies(checkout, args.after)
            state['main'] = service.repositories.build(checkout, ref)
            service.save(directory, state)
            service.repositories.checkout(checkout, state['main'])
            state['checkout'] = dict(main=state['main'], sequence=sequence + 1)
            service.save(directory, state)
            try:
                trimmed = command(['python3', '-I', '-B', checkout / 'tools/slots/trim', checkout], timeout=300)
                trim_log = trimmed.stdout + trimmed.stderr + f'trim exit {trimmed.returncode}\n'
            except OSError as error:
                trim_log = f'trim failed: {error}\n'
            replace(directory / f'prepare-{state.get("attempt", 1)}.log', trim_log.encode())
            disk = command(['df', '-B1', '--output=avail', '/'], timeout=30)
            available = disk.stdout.split()
            need(disk.returncode == 0 and len(available) == 2 and available[1].isdigit()
                 and int(available[1]) >= 80000000000, 'slot refused: root disk needs at least 80000000000 bytes available', 4)
            try:
                fetched = command(['cargo', 'fetch', '--locked'], cwd=checkout, timeout=300)
            except OSError as error:
                raise Problem(f'cannot fetch build {ref}: {error}', 4) from None
            need(fetched.returncode == 0,
                 f'cannot fetch build {ref}: ' + (fetched.stderr.strip() or fetched.stdout.strip()
                                                or f'cargo fetch exited {fetched.returncode}'), 4)
            taking = True
            for pool in state['requests']:
                service.walk_room([pool], kind)
                taken = service.take_login(pool, state['holder'], directory, state.get('run'))
                if taken.returncode == 1:
                    raise Deferred(f'login pool {pool} is busy: ' + taken.stderr.strip(), 1)
                need(taken.returncode == 0, 'the caps are broken: ' + (taken.stderr.strip() or taken.stdout.strip()
                     or f'cannot take {pool}'), 1)
                login, sep, path = taken.stdout.strip().partition(' ')
                need(sep and re.fullmatch(LOGIN, login) and pool_of(login) == pool and Path(path).is_absolute(),
                     f'{name}: invalid login grant', 4)
                state['pools'][pool] = login
                state['logins'][login] = path
                try:
                    mode = os.lstat(path).st_mode
                except FileNotFoundError:
                    mode = 0
                state['kinds'][login] = 'in-place' if stat.S_ISDIR(mode) else 'moved'
                service.save(directory, state)
            if args.resume is not None:
                report = directory / 'report.md'
                no_links(workspace.tmp, report)
                if report.exists():
                    need(stat.S_ISREG(report.stat().st_mode) and report.stat().st_nlink == 1, 'invalid earlier report', 1)
                    earlier = directory / f'report-{state.get("report_attempt", 1)}.md'
                    need(not earlier.exists() and not earlier.is_symlink(), 'earlier report already exists', 1)
                    report.rename(earlier)
                state['report_attempt'] = state['attempt']
                service.save(directory, state)
                (directory / 'paused').unlink(missing_ok=True)
                # The earlier exporter names grants that may now belong to another walk.
                (directory / 'give-back').unlink(missing_ok=True)
                no_links(workspace.tmp, directory / 'brief.md')
                with reading(directory / 'brief.md'):
                    pass
            else:
                brief = focused / ('rung-' + args.rung + '-' + kind + '-brief.md')
                no_links(workspace.tmp, brief)
                if not brief.exists():
                    brief = focused / ('rung-' + args.rung + '-brief.md')
                no_links(workspace.tmp, brief)
                need(brief.is_file(), f'rung brief missing: {brief}', 1)
                replace(directory / 'brief.md', read_bytes(brief))
            task = (f'Read {directory}/brief.md first.\n\nWalk {name} on {args.repo}, rung {args.rung}.\n'
                    f'Directory: {directory}\nCheckout: {checkout}\n'
                    f'Build: {state["ref"]}, commit {state["main"]}\n'
                    f'Cap: {state["cap"]} minutes. Report: {directory}/report.md\n\nHeld logins:\n')
            task += ''.join(f'- {login} (pool {pool}): {state["logins"][login]} ({state["kinds"][login]})\n'
                            for pool, login in state['pools'].items()) or 'None.\n'
            task += ('\nBuild only in this slot: HEAVY_CLASS=background heavy cargo build --locked --offline -p temper.\n'
                     'Never use --release or --target-dir, never clean the target, and touch nothing else in the checkout.\n'
                     'Before each heavy command run df -B1 --output=avail / and require at least 80000000000 bytes.\n'
                     'Below that floor, wait 5 minutes and check again until enough space is available.\n'
                     'Captures must exclude credentials and sign-in links. Mask values with [masked], retaining diagnostic lines.\n'
                     'Keep the deployed box in the walk directory with its own binary, independent of the slot.\n')
            task += (f'\nMove file logins into deployments as the binding says; directory logins are used in place.\n'
                     f'At once after moving a login, write {directory}/give-back: an executable\n'
                     'that exports each moved login back to its resting path, every program named by\n'
                     'its absolute path (it runs outside your shell). Never take give-back.lock in your helper: the stop wrapper holds it.\n'
                     'If the helper needs its own lock, use a different lock name. Run it before the deployment\n'
                     'stops; check by stat alone (a non-empty regular file, 0600). Your session and\n'
                     'deployment stops run the same file under one lock. Never run logins, never\n'
                     'read or copy a login. Stop using directory logins before their units stop.\n'
                     f'For every deployment use: qa deploy {directory} NAME -- COMMAND...\n')
            task += (f'\nTo pause at a blocking finding: write the finding in your report and {directory}/notes.md,\n'
                     f'and the step you stopped at in {directory}/paused (one line, at most 200 characters, no controls).\n'
                     'Give each moved login back through give-back and check it by stat: give back before you break it.\n'
                     'Then stop the deployments, keeping their data directories and saved commands, and end your session.\n'
                     'A branch resume confirms a fix; the walk that counts must finish on main at the landed commit.\n')
            if args.resume is not None:
                reports = sorted(path.name for path in directory.glob('report-*.md')
                                 if re.fullmatch(r'report-[1-9][0-9]*\.md', path.name))
                task += (f'\nResume from: {state["pause_line"]}\n'
                         f'Read {directory}/notes.md and the earlier reports: {", ".join(reports)}.\n'
                         'Carry their findings into the new report. Import each login again from its new resting path,\n'
                         'and write a new give-back file for these grants before moving them.\n'
                         'Keep each deployment directory and restart through qa deploy on its own data.\n'
                         'Use this checkout’s REF binary in place of any earlier slot executable; check the binding’s\n'
                         'configuration before starting. If a kept store will not open (a fix moved a stored family),\n'
                         'say so in the report and walk again from the first step on a fresh deployment in this directory.\n'
                         'Saved deployment commands and directories:\n')
                task += ''.join(f'- {directory}/{d["name"]}: {shlex.join(d["argv"])}\n'
                                f'  qa deploy {directory} {d["name"]} -- {shlex.join(d["argv"])}\n'
                                for d in state.get('deployments', []))
            replace(directory / 'task.md', task.encode())
            service.walk_event(directory, state, 'walk-resume' if args.resume is not None else 'walk-start', ', '.join(state['logins']) + ' ' + state['main'][:9])
            script = stop_path(Path(__file__).resolve())
            stop_path(directory)
            on_stop = '#!/bin/sh\nexec ' + ' '.join(shlex.quote(str(word)) for word in
                       (script, '_give-back', directory, options['QA_STOP_SECONDS'])) + '\n'
            replace(directory / 'on-stop', on_stop.encode(), 0o700)
            state.update(stage='starting', started=timestamp(), launch_complete=False)
            service.save(directory, state)
            launch = ['task', '--to', 'qa-watch', '--on-stop', directory / 'on-stop',
                      directory / 'task.md', checkout, directory / 'report.md']
            if args.resume is not None:
                launch[1:1] = ['--resume', state['resume_run']]
            launched = service.call('codex-run', *launch)
            if args.resume is not None and launched.returncode not in (0, 124) and any(
                    reason in launched.stderr + launched.stdout
                    for reason in ('resume run has no thread', 'resume run has no meta')):
                launched = service.call('codex-run', *[launch[0], *launch[3:]])
            if launched.returncode == 124:
                log(f'{name}: launch timed out; keeping custody for run recovery')
                return 1
            state['launch_complete'] = launched.returncode != 0
            service.save(directory, state)
            words = launched.stdout.split()
            need(launched.returncode == 0 and words and re.fullmatch(r'[a-zA-Z0-9_-]+', words[0]),
                 launched.stderr.strip() or 'codex-run refused launch', 1)
            state.update(run=words[0], stage='running')
            service.save(directory, state)
            service.record_run(directory, state)
        except (Problem, OSError, ValueError, UnicodeError):
            if state['stage'] == 'starting':
                service.recover_run(directory, state)
            if not state['run']:
                service.cancel_walk(directory, state, drop=taking)
            raise
        print('walk ' + name)
        for login, path in state['logins'].items():
            print(login, path)
        print('run ' + state['run'])
    return 0


def preserve_command(args, workspace):
    if args.command == 'keep' and args.check:
        need(args.name is None, 'keep --check needs only DIRECTORY')
        try:
            files, _ = evidence['snapshot'](Path(args.check), {}, settings(workspace)['QA_EVIDENCE_KIB'] * 1024)
        except evidence['Refusal'] as error:
            raise Problem(str(error)) from None
        print(f'clean: {len(files)} files, {sum(map(len, files.values()))} bytes')
        return 0
    need(args.name and re.fullmatch(r'rung-[a-z0-9][a-z0-9-]*-[1-9][0-9]*', args.name), 'invalid walk name')
    service = Watch(workspace, '')
    service.options = settings(workspace)
    with service.walks_locked():
        match = next(((d, s) for d, s in service.local_walks() if s['walk'] == args.name), None)
        need(match, 'unknown managed walk')
        directory, state = match
        if args.command in ('pin', 'unpin'):
            state['pinned'] = args.command == 'pin'
            service.save(directory, state)
            print(args.command + ' ' + args.name)
            return 0
        need(state['stage'] == 'ended' and state.get('released'), 'keep requires an ended walk')
    with service.evidence_locked() as descriptor:
        saved = service.prepare_evidence(directory, state)
        need(saved['status'] != 'refused', saved.get('refusal', 'evidence refused'))
        if saved['status'] == 'waiting':
            saved['commit'] = service.publish_evidence(state, saved, descriptor)
            saved['status'] = 'kept'
            service.save_preservation(state, saved)
        print(service.evidence_status(saved))
    return 0


def watch(director, once, workspace):
    os.environ['POST_NAME'] = 'qa-watch'
    # Check assignment before creating state or locks.
    need(workspace.fixture or (Path.home() / '.config/agents-qa/director').is_file(),
         "this is not the service's machine (no ~/.config/agents-qa/director)")
    need(re.fullmatch(r'[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*@[a-z][a-z0-9-]*', director),
         'invalid director address: expected NAME@MACHINE')
    service = Watch(workspace, director)
    no_links(workspace.tmp, service.directory)
    service.directory.mkdir(parents=True, exist_ok=True)
    with (service.directory / 'watch.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Problem('another service runs') from None
        service.watch_lock = lock.fileno()
        while True:
            options = settings(workspace, cleanup=True)
            service.check(options)
            if once:
                return 0
            interval = options['QA_INTERVAL_SECONDS']
            waited = service.call('post', 'wait', 'qa-watch', '--timeout', str(interval), '--holder', str(os.getpid()), '--kind', 'codex')
            if waited.returncode == 0:
                read = service.call('post', 'read', 'qa-watch')
                log(read.stdout)
                if read.returncode:
                    log('post read failed: ' + read.stderr.strip())
            elif waited.returncode == 4:
                log('another waiter took qa-watch')
                return 2
            elif waited.returncode != 1:
                log('post wait failed: ' + (waited.stderr.strip() or waited.stdout.strip()))
                time.sleep(interval)


def main():
    if sys.argv[1:2] == ['_give-back']:
        return give_back(sys.argv[2:])
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    deployment = sub.add_parser('deploy')
    deployment.add_argument('directory')
    deployment.add_argument('name')
    deployment.add_argument('argv', nargs=argparse.REMAINDER)
    walking = sub.add_parser('walk')
    walking.add_argument('repo')
    walking.add_argument('rung')
    walking.add_argument('--build')
    walking.add_argument('--after', action='append', default=[])
    walking.add_argument('--resume')
    walking.add_argument('--kind')
    walking.add_argument('--login', action='append', default=[])
    walking.add_argument('--cap', type=int)
    keeping = sub.add_parser('keep')
    keeping.add_argument('name', nargs='?')
    keeping.add_argument('--check', metavar='DIRECTORY')
    for verb in ('pin', 'unpin'):
        pinning = sub.add_parser(verb)
        pinning.add_argument('name')
    queued = sub.add_parser('queue')
    queued.add_argument('--json', action='store_true', dest='json_output')
    queue_actions = queued.add_subparsers(dest='queue_action')
    cancelling = queue_actions.add_parser('cancel')
    cancelling.add_argument('id')
    taking = sub.add_parser('take')
    taking.add_argument('kind')
    taking.add_argument('--login')
    taking.add_argument('--as', dest='holder', required=True)
    taking.add_argument('--note')
    giving = sub.add_parser('give')
    giving.add_argument('name')
    giving.add_argument('--as', dest='holder', required=True)
    service = sub.add_parser('watch')
    service.add_argument('--director', required=True)
    service.add_argument('--once', action='store_true')
    args = parser.parse_args()
    try:
        workspace = Workspace()
        if args.command in ('keep', 'pin', 'unpin'):
            return preserve_command(args, workspace)
        if args.command == 'take':
            return take(args, workspace)
        if args.command == 'give':
            return give(args, workspace)
        if args.command == 'deploy':
            need('--' in sys.argv[2:] and sys.argv[2:].index('--') == 2, 'deploy needs DIRECTORY NAME -- COMMAND...')
            return deploy(args, workspace)
        if args.command == 'queue':
            return queue(args, workspace)
        if args.command == 'walk':
            return walk(args, workspace)
        if args.command == 'watch':
            return watch(args.director, args.once, workspace)
    except Problem as error:
        print(f'qa: {error}', file=sys.stderr)
        return error.code
    except (OSError, ValueError, UnicodeError) as error:
        print(f'qa: {error}', file=sys.stderr)
        return 4


if __name__ == '__main__':
    sys.exit(main())
