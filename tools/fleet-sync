source,entries,tree=json.loads(sys.argv[1])
home=os.open(Path.home(),os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
def open_parent(path):
    parts=path.split("/")
    fd=os.dup(home)
    try:
        for part in parts[:-1]:
            child=os.open(part,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd)
            os.close(fd)
            fd=child
        return fd,parts[-1]
    except BaseException:
        os.close(fd)
        raise
with tarfile.open(fileobj=sys.stdout.buffer,mode="w|") as archive:
    for path,row in entries.items():
        relative=source if not tree or path=="." else source+"/"+path
        directory,leaf=open_parent(relative)
        try:
            info=os.stat(leaf,dir_fd=directory,follow_symlinks=False)
            kind="file" if stat.S_ISREG(info.st_mode) else "dir" if stat.S_ISDIR(info.st_mode) else "link" if stat.S_ISLNK(info.st_mode) else "invalid"
            if kind!=row["type"]: raise ValueError("peer artifact type changed: "+path)
            item=tarfile.TarInfo(path)
            item.mode=stat.S_IMODE(info.st_mode)
            if kind=="file":
                fd=os.open(leaf,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=directory)
                with os.fdopen(fd,"rb") as stream:
