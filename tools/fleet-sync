                    if not stat.S_ISREG(opened.st_mode): raise ValueError("not a regular seed file")
                    item.size=opened.st_size
                    item.mode=stat.S_IMODE(opened.st_mode)
                    archive.addfile(item,stream)
            elif kind=="dir":
                item.type=tarfile.DIRTYPE
                archive.addfile(item)
            else:
                item.type=tarfile.SYMTYPE
                item.linkname=os.readlink(leaf,dir_fd=directory)
                archive.addfile(item)
        finally:
            os.close(directory)
os.close(home)
'''


