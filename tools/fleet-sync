class Declarations:
    def __init__(self, root, home):
        self.root = root
        fleet = root / "fleet"
        known = {"hosts.toml", "env", "claude/settings.json", "codex/config.toml",
                 "cargo/config.toml", "versions.toml", "repositories.toml", "units/roles.toml", "policy.toml"}
        parsed = {}
        for path in sorted(fleet.rglob("*")):
            if path.is_symlink():
                raise ValueError(f"symlink in fleet declarations: {path}")
            if not path.is_file():
                continue
            name = path.relative_to(fleet).as_posix()
            if name in FLEET_ASSETS:
                continue
            content = path.read_text()
            if name.endswith(".toml"):
                parsed[name] = tomllib.loads(content)
            elif name.endswith(".json"):
                parsed[name] = json.loads(content)
            elif name == "env" or (path.parent == fleet / "units" and path.suffix in (".service", ".timer")):
                parsed[name] = content
            else:
                raise ValueError(f"unknown fleet declaration: {name}")
        if not known <= parsed.keys():
            raise ValueError(f"missing declarations: {sorted(known - parsed.keys())}")
        self.hosts = parsed["hosts.toml"]["hosts"]
        hostnames = set()
        for name, host in self.hosts.items():
            if not re.fullmatch(r"[a-z][a-z0-9-]*", name):
                raise ValueError(f"invalid host name: {name}")
            if host["hostname"] in hostnames:
                raise ValueError("duplicate hostname")
            hostnames.add(host["hostname"])
            if not re.fullmatch(r"[a-zA-Z0-9_.@:-]+", host["ssh"]) or host["ssh"].startswith("-"):
                raise ValueError(f"invalid ssh address for {name}")
            if type(host.get("seed", False)) is not bool:
                raise ValueError(f"seed flag must be boolean for {name}")
            if not isinstance(host["roles"], list) or not all(isinstance(r, str) for r in host["roles"]):
                raise ValueError(f"invalid roles for {name}")
            for key, value in host["machine_env"].items():
                try:
                    if not KEY.fullmatch(key):
                        raise ValueError("invalid key")
                    if isinstance(value, str):
                        if not value:
                            raise ValueError("machine_env strings must be nonempty")
                        literal_env_value(value)
                    elif type(value) is not int or value < 0:
                        raise ValueError("expected a nonnegative integer or literal string")
                except ValueError as error:
                    raise ValueError(f"invalid machine_env for {name}: {key}: {error}") from error
            for key, value in host["env"].items():
                if not KEY.fullmatch(key) or key == "PATH":
                    raise ValueError(f"invalid env key: {key}")
                env_value(value, home)
            if "cargo_jobs" in host and (type(host["cargo_jobs"]) is not int or host["cargo_jobs"] < 1):
                raise ValueError(f"invalid cargo_jobs for {name}")
        self.env = {}
        for line in parsed["env"].splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            key, sep, value = line.partition("=")
            if not sep or not KEY.fullmatch(key) or key == "PATH" or key in self.env:
                raise ValueError(f"invalid fleet/env line: {line}")
            self.env[key] = env_value(value, home)
        self.file_policy = parsed["policy.toml"]["files"]
        for path, policy in self.file_policy.items():
            if Path(path).is_absolute() or ".." in Path(path).parts or policy not in ("check", "write"):
                raise ValueError(f"invalid file policy: {path} = {policy}")
        self.claude = parsed["claude/settings.json"]
        if not isinstance(self.claude, dict) or "env" in self.claude:
            raise ValueError("Claude settings must be an object without env")
        self.codex = parsed["codex/config.toml"]
        if not self.codex or any(not KEY.fullmatch(k) or not isinstance(v, str) for k, v in self.codex.items()):
            raise ValueError("Codex declarations must be top-level string keys")
        cargo = (fleet / "cargo/config.toml").read_text()
        if "$" in cargo.replace("$HOME", ""):
            raise ValueError("only $HOME expansion is allowed in Cargo config")
        self.cargo = cargo.replace("$HOME", str(home))
        tomllib.loads(self.cargo)
        self.versions = parsed["versions.toml"]
        for name, pin in self.versions.items():
            command = pin["command"]
            if not isinstance(pin["version"], str) or not isinstance(command, list) or not command or not all(isinstance(v, str) for v in command):
                raise ValueError(f"invalid version declaration: {name}")
            if command[0] in ("claude", "codex") and command != [command[0], "--version"]:
                raise ValueError("Claude and Codex may only run with --version")
            version_only = pin.get("version_only_hosts", [])
            if not isinstance(version_only, list) or any(host not in self.hosts for host in version_only):
                raise ValueError("invalid version-only host list")
            install = pin.get("install")
            if install is not None:
                validate_install(name, install, pin["version"])
                if any(host not in self.hosts or not self.hosts[host].get("seed", False) for host in install.get("seed_hosts", [])):
                    raise ValueError("seed host allowlist must name declared seed hosts")
                if install.get("seed") == "peer" and not install.get("disagreement"):
                    seed_entries(root, install)  # Fail malformed pins before any writes.
        self.agents_origin = parsed["repositories.toml"]["agents"]
        self.fabrig_origin = parsed["repositories.toml"]["fabrig"]
        for name, origin in (("agents", self.agents_origin), ("fabrig", self.fabrig_origin)):
            if not isinstance(origin, str) or not origin or origin.startswith("-"):
                raise ValueError(f"invalid {name} origin")
        self.unit_roles = parsed["units/roles.toml"]["units"]
        self.units = {Path(k).name: v for k, v in parsed.items() if k.startswith("units/") and k.endswith((".service", ".timer"))}
        if self.units.keys() != self.unit_roles.keys():
            raise ValueError("every unit must have exactly one roles declaration")
        for name in RECOVERY_UNITS:
            if self.unit_roles.get(name) != ["*"]:
                raise ValueError(f"{name} must belong to exactly [\"*\"]")
        self.start_once = set()
        for name, roles in self.unit_roles.items():
            if not isinstance(roles, list) or not roles or not all(isinstance(r, str) for r in roles):
                raise ValueError(f"invalid unit roles: {name}")
            text = self.units[name]
            if text.partition("\n")[0] == "# fleet-sync: start-once":
                if not name.endswith(".service") or not any(line.strip() == "[Install]" for line in text.splitlines()):
                    raise ValueError(f"start-once requires a service with [Install]: {name}")
                self.start_once.add(name)
            if "[Unit]" not in text or (name.endswith(".service") and "[Service]" not in text) or (name.endswith(".timer") and "[Timer]" not in text):
                raise ValueError(f"invalid unit: {name}")
        section, starts = "", []
        for line in self.units.get("fleet-sync.service", "").splitlines():
            line = line.strip()
            if line.startswith(("#", ";")):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1]
            key, _, value = line.partition("=")
            if key.strip() == "ExecStart":
                starts.append((section, value.strip()))
        if starts != [("Service", SERVICE_START.partition("=")[2])] or "*" not in self.unit_roles.get("fleet-sync.service", []):
            raise ValueError("fleet-sync.service must retain the fixed login-shell current/tools/fleet-sync --timer launcher")
        self.tools = {}
        for line in (root / "tools/installed").read_text().splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            fields = line.split()
            if len(fields) not in (1, 2):
                raise ValueError(f"invalid installed tool: {line}")
            name, path = fields[0], fields[-1]
            if (not TOOL_NAME.fullmatch(name) or name in self.tools
                    or Path(path).is_absolute() or ".." in Path(path).parts):
                raise ValueError(f"invalid installed tool: {line}")
            if any((directory / name).is_file() and os.access(directory / name, os.X_OK)
                   for directory in SYSTEM_TOOL_DIRS):
                raise ValueError(f"installed tool shadows system command: {name}")
            tool = root / "tools" / path
            if not tool.is_file() or not os.access(tool, os.X_OK) or not tool.resolve().is_relative_to(root.resolve()):
                raise ValueError(f"missing executable tool: {line}")
            self.tools[name] = path

    def host(self, name, allow_unknown=False):
        name = name or os.environ.get("FLEET_HOST")
        if name:
            if name not in self.hosts:
                raise ValueError(f"unknown host: {name}")
            return name
        for name, host in self.hosts.items():
            if host["hostname"] == socket.gethostname():
                return name
        if allow_unknown:
            return None
        raise ValueError(f"unknown hostname: {socket.gethostname()}")

    def host_units(self, name):
        wanted = {unit for unit, assigned in self.unit_roles.items()
                  if "*" in assigned or set(assigned) & set(self.hosts[name]["roles"])}
        if not RECOVERY_UNITS <= wanted or not RECOVERY_UNITS <= self.units.keys():
            raise ValueError("host rendering must retain both fleet-sync recovery units")
        return wanted


def atomic(path, data, mode=0o600):
    """All regular-file writes, including bookkeeping, use a sibling rename."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, sibling = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(data if isinstance(data, bytes) else data.encode())
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(sibling, path)
    finally:
        if os.path.lexists(sibling):
            os.unlink(sibling)


def atomic_link(path, target):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=f".{path.name}.", dir=path.parent) as directory:
        sibling = Path(directory) / "link"
        sibling.symlink_to(target)
        os.replace(sibling, path)


class Runner:
    def __init__(self, args, declarations, name, resume=None):
        self.args, self.d, self.name = args, declarations, name
        self.home = Path.home()
        self.safe = SafeHome(self.home)
        self.base = self.home / "src/fabrig"
        self.state_dir = self.home / ".local/state/fleet-sync"
        self.config = self.home / ".config/fleet-sync"
        startup_error = None
        try:
            self.old = self.safe.json(".local/state/fleet-sync/state.json", {})
            intent = self.safe.json(".local/state/fleet-sync/units.json", None)
        except (OSError, ValueError) as error:
            self.old, intent, startup_error = {}, None, str(error)
        self.state = resume or {"host": name, "agents_sha": self.old.get("agents_sha"), "fabrig_sha": self.old.get("fabrig_sha"),
                                "start": now(), "end": None, "items": [],
                                "last_timer_end": self.old.get("last_timer_end")}
        # Releases predating backoff can hand off a state without these fields.
        self.state.setdefault("consecutive_failures", self.old.get("consecutive_failures", 0))
        self.state.setdefault("last_failure", self.old.get("last_failure"))
        self.owned = set(self.old.get("managed_files", []))
        self.link_owned = set(self.old.get("managed_links", []))
        self.unit_owned = set(self.old.get("managed_units", []))
        self.start_once_started = set()
        self.reload_pending = self.old.get("unit_reload_pending", False)
        if intent is not None:
            self.unit_owned = set(intent["units"])
            self.start_once_started = set(intent.get("start_once_started", []))
            self.reload_pending = intent["reload_pending"]
        self.log = json.loads(os.environ.pop("FLEET_SYNC_LOG", "[]")) if resume else []
        self.lock_fd = None
        self.previewing = False
        self.kache_bootstrapped = False
        self.waiting = False
        if startup_error:
            self.item("state", "failed", startup_error)
        else:
            self.attempt("links:ownership", self.load_link_ownership)

    def item(self, name, result, reason):
        self.state["items"].append({"item": name, "result": result,
                                    "reason": " ".join(str(reason).split())[:600]})

    def git_ssh_command(self):
        inspecting = self.args.check or self.previewing or getattr(self.args, "preview", None) is not None
        relative = ".local/state/fleet-sync/ssh"
        control = str(self.home / relative)
        # OpenSSH expands %C to a 40-byte hex hash, not the remote's full name.
        if len(os.fsencode(control)) + 1 + 40 >= 100:
            raise ValueError("SSH control path must be under 100 bytes after %C expansion")
        try:
            with self.safe.parent(relative + "/.probe", create=not inspecting) as (directory, _):
                if stat.S_IMODE(os.fstat(directory).st_mode) != 0o700:
                    if inspecting:
                        raise ValueError("SSH control directory must be 0700")
                    os.fchmod(directory, 0o700)
        except FileNotFoundError:
            if not inspecting:
                raise
        # Quote both for the shell and ssh_config's option parser; HOME may contain spaces/%.
        control = control.replace("%", "%%").replace("\\", "\\\\").replace('"', '\\"') + "/%C"
        return shlex.join(["ssh", "-T", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes",
                           "-o", "UpdateHostKeys=no", "-o", "ConnectTimeout=5",
                           "-o", "ControlMaster=no" if inspecting else "ControlMaster=auto",
                           "-o", "ControlPersist=no" if inspecting else "ControlPersist=600",
                           "-o", f'ControlPath="{control}"'])

    def cmd(self, *argv, timeout=60, binary=False, extra_env=None, pass_fds=(), allowed=(0,), stdout=subprocess.PIPE):
        path = f"{self.home}/.local/bin:{self.home}/.cargo/bin:" + os.environ.get("PATH", "/usr/local/bin:/usr/bin:/bin")
        ssh = self.git_ssh_command()
        result = run_child(argv, timeout, pass_fds=pass_fds, stdout=stdout,
                                env={**os.environ, **self.environment(), "PATH": path,
                                                      "GIT_TERMINAL_PROMPT": "0",
                                                      "GIT_SSH_COMMAND": ssh,
                                                      "GIT_OPTIONAL_LOCKS": "0", "PYTHONDONTWRITEBYTECODE": "1", **(extra_env or {})})
        err = result.stderr.decode(errors="replace")
        out = result.stdout.decode(errors="replace") if not binary else "[binary output]"
        self.log.append(f"$ {shlex.join([str(v) for v in argv])}\n{out}{err}")
        if result.returncode not in allowed:
            raise CommandError(result.returncode, f"{Path(str(argv[0])).name} exited {result.returncode}: {(err or out).strip()[-600:]}")
        return result.stdout if binary else out.strip()

    def git(self, repo, *args):
        return self.cmd("git", "-C", repo, *args)

    def validate_clone(self, path, origin):
        self.safe.directory(str(path.relative_to(self.home)))
        if path.is_symlink():
            raise ValueError(f"refusing symlink clone: {path}")
        if Path(self.git(path, "rev-parse", "--show-toplevel")).resolve() != path.resolve():
            raise ValueError(f"not a dedicated clone: {path}")
        if self.git(path, "remote", "get-url", "origin") != origin:
            raise ValueError(f"foreign origin: {path}")
        if self.git(path, "status", "--porcelain", "--untracked-files=all"):
            raise ValueError(f"dirty clone: {path}")

    def source(self):
        metadata = read_json(ROOT / ".fleet-release.json", None)
        if metadata is not None:
            if not SHA.fullmatch(metadata["sha"]):
                raise ValueError("invalid release metadata")
            return metadata["origin"], metadata["sha"]
        try:
            # An archive nested inside another checkout must not inherit its origin.
            if Path(self.git(ROOT, "rev-parse", "--show-toplevel")).resolve() != ROOT.resolve():
                return self.d.agents_origin, "unknown"
            origin = self.git(ROOT, "remote", "get-url", "origin")
        except (OSError, ValueError, subprocess.SubprocessError):
            return self.d.agents_origin, "unknown"
        try:
            sha = self.git(ROOT, "rev-parse", "HEAD")
        except (OSError, ValueError, subprocess.SubprocessError):
            sha = "unknown"
        return origin, sha

    def release(self):
        origin, _ = self.source()
        self.safe.guard("src/fabrig/current")
        self.safe.guard("src/fabrig/releases/.probe")
        clone = self.base / "agents"
        current = self.base / "current"
        releases_dir = self.base / "releases"
        actual = current.resolve() if current.is_symlink() else None
        self.state["agents_sha"] = actual.name[7:] if actual and actual.parent == releases_dir and re.fullmatch(r"agents-[0-9a-f]{40}", actual.name) else None
        pin_data = self.safe.read(".config/fleet-sync/pin")
        pin = pin_data.decode().strip() if pin_data is not None else None
        if pin is not None and not SHA.fullmatch(pin):
            raise ValueError("pin must contain a full lowercase commit sha")
        if clone.is_symlink():
            raise ValueError(f"refusing symlink clone: {clone}")
        if self.args.check:
            if not clone.exists():
                self.item("agents", "drift", "dedicated clone is absent")
                return
            self.validate_clone(clone, origin)
            remote = self.cmd("git", "ls-remote", "--exit-code", origin, "refs/heads/main").split()[0]
            sha = pin or remote
        else:
            if clone.exists():
                self.validate_clone(clone, origin)
                self.git(clone, "fetch", "origin")
            else:
                self.safe.directory("src/fabrig", create=True)
                self.cmd("git", "clone", "--", origin, clone)
            sha = self.git(clone, "rev-parse", f"{pin or 'origin/main'}^{{commit}}")
        self.state["desired_agents_sha"] = sha
        release = self.base / "releases" / f"agents-{sha}"
        if current.exists() and not current.is_symlink():
            raise ValueError("refusing non-symlink current")
        if release.is_symlink():
            raise ValueError("refusing symlink release")
        right = current.is_symlink() and current.resolve() == release
        detached = self.git(clone, "rev-parse", "HEAD") == sha and not self.git(clone, "branch", "--show-current")
        if self.args.check:
            self.item("agents", "ok" if right and release.is_dir() and detached else "drift",
                      "release and checkout current" if right and detached else "release or detached checkout differs")
            return
        self.git(clone, "switch", "--detach", sha)
        created = not release.exists()
        if created:
            self.safe.directory("src/fabrig/releases", create=True)
            with tempfile.TemporaryDirectory(prefix=".agents-", dir=release.parent) as temporary:
                stage = Path(temporary) / "release"
                stage.mkdir()
                archive = self.cmd("git", "-C", clone, "archive", "--format=tar", sha, binary=True)
                with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
                    members = [m for m in tar.getmembers() if m.name.split("/")[0] != "old"]
                    tar.extractall(stage, members=members, filter="data")
                atomic(stage / ".fleet-release.json", json.dumps({"origin": origin, "sha": sha}))
                os.rename(stage, release)
        self.cmd(sys.executable, "-I", "-B", release / "tools/fleet-sync", "--self-check", "--host", self.name)
        candidate = Declarations(release, self.home)
        candidate.host(self.name)
        candidate.host_units(self.name)
        self.verify_units(candidate)
        smoke = self.cmd(sys.executable, "-I", "-B", release / "tools/fleet-sync", "--check", "--json", "--host", self.name,
                         extra_env={"FLEET_SYNC_SMOKE_FD": str(self.lock_fd)}, pass_fds=(self.lock_fd,), allowed=(0, 1))
        state = json.loads(smoke)
        if (not isinstance(state, dict) or state.get("host") != self.name or not isinstance(state.get("items"), list)
                or not {"start", "end", "agents_sha", "fabrig_sha"} <= state.keys()
                or any(not isinstance(item, dict) or not all(isinstance(item.get(key), str) for key in ("item", "result", "reason")) for item in state["items"])):
            raise ValueError("candidate smoke test did not print state JSON")
        if actual and actual.is_dir() and actual.parent == release.parent and not (actual / ".fleet-promoted").exists():
            atomic(actual / ".fleet-promoted", now())
        if not (release / ".fleet-promoted").exists():
            atomic(release / ".fleet-promoted", now())
        if not right:
            atomic_link(current, release)
        self.state["agents_sha"] = sha
        self.state["previous_release"] = self.previous_release()
        self.item("agents", "changed" if created or not right or not detached else "ok", f"release {sha}")
        releases = sorted((p for p in release.parent.iterdir() if re.fullmatch(r"agents-[0-9a-f]{40}", p.name)
                           and p.is_dir() and not p.is_symlink()), key=lambda p: p.stat().st_mtime_ns, reverse=True)
        previous = self.state["previous_release"]
        for stale in releases[10:]:
            if stale != current.resolve() and stale.name != previous:
                shutil.rmtree(stale)
        if ROOT != release:
            if self.args.resume_fd is not None:
                raise ValueError("refusing release exec loop")
            os.set_inheritable(self.lock_fd, True)
            env = {**os.environ, "FLEET_SYNC_HANDOFF": json.dumps(self.state),
                   "FLEET_SYNC_LOG": json.dumps([entry[-4000:] for entry in self.log][-12:])}
            argv = [sys.executable, "-I", "-B", str(release / "tools/fleet-sync"),
                    *sys.argv[1:], "--resume-fd", str(self.lock_fd)]
            os.execve(sys.executable, argv, env)

    def previous_release(self):
        directory = self.base / "releases"
        current = (self.base / "current").resolve()
        try:
            self.safe.directory("src/fabrig", create=False)
        except FileNotFoundError:
            return None
        releases = [directory / name for name in self.safe.names("src/fabrig/releases")
                    if re.fullmatch(r"agents-[0-9a-f]{40}", name) and directory / name != current
                    and not (directory / name).is_symlink() and (directory / name / ".fleet-promoted").is_file()]
        return max(releases, key=lambda p: (p / ".fleet-promoted").stat().st_mtime_ns).name if releases else None

    def verify_units(self, declarations):
        executable = shutil.which("systemd-analyze")
        if executable is None:
            self.item("units:verify", "warn", "systemd-analyze unavailable; verification skipped")
            return
        units = [declarations.root / "fleet/units" / name for name in sorted(declarations.host_units(self.name))
                 if declarations.file_policy.get(f".config/systemd/user/{name}", "write") != "check"]
        self.cmd(executable, "--user", "verify", *units)

    def fabrig_deferred(self):
        data = self.safe.read(".config/fleet-sync/defer-fabrig")
        if data is None:
            return False
        lines = data.decode().splitlines()
        self.item("fabrig", "deferred", lines[0] if lines else "defer-fabrig exists")
        return True

    @contextmanager
    def install_lock(self):
        """Ops and fleet share this inode. Never unlink or replace it."""
        relative = ".local/state/fabrig/install.lock"
        if self.args.check and self.safe.read(relative) is None:
            yield True
            return
        fd = None
        with self.safe.parent(relative, create=not self.args.check) as (directory_fd, leaf):
            try:
                fd = self.safe.open_regular(directory_fd, leaf, os.O_RDONLY if self.args.check else os.O_RDWR | os.O_CREAT)
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    yield False
                    return
                if self.args.check:
                    if stat.S_IMODE(os.fstat(fd).st_mode) != 0o600 or stat.S_IMODE(os.fstat(directory_fd).st_mode) != 0o700:
                        raise ValueError("install lock must be 0600 in a 0700 directory")
                else:
                    if stat.S_IMODE(os.fstat(directory_fd).st_mode) != 0o700:
                        os.fchmod(directory_fd, 0o700)
                    if stat.S_IMODE(os.fstat(fd).st_mode) != 0o600:
                        os.fchmod(fd, 0o600)
                yield True
            finally:
                if fd is not None:
                    os.close(fd)

    def fabrig_mirror(self):
        if getattr(self.args, "smoke_fd", None) is not None:
            return None  # Smoke checks cannot fetch, including lazy partial-clone blobs.
        directory = self.base / ".fleet-sync"
        mirror = directory / "fabrig.git"
        if directory.is_symlink() or mirror.is_symlink():
            raise ValueError("refusing symlink fabrig mirror")
        if not mirror.exists():
            if self.args.check:
                return None
            self.safe.directory("src/fabrig/.fleet-sync", create=True)
            directory.chmod(0o700)
            self.cmd("git", "clone", "--bare", "--filter=blob:none", "--", self.d.fabrig_origin, mirror)
        self.safe.directory("src/fabrig/.fleet-sync/fabrig.git")
        if self.git(mirror, "rev-parse", "--is-bare-repository") != "true":
            raise ValueError("fabrig mirror must be bare")
        if self.git(mirror, "remote", "get-url", "origin") != self.d.fabrig_origin:
            raise ValueError("foreign origin: fabrig mirror")
        if not self.args.check:
            directory.chmod(0o700)
            mirror.chmod(0o700)
        remote = self.cmd("git", "ls-remote", "--exit-code", self.d.fabrig_origin, "refs/heads/main").split()[0]
        if not SHA.fullmatch(remote):
            raise ValueError("invalid fabrig origin/main sha")
        try:
            cached = self.git(mirror, "rev-parse", "--verify", "refs/remotes/origin/main")
        except CommandError:
            cached = None  # A new bare clone has refs/heads/main, not origin/main.
        if cached != remote:
            # Bare clones have no default origin/main fetch refspec; name it explicitly.
            self.git(mirror, "fetch", "--no-tags", "origin", "+refs/heads/main:refs/remotes/origin/main")
        return mirror

    def fabrig(self):
        if self.fabrig_deferred():
            return
        with self.install_lock() as acquired:
            if not acquired:
                self.item("fabrig", "held", "install lock busy")
                return
            if self.fabrig_deferred():
                return
            self.fabrig_locked()

    def fabrig_locked(self):
        self.safe.guard("src/fabrig/main")
        self.safe.guard(".local/bin/.probe")
        clone = self.base / "main"
        origin = self.d.fabrig_origin
        if clone.is_symlink():
            raise ValueError("refusing symlink fabrig clone")
        mirror = self.fabrig_mirror()
        remote = self.git(mirror, "rev-parse", "origin/main") if mirror else self.cmd("git", "ls-remote", "--exit-code", origin, "refs/heads/main").split()[0]
        self.state["desired_fabrig_sha"] = remote
        if not clone.exists():
            if self.args.check:
                self.item("fabrig", "drift", "dedicated clone is absent")
                return
            # Bootstrap only the installer; it alone creates the dedicated clone and links.
            self.safe.directory("src/fabrig", create=True)
            with tempfile.TemporaryDirectory(prefix=".fabrig-install-", dir=self.base) as temporary:
                checkout = Path(temporary) / "checkout"
                self.cmd("git", "clone", "--depth=1", "--branch", "main", "--", origin, checkout)
                if self.fabrig_deferred():
                    return
                self.safe.guard(".local/bin/.probe")
                self.cmd(sys.executable, "-I", "-B", checkout / "tools/install", timeout=300)
            self.state["fabrig_sha"] = self.git(clone, "rev-parse", "HEAD")
            self.item("fabrig", "changed", "bootstrapped through fabrig installer")
            return
        # Only the installer may write to main, including its refs and index.
        self.safe.directory("src/fabrig/main")
        if Path(self.git(clone, "rev-parse", "--show-toplevel")).resolve() != clone.resolve():
            raise ValueError("not a dedicated fabrig clone")
        if self.git(clone, "remote", "get-url", "origin") != origin:
            raise ValueError("foreign origin: fabrig clone")
        head = self.git(clone, "rev-parse", "HEAD")
        self.state["fabrig_sha"] = head
        changed = head != remote
        if changed and mirror:
            try:
                self.git(mirror, "cat-file", "-e", f"{head}^{{commit}}")
            except CommandError:
                pass  # An installed commit missing from the mirror counts as changed.
            else:
                try:
                    self.git(mirror, "diff", "--quiet", head, "origin/main", "--", "tools/")
                    changed = False
                except CommandError as error:
                    if error.code != 1:
                        raise
        if self.fabrig_deferred():
            return
        wrong = False
        for line in self.safe.read("src/fabrig/main/tools/installed").decode().splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            fields = line.split()
            if len(fields) != 2 or any(not re.fullmatch(r"[a-zA-Z0-9_-]+", v) for v in fields):
                raise ValueError("invalid fabrig tools/installed")
            tool, directory = fields
            link = self.home / ".local/bin" / tool
            if self.fabrig_deferred():
                return
            wrong |= self.safe.readlink(str(link.relative_to(self.home))) != str(clone / "tools" / directory / tool)
        if changed or wrong:
            if self.args.check:
                self.item("fabrig", "drift", "tools changed or installed links differ")
            else:
                if self.fabrig_deferred():
                    return
                self.safe.guard(".local/bin/.probe")
                self.cmd(sys.executable, "-I", "-B", clone / "tools/install", timeout=300)
                self.state["fabrig_sha"] = self.git(clone, "rev-parse", "HEAD")
                self.item("fabrig", "changed", "ran fabrig installer (output in run.log)")
        else:
            reason = f"main ahead, tools unchanged ({head[:7]} -> {remote[:7]})" if head != remote else "HEAD and links current"
            self.item("fabrig", "ok", reason)

    def save_link_intent(self):
        relative = ".local/state/fleet-sync/links.json"
        names = sorted(self.link_owned)
        if not self.args.check and self.safe.json(relative, None) != names:
            self.safe.save(relative, json.dumps(names) + "\n")

    def load_link_ownership(self):
        recorded = self.safe.json(".local/state/fleet-sync/links.json", None)
        if recorded is not None:
            self.link_owned = set(recorded)
        elif "managed_links" not in self.old:
            # Older runners kept proof of created links in their change history.
            history = self.safe.read(".local/state/fleet-sync/runs.jsonl") or b""
            for run in [self.old, *(json.loads(line) for line in history.splitlines())]:
                for item in run.get("items", []):
                    if (item.get("item", "").startswith("link:") and item.get("result") == "changed"
                            and item.get("reason") == "linked to current release"):
                        self.link_owned.add(item["item"][5:])
        if any(not TOOL_NAME.fullmatch(name) for name in self.link_owned):
            raise ValueError("invalid tool link ownership record")

    def links(self):
        for tool in sorted(self.link_owned - self.d.tools.keys()):
            relative = f".local/bin/{tool}"
            try:
                old = self.safe.readlink(relative)
                target = Path(os.path.normpath(self.home / ".local/bin" / old)) if old else None
                managed = target is not None and any(target.is_relative_to(parent)
                    for parent in (self.base / "current", self.base / "releases"))
                if managed and self.args.check:
                    self.item(f"link:{tool}", "drift", "previously managed tool is no longer installed")
                    continue
                if managed:
                    with self.safe.parent(relative) as (directory, leaf):
                        if os.readlink(leaf, dir_fd=directory) != old:
                            self.item(f"link:{tool}", "warn", "link changed; retry next run")
                            continue
                        os.unlink(leaf, dir_fd=directory)
                    self.item(f"link:{tool}", "changed", "removed obsolete tool link")
            except ValueError as error:
                # A regular file replacing an old link belongs to the user now.
                self.item(f"link:{tool}", "warn", str(error))
                continue
            if not self.args.check:
                self.link_owned.discard(tool)
                self.save_link_intent()
        for tool, path in self.d.tools.items():
            relative = f".local/bin/{tool}"
            target = self.base / "current/tools" / path
            try:
                old = self.safe.readlink(relative)
            except (OSError, ValueError) as error:
                self.item(f"link:{tool}", "failed", str(error))
                continue
            if old == str(target):
                self.item(f"link:{tool}", "ok", "current")
            elif self.args.check:
                self.item(f"link:{tool}", "drift", "link is absent or differs")
            else:
                self.safe.link(relative, target)
                # Persist each successful creation without waiting for final state.
                self.link_owned.add(tool)
                self.save_link_intent()
                self.item(f"link:{tool}", "changed", "linked to current release")
        self.save_link_intent()

    def write(self, relative, content=None, mode=0o600, semantic=False, transform=None):
        for _ in range(2):
            snapshot = self.safe.snapshot(relative)
            old = snapshot[0]
            desired = transform(old) if transform else content
            data = desired.encode() if isinstance(desired, str) else desired
            equal = old == data
            if semantic and old is not None:
                try:
                    equal = json.loads(old) == json.loads(data)
                except (ValueError, UnicodeError):
                    pass
            if equal:
                self.item(relative, "ok", "content current")
                return False
            if (self.d.file_policy.get(relative, "write") == "check"
                    and not (self.kache_bootstrapped and relative in PROVISION_KACHE_FILES)):
                self.item(relative, "warn", "differs; check-only")
                return False
            if self.args.check:
                self.item(relative, "drift", "file is absent or differs")
                return True
            if self.safe.commit(relative, snapshot, data, mode, backup=relative not in self.owned):
                self.owned.add(relative)
                self.item(relative, "changed", "wrote file")
                return True
        self.item(relative, "warn", "busy; retry next run")
        return False

    def shell_block(self, relative, first):
        self.write(relative, mode=0o644, transform=lambda data: self.shell_content(data, relative, first))

    def shell_content(self, data, relative, first):
        content = data.decode() if data is not None else ""
        if content.count(BEGIN) != content.count(END) or content.count(BEGIN) > 1:
            raise ValueError(f"ambiguous fleet-sync block in {relative}")
        match = re.search(r"(?m)^" + re.escape(BEGIN) + r"\r?\n.*?^" + re.escape(END) + r"\r?(?:\n|$)", content, re.S)
        if BEGIN in content and not match:
            raise ValueError(f"malformed fleet-sync block in {relative}")
        # Relocate an existing block only if needed; outside bytes retain their order.
        outside = content[:match.start()] + content[match.end():] if match else content
        if first:
            result = BLOCK + outside
        else:
            result = outside + ("\n" if outside and not outside.endswith("\n") else "") + BLOCK
        return result

    def codex(self):
        self.write(".codex/config.toml", transform=self.codex_content)

    def codex_content(self, data):
        content = data.decode() if data is not None else ""
        # Parse first: never damage a config whose syntax we cannot understand.
        original = tomllib.loads(content)
        lines = content.splitlines(keepends=True)
        boundary = len(lines)
        prefix, statement = [], []
        found = set()
        for i, line in enumerate(lines):
            if not statement and line.lstrip().startswith("["):
                boundary = i
                break
            statement.append(line)
            try:
                parsed = tomllib.loads("".join(statement))
            except tomllib.TOMLDecodeError:
                continue  # A multiline string/array is one statement, including apparent headers.
            owned = parsed.keys() & self.d.codex.keys()
            if owned:
                for key in owned:
                    prefix.append(f"{key} = {json.dumps(self.d.codex[key])}\n")
                    found.add(key)
            else:
                prefix.extend(statement)
            statement = []
        if statement:
            raise ValueError("could not safely split Codex top-level statements")
        for key, value in self.d.codex.items():
            if key not in found:
                if prefix and not prefix[-1].endswith("\n"):
                    prefix[-1] += "\n"
                prefix.append(f"{key} = {json.dumps(value)}\n")
        result = "".join(prefix + lines[boundary:])
        merged = tomllib.loads(result)
        if any(merged.get(k) != v for k, v in self.d.codex.items()) or {k: v for k, v in original.items() if k not in self.d.codex} != {k: v for k, v in merged.items() if k not in self.d.codex}:
            raise ValueError("could not safely update Codex top-level keys")
        return result

    def environment(self):
        host = self.d.hosts[self.name]
        return {**self.d.env, **{k: expand(v, self.home) for k, v in host["env"].items()}}

    def conflicts(self, env, safe=None):
        safe = safe or self.safe
        paths = [".profile", ".bashrc", ".config/plan/environment.sh"]
        paths += [".config/environment.d/" + name for name in sorted(safe.names(".config/environment.d")) if name.endswith(".conf")]
        for relative in paths:
            if Path(relative).name == "90-fabrig.conf":
                continue
            data = safe.read(relative)
            if data is None:
                continue
            in_block = False
            for number, line in enumerate(data.decode().splitlines(), 1):
                if line == BEGIN:
                    in_block = True
                elif line == END:
                    in_block = False
                elif not in_block:
                    match = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z_0-9]*)=(.*)", line)
                    if not match or match[1] == "PATH" or match[1] not in env:
                        continue
                    value = match[2].strip()
                    try:
                        words = shlex.split(value, comments=True)
                        value = expand(words[0], self.home) if len(words) == 1 else value
                    except ValueError:
                        pass
                    if value != env[match[1]]:
                        self.item(f"conflict:{relative}:{number}", "warn", f"sets {match[1]} to a different value")

    @staticmethod
    def machine_map(data, user):
        mapping = {}
        for line in data.decode().splitlines():
            fields = line.partition("#")[0].split()
            if not fields:
                continue
            name = fields[0]
            target = fields[1] if len(fields) == 2 else None
            if target not in (None, "local") and "@" not in target and user:
                target = f"{user}@{target}"
            # Ambiguous duplicate names and malformed entries cannot compare equal.
            if name in mapping and mapping[name] != target:
                target = None
            mapping[name] = target
        return mapping

    def machines(self):
        relative = "src/rust/tmp/post/machines"
        desired = f"{self.name} local\n" + "".join(f"{name} {h['ssh']}\n" for name, h in self.d.hosts.items() if name != self.name)
        if self.d.file_policy.get(relative, "write") != "check":
            return self.write(relative, desired)
        user = os.environ.get("USER", "")
        actual = self.machine_map(self.safe.read(relative) or b"", user)
        wanted = self.machine_map(desired.encode(), user)
        different = sorted(name for name in actual.keys() | wanted.keys()
                           if name not in actual or name not in wanted or actual[name] != wanted[name])
        if different:
            self.item(relative, "warn", f"names differ: {', '.join(different)}; check-only")
        else:
            self.item(relative, "ok", "routing mapping current")

    def render(self):
        host = self.d.hosts[self.name]
        env = self.environment()
        path = f"{self.home}/.local/bin:{self.home}/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
        shell = 'PATH=${PATH-/usr/local/bin:/usr/bin:/bin}\n'
        # Add cargo first so local/bin comes first when both are absent.
        for directory in (".cargo/bin", ".local/bin"):
            shell += f'case ":$PATH:" in\n  *":$HOME/{directory}:"*) ;;\n  *) PATH="$HOME/{directory}:$PATH" ;;\nesac\n'
        shell += "export PATH\n"
        shell += "".join(f"export {k}={shlex.quote(v)}\n" for k, v in env.items())
        self.attempt(".config/fabrig/env.sh", lambda: self.write(".config/fabrig/env.sh", shell, 0o644))
        systemd_env = "".join(f"{k}={v}\n" for k, v in {"PATH": path, **env}.items())
        self.attempt(".config/environment.d/90-fabrig.conf", lambda: self.write(".config/environment.d/90-fabrig.conf", systemd_env))
        settings = json.dumps({**self.d.claude, "env": env}, indent=2) + "\n"
        self.attempt(".claude/settings.json", lambda: self.write(".claude/settings.json", settings, semantic=True))
        cargo = self.d.cargo
        if "cargo_jobs" in host:
            cargo = cargo.replace("[build]\n", f"[build]\njobs = {host['cargo_jobs']}\n", 1)
        self.attempt(".cargo/config.toml", lambda: self.write(".cargo/config.toml", cargo))
        self.attempt("machine.env", lambda: self.write("src/rust/tmp/machine.env", "".join(f"{k}={v}\n" for k, v in host["machine_env"].items())))
        self.attempt("post/machines", self.machines)
        if self.kache_declared():
            self.attempt("kache:config", self.kache_config)
        self.attempt(".profile", lambda: self.shell_block(".profile", False))
        self.attempt(".bashrc", lambda: self.shell_block(".bashrc", True))
        self.attempt(".codex/config.toml", self.codex)
        self.attempt("conflicts", lambda: self.conflicts(env, getattr(self, "real_safe", self.safe)))

    def units(self):
        declared = self.d.host_units(self.name)
        readonly = {name for name in declared | self.unit_owned
                    if self.d.file_policy.get(f".config/systemd/user/{name}", "write") == "check"
                    and not (self.kache_bootstrapped and f".config/systemd/user/{name}" in PROVISION_KACHE_FILES)}
        for name in sorted(readonly & declared):
            self.write(f".config/systemd/user/{name}", self.d.units[name])
        wanted = declared - readonly
        directory = self.home / ".config/systemd/user"
        differs, existing = {}, {}
        for name in wanted | (self.unit_owned - readonly):
            if Path(name).name != name or not name.endswith((".timer", ".service")):
                raise ValueError("invalid unit ownership record")
            data = self.safe.read(f".config/systemd/user/{name}")
            existing[name] = data is not None
            if name in wanted:
                differs[name] = data != self.d.units[name].encode()
        start_once = wanted & self.d.start_once
        first_start = {name for name in start_once
                       if not existing[name] or name not in self.unit_owned
                       or (name not in self.start_once_started and not self.service_enabled(name))}
        stale = self.unit_owned - wanted - RECOVERY_UNITS - readonly
        if not self.args.check and not self.previewing:
            # Journal ownership AND reload intent before the first unit mutation.
            self.start_once_started.difference_update(first_start)
            self.unit_owned.update(wanted)
            self.reload_pending |= any(differs.values()) or bool(stale)
            self.save_unit_intent()
        for name in sorted(wanted):
            relative = f".config/systemd/user/{name}"
            different = self.write(relative, self.d.units[name])
            if (different and name not in first_start and name.endswith(".service")
                    and (name in start_once or not re.search(r"(?m)^Type=oneshot\s*$", self.d.units[name]))):
                self.item(name, "warn", "restart pending; service was not restarted")
        for name in sorted(stale):
            if self.args.check:
                self.item(name, "drift", "previously managed unit no longer belongs to this role"
                          + ("; stopped by its owner" if name.endswith(".service") else ""))
            else:
                # Do not stop services, including services paired with removed timers.
                if existing[name] and not self.previewing:
                    self.cmd("systemctl", "--user", "disable", "--no-reload", *(["--now"] if name.endswith(".timer") else []), name)
                self.safe.unlink(f".config/systemd/user/{name}")
                self.unit_owned.remove(name)
                self.start_once_started.discard(name)
                self.owned.discard(f".config/systemd/user/{name}")
                self.item(name, "changed", "disabled and removed previously managed unit"
                          + ("; stopped by its owner" if name.endswith(".service") else ""))
        if self.args.check or self.previewing:
            for name in sorted(start_once):
                enabled = self.service_enabled(name)
                self.item(f"enabled:{name}", "ok" if enabled else "drift", "service enablement symlink")
                if name in first_start:
                    self.item(name, "drift", "start-once service first start pending")
                else:
                    self.start_once_status(name)
        if self.previewing:
            self.item("units:activation", "deferred", "preview: no systemctl writes")
            return
        if self.args.check:
            # Timers remain filesystem-only; start-once services get a read-only activity probe.
            if self.reload_pending:
                self.item("units:reload", "drift", "daemon-reload pending after a failed run")
            for name in sorted(wanted):
                if name.endswith(".timer"):
                    enabled = self.timer_enabled(name)
                    self.item(f"enabled:{name}", "ok" if enabled else "drift", "timer enablement symlink")
            if not (os.environ.get("DBUS_SESSION_BUS_ADDRESS") or (Path(os.environ.get("XDG_RUNTIME_DIR", "/nonexistent")) / "bus").exists()):
                self.item("units:bus", "failed", "no user bus advertised")
            return
        # A previous run may have completed while the manager still held stale
        # units. Read its view even when our bytes and journal are current.
        manager = self.cmd("systemctl", "--user", "show", "-p", "NeedDaemonReload", *sorted(self.unit_owned - readonly))
        if "NeedDaemonReload=yes" in manager.splitlines():
            self.reload_pending = True
            self.save_unit_intent()
        if self.reload_pending:
            self.cmd("systemctl", "--user", "daemon-reload")
            self.reload_pending = False
            self.save_unit_intent()
        for name in sorted(wanted):
            if name.endswith(".timer"):
                try:
                    self.cmd("systemctl", "--user", "is-active", "--quiet", name)
                    active = True
                except CommandError as error:
                    if error.code not in (1, 3, 4):
                        raise
                    active = False
                if not self.timer_enabled(name) or not active:
                    relative = f".config/systemd/user/timers.target.wants/{name}"
                    if not self.timer_enabled(name) and self.safe.readlink(relative) is not None:
                        if name not in self.unit_owned:
                            raise ValueError("refusing enablement repair without unit ownership")
                        self.safe.link(relative, directory / name)
                    self.cmd("systemctl", "--user", "enable", "--now", "--no-reload", name)
                self.item(f"enabled:{name}", "ok", "timer enabled and started")
        for name in sorted(start_once):
            enabled = self.service_enabled(name)
            if name in first_start or not enabled:
                for relative in self.service_enablement(name):
                    if self.safe.readlink(relative) is not None:
                        self.safe.link(relative, directory / name)
                self.cmd("systemctl", "--user", "enable", *(["--now"] if name in first_start else []),
                         "--no-reload", name)
            self.start_once_started.add(name)
            self.save_unit_intent()
            self.item(f"enabled:{name}", "ok", "start-once service enabled"
                      + (" and started" if name in first_start else ""))
            self.start_once_status(name)
        self.save_unit_intent()

    def service_enablement(self, name):
        links, section = set(), ""
        for line in self.d.units[name].splitlines():
            line = line.strip()
            if line.startswith("[") and line.endswith("]"):
                section = line
            key, sep, value = line.partition("=")
            if section != "[Install]" or not sep or key.strip() not in ("WantedBy", "RequiredBy", "Alias"):
                continue
            key = key.strip()
            for target in value.split():
                if Path(target).name != target or target in (".", "..") or "%" in target:
                    raise ValueError(f"unsupported start-once enablement target: {target}")
                suffix = {"WantedBy": "wants", "RequiredBy": "requires"}.get(key)
                links.add(f".config/systemd/user/{target}.{suffix}/{name}" if suffix
                          else f".config/systemd/user/{target}")
        return sorted(links)

    def service_enabled(self, name):
        safe = getattr(self, "real_safe", self.safe)
        return all(self.enablement_link(safe, relative, name) for relative in self.service_enablement(name))

    def enablement_link(self, safe, relative, name):
        target = safe.readlink(relative)
        if target is None:
            return False
        path = Path(target)
        if not path.is_absolute():
            path = (self.home / relative).parent / path
        return Path(os.path.normpath(path)) == self.home / ".config/systemd/user" / name

    def start_once_status(self, name):
        try:
            self.cmd("systemctl", "--user", "is-active", "--quiet", name)
        except CommandError as error:
            if error.code not in (1, 3, 4):
                raise
            self.item(name, "warn", "start-once service not active; its owner restarts it")
        else:
            self.item(name, "ok", "start-once service active")

    def timer_enabled(self, name):
        relative = f".config/systemd/user/timers.target.wants/{name}"
        return self.enablement_link(self.safe, relative, name)

    def save_unit_intent(self):
        relative = ".local/state/fleet-sync/units.json"
        intent = {"units": sorted(self.unit_owned), "reload_pending": self.reload_pending}
        if self.start_once_started:
            intent["start_once_started"] = sorted(self.start_once_started)
        if self.safe.json(relative, None) != intent:
            self.safe.save(relative, json.dumps(intent) + "\n")

    def version_matches(self, pin, command=None):
        output = self.cmd(*(command or pin["command"]), timeout=10)
        found = re.findall(r"(?<![A-Za-z0-9])v?(\d+(?:\.\d+){2,3}(?:[-+][A-Za-z0-9.-]+)?)", output)
        return any(pin["version"] in (value, value.partition("+")[0]) for value in found)

    def download(self, url, digest, destination):
        # No download is ever executed/extracted before its declared SHA256 passes.
        self.cmd("curl", "--fail", "--silent", "--show-error", "--location",
                 "--proto", "=https", "--proto-redir", "=https", "--connect-timeout", "10",
                 "--max-time", "300", "--output", destination, "--", url, timeout=310)
        with destination.open("rb") as stream:
            actual = hashlib.file_digest(stream, "sha256").hexdigest()
        if actual != digest:
            raise ValueError("download SHA256 mismatch")

    def extracted(self, archive, directory):
        # Data filter bounds links; disallow links altogether for installation
        # so entrypoint checks and subsequent copies cannot escape staging.
        with tarfile.open(archive) as tar:
            members = tar.getmembers()
            if any(not (m.isfile() or m.isdir()) or Path(m.name).is_absolute()
                   or ".." in Path(m.name).parts for m in members):
                raise ValueError("unsafe provision archive member")
            tar.extractall(directory, members=members, filter="data")

    def install_file(self, relative, source):
        self.safe.save(relative, source.read_bytes(), 0o755)

    def install_tree(self, relative, source):
        # Only versioned tool directories may be replaced. Quarantine the previous
        # directory until the sibling promotion succeeds; never edit its binaries.
        with self.safe.parent(relative, create=True) as (directory, leaf):
            try:
                info = os.stat(leaf, dir_fd=directory, follow_symlinks=False)
            except FileNotFoundError:
                info = None
            if info is not None and not stat.S_ISDIR(info.st_mode):
                raise ValueError("refusing non-directory provision release")
            sibling = f".{leaf}.{secrets.token_hex(12)}"
            # Copy into a sibling on the destination filesystem, before any rename.
            parent = Path(f"/proc/self/fd/{directory}")
            shutil.copytree(source, parent / sibling, symlinks=True)
            previous = sibling + ".previous"
            try:
                if info is not None:
                    os.rename(leaf, previous, src_dir_fd=directory, dst_dir_fd=directory)
                try:
                    os.rename(sibling, leaf, src_dir_fd=directory, dst_dir_fd=directory)
                except BaseException:
                    if info is not None:
                        os.rename(previous, leaf, src_dir_fd=directory, dst_dir_fd=directory)
                    raise
                os.fsync(directory)
            finally:
                for name in (sibling, previous):
                    if (parent / name).exists():
                        shutil.rmtree(parent / name)

    def rust_current(self, install):
        toolchain = install["toolchain"]
        active = self.cmd("rustup", "show", "active-toolchain")
        if not active.startswith(toolchain + "-"):
            return False
        tools = self.cmd("rustup", "toolchain", "list").splitlines()
        if any(not any(row.startswith(extra + "-") for row in tools) for extra in install["extra_toolchains"]):
            return False
        components = self.cmd("rustup", "component", "list", "--installed", "--toolchain", toolchain).splitlines()
        targets = self.cmd("rustup", "target", "list", "--installed", "--toolchain", toolchain).splitlines()
        return (all(any(row == c or row.startswith(c + "-") for row in components) for c in install["components"])
                and set(install["targets"]) <= set(targets))

    def install_rust(self, install):
        toolchain = install["toolchain"]
        options = ["--profile", install["profile"]]
        for component in install["components"]:
            options += ["--component", component]
        for target in install["targets"]:
            options += ["--target", target]
        # Rustup verifies Rust's per-component SHA256s. Disable self-update: the
        # prerequisite manager comes from Debian's authenticated apt repository.
        self.cmd("rustup", "toolchain", "install", toolchain, *options, "--no-self-update", timeout=1800)
        self.cmd("rustup", "default", toolchain)
        for extra in install["extra_toolchains"]:
            self.cmd("rustup", "toolchain", "install", extra, "--profile", install["profile"],
                     "--no-self-update", timeout=1800)

    def install_pin(self, name, pin, work):
        install = pin["install"]
        kind = install["kind"]
        if kind == "rustup":
            self.install_rust(install)
            return
        archive = work / "download"
        if kind == "kache-source":
            source = work / "source"
            self.cmd("git", "init", "--", source)
            self.git(source, "fetch", "--depth", "1", install["repository"], install["rev"])
            self.git(source, "checkout", "--detach", "FETCH_HEAD")
            if self.git(source, "rev-parse", "HEAD") != install["rev"]:
                raise ValueError("kache source revision mismatch")
            for patch in install["patches"]:
                path = self.d.root / "fleet/kache" / patch
                self.git(source, "apply", "--check", path)
                self.git(source, "apply", path)
            self.download(install["musl_url"], install["musl_sha256"], archive)
            self.extracted(archive, work)
            self.cmd("bash", self.d.root / "fleet/kache/build", work, timeout=1800)
            artifact = work / "out/kache"
            if not self.version_matches(pin, [str(artifact), "--version"]):
                raise ValueError("built kache version differs")
            self.install_file(install["destination"], artifact)
            return
        self.download(install["url"], install["sha256"], archive)
        if kind == "claude-script":
            payload = work / "payload"
            self.download(install["payload_url"], install["payload_sha256"], payload)
            # Run the approved vendor installer in an isolated HOME; only its
            # checked versioned output is copied into the user's real HOME.
            stage_home = work / "home"
            stage_home.mkdir()
            self.cmd("bash", archive, pin["version"], timeout=600,
                     extra_env={"HOME": str(stage_home), "XDG_CONFIG_HOME": str(stage_home / ".config"),
                                "XDG_DATA_HOME": str(stage_home / ".local/share"),
                                "XDG_CACHE_HOME": str(stage_home / ".cache"),
                                "CLAUDE_CONFIG_DIR": str(stage_home / ".claude"), "BASH_ENV": "/dev/null"})
            relative = f".local/share/claude/versions/{pin['version']}"
            artifact = stage_home / relative
            if artifact.is_symlink() or hashlib.sha256(artifact.read_bytes()).hexdigest() != install["payload_sha256"]:
                raise ValueError("Claude installer output SHA256 differs")
            self.install_file(relative, artifact)
            self.safe.link(".local/bin/claude", self.home / relative)
            return
        if kind in ("tar", "opt-tar", "codex-package"):
            unpack = work / "unpack"
            unpack.mkdir()
            self.extracted(archive, unpack)
            if kind == "tar":
                artifact = unpack / install["member"]
            else:
                artifact = unpack / install["entrypoint"]
        else:
            artifact = archive
        if not artifact.is_file() or artifact.is_symlink():
            raise ValueError("provision entrypoint is not a regular file")
        artifact.chmod(0o755)
        if not self.version_matches(pin, [str(artifact), *pin["command"][1:]]):
            raise ValueError("downloaded tool version differs")
        if kind in ("opt-tar", "codex-package"):
            if kind == "codex-package":
                metadata = json.loads((unpack / "codex-package.json").read_text())
                if (metadata.get("version") != pin["version"] or metadata.get("entrypoint") != "bin/codex"
                        or metadata.get("target") != "x86_64-unknown-linux-musl"
                        or metadata.get("layoutVersion") != 1 or metadata.get("variant") != "codex"
                        or metadata.get("resourcesDir") != "codex-resources" or metadata.get("pathDir") != "codex-path"
                        or not (unpack / "bin/codex-code-mode-host").is_file()
                        or not (unpack / "codex-resources").is_dir() or not (unpack / "codex-path").is_dir()):
                    raise ValueError("Codex standalone package metadata differs")
            self.install_tree(install["release"], unpack)
            if kind == "codex-package":
                self.safe.link(".codex/packages/standalone/current", self.home / install["release"])
                target = self.home / ".codex/packages/standalone/current/bin/codex"
            else:
                target = self.home / install["release"] / install["entrypoint"]
            self.safe.link(f".local/bin/{name}", target)
        else:
            self.install_file(install["destination"], artifact)
            if kind == "binary" and install["destination"] != f".local/bin/{name}":
                self.safe.link(f".local/bin/{name}", self.home / install["destination"])

    def seed_matches(self, relative, entries, tree):
        safe = self.safe
        try:
            if not tree:
                with safe.parent(relative) as (directory, leaf):
                    fd = safe.open_regular(directory, leaf)
                    with os.fdopen(fd, "rb") as stream:
                        info = os.fstat(stream.fileno())
                        return (stat.S_IMODE(info.st_mode) == entries["payload"]["mode"]
                                and hashlib.file_digest(stream, "sha256").hexdigest() == entries["payload"]["sha256"])
            # Validate the shape/types/modes before opening any contents. Unknown
            # extra files (including misplaced state) are never read.
            for path, row in entries.items():
                location = relative if path == "." else f"{relative}/{path}"
                with safe.parent(location) as (directory, leaf):
                    info = os.stat(leaf, dir_fd=directory, follow_symlinks=False)
                    kind = "file" if stat.S_ISREG(info.st_mode) else "dir" if stat.S_ISDIR(info.st_mode) else "link" if stat.S_ISLNK(info.st_mode) else "invalid"
                    if kind != row["type"] or stat.S_IMODE(info.st_mode) != row["mode"]:
                        return False
                    if kind == "link" and os.readlink(leaf, dir_fd=directory) != row["target"]:
                        return False
                if kind == "dir":
                    expected = {Path(p).name for p in entries if p != "." and str(Path(p).parent) == path}
                    if set(safe.names(location)) != expected:
                        return False
            for path, row in entries.items():
                if row["type"] == "file":
                    with safe.parent(f"{relative}/{path}") as (directory, leaf):
                        with os.fdopen(safe.open_regular(directory, leaf), "rb") as stream:
                            if hashlib.file_digest(stream, "sha256").hexdigest() != row["sha256"]:
                                return False
            return True
        except FileNotFoundError:
            return False

    def unpack_seed(self, archive, destination, entries):
        # Reject partial/extra/duplicate paths and links/modes before extraction.
        with tarfile.open(archive) as tar:
            members = {}
            for member in tar.getmembers():
                path = member.name.rstrip("/")
                while path.startswith("./"):
                    path = path[2:]
                if path in members or path not in entries:
                    raise ValueError("seed archive has duplicate or unexpected member")
                row = entries[path]
                kind = "file" if member.isfile() else "dir" if member.isdir() else "link" if member.issym() else "invalid"
                if kind != row["type"] or member.mode != row["mode"]:
                    raise ValueError("seed archive type/mode mismatch")
                if kind == "link" and member.linkname != row["target"]:
                    raise ValueError("seed archive symlink target mismatch")
                members[path] = member
            if members.keys() != entries.keys():
                raise ValueError("partial seed tree: manifest members missing")
            destination.mkdir(mode=0o700)
            for path, row in entries.items():
                if row["type"] == "dir" and path != ".":
                    (destination / path).mkdir(mode=0o700, parents=True, exist_ok=True)
            for path, member in members.items():
                row = entries[path]
                if row["type"] != "file":
                    continue
                output = destination / path
                with tar.extractfile(member) as source, output.open("xb") as target:
                    shutil.copyfileobj(source, target)
                with output.open("rb") as stream:
                    if hashlib.file_digest(stream, "sha256").hexdigest() != row["sha256"]:
                        raise ValueError(f"seed SHA256 mismatch: {path}")
                output.chmod(row["mode"])
            for path, row in entries.items():
                if row["type"] == "link":
                    (destination / path).symlink_to(row["target"])
            for path in sorted(entries, key=lambda p: len(Path(p).parts), reverse=True):
                if entries[path]["type"] == "dir":
                    (destination / path).chmod(entries[path]["mode"])

    def seed_links(self, name, install):
        if name == "cargo-nextest":
            return False
        changed = False
        target = self.home / install.get("destination", install.get("release", ""))
        if name == "codex":
            relative = ".codex/packages/standalone/current"
            if self.safe.readlink(relative) != str(target):
                self.safe.link(relative, target)
                changed = True
            target = self.home / relative / "bin/codex"
        elif install["kind"] != "binary":
            target /= install["entrypoint"]
        relative = f".local/bin/{name}"
        if self.safe.readlink(relative) != str(target):
            self.safe.link(relative, target)
            changed = True
        return changed

    def provision_seed(self, name, pin):
        install = pin["install"]
        item = f"provision:{name}"
        if install.get("disagreement"):
            self.item(item, "warn", f"manual: peer disagreement: {install['disagreement']}")
            return
        entries = seed_entries(self.d.root, install)
        tree = install["kind"] != "binary"
        relative = install["release"] if tree else install["destination"]
        if self.seed_matches(relative, entries, tree):
            changed = self.seed_links(name, install)
            self.item(item, "changed" if changed else "ok", f"content pin matches; {'repaired links' if changed else 'no transfer or writes'}")
            return
        self.safe.directory(".local/state/fleet-sync", create=True)
        peers = sorted((n for n, host in self.d.hosts.items() if host.get("seed", False) and n != self.name
                        and n in install.get("seed_hosts", self.d.hosts)),
                       key=lambda n: (n != "hetzner3", n))
        candidates = [None] if install.get("url") else peers
        failures = []
        for peer in candidates:
            try:
                with tempfile.TemporaryDirectory(prefix=".seed-", dir=self.state_dir) as temporary:
                    work = Path(temporary)
                    archive = work / "archive"
                    if peer is None:
                        self.download(install["url"], install["sha256"], archive)
                        if tree:
                            self.unpack_seed(archive, work / "verified", entries)
                        else:
                            output = work / "verified/payload"
                            output.parent.mkdir()
                            archive.rename(output)
                            output.chmod(entries["payload"]["mode"])
                    else:
                        request = json.dumps([install["source"], entries, tree])
                        command = shlex.join(["python3", "-B", "-c", SEED_EXPORT, request])
                        with archive.open("xb") as output:
                            self.cmd("ssh", "-T", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes",
                                     "-o", "UpdateHostKeys=no", "-o", "ConnectTimeout=5",
                                     self.d.hosts[peer]["ssh"], command, timeout=600, binary=True, stdout=output)
                        self.unpack_seed(archive, work / "verified", entries)
                    if tree:
                        self.install_tree(relative, work / "verified")
                    else:
                        self.safe.save(relative, (work / "verified/payload").read_bytes(), entries["payload"]["mode"])
                    self.seed_links(name, install)
                if failures:
                    self.item(f"seed:{name}", "warn", "; ".join(failures))
                self.item(item, "changed", f"verified content pin; installed from {peer or 'upstream URL'}")
                return
            except (OSError, ValueError, subprocess.SubprocessError, tarfile.TarError) as error:
                failures.append(f"{peer or 'upstream URL'}: {error}")
        raise ValueError("no verified seed available: " + ("; ".join(failures) or "no other seed hosts declared"))

    def provision(self):
        self.kache_bootstrapped = False
        # Called only from an explicit manual run under the ordinary fleet lock.
        # Bootstrap Rust before kache, regardless of declaration order.
        names = sorted(self.d.versions, key=lambda name: name != "rustc")
        for name in names:
            pin = self.d.versions[name]
            install = pin.get("install")
            item = f"provision:{name}"
            try:
                if name == "kache" and self.kache_present():
                    self.item(item, "ok", "existing kache left to ops; no binary/config/unit takeover")
                    continue
                if install and install.get("seed") == "peer":
                    self.provision_seed(name, pin)
                    continue
                try:
                    current = self.version_matches(pin)
                except (OSError, ValueError, subprocess.SubprocessError):
                    current = False
                if current and install and install["kind"] == "rustup":
                    current = self.rust_current(install)
                if install is None or any(isinstance(v, str) and v.startswith("TODO-USER:") for v in install.values()):
                    self.item(item, "warn", f"manual: TODO-USER {name} {pin['version']}; approve URL and SHA256 in fleet/versions.toml")
                    continue
                if current:
                    self.item(item, "ok", f"{pin['version']} already installed")
                    continue
                self.safe.directory(".local/state/fleet-sync", create=True)
                with tempfile.TemporaryDirectory(prefix=".provision-", dir=self.state_dir) as directory:
                    self.install_pin(name, pin, Path(directory))
                if not self.version_matches(pin):
                    raise ValueError("installed version differs from pin")
                if name == "kache":
                    self.kache_bootstrapped = True
                self.item(item, "changed", f"installed {pin['version']}")
            except (OSError, ValueError, subprocess.SubprocessError, tarfile.TarError) as error:
                self.item(item, "failed", str(error))

    def kache_present(self):
        # Metadata only. Presence, including a broken/user-owned link, forbids a
        # takeover. PATH may contain an older installation outside .local/bin.
        self.safe.guard(".local/bin/kache")
        path = f"{self.home}/.local/bin:{self.home}/.cargo/bin:" + os.environ.get("PATH", "/usr/bin:/bin")
        footprints = (".local/bin/kache", ".config/kache", ".cache/kache", ".local/share/kache",
                      ".config/systemd/user/kache.service", ".config/systemd/user/kache.service.d")
        return any(os.path.lexists(self.home / p) for p in footprints) or shutil.which("kache", path=path) is not None

    def kache_declared(self):
        return self.d.versions.get("kache", {}).get("install", {}).get("kind") == "kache-source"

    def kache_config(self):
        values = self.d.hosts[self.name]["machine_env"]
        cap = values.get("KACHE_MAX_GB", 12)
        floor = values.get("PLAN_MIN_DISK_GB", 40)
        # machine_env may hold literal strings; kache's sizes must read as whole numbers.
        try:
            cap, floor = (v if type(v) is int else int(v, 10) if isinstance(v, str) and v.isdigit() else None
                          for v in (cap, floor))
        except ValueError:
            cap = floor = None
        if cap is None or floor is None:
            raise ValueError("KACHE_MAX_GB and PLAN_MIN_DISK_GB must be whole numbers for kache")
        config = (self.d.root / "fleet/kache/config.toml").read_text()
        config = config.replace("@CAP@", str(cap)).replace("@RECOVERY@", str((floor + max(cap, 1)) * 1024**3))
        # Keep the existing non-secret remote selection in a comparison only.
        # Never inspect store.env, cache/store directories or service drop-ins.
        existing = self.safe.read(".config/kache/config.toml") or b""
        remote = b"[cache.remote]" in existing
        local_only = values.get("KACHE_LOCAL_ONLY", 0) or not remote
        config = config.replace("@LOCAL_ONLY@", "true" if local_only else "false")
        if remote:
            config += (self.d.root / "fleet/kache/remote.toml").read_text()
        self.write(".config/kache/config.toml", config)

    def start_kache(self):
        if not self.kache_bootstrapped:
            return  # Existing installations and later runs remain ops-owned.
        if not self.version_matches(self.d.versions["kache"]):
            raise ValueError("kache pin unavailable; service was not started")
        relative = ".config/systemd/user/default.target.wants/kache.service"
        target = self.safe.readlink(relative)
        enabled = target == str(self.home / ".config/systemd/user/kache.service") or target == "../kache.service"
        if target is not None and not enabled:
            raise ValueError("conflicting kache enablement link; repair manually")
        active = True
        try:
            self.cmd("systemctl", "--user", "is-active", "--quiet", "kache.service")
        except CommandError as error:
            if error.code not in (1, 3, 4):
                raise
            active = False
        if not active or not enabled:
            self.cmd("systemctl", "--user", "enable", "--now", "--no-reload", "kache.service")
        self.item("kache:activation", "ok", "service enabled and started; existing daemon was not restarted")

    def versions(self):
        for name, pin in self.d.versions.items():
            try:
                output = self.cmd(*pin["command"], timeout=10)
                if "install" not in pin:
                    # Preserve version-only declarations' pre-bootstrap behavior.
                    found = re.findall(r"(?<![A-Za-z0-9])\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.]+)?", output)
                    match = pin["version"] in found
                else:
                    found = re.findall(r"(?<![A-Za-z0-9])v?(\d+(?:\.\d+){2,3}(?:[-+][A-Za-z0-9.-]+)?)", output)
                    match = any(pin["version"] in (value, value.partition("+")[0]) for value in found)
                version_only = self.name in pin.get("version_only_hosts", [])
                reason = ("version-only; canonical tree is for builders; " if version_only else "")
                self.item(f"version:{name}", "ok" if match and not version_only else "warn", reason + f"want {pin['version']}; got {output[:160]}")
            except (OSError, ValueError, subprocess.TimeoutExpired) as error:
                self.item(f"version:{name}", "warn", str(error))

    def attempt(self, name, function):
        try:
            return function()
        except (OSError, ValueError, subprocess.SubprocessError, tarfile.TarError) as error:
            self.item(name, "failed", str(error))
            return False

    def acquire(self):
        relative = ".local/state/fleet-sync/lock"
        if self.args.check and self.safe.read(relative) is None:
            return True
        with self.safe.parent(relative, create=not self.args.check) as (directory, leaf):
            fd = self.safe.open_regular(directory, leaf, os.O_RDONLY if self.args.check else os.O_RDWR | os.O_CREAT)
        inherited = self.args.resume_fd if self.args.resume_fd is not None else getattr(self.args, "smoke_fd", None)
        if inherited is not None:
            actual, expected = os.fstat(inherited), os.fstat(fd)
            os.close(fd)
            if not stat.S_ISREG(actual.st_mode) or (actual.st_ino, actual.st_dev) != (expected.st_ino, expected.st_dev):
                raise ValueError("invalid inherited lock")
            self.lock_fd = inherited
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.set_inheritable(self.lock_fd, False)
            return True
        self.lock_fd = fd
        try:
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except BlockingIOError:
            os.close(self.lock_fd)
            self.lock_fd = None
            if self.args.check:
                self.item("lock", "busy", "a run is in progress; check again")
            elif not self.args.timer:
                self.item("lock", "failed", "another run holds the lock")
            return False

    def finish(self, persist=True):
        self.state["end"] = now()
        if not any(i["result"] == "busy" for i in self.state["items"]):
            try:
                self.state["previous_release"] = self.previous_release()
            except (OSError, ValueError) as error:
                self.item("releases", "failed", str(error))
        self.state["managed_files"] = sorted(self.owned)
        self.state["managed_links"] = sorted(self.link_owned)
        self.state["managed_units"] = sorted(self.unit_owned)
        self.state["unit_reload_pending"] = self.reload_pending
        if persist and not self.args.check:
            failed = any(i["result"] == "failed" for i in self.state["items"])
            if self.args.timer:
                self.state["last_timer_end"] = self.state["end"]
                if failed:
                    self.state["consecutive_failures"] += 1
                    self.state["last_failure"] = self.state["end"]
            if not failed:
                self.state["consecutive_failures"] = 0
                self.state["last_failure"] = None
            self.state["backoff_until"] = self.backoff_until()
            self.safe.save(".local/state/fleet-sync/state.json", json.dumps(self.state, indent=2) + "\n")
            self.safe.save(".local/state/fleet-sync/run.log", "\n".join(self.log)[-262144:])
            history = ".local/state/fleet-sync/runs.jsonl"
            cutoff = dt.datetime.now(dt.UTC) - dt.timedelta(days=7)
            records = []
            old_history = self.safe.read(history)
            if old_history is not None:
                for line in old_history.decode().splitlines():
                    record = json.loads(line)
                    if dt.datetime.fromisoformat(record["end"]) >= cutoff:
                        records.append(record)
            if any(i["result"] in ("changed", "failed") for i in self.state["items"]):
                records.append(self.state)
            if records or old_history is not None:
                self.safe.save(history, "".join(json.dumps(r) + "\n" for r in records))
        return 1 if any(i["result"] in ("drift", "failed") for i in self.state["items"]) else 0

    def backoff_until(self):
        failures = self.state.get("consecutive_failures", 0)
        stamp = self.state.get("last_failure")
        if not failures or not stamp:
            return None
        if type(failures) is not int or failures < 0:
            raise ValueError("invalid consecutive_failures")
        failure = dt.datetime.fromisoformat(stamp)
        if failure.tzinfo is None:
            raise ValueError("last_failure must include a timezone")
        minutes = min(60, 2 ** min(failures - 1, 6))
        return (failure + dt.timedelta(minutes=minutes)).isoformat()

    def backoff_reason(self):
        until = self.backoff_until()
        self.state["backoff_until"] = until
        if until and dt.datetime.fromisoformat(until) > dt.datetime.now(dt.UTC):
            clock = dt.datetime.fromisoformat(until).astimezone(dt.UTC).strftime("%H:%MZ")
            return f"backoff until {clock} ({self.state['consecutive_failures']} failures)"
        return None

    def timer_wait(self):
        # Read under the fleet lock; a prior run may have finished while we started.
        saved = self.safe.json(".local/state/fleet-sync/state.json", {})
        for key, default in (("consecutive_failures", 0), ("last_failure", None)):
            self.state[key] = saved.get(key, default)
        retry = ".config/fleet-sync/retry"
        if self.safe.read(retry) is not None:
            self.safe.unlink(retry)
            return False
        reason = self.backoff_reason()
        if not reason:
            return False
        try:
            origin, _ = self.source()
            fields = self.cmd("git", "ls-remote", "--exit-code", origin, "refs/heads/main").split()
            remote = fields[0] if fields else ""
            if not SHA.fullmatch(remote):
                raise ValueError("invalid agents origin/main sha")
            if remote != saved.get("agents_sha"):
                return False
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            reason += "; origin/main probe failed: " + " ".join(str(error).split())[:600]
        log = self.safe.read(".local/state/fleet-sync/run.log") or b""
        self.safe.save(".local/state/fleet-sync/run.log",
                       (log.rstrip(b"\n") + f"\n{now()} {reason}\n".encode())[-262144:])
        self.waiting = True
        return True

    def preview(self, destination):
        """Converge a private HOME copy, retaining real HOME for rendering/conflicts."""
        destination = Path(destination).absolute()
        copy_home = destination / "home"
        if self.home == copy_home or self.home.is_relative_to(copy_home):
            raise ValueError("preview HOME must not contain the real HOME")
        # Check each component without following links before creating any output.
        for component in reversed((destination, *destination.parents)):
            try:
                info = component.lstat()
            except FileNotFoundError:
                if component != destination:
                    raise
                continue
            if not stat.S_ISDIR(info.st_mode):
                raise ValueError("preview DIR must be a directory with no symlinked components")
        output = SafeHome(Path(destination.anchor))
        relative = str(destination.relative_to(destination.anchor))
        # Only DIR itself may be created: missing ancestors are outside its scope.
        with output.parent(relative) as (directory, leaf):
            try:
                os.mkdir(leaf, mode=0o700, dir_fd=directory)
            except FileExistsError:
                pass
        info = destination.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != 0o700):
            raise ValueError("preview DIR must be owned by the user with mode 0700")
        if output.names(relative):
            raise ValueError("preview DIR must be empty")
        output.directory(relative + "/home", create=True)
        self.real_safe = self.safe
        copy = SafeHome(copy_home)
        units = self.d.host_units(self.name) | self.unit_owned
        if any(Path(name).name != name or not name.endswith((".timer", ".service")) for name in units):
            raise ValueError("invalid unit ownership record")
        paths = set(RENDERED_FILES) | {f".config/systemd/user/{name}" for name in units}
        if self.kache_declared():
            paths.add(".config/kache/config.toml")
        for path in self.owned - paths:
            if Path(path).parent != Path(".config/systemd/user") or Path(path).suffix not in (".timer", ".service"):
                raise ValueError("unrecognized managed file in state")
        paths |= self.owned
        # Existing backups also matter to an accurate first-run preview.
        paths |= {path + ".pre-fleet-sync" for path in paths}
        before = {}
        for path in sorted(paths):
            data = self.real_safe.read(path)
            before[path] = data
            if data is not None:
                copy.save(path, data)
        link_before = {}
        for tool in self.d.tools.keys() | self.link_owned:
            path = f".local/bin/{tool}"
            try:
                target = self.real_safe.readlink(path)
            except ValueError:
                # Preserve regular-file conflicts so links() reports the real refusal.
                data = self.real_safe.read(path)
                before[path] = data
                copy.save(path, data)
            else:
                link_before[path] = target
                if target is not None:
                    copy.link(path, target)
        recorded = self.real_safe.read(".local/state/fleet-sync/links.json")
        if recorded is not None:
            copy.save(".local/state/fleet-sync/links.json", recorded)
        self.safe, self.previewing = copy, True
        try:
            self.item("agents", "deferred", "preview: using invoking checkout declarations; no release deployment")
            self.item("fabrig", "deferred", "preview: fabrig installer is not run")
            self.attempt("links", self.links)
            self.render()
            self.attempt("units", self.units)
            self.item("versions", "deferred", "not probed in preview; see --check")
            new = []
            for path, original in sorted(before.items()):
                rendered = copy.read(path)
                if original == rendered:
                    continue
                if original is None:
                    new.append(path)
                # Decode invalid text visibly without ever following a managed symlink.
                old_lines = (original or b"").decode(errors="backslashreplace").splitlines(keepends=True)
                new_lines = (rendered or b"").decode(errors="backslashreplace").splitlines(keepends=True)
                for line in difflib.unified_diff(old_lines, new_lines,
                        fromfile=str(self.home / path) if original is not None else "/dev/null",
                        tofile=str(copy_home / path) if rendered is not None else "/dev/null"):
                    sys.stdout.write(line if line.endswith("\n") else line + "\n\\ No newline at end of file\n")
            for path, original in sorted(link_before.items()):
                target = copy.readlink(path)
                if target != original:
                    print(f"link {self.home / path}: {original or '(absent)'} -> {target}")
                    if original is None:
                        new.append(path)
            print("New files:")
            for path in sorted(new):
                print(path)
        finally:
            self.safe, self.previewing = self.real_safe, False
        return self.finish(False)

    def run(self):
        inspecting = self.args.check or getattr(self.args, "preview", None) is not None
        if any(i["result"] == "failed" and not (inspecting and i["item"] == "agents")
               for i in self.state["items"]):
            return self.finish(False)
        try:
            hold = self.safe.read(".config/fleet-sync/hold")
        except (OSError, ValueError) as error:
            self.item("hold", "failed", str(error))
            return self.finish(False)
        if hold is not None:
            lines = hold.decode().splitlines()
            self.item("hold", "held", lines[0] if lines else "hold file exists")
            return self.finish(False)
        if getattr(self.args, "preview", None) is not None:
            return self.preview(self.args.preview)
        try:
            acquired = self.acquire()
        except (OSError, ValueError) as error:
            self.item("lock", "failed", str(error))
            return self.finish(False)
        if not acquired:
            if self.args.timer and not self.args.check:
                return 0
            return self.finish(False)
        try:
            if self.args.check:
                reason = self.backoff_reason()
                if reason:
                    self.item("backoff", "held", reason)
            if self.args.timer and not self.args.check and self.args.resume_fd is None:
                try:
                    if self.timer_wait():
                        return 0
                except (OSError, ValueError, subprocess.SubprocessError) as error:
                    self.item("backoff", "failed", str(error))
                    return self.finish()
            if self.args.resume_fd is None:
                self.attempt("agents", self.release)
            if self.args.check or not any(i["result"] == "failed" for i in self.state["items"]):
                self.attempt("fabrig", self.fabrig)
                self.attempt("links", self.links)
                self.render()
                if getattr(self.args, "provision", False):
                    self.provision()
                    if self.kache_bootstrapped:
                        self.attempt("kache:config", self.kache_config)
                self.attempt("units", self.units)
                if self.kache_bootstrapped:
                    self.attempt("kache:activation", self.start_kache)
                self.versions()
            return self.finish()
        finally:
            if self.lock_fd is not None:
                os.close(self.lock_fd)


def print_state(state, as_json):
    if as_json:
        print(json.dumps(state))
        return
    for item in state["items"]:
        if item["result"] != "ok":
            print(f"{item['result']:7} {item['item']}: {item['reason']}")
    counts = {result: sum(i["result"] == result for i in state["items"])
              for result in ("ok", "changed", "drift", "warn", "failed", "held", "busy", "deferred")}
    print(f"{state['host']}: " + ", ".join(f"{n} {r}" for r, n in counts.items() if n))


def status(args, declarations, name):
    def remote(host):
        try:
            result = run_child(["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5",
                                     "-o", "StrictHostKeyChecking=yes", "-o", "UpdateHostKeys=no",
                                     declarations.hosts[host]["ssh"], 'bash -lc "fleet-sync --check --json"'],
                                    timeout=60)
            if result.returncode not in (0, 1):
                raise ValueError(result.stderr.decode(errors="replace").strip() or f"ssh exited {result.returncode}")
            data = json.loads(result.stdout)
            if not isinstance(data, dict) or data.get("host") != host or not isinstance(data.get("items"), list):
                raise ValueError("invalid host response")
            for item in data["items"]:
                if not isinstance(item, dict) or not all(isinstance(item.get(key), str) for key in ("item", "result", "reason")):
                    raise ValueError("invalid item in host response")
            return data
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            return {"host": host, "unreachable": " ".join(str(error).split())[:600]}

    with concurrent.futures.ThreadPoolExecutor(max_workers=len(declarations.hosts)) as pool:
        try:
            futures = {host: pool.submit(remote, host) for host in declarations.hosts if host != name}
            states = {}
            if name is not None:
                local_args = argparse.Namespace(**vars(args))
                local_args.check, local_args.timer = True, False
                local = Runner(local_args, declarations, name)
                local.run()
                states[name] = local.state
            states.update({host: future.result() for host, future in futures.items()})
        except KeyboardInterrupt:
            terminate_children()
            raise
    rows = [states[host] for host in declarations.hosts]
    if args.json:
        print(json.dumps({"hosts": rows}))
    else:
        for row in rows:
            if "unreachable" in row:
                print(f"{row['host']}: unreachable ({row['unreachable']})")
                continue
            stamp = row.get("last_timer_end")
            try:
                age = f"{max(0, int((dt.datetime.now(dt.UTC) - dt.datetime.fromisoformat(stamp)).total_seconds()))}s" if stamp else "never"
            except (ValueError, TypeError):
                age = "unknown"
            problems = "; ".join(f"{i['result']} {i['item']}: {i['reason']}" for i in row["items"] if i["result"] != "ok")
            previous = row.get("previous_release")
            recovery = ""
            if isinstance(previous, str) and re.fullmatch(r"agents-[0-9a-f]{40}", previous):
                recovery = " recover=" + shlex.join(["ssh", declarations.hosts[row["host"]]["ssh"],
                    f'bash -lc "python3 -I ~/src/fabrig/releases/{previous}/tools/fleet-sync"'])
            print(f"{row['host']}: agents={row.get('agents_sha') or '?'} fabrig={row.get('fabrig_sha') or '?'} timer-age={age} previous={previous or 'none'} {problems or 'ok'}{recovery}")
    return int(any("unreachable" in r or any(i["result"] in ("drift", "failed") for i in r.get("items", [])) for r in rows))


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", nargs="?", choices=["status"])
    parser.add_argument("--provision", action="store_true", help="explicitly install pinned tools (never in timer)")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--timer", action="store_true")
    parser.add_argument("--preview", metavar="DIR", help="render changes into DIR/home without deployment")
    parser.add_argument("--host")
    parser.add_argument("--self-check", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--resume-fd", type=int, help=argparse.SUPPRESS)
    args = parser.parse_args()
    smoke_fd = os.environ.pop("FLEET_SYNC_SMOKE_FD", None)
    args.smoke_fd = int(smoke_fd) if smoke_fd is not None else None
    if args.smoke_fd is not None and not args.check:
        parser.error("smoke lock requires --check")
    if args.provision and (args.command or args.check or args.timer or args.preview is not None
                           or args.self_check or args.smoke_fd is not None):
        parser.error("--provision accepts only --host and --json")
    if args.preview is not None and (args.command or args.check or args.timer or args.json or args.self_check
                                     or args.resume_fd is not None or args.smoke_fd is not None):
        parser.error("--preview accepts only --host")
    if args.command and (args.check or args.timer or args.self_check or args.resume_fd is not None):
        parser.error("status accepts only --json and --host")
    try:
        declarations = Declarations(ROOT, Path.home())
        name = declarations.host(args.host, allow_unknown=bool(args.command))
    except (OSError, ValueError, KeyError, TypeError) as error:
        parser.error(str(error))
    if args.self_check:
        return 0
    if args.command:
        return status(args, declarations, name)
    handoff = os.environ.pop("FLEET_SYNC_HANDOFF", None)
    if (args.resume_fd is None) != (handoff is None) or (args.resume_fd is not None and args.check):
        parser.error("invalid release handoff")
    runner = Runner(args, declarations, name, json.loads(handoff) if handoff else None)
    code = runner.run()
    if not runner.waiting and not (args.timer and not runner.state["items"]):
        print_state(runner.state, args.json)
    return code


if __name__ == "__main__":
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, interrupt_run)
    try:
        sys.exit(main())
    except KeyboardInterrupt as error:
        sys.exit(getattr(error, "exit_code", 130))
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"fleet-sync: {error}", file=sys.stderr)
        sys.exit(1)
