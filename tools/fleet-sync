class CommandError(ValueError):
    def __init__(self, code, reason):
        super().__init__(reason)
        self.code = code


class RunInterrupted(KeyboardInterrupt):
    def __init__(self, signum):
        self.exit_code = 130 if signum == signal.SIGINT else 143


def interrupt_run(signum, frame):
    if threading.get_ident() not in CLEANUP_THREADS:
        raise RunInterrupted(signum)


def now():
    return dt.datetime.now(dt.UTC).isoformat()


def terminate_group(process):
    identity = threading.get_ident()
    CLEANUP_THREADS.add(identity)
    try:
        deadline = time.monotonic() + 5
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
        # A descendant can outlive its parent and close its inherited pipes.
        try:
            os.killpg(process.pid, 0)
        except ProcessLookupError:
            pass
        else:
            time.sleep(max(0, deadline - time.monotonic()))
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        process.wait()
    finally:
        CLEANUP_THREADS.discard(identity)


def terminate_children():
    with CHILDREN_LOCK:
        children = list(ACTIVE_CHILDREN)
    for process in children:
        terminate_group(process)


def run_child(argv, timeout, env=None, pass_fds=(), stdout=subprocess.PIPE):
    process = subprocess.Popen([str(v) for v in argv], stdin=subprocess.DEVNULL,
                               stdout=stdout, stderr=subprocess.PIPE,
                               start_new_session=True, env=env, pass_fds=pass_fds)
    try:
        with CHILDREN_LOCK:
            ACTIVE_CHILDREN.add(process)
        out, err = process.communicate(timeout=timeout)
    except (subprocess.TimeoutExpired, KeyboardInterrupt):
        terminate_group(process)
        process.communicate()
        raise
    finally:
        with CHILDREN_LOCK:
            ACTIVE_CHILDREN.discard(process)
    return subprocess.CompletedProcess(argv, process.returncode, out or b"", err)


def read_json(path, default):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as stream:
            if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
                raise ValueError(f"not a regular file: {path}")
            return json.loads(stream.read())
    except FileNotFoundError:
        return default


class SafeHome:
    """Resolve HOME paths through pinned directory descriptors, never symlinks."""
    def __init__(self, home):
        self.home = home

    @contextmanager
    def parent(self, relative, create=False):
        parts = Path(relative).parts
        if not parts or Path(relative).is_absolute() or ".." in parts:
            raise ValueError(f"invalid HOME path: {relative}")
        fd = os.open(self.home, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            for part in parts[:-1]:
                try:
                    child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                except FileNotFoundError:
                    if not create:
                        raise
                    try:
                        os.mkdir(part, mode=0o700, dir_fd=fd)
                    except FileExistsError:
                        pass
                    child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                except OSError as error:
                    raise ValueError(f"refusing symlink or non-directory parent: {relative}") from error
                os.close(fd)
                fd = child
            yield fd, parts[-1]
        finally:
            os.close(fd)

    def open_regular(self, directory, leaf, flags=os.O_RDONLY, mode=0o600):
        try:
            fd = os.open(leaf, flags | os.O_NONBLOCK | os.O_NOFOLLOW, mode, dir_fd=directory)
        except OSError as error:
            if error.errno == errno.ELOOP:
                raise ValueError(f"refusing symlink: {leaf}") from error
            raise
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            os.close(fd)
            raise ValueError(f"not a regular file: {leaf}")
        return fd

    def snapshot_at(self, directory, leaf):
        try:
            fd = self.open_regular(directory, leaf)
        except FileNotFoundError:
            return None, None
        with os.fdopen(fd, "rb") as stream:
            data = stream.read()
            info = os.fstat(stream.fileno())
        return data, (info.st_dev, info.st_ino, info.st_mtime_ns, info.st_size)

    def snapshot(self, relative):
        try:
            with self.parent(relative) as (directory, leaf):
                return self.snapshot_at(directory, leaf)
        except FileNotFoundError:
            return None, None

    def read(self, relative):
        return self.snapshot(relative)[0]

    def json(self, relative, default):
        data = self.read(relative)
        return default if data is None else json.loads(data)

    def stage(self, directory, leaf, data, mode):
        sibling = f".{leaf}.{secrets.token_hex(12)}"
        fd = self.open_regular(directory, sibling, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
        try:
            with os.fdopen(fd, "wb") as stream:
                os.fchmod(stream.fileno(), mode)
                stream.write(data)
                stream.flush()
                os.fsync(stream.fileno())
        except BaseException:
            os.unlink(sibling, dir_fd=directory)
            raise
        return sibling

    def commit(self, relative, snapshot, data, mode=0o600, backup=False):
        with self.parent(relative, create=True) as (directory, leaf):
            if self.snapshot_at(directory, leaf) != snapshot:
                return False
            if backup and snapshot[0] is not None:
                backup_leaf = leaf + ".pre-fleet-sync"
                backup_snapshot = self.snapshot_at(directory, backup_leaf)
                if backup_snapshot[0] is None:
                    sibling = self.stage(directory, backup_leaf, snapshot[0], mode)
                    try:
                        if self.snapshot_at(directory, leaf) != snapshot:
                            return False
                        if self.snapshot_at(directory, backup_leaf) == backup_snapshot:
                            os.replace(sibling, backup_leaf, src_dir_fd=directory, dst_dir_fd=directory)
                    finally:
                        try:
                            os.unlink(sibling, dir_fd=directory)
                        except FileNotFoundError:
                            pass
            sibling = self.stage(directory, leaf, data, mode)
            try:
                if self.snapshot_at(directory, leaf) != snapshot:
                    return False
                os.replace(sibling, leaf, src_dir_fd=directory, dst_dir_fd=directory)
                return True
            finally:
                try:
                    os.unlink(sibling, dir_fd=directory)
                except FileNotFoundError:
                    pass

    def save(self, relative, data, mode=0o600):
        data = data.encode() if isinstance(data, str) else data
        if not self.commit(relative, self.snapshot(relative), data, mode):
            raise ValueError(f"{relative}: busy; retry next run")
        with self.parent(relative) as (directory, _):
            os.fsync(directory)

    def directory(self, relative, create=False):
        with self.parent(str(relative) + "/.probe", create=create):
            pass

    def guard(self, relative):
        try:
            with self.parent(relative):
                pass
        except FileNotFoundError:
            pass

    def names(self, relative):
        try:
            with self.parent(relative + "/.probe") as (directory, _):
                return os.listdir(directory)
        except FileNotFoundError:
            return []

    def readlink(self, relative):
        try:
            with self.parent(relative) as (directory, leaf):
                info = os.stat(leaf, dir_fd=directory, follow_symlinks=False)
                if not stat.S_ISLNK(info.st_mode):
                    raise ValueError(f"refusing non-symlink: {relative}")
                return os.readlink(leaf, dir_fd=directory)
        except FileNotFoundError:
            return None

    def link(self, relative, target):
        with self.parent(relative, create=True) as (directory, leaf):
            self.readlink(relative)  # Refuse a non-symlink before any replacement.
            sibling = f".{leaf}.{secrets.token_hex(12)}"
            os.symlink(str(target), sibling, dir_fd=directory)
            try:
                self.readlink(relative)
                os.replace(sibling, leaf, src_dir_fd=directory, dst_dir_fd=directory)
            finally:
                try:
                    os.unlink(sibling, dir_fd=directory)
                except FileNotFoundError:
                    pass

    def unlink(self, relative):
        with self.parent(relative) as (directory, leaf):
            if self.snapshot_at(directory, leaf)[0] is not None:
                os.unlink(leaf, dir_fd=directory)


def expand(value, home):
    if not isinstance(value, str) or any(c in value for c in "\n\r\0"):
        raise ValueError("environment values must be single-line strings")
    if "$" in value.replace("$HOME", "") or re.search(r"\$HOME[A-Za-z_0-9]", value):
        raise ValueError("only $HOME expansion is allowed")
    return value.replace("$HOME", str(home))


def literal_env_value(value):
    if any(c.isspace() or c in "\"'\\$" for c in value):
        raise ValueError("env values cannot contain whitespace, quotes, backslashes or $ after expansion")
    return value


def env_value(value, home):
    return literal_env_value(expand(value, home))


def relative_asset(value):
    if (not isinstance(value, str) or not value or Path(value).is_absolute()
            or any(p in (".", "..") for p in value.split("/")) or "\\" in value):
        raise ValueError(f"invalid provision path: {value}")
    return value


def validate_install(name, install, version=None):
    kind = install.get("kind")
    if kind not in ("rustup", "tar", "binary", "opt-tar", "codex-package", "claude-script", "kache-source"):
        raise ValueError(f"invalid installer for {name}")
    required = {
        "rustup": ("toolchain", "profile", "components", "targets", "extra_toolchains"),
        "tar": ("member", "destination"), "binary": ("destination",),
        "opt-tar": ("release", "entrypoint"), "codex-package": ("release", "entrypoint"),
        "claude-script": (), "kache-source": ("repository", "rev", "patches", "destination"),
    }
    if any(key not in install for key in required[kind]):
        raise ValueError(f"incomplete installer for {name}")
    if "seed" in install:
        if install["seed"] != "peer" or kind not in ("binary", "opt-tar", "codex-package"):
            raise ValueError("invalid peer seed installer")
        expected = seed_location(name, version)
        expected_kind = "codex-package" if name == "codex" else "opt-tar" if name == "chromium" else "binary"
        if kind != expected_kind:
            raise ValueError("wrong installer kind for peer artifact")
        if kind != "binary" and install.get("entrypoint") != ("bin/codex" if name == "codex" else "usr/lib/chromium/chromium"):
            raise ValueError("wrong entrypoint for peer artifact")
        if install.get("source") != expected or install.get("destination", install.get("release")) != expected:
            raise ValueError("seed paths must name the allowlisted versioned artifact")
        if install.get("disagreement"):
            if name != "chromium" or not isinstance(install["disagreement"], str):
                raise ValueError("invalid seed disagreement")
            return
        if kind == "binary":
            if not re.fullmatch(r"[0-9a-f]{64}", install.get("sha256", "")):
                raise ValueError("peer file requires SHA256 pin")
            if not re.fullmatch(r"0[0-7]{3}", install.get("mode", "")):
                raise ValueError("peer file requires mode")
        elif install.get("manifest") != f"seeds/{name}.sha256":
            raise ValueError("peer tree requires its named manifest")
        if "seed_hosts" in install and (not isinstance(install["seed_hosts"], list) or not install["seed_hosts"]
                or not all(isinstance(host, str) and re.fullmatch(r"[a-z][a-z0-9-]*", host) for host in install["seed_hosts"])):
            raise ValueError("invalid seed host allowlist")
        if "url" in install and (not install["url"].startswith("https://")
                or not re.fullmatch(r"[0-9a-f]{64}", install.get("sha256", ""))):
            raise ValueError("optional upstream URL requires HTTPS and SHA256 pin")
        return
    downloads = [("musl_url", "musl_sha256")] if kind == "kache-source" else []
    if kind not in ("rustup", "kache-source"):
        downloads.append(("url", "sha256"))
    if kind == "claude-script":
        downloads.append(("payload_url", "payload_sha256"))
    for url, digest in downloads:
        for key in (url, digest):
            value = install[key]
            if not isinstance(value, str):
                raise ValueError(f"invalid {key} for {name}")
        if not install[url].startswith(("https://", "TODO-USER:")):
            raise ValueError(f"HTTPS download required for {name}")
        if not (re.fullmatch(r"[0-9a-f]{64}", install[digest]) or install[digest].startswith("TODO-USER:")):
            raise ValueError(f"SHA256 required for {name}")
    if kind == "kache-source":
        if not SHA.fullmatch(install["rev"]) or not install["repository"].startswith("https://"):
            raise ValueError("kache requires a pinned source commit over HTTPS")
        if install["patches"] != ["git-checkout-rev.patch", "upload-bound.patch"]:
            raise ValueError("kache requires the fleet patches in order")
    if kind == "rustup":
        if name != "rustc" or not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", install["toolchain"]):
            raise ValueError("invalid Rust toolchain")
        if install["profile"] not in ("minimal", "default", "complete"):
            raise ValueError("invalid Rust profile")
        for field in ("components", "targets", "extra_toolchains"):
            if not isinstance(install[field], list) or not all(re.fullmatch(r"[A-Za-z0-9_.-]+", v) for v in install[field]):
                raise ValueError(f"invalid Rust {field}")
    for key in ("member", "entrypoint", "destination", "release"):
        if key in install:
            relative_asset(install[key])
    if "destination" in install and not install["destination"].startswith((".local/bin/", ".local/opt/", ".cargo/bin/")):
        raise ValueError("provision destination outside tool directories")
    if "release" in install and not install["release"].startswith((".local/opt/", ".codex/packages/standalone/releases/")):
        raise ValueError("provision release outside tool directories")


def seed_location(name, version):
    if not isinstance(version, str) or not re.fullmatch(r"\d+(?:\.\d+){2,3}", version):
        raise ValueError("invalid peer seed version")
    paths = {
        "cargo-nextest": ".cargo/bin/cargo-nextest",
        "claude": f".local/share/claude/versions/{version}",
        "forgejo": f".local/opt/forgejo-{version}/forgejo",
        "forgejo-runner": f".local/opt/forgejo-runner-{version}/forgejo-runner",
        "chromium": f".local/opt/chromium-{version}",
        "codex": f".codex/packages/standalone/releases/{version}-x86_64-unknown-linux-musl",
    }
    if name not in paths:
        raise ValueError("not an allowlisted peer artifact")
    return paths[name]


def parse_seed_manifest(text):
    entries, modes = {}, {}
    for line in text.splitlines():
        if not line or line.startswith("#"):
            continue
        header, sep, path = line.partition("  ")
        if not sep:
            raise ValueError("invalid seed manifest line")
        if header.startswith("symlink "):
            path, target = json.loads(path)
            row = {"type": "link", "mode": int(header.split()[1], 8), "target": target}
            if (not isinstance(target, str) or not target or Path(target).is_absolute()
                    or any(c in target for c in "\r\n\0")):
                raise ValueError("invalid seed symlink target")
            resolved = posixpath.normpath(posixpath.join(posixpath.dirname(path), target))
            if resolved == ".." or resolved.startswith("../"):
                raise ValueError("seed symlink escapes tree")
        elif header.startswith("directory "):
            row = {"type": "dir", "mode": int(header.split()[1], 8)}
        elif header.startswith("mode "):
            if path in modes:
                raise ValueError("duplicate seed mode")
            modes[path] = int(header.split()[1], 8)
            continue
        elif re.fullmatch(r"[0-9a-f]{64}", header):
            row = {"type": "file", "sha256": header}
        else:
            raise ValueError("invalid seed manifest record")
        if path != ".":
            relative_asset(path)
            if posixpath.normpath(path) != path:
                raise ValueError("seed paths must be canonical")
        if any(c in path for c in "\r\n\0") or path in entries:
            raise ValueError("invalid or duplicate seed path")
        entries[path] = row
    if entries.get(".", {}).get("type") != "dir":
        raise ValueError("seed tree needs root directory metadata")
    if set(modes) != {p for p, row in entries.items() if row["type"] == "file"}:
        raise ValueError("seed files need exactly one mode")
    for path, row in entries.items():
        if row["type"] == "file":
            row["mode"] = modes[path]
        if not 0 <= row["mode"] <= 0o777 or (row["type"] == "link" and row["mode"] != 0o777):
            raise ValueError("unsafe seed mode")
        for parent in Path(path).parents if path != "." else ():
            if entries.get(str(parent), {}).get("type") != "dir":
                raise ValueError("seed path has a missing or symlink parent")
    return entries


def seed_entries(root, install):
    if install["kind"] == "binary":
        return {"payload": {"type": "file", "sha256": install["sha256"], "mode": int(install["mode"], 8)}}
    entries = parse_seed_manifest((root / "fleet" / install["manifest"]).read_text())
    forbidden = {"auth.json", ".credentials.json", ".claude.json", "store.env", "state.json",
                 "sessions", "logins", ".ssh", ".claude"}
    if any(set(Path(path).parts) & forbidden for path in entries):
        raise ValueError("auth/state path is not a seed artifact")
    return entries


# Peer transfer opens only explicitly pinned artifacts through no-follow directory
# descriptors. No recursive tar of HOME/config, unknown extra file or credential
# can enter the stream. Tar headers carry pinned names; receivers verify content.
SEED_EXPORT = r'''import io,json,os,stat,sys,tarfile
