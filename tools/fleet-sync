    "bootstrap/README.md", "bootstrap/inventory.md", "bootstrap/packages.txt",
    "bootstrap/root.sh", "bootstrap/user.sh", "bootstrap/bootstrap.py",
    "kache/README.md", "kache/build", "kache/git-checkout-rev.patch",
    "kache/upload-bound.patch", "kache/config.toml", "kache/remote.toml",
