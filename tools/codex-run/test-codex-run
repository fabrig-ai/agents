#!/usr/bin/env bash
# Test codex-run in an isolated workspace with fake Codex, post and units.
set -Eeuo pipefail
umask 077
trap 'echo "test-codex-run: failed at line $LINENO" >&2' ERR
started=$(date +%s.%N)
# Like case_runner.py: five minutes of tool hang patience; a unit runs
# several tools (and sometimes retries or an ExecStop), so allow a whole
# case. The supplied standalone baseline is 179 checks in 19 seconds.
HUNG_TOOL_S=300
HUNG_CASE_S=$((3 * HUNG_TOOL_S))
# This deadline is the subject of the TERM-ignoring callback case.
ON_STOP_TIMEOUT_S=1
kit=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
scratch_parent=$(cd "$kit/../.." && pwd -P)
t=$(mktemp -d "$scratch_parent/.test-codex-run.XXXXXX")
cleanup() {
    local file pid
    for file in "$DEV_ROOT"/fake/*.pid; do
        [[ -f $file && ! -f ${file%.pid}.ended ]] || continue
        read -r pid <"$file"
        kill "$pid" 2>/dev/null || true
    done
    rm -rf "$t"
}
export HOME=$t/home DEV_ROOT=$t/workspace POST_NAME=o/caller
export CODEX_RUN_RETRY_DELAYS='0 0 0'
mkdir -p "$HOME" "$DEV_ROOT/fake" "$t/bin" "$t/reports" "$t/work dir" "$t/fabrig/tools/codex-run" "$t/fabrig/tools/slots"
trap cleanup EXIT
cp "$kit/codex-run" "$t/fabrig/tools/codex-run/codex-run"
cp "$kit/final.py" "$t/fabrig/tools/codex-run/final.py"
cp "$kit/../slots/lifetime.py" "$t/fabrig/tools/slots/lifetime.py"
kit=$t/fabrig/tools/codex-run
# No host directory is searchable, including when a service fake is removed.
for tool in awk bash cat chmod cmp cp cut date dirname env flock grep head jq ln mkdir mkfifo \
    mv od perl python3 readlink realpath rm rmdir sed setsid sleep stat systemd-escape tail timeout touch tr true wc; do
    [[ -x /usr/bin/$tool ]]
    ln -s "/usr/bin/$tool" "$t/bin/$tool"
done
export PATH=$t/bin
export BASH_ENV=$t/service-env
printf 'fixture_path=%q\nfixture_audit=%q\n' "$PATH" "$t/isolation-audit" >"$BASH_ENV"
cat >>"$BASH_ENV" <<'AUDIT'
# Independent of producer calls: abort before shell code can use a host PATH.
if [[ $PATH != "$fixture_path" ]]; then
    printf 'UNSAFE PATH %s\n' "$PATH" >>"$fixture_audit"
    exit 99
fi
fixture_reap=missing fixture_systemctl=missing
[[ ! -x $fixture_path/reap ]] || fixture_reap=stub
[[ ! -x $fixture_path/systemctl ]] || fixture_systemctl=stub
printf '%s\t%s\t%s\t%s\t%s\n' "$BASHPID" "$PATH" "$fixture_reap" "$fixture_systemctl" "$0" >>"$fixture_audit"
AUDIT
fake=$DEV_ROOT/fake
export CODEX_RUN_FIXTURE_ROOT=$DEV_ROOT
# A monitor notifies only after publishing its ended marker. Keep a reader
# open so a fast unit can finish before wait_unit starts reading.
mkfifo "$fake/unit-events" "$fake/pause-release"
exec {unit_events}<>"$fake/unit-events"
# Pause until the signal case ends this child, regardless of host scheduling.
# A reader held open also lets the child open its end without a handshake.
exec {pause_release}<>"$fake/pause-release"
printf 'Implement the fixture task.\n' >"$t/task file.md"
printf 'Own the fixture tasks.\n' >"$t/brief.md"

# The fixture's login profile supplies PATH; the launcher must not forward it.
printf 'export PATH=%q\n' "$t/bin" >"$HOME/.bash_profile"
cat >"$t/bin/systemd-run.python" <<'FAKE'
#!/usr/bin/python3 -IS
import os, pathlib, shlex, signal, subprocess, sys
args = sys.argv[1:]
fixture = pathlib.Path(os.environ.get('DEV_ROOT') or os.environ['CODEX_RUN_FIXTURE_ROOT']).resolve() / 'fake'
(fixture / 'launch.args').write_bytes(b'\0'.join(os.fsencode(a) for a in args) + b'\0')
if (fixture / 'launch-fail').exists():
    sys.exit('fixture launch failed')
env = {key: os.environ[key] for key in ('HOME', 'PATH', 'BASH_ENV')}
unit = ''
stop = None
assert '--service-type=exec' in args
while args:
    arg = args.pop(0)
    if arg in ('--user', '--collect', '--quiet', '--service-type=exec'):
        continue
    if arg == '--unit':
        unit = args.pop(0)
    elif arg.startswith('--property='):
        assert stop is None and arg.startswith('--property=ExecStop=-'), arg
        stop = arg[len('--property=ExecStop=-'):]
        (fixture / 'stop.property').write_text(stop)
    elif arg.startswith('--setenv='):
        key, value = arg[len('--setenv='):].split('=', 1)
        assert key in ('DEV_ROOT', 'CODEX_RUN_RETRY_DELAYS'), key
        env[key] = value
    else:
        args.insert(0, arg)
        break
assert args[:3] == ['bash', '-lc', 'exec "$0" "$@"']
stop_args = None
if stop is not None:
    # Only the quoted tokens our launcher emits: check syntax AND decoded argv.
    expected = [args[3], '_stop', args[5]]
    assert stop == ' '.join('"' + token + '"' for token in expected), stop
    stop_args = shlex.split(stop)
    assert stop_args == expected, stop_args
    (fixture / 'stop.argv').write_text(repr(stop_args))
# Emulate exec's launch-time refusal, including a removed worker executable.
if (fixture / 'missing-executable').exists():
    args[3] = str(fixture / 'missing-worker')
if not os.access(args[3], os.X_OK):
    sys.exit('worker executable missing')
if (fixture / 'hold-launch').exists():
    sys.exit(0)
# A private profile emulates the login environment without using real tools/state.
command = ['/bin/bash', '--noprofile', '--norc', '-c',
           'source "$HOME/.bash_profile"; exec "$0" "$@"', *args[3:]]
# A unit starts with default signal dispositions, also when this fixture runs
# as a background job, which ignores SIGINT and SIGQUIT.
signal.signal(signal.SIGINT, signal.SIG_DFL)
signal.signal(signal.SIGQUIT, signal.SIG_DFL)
with (fixture / (unit + '.log')).open('wb') as log:
    pid = os.fork()
    if pid == 0:
        orphan_story = ((fixture / 'scenario').exists() and
                        (fixture / 'scenario').read_text().strip() == 'orphan')
        if orphan_story:
            import ctypes
            assert ctypes.CDLL(None).prctl(36, 1, 0, 0, 0) == 0
            signal.signal(signal.SIGTERM, lambda sig, frame:
                          (fixture / (unit + '.manager-signal')).write_text(str(sig)))
        os.dup2(log.fileno(), 1)
        os.dup2(log.fileno(), 2)
        proc = subprocess.Popen(command, env=env, stdin=subprocess.DEVNULL,
                                stdout=log, stderr=log, start_new_session=True)
        (fixture / (unit + '.pid')).write_text(str(proc.pid) + '\n')
        status = proc.wait()
        if orphan_story:
            while True:
                try:
                    os.waitpid(-1, 0)
                except ChildProcessError:
                    break
        if stop_args is not None:
            subprocess.run(stop_args, env=env, stdin=subprocess.DEVNULL,
                           stdout=log, stderr=log, check=True)
        (fixture / (unit + '.ended')).write_text(str(status) + '\n')
        fd = os.open(fixture / 'unit-events', os.O_WRONLY | os.O_NONBLOCK)
        os.write(fd, (unit + '\n').encode())
        os.close(fd)
        os._exit(0)
FAKE
