#!/bin/bash
set -euo pipefail
fixture=${DEV_ROOT:-$CODEX_RUN_FIXTURE_ROOT}/fake
if [[ -f $fixture/scenario && $(<"$fixture/scenario") == orphan ||
      -f $fixture/scenario && $(<"$fixture/scenario") == pause ]]; then
    exec /usr/bin/python3 -I -S "${BASH_SOURCE[0]}.python" "$@"
fi
printf '%s\0' "$@" >"$fixture/launch.args"
[[ ! -f $fixture/launch-fail ]] || { echo 'fixture launch failed' >&2; exit 1; }
envs=("HOME=$HOME" "PATH=$PATH" "BASH_ENV=$BASH_ENV")
unit='' stop='' stop_set=0 service=0
while (($#)); do
    case $1 in
        --user|--collect|--quiet) shift ;;
        --service-type=exec) service=1; shift ;;
        --unit) unit=$2; shift 2 ;;
        --property=*)
            [[ $stop_set == 0 && $1 == --property=ExecStop=-* ]]
            stop_set=1
            stop=${1#--property=ExecStop=-}
            printf '%s' "$stop" >"$fixture/stop.property"
            shift ;;
        --setenv=*)
            value=${1#--setenv=}; [[ $value == *=* ]]; key=${value%%=*}
            [[ $key == DEV_ROOT || $key == CODEX_RUN_RETRY_DELAYS ]]
            envs+=("$value"); shift ;;
        *) break ;;
    esac
done
[[ $service == 1 && $1 == bash && $2 == -lc && $3 == 'exec "$0" "$@"' ]]
shift 3
stop_args=()
if ((stop_set)); then
    stop_args=("$1" _stop "$3")
    printf -v expected '"%s" "%s" "%s"' "${stop_args[@]}"
    [[ $stop == "$expected" ]]
    # The exact quoted property is checked above; these tokens are its argv.
    printf "['%s', '%s', '%s']" "${stop_args[@]}" >"$fixture/stop.argv"
fi
worker=$1; shift
[[ ! -f $fixture/missing-executable ]] || worker=$fixture/missing-worker
[[ -x $worker ]] || { echo 'worker executable missing' >&2; exit 1; }
[[ ! -f $fixture/hold-launch ]] || exit 0
(
    # env restores default dispositions even when the fixture is a background
    # job. setsid execs the worker in its own process group, preserving its PID.
    env -i --default-signal=INT --default-signal=QUIT "${envs[@]}" \
        setsid /bin/bash --noprofile --norc -c \
        'source "$HOME/.bash_profile"; exec "$0" "$@"' "$worker" "$@" </dev/null &
    pid=$!
    printf '%s\n' "$pid" >"$fixture/$unit.pid"
    status=0
    wait "$pid" || status=$?
    if ((${#stop_args[@]})); then
        env -i "${envs[@]}" "${stop_args[@]}" </dev/null
    fi
    printf '%s\n' "$status" >"$fixture/$unit.ended"
    printf '%s\n' "$unit" >"$fixture/unit-events"
) >"$fixture/$unit.log" 2>&1 &
FAKE
