cat >"$t/bin/fixture-json" <<'FAKE'
json_string() {
    local value=$1 control escaped octal number
    # Bash substitutions copy the whole string for each control byte. Keep
    # ordinary argv in the shell and escape large fixture bodies in one pass.
    # Perl is independent of the jq/Python parsers checking these recordings.
    if ((${#value} > 8192)); then
        printf '%s' "$value" | perl -0777 -pe '
            BEGIN { print "\"" }
            s/(["\\\x00-\x1f])/sprintf("\\u%04x", ord($1))/ge;
            END { print "\"" }
        '
        return
    fi
    if [[ $value == *[[:cntrl:]]* || $value == *\\* || $value == *\"* ]]; then
        value=${value//\\/\\\\}; value=${value//\"/\\\"}
        value=${value//$'\n'/\\n}; value=${value//$'\r'/\\r}; value=${value//$'\t'/\\t}
        if [[ $value == *[$'\001'-$'\037']* ]]; then
            for ((number=1; number<32; number++)); do
                printf -v octal '%03o' "$number"
                printf -v control '%b' "\\$octal"
                printf -v escaped '\\u%04x' "$number"
                value=${value//"$control"/"$escaped"}
            done
        fi
    fi
    printf '"%s"' "$value"
}
json_call() {
    local body=$1 argument separator=''
    shift
    printf '{"args":['
    for argument in "$@"; do
        printf '%s' "$separator"; json_string "$argument"; separator=,
    done
    printf ']'
    if [[ $body == body ]]; then
        [[ -f ${!#} && -r ${!#} ]] || return 1
        # A sentinel preserves trailing newlines across command substitution.
        # Bulk reads avoid Bash read's byte-at-a-time handling of long input.
        body=$(cat -- "${!#}" && printf .) || return
        body=${body%.}
        printf ',"body":'; json_string "$body"
    fi
    printf '}\n'
}
FAKE
