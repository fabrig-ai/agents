# fleet-sync: start-once
[Unit]
Description=End the rung walks on the held logins' machine (tools/qa/qa.md)

[Service]
Type=exec
WorkingDirectory=%h
ExecStart=/bin/bash -lc 'exec "$$HOME/src/fabrig/current/tools/qa/qa" watch --director "$$1"' qa-watch s/qa@hel8
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
