+#[test]
+fn remote_upload_max_bytes_defaults_and_respects_env_file_and_ignore_env() {
+    let _lock = config_path_lock();
+    let _env = set_env_for_test("KACHE_REMOTE_UPLOAD_MAX_BYTES", None);
+    let missing: Result<FileConfig> = Ok(toml::from_str("").unwrap());
+    assert_eq!(Config::remote_upload_max_bytes(&missing), 0);
+    let file: Result<FileConfig> =
+        Ok(toml::from_str("[cache]\nremote_upload_max_bytes = 67108864\n").unwrap());
+    assert_eq!(Config::remote_upload_max_bytes(&file), 67108864);
+    {
+        let _override = set_env_for_test("KACHE_REMOTE_UPLOAD_MAX_BYTES", Some("42".as_ref()));
+        assert_eq!(Config::remote_upload_max_bytes(&file), 42);
+        let ignored: Result<FileConfig> = Ok(toml::from_str(
+            "[cache]\nignore_env = true\nremote_upload_max_bytes = 9\n",
+        )
+        .unwrap());
+        assert_eq!(Config::remote_upload_max_bytes(&ignored), 9);
+    }
+    {
+        let _unlimited = set_env_for_test("KACHE_REMOTE_UPLOAD_MAX_BYTES", Some("0".as_ref()));
+        assert_eq!(Config::remote_upload_max_bytes(&file), 0);
+    }
+    {
+        let _invalid = set_env_for_test("KACHE_REMOTE_UPLOAD_MAX_BYTES", Some("invalid".as_ref()));
+        assert_eq!(Config::remote_upload_max_bytes(&file), 67108864);
+    }
+}
