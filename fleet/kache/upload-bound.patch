+#[derive(Debug, Serialize, Deserialize)]
+struct UploadIntent {
+    #[serde(flatten)]
+    job: UploadJob,
+    #[serde(default)]
+    attempts: u32,
+    // Legacy intents start their age at replay, and that timestamp is then durable.
+    #[serde(default = "unix_time_ms")]
+    first_written_at_ms: u64,
+}
+
+impl UploadIntent {
+    fn new(job: UploadJob) -> Self {
+        Self {
+            job,
+            attempts: 0,
+            first_written_at_ms: unix_time_ms(),
+        }
+    }
+
+    fn exhausted(&self) -> bool {
+        self.attempts >= crate::remote_resilience::UPLOAD_MAX_ATTEMPTS
+            || unix_time_ms().saturating_sub(self.first_written_at_ms)
+                >= crate::remote_resilience::UPLOAD_MAX_AGE.as_millis() as u64
+    }
+
+    fn save(&self, config: &Config) -> Result<()> {
+        let path = upload_spool_path(config, &self.job.key);
+        crate::atomic::atomic_replace(&path, &serde_json::to_vec(self)?)?;
+        // atomic_replace fsyncs the file but treats directory fsync as best effort.
+        crate::atomic::fsync_dir(config.upload_spool_dir().as_path())
+            .context("flushing upload retry budget")
+    }
+}
+
+fn read_upload_intent(config: &Config, key: &str) -> Result<UploadIntent> {
+    serde_json::from_slice(&std::fs::read(upload_spool_path(config, key))?)
+        .context("reading upload retry budget")
+}
+
 fn upload_spool_path(config: &Config, key: &str) -> PathBuf {
     config.upload_spool_dir().join(format!("{key}.json"))
 }
