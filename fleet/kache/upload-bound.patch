+
+    struct Backend {
+        heads: AtomicU64,
+        puts: AtomicU64,
+        fail: bool,
+    }
+
+    #[async_trait::async_trait]
+    impl crate::remote_backend::RemoteBackend for Backend {
+        async fn head(&self, _key: &str) -> Result<bool> {
+            self.heads.fetch_add(1, Ordering::SeqCst);
+            if self.fail {
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::ConnectionReset,
+                    "upload refused",
+                )
+                .into());
+            }
+            Ok(false)
+        }
+        async fn get(
+            &self,
+            _key: &str,
+            _max_bytes: Option<u64>,
+        ) -> Result<Option<crate::remote_backend::GetObject>> {
+            panic!("upload must not GET")
+        }
+        async fn put(&self, _key: &str, _body: Vec<u8>, _content_type: Option<&str>) -> Result<()> {
+            self.puts.fetch_add(1, Ordering::SeqCst);
+            Ok(())
+        }
+        async fn put_if_absent(
+            &self,
+            key: &str,
+            body: Vec<u8>,
+            content_type: Option<&str>,
+        ) -> Result<crate::remote_backend::PutIfAbsentResult> {
+            self.put(key, body, content_type).await?;
+            Ok(crate::remote_backend::PutIfAbsentResult::Created)
+        }
+        async fn list(&self, _prefix: &str) -> Result<Vec<String>> {
+            Ok(Vec::new())
+        }
+        fn describe(&self, key: &str) -> String {
+            format!("upload-bound://{key}")
+        }
+    }
+
+    fn fixture(dir: &Path, fail: bool, max_bytes: u64) -> (Arc<Daemon>, Arc<Backend>, UploadJob) {
+        let backend = Arc::new(Backend {
+            heads: AtomicU64::new(0),
+            puts: AtomicU64::new(0),
+            fail,
+        });
+        let mut config = test_config(dir);
+        config.remote = Some(test_remote_config());
+        config.remote_upload_max_bytes = max_bytes;
+        let key = test_cache_key("bounded-upload");
+        seed_store_entry(&config, &key, "serde", dir);
+        let job = persist_upload_job(
+            &config,
+            &UploadJob {
+                key,
+                entry_dir: String::new(),
+                crate_name: "serde".into(),
+                client_epoch: 0,
+                client_version: None,
+            },
+        )
+        .unwrap();
+        let daemon = Arc::new(Daemon::new(config));
+        daemon.set_remote_backend_for_test(backend.clone());
+        (daemon, backend, job)
+    }
+
+    async fn retired(daemon: &Arc<Daemon>, job: &UploadJob) -> Response {
+        daemon.pending_uploads.write().await.insert(job.key.clone());
+        let response = tokio::time::timeout(Duration::from_secs(25), run_upload_job(daemon, job))
+            .await
+            .unwrap();
+        assert!(!upload_spool_path(&daemon.config, &job.key).exists());
+        assert!(daemon.pending_uploads.read().await.is_empty());
+        assert!(Store::open(&daemon.config).unwrap().contains(&job.key));
+        response
+    }
+
+    #[tokio::test]
+    async fn three_retryable_attempts_release_the_gc_pin() {
+        let dir = tempfile::tempdir().unwrap();
+        let (daemon, backend, job) = fixture(dir.path(), true, 0);
+        let mut small = daemon.config.clone();
+        small.max_size = 1;
+        let store = Store::open(&small).unwrap();
+        std::fs::remove_dir_all(dir.path().join(format!("{}-src", job.key))).unwrap();
+        store.set_last_accessed_for_test(&job.key, "-1 hour");
+        // Size GC cannot reclaim the entry while its intent pins it.
+        store.evict().unwrap();
+        assert!(store.contains(&job.key));
+        let response = retired(&daemon, &job).await;
+        assert!(response.error.unwrap().contains("budget exhausted"));
+        assert_eq!(backend.heads.load(Ordering::SeqCst), 3);
+        store.evict().unwrap();
+        assert!(!store.contains(&job.key));
+    }
+
+    #[tokio::test]
+    async fn retry_count_and_first_write_survive_restart_and_duplicate_submission() {
+        let dir = tempfile::tempdir().unwrap();
+        let (daemon, backend, job) = fixture(dir.path(), true, 0);
+        let original_time = read_upload_intent(&daemon.config, &job.key)
+            .unwrap()
+            .first_written_at_ms;
+        let worker_daemon = daemon.clone();
+        let worker_job = job.clone();
+        let worker = tokio::spawn(async move { run_upload_job(&worker_daemon, &worker_job).await });
+        tokio::time::timeout(Duration::from_secs(3), async {
+            loop {
+                if read_upload_intent(&daemon.config, &job.key)
+                    .unwrap()
+                    .attempts
+                    == 1
+                {
+                    break;
+                }
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .unwrap();
+        worker.abort();
+        assert!(worker.await.unwrap_err().is_cancelled());
+        persist_upload_job(&daemon.config, &job).unwrap();
+        let replayed = load_upload_jobs(&daemon.config).unwrap();
+        assert_eq!(replayed, vec![job.clone()]);
+        let saved = read_upload_intent(&daemon.config, &job.key).unwrap();
+        assert_eq!(saved.attempts, 1);
+        assert_eq!(saved.first_written_at_ms, original_time);
+        let restarted = Arc::new(Daemon::new(daemon.config.clone()));
+        restarted.set_remote_backend_for_test(backend.clone());
+        assert!(!retired(&restarted, &replayed[0]).await.ok);
+        assert_eq!(backend.heads.load(Ordering::SeqCst), 3);
+    }
+
+    #[tokio::test]
+    async fn age_expires_before_network_including_startup_replay() {
+        for replay in [false, true] {
+            let dir = tempfile::tempdir().unwrap();
+            let (daemon, backend, job) = fixture(dir.path(), true, 0);
+            let mut intent = read_upload_intent(&daemon.config, &job.key).unwrap();
+            intent.first_written_at_ms = unix_time_ms() - 31 * 60 * 1000;
+            intent.save(&daemon.config).unwrap();
+            let jobs = if replay {
+                load_upload_jobs(&daemon.config).unwrap()
+            } else {
+                vec![job]
+            };
+            assert!(!retired(&daemon, &jobs[0]).await.ok);
+            assert_eq!(backend.heads.load(Ordering::SeqCst), 0);
+        }
+    }
+
+    #[test]
+    fn legacy_intent_starts_at_replay_and_keeps_that_time_on_next_replay() {
+        let dir = tempfile::tempdir().unwrap();
+        let (daemon, _, job) = fixture(dir.path(), true, 0);
+        fs::write(
+            upload_spool_path(&daemon.config, &job.key),
+            serde_json::to_vec(&job).unwrap(),
+        )
+        .unwrap();
+        let before = unix_time_ms();
+        assert_eq!(load_upload_jobs(&daemon.config).unwrap(), vec![job.clone()]);
+        let intent = read_upload_intent(&daemon.config, &job.key).unwrap();
+        assert_eq!(intent.attempts, 0);
+        assert!(
+            intent.first_written_at_ms >= before && intent.first_written_at_ms <= unix_time_ms()
+        );
+        assert!(!intent.exhausted());
+        let bytes = fs::read(upload_spool_path(&daemon.config, &job.key)).unwrap();
+        assert_eq!(load_upload_jobs(&daemon.config).unwrap(), vec![job.clone()]);
+        assert_eq!(
+            fs::read(upload_spool_path(&daemon.config, &job.key)).unwrap(),
+            bytes
+        );
+    }
+
+    #[tokio::test]
+    async fn breaker_suppression_uses_age_but_no_attempts() {
+        let dir = tempfile::tempdir().unwrap();
+        let (daemon, backend, job) = fixture(dir.path(), true, 0);
+        for _ in 0..3 {
+            daemon.remote_breaker.note_failure("PUT", "degraded");
+        }
+        let mut intent = read_upload_intent(&daemon.config, &job.key).unwrap();
+        // Allow four suppressed attempts, then expire without waiting 30 minutes.
+        intent.first_written_at_ms = unix_time_ms() - 30 * 60 * 1000 + 16_000;
+        intent.save(&daemon.config).unwrap();
+        let worker_daemon = daemon.clone();
+        let worker_job = job.clone();
+        let worker = tokio::spawn(async move { retired(&worker_daemon, &worker_job).await });
+        tokio::time::timeout(Duration::from_secs(18), async {
+            loop {
+                if daemon
+                    .transfer_counters
+                    .uploads_suppressed
+                    .load(Ordering::Relaxed)
+                    >= 4
+                {
+                    break;
+                }
+                tokio::time::sleep(Duration::from_millis(20)).await;
+            }
+        })
+        .await
+        .unwrap();
+        assert!(
+            !worker.is_finished(),
+            "three suppressions must not exhaust the attempt budget"
+        );
+        let saved = read_upload_intent(&daemon.config, &job.key).unwrap();
+        assert_eq!(saved.attempts, 0);
+        assert_eq!(saved.first_written_at_ms, intent.first_written_at_ms);
+        let response = worker.await.unwrap();
+        assert!(response.error.unwrap().contains("budget exhausted"));
+        assert_eq!(backend.heads.load(Ordering::SeqCst), 0);
+    }
+
+    #[test]
+    fn replay_continues_after_bad_budget_or_legacy_stamp_failure() {
+        for bad_budget in [false, true] {
+            let dir = tempfile::tempdir().unwrap();
+            let (daemon, _, job) = fixture(dir.path(), true, 0);
+            let mut bytes = serde_json::to_value(&job).unwrap();
+            if bad_budget {
+                bytes["attempts"] = serde_json::json!("invalid");
+            }
+            fs::write(
+                upload_spool_path(&daemon.config, &job.key),
+                serde_json::to_vec(&bytes).unwrap(),
+            )
+            .unwrap();
+            let next_key = test_cache_key("next-replay-job");
+            seed_store_entry(&daemon.config, &next_key, "serde", dir.path());
+            let next = persist_upload_job(
+                &daemon.config,
+                &UploadJob {
+                    key: next_key,
+                    ..job.clone()
+                },
+            )
+            .unwrap();
+            let jobs = load_upload_jobs_with(&daemon.config, |_| {
+                Err(std::io::Error::from_raw_os_error(28).into())
+            })
+            .unwrap();
+            assert_eq!(jobs, vec![next]);
+            assert!(!upload_spool_path(&daemon.config, &job.key).exists());
+            assert!(Store::open(&daemon.config).unwrap().contains(&job.key));
+        }
+    }
+
+    #[tokio::test]
+    async fn oversized_pack_stays_local_without_put_and_zero_limit_uploads() {
+        for (limit, expected_puts) in [(1, 0), (0, 2)] {
+            let dir = tempfile::tempdir().unwrap();
+            let (daemon, backend, job) = fixture(dir.path(), false, limit);
+            let response = retired(&daemon, &job).await;
+            assert_eq!(response.ok, limit == 0);
+            if limit != 0 {
+                assert!(response.error.unwrap().starts_with("upload skipped:"));
+            }
+            assert_eq!(backend.puts.load(Ordering::SeqCst), expected_puts);
+        }
+    }
+}
