+    fn git_checkout_rules_share_keys_and_remapped_paths_across_revisions() {
+        let dir = TempDir::new().unwrap();
+        let home = dir.path().join("cargo");
+        for rev in ["abcdef0", "1234567"] {
+            let root = home.join("git/checkouts/project-01234567").join(rev);
+            let member = root.join("crates/member");
+            std::fs::create_dir_all(&member).unwrap();
+            let source = member.join("lib.rs");
+            let normalizer = pn_with_rules(vec![
+                (member.to_str().unwrap(), "<WORKSPACE>"),
+                (home.to_str().unwrap(), "<CARGO_HOME>"),
+            ])
+            .with_git_checkout(Some(&home), Some(&member));
+            assert_eq!(
+                normalizer.normalize(source.to_str().unwrap()),
+                "<GIT_CHECKOUT:project-01234567>/crates/member/lib.rs"
+            );
+            assert_eq!(
+                normalizer.source_path_identity(&source).unwrap(),
+                b"<GIT_CHECKOUT:project-01234567>/crates/member/lib.rs"
+            );
+            assert_eq!(
+                normalizer.remap_args().last().unwrap(),
+                &format!(
+                    "--remap-path-prefix={}=/kache/git/checkouts/project-01234567",
+                    root.display()
+                )
+            );
+            let roots = normalizer.depinfo_source_roots();
+            let checkout = roots.iter().find(|r| r.root == root).unwrap();
+            assert_eq!(checkout.depinfo_sentinel, "__kache_git_checkout__/");
+            assert_eq!(checkout.priority, 7);
+            // Matching a prefix of the revision is not a rustc remap.
+            assert!(
+                !normalizer
+                    .normalize(format!("{}f/lib.rs", root.display()))
+                    .contains("<GIT_CHECKOUT:")
+            );
+        }
+    }
