+/// A pin move changes Cargo's source path, but not a byte-identical unit's
+/// key. Values that can escape into the artifact must still bind the checkout.
+#[test]
+fn git_checkout_key_tracks_content_and_embedded_paths() {
+    let _lock = key_test_lock();
+    let dir = tempfile::tempdir().unwrap();
+    let home = dir.path().join("cargo");
+    let key = |rev: &str, code: &str, env_var: Option<&str>, skip_remap: bool| {
+        let member = home
+            .join("git/checkouts/project-01234567")
+            .join(rev)
+            .join("member");
+        std::fs::create_dir_all(&member).unwrap();
+        let source = member.join("lib.rs");
+        std::fs::write(&source, code).unwrap();
+        let mut args = RustcArgs::parse(&base_args(&source)).unwrap();
+        args.path_normalize_disabled = skip_remap;
+        let normalizer = PathNormalizer::empty().with_git_checkout(Some(&home), Some(&member));
+        let raw_path = member.to_str().unwrap();
+        provide_dep_info(
+            DepInfo {
+                source_files: vec![source],
+                env_deps: env_var
+                    .map(|var| vec![(var.into(), raw_path.into())])
+                    .unwrap_or_default(),
+            },
+            None,
+        );
+        compute_cache_key(&args, &FileHasher::new(), &normalizer, &KeyEnv::default()).unwrap()
+    };
+    let code = "pub fn value() -> u32 { 1 }";
+    let first = key("abcdef0", code, None, false);
+    assert_eq!(first, key("1234567", code, None, false));
+    assert_ne!(
+        first,
+        key("1234567", "pub fn value() -> u32 { 2 }", None, false)
+    );
+    for var in ["CARGO_MANIFEST_DIR", "CUSTOM_PATH"] {
+        assert_ne!(
+            key("abcdef0", code, Some(var), false),
+            key("1234567", code, Some(var), false),
+            "{var} may embed the revision in output"
+        );
+    }
+    assert_ne!(
+        key("abcdef0", code, None, true),
+        key("1234567", code, None, true),
+        "without rustc remapping the revision must remain keyed"
+    );
+}
+
+/// A revision-free git root is no longer an immutable Cargo package path:
+/// native archives there need their content folded, even with unchanged Rust.
+#[test]
+fn git_checkout_native_archives_are_content_keyed() {
+    let dir = tempfile::tempdir().unwrap();
+    let home = dir.path().join("cargo");
+    let member = home.join("git/checkouts/project-01234567/abcdef0/member");
+    let native = member.join("native");
+    std::fs::create_dir_all(&native).unwrap();
+    let normalizer = PathNormalizer::empty().with_git_checkout(Some(&home), Some(&member));
+    let context = unix_context("x86_64-unknown-linux-gnu", &normalizer);
+    let dirs = [native.clone()];
+    let args = unit_args("bin", &dir.path().join("deps"), &[]);
+    assert!(fold_rewrites(&native.join("libfoo.a"), || {
+        fold_inputs(&args, &dirs, &[], &context)
+    }));
+}
