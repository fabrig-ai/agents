+    /// Treat the active Cargo git revision as another checkout of the same
+    /// repository. Use the same rule for keys, rustc paths, and dep-info
+    /// restore; erasing the revision only in keys would reuse different bytes.
+    /// Env-dep values that may be embedded (notably CARGO_MANIFEST_DIR) still
+    /// retain their raw value through cache_key's existing safety checks.
+    pub(crate) fn with_git_checkout(
+        mut self,
+        cargo_home: Option<&Path>,
+        manifest_dir: Option<&Path>,
+    ) -> Self {
+        let Some((root, name)) = cargo_home
+            .zip(manifest_dir)
+            .and_then(|(home, manifest)| git_checkout_root(home, manifest))
+        else {
+            return self;
+        };
+        let sentinel = format!("<GIT_CHECKOUT:{name}>");
+        let mut rules = Vec::new();
+        push_path_rule_aliases(
+            &mut rules,
+            &mut self.source_restore_roots,
+            &root,
+            &sentinel,
+            &sentinel,
+        );
+        rules.append(&mut self.rules);
+        let mut seen = std::collections::HashSet::new();
+        rules.retain(|rule| seen.insert(rule.prefix.clone()));
+        self.rules = rules;
+        self
     }
 
