+/// Cargo owns this layout; only the revision component is discarded. Keep
+/// repository identity and the package's path within it. Unknown layouts fail
+/// closed to the ordinary CARGO_HOME rule (and therefore keep the revision).
+fn git_checkout_root(cargo_home: &Path, manifest_dir: &Path) -> Option<(PathBuf, String)> {
+    let checkouts = std::path::absolute(cargo_home).ok()?.join("git/checkouts");
+    let manifest = std::path::absolute(manifest_dir).ok()?;
+    let relative = manifest.strip_prefix(&checkouts).ok()?;
+    let mut components = relative.components();
+    let std::path::Component::Normal(name) = components.next()? else {
+        return None;
+    };
+    let std::path::Component::Normal(rev) = components.next()? else {
+        return None;
+    };
+    let rev = rev.to_str()?;
+    if !(7..=40).contains(&rev.len()) || !rev.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return None;
+    }
+    Some((checkouts.join(name).join(rev), name.to_str()?.to_string()))
+}
+
+fn git_checkout_name(sentinel: &str) -> Option<&str> {
+    sentinel.strip_prefix("<GIT_CHECKOUT:")?.strip_suffix('>')
+}
+
 fn depinfo_sentinel_for_source(source_sentinel: &str) -> Option<String> {
+    if git_checkout_name(source_sentinel).is_some() {
+        return Some("__kache_git_checkout__/".to_string());
+    }
     if let Some(index) = configured_base_dir_index(source_sentinel) {
         return Some(format!("__kache_base_dir_{index}__/"));
