def has_pquota(line):
    return any(t.startswith('rootflags=') and 'pquota' in t.split('=', 1)[1].split(',')
               for t in shlex.split(line))


class Pquota:
    def __init__(self, host, central='free@204.168.210.29', root=Path('/'), env=None, policy=None):
        self.host, self.central, self.root = host, central, Path(root)
        self.env = env or dict(PATH=PATH, LANG='C', LC_ALL='C')
        self.policy = policy or {}

    def path(self, absolute):
        return self.root / absolute.lstrip('/')

    def read(self, absolute):
        return self.path(absolute).read_text()

    def run(self, *args, returncodes=(0,)):
        result = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                timeout=60, env=self.env, check=False)
        if result.returncode not in returncodes:
            raise ValueError(f'{shlex.join(args)}: exit {result.returncode}: {result.stderr.strip()}')
        return result.stdout

    def user(self, *args, returncodes=(0,)):
        uid = pwd.getpwnam('free').pw_uid
        return self.run('runuser', '-u', 'free', '--', 'env', '-i', 'HOME=/home/free',
                        f'PATH=/home/free/.local/bin:{PATH}', f'XDG_RUNTIME_DIR=/run/user/{uid}',
                        f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus',
                        'LANG=C', *args, returncodes=returncodes)

    def safe(self, absolute):
        path = self.path(absolute)
        for parent in (path, *path.parents):
            if parent.is_symlink():
                raise ValueError(f'refusing symlink: {parent}')
        if path.exists() and not path.is_file():
            raise ValueError(f'not a regular file: {path}')
        return path

    def sync(self, directory):
        fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)

    def write(self, absolute, content, mode=0o600):
        path = self.safe(absolute)
        data = content.encode() if isinstance(content, str) else content
        if path.exists() and path.read_bytes() == data:
            if stat.S_IMODE(path.stat().st_mode) != mode:
                os.chmod(path, mode)
            return
        path.parent.mkdir(parents=True, exist_ok=True)
        fd, temporary = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
        try:
            with os.fdopen(fd, 'wb') as out:
                os.fchmod(out.fileno(), mode)
                out.write(data)
                out.flush()
                os.fsync(out.fileno())
            os.replace(temporary, path)
            self.sync(path.parent)
        finally:
            Path(temporary).unlink(missing_ok=True)

    @contextmanager
    def locked(self):
        path = self.safe('/var/lib/fabrig-pquota/lock')
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open('a') as stream:
            os.chmod(path, 0o600)
            fcntl.flock(stream, fcntl.LOCK_EX)
            yield

    def save(self, state):
        self.write(STATE, json.dumps(state, indent=2, sort_keys=True) + '\n')

    def state(self):
        state = json.loads(self.safe(STATE).read_text())
        if not isinstance(state, dict):
            raise ValueError('malformed pquota state')
        if state.get('version') != 1 or state.get('host') != self.host:
            raise ValueError('missing/foreign pquota state')
        return state

    def snapshot(self):
        command = shlex.join(('python3', '-I', '-B', '-c', CENTRAL_SNAPSHOT))
        data = json.loads(self.user('ssh', '-T', '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=yes',
            '-o', 'UpdateHostKeys=no', '-o', 'ConnectTimeout=10', self.central, command))
        if hashlib.sha256(data['declaration'].encode()).hexdigest() != data['digest']:
            raise ValueError('central inventory digest does not match declaration')
        pool = {}
        for line in data['declaration'].splitlines():
            fields = line.partition('#')[0].split()
            if not fields:
                continue
            host, *shares = fields
            if not shares:
                raise ValueError('empty central slot pool')
            for share in shares:
                number, sep, owner = share.partition('=')
                if not sep or not number.isdecimal() or int(number) < 1 or not owner:
                    raise ValueError('invalid central inventory share')
                pair = (host, str(int(number)))
                if pair in pool:
                    raise ValueError('duplicate central inventory slot')
                pool[pair] = owner
        rows = {}
        for line in data['listing'].splitlines():
            match = re.fullmatch(r'([a-z][a-z0-9-]*) ([1-9][0-9]*) \[([^\]\r\n]+)\]: (.+)', line)
            if not match:
                raise ValueError('unrecognized central claim list row')
            host, slot, share, detail = match.groups()
            pair = (host, slot)
            if pair in rows or pool.get(pair) != share:
                raise ValueError('claim list and inventory disagree')
            row = dict(slot=slot, share=share, owner=None, what=None, created=None)
            if detail != 'free':
                held = re.fullmatch(r'([^:]+): (.+) \(since ([^()]+)\); held [0-9]+d [0-9]{2}:[0-9]{2}:[0-9]{2}(?:; lent by .+)?', detail)
                if not held:
                    raise ValueError('unrecognized central claim detail')
                row.update(zip(('owner', 'what', 'created'), held.groups()))
            rows[pair] = row
        if not pool or rows.keys() != pool.keys():
            raise ValueError('empty/incomplete central claim list')
        selected = [row for (host, _), row in rows.items() if host == self.host]
        return dict(path=data['path'], digest=data['digest'], slots=selected, admission_closed=not selected)

    def approval(self, row, retained):
        reference = retained['post']
        path = self.policy.get('approval_files', {}).get(reference)
        if not path:
            raise ValueError(f'approval {reference}: explicit --approval-file required; no non-consuming post metadata API')
        raw = self.user('python3', '-I', '-B', '-c', READ_POST, path)
        message = Parser(policy=email_policy.default).parsestr(raw)
        if any(len(message.get_all(key, [])) != 1 for key in ('From', 'Id')):
            raise ValueError('approval requires exactly one From and Id header')
        sender = str(message['From']).strip()
        approver = retained['approver']
        if sender not in (approver, approver + '@hel8') or str(message['Id']).strip() != reference:
            raise ValueError('approval sender/Id mismatch')
        body = message.get_payload()
        fields = {}
        for key in ('slot', 'what', 'plan', 'service'):
            values = re.findall(r'^' + key + r': ([^\r\n]+)$', body, re.M)
            if len(values) != 1:
                raise ValueError(f'approval requires one {key}: line')
            fields[key] = values[0]
        if fields['slot'] != f'{self.host}:{row["slot"]}' or fields['what'] != row['what']:
            raise ValueError('approval slot/WHAT mismatch')
        if not re.search(r'preserv', fields['plan'], re.I) or not re.search(r'restart', fields['plan'], re.I):
            raise ValueError('approval plan must describe preservation and restart')
        service = self.policy.get('retained_services', {}).get(row['slot'])
        if fields['service'] != service or not service or not re.fullmatch(r'[a-zA-Z0-9_.@:-]+\.service', service):
            raise ValueError('approval service must match --retained-service')
        status = self.unit(service)
        if status['ActiveState'] != 'inactive':
            raise ValueError(f'retained service must be drained and inactive: {service}: {status}')
        return dict(post=reference, from_identity=sender, approver=approver,
            sha256=hashlib.sha256(raw.encode()).hexdigest(), plan=fields['plan'], service=service)

    def claims(self, display=False):
        snapshot = self.snapshot()
        print(f'central inventory {snapshot["path"]} sha256={snapshot["digest"]}') if display else None
        if display and snapshot['admission_closed']:
            print(f'PASS occupancy {self.host}: no eligible slots; pinned claim inventory rejects every acquisition')
        errors, held = [], []
        retained = {item['slot']: item for item in self.policy.get('retained_claims', [])}
        used = set()
        for row in snapshot['slots']:
            item = dict(row)
            try:
                if row['owner'] is None:
                    raise ValueError('FREE; ops maintenance claim missing')
                if row['slot'] in retained:
                    option = retained[row['slot']]
                    if row['owner'] != option['owner']:
                        raise ValueError('retained claim owner mismatch')
                    item['approval'] = self.approval(row, option)
                    item['kind'] = 'retained'
                    used.add(row['slot'])
                elif (self.policy.get('maintenance_owner') and self.policy.get('maintenance_what') and
                      row['owner'] == self.policy['maintenance_owner'] and row['what'] == self.policy['maintenance_what']):
                    item['kind'] = 'maintenance'
                else:
                    raise ValueError('foreign claim or wrong maintenance WHAT; bound retained approval missing')
                if display:
                    print(f'PASS occupancy {self.host}:{row["slot"]} [{row["share"]}] {row["owner"]}: {row["what"]} ({item["kind"]})')
                held.append(item)
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
                errors.append(f'{self.host}:{row["slot"]}: {error}')
                if display:
                    print(f'FAIL occupancy {self.host}:{row["slot"]} [{row["share"]}] {row["owner"]}: {row["what"]}: {error}')
        if self.policy.get('inventory_digest') != snapshot['digest']:
            errors.append('missing/changed --inventory-digest (covers entire host pool and share declaration)')
        if used != retained.keys():
            errors.append('retained option does not match a configured occupied slot')
        if errors:
            raise ValueError('; '.join(errors))
        return dict(path=snapshot['path'], digest=snapshot['digest'], slots=held, admission_closed=snapshot['admission_closed'])

    def unit(self, name, allow_absent=False):
        output = self.user('systemctl', '--user', 'show', '--property=' + ','.join(
            ('LoadState', 'ActiveState', 'SubState', 'UnitFileState', *GRAPH_FORWARD, *GRAPH_REVERSE, *HANDLER_MODES.values())), '--', name)
        row = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
        if allow_absent and row.get('LoadState') == 'not-found' and row.get('ActiveState') == 'inactive':
            return row
        if row.get('LoadState') != 'loaded' or row.get('ActiveState') not in ('active', 'inactive', 'failed'):
            raise ValueError(f'unreadable unit state: {name}')
        return row

    def nonclaim_writers(self):
        rows = json.loads(self.user('systemctl', '--user', 'list-units', '--all', '--type=service,scope',
                                   '--output=json', '--no-pager', '--'))
        if not isinstance(rows, list):
            raise ValueError('unreadable user unit status')
        busy = []
        for row in rows:
            name = row['unit']
            if name.startswith(('codex-run-', 'after-landing', 'agents-after-landing')) and row['active'] != 'inactive':
                busy.append(name)
            if name.startswith('skein-heavy-') and not re.fullmatch(r'skein-heavy-[0-9a-f]+-reconcile\.service', name):
                if row['active'] not in ('inactive', 'failed'):
                    busy.append(name)
        if busy:
            raise ValueError('live user scopes/writers: ' + ', '.join(busy))
        submitters = json.loads(self.user('python3', '-I', '-B', '-c', SUBMITTERS))
        if submitters:
            raise ValueError(f'heavy submitters/wrappers still present: {submitters}')
        return 'no heavy scopes/submitters or codex-run/after-landing units'

    def installed(self):
        result = json.loads(self.user('python3', '-I', '-B', '-c', INSTALLED_PROOF))
        if not re.fullmatch(r'[0-9a-f]{40,64}', result['fabrig_head']) or not result['start_once_units']:
            raise ValueError('installed source identity unavailable')
        if len(result['heavy_digests']) != 6 or any(not re.fullmatch(r'[0-9a-f]{64}', v) for v in result['heavy_digests'].values()):
            raise ValueError('installed heavy digest unavailable')
        return result

    def environment(self):
        result = json.loads(self.user('python3', '-I', '-B', '-c', MACHINE_ENV, json.dumps(sorted(MACHINE_KEYS))))
        if not isinstance(result, dict) or not result or not result.keys() <= MACHINE_KEYS or any(not isinstance(v, str) for v in result.values()):
            raise ValueError('invalid nonsecret machine.env summary')
        return result

    def services(self, installed=None):
        installed = installed or self.installed()
        rows = {name: self.unit(name, allow_absent=True) for name in installed['start_once_units']}
        retained = set(self.policy.get('retained_services', {}).values())
        for name in retained - rows.keys():
            rows[name] = self.unit(name)
        return dict(states=rows, owner_restarts=sorted(retained | {name for name, status in rows.items()
            if status['ActiveState'] == 'active'}))

    def boot_prevention(self, services):
        # Resolve both directions so reverse-only systemd evidence cannot hide a
        # startup edge. PartOf/ConsistsOf is conservatively treated as activation.
        producers = set(services['states'])
        roots = {'default.target'}
        pending = set(producers) | roots
        rows = json.loads(self.user('systemctl', '--user', 'list-unit-files', '--output=json', '--no-pager', '--'))
        if not isinstance(rows, list):
            raise ValueError('unreadable unit installation inventory')
        disabled = {'disabled', 'static', 'indirect', 'masked', 'masked-runtime'}
        boot_states = {'enabled', 'enabled-runtime', 'linked', 'linked-runtime', 'alias', 'generated'}
        evidence, graph = {}, {}
        for row in rows:
            name, state = row['unit_file'], row['state']
            if state not in disabled | boot_states:
                raise ValueError(f'unsupported unit installation state: {name}: {state}')
            if state in boot_states:
                roots.add(name)
                pending.add(name)
            if name.endswith(('.timer', '.path', '.socket')):
                pending.add(name)
        edges, handlers = set(), set()
        while pending:
            if len(evidence) >= GRAPH_LIMIT:
                raise ValueError('activation graph exceeds supported unit bound')
            name = sorted(pending)[0]
            pending.remove(name)
            if '@.' in name or not re.fullmatch(r'[a-zA-Z0-9_.@:-]+\.(service|target|timer|path|socket|slice|scope|mount|automount|device|swap)', name):
                raise ValueError(f'unsupported activation graph unit: {name}')
            status = self.unit(name, allow_absent=name in producers)
            if status['LoadState'] == 'not-found':
                # An absent declaration is safe only when no dependency or
                # trigger refers to it; incoming references are checked below.
                evidence[name] = dict(status=status, installation='not-found')
                continue
            required = {*GRAPH_FORWARD, *GRAPH_REVERSE, 'UnitFileState'}
            if not required <= status.keys():
                raise ValueError(f'incomplete activation graph properties: {name}')
            installed = self.user('systemctl', '--user', 'is-enabled', '--', name, returncodes=(0, 1)).strip()
            if installed not in disabled | boot_states or status['UnitFileState'] not in disabled | boot_states:
                raise ValueError(f'unresolved installation state: {name}')
            if installed in boot_states or status['UnitFileState'] in boot_states:
                roots.add(name)
            if name in producers and (installed not in disabled or status['UnitFileState'] not in disabled):
                raise ValueError(f'owner must disable {name} without --now before reboot')
            if name.endswith(('.timer', '.path', '.socket')) and status['ActiveState'] != 'inactive':
                roots.add(name)
            evidence[name] = dict(status=status, installation=installed)
            for key in GRAPH_FORWARD + GRAPH_REVERSE:
                for other in status[key].split():
                    source, destination = (name, other) if key in GRAPH_FORWARD else (other, name)
                    edges.add((source, destination))
                    event = key.removesuffix('Of')
                    if event in HANDLER_MODES:
                        handlers.add((source, destination, event))
                    if len(edges) > GRAPH_EDGE_LIMIT:
                        raise ValueError('activation graph exceeds supported edge bound')
                    graph.setdefault(source, set()).add(destination)
                    if other not in evidence:
                        pending.add(other)
        missing = {node for edge in edges for node in edge if evidence[node]['status']['LoadState'] != 'loaded'}
        if missing:
            raise ValueError(f'unresolved activation graph dependencies: {sorted(missing)}')
        for source, _, event in handlers:
            if evidence[source]['status'].get(HANDLER_MODES[event]) != 'replace':
                raise ValueError(f'unsupported {event} handler job mode: {source}')
        def reachable(seeds, reason):
            reached, paths = set(), {seed: [seed] for seed in seeds}
            todo = sorted(seeds)
            while todo:
                node = todo.pop(0)
                if node in reached:
                    continue
                reached.add(node)
                if node in producers:
                    raise ValueError(f'producer reachable through {reason}: ' + ' -> '.join(paths[node]))
                for other in sorted(graph.get(node, ())):
                    if other not in paths:
                        paths[other] = paths[node] + [other]
                    if other not in reached:
                        todo.append(other)
            return reached
        # Even an otherwise dormant handler route to a retained producer is
        # refused: success/failure can be delivered before owner readmission.
        handler_reached = reachable({destination for _, destination, _ in handlers}, 'success/failure handler')
        reached = reachable(roots, 'boot/active trigger')
        return dict(units=evidence, roots=sorted(roots), edges=[list(edge) for edge in sorted(edges)],
                    reached=sorted(reached), handlers=[list(edge) for edge in sorted(handlers)],
                    handler_reached=sorted(handler_reached), unit_bound=GRAPH_LIMIT, edge_bound=GRAPH_EDGE_LIMIT)

    def preboot(self):
        sources = self.installed()
        return dict(sources=sources, environment=self.environment(), services=self.services(sources),
                    boot_id=self.boot_id())

    def heavy(self):
        self.user('/home/free/src/fabrig/main/tools/heavy/heavy', '--installed')
        data = json.loads(self.user('python3', '-I', '-B', '-c', HEAVY_SNAPSHOT))
        if (not isinstance(data, dict) or data.get('version') != 1 or
                not data.get('installation') or not isinstance(data.get('tasks'), dict)):
            raise ValueError('missing/unsupported heavy installation snapshot')
        busy = []
        for token, task in data['tasks'].items():
            if not isinstance(task, dict) or not isinstance(task.get('state'), str):
                raise ValueError('malformed heavy task')
            if task['state'] != 'released' or task.get('release_complete', True) is not True or task.get('cgroup_empty', True) is not True:
                busy.append(f'{token}:{task["state"]}')
        if busy:
            raise ValueError('heavy unfinished tasks: ' + ', '.join(busy))
        return 'installed; zero unfinished tasks (atomic snapshot)'

    def marker(self):
        path = self.safe('/var/lib/fabrig-pquota/fence')
        info = path.stat()
        if info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError('ops marker must be root-owned and not group/world writable')
        fields = path.read_text().strip().split(None, 1)
        if len(fields) != 2 or fields[0] != self.host or not fields[1].strip():
            raise ValueError('ops marker must contain exact host and nonempty ops reason')
        return ' '.join(fields)

    def identity(self):
        hosts = tomllib.loads((Path(__file__).resolve().parents[1] / 'hosts.toml').read_text())['hosts']
        actual = socket.gethostname().split('.', 1)[0]
        if self.host not in hosts or actual not in (self.host, hosts[self.host]['hostname']):
            raise ValueError(f'host mismatch: requested {self.host}, actual {actual}')
        return actual

    def mount(self):
        data = json.loads(self.run('findmnt', '--json', '--target', '/', '--output', 'TARGET,SOURCE,FSTYPE,OPTIONS'))
        rows = data['filesystems']
        if len(rows) != 1 or rows[0]['target'] != '/' or rows[0]['fstype'] != 'xfs':
            raise ValueError('root must be a single XFS mount')
        return rows[0]

    def root_uuid(self, specification):
        if specification.startswith('UUID='):
            expected = str(uuid.UUID(specification[5:]))
            device = '/dev/disk/by-uuid/' + expected
        else:
            expected, device = None, specification
        if not re.fullmatch(r'/dev/[a-zA-Z0-9_./:-]+', device):
            raise ValueError(f'unresolved block root: {specification}')
        value = self.run('blkid', '-c', '/dev/null', '-p', '-s', 'UUID', '-o', 'value', device).strip()
        identity = str(uuid.UUID(value))
        if identity == str(uuid.UUID(int=0)) or (expected and expected != identity):
            raise ValueError(f'conflicting root UUID: {specification}')
        return identity

    def boot_id(self):
        value = self.read(BOOT).strip()
        parsed = uuid.UUID(value)
        if str(parsed) != value or not parsed.int:
            raise ValueError('invalid boot ID')
        return value

    def entry_kernel(self, line):
        path = shlex.split(line)[0]
        # Generated Debian entries name the release explicitly. An unversioned
        # alias or unknown naming scheme needs manual review, never a guess.
        match = re.fullmatch(r'(?:/boot)?/vmlinuz-([a-zA-Z0-9_.+-]+)', path)
        if not match:
            raise ValueError('default kernel must have a literal versioned vmlinuz path')
        return match.group(1)

    def fence(self):
        checks = []
        for name, probe in [('host identity', self.identity), ('XFS root', self.mount),
                            ('ops marker', self.marker), ('heavy idle', self.heavy),
                            ('non-claim writers', self.nonclaim_writers), ('central occupancy', self.claims)]:
            try:
                value = probe()
                ok = True
                checks.append((ok, name, str(value)))
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
                checks.append((False, name, str(error)))
        return checks

    def require_fence(self):
        checks = self.fence()
        for ok, name, detail in checks:
            print(f'{"PASS" if ok else "FAIL"} fence {name}: {detail}')
        self.last_fence_checks = [dict(name=name, pass_result=ok, detail=detail) for ok, name, detail in checks]
        if not all(row[0] for row in checks):
            raise ValueError('fence refused; no boot changes/reboot authorized')
        return self.claims()

    def digest(self):
        return hashlib.sha256(self.path(GRUB).read_bytes()).hexdigest()

    def boot_files(self):
        names = ['/etc/default/grub', '/etc/fstab', GRUB, '/boot/grub/grubenv']
        directory = self.path('/etc/default/grub.d')
        if directory.is_symlink():
            raise ValueError('symlink grub.d')
        names += ['/' + p.relative_to(self.root).as_posix() for p in sorted(directory.glob('*'))]
        return {name: self.safe(name).read_bytes() for name in names}

    def boot_safety(self, enabled=False):
        files = self.boot_files()
        for name, data in files.items():
            if name == '/etc/default/grub' or name.startswith('/etc/default/grub.d/'):
                if name == DROPIN and enabled and data == CONTENT.encode():
                    continue
                for line in data.decode().splitlines():
                    if not line.strip() or line.lstrip().startswith('#'):
                        continue
                    # This is a literal data grammar, not a shell parser. No
                    # escaping, command separators, interpolation or sourcing.
                    match = re.fullmatch(r'\s*([A-Z][A-Z0-9_]*)=(?:"([^"\\$`\r\n]*)"|([a-zA-Z0-9_./,:=+@%-]*))(?:\s+#.*)?\s*', line)
                    if not match:
                        raise ValueError(f'unsupported literal GRUB input in {name}: {line}')
                    value = match.group(2) if match.group(2) is not None else match.group(3)
                    if match.group(1) == 'GRUB_SAVEDEFAULT' and value == 'true':
                        raise ValueError('GRUB_SAVEDEFAULT=true is unsupported')
                    if re.search(r'rootflags\s*=', value):
                        raise ValueError(f'existing rootflags in {name}; refuse append')
        roots = []
        for line in files['/etc/fstab'].decode().splitlines():
            fields = line.partition('#')[0].split()
            if not fields:
                continue
            if len(fields) < 4:
                raise ValueError('unrecognized fstab entry')
            if fields[1] == '/':
                roots.append(fields)
            for option in fields[3].split(','):
                if re.search(r'quota|qnoenforce$', option):
                    raise ValueError('quota mount option already in fstab')
        if len(roots) != 1 or roots[0][2] != 'xfs':
            raise ValueError('fstab must have exactly one XFS root entry')
        line = self.default_entry()
        tokens = shlex.split(line)
        if len([t for t in tokens if t.startswith('root=')]) != 1:
            raise ValueError('default Linux line must name exactly one root')
        if not enabled and any(t.startswith('rootflags=') for t in tokens):
            raise ValueError('generated default already has rootflags')
        if enabled:
            self.check_entry(True)
        identities = [self.root_uuid(spec) for spec in (self.mount()['source'], roots[0][0],
            next(t[5:] for t in tokens if t.startswith('root=')))]
        if len(set(identities)) != 1:
            raise ValueError('mounted, fstab and selected GRUB root identities differ')
        return dict(files={name: hashlib.sha256(data).hexdigest() for name, data in files.items()},
                    default=line, root_uuid=identities[0], kernel=self.entry_kernel(line))

    def originals(self, require_binding=False):
        raw = self.safe(ORIGINAL + '/manifest.json').read_bytes()
        manifest = json.loads(raw)
        if self.path(STATE).exists():
            binding = self.state().get('original_binding')
            if not binding:
                raise ValueError('missing original manifest binding in state')
            if (hashlib.sha256(raw).hexdigest() != binding['sha256'] or
                    sorted(manifest['files']) != binding['files']):
                raise ValueError('original manifest digest/membership mismatch')
        elif require_binding:
            raise ValueError('prepared state required to validate original membership')
        mandatory = {'/etc/default/grub', '/etc/fstab', GRUB, '/boot/grub/grubenv'}
        if not mandatory <= manifest.get('files', {}).keys():
            raise ValueError('missing mandatory original boot files')
        if manifest.get('version') != 1 or manifest.get('host') != self.host:
            raise ValueError('foreign original backup')
        for name, item in manifest['files'].items():
            if not name.startswith(('/etc/', '/boot/grub/')) or '..' in Path(name).parts:
                raise ValueError('invalid original backup path')
            data = self.safe(ORIGINAL + '/files' + name).read_bytes()
            if hashlib.sha256(data).hexdigest() != item['sha256']:
                raise ValueError('original backup digest mismatch')
        return manifest

    def backup(self):
        final = self.path(ORIGINAL)
        if final.exists():
            return self.originals()
        data = self.boot_files()
        if DROPIN in data:
            raise ValueError('existing pquota drop-in without original backup')
        final.parent.mkdir(parents=True, exist_ok=True)
        stage = Path(tempfile.mkdtemp(prefix='.original-', dir=final.parent))
        manifest = dict(version=1, host=self.host, files={})
        try:
            for name, content in data.items():
                destination = stage / 'files' / name.lstrip('/')
                destination.parent.mkdir(parents=True, exist_ok=True)
                with destination.open('wb') as out:
                    out.write(content)
                    out.flush()
                    os.fsync(out.fileno())
                destination.chmod(0o600)
                info = self.safe(name).stat()
                manifest['files'][name] = dict(sha256=hashlib.sha256(content).hexdigest(),
                    mode=stat.S_IMODE(info.st_mode), uid=info.st_uid, gid=info.st_gid)
            file = stage / 'manifest.json'
            file.write_text(json.dumps(manifest, indent=2, sort_keys=True) + '\n')
            file.chmod(0o600)
            with file.open('rb') as stream:
                os.fsync(stream.fileno())
            for directory in sorted((p for p in stage.rglob('*') if p.is_dir()), key=lambda p: len(p.parts), reverse=True):
                self.sync(directory)
            self.sync(stage)
            os.rename(stage, final)
            self.sync(final.parent)
        finally:
            if stage.exists():
                shutil.rmtree(stage)
        return self.originals()

    def restore(self, manifest):
        if manifest != self.originals(require_binding=True):
            raise ValueError('original manifest mismatch before restore')
        existing = {'/' + p.relative_to(self.root).as_posix() for p in self.path('/etc/default/grub.d').glob('*')}
        unexpected = existing - manifest['files'].keys() - {DROPIN}
        if unexpected:
            raise ValueError(f'boot configuration added since backup: {sorted(unexpected)}')
        for name, item in manifest['files'].items():
            self.write(name, self.safe(ORIGINAL + '/files' + name).read_bytes(), item['mode'])
            os.chown(self.safe(name), item['uid'], item['gid'])
        if DROPIN not in manifest['files'] and self.path(DROPIN).exists():
            if self.safe(DROPIN).read_text() != CONTENT:
                raise ValueError('foreign pquota drop-in')
            self.path(DROPIN).unlink()
            self.sync(self.path(DROPIN).parent)

    def verify_originals(self, manifest):
        if manifest != self.originals(require_binding=True):
            raise ValueError('original manifest mismatch before verification')
        for name, item in manifest['files'].items():
            if hashlib.sha256(self.safe(name).read_bytes()).hexdigest() != item['sha256']:
                raise ValueError(f'restored digest mismatch: {name}')
        return True

    def project_attrs(self, directory):
        # Linux FS_IOC_FSGETXATTR, struct fsxattr (linux/fs.h UAPI).
        fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            flags, _, _, project, _, _ = struct.unpack('=5I8s', fcntl.ioctl(fd, 0x801c581f, bytes(28)))
        finally:
            os.close(fd)
        return dict(project=project, inherit=bool(flags & 0x200))

    def probe(self):
        # Never called by plan. Unique unused project ID and private directory;
        # all quota mutation is confined to this temporary project.
        report = self.run('xfs_quota', '-x', '-c', 'report -p -n -b', '/')
        used = {int(value) for value in re.findall(r'^\s*#?([0-9]+)\s', report, re.M)}
        if 'Project quota on /' not in report or not used:
            raise ValueError('unrecognized project quota inventory; no probe authorized')
        project = 0x60000000 + (uuid.uuid4().int % 0x10000000)
        if project in used:
            raise ValueError('probe project ID collision; retry with no mutation')
        base = self.path('/var/lib/fabrig-pquota/probe')
        self.safe('/var/lib/fabrig-pquota/probe/.guard')
        base.mkdir(parents=True, exist_ok=True, mode=0o700)
        directory = Path(tempfile.mkdtemp(prefix='project-', dir=base))
        account = pwd.getpwnam('free')
        os.chown(directory, account.pw_uid, account.pw_gid)
        setup = False
        result, errors = {}, []
        try:
            setup = True  # Partial project setup also requires cleanup.
            self.run('xfs_quota', '-x', '-c', f'project -s -p {directory} {project}', '/')
            self.run('xfs_quota', '-x', '-c', f'limit -p bsoft=0 bhard=1m {project}', '/')
            parent = self.project_attrs(directory)
            if parent != dict(project=project, inherit=True):
                raise ValueError('probe parent project/inherit flag missing')
            result = json.loads(self.run('python3', '-I', '-B', '-c', PROBE_WRITE, str(directory),
                                        str(account.pw_uid), str(account.pw_gid)))
            child = self.project_attrs(directory / 'child')
            if child != parent:
                raise ValueError('new subdirectory did not inherit project and inherit flag')
            if result.get('errno') != errno.EDQUOT or result.get('bytes', 2**30) >= 2 * 1024 * 1024:
                raise ValueError(f'probe must fail specifically with EDQUOT: {result}')
            result.update(project=project, inherited=True, hard_cap_bytes=1048576)
        finally:
            if setup:
                for command in (f'project -C -p {directory} {project}', f'limit -p bsoft=0 bhard=0 {project}'):
                    try:
                        self.run('xfs_quota', '-x', '-c', command, '/')
                    except (OSError, ValueError, subprocess.SubprocessError) as error:
                        errors.append(str(error))
            if not errors:
                shutil.rmtree(directory)
            if errors:
                raise ValueError(f'probe cleanup incomplete at {directory}: {errors}')
        return result

    def default_entry(self):
        # Deliberately narrow: numbered top-level entries only. Saved/one-shot,
        # submenu, custom defaults or unknown generated syntax require ops review.
        defaults = re.findall(r'^\s*GRUB_DEFAULT=(.*)$', self.read('/etc/default/grub'), re.M)
        fields = shlex.split(defaults[-1]) if defaults else ['0']
        if not fields:
            raise ValueError('empty GRUB_DEFAULT')
        value = fields[0]
        if not value.isdecimal():
            raise ValueError('unsupported GRUB_DEFAULT; require numeric top-level entry')
        # Other drop-ins may override GRUB_DEFAULT. Never guess shell semantics.
        directory = self.path('/etc/default/grub.d')
        for path in sorted(directory.glob('*')):
            if path.name != Path(DROPIN).name and re.search(r'\bGRUB_DEFAULT\s*=', path.read_text()):
                raise ValueError('GRUB_DEFAULT in another drop-in requires ops review')
        environment = self.run('grub-editenv', str(self.path('/boot/grub/grubenv')), 'list')
        if any(line.startswith(('next_entry=', 'saved_entry=')) and line.partition('=')[2]
               for line in environment.splitlines()):
            raise ValueError('saved/one-shot GRUB entry requires ops review')
        config = self.read(GRUB)
        selected = re.findall(r'^\s*set default=(.*?)\s*$', config, re.M)
        allowed_variables = ('"${next_entry}"', '"${saved_entry}"', '"$next_entry"', '"$saved_entry"')
        literals = [item for item in selected if item not in allowed_variables]
        if not literals or any(shlex.split(item) != [value] for item in literals):
            raise ValueError('generated default does not match GRUB_DEFAULT')
        entries = list(re.finditer(r'^(menuentry|submenu)\s', config, re.M))
        index = int(value)
        if index >= len(entries) or entries[index].group(1) != 'menuentry':
            raise ValueError('default is missing or a submenu')
        end = entries[index + 1].start() if index + 1 < len(entries) else len(config)
        block = config[entries[index].start():end]
        lines = re.findall(r'^\s*linux(?:efi)?\s+(.+)$', block, re.M)
        if len(lines) != 1:
            raise ValueError('default must contain exactly one Linux boot line')
        return lines[0]

    def check_entry(self, enabled):
        line = self.default_entry()
        flags = [t for t in shlex.split(line) if t.startswith('rootflags=')]
        if has_pquota(line) != enabled or (enabled and len(flags) != 1):
            raise ValueError(f'generated default rootflags verification failed: {line}')
        return line

    def plan(self):
        for name, probe in [('cmdline', lambda: self.read('/proc/cmdline').strip()),
                ('mount', self.mount), ('quota state', lambda: self.run('xfs_quota', '-x', '-c', 'state', '/').strip()),
                ('boot safety', self.boot_safety), ('pre-boot sources/environment/services', self.preboot),
                ('full occupancy', lambda: self.claims(display=True))]:
            try:
                print(f'{name}: {probe()}')
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
                print(f'UNAVAILABLE {name}: {error}')
        print(f'would atomically write {DROPIN}:\n{CONTENT}', end='')
        print('would run: update-grub; preserve existing boot options; would NOT reboot')
        for ok, name, detail in self.fence():
            print(f'{"PASS" if ok else "FAIL"} fence {name}: {detail}')
        print('plan is read-only; verify explicitly performs a bounded scratch quota/inheritance probe.')

    def prepare(self):
        self.identity()
        previous = self.state() if self.path(STATE).exists() else None
        if previous and previous.get('transaction_origin') == 'bootstrap' and previous.get('phase') != 'rolled-back':
            raise ValueError('bootstrap recovery transaction; rollback before establishing fenced prepare')
        if previous and previous.get('phase') == 'prepared':
            self.bind_policy(previous)
            self.require_fence_unchanged(previous)
            if previous['boot_id'] != self.read(BOOT).strip() or self.digest() != previous['grub_after']:
                raise ValueError('prepared boot/config drift; investigate')
            if self.boot_safety(enabled=True)['files'] != previous['boot_files_after']:
                raise ValueError('prepared boot input files drifted')
            self.originals()
            if self.preboot() != previous['proof']:
                raise ValueError('pre-boot source/environment/service proof drift')
            print('PASS already prepared; original backups and evidence preserved')
            return
        if previous and previous.get('phase') in ('preparing', 'rolling-back'):
            raise ValueError('incomplete transaction; investigate and rollback')
        safety = self.boot_safety()
        self.require_fence()
        proof = self.preboot()  # No boot mutation if source/env/service proof fails.
        self.claims()  # Establish current approval and occupancy before backup.
        backup = self.backup()
        if {k: v['sha256'] for k, v in backup['files'].items()} != safety['files']:
            raise ValueError('boot originals changed since write-once backup')
        occupancy = self.require_fence()  # Immediately before committing boot intent.
        state = self.prepare_intent(safety, backup, proof, occupancy)
        self.write(DROPIN, CONTENT, 0o644)
        self.run('update-grub')
        self.finish_prepare(state)
        print('PASS prepared; owner restarts after boot: ' + ', '.join(proof['services']['owner_restarts']))

    def prepare_intent(self, safety, backup, proof, occupancy, origin='prepare'):
        state = dict(version=1, host=self.host, phase='preparing', prepared_at=now(),
            boot_id=proof['boot_id'], before_cmdline=self.read('/proc/cmdline').strip(),
            before_mount=self.mount(), grub_before=self.digest(), default_before=safety['default'],
            proof=proof, occupancy=occupancy, policy=self.policy, central=self.central, fence=getattr(self, 'last_fence_checks', []), transaction_origin=origin,
            root_uuid=safety['root_uuid'], prepared_kernel=safety['kernel'],
            original_binding=dict(files=sorted(backup['files']), sha256=hashlib.sha256(
                self.safe(ORIGINAL + '/manifest.json').read_bytes()).hexdigest()))
        self.save(state)
        return state

    def finish_prepare(self, state):
        line = self.check_entry(True)
        if [t for t in shlex.split(line) if t != 'rootflags=pquota'] != shlex.split(state['default_before']):
            raise ValueError('update-grub changed existing default Linux options')
        after = self.boot_safety(enabled=True)
        state.update(grub_after=self.digest(), default_after=line, phase='prepared', boot_files_after=after['files'])
        self.save(state)

    def bootstrap_begin(self):
        # Fresh bootstrap has not installed the fleet/source/claim machinery.
        # Its transaction is recovery evidence, never a bypass of those fences.
        self.identity()  # Rollback must recognize this host even after interruption.
        if self.path(STATE).exists():
            state = self.state()
            if state.get('phase') != 'rolled-back':
                if state.get('transaction_origin') != 'bootstrap' or state.get('phase') != 'prepared':
                    raise ValueError('existing or interrupted transaction; investigate and rollback')
                self.originals(require_binding=True)
                if (self.boot_id() != state['boot_id'] or
                        self.boot_safety(enabled=True)['files'] != state['boot_files_after']):
                    raise ValueError('bootstrap boot/configuration changed; investigate')
                return state
        safety = self.boot_safety()
        backup = self.backup()
        if {k: v['sha256'] for k, v in backup['files'].items()} != safety['files']:
            raise ValueError('boot originals changed since write-once backup')
        proof = dict(boot_id=self.boot_id())
        return self.prepare_intent(safety, backup, proof, None, origin='bootstrap')

    def bind_policy(self, state):
        if self.central != state['central']:
            raise ValueError('central authority differs from prepare')
        if self.policy and self.policy != state['policy']:
            raise ValueError('fence/approval policy differs from prepare')
        self.policy = state['policy']

    def require_fence_unchanged(self, state):
        occupancy = self.require_fence()
        if occupancy != state['occupancy']:
            raise ValueError('central claim incarnation, inventory or retained approval changed since prepare')
        return occupancy

    def rollback(self):
        self.identity()
        manifest = self.originals(require_binding=True)
        state = self.state() if self.path(STATE).exists() else dict(version=1, host=self.host)
        if self.path(DROPIN).exists() and self.safe(DROPIN).read_text() != CONTENT:
            raise ValueError('foreign drop-in; refusing rollback')
        state.update(phase='rolling-back', rollback_started=now())
        self.save(state)
        self.restore(manifest)
        self.run('update-grub')
        self.check_entry(False)
        # Generated GRUB may differ cosmetically. Restore the byte-exact known
        # original after regeneration, then prove all original digests/default.
        self.restore(manifest)
        self.verify_originals(manifest)
        self.check_entry(False)
        state.update(phase='rolled-back', rollback_at=now(), rollback_boot_id=self.read(BOOT).strip(),
                     rollback_grub_after=self.digest())
        self.save(state)
        print('PASS restored all original file digests; reboot remains separate and fenced')

    def reboot(self):
        state = self.state()
        if state.get('transaction_origin') == 'bootstrap':
            raise ValueError('bootstrap recovery state cannot authorize reboot; establish a fenced prepare')
        self.bind_policy(state)
        if state.get('phase') not in ('prepared', 'rolled-back'):
            raise ValueError('no successful prepare/rollback')
        expected = state['boot_id'] if state['phase'] == 'prepared' else state['rollback_boot_id']
        if self.read(BOOT).strip() != expected:
            raise ValueError('boot already changed; refusing repeated reboot')
        key = 'grub_after' if state['phase'] == 'prepared' else 'rollback_grub_after'
        if self.digest() != state[key]:
            raise ValueError('GRUB changed after preparation')
        self.check_entry(state['phase'] == 'prepared')
        manifest = self.originals()
        expected_files = state['boot_files_after'] if state['phase'] == 'prepared' else {k: v['sha256'] for k, v in manifest['files'].items()}
        if self.boot_safety(enabled=state['phase'] == 'prepared')['files'] != expected_files:
            raise ValueError('boot input files changed after preparation')
        latest = self.preboot()
        if latest['sources'] != state['proof']['sources'] or latest['environment'] != state['proof']['environment']:
            raise ValueError('installed source/environment changed since prepare')
        state['reboot_prevention'] = self.boot_prevention(latest['services'])
        state['reboot_services'] = latest['services']
        state['proof']['services']['owner_restarts'] = sorted(set(state['proof']['services']['owner_restarts']) | set(latest['services']['owner_restarts']))
        self.save(state)
        self.require_fence_unchanged(state)
        state.update(reboot_fence=self.last_fence_checks, reboot_requested_at=now())
        self.save(state)
        self.run('systemctl', 'reboot', '--')

    def expected_options(self, state):
        prepared = shlex.split(state['default_after'])
        running = shlex.split(self.read('/proc/cmdline'))
        if running and running[0].startswith('BOOT_IMAGE='):
            if running.pop(0) != 'BOOT_IMAGE=' + prepared[0]:
                raise ValueError('BOOT_IMAGE does not match prepared kernel path')
        # No sorting, deduplication or normalization of any other token.
        return running == prepared[1:]

    def verify(self):
        state = self.state()
        if state.get('transaction_origin') == 'bootstrap':
            raise ValueError('bootstrap recovery state cannot authorize a probe; establish a fenced prepare')
        self.bind_policy(state)
        checks = []
        def check(name, probe):
            try:
                value = probe()
                ok = bool(value)
                detail = value
            except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
                ok, detail = False, str(error)
            checks.append(dict(name=name, pass_result=ok, detail=detail))
            print(f'{"PASS" if ok else "FAIL"} {name}: {str(detail).replace(chr(10), " | ")}')
        check('boot changed since prepare', lambda: state['phase'] == 'prepared' and self.boot_id() != state['boot_id'])
        check('prepared kernel running', lambda: self.run('uname', '-r').strip() == state['prepared_kernel'])
        check('root device identity unchanged', lambda: self.root_uuid(self.mount()['source']) == state['root_uuid'])
        check('post-prepare boot input digests unchanged', lambda: self.boot_safety(enabled=True)['files'] == state['boot_files_after'])
        check('original manifest and payloads intact', lambda: self.originals(require_binding=True))
        check('exact prepared kernel options', lambda: self.expected_options(state))
        check('owner boot prevention preserved', lambda: self.boot_prevention(self.services()))
        check('cmdline rootflags=pquota', lambda: has_pquota(self.read('/proc/cmdline')))
        check('XFS mount prjquota', lambda: 'prjquota' in self.mount()['options'].split(','))
        def quota():
            output = self.run('xfs_quota', '-x', '-c', 'state', '/')
            project = re.search(r'^Project quota state on / .*?$(.*?)(?=^\S|\Z)', output, re.M | re.S)
            section = project.group(1) if project else ''
            return bool(re.search(r'^\s*Accounting:\s+ON\s*$', section, re.M) and
                        re.search(r'^\s*Enforcement:\s+ON\s*$', section, re.M))
        check('project accounting/enforcement ON', quota)
        check('installed sources unchanged', lambda: self.installed() == state['proof']['sources'])
        check('machine.env unchanged', lambda: self.environment() == state['proof']['environment'])
        check('fleet-sync.timer active', lambda: self.user('systemctl', '--user', 'is-active', '--', 'fleet-sync.timer').strip() == 'active')
        check('maintenance and retained claims unchanged; all writers drained', lambda: self.require_fence_unchanged(state))
        # A failed prerequisite never authorizes any live quota operation.
        if all(row['pass_result'] for row in checks):
            check('project inheritance and EDQUOT scratch probe', self.probe)
        else:
            check('project inheritance and EDQUOT scratch probe', lambda: False)
        state['verification'] = dict(at=now(), boot_id=self.read(BOOT).strip(), checks=checks, fence=self.last_fence_checks)
        self.save(state)
        status = 'PASS' if all(row['pass_result'] for row in checks) else 'FAIL'
        print(status + ' owner restart list (starts none; wait for accepted verification): ' + ', '.join(state['proof']['services']['owner_restarts']))
        return all(row['pass_result'] for row in checks)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', nargs='?', choices=('plan', 'prepare', 'reboot', 'verify', 'rollback'), default='plan')
    parser.add_argument('--host', required=True)
    parser.add_argument('--central', default='free@204.168.210.29', help='hel8 SSH authority (as free)')
    parser.add_argument('--yes', action='store_true')
    parser.add_argument('--inventory-digest')
    parser.add_argument('--maintenance-owner')
    parser.add_argument('--maintenance-what')
    parser.add_argument('--retained-claim', action='append', default=[], metavar='SLOT:CLAIM_OWNER:APPROVER:POST_ID')
    parser.add_argument('--approval-file', action='append', default=[], metavar='POST_ID:ABSOLUTE_MD_PATH')
    parser.add_argument('--retained-service', action='append', default=[], metavar='SLOT:UNIT.service')
    args = parser.parse_args()
    if not re.fullmatch(r'[a-z][a-z0-9-]*', args.host):
        parser.error('invalid host')
    if not re.fullmatch(r'[a-zA-Z0-9_.@:-]+', args.central) or args.central.startswith('-'):
        parser.error('invalid central SSH destination')
    mutation = args.command in ('prepare', 'reboot', 'rollback')
    if mutation and not args.yes:
        parser.error(f'{args.command} requires --yes')
    if os.geteuid() != 0:
        parser.error('run as root: sudo python3 -I fleet/bootstrap/pquota ...')
    options = {}
    if args.inventory_digest or args.maintenance_owner or args.maintenance_what or args.retained_claim or args.approval_file or args.retained_service:
        if args.inventory_digest and not re.fullmatch(r'[0-9a-f]{64}', args.inventory_digest):
            parser.error('inventory digest must be sha256')
        options = dict(inventory_digest=args.inventory_digest, maintenance_owner=args.maintenance_owner,
                       maintenance_what=args.maintenance_what, retained_claims=[], approval_files={}, retained_services={})
        for item in args.retained_claim:
            fields = item.split(':', 3)
            if len(fields) != 4 or not fields[0].isdecimal() or not all(fields):
                parser.error('retained claim requires SLOT:CLAIM_OWNER:APPROVER:POST_ID')
            row = dict(zip(('slot', 'owner', 'approver', 'post'), fields))
            if row['slot'] in {r['slot'] for r in options['retained_claims']}:
                parser.error('duplicate retained slot')
            options['retained_claims'].append(row)
        for argument, key in ((args.approval_file, 'approval_files'), (args.retained_service, 'retained_services')):
            for item in argument:
                name, sep, value = item.partition(':')
                if not sep or not name or not value or name in options[key]:
                    parser.error('invalid/duplicate approval file or retained service')
                if key == 'approval_files' and (not Path(value).is_absolute() or Path(value).suffix != '.md'):
                    parser.error('approval file must be an explicit absolute .md post path')
                options[key][name] = value
    tool = Pquota(args.host, args.central, policy=options)
    if mutation:
        with tool.locked():
            getattr(tool, args.command)()
    elif args.command == 'verify':
        with tool.locked():
            return 0 if tool.verify() else 1
    else:
        tool.plan()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        sys.exit(f'pquota: {error}')
